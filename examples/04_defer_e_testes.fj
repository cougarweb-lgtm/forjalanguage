// 04_defer_e_testes.fj - defer (roda na saida do bloco, ordem inversa) e blocos test/expect.
// Rodar:  forja run examples\04_defer_e_testes.fj      Testar:  forja test examples\04_defer_e_testes.fj

proc soma_ate(n: int) -> int {
    var soma = 0
    for i in 1..=n {
        soma += i
    }
    return soma
}

proc main() {
    defer print("fim")
    defer print("quase fim")
    print(soma_ate(10))
}

test "soma de 1 a 10" {
    expect(soma_ate(10) == 55)
}

test "soma de zero termos" {
    expect(soma_ate(0) == 0)
}
