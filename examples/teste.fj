// teste.fj - primeiro programa Forja compilado e executado de ponta a ponta.
// Caminho: teste.fj -> forja -> teste.c -> gcc -> teste.exe (codigo nativo, sem bytecode).

unit Metros: f32
unit Segundos: f32
unit MetrosPorSegundo = Metros / Segundos

struct Grifo {
    vida: i32 in 0..=100 = 100
    velocidade: MetrosPorSegundo = 8.0
}

// soma 1 + 2 + ... + n, cada termo multiplicado por passo (padrao 1)
proc soma_ate(n: int, passo: int = 1) -> int {
    var soma = 0
    for i in 1..<n + 1 {
        soma += i * passo
    }
    return soma
}

proc main() {
    print("Olá, mundo!")

    print("Soma de 1 a 10:")
    print(soma_ate(10))
    print("Mesma soma com passo = 2:")
    print(soma_ate(10, passo = 2))

    print("Contagem regressiva:")
    var n = 3
    while n > 0 {
        print(n)
        n -= 1
    }

    print("Pares de 1 a 10:")
    for i in 1..<11 {
        if i % 2 == 0 {
            print(i)
        }
    }

    let g = Grifo{}
    let t: Segundos = 2.5
    let d: Metros = g.velocidade * t
    print("Vida do grifo:")
    print(g.vida)
    print("Distancia em 2.5 s a 8 m/s:")
    print(d as int)
}
