// 02_resultado.fj - erro como valor: "T ! E", try, or_else e switch que cobre todos os casos.
// Rodar:  forja run examples\02_resultado.fj

enum Erro { nao_achou }

proc achar(id: i32) -> i32 ! Erro {
    if id == 0 {
        return Erro.nao_achou
    }
    return id * 10
}

// try repassa o erro para quem chamou (o proc precisa devolver "! Erro" tambem)
proc dobro_do_achado(id: i32) -> i32 ! Erro {
    let valor = try achar(id)
    return valor * 2
}

proc main() {
    // or_else: valor padrao so quando deu erro
    print(achar(3) or_else -1)
    print(achar(0) or_else -1)

    // switch sobre o resultado: tem que tratar o valor e o erro
    switch r in dobro_do_achado(4) {
    case i32:
        print(r)
    case Erro:
        print("nao achou")
    }
    switch r in dobro_do_achado(0) {
    case i32:
        print(r)
    case Erro:
        print("nao achou")
    }
}
