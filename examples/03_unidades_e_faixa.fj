// 03_unidades_e_faixa.fj - unidades de medida (erro de compilacao se misturar) e campo com faixa.
// Rodar:  forja run examples\03_unidades_e_faixa.fj

unit Metros: f32
unit Segundos: f32
unit MetrosPorSegundo = Metros / Segundos

struct Alvo {
    vida: i32 in 0..=100 = 100
    nivel: int in 1..<10 = 1
}

proc main() {
    let distancia: Metros = 10.0
    let tempo: Segundos = 2.0
    let velocidade: MetrosPorSegundo = distancia / tempo
    print(velocidade as int)

    let alvo = Alvo{vida = 55, nivel = 9}
    print(alvo.vida)
    print(alvo.nivel)
    let novo = Alvo{}
    print(novo.vida)
    // alvo.vida = 101  <- panic R0001 em dev (fora de 0..=100); distancia + tempo <- erro E0412
}
