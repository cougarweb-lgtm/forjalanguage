// 05_vetor_c.fj - vetor devolvido por uma funcao C: slice_from(p, len = n) vira fatia com o tamanho real.
// Rodar:  forja run examples\05_vetor_c.fj

foreign {
    link "msvcrt"
    proc c_calloc = "calloc"(n: u64, tamanho: u64) -> ?^i32
    proc c_free = "free"(p: rawptr)
}

// a fatia e emprestada: quem alocou (o C) e quem libera; indice fora do tamanho dado = R0006
proc somar(valores: []i32) -> int {
    var soma: int = 0
    for x in valores {
        soma = soma + x as int
    }
    return soma
}

proc main() {
    let n: i32 = 5
    let p = c_calloc(5, tamanho = 4)
    var v = slice_from(p, len = n)
    for i in 0..<len(v) {
        v[i] = (i * i) as i32
    }
    print(len(v))
    print(somar(v[..]))
    c_free(p as rawptr)
}
