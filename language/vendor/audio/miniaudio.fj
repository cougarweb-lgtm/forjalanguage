pub const MA_SUCCESS: i32 = 0
pub const MA_ERROR: i32 = -1
pub const MA_INVALID_ARGS: i32 = -2
pub const MA_INVALID_OPERATION: i32 = -3
pub const MA_OUT_OF_MEMORY: i32 = -4
pub const MA_DOES_NOT_EXIST: i32 = -7
pub const MA_INVALID_FILE: i32 = -10
pub const MA_NO_BACKEND: i32 = -203
pub const MA_NO_DEVICE: i32 = -204
pub const MA_SOUND_FLAG_STREAM: i32 = 1
pub const MA_SOUND_FLAG_DECODE: i32 = 2
pub const MA_SOUND_FLAG_ASYNC: i32 = 4
pub const MA_SOUND_FLAG_LOOPING: i32 = 32
pub const MA_SOUND_FLAG_NO_DEFAULT_ATTACHMENT: i32 = 4096
pub const MA_SOUND_FLAG_NO_PITCH: i32 = 8192
pub const MA_SOUND_FLAG_NO_SPATIALIZATION: i32 = 16384

pub foreign {
    link "miniaudio"
    opaque MaEngineConfig
    opaque MaEngine
    opaque MaSoundGroup
    opaque MaFence
    opaque MaSound
    proc ma_version_string() -> ?cstr
    proc ma_version(p_major: ?^u32, p_minor: ?^u32, p_revision: ?^u32)
    proc ma_result_description(result: i32) -> ?cstr
    proc ma_engine_init(p_config: ?^MaEngineConfig, p_engine: ?^MaEngine) -> i32
    proc ma_engine_uninit(p_engine: ?^MaEngine)
    proc ma_engine_read_pcm_frames(p_engine: ?^MaEngine, p_frames_out: rawptr, frame_count: u64, p_frames_read: ?^u64) -> i32
    proc ma_engine_get_channels(p_engine: ?^MaEngine) -> u32
    proc ma_engine_get_sample_rate(p_engine: ?^MaEngine) -> u32
    proc ma_engine_start(p_engine: ?^MaEngine) -> i32
    proc ma_engine_set_volume(p_engine: ?^MaEngine, volume: f32) -> i32
    proc ma_engine_play_sound(p_engine: ?^MaEngine, p_file_path: cstr, p_group: ?^MaSoundGroup) -> i32
    proc ma_sound_init_from_file(p_engine: ?^MaEngine, p_file_path: cstr, flags: u32, p_group: ?^MaSoundGroup, p_done_fence: ?^MaFence, p_sound: ?^MaSound) -> i32
    proc ma_sound_uninit(p_sound: ?^MaSound)
    proc ma_sound_start(p_sound: ?^MaSound) -> i32
    proc ma_sound_stop(p_sound: ?^MaSound) -> i32
    proc ma_sound_set_volume(p_sound: ?^MaSound, volume: f32)
    proc ma_sound_set_pan(p_sound: ?^MaSound, pan: f32)
    proc ma_sound_set_pitch(p_sound: ?^MaSound, pitch: f32)
    proc ma_sound_set_looping(p_sound: ?^MaSound, is_looping: u32)
    proc ma_sound_is_playing(p_sound: ?^MaSound) -> u32
    proc ma_sound_at_end(p_sound: ?^MaSound) -> u32
    proc maf_config_nova() -> ?^MaEngineConfig
    proc maf_config_liberar(config: ?^MaEngineConfig)
    proc maf_config_sem_dispositivo(config: ?^MaEngineConfig, sem_dispositivo: u32)
    proc maf_config_formato(config: ?^MaEngineConfig, canais: u32, taxa: u32)
    proc maf_engine_nova() -> ?^MaEngine
    proc maf_engine_liberar(engine: ?^MaEngine)
    proc maf_sound_nova() -> ?^MaSound
    proc maf_sound_liberar(som: ?^MaSound)
}
