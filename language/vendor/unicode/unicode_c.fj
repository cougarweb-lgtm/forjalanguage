pub const UTF8PROC_ERROR_INVALIDOPTS: i32 = -5

pub foreign {
    link "utf8proc"
    proc utf8proc_version() -> ?cstr
    proc utf8proc_unicode_version() -> ?cstr
    proc utf8proc_errmsg(errcode: i64) -> ?cstr
    proc utf8proc_iterate(str_: ?^u8, strlen: i64, codepoint_ref: ?^i32) -> i64
    proc utf8proc_codepoint_valid(codepoint: i32) -> bool
    proc utf8proc_encode_char(codepoint: i32, dst: ?^u8) -> i64
    proc utf8proc_get_property(codepoint: i32) -> ?^Utf8procPropertyStruct
    proc utf8proc_decompose_char(codepoint: i32, dst: ?^i32, bufsize: i64, options: u32, last_boundclass: ?^i32) -> i64
    proc utf8proc_decompose(str_: ?^u8, strlen: i64, buffer: ?^i32, bufsize: i64, options: u32) -> i64
    proc utf8proc_decompose_custom(str_: ?^u8, strlen: i64, buffer: ?^i32, bufsize: i64, options: u32, custom_func: proc(codepoint: i32, data: rawptr) -> i32, custom_data: rawptr) -> i64
    proc utf8proc_normalize_utf32(buffer: ?^i32, length: i64, options: u32) -> i64
    proc utf8proc_reencode(buffer: ?^i32, length: i64, options: u32) -> i64
    proc utf8proc_grapheme_break_stateful(codepoint1: i32, codepoint2: i32, state: ?^i32) -> bool
    proc utf8proc_grapheme_break(codepoint1: i32, codepoint2: i32) -> bool
    proc utf8proc_tolower(c: i32) -> i32
    proc utf8proc_toupper(c: i32) -> i32
    proc utf8proc_totitle(c: i32) -> i32
    proc utf8proc_islower(c: i32) -> i32
    proc utf8proc_isupper(c: i32) -> i32
    proc utf8proc_charwidth(codepoint: i32) -> i32
    proc utf8proc_charwidth_ambiguous(codepoint: i32) -> bool
    proc utf8proc_category(codepoint: i32) -> Utf8procCategory
    proc utf8proc_category_string(codepoint: i32) -> ?cstr
    proc utf8proc_map(str_: ?^u8, strlen: i64, dstptr: ?^?^u8, options: u32) -> i64
    proc utf8proc_map_custom(str_: ?^u8, strlen: i64, dstptr: ?^?^u8, options: u32, custom_func: proc(codepoint: i32, data: rawptr) -> i32, custom_data: rawptr) -> i64
    proc utf8proc_NFD(str_: ?^u8) -> ?^u8
    proc utf8proc_NFC(str_: ?^u8) -> ?^u8
    proc utf8proc_NFKD(str_: ?^u8) -> ?^u8
    proc utf8proc_NFKC(str_: ?^u8) -> ?^u8
    proc utf8proc_NFKC_Casefold(str_: ?^u8) -> ?^u8
    proc utf8proc_free(ptr: ?^u8)
}

pub proc utf8proc_property_struct_comb_index_get(p: ^Utf8procPropertyStruct) -> u16 {
    return ((p.bits_0 >> 0) & 1023) as u16
}

pub proc utf8proc_property_struct_comb_index_set(p: ^Utf8procPropertyStruct, v: u16) {
    p.bits_0 = (p.bits_0 & 64512) | ((v & 1023) << 0)
}

pub proc utf8proc_property_struct_comb_length_get(p: ^Utf8procPropertyStruct) -> u16 {
    return ((p.bits_0 >> 10) & 31) as u16
}

pub proc utf8proc_property_struct_comb_length_set(p: ^Utf8procPropertyStruct, v: u16) {
    p.bits_0 = (p.bits_0 & 33791) | ((v & 31) << 10)
}

pub proc utf8proc_property_struct_comb_issecond_get(p: ^Utf8procPropertyStruct) -> u16 {
