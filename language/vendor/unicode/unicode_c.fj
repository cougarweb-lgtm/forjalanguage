pub struct Utf8procPropertyStruct {
    category: i16
    combining_class: i16
    bidi_class: i16
    decomp_type: i16
    decomp_seqindex: u16
    casefold_seqindex: u16
    uppercase_seqindex: u16
    lowercase_seqindex: u16
    titlecase_seqindex: u16
    bits_0: u16
    bits_1: u32
}

// layout Utf8procPropertyStruct struct~utf8proc_property_struct tamanho=24 alinhamento=4 category:category=0 combining_class:combining_class=2 bidi_class:bidi_class=4 decomp_type:decomp_type=6 decomp_seqindex:decomp_seqindex=8 casefold_seqindex:casefold_seqindex=10 uppercase_seqindex:uppercase_seqindex=12 lowercase_seqindex:lowercase_seqindex=14 titlecase_seqindex:titlecase_seqindex=16 bits_0:-=18 bits_1:-=20
static_assert(size_of(Utf8procPropertyStruct) == 24, msg = "layout de Utf8procPropertyStruct: tamanho difere da libclang")
static_assert(align_of(Utf8procPropertyStruct) == 4, msg = "layout de Utf8procPropertyStruct: alinhamento difere da libclang")
static_assert(offset_of(Utf8procPropertyStruct.category) == 0, msg = "layout de Utf8procPropertyStruct: offset de category difere da libclang")
static_assert(offset_of(Utf8procPropertyStruct.combining_class) == 2, msg = "layout de Utf8procPropertyStruct: offset de combining_class difere da libclang")
static_assert(offset_of(Utf8procPropertyStruct.bidi_class) == 4, msg = "layout de Utf8procPropertyStruct: offset de bidi_class difere da libclang")
static_assert(offset_of(Utf8procPropertyStruct.decomp_type) == 6, msg = "layout de Utf8procPropertyStruct: offset de decomp_type difere da libclang")
static_assert(offset_of(Utf8procPropertyStruct.decomp_seqindex) == 8, msg = "layout de Utf8procPropertyStruct: offset de decomp_seqindex difere da libclang")
static_assert(offset_of(Utf8procPropertyStruct.casefold_seqindex) == 10, msg = "layout de Utf8procPropertyStruct: offset de casefold_seqindex difere da libclang")
static_assert(offset_of(Utf8procPropertyStruct.uppercase_seqindex) == 12, msg = "layout de Utf8procPropertyStruct: offset de uppercase_seqindex difere da libclang")
static_assert(offset_of(Utf8procPropertyStruct.lowercase_seqindex) == 14, msg = "layout de Utf8procPropertyStruct: offset de lowercase_seqindex difere da libclang")
static_assert(offset_of(Utf8procPropertyStruct.titlecase_seqindex) == 16, msg = "layout de Utf8procPropertyStruct: offset de titlecase_seqindex difere da libclang")
static_assert(offset_of(Utf8procPropertyStruct.bits_0) == 18, msg = "layout de Utf8procPropertyStruct: offset de bits_0 difere da libclang")
static_assert(offset_of(Utf8procPropertyStruct.bits_1) == 20, msg = "layout de Utf8procPropertyStruct: offset de bits_1 difere da libclang")

