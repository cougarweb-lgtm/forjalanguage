// gerado por 'forja ligar' 0.9.0 a partir de harfbuzz\hbf.h (--link harfbuzz); depois acrescentadas a mao SO as clausulas de posse (creates/destroys, como image_c.fj) e este comentario.
// gerados: 32 (procs 16, tipos 3, consts 13, acessos 0); recusados: 0
// 0.1.0 (20/11/2026, PREPARO, FORJA-D0810): ponte da cola hbf (HarfBuzz 15.1.0). Implementacao em harfbuzz\hbf.c, dentro de vendor\libharfbuzz.a.

pub const HBF_OK: i32 = 0
pub const HBF_ERR_ARG: i32 = -1
pub const HBF_ERR_GLIFO: i32 = -2
pub const HBF_ERR_MEMORIA: i32 = -3
pub const HBF_ERR_ENTRADA: i32 = -4
pub const HBF_DIRECAO_AUTO: i32 = 0
pub const HBF_DIRECAO_LTR: i32 = 1
pub const HBF_DIRECAO_RTL: i32 = 2
pub const HBF_DIRECAO_TTB: i32 = 3
pub const HBF_DIRECAO_BTT: i32 = 4
pub const HBF_SUBSET_SEM_HINTS: i32 = 1
pub const HBF_SUBSET_MANTER_GIDS: i32 = 2
pub const HBF_REGISTRO_GLIFO: i32 = 24

pub foreign {
    link "harfbuzz"
    opaque HbfFont
    opaque HbfRun
    opaque HbfBytes
    proc hbf_font_open(dados: ?^u8, tamanho: u64, indice_face: u32) -> ?^HbfFont creates
    proc hbf_font_close(fonte: ?^HbfFont) destroys fonte
    proc hbf_units_per_em(fonte: ?^HbfFont, saida: ?^i32) -> i32
    proc hbf_font_metricas(fonte: ?^HbfFont, ascender: ?^i32, descender: ?^i32, line_gap: ?^i32) -> i32
    proc hbf_glyph_count(fonte: ?^HbfFont, saida: ?^i32) -> i32
    proc hbf_glyph_for_codepoint(fonte: ?^HbfFont, codepoint: u32, gid: ?^u32) -> i32
    proc hbf_glyph_advance(fonte: ?^HbfFont, gid: u32, saida: ?^i32) -> i32
    proc hbf_shape(fonte: ?^HbfFont, utf8: ?^u8, tamanho: u64, direcao: i32, script: cstr, idioma: cstr, features: cstr) -> ?^HbfRun creates
    proc hbf_run_len(run: ?^HbfRun, saida: ?^i32) -> i32
    proc hbf_run_copy(run: ?^HbfRun, saida: ?^u8, capacidade: u64) -> i32
    proc hbf_run_free(run: ?^HbfRun) destroys run
    proc hbf_subset(fonte: ?^HbfFont, gids: ?^u32, n_gids: u64, flags: u32) -> ?^HbfBytes creates
    proc hbf_bytes_len(bytes: ?^HbfBytes, saida: ?^u64) -> i32
    proc hbf_bytes_copy(bytes: ?^HbfBytes, saida: ?^u8, capacidade: u64) -> i32
    proc hbf_bytes_free(bytes: ?^HbfBytes) destroys bytes
    proc hbf_version() -> ?cstr
    proc hbf_shutdown() ends
}
