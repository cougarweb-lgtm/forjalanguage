// gerado por 'forja ligar' 0.8.1 a partir de cJSON.h; nao edite a mao (gere de novo).
// gerados: 96 (procs 78, tipos 2, consts 16, acessos 0); recusados: 7
// ajustes a mao (M6c P90, forja ligar 0.8.0 --propor; regenere e refaca estes):
//  1. `takes` a mao (o nome nao diz): cJSON_AddItemToArray/AddItemToObject/AddItemToObjectCS (takes item), cJSON_ReplaceItemInArray/InObject/InObjectCaseSensitive
//     (takes newitem) e cJSON_ReplaceItemViaPointer (takes replacement); o item entregue passa a ser do pai e sai dos vivos;
//  2. clausulas do --propor TIRADAS por falso positivo: cJSON_DeleteItemFromArray/FromObject/FromObjectCaseSensitive (removem um item, nao destroem o objeto),
//     cJSON_malloc/cJSON_free (rawptr cru, sem par do usuario).

pub struct CJson {
    next: ?^CJson
    prev: ?^CJson
    child: ?^CJson
    type: i32
    valuestring: rawptr
    valueint: i32
    valuedouble: f64
    string: rawptr
}

pub struct CJsonHooks {
    malloc_fn: rawptr
    free_fn: rawptr
}

// layout CJson struct~cJSON tamanho=64 alinhamento=8 next:next=0 prev:prev=8 child:child=16 type:type=24 valuestring:valuestring=32 valueint:valueint=40 valuedouble:valuedouble=48 string:string=56
static_assert(size_of(CJson) == 64, msg = "layout de CJson: tamanho difere da libclang")
static_assert(align_of(CJson) == 8, msg = "layout de CJson: alinhamento difere da libclang")
static_assert(offset_of(CJson.next) == 0, msg = "layout de CJson: offset de next difere da libclang")
static_assert(offset_of(CJson.prev) == 8, msg = "layout de CJson: offset de prev difere da libclang")
static_assert(offset_of(CJson.child) == 16, msg = "layout de CJson: offset de child difere da libclang")
static_assert(offset_of(CJson.type) == 24, msg = "layout de CJson: offset de type difere da libclang")
static_assert(offset_of(CJson.valuestring) == 32, msg = "layout de CJson: offset de valuestring difere da libclang")
static_assert(offset_of(CJson.valueint) == 40, msg = "layout de CJson: offset de valueint difere da libclang")
static_assert(offset_of(CJson.valuedouble) == 48, msg = "layout de CJson: offset de valuedouble difere da libclang")
static_assert(offset_of(CJson.string) == 56, msg = "layout de CJson: offset de string difere da libclang")

// layout CJsonHooks struct~cJSON_Hooks tamanho=16 alinhamento=8 malloc_fn:malloc_fn=0 free_fn:free_fn=8
static_assert(size_of(CJsonHooks) == 16, msg = "layout de CJsonHooks: tamanho difere da libclang")
static_assert(align_of(CJsonHooks) == 8, msg = "layout de CJsonHooks: alinhamento difere da libclang")
static_assert(offset_of(CJsonHooks.malloc_fn) == 0, msg = "layout de CJsonHooks: offset de malloc_fn difere da libclang")
static_assert(offset_of(CJsonHooks.free_fn) == 8, msg = "layout de CJsonHooks: offset de free_fn difere da libclang")

pub const CJSON_VERSION_MAJOR: i32 = 1
pub const CJSON_VERSION_MINOR: i32 = 7
pub const CJSON_VERSION_PATCH: i32 = 19
pub const C_JSON_INVALID: i32 = 0
pub const C_JSON_FALSE: i32 = 1
pub const C_JSON_TRUE: i32 = 2
pub const C_JSON_NULL: i32 = 4
pub const C_JSON_NUMBER: i32 = 8
pub const C_JSON_STRING: i32 = 16
pub const C_JSON_ARRAY: i32 = 32
pub const C_JSON_OBJECT: i32 = 64
pub const C_JSON_RAW: i32 = 128
pub const C_JSON_IS_REFERENCE: i32 = 256
pub const C_JSON_STRING_IS_CONST: i32 = 512
pub const CJSON_NESTING_LIMIT: i32 = 1000
pub const CJSON_CIRCULAR_LIMIT: i32 = 10000

