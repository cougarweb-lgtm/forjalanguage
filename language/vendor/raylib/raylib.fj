}

pub struct Camera3D {
    position: Vector3
    target: Vector3
    up: Vector3
    fovy: f32
    projection: i32
}

pub struct Camera2D {
    offset: Vector2
    target: Vector2
    rotation: f32
    zoom: f32
}

pub struct Mesh {
    vertex_count: i32
    triangle_count: i32
    vertices: ?^f32
    texcoords: ?^f32
    texcoords2: ?^f32
    normals: ?^f32
    tangents: ?^f32
    colors: ?^u8
    indices: ?^u16
    bone_count: i32
    bone_indices: ?^u8
    bone_weights: ?^f32
    anim_vertices: ?^f32
    anim_normals: ?^f32
    vao_id: u32
    vbo_id: ?^u32
}

pub struct Shader {
    id: u32
    locs: ?^i32
}

pub struct MaterialMap {
    texture: Texture
    color: Color
    value: f32
}

pub struct Material {
    shader: Shader
    maps: ?^MaterialMap
    params: [4]f32
}

pub struct Transform {
    translation: Vector3
    rotation: Vector4
    scale: Vector3
}

pub struct BoneInfo {
    name: [32]i8
    parent: i32
}

pub struct ModelSkeleton {
    bone_count: u32
    bones: ?^BoneInfo
    bind_pose: ?^Transform
}

pub struct Model {
    transform: Matrix
    mesh_count: i32
    material_count: i32
    meshes: ?^Mesh
    materials: ?^Material
    mesh_material: ?^i32
    skeleton: ModelSkeleton
    current_pose: ?^Transform
    bone_matrices: ?^Matrix
}

pub struct ModelAnimation {
    name: [32]i8
    bone_count: u32
    keyframe_count: i32
    keyframe_poses: ?^?^Transform
}

pub struct Ray {
    position: Vector3
    direction: Vector3
}

pub struct RayCollision {
    hit: bool
    distance: f32
    point: Vector3
    normal: Vector3
}

pub struct BoundingBox {
    min: Vector3
    max: Vector3
}

pub struct Wave {
    frame_count: u32
    sample_rate: u32
    sample_size: u32
    channels: u32
    data: rawptr
}

pub struct AudioStream {
    buffer: ?^RAudioBuffer
    processor: ?^RAudioProcessor
    sample_rate: u32
    sample_size: u32
    channels: u32
}

pub struct Sound {
    stream: AudioStream
    frame_count: u32
}

pub struct Music {
    stream: AudioStream
    frame_count: u32
    looping: bool
    ctx_type: i32
    ctx_data: rawptr
}

pub struct VrDeviceInfo {
    h_resolution: i32
    v_resolution: i32
    h_screen_size: f32
    v_screen_size: f32
    eye_to_screen_distance: f32
    lens_separation_distance: f32
    interpupillary_distance: f32
    lens_distortion_values: [4]f32
    chroma_ab_correction: [4]f32
}

pub struct VrStereoConfig {
    projection: [2]Matrix
    view_offset: [2]Matrix
    left_lens_center: [2]f32
    right_lens_center: [2]f32
    left_screen_center: [2]f32
    right_screen_center: [2]f32
    scale: [2]f32
    scale_in: [2]f32
}

pub struct FilePathList {
    count: u32
    paths: ?^?^i8
}

pub struct AutomationEvent {
    frame: u32
    type: u32
    params: [4]i32
}

pub struct AutomationEventList {
    capacity: u32
    count: u32
    events: ?^AutomationEvent
}

