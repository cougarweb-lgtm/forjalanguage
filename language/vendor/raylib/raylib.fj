}

pub struct Texture {
    id: u32
    width: i32
    height: i32
    mipmaps: i32
    format: i32
}

pub struct RenderTexture {
    id: u32
    texture: Texture
    depth: Texture
}

pub struct NPatchInfo {
    source: Rectangle
    left: i32
    top: i32
    right: i32
    bottom: i32
    layout: i32
}

pub struct GlyphInfo {
    value: i32
    offset_x: i32
    offset_y: i32
    advance_x: i32
