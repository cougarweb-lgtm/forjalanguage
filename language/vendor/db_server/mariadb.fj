pub const MYSQL_OPT_CONNECT_TIMEOUT: i32 = 0
pub const MYSQL_SET_CHARSET_NAME: i32 = 7
pub const MYSQL_OPT_READ_TIMEOUT: i32 = 11
pub const MYSQL_OPT_WRITE_TIMEOUT: i32 = 12
pub const MYSQL_OPT_RECONNECT: i32 = 20

pub foreign {
    link "mariadb"
    opaque StMysql
    opaque StMysqlRes
    proc mysql_init(mysql: ?^StMysql) -> ?^StMysql
    proc mysql_real_connect(mysql: ?^StMysql, host: cstr, user: cstr, passwd: cstr, db: cstr, port: u32, unix_socket: cstr, clientflag: c_ulong) -> ?^StMysql
    proc mysql_close(sock: ?^StMysql)
    proc mysql_options(mysql: ?^StMysql, option: i32, arg: rawptr) -> i32
    proc mysql_set_character_set(mysql: ?^StMysql, csname: cstr) -> i32
    proc mysql_ping(mysql: ?^StMysql) -> i32
    proc mysql_errno(mysql: ?^StMysql) -> u32
    proc mysql_error(mysql: ?^StMysql) -> ?cstr
    proc mysql_sqlstate(mysql: ?^StMysql) -> ?cstr
    proc mysql_query(mysql: ?^StMysql, q: cstr) -> i32
    proc mysql_store_result(mysql: ?^StMysql) -> ?^StMysqlRes
    proc mysql_free_result(result: ?^StMysqlRes)
    proc mysql_num_rows(res: ?^StMysqlRes) -> u64
    proc mysql_num_fields(res: ?^StMysqlRes) -> u32
    proc mysql_fetch_row(result: ?^StMysqlRes) -> ?^cstr
    proc mysql_fetch_lengths(result: ?^StMysqlRes) -> ?^c_ulong
    proc mysql_affected_rows(mysql: ?^StMysql) -> u64
    proc mysql_insert_id(mysql: ?^StMysql) -> u64
    proc mysql_real_escape_string(mysql: ?^StMysql, to: ?^i8, from: cstr, length: c_ulong) -> c_ulong
    proc mysql_get_client_info() -> ?cstr
    proc mysql_get_client_version() -> c_ulong
}
