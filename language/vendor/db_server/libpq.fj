pub enum ConnStatusType {
    ok
    bad
    started
    made
    awaiting_response
    auth_ok
    setenv
    ssl_startup
    needed
    check_writable
    consume
    gss_startup
    check_target
    check_standby
    allocated
    authenticating
}

pub enum PostgresPollingStatusType {
    failed
    reading
    writing
    ok
    active
}

pub enum ExecStatusType {
    empty_query
    command_ok
    tuples_ok
    copy_out
    copy_in
    bad_response
    nonfatal_error
    fatal_error
    copy_both
    single_tuple
    pipeline_sync
    pipeline_aborted
    tuples_chunk
}

pub enum PGTransactionStatusType {
    idle
    active
    intrans
    inerror
    unknown
}

pub enum PGVerbosity {
    pqerrors_terse
    pqerrors_default
    pqerrors_verbose
    pqerrors_sqlstate
}

pub enum PGContextVisibility {
    never
    errors
    always
}

pub enum PGPing {
    ok
    reject
    no_response
    no_attempt
}

pub enum PGpipelineStatus {
    off
    on
    aborted
}

pub enum PGauthData {
    prompt_oauth_device
    oauth_bearer_token
}

pub struct PgNotify {
    relname: rawptr
    be_pid: i32
    extra: rawptr
    next: ?^PgNotify
}

pub struct PQprintOpt {
    header: i8
    align: i8
    standard: i8
    html3: i8
    expanded: i8
    pager: i8
    field_sep: rawptr
    table_opt: rawptr
    caption: rawptr
    field_name: ?^?^i8
}

pub struct PQconninfoOption {
    keyword: rawptr
    envvar: rawptr
    compiled: rawptr
    val: rawptr
    label: rawptr
    dispchar: rawptr
    dispsize: i32
}

pub struct PgresAttDesc {
    name: rawptr
    tableid: u32
    columnid: i32
    format: i32
    typid: u32
    typlen: i32
    atttypmod: i32
}

pub struct PGpromptOAuthDevice {
    verification_uri: rawptr
    user_code: rawptr
    verification_uri_complete: rawptr
    expires_in: i32
}

pub struct Iobuf {
    _placeholder: rawptr
}

