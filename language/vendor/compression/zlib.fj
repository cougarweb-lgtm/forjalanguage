// IA1-L3c3: UM ajuste a mao depois de gerar: o 'proc compress' foi tirado (nada o usava; compress2 faz o mesmo) porque compression.fj exporta 'compress' e o C gerado teria dois fj_compress; refaca ao regerar.
// P84 (16/11/2026): regerado com ligar 0.7.1; o 'len' dos parametros virou 'len_' (gerador 0.6.x) e as tipos uLong viraram c_ulong/c_long. Desvio aceito pelo main; sqlite3.fj fica no P90.

pub struct ZStreamS {
    next_in: ?^u8
    avail_in: u32
    total_in: c_ulong
    next_out: ?^u8
    avail_out: u32
    total_out: c_ulong
    msg: rawptr
    state: ?^InternalState
    zalloc: rawptr
    zfree: rawptr
    opaque: rawptr
    data_type: i32
    adler: c_ulong
    reserved: c_ulong
}

pub struct GzHeaderS {
    text: i32
    time: c_ulong
    xflags: i32
    os: i32
    extra: ?^u8
    extra_len: u32
    extra_max: u32
    name: ?^u8
    name_max: u32
    comment: ?^u8
    comm_max: u32
    hcrc: i32
    done: i32
}

pub struct GzFileS {
    have: u32
    next: ?^u8
    pos: i64
}

// layout ZStreamS struct~z_stream_s tamanho=88 alinhamento=8 next_in:next_in=0 avail_in:avail_in=8 total_in:total_in=12 next_out:next_out=16 avail_out:avail_out=24 total_out:total_out=28 msg:msg=32 state:state=40 zalloc:zalloc=48 zfree:zfree=56 opaque:opaque=64 data_type:data_type=72 adler:adler=76 reserved:reserved=80
// 0.7.1: struct com c_long/c_ulong: o tamanho segue o alvo (4 no Windows, 8 no Linux), sem static_assert; a prova nos 2 alvos e tests\nativo\m6c\clong\gzheader_layout.fj

// layout GzHeaderS struct~gz_header_s tamanho=72 alinhamento=8 text:text=0 time:time=4 xflags:xflags=8 os:os=12 extra:extra=16 extra_len:extra_len=24 extra_max:extra_max=28 name:name=32 name_max:name_max=40 comment:comment=48 comm_max:comm_max=56 hcrc:hcrc=60 done:done=64
// 0.7.1: struct com c_long/c_ulong: o tamanho segue o alvo (4 no Windows, 8 no Linux), sem static_assert; a prova nos 2 alvos e tests\nativo\m6c\clong\gzheader_layout.fj

// layout GzFileS struct~gzFile_s tamanho=24 alinhamento=8 have:have=0 next:next=8 pos:pos=16
static_assert(size_of(GzFileS) == 24, msg = "layout de GzFileS: tamanho difere da libclang")
static_assert(align_of(GzFileS) == 8, msg = "layout de GzFileS: alinhamento difere da libclang")
static_assert(offset_of(GzFileS.have) == 0, msg = "layout de GzFileS: offset de have difere da libclang")
static_assert(offset_of(GzFileS.next) == 8, msg = "layout de GzFileS: offset de next difere da libclang")
static_assert(offset_of(GzFileS.pos) == 16, msg = "layout de GzFileS: offset de pos difere da libclang")

