pub const ZLIBF_FORMATO_ZLIB: i32 = 0
pub const ZLIBF_FORMATO_RAW: i32 = 1
pub const ZLIBF_OK: i32 = 0
pub const ZLIBF_FIM: i32 = 1
pub const ZLIBF_ERRO_DADOS: i32 = -1
pub const ZLIBF_ERRO_MEMORIA: i32 = -2
pub const ZLIBF_ERRO_PARAMETRO: i32 = -3

pub foreign {
    link "z"
    opaque ZlibfFluxo
    proc zlibf_deflate_novo(nivel: i32, formato: i32) -> ?^ZlibfFluxo creates
    proc zlibf_inflate_novo(formato: i32) -> ?^ZlibfFluxo creates
    proc zlibf_processar(fluxo: ?^ZlibfFluxo, entrada: ?^u8, n_entrada: u64, saida: ?^u8, cap_saida: u64, terminar: i32, consumidos: ?^u64, gravados: ?^u64) -> i32
    proc zlibf_fechar(fluxo: ?^ZlibfFluxo) destroys fluxo
}
