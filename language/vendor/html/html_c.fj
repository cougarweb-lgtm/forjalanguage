// gerado por 'forja ligar' 0.9.0 a partir de lexborf.h e ajustado a mao (M6c): nao edite a mao sem regerar e refazer estes ajustes.
// gerados: 27 (procs 25, tipos 2, consts 0, acessos 0); recusados: 0
// ajustes a mao:
//  1. clausulas creates/destroys (o forja ligar nao as propoe sem --propor): lexborf_parse/lexborf_css_parse criam o handle;
//     lexborf_free/lexborf_css_free destroem o do parametro;
//  2. textos devolvidos como ?cstr (antes ?^u8): a cola entrega copias terminadas em NUL que vivem ate o free do dono;
//     o `len_` continua na assinatura C (o cstr nao carrega tamanho) e a ponte passa none.

pub foreign {
    link "lexbor"
    opaque LexborfDoc
    opaque LexborfSheet
    proc lexborf_parse(html: ?^u8, len_: u64) -> ?^LexborfDoc creates
    proc lexborf_free(d: ?^LexborfDoc) destroys d
    proc lexborf_node_count(d: ?^LexborfDoc) -> i32
    proc lexborf_node_type(d: ?^LexborfDoc, i: i32) -> i32
    proc lexborf_parent(d: ?^LexborfDoc, i: i32) -> i32
    proc lexborf_first_child(d: ?^LexborfDoc, i: i32) -> i32
    proc lexborf_next_sibling(d: ?^LexborfDoc, i: i32) -> i32
    proc lexborf_tag_name(d: ?^LexborfDoc, i: i32, len_: ?^u64) -> ?cstr
    proc lexborf_namespace(d: ?^LexborfDoc, i: i32) -> i32
    proc lexborf_attr_count(d: ?^LexborfDoc, i: i32) -> i32
    proc lexborf_attr_name(d: ?^LexborfDoc, i: i32, k: i32, len_: ?^u64) -> ?cstr
    proc lexborf_attr_value(d: ?^LexborfDoc, i: i32, k: i32, len_: ?^u64) -> ?cstr
    proc lexborf_text(d: ?^LexborfDoc, i: i32, len_: ?^u64) -> ?cstr
    proc lexborf_find_all(d: ?^LexborfDoc, root: i32, selector: ?^u8, sel_len: u64, out: ?^i32, cap: i32) -> i32
    proc lexborf_css_parse(css: ?^u8, len_: u64) -> ?^LexborfSheet creates
    proc lexborf_css_free(s: ?^LexborfSheet) destroys s
    proc lexborf_css_rule_count(s: ?^LexborfSheet) -> i32
    proc lexborf_css_atrule_count(s: ?^LexborfSheet) -> i32
    proc lexborf_css_rule_selector(s: ?^LexborfSheet, r: i32, len_: ?^u64) -> ?cstr
    proc lexborf_css_rule_specificity(s: ?^LexborfSheet, r: i32) -> i32
    proc lexborf_css_decl_count(s: ?^LexborfSheet, r: i32) -> i32
    proc lexborf_css_decl_name(s: ?^LexborfSheet, r: i32, k: i32, len_: ?^u64) -> ?cstr
    proc lexborf_css_decl_value(s: ?^LexborfSheet, r: i32, k: i32, len_: ?^u64) -> ?cstr
    proc lexborf_css_decl_important(s: ?^LexborfSheet, r: i32, k: i32) -> i32
    proc lexborf_version() -> ?cstr
}
