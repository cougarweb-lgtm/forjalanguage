// std:sync - Mutex e Cond (M5 P48; funcoes no P49). API em ingles (ADR-39); o corpo chama o runtime direto (forja_sync_*, rt_sync_win.c / forja_rt_sync.h).
// Changelog: 0.2.0 - M5 P49: lock, unlock, try_lock (Mutex) e wait, wait_ms, signal, broadcast (Cond) sobre SRWLOCK e CONDITION_VARIABLE (Windows). Linux = X0003 (M5c-b).
// Changelog: 0.1.0 - M5 P48: Mutex e Cond como struct de 1 palavra com padrao 0 (valor zero valido); marcados como nao copiaveis (E0339, sem_naocopia.c).
// Copia de Mutex ou Cond e recusada pelo compilador; passe ^Mutex (o endereco).

foreign {
    proc forja_sync_travar(m: rawptr)
    proc forja_sync_soltar(m: rawptr)
    proc forja_sync_tentar(m: rawptr) -> i32
    proc forja_sync_esperar(c: rawptr, m: rawptr)
    proc forja_sync_esperar_ms(c: rawptr, m: rawptr, ms: u32) -> i32
    proc forja_sync_sinalizar(c: rawptr)
    proc forja_sync_difundir(c: rawptr)
}

pub struct Mutex {
    palavra: u64 = 0
}

pub struct Cond {
    palavra: u64 = 0
}

// Trava o Mutex; espera se outra thread o tem.
pub proc lock(m: ^Mutex) {
    forja_sync_travar(m as rawptr)
}

// Solta o Mutex (quem trava tem de soltar, na mesma thread).
pub proc unlock(m: ^Mutex) {
    forja_sync_soltar(m as rawptr)
}

// Tenta travar sem esperar: true = travou, false = outra thread tem o Mutex.
pub proc try_lock(m: ^Mutex) -> bool {
    return forja_sync_tentar(m as rawptr) != 0
}

// Solta m, espera um signal/broadcast em c e volta com m travado de novo.
pub proc wait(c: ^Cond, m: ^Mutex) {
    forja_sync_esperar(c as rawptr, m as rawptr)
}

// Igual a wait, com limite de ms: true = acordou; false = expirou sem sinal (m volta travado nos dois casos).
pub proc wait_ms(c: ^Cond, m: ^Mutex, ms: u32) -> bool {
    return forja_sync_esperar_ms(c as rawptr, m as rawptr, ms) != 0
}

// Acorda uma thread esperando em c.
pub proc signal(c: ^Cond) {
    forja_sync_sinalizar(c as rawptr)
}

// Acorda todas as threads esperando em c.
pub proc broadcast(c: ^Cond) {
    forja_sync_difundir(c as rawptr)
}
