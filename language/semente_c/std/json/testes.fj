// std:json (J08) - testes do modulo: corpus JSONTestSuite (validos e invalidos), consulta por caminho e escrita.
// Versao: 0.2.0. Changelog: 0.1.0 - conversao do teste antigo (main + .esperado) para test/expect: corpus em tabela (26 validos, 24 invalidos) percorrida por helper que imprime o 1o documento que falha; consulta e escrita com um expect por linha do esperado. 0.2.0 - J1: limites do inteiro (i64/u64 e range), set_int/push_int, percurso first/next, quote e arquivo (write_file/parse_file).
// Sem import e sem proc main: o pedaco fica dentro do modulo, entao chama as procs dele SEM prefixo.

struct EscritaSaida {
    inicial: str = ""
    sem_campo: str = ""
    tamanho: i32 = 0
    sem_item: str = ""
    ida_volta: bool = false
}

// Documento com n niveis de colchetes, sem valor dentro (o corpus usa 500 e 501).
proc aninhado(n: int, a: mem.Arena) -> str {
    let abre = tx.repeat("[", n, alloc = a)
    let fecha = tx.repeat("]", n, alloc = a)
    return format(f"{abre}{fecha}", alloc = a)
}

// "ok" se parse(dump) reproduz o mesmo texto, "DIFERENTE" se muda, "falhou" se o parse recusa.
proc ida_volta_estado(txt: str, a: mem.Arena) -> str {
    var estado = "falhou"
    switch s in parse(txt, alloc = a) {
    case Json:
        let txt2 = dump(s, false, alloc = a) or_else ""
        if txt2 == txt {
            estado = "ok"
        } else {
            estado = "DIFERENTE"
        }
    case JsonError:
        estado = "falhou"
    }
    return estado
}

// Linha do documento no formato do teste antigo, sem o numero: "valido ..." com a ida e volta, ou "invalido linha:coluna causa".
proc resultado_documento(texto: str, a: mem.Arena) -> str {
    var pos = JsonPos{}
    var linha = ""
    switch r in parse(texto, where = &pos, alloc = a) {
    case Json:
        let txt = dump(r, false, alloc = a) or_else ""
        let estado = ida_volta_estado(txt, a)
        let tam = len(txt)
        if tam > 60 {
            linha = format(f"valido len {tam}\n  ida-volta {estado}", alloc = a)
        } else {
            linha = format(f"valido {txt}\n  ida-volta {estado}", alloc = a)
        }
    case JsonError:
        linha = format(f"invalido {pos.linha}:{pos.coluna} {pos.causa}", alloc = a)
    }
    return linha
}

// Compara cada documento com o esperado; devolve o indice do 1o que falha (-1 se todos batem) e imprime esse documento.
proc primeiro_falho(docs: []str, esperados: []str, a: mem.Arena) -> int {
    var falho = -1
    for i in 0..<len(docs) {
        let obtido = resultado_documento(docs[i], a)
        if obtido != esperados[i] {
            let doc = docs[i]
            let esperado = esperados[i]
            print(f"documento falhou: {doc} | esperado: {esperado} | obtido: {obtido}")
            falho = i
            break
        }
    }
    return falho
}

// Documento da consulta (mesmo texto do teste antigo).
proc doc_consulta(a: mem.Arena) -> Json ! JsonError {
    let d = try parse("{\"a\":{\"b\":[10,20.5],\"c\":\"oi\"},\"t\":true}", alloc = a)
    return d
}

// Escrita: monta o documento, muda campos, remove um item e confere a ida e volta.
proc escrever_documento(a: mem.Arena) -> EscritaSaida ! JsonError {
    let o = try new_object(a)
    try set_number(o, name = "n", value = 2.5)
    try set_text(o, name = "s", value = "oi")
    try set_bool(o, name = "b", value = true)
    try set_null(o, name = "z")
    let l = try set_list(o, name = "l")
    try push_number(l, value = 7.0)
    try push_text(l, value = "x")
    let inicial = try dump(o, false, alloc = a)
    try remove_field(o, name = "s")
    let sem_campo = try dump(o, false, alloc = a)
    let tamanho = size(o)
    try remove_item(l, 0)
    let sem_item = try dump(o, false, alloc = a)
    let txt = try dump(o, false, alloc = a)
    let de_novo = try parse(txt, alloc = a)
    let txt2 = try dump(de_novo, false, alloc = a)
    return EscritaSaida{inicial = inicial, sem_campo = sem_campo, tamanho = tamanho, sem_item = sem_item, ida_volta = txt2 == txt}
}

test "documentos validos do corpus batem com o esperado e fazem ida e volta" {
    let a = mem.arena_create()
    defer mem.arena_destroy(a)
    var docs: [26]str = {
        "{}", "[]", "0", "-0", "\"\\u00e9\"", "\"\\ud83d\\ude00\"", "[1,2,3]",
        "{\"a\":{\"b\":[10,20.5]}}", "true", "false", "null", "1e2", "-1.5E-3",
        "9007199254740993", "[[[[]]]]", "{\"\":0}", "  \n\t[ 1 , 2 ]  \r\n",
        "\"a\\/b\\\\c\\\"d\\b\\f\\n\\r\\t\"", "[{\"k\":null},{\"k\":false}]", "1e400",
        "123456789012345678901234567890", "\"x\"", "", "{\n\"a\":\n[1,\n2]\n}",
        "1E+2", "\"\\u0000\""
    }
    docs[22] = aninhado(500, a)
    var esperados: [26]str = {
        "valido {}\n  ida-volta ok", "valido []\n  ida-volta ok", "valido 0\n  ida-volta ok",
        "valido -0\n  ida-volta ok", "valido \"é\"\n  ida-volta ok", "valido \"😀\"\n  ida-volta ok",
        "valido [1,2,3]\n  ida-volta ok", "valido {\"a\":{\"b\":[10,20.5]}}\n  ida-volta ok",
        "valido true\n  ida-volta ok", "valido false\n  ida-volta ok", "valido null\n  ida-volta ok",
        "valido 1e2\n  ida-volta ok", "valido -1.5E-3\n  ida-volta ok",
        "valido 9007199254740993\n  ida-volta ok", "valido [[[[]]]]\n  ida-volta ok",
        "valido {\"\":0}\n  ida-volta ok", "valido [1,2]\n  ida-volta ok",
        "valido \"a/b\\\\c\\\"d\\b\\f\\n\\r\\t\"\n  ida-volta ok",
        "valido [{\"k\":null},{\"k\":false}]\n  ida-volta ok", "valido 1e400\n  ida-volta ok",
        "valido 123456789012345678901234567890\n  ida-volta ok", "valido \"x\"\n  ida-volta ok",
        "valido len 1000\n  ida-volta ok", "valido {\"a\":[1,2]}\n  ida-volta ok",
        "valido 1E+2\n  ida-volta ok", "valido \"\\u0000\"\n  ida-volta ok"
    }
    let falho = primeiro_falho(docs[..], esperados[..], a)
    expect(falho == -1)
}

test "documentos invalidos sao recusados com linha e coluna" {
    let a = mem.arena_create()
    defer mem.arena_destroy(a)
    var docs: [24]str = {
        "[1,]", "01", "[01]", "1.", ".5", "+1", "\"\\u00e\"", "\"\\ud83d\"", "\"\\ude00\"",
        "\"abc", "{\"a\" 1}", "{\"a\":1,}", "[1 2]", "nul", "tru", "{} x", "\"\\x41\"",
        "\"a\tb\"", "-", "1e", "[", "", "{\n  \"a\": 1,\n  \"b\" 2\n}", "[1, 2, 3"
    }
    docs[21] = aninhado(501, a)
    var esperados: [24]str = {
        "invalido 1:4 valor esperado", "invalido 1:2 texto depois do valor",
        "invalido 1:3 ',' ou ']' esperado", "invalido 1:3 digito esperado depois do ponto",
        "invalido 1:1 valor esperado", "invalido 1:1 valor esperado",
        "invalido 1:2 \\u exige 4 digitos hexadecimais",
        "invalido 1:8 substituto alto sem o substituto baixo que vem depois",
        "invalido 1:2 substituto baixo sem alto antes", "invalido 1:5 string sem aspa de fecho",
        "invalido 1:6 ':' esperado depois do nome do campo",
        "invalido 1:8 nome de campo entre aspas esperado", "invalido 1:4 ',' ou ']' esperado",
        "invalido 1:1 literal invalido (true, false ou null)",
        "invalido 1:1 literal invalido (true, false ou null)", "invalido 1:4 texto depois do valor",
        "invalido 1:2 escape invalido (use \\ \" / b f n r t u)",
        "invalido 1:3 caractere de controle dentro da string", "invalido 1:2 digito esperado depois do sinal",
        "invalido 1:3 digito esperado no expoente", "invalido 1:2 fim do texto: valor esperado",
        "invalido 1:501 aninhamento acima de 500", "invalido 3:7 ':' esperado depois do nome do campo",
        "invalido 1:9 ',' ou ']' esperado"
    }
    let falho = primeiro_falho(docs[..], esperados[..], a)
    expect(falho == -1)
}

test "consulta: caminho, campo e texto" {
    let a = mem.arena_create()
    defer mem.arena_destroy(a)
    switch r in doc_consulta(a) {
    case Json:
        expect((path_int(r, path = "a.b[0]") or_else -1) == 10)
        expect((path_number(r, path = "a.b[1]") or_else -1.0) == 20.5)
        expect((path_text(r, path = "a.c") or_else "erro") == "oi")
        expect((field_bool(r, name = "t") or_else false) == true)
        expect((path_text(r, path = "a.x") or_else "erro") == "erro")
    case JsonError:
        expect(false)
    }
}

test "consulta: erro de caminho devolve a posicao" {
    let a = mem.arena_create()
    defer mem.arena_destroy(a)
    switch r in doc_consulta(a) {
    case Json:
        var onde = 0
        expect((path_text(r, path = "a.x[0]", at = &onde) or_else "erro") == "erro")
        expect(onde == 2)
        var onde2 = 0
        switch g in get_path(r, "a..b", at = &onde2) {
        case Json:
            expect(false)
        case JsonError:
            expect(onde2 == 2)
        }
    case JsonError:
        expect(false)
    }
}

test "consulta: tamanho, tipo, chave e inteiro grande" {
    let a = mem.arena_create()
    defer mem.arena_destroy(a)
    switch r in doc_consulta(a) {
    case Json:
        switch b in get_path(r, "a.b") {
        case Json:
            expect(size(b) == 2)
            expect(kind(b) == JsonKind.list)
        case JsonError:
            expect(false)
        }
        expect((key(r, index = 0) or_else "?") == "a")
    case JsonError:
        expect(false)
    }
    switch grande in parse("123456789012345678901234567890", alloc = a) {
    case Json:
        expect((path_int(grande, path = "") or_else -1) == -1)
    case JsonError:
        expect(false)
    }
}

test "escrita: monta, muda campos, remove item e ida e volta" {
    let a = mem.arena_create()
    defer mem.arena_destroy(a)
    switch r in escrever_documento(a) {
    case EscritaSaida:
        expect(r.inicial == "{\"n\":2.5,\"s\":\"oi\",\"b\":true,\"z\":null,\"l\":[7,\"x\"]}")
        expect(r.sem_campo == "{\"n\":2.5,\"b\":true,\"z\":null,\"l\":[7,\"x\"]}")
        expect(r.tamanho == 4)
        expect(r.sem_item == "{\"n\":2.5,\"b\":true,\"z\":null,\"l\":[\"x\"]}")
        expect(r.ida_volta)
    case JsonError:
        expect(false)
    }
}

// Parse e leitura do inteiro com sinal; o erro (range, wrong_type) segue como esta.
proc integer_de(texto: str, a: mem.Arena) -> i64 ! JsonError {
    let d = try parse(texto, alloc = a)
    let v = try integer(d)
    return v
}

// Parse e leitura do inteiro sem sinal; mesmo contrato de integer_de.
proc uinteger_de(texto: str, a: mem.Arena) -> u64 ! JsonError {
    let d = try parse(texto, alloc = a)
    let v = try uinteger(d)
    return v
}

// Escrita com set_int e push_int: o inteiro grande e o negativo saem como estao.
proc escrever_inteiros(a: mem.Arena) -> str ! JsonError {
    let o = try new_object(a)
    try set_int(o, name = "x", value = 9007199254740993)
    let l = try set_list(o, name = "l")
    try push_int(l, value = -5)
    let txt = try dump(o, false, alloc = a)
    return txt
}

// Conta os filhos de um objeto ou lista pelo percurso first/next.
proc conta_filhos(j: Json) -> int {
    var c = first(j)
    var n = 0
    while c != none {
        n += 1
        c = next(c or_else j)
    }
    return n
}

// Chaves do objeto na ordem do percurso, cada uma seguida de ';'.
proc chaves_do_objeto(j: Json, a: mem.Arena) -> str {
    var c = first(j)
    var chaves = ""
    while c != none {
        let v = c or_else j
        chaves = format(f"{chaves}{key_of(v)};", alloc = a)
        c = next(v)
    }
    return chaves
}

// Inteiros dos itens da lista na ordem do percurso, cada um seguido de ';' (-1 se o item nao e inteiro).
proc valores_da_lista(j: Json, a: mem.Arena) -> str {
    var c = first(j)
    var txt = ""
    while c != none {
        let v = c or_else j
        let n = integer(v) or_else -1
        txt = format(f"{txt}{n};", alloc = a)
        c = next(v)
    }
    return txt
}

// Grava o documento em `caminho` com pretty, le de volta com parse_file e diz se o dump compacto bate.
proc arquivo_ida_volta(texto: str, caminho: str, a: mem.Arena) -> bool ! JsonError {
    let orig = try parse(texto, alloc = a)
    try write_file(orig, caminho, pretty = true)
    let lido = try parse_file(caminho, alloc = a)
    let esperado = try dump(orig, false, alloc = a)
    let obtido = try dump(lido, false, alloc = a)
    return esperado == obtido
}

test "inteiro: limites do i64 e erro de faixa" {
    let a = mem.arena_create()
    defer mem.arena_destroy(a)
    switch maximo in integer_de("9223372036854775807", a) {
    case i64:
        expect(maximo == 9223372036854775807)
    case JsonError:
        expect(false)
    }
    switch minimo in integer_de("-9223372036854775808", a) {
    case i64:
        expect(minimo == -9223372036854775808)
    case JsonError:
        expect(false)
    }
    switch acima in integer_de("9223372036854775808", a) {
    case i64:
        expect(false)
    case JsonError:
        expect(acima == JsonError.range)
    }
    switch grande in integer_de("1e300", a) {
    case i64:
        expect(false)
    case JsonError:
        expect(grande == JsonError.range)
    }
    switch pequeno in integer_de("-1e300", a) {
    case i64:
        expect(false)
    case JsonError:
        expect(pequeno == JsonError.range)
    }
}

test "inteiro sem sinal: limites do u64 e negativo" {
    let a = mem.arena_create()
    defer mem.arena_destroy(a)
    switch maximo in uinteger_de("18446744073709551615", a) {
    case u64:
        expect(maximo == 18446744073709551615)
    case JsonError:
        expect(false)
    }
    switch acima in uinteger_de("18446744073709551616", a) {
    case u64:
        expect(false)
    case JsonError:
        expect(acima == JsonError.range)
    }
    switch meio in uinteger_de("9223372036854775808", a) {
    case u64:
        expect(meio == 9223372036854775808)
    case JsonError:
        expect(false)
    }
    switch negativo in uinteger_de("-1", a) {
    case u64:
        expect(false)
    case JsonError:
        expect(negativo == JsonError.range)
    }
    switch grande in uinteger_de("1e300", a) {
    case u64:
        expect(false)
    case JsonError:
        expect(grande == JsonError.range)
    }
}

test "inteiro: numero com ponto e trunca" {
    let a = mem.arena_create()
    defer mem.arena_destroy(a)
    switch com_sinal in integer_de("2.9", a) {
    case i64:
        expect(com_sinal == 2)
    case JsonError:
        expect(false)
    }
    switch sem_sinal in uinteger_de("2.9", a) {
    case u64:
        expect(sem_sinal == 2)
    case JsonError:
        expect(false)
    }
}

test "set_int e push_int: inteiro grande e negativo no dump" {
    let a = mem.arena_create()
    defer mem.arena_destroy(a)
    switch r in escrever_inteiros(a) {
    case str:
        expect(r == "{\"x\":9007199254740993,\"l\":[-5]}")
    case JsonError:
        expect(false)
    }
}

test "percurso first/next: chaves na ordem, itens da lista e none" {
    let a = mem.arena_create()
    defer mem.arena_destroy(a)
    switch r in parse("{\"a\":1,\"b\":[2,3]}", alloc = a) {
    case Json:
        expect(conta_filhos(r) == 2)
        expect(chaves_do_objeto(r, a) == "a;b;")
        switch campo_b in field(r, name = "b") {
        case Json:
            expect(conta_filhos(campo_b) == 2)
            expect(valores_da_lista(campo_b, a) == "2;3;")
            expect(key_of(first(campo_b) or_else campo_b) == "")
        case JsonError:
            expect(false)
        }
        switch numero in field(r, name = "a") {
        case Json:
            expect(first(numero) == none)
        case JsonError:
            expect(false)
        }
    case JsonError:
        expect(false)
    }
}

test "quote: aspas e escapes" {
    let a = mem.arena_create()
    defer mem.arena_destroy(a)
    expect(quote("a\"\n", alloc = a) == "\"a\\\"\\n\"")
    expect(quote("", alloc = a) == "\"\"")
}

test "arquivo: write_file, parse_file e erro de arquivo inexistente" {
    let a = mem.arena_create()
    defer mem.arena_destroy(a)
    switch caminho in file.make_temp_file("jsonj1", alloc = a) {
    case str:
        switch igual in arquivo_ida_volta("{\"x\":1,\"y\":[true,\"s\"]}", caminho, a) {
        case bool:
            expect(igual)
        case JsonError:
            expect(false)
        }
        expect(file.remove_file(caminho) == none)
    case file.FileError:
        expect(false)
    }
    switch falta in parse_file("nao_existe_j1.json", alloc = a) {
    case Json:
        expect(false)
    case JsonError:
        expect(falta == JsonError.file)
    }
}
