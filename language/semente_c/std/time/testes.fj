// std:time - testes do modulo (S4 P6). Anexados ao texto de std:time SO em forja test std:time (o build normal nao os ve).
// Versao: 0.2.0. Changelog: 0.2.0 - R2: TZif (fixture de Sao_Paulo em hex), format_iso_offset, parse_iso_offset, format_rfc5322, local_offset_s e comparacao com o Python no Windows (FORJA_FUSO_ESPERADO). 0.1.0 - S4 P6: calendario UTC, ida e volta de nanossegundos, ISO 8601 (format/parse, erros), add_days/add_seconds e bissextos, com os valores da fixture 216 (.esperado). Sem Stopwatch, sem now() e sem relogio (nao deterministico).
// Sem import e sem proc main: o pedaco fica dentro do modulo, entao chama as procs dele SEM prefixo (from_unix_ns, format_iso...).
// Os helpers devolvem bool: o erro do ! TimeError vira falso em vez de quebrar o teste.

proc iso_igual(ns: int, esperado: str) -> bool {
    let texto = format_iso(from_unix_ns(ns), alloc = heap)
    defer delete(texto)
    return texto == esperado
}

proc iso_dt_igual(dt: DateTime, esperado: str) -> bool {
    let texto = format_iso(dt, alloc = heap)
    defer delete(texto)
    return texto == esperado
}

proc ida_volta_igual(ns: int) -> bool {
    var ok = false
    switch r in to_unix_ns(from_unix_ns(ns)) {
    case int: ok = r == ns
    case TimeError: ok = false
    }
    return ok
}

proc parse_erro_igual(s: str, esperado: TimeError) -> bool {
    var ok = false
    switch r in parse_iso(s) {
    case DateTime: ok = false
    case TimeError: ok = r == esperado
    }
    return ok
}

test "calendario epoca e fronteiras de ano" {
    expect(iso_igual(0, "1970-01-01T00:00:00Z"))
    expect(iso_igual(1700000000000000000, "2023-11-14T22:13:20Z"))
    expect(iso_igual(1735689600000000000, "2025-01-01T00:00:00Z"))
    expect(iso_igual(-1000000000, "1969-12-31T23:59:59Z"))
    expect(iso_igual(-1, "1969-12-31T23:59:59.999999999Z"))
}

test "calendario bissextos 2000 e 2100" {
    expect(iso_igual(951782400000000000, "2000-02-29T00:00:00Z"))
    expect(iso_igual(951782399123000000, "2000-02-28T23:59:59.123Z"))
    expect(iso_igual(4107542400000000000, "2100-03-01T00:00:00Z"))
}

test "calendario antes de 1970 e limites de i64" {
    expect(iso_igual(-2208988800000000000, "1900-01-01T00:00:00Z"))
    expect(iso_igual(-9223372036854775807 - 1, "1677-09-21T00:12:43.145224192Z"))
    expect(iso_igual(9223372036854775807, "2262-04-11T23:47:16.854775807Z"))
}

test "ida e volta de nanossegundos" {
    expect(ida_volta_igual(0))
    expect(ida_volta_igual(1700000000000000000))
    expect(ida_volta_igual(1234567890000456000))
    expect(ida_volta_igual(-1))
    expect(ida_volta_igual(-9223372036854775807 - 1))
    expect(ida_volta_igual(9223372036854775807))
}

test "semana e dia do ano" {
    let epoca = from_unix_ns(0)
    expect(weekday(epoca) == 4)
    let novembro = from_unix_ns(1700000000000000000)
    expect(weekday(novembro) == 2)
    expect(day_of_year(novembro) == 318)
    let bissexto = from_unix_ns(951782400000000000)
    expect(day_of_year(bissexto) == 60)
}

test "bissextos e dias do mes" {
    expect(is_leap_year(2000))
    expect(is_leap_year(2024))
    expect(is_leap_year(1900) == false)
    expect(is_leap_year(2100) == false)
    expect(days_in_month(2024, 2) == 29)
    expect(days_in_month(2023, 2) == 28)
    expect(days_in_month(2023, 4) == 30)
    expect(days_in_month(2023, 12) == 31)
}

test "parse_iso aceita fracao de segundo" {
    var ok = false
    switch r in parse_iso("2026-11-13T00:30:05.123456789Z") {
    case DateTime: ok = iso_dt_igual(r, "2026-11-13T00:30:05.123456789Z")
    case TimeError: ok = false
    }
    expect(ok)
}

test "parse_iso erros de campo e de texto" {
    expect(parse_erro_igual("2026-13-01T00:00:00Z", TimeError.invalid_field))
    expect(parse_erro_igual("2026-11-13T00:30:05.1234567891Z", TimeError.invalid_text))
}

test "add_days e add_seconds cruzam o bissexto" {
    let dt = from_unix_ns(951782400000000000)
    expect(iso_dt_igual(add_days(dt, 1), "2000-03-01T00:00:00Z"))
    expect(iso_dt_igual(add_seconds(dt, -1), "2000-02-28T23:59:59Z"))
}

test "conversao de ms e segundos em nanossegundos" {
    expect(ms_to_ns(3) == 3000000)
    expect(seconds_to_ns(2) == 2000000000)
    expect(ns_to_ms(2500000) == 2)
}

// ---- R2: fuso, TZif, deslocamento no ISO e RFC 5322 (0.2.0 dos testes) ----
// SAO_PAULO_TZIF = tests\std\fixtures\America_Sao_Paulo.tzif (tzdata 2026f do Alpine, dominio publico; 1430 bytes) em hexadecimal.
const SAO_PAULO_TZIF: str = ""
const SAO_PAULO_TZIF_BYTES: int = 1430
const HEX_LETTER_A_VALUE_OFFSET: u8 = 87
const FUSO_ENV_ESPERADO: str = "FORJA_FUSO_ESPERADO"

// Valor de um digito hexadecimal minusculo (0..15), ou 0 se nao e.
proc hex_nibble(b: u8) -> int {
    if b >= CHAR_ZERO and b <= CHAR_NINE {
        return (b - CHAR_ZERO) as int
    }
    if b >= 97 and b <= 102 {
        return (b - HEX_LETTER_A_VALUE_OFFSET) as int
    }
    return 0
}

// Bytes (lista DONA: delete) do texto hexadecimal text.
proc hex_bytes(text: str) -> [dynamic]u8 {
    var bytes = make([dynamic]u8, alloc = heap)
    var at = 0
    while at + 1 < len(text) {
        append(&bytes, item = (hex_nibble(text[at]) * 16 + hex_nibble(text[at + 1])) as u8)
        at += 2
    }
    return bytes
}

// Instante UTC (segundos desde 1970) de ano-mes-dia hora:00:00.
proc utc_seconds(year: int, month: int, day: int, hour: int) -> int {
    return unix_seconds(DateTime{year = year, month = month, day = day, hour = hour})
}

// O deslocamento de Sao Paulo no instante unix_s, lido da fixture TZif; -999999 se a leitura falha.
proc sao_paulo_offset(unix_s: int) -> int {
    var bytes = hex_bytes(SAO_PAULO_TZIF)
    defer delete(bytes)
    return tzif_offset(bytes[..], unix_s) or_else -999999
}

proc tzif_erro_igual(bytes: []u8, esperado: TimeError) -> bool {
    var ok = false
    switch r in tzif_offset(bytes, 0) {
    case int: ok = false
    case TimeError: ok = r == esperado
    }
    return ok
}

proc iso_offset_igual(dt: DateTime, offset_s: int, esperado: str) -> bool {
    let texto = format_iso_offset(dt, offset_s, alloc = heap)
    defer delete(texto)
    return texto == esperado
}

proc rfc5322_igual(dt: DateTime, offset_s: int, esperado: str) -> bool {
    let texto = format_rfc5322(dt, offset_s, alloc = heap)
    defer delete(texto)
    return texto == esperado
}

// parse_iso_offset de texto devolve o instante UTC esperado (em ISO) e o deslocamento esperado.
proc parse_offset_igual(texto: str, utc_esperado: str, offset_esperado: int) -> bool {
    var ok = false
    switch r in parse_iso_offset(texto) {
    case ZonedTime: ok = iso_dt_igual(r.dt_utc, utc_esperado) and r.offset_s == offset_esperado
    case TimeError: ok = false
    }
    return ok
}

proc parse_offset_erro_igual(texto: str, esperado: TimeError) -> bool {
    var ok = false
    switch r in parse_iso_offset(texto) {
    case ZonedTime: ok = false
    case TimeError: ok = r == esperado
    }
    return ok
}

test "fixture TZif de Sao_Paulo decodifica e tem 1430 bytes" {
    var bytes = hex_bytes(SAO_PAULO_TZIF)
    defer delete(bytes)
    expect(len(bytes) == SAO_PAULO_TZIF_BYTES)
    expect(tzif_magic_at(bytes[..], at = 0))
}

test "TZif Sao_Paulo 1970 e 2020 sao -03:00" {
    expect(sao_paulo_offset(0) == -10800)
    expect(sao_paulo_offset(utc_seconds(2020, 6, 1, 0)) == -10800)
}

test "TZif Sao_Paulo 2018 tem horario de verao -02:00" {
    expect(sao_paulo_offset(utc_seconds(2018, 2, 10, 12)) == -7200)
    expect(sao_paulo_offset(utc_seconds(2018, 12, 15, 12)) == -7200)
    expect(sao_paulo_offset(utc_seconds(2018, 8, 1, 12)) == -10800)
}

test "TZif Sao_Paulo na fronteira exata da transicao" {
    let start = utc_seconds(2018, 11, 4, 3)
    expect(sao_paulo_offset(start - 1) == -10800)
    expect(sao_paulo_offset(start) == -7200)
    expect(sao_paulo_offset(start + 1) == -7200)
}

test "TZif Sao_Paulo antes da 1a transicao vale o tipo 0 (LMT)" {
    expect(sao_paulo_offset(utc_seconds(1800, 1, 1, 0)) == -11188)
}

test "tzif_offset recusa texto que nao e TZif v2 ou v3" {
    var bytes = hex_bytes(SAO_PAULO_TZIF)
    defer delete(bytes)
    expect(tzif_erro_igual(bytes[0..<0], TimeError.invalid_text))
    expect(tzif_erro_igual(bytes[0..<20], TimeError.invalid_text))
    expect(tzif_erro_igual(bytes[0..<1000], TimeError.invalid_text))
    bytes[0] = 88
    expect(tzif_erro_igual(bytes[..], TimeError.invalid_text))
    bytes[0] = 84
    bytes[TZIF_VERSION_AT] = 0
    expect(tzif_erro_igual(bytes[..], TimeError.invalid_text))
}

test "format_iso_offset escreve a hora local com o deslocamento" {
    let utc = DateTime{year = 2026, month = 11, day = 18, hour = 0, minute = 5}
    expect(iso_offset_igual(utc, -10800, "2026-11-17T21:05:00-03:00"))
    expect(iso_offset_igual(utc, 0, "2026-11-18T00:05:00+00:00"))
    let meio = DateTime{year = 2026, month = 1, day = 1, nanosecond = 500000000}
    expect(iso_offset_igual(meio, 19800, "2026-01-01T05:30:00.500+05:30"))
}

test "parse_iso_offset le Z e +-hh:mm e devolve o instante em UTC" {
    expect(parse_offset_igual("2026-11-17T21:05:00-03:00", "2026-11-18T00:05:00Z", -10800))
    expect(parse_offset_igual("2026-11-18T00:05:00Z", "2026-11-18T00:05:00Z", 0))
    expect(parse_offset_igual("2026-01-01T05:30:00.5+05:30", "2026-01-01T00:00:00.500Z", 19800))
    expect(parse_offset_igual("2026-11-18T00:05:00", "2026-11-18T00:05:00Z", 0))
}

test "parse_iso_offset erros de forma e de faixa" {
    expect(parse_offset_erro_igual("2026-11-17T21:05:00-25:00", TimeError.invalid_field))
    expect(parse_offset_erro_igual("2026-11-17T21:05:00-03:60", TimeError.invalid_field))
    expect(parse_offset_erro_igual("2026-11-17T21:05:00-0300", TimeError.invalid_text))
    expect(parse_offset_erro_igual("2026-11-17T21:05:00+ab:cd", TimeError.invalid_text))
    expect(parse_offset_erro_igual("2026-02-30T21:05:00-03:00", TimeError.invalid_field))
}

test "format e parse com deslocamento fazem ida e volta" {
    let offsets: [5]int = {-10800, 0, 19800, -43200, 50400}
    let instants: [3]int = {0, 1700000000, -86400}
    var ok = true
    for secs in instants {
        let utc = from_parts(secs, nanosecond = 0)
        for offset in offsets {
            let texto = format_iso_offset(utc, offset, alloc = heap)
            defer delete(texto)
            let utc_texto = format_iso(utc, alloc = heap)
            defer delete(utc_texto)
            if not parse_offset_igual(texto, utc_texto, offset) {
                ok = false
            }
        }
    }
    expect(ok)
}

test "format_rfc5322 de 4 datas fixas" {
    let ref = DateTime{year = 2026, month = 11, day = 19, hour = 0, minute = 5}
    expect(rfc5322_igual(ref, -10800, "Wed, 18 Nov 2026 21:05:00 -0300"))
    expect(rfc5322_igual(DateTime{}, 0, "Thu, 01 Jan 1970 00:00:00 +0000"))
    expect(rfc5322_igual(DateTime{year = 2024, month = 2, day = 29, hour = 12}, 19800, "Thu, 29 Feb 2024 17:30:00 +0530"))
    expect(rfc5322_igual(DateTime{year = 2000, month = 12, day = 31, hour = 23, minute = 59, second = 59}, 0, "Sun, 31 Dec 2000 23:59:59 +0000"))
}

test "local_offset_s e now_local concordam e ficam na faixa" {
    let agora, offset = now_local()
    expect(offset > -86400 and offset < 86400)
    expect(local_offset_s(agora) == offset)
}

// Windows: o deslocamento do kernel32 em 3 instantes recentes (2020-06-01, 2023-11-14, 2026-01-10) bate com time.localtime().tm_gmtoff do Python no mesmo PC (o verificador passa FORJA_FUSO_ESPERADO="a,b,c"; sem ela o teste nao tem o que comparar e passa).
proc env_offsets_esperados() -> [3]int {
    var found: [3]int = {}
    switch value in os.env(FUSO_ENV_ESPERADO) {
    case str:
        var index = 0
        var sign = 1
        var current = 0
        for i in 0..<len(value) {
            let b = value[i]
            if b == CHAR_DASH {
                sign = -1
            } else if b == 44 {
                found[index] = sign * current
                index += 1
                sign = 1
                current = 0
            } else {
                current = current * 10 + digit_of(b)
            }
        }
        found[index] = sign * current
    case none:
        found[0] = FUSO_INDISPONIVEL
    }
    return found
}

test "Windows: local_offset_s igual ao tm_gmtoff do Python em 3 instantes" {
    let esperado = env_offsets_esperados()
    if esperado[0] != FUSO_INDISPONIVEL {
        expect(local_offset_s(from_parts(1590969600, nanosecond = 0)) == esperado[0])
        expect(local_offset_s(from_parts(1700000000, nanosecond = 0)) == esperado[1])
        expect(local_offset_s(from_parts(1768000000, nanosecond = 0)) == esperado[2])
    }
}
