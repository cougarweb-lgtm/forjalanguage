// std:fmt - testes do modulo (S4 P6). Anexados ao texto de std:fmt SO em forja test std:fmt (o build normal nao os ve).
// Versao: 0.1.0. Changelog: 0.1.0 - S4 P6: contrato das fixtures 288..307 e 314..317 (number, percent, integer, fixed, write, find_locale, money, mul_div_round, split_even, allocate, compact, bytes, parse_number, date e duration) com os valores do .esperado. Sem os de panic (294, 295, 298..300, 308..313, 318, 319) e sem alocador de arena (322).
// Sem import e sem proc main: o pedaco fica dentro do modulo, entao chama as procs dele SEM prefixo (number, percent, PT_BR...). Os imports tx/tm do topo de std:fmt valem aqui.
// Os helpers *_igual devolvem bool: o erro do ! ParseError/MoneyError vira falso em vez de quebrar o teste.
// Titulos ASCII e unicos no modulo (E0802). Helpers com mais de 4 parametros recebem o 2o em diante por nome.

proc dez_elevado(n: int) -> f64 {
    var r: f64 = 1.0
    for _vez in 0..<n {
        r = r * 10.0
    }
    return r
}

proc bits_de(b: u64) -> f64 {
    return transmute(b, to = f64)
}

proc numero_igual(v: f64, d: int, loc: Locale, esperado: str) -> bool {
    let texto = number(v, loc = loc, decimals = d, alloc = heap)
    defer delete(texto)
    return texto == esperado
}

proc numero_modo_igual(v: f64, d: int, modo: Rounding, esperado: str) -> bool {
    let texto = number(v, loc = ISO, decimals = d, rounding = modo, alloc = heap)
    defer delete(texto)
    return texto == esperado
}

proc porcento_igual(v: f64, d: int, loc: Locale, esperado: str) -> bool {
    let texto = percent(v, loc = loc, decimals = d, alloc = heap)
    defer delete(texto)
    return texto == esperado
}

proc inteiro_igual(v: int, loc: Locale, esperado: str) -> bool {
    let texto = integer(v, loc = loc, alloc = heap)
    defer delete(texto)
    return texto == esperado
}

proc fixo_igual(v: int, scale: int, loc: Locale, esperado: str) -> bool {
    let texto = fixed(v, loc = loc, scale = scale, alloc = heap)
    defer delete(texto)
    return texto == esperado
}

proc dinheiro_igual(cents: int, scale: int, loc: Locale, esperado: str) -> bool {
    let texto = money(cents, loc = loc, scale = scale, alloc = heap)
    defer delete(texto)
    return texto == esperado
}

proc bytes_igual(n: int, binario: bool, loc: Locale, esperado: str) -> bool {
    let texto = bytes(n, loc = loc, binary = binario, alloc = heap)
    defer delete(texto)
    return texto == esperado
}

proc compacto_igual(v: f64, loc: Locale, esperado: str) -> bool {
    let texto = compact(v, loc = loc, alloc = heap)
    defer delete(texto)
    return texto == esperado
}

proc duracao_igual(ns: int, loc: Locale, esperado: str) -> bool {
    let texto = format_duration(ns, loc = loc, alloc = heap)
    defer delete(texto)
    return texto == esperado
}

proc mul_div_igual(a: int, num: int, den: int, modo: Rounding, esperado: int) -> bool {
    var ok = false
    switch r in mul_div_round(a, num, den, modo) {
    case int: ok = r == esperado
    case MoneyError: ok = false
    }
    return ok
}

proc tag_achada(tag: str) -> str {
    var achou = ""
    switch v in find_locale(tag) {
    case Locale: achou = v.tag
    case none: achou = ""
    }
    return achou
}

proc numero_lido_igual(s: str, loc: Locale, esperado: f64) -> bool {
    var ok = false
    switch r in parse_number(s, loc) {
    case f64: ok = abs(r - esperado) < 0.000000001
    case ParseError: ok = false
    }
    return ok
}

proc numero_lido_falha(s: str, loc: Locale, esperado: ParseError) -> bool {
    var ok = false
    switch r in parse_number(s, loc) {
    case f64: ok = false
    case ParseError: ok = r == esperado
    }
    return ok
}

test "number modos de arredondamento em 2.5 e -2.5" {
    expect(numero_modo_igual(2.5, 0, Rounding.half_up, "3"))
    expect(numero_modo_igual(2.5, 0, Rounding.half_even, "2"))
    expect(numero_modo_igual(2.5, 0, Rounding.half_down, "2"))
    expect(numero_modo_igual(2.5, 0, Rounding.up, "3"))
    expect(numero_modo_igual(2.5, 0, Rounding.down, "2"))
    expect(numero_modo_igual(-2.5, 0, Rounding.half_up, "-3"))
    expect(numero_modo_igual(-2.5, 0, Rounding.half_even, "-2"))
    expect(numero_modo_igual(-2.5, 0, Rounding.half_down, "-2"))
    expect(numero_modo_igual(-2.5, 0, Rounding.up, "-3"))
    expect(numero_modo_igual(-2.5, 0, Rounding.down, "-2"))
}

test "number modos de arredondamento em 0.125 e 1.005" {
    expect(numero_modo_igual(0.125, 2, Rounding.half_up, "0.13"))
    expect(numero_modo_igual(0.125, 2, Rounding.half_even, "0.12"))
    expect(numero_modo_igual(0.125, 2, Rounding.half_down, "0.12"))
    expect(numero_modo_igual(0.125, 2, Rounding.up, "0.13"))
    expect(numero_modo_igual(0.125, 2, Rounding.down, "0.12"))
    expect(numero_modo_igual(1.005, 2, Rounding.half_up, "1.01"))
    expect(numero_modo_igual(1.005, 2, Rounding.half_even, "1.00"))
    expect(numero_modo_igual(1.005, 2, Rounding.down, "1.00"))
}

test "number 0.1 mais 0.2 e zero com sinal" {
    expect(numero_igual(0.1 + 0.2, 2, ISO, "0.30"))
    expect(numero_igual(0.0, 2, ISO, "0.00"))
    expect(numero_igual(-0.0, 2, ISO, "0.00"))
    expect(numero_igual(0.0000001, 7, ISO, "0.0000001"))
}

test "number NaN e infinito" {
    expect(numero_igual(bits_de(0x7FF8000000000000), 2, ISO, "NaN"))
    expect(numero_igual(bits_de(0x7FF0000000000000), 2, ISO, "∞"))
    expect(numero_igual(bits_de(0xFFF0000000000000), 0, ISO, "-∞"))
}

test "number valores grandes e potencia de dez" {
    expect(numero_igual(999999999999999.5, 0, ISO, "1000000000000000"))
    expect(numero_igual(dez_elevado(21), 2, ISO, "1000000000000000000000.00"))
    expect(numero_igual(dez_elevado(22), 0, ISO, "10000000000000000000000"))
}

test "number decimals 15 sem erro de ponto flutuante" {
    expect(numero_igual(0.1, 15, ISO, "0.100000000000000"))
    expect(numero_igual(1.5, 15, ISO, "1.500000000000000"))
    expect(numero_igual(0.1 + 0.2, 15, ISO, "0.300000000000000"))
    expect(numero_igual(1.0 / 3.0, 15, ISO, "0.333333333333333"))
    expect(numero_igual(123456789.123456789, 15, ISO, "123456789.123457000000000"))
}

test "number regioes em 1234.5 com 2 casas" {
    expect(numero_igual(1234.5, 2, PT_BR, "1.234,50"))
    expect(numero_igual(1234.5, 2, EN_US, "1,234.50"))
    expect(numero_igual(1234.5, 2, ES_ES, "1234,50"))
    expect(numero_igual(1234.5, 2, DE_DE, "1.234,50"))
    expect(numero_igual(1234.5, 2, PT_PT, "1234,50"))
    expect(numero_igual(1234.5, 2, ISO, "1234.50"))
}

test "number milhar em 1000 e 12345.678 no es-ES" {
    expect(numero_igual(1000.0, 2, PT_BR, "1.000,00"))
    expect(numero_igual(1000.0, 2, ES_ES, "1000,00"))
    expect(numero_igual(12345.678, 2, ES_ES, "12.345,68"))
    expect(numero_igual(9999.99, 2, ES_ES, "9999,99"))
}

test "number negativo com milhar em pt-BR e en-US" {
    expect(numero_igual(-1234567.891, 2, PT_BR, "-1.234.567,89"))
    expect(numero_igual(-1234567.891, 2, EN_US, "-1,234,567.89"))
}

test "percent modos e regioes" {
    expect(porcento_igual(0.0115, 2, PT_BR, "1,15%"))
    expect(porcento_igual(0.0115, 2, EN_US, "1.15%"))
    expect(porcento_igual(0.5, 0, PT_BR, "50%"))
    expect(porcento_igual(-0.5, 0, PT_BR, "-50%"))
    expect(porcento_igual(12.0, 0, PT_BR, "1.200%"))
    expect(porcento_igual(0.999, 0, PT_BR, "100%"))
    expect(porcento_igual(0.99995, 1, EN_US, "100.0%"))
    let meio = percent(0.125, loc = PT_BR, decimals = 0, rounding = Rounding.half_even, alloc = heap)
    defer delete(meio)
    expect(meio == "12%")
}

test "percent NaN" {
    expect(porcento_igual(bits_de(0x7FF8000000000000), 1, PT_BR, "NaN"))
}

test "integer regioes e bordas de i64" {
    expect(inteiro_igual(1234, PT_BR, "1.234"))
    expect(inteiro_igual(1234, EN_US, "1,234"))
    expect(inteiro_igual(1234, ES_ES, "1234"))
    expect(inteiro_igual(1000000, PT_BR, "1.000.000"))
    expect(inteiro_igual(1000000, ISO, "1000000"))
    expect(inteiro_igual(-1000, EN_US, "-1,000"))
    expect(inteiro_igual(-9223372036854775807 - 1, PT_BR, "-9.223.372.036.854.775.808"))
    expect(inteiro_igual(9223372036854775807, EN_US, "9,223,372,036,854,775,807"))
}

test "write_number e write_integer no mesmo buffer" {
    var buf = make([dynamic]u8, alloc = heap, cap = 32)
    defer delete(buf)
    append(&buf, item = "[")
    write_number(1234.5, buf = &buf, loc = PT_BR)
    append(&buf, item = "][")
    write_integer(-1234567, buf = &buf, loc = EN_US)
    append(&buf, item = "]")
    let linha = to_str(&buf)
    defer delete(linha)
    expect(linha == "[1.234,50][-1,234,567]")
}

test "write_number arredondamento no buffer" {
    var buf = make([dynamic]u8, alloc = heap, cap = 32)
    defer delete(buf)
    append(&buf, item = "[")
    write_number(2.5, buf = &buf, loc = PT_BR, decimals = 0, rounding = Rounding.half_even)
    append(&buf, item = "|")
    write_number(2.5, buf = &buf, loc = PT_BR, decimals = 0)
    append(&buf, item = "|")
    write_number(-2.5, buf = &buf, loc = PT_BR, decimals = 0, rounding = Rounding.half_down)
    append(&buf, item = "]")
    let linha = to_str(&buf)
    defer delete(linha)
    expect(linha == "[2|3|-2]")
}

test "find_locale acha tag exata e recusa o resto" {
    expect(tag_achada("pt-BR") == "pt-BR")
    expect(tag_achada("de-DE") == "de-DE")
    expect(tag_achada("pt-br") == "")
    expect(tag_achada("pt_BR") == "")
    expect(tag_achada("xx") == "")
    expect(tag_achada("") == "")
}

test "fixed regioes e bordas" {
    expect(fixo_igual(122334, 2, PT_BR, "1.223,34"))
    expect(fixo_igual(122334, 2, ISO, "1223.34"))
    expect(fixo_igual(-5, 2, EN_US, "-0.05"))
    expect(fixo_igual(5, 3, PT_BR, "0,005"))
    expect(fixo_igual(-1, 3, PT_BR, "-0,001"))
    expect(fixo_igual(99999999, 4, EN_US, "9,999.9999"))
    expect(fixo_igual(-9223372036854775807 - 1, 0, PT_BR, "-9.223.372.036.854.775.808"))
    expect(fixo_igual(9223372036854775807, 9, ISO, "9223372036.854775807"))
}

test "money com simbolo por regiao" {
    expect(dinheiro_igual(122334, 2, PT_BR, "R$ 1.223,34"))
    expect(dinheiro_igual(122334, 2, EN_US, "$1,223.34"))
    expect(dinheiro_igual(5899, 3, PT_BR, "R$ 5,899"))
    expect(dinheiro_igual(-7, 0, PT_BR, "-R$ 7"))
    expect(dinheiro_igual(-9223372036854775807 - 1, 9, PT_BR, "-R$ 9.223.372.036,854775808"))
}

test "money contabil em pt-BR" {
    let texto = money(-1, loc = PT_BR, scale = 2, accounting = true, alloc = heap)
    defer delete(texto)
    expect(texto == "(R$ 0,01)")
}

test "mul_div_round arredondamento por modo" {
    expect(mul_div_igual(5, 1, 2, Rounding.half_up, 3))
    expect(mul_div_igual(5, 1, 2, Rounding.half_even, 2))
    expect(mul_div_igual(5, 1, 2, Rounding.half_down, 2))
    expect(mul_div_igual(5, 1, 2, Rounding.up, 3))
    expect(mul_div_igual(5, 1, 2, Rounding.down, 2))
    expect(mul_div_igual(-5, 1, 2, Rounding.half_up, -3))
    expect(mul_div_igual(25, 1, 10, Rounding.half_even, 2))
    expect(mul_div_igual(999, 15, 100, Rounding.half_up, 150))
    expect(mul_div_igual(2500, 1075, 10000, Rounding.half_up, 269))
    expect(mul_div_igual(2500, 1075, 10000, Rounding.down, 268))
}

test "mul_div_round em 64 bits sem perder precisao" {
    expect(mul_div_igual(9223372036854775807, 9223372036854775807, 9223372036854775807, Rounding.half_up, 9223372036854775807))
    expect(mul_div_igual(9223372036854775807, 2, 2, Rounding.half_up, 9223372036854775807))
}

test "split_even reparte sem perder centavo" {
    var dez = split_even(10, 3, alloc = heap)
    defer delete(dez)
    expect(len(dez) == 3)
    expect(dez[0] == 4)
    expect(dez[1] == 3)
    expect(dez[2] == 3)
    var cem = split_even(100, 7, alloc = heap)
    defer delete(cem)
    expect(len(cem) == 7)
    expect(cem[0] == 15)
    expect(cem[1] == 15)
    expect(cem[2] == 14)
    var soma = 0
    for i in 0..<len(cem) {
        soma = soma + cem[i]
    }
    expect(soma == 100)
}

test "allocate distribui pelos pesos" {
    var pesos: [3]int = {1, 2, 3}
    var partes = allocate(100, pesos[..], alloc = heap)
    defer delete(partes)
    expect(len(partes) == 3)
    expect(partes[0] == 17)
    expect(partes[1] == 33)
    expect(partes[2] == 50)
    var zeros: [3]int = {0, 5, 0}
    var reparte = allocate(100, zeros[..], alloc = heap)
    defer delete(reparte)
    expect(reparte[0] == 0)
    expect(reparte[1] == 100)
}

test "compact escala curta em pt-BR e en-US" {
    expect(compacto_igual(1050.0, PT_BR, "1,1 mil"))
    expect(compacto_igual(1050.0, EN_US, "1.1K"))
    expect(compacto_igual(999.5, PT_BR, "1 mil"))
    expect(compacto_igual(999.5, EN_US, "1K"))
    expect(compacto_igual(9950.0, EN_US, "10K"))
    expect(compacto_igual(12345.0, PT_BR, "12 mil"))
    expect(compacto_igual(99949.0, EN_US, "100K"))
    expect(compacto_igual(0.5, PT_BR, "1"))
    expect(compacto_igual(-2.5, PT_BR, "-3"))
}

test "bytes binario e SI em pt-BR e en-US" {
    expect(bytes_igual(0, true, PT_BR, "0 B"))
    expect(bytes_igual(1000, true, PT_BR, "1000 B"))
    expect(bytes_igual(1000, false, PT_BR, "1 kB"))
    expect(bytes_igual(1024, true, PT_BR, "1 KiB"))
    expect(bytes_igual(1024, false, EN_US, "1 kB"))
    expect(bytes_igual(1536, true, EN_US, "1.5 KiB"))
    expect(bytes_igual(1536, false, PT_BR, "1,5 kB"))
    expect(bytes_igual(1048576, true, PT_BR, "1 MiB"))
    expect(bytes_igual(1572864, false, PT_BR, "1,6 MB"))
    expect(bytes_igual(1000000000, false, PT_BR, "1 GB"))
}

test "duration em pt-BR" {
    expect(duracao_igual(0, PT_BR, "0 s"))
    expect(duracao_igual(999999, PT_BR, "0 s"))
    expect(duracao_igual(1250000000, PT_BR, "1 s 250 ms"))
    expect(duracao_igual(61001000000, PT_BR, "1 min 1 s 1 ms"))
    expect(duracao_igual(3903250000000, PT_BR, "1 h 5 min 3 s 250 ms"))
    expect(duracao_igual(86400000000000, PT_BR, "24 h"))
    expect(duracao_igual(359999999000000, PT_BR, "99 h 59 min 59 s 999 ms"))
}

test "parse_number valores em pt-BR" {
    expect(numero_lido_igual("1.223,34", PT_BR, 1223.34))
    expect(numero_lido_igual("1223,34", PT_BR, 1223.34))
    expect(numero_lido_igual("0,5", PT_BR, 0.5))
    expect(numero_lido_igual("12", PT_BR, 12.0))
    expect(numero_lido_igual("-1.223,34", PT_BR, -1223.34))
}

test "parse_number erros em pt-BR" {
    expect(numero_lido_falha("1.2.3", PT_BR, ParseError.grouping))
    expect(numero_lido_falha("1.22", PT_BR, ParseError.grouping))
    expect(numero_lido_falha(",5", PT_BR, ParseError.invalid))
    expect(numero_lido_falha("5,", PT_BR, ParseError.invalid))
    expect(numero_lido_falha("-", PT_BR, ParseError.invalid))
}

test "date format curto e longo em pt-BR" {
    let dt = tm.from_unix_ns(0)
    let curta = format_date(dt, PT_BR, DateStyle.short, alloc = heap)
    defer delete(curta)
    expect(curta == "01/01/1970")
    let longa = format_date(dt, PT_BR, DateStyle.long, alloc = heap)
    defer delete(longa)
    expect(longa == "1 de janeiro de 1970")
}

test "date time e datetime em pt-BR" {
    let dt = tm.from_unix_ns(0)
    let hora = format_time(dt, PT_BR, alloc = heap)
    defer delete(hora)
    expect(hora == "00:00")
    let data_hora = format_datetime(dt, PT_BR, DateStyle.short, alloc = heap)
    defer delete(data_hora)
    expect(data_hora == "01/01/1970 00:00")
}

test "time com segundos em pt-BR" {
    let dt = tm.from_unix_ns(3909000000000)
    let hora = format_time(dt, PT_BR, seconds = true, alloc = heap)
    defer delete(hora)
    expect(hora == "01:05:09")
}
