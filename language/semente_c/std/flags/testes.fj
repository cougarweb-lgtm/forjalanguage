// std:flags - testes do modulo (A91). Anexados ao texto de std:flags SO em forja test std:flags (o build normal nao os ve).
// Versao: 0.1.0. Changelog: 0.1.0 - A91: casos de std_wip\flags\teste.fj convertidos para test/expect (lista de args, destinos, posicionais, erros de parse e ajuda).
// Sem import e sem proc main: o pedaco fica dentro do modulo, entao chama as procs dele SEM prefixo (parser_new, add_int, parse, usage...).

// LIMITE: 5 parametros posicionais (o parser e os 4 destinos); registra um destino por tipo de flag no teste.
proc registrar_flags(p: ^Parser, n: ^int, nome: ^str, verbose: ^bool, fator: ^f64) {
    add_int(p, n, name = "n", fallback = 3, help = "quantidade")
    add_str(p, nome, name = "nome", fallback = "anon", help = "nome do usuario")
    add_bool(p, verbose, name = "verbose", fallback = false, help = "mais saida")
    add_f64(p, fator, name = "fator", fallback = 0.5, help = "escala")
}

// Linha dos destinos, no formato que o teste antigo imprimia.
proc linha_valores(n: int, nome: str, verbose: bool, fator: f64) -> str {
    return format(f"n={n} nome={nome} verbose={verbose} fator={fator:.2}", alloc = heap)
}

// Linha dos posicionais: rest= seguido dos argumentos juntos por |.
proc linha_rest(p: ^Parser) -> str {
    let pos = text.join(p.rest[..], "|", alloc = heap)
    defer delete(pos)
    return format(f"rest={pos}", alloc = heap)
}

test "flags: sem argumentos usa os padroes" {
    var n = 0
    var nome = ""
    var verbose = false
    var fator: f64 = 0.0
    var p = parser_new("prog", alloc = heap)
    defer parser_delete(&p)
    registrar_flags(&p, &n, &nome, &verbose, &fator)
    var args = text.split("prog", " ", alloc = heap)
    defer delete(args)
    let erro = parse(&p, args[..])
    expect(erro == none)
    let cab = linha_valores(n, nome, verbose, fator)
    expect(cab == "n=3 nome=anon verbose=false fator=0.50")
    delete(cab)
    let rest = linha_rest(&p)
    expect(rest == "rest=")
    delete(rest)
    let ajuda = usage(&p, alloc = heap)
    defer delete(ajuda)
    var uso = text.split(ajuda, "\n", alloc = heap)
    defer delete(uso)
    expect(uso[0] == "uso: prog [opcoes] [argumentos]")
    expect(uso[1] == "  --n  quantidade (padrao 3)")
    expect(uso[2] == "  --nome  nome do usuario (padrao anon)")
    expect(uso[3] == "  --verbose  mais saida (padrao false)")
    expect(uso[4] == "  --fator  escala (padrao 0.50)")
    expect(uso[5] == "")
}

test "flags: formas longas, curtas, com = e -- encerra as opcoes" {
    var n = 0
    var nome = ""
    var verbose = false
    var fator: f64 = 0.0
    var p = parser_new("prog", alloc = heap)
    defer parser_delete(&p)
    registrar_flags(&p, &n, &nome, &verbose, &fator)
    var args = text.split("prog --n 7 --nome=ana -verbose --fator 1.25 pos1 -- --nao-e-flag", " ", alloc = heap)
    defer delete(args)
    let erro = parse(&p, args[..])
    expect(erro == none)
    let cab = linha_valores(n, nome, verbose, fator)
    expect(cab == "n=7 nome=ana verbose=true fator=1.25")
    delete(cab)
    let rest = linha_rest(&p)
    expect(rest == "rest=pos1|--nao-e-flag")
    delete(rest)
    let ajuda = usage(&p, alloc = heap)
    defer delete(ajuda)
    var uso = text.split(ajuda, "\n", alloc = heap)
    defer delete(uso)
    expect(uso[0] == "uso: prog [opcoes] [argumentos]")
    expect(uso[1] == "  --n  quantidade (padrao 3)")
    expect(uso[2] == "  --nome  nome do usuario (padrao anon)")
    expect(uso[3] == "  --verbose  mais saida (padrao false)")
    expect(uso[4] == "  --fator  escala (padrao 0.50)")
    expect(uso[5] == "")
}

test "flags: flag desconhecida" {
    var n = 0
    var nome = ""
    var verbose = false
    var fator: f64 = 0.0
    var p = parser_new("prog", alloc = heap)
    defer parser_delete(&p)
    registrar_flags(&p, &n, &nome, &verbose, &fator)
    var args = text.split("prog --desconhecida", " ", alloc = heap)
    defer delete(args)
    switch e in parse(&p, args[..]) {
    case FlagError:
        let t = erro_texto(e, alloc = heap)
        expect(t == "flag desconhecida: --desconhecida")
        delete(t)
    case none:
        expect(false)
    }
    let cab = linha_valores(n, nome, verbose, fator)
    expect(cab == "n=3 nome=anon verbose=false fator=0.50")
    delete(cab)
    let rest = linha_rest(&p)
    expect(rest == "rest=")
    delete(rest)
    let ajuda = usage(&p, alloc = heap)
    defer delete(ajuda)
    var uso = text.split(ajuda, "\n", alloc = heap)
    defer delete(uso)
    expect(uso[0] == "uso: prog [opcoes] [argumentos]")
    expect(uso[1] == "  --n  quantidade (padrao 3)")
    expect(uso[2] == "  --nome  nome do usuario (padrao anon)")
    expect(uso[3] == "  --verbose  mais saida (padrao false)")
    expect(uso[4] == "  --fator  escala (padrao 0.50)")
    expect(uso[5] == "")
}

test "flags: valor faltando no fim da linha" {
    var n = 0
    var nome = ""
    var verbose = false
    var fator: f64 = 0.0
    var p = parser_new("prog", alloc = heap)
    defer parser_delete(&p)
    registrar_flags(&p, &n, &nome, &verbose, &fator)
    var args = text.split("prog --n", " ", alloc = heap)
    defer delete(args)
    switch e in parse(&p, args[..]) {
    case FlagError:
        let t = erro_texto(e, alloc = heap)
        expect(t == "falta o valor da flag --n")
        delete(t)
    case none:
        expect(false)
    }
    let cab = linha_valores(n, nome, verbose, fator)
    expect(cab == "n=3 nome=anon verbose=false fator=0.50")
