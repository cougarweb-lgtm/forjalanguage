// std:atomic - AtomicI32, AtomicI64, AtomicU64, AtomicPtr e a barreira fence (M5 P50). API em ingles (ADR-39); o corpo chama o runtime direto (forja_atomic_*, rt_atomic.c / forja_rt_atomic.h).
// Changelog: 0.1.0 - M5 P50: load, store, add, sub, exchange e cas por tipo, e fence(ordem) global; ordem = Ordem (relaxed, acquire, release, seq_cst). Linux = X0003 (M5c-b).
// Valor zero valido (0 e null); nao copiaveis (E0339, sem_naocopia.c): passe ^AtomicX (o endereco).
// add e sub devolvem o valor ANTERIOR; cas devolve true se trocou. Em x86-64 todas as ordens viram a mesma instrucao, salvo store seq_cst (xchg) e fence seq_cst (mfence).

foreign {
    proc forja_atomic_carrega_i32(a: rawptr, ordem: Ordem) -> i32
    proc forja_atomic_grava_i32(a: rawptr, valor: i32, ordem: Ordem)
    proc forja_atomic_soma_i32(a: rawptr, valor: i32, ordem: Ordem) -> i32
    proc forja_atomic_subtrai_i32(a: rawptr, valor: i32, ordem: Ordem) -> i32
    proc forja_atomic_troca_i32(a: rawptr, valor: i32, ordem: Ordem) -> i32
    proc forja_atomic_cas_i32(a: rawptr, esperado: i32, novo: i32, ordem: Ordem) -> i32
    proc forja_atomic_carrega_i64(a: rawptr, ordem: Ordem) -> i64
    proc forja_atomic_grava_i64(a: rawptr, valor: i64, ordem: Ordem)
    proc forja_atomic_soma_i64(a: rawptr, valor: i64, ordem: Ordem) -> i64
    proc forja_atomic_subtrai_i64(a: rawptr, valor: i64, ordem: Ordem) -> i64
    proc forja_atomic_troca_i64(a: rawptr, valor: i64, ordem: Ordem) -> i64
    proc forja_atomic_cas_i64(a: rawptr, esperado: i64, novo: i64, ordem: Ordem) -> i32
    proc forja_atomic_carrega_u64(a: rawptr, ordem: Ordem) -> u64
    proc forja_atomic_grava_u64(a: rawptr, valor: u64, ordem: Ordem)
    proc forja_atomic_soma_u64(a: rawptr, valor: u64, ordem: Ordem) -> u64
    proc forja_atomic_subtrai_u64(a: rawptr, valor: u64, ordem: Ordem) -> u64
    proc forja_atomic_troca_u64(a: rawptr, valor: u64, ordem: Ordem) -> u64
    proc forja_atomic_cas_u64(a: rawptr, esperado: u64, novo: u64, ordem: Ordem) -> i32
    proc forja_atomic_carrega_ptr(a: rawptr, ordem: Ordem) -> rawptr
    proc forja_atomic_grava_ptr(a: rawptr, valor: rawptr, ordem: Ordem)
    proc forja_atomic_troca_ptr(a: rawptr, valor: rawptr, ordem: Ordem) -> rawptr
    proc forja_atomic_cas_ptr(a: rawptr, esperado: rawptr, novo: rawptr, ordem: Ordem) -> i32
    proc forja_atomic_barreira(ordem: Ordem)
}

// Ordem de memoria. Os numeros ficam fixos: o runtime (rt_atomic.c) os le como 0, 1, 2 e 3.
pub enum Ordem {
    relaxed = 0
    acquire = 1
    release = 2
    seq_cst = 3
}

pub struct AtomicI32 {
    valor: i32 = 0
}

pub struct AtomicI64 {
    valor: i64 = 0
}

pub struct AtomicU64 {
    valor: u64 = 0
}

// Guarda o endereco como u64 (8 bytes, alinhado): o valor zero e 0 = null.
pub struct AtomicPtr {
    valor: u64 = 0
}

// Le o valor de a com a ordem pedida.
pub proc load_i32(a: ^AtomicI32, ordem: Ordem) -> i32 {
    return forja_atomic_carrega_i32(a as rawptr, ordem)
}

// Grava valor em a com a ordem pedida.
pub proc store_i32(a: ^AtomicI32, valor: i32, ordem: Ordem) {
    forja_atomic_grava_i32(a as rawptr, valor, ordem)
}

// Soma valor em a e devolve o valor ANTERIOR (fetch_add).
pub proc add_i32(a: ^AtomicI32, valor: i32, ordem: Ordem) -> i32 {
    return forja_atomic_soma_i32(a as rawptr, valor, ordem)
}

// Subtrai valor de a e devolve o valor ANTERIOR (fetch_sub).
pub proc sub_i32(a: ^AtomicI32, valor: i32, ordem: Ordem) -> i32 {
    return forja_atomic_subtrai_i32(a as rawptr, valor, ordem)
}

// Troca o valor de a por valor e devolve o ANTERIOR.
pub proc exchange_i32(a: ^AtomicI32, valor: i32, ordem: Ordem) -> i32 {
    return forja_atomic_troca_i32(a as rawptr, valor, ordem)
}

// Se a vale esperado, grava novo e devolve true; senao devolve false (a nao muda).
pub proc cas_i32(a: ^AtomicI32, esperado: i32, novo: i32, ordem: Ordem) -> bool {
    return forja_atomic_cas_i32(a as rawptr, esperado, novo, ordem) != 0
}

// Le o valor de a com a ordem pedida.
pub proc load_i64(a: ^AtomicI64, ordem: Ordem) -> i64 {
    return forja_atomic_carrega_i64(a as rawptr, ordem)
}

// Grava valor em a com a ordem pedida.
pub proc store_i64(a: ^AtomicI64, valor: i64, ordem: Ordem) {
    forja_atomic_grava_i64(a as rawptr, valor, ordem)
}

// Soma valor em a e devolve o valor ANTERIOR (fetch_add).
pub proc add_i64(a: ^AtomicI64, valor: i64, ordem: Ordem) -> i64 {
    return forja_atomic_soma_i64(a as rawptr, valor, ordem)
}

// Subtrai valor de a e devolve o valor ANTERIOR (fetch_sub).
pub proc sub_i64(a: ^AtomicI64, valor: i64, ordem: Ordem) -> i64 {
    return forja_atomic_subtrai_i64(a as rawptr, valor, ordem)
}

// Troca o valor de a por valor e devolve o ANTERIOR.
pub proc exchange_i64(a: ^AtomicI64, valor: i64, ordem: Ordem) -> i64 {
    return forja_atomic_troca_i64(a as rawptr, valor, ordem)
}

// Se a vale esperado, grava novo e devolve true; senao devolve false (a nao muda).
pub proc cas_i64(a: ^AtomicI64, esperado: i64, novo: i64, ordem: Ordem) -> bool {
    return forja_atomic_cas_i64(a as rawptr, esperado, novo, ordem) != 0
}

// Le o valor de a com a ordem pedida.
pub proc load_u64(a: ^AtomicU64, ordem: Ordem) -> u64 {
    return forja_atomic_carrega_u64(a as rawptr, ordem)
}

// Grava valor em a com a ordem pedida.
pub proc store_u64(a: ^AtomicU64, valor: u64, ordem: Ordem) {
    forja_atomic_grava_u64(a as rawptr, valor, ordem)
}

// Soma valor em a e devolve o valor ANTERIOR (fetch_add); estoura por volta (modulo 2^64).
pub proc add_u64(a: ^AtomicU64, valor: u64, ordem: Ordem) -> u64 {
    return forja_atomic_soma_u64(a as rawptr, valor, ordem)
}

// Subtrai valor de a e devolve o valor ANTERIOR (fetch_sub).
pub proc sub_u64(a: ^AtomicU64, valor: u64, ordem: Ordem) -> u64 {
    return forja_atomic_subtrai_u64(a as rawptr, valor, ordem)
}

// Troca o valor de a por valor e devolve o ANTERIOR.
pub proc exchange_u64(a: ^AtomicU64, valor: u64, ordem: Ordem) -> u64 {
    return forja_atomic_troca_u64(a as rawptr, valor, ordem)
}

// Se a vale esperado, grava novo e devolve true; senao devolve false (a nao muda).
pub proc cas_u64(a: ^AtomicU64, esperado: u64, novo: u64, ordem: Ordem) -> bool {
    return forja_atomic_cas_u64(a as rawptr, esperado, novo, ordem) != 0
}

// Le o ponteiro guardado em a com a ordem pedida.
pub proc load_ptr(a: ^AtomicPtr, ordem: Ordem) -> rawptr {
    return forja_atomic_carrega_ptr(a as rawptr, ordem)
}

// Grava o ponteiro valor em a com a ordem pedida.
pub proc store_ptr(a: ^AtomicPtr, valor: rawptr, ordem: Ordem) {
    forja_atomic_grava_ptr(a as rawptr, valor, ordem)
}

// Troca o ponteiro de a por valor e devolve o ANTERIOR.
pub proc exchange_ptr(a: ^AtomicPtr, valor: rawptr, ordem: Ordem) -> rawptr {
    return forja_atomic_troca_ptr(a as rawptr, valor, ordem)
}

// Se a aponta para esperado, grava novo e devolve true; senao devolve false (a nao muda).
pub proc cas_ptr(a: ^AtomicPtr, esperado: rawptr, novo: rawptr, ordem: Ordem) -> bool {
    return forja_atomic_cas_ptr(a as rawptr, esperado, novo, ordem) != 0
}

// Barreira de memoria global com a ordem pedida (seq_cst = mfence no x86-64).
pub proc fence(ordem: Ordem) {
    forja_atomic_barreira(ordem)
}
