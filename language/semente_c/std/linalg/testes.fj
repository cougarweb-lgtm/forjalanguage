// std:linalg - testes do modulo (A14). Anexados ao texto de std:linalg SO em forja test std:linalg (o build normal nao os ve).
// Versao: 0.1.0. Changelog: 0.1.0 - A14: casos de std_wip\linalg\teste.fj convertidos para test/expect (vetores 2/3/4, Mat4, transformacoes, inversa, perspectiva e look_at) com tolerancia 1e-6.
// Sem import e sem proc main: o pedaco fica dentro do modulo, entao chama as procs dele SEM prefixo (vec2_add, mat4_translate...). math (PI_F32) e o apelido de std:math do proprio modulo.

// Igualdade com tolerancia 1e-6: os valores sao f32 calculados (normalizacao, cos e sin), entao igualdade exata nao serve.
proc perto(obtido: f32, esperado: f32) -> bool {
    return abs(obtido - esperado) < 0.000001
}

test "vec2: soma, subtracao e escala" {
    let a2 = Vec2{x = 1.5, y = -2.0}
    let b2 = Vec2{x = 0.25, y = 0.5}
    let s2 = vec2_add(a2, b2)
    expect(perto(s2.x, 1.75))
    expect(perto(s2.y, -1.5))
    let d2 = vec2_sub(a2, b2)
    expect(perto(d2.x, 1.25))
    expect(perto(d2.y, -2.5))
    let k2 = vec2_scale(a2, 2.0)
    expect(perto(k2.x, 3.0))
    expect(perto(k2.y, -4.0))
}

test "vec2: produto escalar, comprimento e normalizacao" {
    expect(perto(vec2_dot(Vec2{x = 3.0, y = 4.0}, Vec2{x = 1.0, y = 2.0}), 11.0))
    expect(perto(vec2_length(Vec2{x = 3.0, y = 4.0}), 5.0))
    let n2 = vec2_normalize(Vec2{x = 3.0, y = 4.0})
    expect(perto(n2.x, 0.6))
    expect(perto(n2.y, 0.8))
}

test "vec3: soma e subtracao" {
    let a3 = Vec3{x = 1.0, y = 2.0, z = 3.0}
    let b3 = Vec3{x = 4.0, y = 5.0, z = 6.0}
    let s3 = vec3_add(a3, b3)
    expect(perto(s3.x, 5.0))
    expect(perto(s3.y, 7.0))
    expect(perto(s3.z, 9.0))
    let d3 = vec3_sub(a3, b3)
    expect(perto(d3.x, -3.0))
    expect(perto(d3.z, -3.0))
}

test "vec3: produto vetorial" {
    let a3 = Vec3{x = 1.0, y = 2.0, z = 3.0}
    let b3 = Vec3{x = 4.0, y = 5.0, z = 6.0}
    let ex = Vec3{x = 1.0, y = 0.0, z = 0.0}
    let ey = Vec3{x = 0.0, y = 1.0, z = 0.0}
    let cx = vec3_cross(ex, ey)
    expect(perto(cx.x, 0.0))
    expect(perto(cx.y, 0.0))
    expect(perto(cx.z, 1.0))
    let c3 = vec3_cross(a3, b3)
    expect(perto(c3.x, -3.0))
    expect(perto(c3.y, 6.0))
    expect(perto(c3.z, -3.0))
}

test "vec3: produto escalar, comprimento e normalizacao" {
    let a3 = Vec3{x = 1.0, y = 2.0, z = 3.0}
    let b3 = Vec3{x = 4.0, y = 5.0, z = 6.0}
    expect(perto(vec3_dot(a3, b3), 32.0))
    expect(perto(vec3_length(Vec3{x = 2.0, y = 3.0, z = 6.0}), 7.0))
    let n3 = vec3_normalize(Vec3{x = 0.0, y = 0.0, z = 5.0})
    expect(perto(n3.x, 0.0))
    expect(perto(n3.y, 0.0))
    expect(perto(n3.z, 1.0))
}

test "vec4: soma, subtracao e escala" {
    let a4 = Vec4{x = 1.0, y = 2.0, z = 3.0, w = 4.0}
    let b4 = Vec4{x = 1.0, y = 1.0, z = 1.0, w = 1.0}
    let s4 = vec4_add(a4, b4)
    expect(perto(s4.x, 2.0))
    expect(perto(s4.w, 5.0))
    let d4 = vec4_sub(a4, b4)
    expect(perto(d4.x, 0.0))
    expect(perto(d4.w, 3.0))
    let k4 = vec4_scale(a4, 0.5)
    expect(perto(k4.x, 0.5))
    expect(perto(k4.w, 2.0))
}

test "vec4: produto escalar, comprimento e normalizacao" {
    let a4 = Vec4{x = 1.0, y = 2.0, z = 3.0, w = 4.0}
    expect(perto(vec4_dot(a4, Vec4{x = 4.0, y = 3.0, z = 2.0, w = 1.0}), 20.0))
    expect(perto(vec4_length(Vec4{x = 1.0, y = 2.0, z = 2.0, w = 4.0}), 5.0))
    let n4 = vec4_normalize(Vec4{x = 0.0, y = 3.0, z = 0.0, w = 4.0})
    expect(perto(n4.y, 0.6))
    expect(perto(n4.w, 0.8))
}

test "mat4: translacao, escala e rotacao transformam pontos" {
    let t = mat4_translate(Vec3{x = 1.0, y = 2.0, z = 3.0})
    let p0 = mat4_transform_point(t, Vec3{x = 0.0, y = 0.0, z = 0.0})
    expect(perto(p0.x, 1.0))
    expect(perto(p0.y, 2.0))
    expect(perto(p0.z, 3.0))
    let sc = mat4_scale(Vec3{x = 2.0, y = 3.0, z = 4.0})
    let p1 = mat4_transform_point(sc, Vec3{x = 1.0, y = 1.0, z = 1.0})
    expect(perto(p1.x, 2.0))
    expect(perto(p1.y, 3.0))
    expect(perto(p1.z, 4.0))
    let meio_volta = math.PI_F32 / 2.0
    let rz = mat4_rotate_axis(Vec3{x = 0.0, y = 0.0, z = 1.0}, meio_volta)
    let p2 = mat4_transform_point(rz, Vec3{x = 1.0, y = 0.0, z = 0.0})
    expect(perto(p2.x, 0.0))
    expect(perto(p2.y, 1.0))
    expect(perto(p2.z, 0.0))
    let rx = mat4_rotate_axis(Vec3{x = 1.0, y = 0.0, z = 0.0}, meio_volta)
    let p3 = mat4_transform_point(rx, Vec3{x = 0.0, y = 1.0, z = 0.0})
    expect(perto(p3.x, 0.0))
    expect(perto(p3.y, 0.0))
    expect(perto(p3.z, 1.0))
}

test "mat4: ordem da multiplicacao" {
    let tr = mat4_translate(Vec3{x = 1.0, y = 0.0, z = 0.0})
    let sc2 = mat4_scale(Vec3{x = 2.0, y = 2.0, z = 2.0})
    let ordem_ts = mat4_mul(tr, sc2)
    let p1 = mat4_transform_point(ordem_ts, Vec3{x = 1.0, y = 1.0, z = 1.0})
    expect(perto(p1.x, 3.0))
    expect(perto(p1.y, 2.0))
    expect(perto(p1.z, 2.0))
    let ordem_st = mat4_mul(sc2, tr)
    let p2 = mat4_transform_point(ordem_st, Vec3{x = 1.0, y = 1.0, z = 1.0})
    expect(perto(p2.x, 4.0))
    expect(perto(p2.y, 2.0))
    expect(perto(p2.z, 2.0))
}

test "mat4: transposta" {
    let t = mat4_translate(Vec3{x = 1.0, y = 2.0, z = 3.0})
    let tt = mat4_transpose(t)
    expect(perto(tt.elementos[3], 1.0))
    expect(perto(tt.elementos[12], 0.0))
}

test "mat4: inversa de translacao e de transformacao afim" {
    let t = mat4_translate(Vec3{x = 1.0, y = 2.0, z = 3.0})
    switch inv in mat4_inverse(t) {
    case Mat4:
        let p = mat4_transform_point(inv, Vec3{x = 0.0, y = 0.0, z = 0.0})
        expect(perto(p.x, -1.0))
        expect(perto(p.y, -2.0))
        expect(perto(p.z, -3.0))
    case none:
        expect(false)
    }
    let afim = mat4_mul(t, mat4_scale(Vec3{x = 2.0, y = 4.0, z = 8.0}))
    switch inv in mat4_inverse(afim) {
    case Mat4:
        let p = mat4_transform_point(inv, Vec3{x = 3.0, y = 6.0, z = 11.0})
        expect(perto(p.x, 1.0))
        expect(perto(p.y, 1.0))
        expect(perto(p.z, 1.0))
    case none:
        expect(false)
    }
}

test "mat4: escala com zero e singular" {
    switch inv in mat4_inverse(mat4_scale(Vec3{x = 0.0, y = 1.0, z = 1.0})) {
    case Mat4:
        expect(false)
    case none:
        expect(true)
    }
}

test "mat4: perspectiva" {
    let pm = mat4_perspective(math.PI_F32 / 2.0, 1.0, 1.0, 3.0)
    expect(perto(pm.elementos[0], 1.0))
    expect(perto(pm.elementos[5], 1.0))
    expect(perto(pm.elementos[10], -1.5))
    expect(perto(pm.elementos[11], -1.0))
    expect(perto(pm.elementos[14], -1.5))
}

test "mat4: look_at" {
    let vista = mat4_look_at(Vec3{x = 0.0, y = 0.0, z = 5.0}, Vec3{x = 0.0, y = 0.0, z = 0.0}, Vec3{x = 0.0, y = 1.0, z = 0.0})
    let p0 = mat4_transform_point(vista, Vec3{x = 0.0, y = 0.0, z = 0.0})
    expect(perto(p0.x, 0.0))
    expect(perto(p0.y, 0.0))
    expect(perto(p0.z, -5.0))
    let p1 = mat4_transform_point(vista, Vec3{x = 1.0, y = 0.0, z = 0.0})
    expect(perto(p1.x, 1.0))
    expect(perto(p1.y, 0.0))
    expect(perto(p1.z, -5.0))
}
