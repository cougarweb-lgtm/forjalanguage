// std:math - testes do modulo (S4 P2). Anexados ao texto de std:math SO em forja test std:math (o build normal nao os ve).
// Versao: 0.2.0. Changelog: 0.2.0 - S4 P4: 8 testes (+ trig aproximada, gemeas f32, constantes, is_nan/is_inf/is_finite, graus/lerp/sign) com os valores exatos das fixtures 366..372. 0.1.0 - S4 P2: 3 testes com valores exatos das fixtures 366..368 e 372 (sem comparacao de f64 trigonometrico).
// Sem import e sem proc main: o pedaco fica dentro do modulo, entao chama as procs dele SEM prefixo math.

test "trig de zero e exata" {
    let zero: f64 = 0.0
    expect(sin(zero) == 0.0)
    expect(cos(zero) == 1.0)
}

test "arredonda metade para longe do zero" {
    expect(round(2.5) == 3.0)
    expect(round(-2.5) == -3.0)
    expect(floor(-0.5) == -1.0)
    expect(ceil(0.5) == 1.0)
}

test "exp log e puras" {
    expect(exp(0.0) == 1.0)
    expect(log2(8.0) == 3.0)
    expect(is_nan(nan()))
    expect(lerp(1.0, 3.0, 0.5) == 2.0)
    expect(sign(-4.0) == -1.0)
}

test "trig f64 aproximada de pi" {
    let meio_pi: f64 = PI / 2.0
    expect(abs(sin(PI)) < 0.000000001)
    expect(abs(cos(PI) + 1.0) < 0.000000001)
    expect(abs(asin(1.0) - meio_pi) < 0.000000001)
}

test "gemeas f32 exatas" {
    let zero: f32 = 0.0
    let um: f32 = 1.0
    let negativo: f32 = -2.5
    expect(sin(zero) == 0.0)
    expect(cos(zero) == 1.0)
    expect(exp(um) == E_F32)
    expect(exp2(um) == 2.0)
    expect(log(um) == 0.0)
    expect(round(negativo) == -3.0)
    expect(floor(negativo) == -3.0)
    expect(trunc(negativo) == -2.0)
}

test "constantes f64 e f32" {
    expect(PI == 3.141592653589793)
    expect(TAU == 6.283185307179586)
    expect(E == 2.718281828459045)
    expect(PI_F32 == 3.1415927)
    expect(TAU_F32 == 6.2831855)
    expect(E_F32 == 2.7182817)
    expect(1.0 + EPSILON > 1.0)
    expect(1.0 + EPSILON_F32 > 1.0)
}

test "is_nan is_inf is_finite" {
    let inf64 = inf()
    let nan64 = nan()
    expect(is_nan(nan64))
    expect(not is_nan(0.0))
    expect(is_inf(inf64))
    expect(is_inf(-inf64))
    expect(not is_inf(nan64))
    expect(is_finite(1.5))
    expect(not is_finite(inf64))
    expect(not is_finite(nan64))
    expect(is_inf(inf_f32()))
    expect(is_nan(nan_f32()))
}

test "graus lerp e sign" {
    expect(deg_to_rad(180.0) == PI)
    expect(rad_to_deg(PI) == 180.0)
    expect(rad_to_deg(PI_F32) == 180.0)
    expect(lerp(0.0, 10.0, 0.25) == 2.5)
    expect(sign(-3.0) == -1.0)
    expect(sign(0.0) == 0.0)
    expect(is_nan(sign(nan())))
}
