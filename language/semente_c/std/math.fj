// std:math - funcoes de ponto flutuante da libm do musl, constantes e procs puros (S3 P3, L11b-1). Uso: import "std:math" as math; math.sin(x).
// Versao: 0.2.0. Changelog: 0.2.0 - L11b-1: gemeas f32 privadas (<nome>_f32, nao-pub: o gancho de sem_math_std.c as escolhe quando o argumento e f32), constantes (PI TAU E EPSILON e as _F32), INF/NAN como procs inf() nan() (inf_f32, nan_f32), procs puros (is_nan is_inf is_finite lerp sign deg_to_rad rad_to_deg). 0.1.0 - L11a-2: 21 funcoes f64 como foreign de alias sobre forja_math_*.
// Sem errno: o musl nao toca errno; NaN e +-inf seguem o Anexo F do C (log(0) = -inf, log(-1) = NaN, pow(0, -1) = inf).
// Tipos: um literal sozinho como argumento vale f64 (diverge do sqrt embutido, onde literal vira f32). Com 2 ou 3 argumentos os tipos sao iguais e o literal se adapta ao outro.
// Misturar f32 e f64, passar inteiro ou unidade = E0334. math.sqrt NAO existe: sqrt e embutido (f32 ou f64, literal vira f32).
// Ordem: round arredonda metade para longe do zero (igual ao musl). Posse: nenhuma funcao aloca nem guarda nada.

pub foreign {
    proc sin = "forja_math_sin"(x: f64) -> f64
    proc cos = "forja_math_cos"(x: f64) -> f64
    proc tan = "forja_math_tan"(x: f64) -> f64
    proc asin = "forja_math_asin"(x: f64) -> f64
    proc acos = "forja_math_acos"(x: f64) -> f64
    proc atan = "forja_math_atan"(x: f64) -> f64
    proc atan2 = "forja_math_atan2"(y: f64, x: f64) -> f64
    proc exp = "forja_math_exp"(x: f64) -> f64
    proc exp2 = "forja_math_exp2"(x: f64) -> f64
    proc log = "forja_math_log"(x: f64) -> f64
    proc log2 = "forja_math_log2"(x: f64) -> f64
    proc log10 = "forja_math_log10"(x: f64) -> f64
    proc pow = "forja_math_pow"(x: f64, y: f64) -> f64
    proc cbrt = "forja_math_cbrt"(x: f64) -> f64
    proc hypot = "forja_math_hypot"(x: f64, y: f64) -> f64
    proc fmod = "forja_math_fmod"(x: f64, y: f64) -> f64
    proc floor = "forja_math_floor"(x: f64) -> f64
    proc ceil = "forja_math_ceil"(x: f64) -> f64
    proc round = "forja_math_round"(x: f64) -> f64
    proc trunc = "forja_math_trunc"(x: f64) -> f64
    proc copysign = "forja_math_copysign"(x: f64, y: f64) -> f64
}

// Gemeas f32 (privadas): so o gancho de sem_math_std.c chama estas, com argumento f32.
foreign {
    proc sin_f32 = "forja_math_sinf"(x: f32) -> f32
    proc cos_f32 = "forja_math_cosf"(x: f32) -> f32
    proc tan_f32 = "forja_math_tanf"(x: f32) -> f32
    proc asin_f32 = "forja_math_asinf"(x: f32) -> f32
    proc acos_f32 = "forja_math_acosf"(x: f32) -> f32
    proc atan_f32 = "forja_math_atanf"(x: f32) -> f32
    proc atan2_f32 = "forja_math_atan2f"(y: f32, x: f32) -> f32
    proc exp_f32 = "forja_math_expf"(x: f32) -> f32
    proc exp2_f32 = "forja_math_exp2f"(x: f32) -> f32
    proc log_f32 = "forja_math_logf"(x: f32) -> f32
    proc log2_f32 = "forja_math_log2f"(x: f32) -> f32
    proc log10_f32 = "forja_math_log10f"(x: f32) -> f32
    proc pow_f32 = "forja_math_powf"(x: f32, y: f32) -> f32
    proc cbrt_f32 = "forja_math_cbrtf"(x: f32) -> f32
    proc hypot_f32 = "forja_math_hypotf"(x: f32, y: f32) -> f32
    proc fmod_f32 = "forja_math_fmodf"(x: f32, y: f32) -> f32
    proc floor_f32 = "forja_math_floorf"(x: f32) -> f32
    proc ceil_f32 = "forja_math_ceilf"(x: f32) -> f32
    proc round_f32 = "forja_math_roundf"(x: f32) -> f32
    proc trunc_f32 = "forja_math_truncf"(x: f32) -> f32
    proc copysign_f32 = "forja_math_copysignf"(x: f32, y: f32) -> f32
}

// Constantes f64 e as gemeas f32 (EPSILON difere por tipo: 2^-52 e 2^-23).
pub const PI: f64 = 3.141592653589793
pub const TAU: f64 = 6.283185307179586
pub const E: f64 = 2.718281828459045
pub const EPSILON: f64 = 0.0000000000000002220446049250313
pub const PI_F32: f32 = 3.1415927
pub const TAU_F32: f32 = 6.2831855
pub const E_F32: f32 = 2.7182817
pub const EPSILON_F32: f32 = 0.00000011920929

// INF e NAN nao sao const: a const da Forja recusa 1.0 / 0.0 com E0420 (divisao real por zero constante nao dobra). Sao procs com divisao em tempo de execucao.
pub proc inf() -> f64 {
    let um: f64 = 1.0
    let zero: f64 = 0.0
    return um / zero
}

pub proc inf_f32() -> f32 {
    let um: f32 = 1.0
    let zero: f32 = 0.0
    return um / zero
}

pub proc nan() -> f64 {
    let zero: f64 = 0.0
    return zero / zero
}

pub proc nan_f32() -> f32 {
    let zero: f32 = 0.0
    return zero / zero
}

// Pura: x e NaN.
pub proc is_nan(x: f64) -> bool {
    return x != x
}

proc is_nan_f32(x: f32) -> bool {
    return x != x
}

// Pura: x e +inf ou -inf (x - x vira NaN so para infinito).
pub proc is_inf(x: f64) -> bool {
    return x == x and x - x != 0.0
}

proc is_inf_f32(x: f32) -> bool {
    return x == x and x - x != 0.0
}

// Pura: x e finito (nao NaN e nao infinito).
pub proc is_finite(x: f64) -> bool {
    return x - x == 0.0
}

proc is_finite_f32(x: f32) -> bool {
    return x - x == 0.0
}

// Pura: a + (b - a) * t, sem limitar t a [0, 1].
pub proc lerp(a: f64, b: f64, t: f64) -> f64 {
    return a + (b - a) * t
}

proc lerp_f32(a: f32, b: f32, t: f32) -> f32 {
    return a + (b - a) * t
}

// Pura: 1.0 se x > 0, -1.0 se x < 0; para +-0 e NaN devolve x (mantem o zero com sinal e o NaN).
pub proc sign(x: f64) -> f64 {
    if x > 0.0 {
        return 1.0
    }
    if x < 0.0 {
        return -1.0
    }
    return x
}

proc sign_f32(x: f32) -> f32 {
    if x > 0.0 {
        return 1.0
    }
    if x < 0.0 {
        return -1.0
    }
    return x
}

// Pura: graus para radianos e de volta (x * PI / 180 e x * 180 / PI).
pub proc deg_to_rad(x: f64) -> f64 {
    return x * PI / 180.0
}

proc deg_to_rad_f32(x: f32) -> f32 {
    return x * PI_F32 / 180.0
}

pub proc rad_to_deg(x: f64) -> f64 {
    return x * 180.0 / PI
}

proc rad_to_deg_f32(x: f32) -> f32 {
    return x * 180.0 / PI_F32
}
