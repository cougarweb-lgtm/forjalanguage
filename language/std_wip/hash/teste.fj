import "hash"

// Bytes de um texto, numa lista do alocador que o chamador passou (delete so se for heap).
proc bytes_de(s: str, alloc: Allocator) -> [dynamic]u8 {
    var out = make([dynamic]u8, alloc = alloc)
    for i in 0..<len(s) {
        append(&out, item = s[i])
    }
    return out
}

proc main() {
    var vazio = bytes_de("", alloc = heap)
    defer delete(vazio)
    var a = bytes_de("a", alloc = heap)
    defer delete(a)
    var foobar = bytes_de("foobar", alloc = heap)
    defer delete(foobar)
    var abc = bytes_de("abc", alloc = heap)
    defer delete(abc)
    var nobody = bytes_de("Nobody inspects the spammish repetition", alloc = heap)
    defer delete(nobody)
    var digitos = bytes_de("123456789", alloc = heap)
    defer delete(digitos)
    var raposa = bytes_de("The quick brown fox jumps over the lazy dog", alloc = heap)
    defer delete(raposa)

    let f1 = hash.fnv1a_64(vazio[..])
    print(f"{f1:016x}")
    let f2 = hash.fnv1a_64(a[..])
    print(f"{f2:016x}")
    let f3 = hash.fnv1a_64(foobar[..])
    print(f"{f3:016x}")

    let x1 = hash.xxh64(vazio[..], 0)
    print(f"{x1:016x}")
    let x2 = hash.xxh64(abc[..], 0)
    print(f"{x2:016x}")
    let x3 = hash.xxh64(nobody[..], 0)
    print(f"{x3:016x}")
    let x4 = hash.xxh64(abc[..], 1)
    print(f"{x4:016x}")
    let x5 = hash.xxh64(nobody[..], 0x0123456789ABCDEF)
    print(f"{x5:016x}")
    let x6 = hash.xxh64(vazio[..], 1)
    print(f"{x6:016x}")

    let c1 = hash.crc32(digitos[..])
    print(f"{c1:08x}")
    let c2 = hash.crc32(vazio[..])
    print(f"{c2:08x}")
    let c3 = hash.crc32(raposa[..])
    print(f"{c3:08x}")
}
