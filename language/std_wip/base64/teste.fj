import "base64"

// Bytes de um texto, numa lista do alocador que o chamador passou (delete so se for heap).
proc bytes_de(s: str, alloc: Allocator) -> [dynamic]u8 {
    var out = make([dynamic]u8, alloc = alloc)
    for i in 0..<len(s) {
        append(&out, item = s[i])
    }
    return out
}

// Imprime os bytes em hex minusculo (2 digitos por byte), numa linha.
proc imprime_hex(b: []u8) {
    var saida = make([dynamic]u8, alloc = heap)
    defer delete(saida)
    let digitos = "0123456789abcdef"
    for i in 0..<len(b) {
        append(&saida, item = digitos[(b[i] >> 4) as int])
        append(&saida, item = digitos[(b[i] & 0x0F) as int])
    }
    let h = from_bytes(saida[..], alloc = heap)
    print(h)
    delete(h)
}

proc nome_erro(e: base64.CodecError) {
    switch e {
    case base64.CodecError.tamanho_invalido:
        print("erro tamanho_invalido")
    case base64.CodecError.caractere_invalido:
        print("erro caractere_invalido")
    }
}

proc mostra_decode(s: str) {
    switch r in base64.decode(s, alloc = heap) {
    case [dynamic]u8:
        imprime_hex(r[..])
        delete(r)
    case base64.CodecError:
        nome_erro(r)
    }
}

proc mostra_decode_url(s: str) {
    switch r in base64.decode_url(s, alloc = heap) {
    case [dynamic]u8:
        imprime_hex(r[..])
        delete(r)
    case base64.CodecError:
        nome_erro(r)
    }
}

proc mostra_hex_decode(s: str) {
    switch r in base64.hex_decode(s, alloc = heap) {
    case [dynamic]u8:
        imprime_hex(r[..])
        delete(r)
    case base64.CodecError:
        nome_erro(r)
    }
}

// Codifica o texto com encode e imprime o resultado, liberando o str.
proc mostra_encode(s: str) {
    var b = bytes_de(s, alloc = heap)
    defer delete(b)
    let c = base64.encode(b[..], alloc = heap)
    print(c)
    delete(c)
}

proc main() {
    mostra_encode("")
    mostra_encode("f")
    mostra_encode("fo")
    mostra_encode("foo")
    mostra_encode("foob")
    mostra_encode("fooba")
    mostra_encode("foobar")

    var f = bytes_de("f", alloc = heap)
    defer delete(f)
    let sp1 = base64.encode_sem_padding(f[..], alloc = heap)
    print(sp1)
    delete(sp1)
    var fo = bytes_de("fo", alloc = heap)
    defer delete(fo)
    let sp2 = base64.encode_sem_padding(fo[..], alloc = heap)
    print(sp2)
    delete(sp2)
    var foob = bytes_de("foob", alloc = heap)
    defer delete(foob)
    let sp3 = base64.encode_sem_padding(foob[..], alloc = heap)
    print(sp3)
    delete(sp3)

    var fbffbf: [3]u8 = {0xFB, 0xFF, 0xBF}
    let u1 = base64.encode_url(fbffbf[..], alloc = heap)
    print(u1)
    delete(u1)
    var ffef: [2]u8 = {0xFF, 0xEF}
    let u2 = base64.encode_url(ffef[..], alloc = heap)
    print(u2)
    delete(u2)
    let p1 = base64.encode(ffef[..], alloc = heap)
    print(p1)
    delete(p1)

    mostra_decode("Zm9vYmFy")
    mostra_decode("Zm9vYg")
    mostra_decode_url("-_-_")
    mostra_decode("+/+/")
    mostra_decode("Zm9!")
    mostra_decode("Z")
    mostra_decode("Zg=")
    mostra_decode("Zm9")
    mostra_decode("Zg===")

    var hexbytes: [5]u8 = {0x00, 0x7F, 0x80, 0xFF, 0x0A}
    let hx = base64.hex_encode(hexbytes[..], alloc = heap)
    print(hx)
    delete(hx)
    mostra_hex_decode("DEADbeef")
    mostra_hex_decode("abc")
    mostra_hex_decode("zz")

    var todos = make([dynamic]u8, alloc = heap, cap = 256)
    defer delete(todos)
    for i in 0..<256 {
        append(&todos, item = i as u8)
    }
    let codificado = base64.encode(todos[..], alloc = heap)
    var igual = true
    switch d in base64.decode(codificado, alloc = heap) {
    case [dynamic]u8:
        for i in 0..<256 {
            if d[i] != todos[i] {
                igual = false
            }
        }
        delete(d)
    case base64.CodecError:
        igual = false
    }
    delete(codificado)
    print(igual)

    let hexcodificado = base64.hex_encode(todos[..], alloc = heap)
    var igual_hex = true
    switch d in base64.hex_decode(hexcodificado, alloc = heap) {
    case [dynamic]u8:
        for i in 0..<256 {
            if d[i] != todos[i] {
                igual_hex = false
            }
        }
        delete(d)
    case base64.CodecError:
        igual_hex = false
    }
    delete(hexcodificado)
    print(igual_hex)
}
