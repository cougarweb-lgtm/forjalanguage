import "binary"

// Hex minusculo de b (2 digitos por byte). Devolve texto no heap: o chamador faz delete.
proc hex_de(b: []u8) -> str {
    var saida = make([dynamic]u8, alloc = heap)
    defer delete(saida)
    let digitos = "0123456789abcdef"
    for i in 0..<len(b) {
        append(&saida, item = digitos[(b[i] >> 4) as int])
        append(&saida, item = digitos[(b[i] & 0x0F) as int])
    }
    return from_bytes(saida[..], alloc = heap)
}

proc nome_erro(e: binary.BinaryError) {
    switch e {
    case binary.BinaryError.fora_da_faixa:
        print("erro fora_da_faixa")
    case binary.BinaryError.varint_incompleto:
        print("erro varint_incompleto")
    case binary.BinaryError.varint_longo:
        print("erro varint_longo")
    }
}

proc mostra_u16_le(b: []u8, at: int) {
    switch v in binary.read_u16_le(b, at) {
    case u16:
        print(f"{v:04x}")
    case binary.BinaryError:
        nome_erro(v)
    }
}

proc mostra_u16_be(b: []u8, at: int) {
    switch v in binary.read_u16_be(b, at) {
    case u16:
        print(f"{v:04x}")
    case binary.BinaryError:
        nome_erro(v)
    }
}

proc mostra_u32_le(b: []u8, at: int) {
    switch v in binary.read_u32_le(b, at) {
    case u32:
        print(f"{v:08x}")
    case binary.BinaryError:
        nome_erro(v)
    }
}

proc mostra_u32_be(b: []u8, at: int) {
    switch v in binary.read_u32_be(b, at) {
    case u32:
        print(f"{v:08x}")
    case binary.BinaryError:
        nome_erro(v)
    }
}

proc mostra_u64_le(b: []u8, at: int) {
    switch v in binary.read_u64_le(b, at) {
    case u64:
        print(f"{v:016x}")
    case binary.BinaryError:
        nome_erro(v)
    }
}

proc mostra_u64_be(b: []u8, at: int) {
    switch v in binary.read_u64_be(b, at) {
    case u64:
        print(f"{v:016x}")
    case binary.BinaryError:
        nome_erro(v)
    }
}

proc mostra_uvarint(b: []u8, at: int) {
    switch v in binary.read_uleb128(b, at) {
    case binary.UVarint:
        print(f"{v.value:x} {v.size}")
    case binary.BinaryError:
        nome_erro(v)
    }
}

proc mostra_svarint(b: []u8, at: int) {
    switch v in binary.read_sleb128(b, at) {
    case binary.SVarint:
        print(f"{v.value} {v.size}")
    case binary.BinaryError:
        nome_erro(v)
    }
}

// Codifica valor sem sinal, imprime os bytes em hex e depois le de volta.
proc caso_uleb(valor: u64) {
    var buf = make([dynamic]u8, alloc = heap)
    defer delete(buf)
    binary.write_uleb128(&buf, valor)
    let h = hex_de(buf[..])
    defer delete(h)
    print(h)
    mostra_uvarint(buf[..], 0)
}

// Codifica valor com sinal, imprime os bytes em hex e depois le de volta.
proc caso_sleb(valor: i64) {
    var buf = make([dynamic]u8, alloc = heap)
    defer delete(buf)
    binary.write_sleb128(&buf, valor)
    let h = hex_de(buf[..])
    defer delete(h)
    print(h)
    mostra_svarint(buf[..], 0)
}

proc main() {
    var b: [8]u8 = {1, 2, 3, 4, 5, 6, 7, 8}
    mostra_u16_le(b[..], 0)
    mostra_u16_be(b[..], 0)
    mostra_u32_le(b[..], 0)
    mostra_u32_be(b[..], 4)
    mostra_u64_le(b[..], 0)
    mostra_u64_be(b[..], 0)
    mostra_u16_le(b[..], 7)
    mostra_u32_be(b[..], -1)
    mostra_u64_be(b[..], 1)
    mostra_u16_be(b[..], 6)
    mostra_u16_le(b[0..<0], 0)

    var out = make([dynamic]u8, alloc = heap)
    defer delete(out)
    binary.write_u16_le(&out, 0x1234)
    binary.write_u16_be(&out, 0x1234)
    binary.write_u32_le(&out, 0x01020304)
    binary.write_u32_be(&out, 0xA1B2C3D4)
    binary.write_u64_le(&out, 0xFFFFFFFFFFFFFFFF)
    binary.write_u64_be(&out, 0x0102030405060708)
    print(len(out))
    mostra_u16_le(out[..], 0)
    mostra_u16_be(out[..], 2)
    mostra_u32_le(out[..], 4)
    mostra_u32_be(out[..], 8)
    mostra_u64_le(out[..], 12)
    mostra_u64_be(out[..], 20)
    print(f"{out[0]:02x} {out[2]:02x} {out[4]:02x}")
    mostra_u16_le(out[..], 27)

    caso_uleb(0)
    caso_uleb(624485)
    caso_uleb(300)
    caso_uleb(127)
    caso_uleb(128)
    caso_uleb(0xFFFFFFFFFFFFFFFF)
    var longo: [10]u8 = {0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0x02}
    mostra_uvarint(longo[..], 0)
    var incompleto: [2]u8 = {0x80, 0x80}
    mostra_uvarint(incompleto[..], 0)
    mostra_uvarint(b[0..<0], 0)

    caso_sleb(2)
    caso_sleb(-2)
    caso_sleb(127)
    caso_sleb(-128)
    caso_sleb(-123456)
    caso_sleb(-1)
    caso_sleb(0)
    var meio: [1]u8 = {0x40}
    mostra_svarint(meio[..], 0)
    caso_sleb(9223372036854775807)
    caso_sleb(-9223372036854775808)
    var sinal_longo: [10]u8 = {0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0x01}
    mostra_svarint(sinal_longo[..], 0)
}
