// Teste do linalg (A14): valores calculados a mao. Cada valor sai como x*1000 arredondado (metade para longe do zero) e a comparacao tem tolerancia 1e-5. Rodar: forja run teste.fj (e --backend c); saida em teste.esperado.
import "linalg"
import "std:math" as math

// x*1000 arredondado (metade para longe do zero): 0.6 vira 600 e -1.5 vira -1500.
proc milesimos(x: f32) -> int {
    let v = x * 1000.0
    if v < 0.0 {
        return 0 - ((0.0 - v + 0.5) as int)
    }
    return (v + 0.5) as int
}

// Compara com tolerancia 1e-5 e imprime rotulo, x*1000 e ok ou FALHOU.
proc conferir(rotulo: str, obtido: f32, esperado: f32) {
    let mil = milesimos(obtido)
    if abs(obtido - esperado) <= 0.00001 {
        print(f"{rotulo} {mil} ok")
    } else {
        print(f"{rotulo} {mil} FALHOU")
    }
}

// Mesma conferencia de conferir, com o eixo (x, y ou z) impresso depois do rotulo. f"..." so vale como 1o argumento de print.
proc conferir_eixo(rotulo: str, eixo: str, obtido: f32, esperado: f32) {
    let mil = milesimos(obtido)
    if abs(obtido - esperado) <= 0.00001 {
        print(f"{rotulo} {eixo} {mil} ok")
    } else {
        print(f"{rotulo} {eixo} {mil} FALHOU")
    }
}

// Confere as tres coordenadas de um ponto, com o rotulo e o eixo x, y, z.
proc conferir_ponto(rotulo: str, p: linalg.Vec3, x: f32, y: f32, z: f32) {
    conferir_eixo(rotulo, "x", p.x, x)
    conferir_eixo(rotulo, "y", p.y, y)
    conferir_eixo(rotulo, "z", p.z, z)
}

proc testar_vetores() {
    let a2 = linalg.Vec2{x = 1.5, y = -2.0}
    let b2 = linalg.Vec2{x = 0.25, y = 0.5}
    let s2 = linalg.vec2_add(a2, b2)
    conferir("vec2_add x", s2.x, 1.75)
    conferir("vec2_add y", s2.y, -1.5)
    let d2 = linalg.vec2_sub(a2, b2)
    conferir("vec2_sub x", d2.x, 1.25)
    conferir("vec2_sub y", d2.y, -2.5)
    let k2 = linalg.vec2_scale(a2, 2.0)
    conferir("vec2_scale x", k2.x, 3.0)
    conferir("vec2_scale y", k2.y, -4.0)
    conferir("vec2_dot", linalg.vec2_dot(linalg.Vec2{x = 3.0, y = 4.0}, linalg.Vec2{x = 1.0, y = 2.0}), 11.0)
    conferir("vec2_length", linalg.vec2_length(linalg.Vec2{x = 3.0, y = 4.0}), 5.0)
    let n2 = linalg.vec2_normalize(linalg.Vec2{x = 3.0, y = 4.0})
    conferir("vec2_normalize x", n2.x, 0.6)
    conferir("vec2_normalize y", n2.y, 0.8)

    let a3 = linalg.Vec3{x = 1.0, y = 2.0, z = 3.0}
    let b3 = linalg.Vec3{x = 4.0, y = 5.0, z = 6.0}
    let s3 = linalg.vec3_add(a3, b3)
    conferir("vec3_add x", s3.x, 5.0)
    conferir("vec3_add y", s3.y, 7.0)
    conferir("vec3_add z", s3.z, 9.0)
    let d3 = linalg.vec3_sub(a3, b3)
    conferir("vec3_sub x", d3.x, -3.0)
    conferir("vec3_sub z", d3.z, -3.0)
    let ex = linalg.Vec3{x = 1.0, y = 0.0, z = 0.0}
    let ey = linalg.Vec3{x = 0.0, y = 1.0, z = 0.0}
    let cx = linalg.vec3_cross(ex, ey)
    conferir("vec3_cross ex*ey x", cx.x, 0.0)
    conferir("vec3_cross ex*ey y", cx.y, 0.0)
    conferir("vec3_cross ex*ey z", cx.z, 1.0)
    let c3 = linalg.vec3_cross(a3, b3)
    conferir("vec3_cross x", c3.x, -3.0)
    conferir("vec3_cross y", c3.y, 6.0)
    conferir("vec3_cross z", c3.z, -3.0)
    conferir("vec3_dot", linalg.vec3_dot(a3, b3), 32.0)
    conferir("vec3_length", linalg.vec3_length(linalg.Vec3{x = 2.0, y = 3.0, z = 6.0}), 7.0)
    let n3 = linalg.vec3_normalize(linalg.Vec3{x = 0.0, y = 0.0, z = 5.0})
    conferir("vec3_normalize x", n3.x, 0.0)
    conferir("vec3_normalize y", n3.y, 0.0)
    conferir("vec3_normalize z", n3.z, 1.0)

    let a4 = linalg.Vec4{x = 1.0, y = 2.0, z = 3.0, w = 4.0}
    let b4 = linalg.Vec4{x = 1.0, y = 1.0, z = 1.0, w = 1.0}
    let s4 = linalg.vec4_add(a4, b4)
    conferir("vec4_add x", s4.x, 2.0)
    conferir("vec4_add w", s4.w, 5.0)
    let d4 = linalg.vec4_sub(a4, b4)
    conferir("vec4_sub x", d4.x, 0.0)
    conferir("vec4_sub w", d4.w, 3.0)
    let k4 = linalg.vec4_scale(a4, 0.5)
    conferir("vec4_scale x", k4.x, 0.5)
    conferir("vec4_scale w", k4.w, 2.0)
    conferir("vec4_dot", linalg.vec4_dot(a4, linalg.Vec4{x = 4.0, y = 3.0, z = 2.0, w = 1.0}), 20.0)
    conferir("vec4_length", linalg.vec4_length(linalg.Vec4{x = 1.0, y = 2.0, z = 2.0, w = 4.0}), 5.0)
    let n4 = linalg.vec4_normalize(linalg.Vec4{x = 0.0, y = 3.0, z = 0.0, w = 4.0})
    conferir("vec4_normalize y", n4.y, 0.6)
    conferir("vec4_normalize w", n4.w, 0.8)
}

proc testar_matrizes() {
    let t = linalg.mat4_translate(linalg.Vec3{x = 1.0, y = 2.0, z = 3.0})
    conferir_ponto("translate origem", linalg.mat4_transform_point(t, linalg.Vec3{x = 0.0, y = 0.0, z = 0.0}), 1.0, 2.0, 3.0)
    let sc = linalg.mat4_scale(linalg.Vec3{x = 2.0, y = 3.0, z = 4.0})
    conferir_ponto("scale (1,1,1)", linalg.mat4_transform_point(sc, linalg.Vec3{x = 1.0, y = 1.0, z = 1.0}), 2.0, 3.0, 4.0)
    let meio_volta = math.PI_F32 / 2.0
    let rz = linalg.mat4_rotate_axis(linalg.Vec3{x = 0.0, y = 0.0, z = 1.0}, meio_volta)
    conferir_ponto("rot Z (1,0,0)", linalg.mat4_transform_point(rz, linalg.Vec3{x = 1.0, y = 0.0, z = 0.0}), 0.0, 1.0, 0.0)
    let rx = linalg.mat4_rotate_axis(linalg.Vec3{x = 1.0, y = 0.0, z = 0.0}, meio_volta)
    conferir_ponto("rot X (0,1,0)", linalg.mat4_transform_point(rx, linalg.Vec3{x = 0.0, y = 1.0, z = 0.0}), 0.0, 0.0, 1.0)
    let tr = linalg.mat4_translate(linalg.Vec3{x = 1.0, y = 0.0, z = 0.0})
    let sc2 = linalg.mat4_scale(linalg.Vec3{x = 2.0, y = 2.0, z = 2.0})
    let ordem_ts = linalg.mat4_mul(tr, sc2)
    conferir_ponto("tr*sc (1,1,1)", linalg.mat4_transform_point(ordem_ts, linalg.Vec3{x = 1.0, y = 1.0, z = 1.0}), 3.0, 2.0, 2.0)
    let ordem_st = linalg.mat4_mul(sc2, tr)
    conferir_ponto("sc*tr (1,1,1)", linalg.mat4_transform_point(ordem_st, linalg.Vec3{x = 1.0, y = 1.0, z = 1.0}), 4.0, 2.0, 2.0)
    let tt = linalg.mat4_transpose(t)
    conferir("transpose [3]", tt.elementos[3], 1.0)
    conferir("transpose [12]", tt.elementos[12], 0.0)
    switch inv in linalg.mat4_inverse(t) {
    case linalg.Mat4:
        conferir_ponto("inversa translate", linalg.mat4_transform_point(inv, linalg.Vec3{x = 0.0, y = 0.0, z = 0.0}), -1.0, -2.0, -3.0)
    case none:
        print("FALHOU: translate sem inversa")
    }
    let afim = linalg.mat4_mul(t, linalg.mat4_scale(linalg.Vec3{x = 2.0, y = 4.0, z = 8.0}))
    switch inv in linalg.mat4_inverse(afim) {
    case linalg.Mat4:
        conferir_ponto("inversa afim (3,6,11)", linalg.mat4_transform_point(inv, linalg.Vec3{x = 3.0, y = 6.0, z = 11.0}), 1.0, 1.0, 1.0)
    case none:
        print("FALHOU: afim sem inversa")
    }
    switch inv in linalg.mat4_inverse(linalg.mat4_scale(linalg.Vec3{x = 0.0, y = 1.0, z = 1.0})) {
    case linalg.Mat4:
        print("FALHOU: escala zero deveria ser singular")
    case none:
        print("singular ok")
    }
    let pm = linalg.mat4_perspective(math.PI_F32 / 2.0, 1.0, 1.0, 3.0)
    conferir("persp [0]", pm.elementos[0], 1.0)
    conferir("persp [5]", pm.elementos[5], 1.0)
    conferir("persp [10]", pm.elementos[10], -1.5)
    conferir("persp [11]", pm.elementos[11], -1.0)
    conferir("persp [14]", pm.elementos[14], -1.5)
    let vista = linalg.mat4_look_at(linalg.Vec3{x = 0.0, y = 0.0, z = 5.0}, linalg.Vec3{x = 0.0, y = 0.0, z = 0.0}, linalg.Vec3{x = 0.0, y = 1.0, z = 0.0})
    conferir_ponto("look_at origem", linalg.mat4_transform_point(vista, linalg.Vec3{x = 0.0, y = 0.0, z = 0.0}), 0.0, 0.0, -5.0)
    conferir_ponto("look_at (1,0,0)", linalg.mat4_transform_point(vista, linalg.Vec3{x = 1.0, y = 0.0, z = 0.0}), 1.0, 0.0, -5.0)
}

proc main() {
    testar_vetores()
    testar_matrizes()
}
