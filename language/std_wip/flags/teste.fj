// Teste do flags (A91): listas de args fixas (cada linha e separada por espaco) e os destinos, os posicionais, o erro e a ajuda. Rodar: forja run teste.fj (e --backend c); saida em teste.esperado.
import "flags"
import "std:text"
import "std:math" as math

// Imprime o texto do erro do parse, no alocador do heap, e libera.
proc imprimir_erro(e: flags.FlagError) {
    let texto = flags.erro_texto(e, alloc = heap)
    print(texto)
    delete(texto)
}

// Registra as 4 flags, le a linha de argumentos e imprime o resultado: erro (se houve), destinos, posicionais e ajuda.
proc executar(linha: str) {
    var n = 0
    var nome = ""
    var verbose = false
    var fator = math.E
    var p = flags.parser_new("prog", alloc = heap)
    defer flags.parser_delete(&p)
    flags.add_int(&p, &n, name = "n", fallback = 3, help = "quantidade")
    flags.add_str(&p, &nome, name = "nome", fallback = "anon", help = "nome do usuario")
    flags.add_bool(&p, &verbose, name = "verbose", fallback = false, help = "mais saida")
    flags.add_f64(&p, &fator, name = "fator", fallback = 0.5, help = "escala")
    var args = text.split(linha, " ", alloc = heap)
    defer delete(args)
    switch erro in flags.parse(&p, args[..]) {
    case flags.FlagError:
        imprimir_erro(erro)
    case none:
        print("sem erro")
    }
    print(f"n={n} nome={nome} verbose={verbose} fator={fator:.2}")
    let posicionais = text.join(p.rest[..], "|", alloc = heap)
    print(f"rest={posicionais}")
    delete(posicionais)
    let ajuda = flags.usage(&p, alloc = heap)
    print(ajuda)
    delete(ajuda)
}

proc main() {
    executar("prog")
    executar("prog --n 7 --nome=ana -verbose --fator 1.25 pos1 -- --nao-e-flag")
    executar("prog --desconhecida")
    executar("prog --n")
    executar("prog --n abc")
    executar("prog --fator xyz")
    executar("prog --verbose=talvez")
}
