import "uuid"

proc nome_erro(e: uuid.UuidError) {
    switch e {
    case uuid.UuidError.tamanho_invalido:
        print("erro tamanho_invalido")
    case uuid.UuidError.formato_invalido:
        print("erro formato_invalido")
    case uuid.UuidError.tempo_invalido:
        print("erro tempo_invalido")
    }
}

// Formata u, imprime o texto e libera o str.
proc mostra_texto(u: [16]u8) {
    let t = uuid.format_uuid(u, alloc = heap)
    print(t)
    delete(t)
}

// Le s com parse_uuid e imprime o texto de volta, ou o erro.
proc mostra_parse(s: str) {
    switch r in uuid.parse_uuid(s) {
    case [16]u8:
        mostra_texto(r)
    case uuid.UuidError:
        nome_erro(r)
    }
}

// Texto de u lido de volta com parse_uuid: a ida e volta tem de devolver o mesmo texto.
proc ida_e_volta(u: [16]u8) {
    let t = uuid.format_uuid(u, alloc = heap)
    defer delete(t)
    mostra_parse(t)
}

// Gera v4 com os bytes dados e imprime o texto, a versao, a variante e a ida e volta.
proc mostra_v4(bytes: []u8) {
    switch r in uuid.v4(bytes) {
    case [16]u8:
        mostra_texto(r)
        print(uuid.versao(r))
        print(uuid.variante_rfc(r))
        ida_e_volta(r)
    case uuid.UuidError:
        nome_erro(r)
    }
}

// Gera v7 com os bytes e o carimbo dados e imprime o texto, a versao e a variante.
proc mostra_v7(bytes: []u8, unix_ms: u64) {
    switch r in uuid.v7(bytes, unix_ms) {
    case [16]u8:
        mostra_texto(r)
        print(uuid.versao(r))
        print(uuid.variante_rfc(r))
    case uuid.UuidError:
        nome_erro(r)
    }
}

proc main() {
    var aleatorio16: [16]u8 = {0x00, 0x11, 0x22, 0x33, 0x44, 0x55, 0x66, 0x77, 0x88, 0x99, 0xAA, 0xBB, 0xCC, 0xDD, 0xEE, 0xFF}
    mostra_v4(aleatorio16[..])

    var curto: [15]u8 = {0x00, 0x11, 0x22, 0x33, 0x44, 0x55, 0x66, 0x77, 0x88, 0x99, 0xAA, 0xBB, 0xCC, 0xDD, 0xEE}
    mostra_v4(curto[..])

    var aleatorio10: [10]u8 = {0xFF, 0xAB, 0x3F, 0x11, 0x22, 0x33, 0x44, 0x55, 0x66, 0x77}
    mostra_v7(aleatorio10[..], 0x0123456789AB)
    mostra_v7(aleatorio10[..], 0x1000000000000)
    var aleatorio16b: [16]u8 = {0x00, 0x11, 0x22, 0x33, 0x44, 0x55, 0x66, 0x77, 0x88, 0x99, 0xAA, 0xBB, 0xCC, 0xDD, 0xEE, 0xFF}
    mostra_v7(aleatorio16b[..], 0x0123456789AB)

    mostra_parse("01234567-89AB-7FAB-BF11-223344556677")
    mostra_parse("")
    mostra_parse("00112233x4455-4677-8899-aabbccddeeff")
    mostra_parse("0011223Z-4455-4677-8899-aabbccddeeff")
}
