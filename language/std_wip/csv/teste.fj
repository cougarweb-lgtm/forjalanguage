// Teste do csv (V01): casos do RFC 4180, erros explicitos e ida e volta do escritor. Rodar: forja run teste.fj (e --backend c); saida em teste.esperado.
import "csv"
import "std:text"

// Nome de cada erro, com o prefixo que a saida mostra.
proc descrever_erro(e: csv.CsvError) -> str {
    switch e {
    case csv.CsvError.aspas_nao_fechadas:
        return "erro: aspas_nao_fechadas"
    case csv.CsvError.aspas_mal_posicionadas:
        return "erro: aspas_mal_posicionadas"
    case csv.CsvError.separador_invalido:
        return "erro: separador_invalido"
    }
    return "erro: desconhecido"
}

// Le o texto inteiro e imprime cada registro com os campos juntos por |; no fim imprime ok ou o erro.
proc mostrar(texto: str, sep: str) {
    var r = csv.reader_new(texto, sep = sep)
    defer csv.reader_delete(&r)
    var campos = make([dynamic]str, alloc = heap)
    defer delete(campos)
    while csv.next_record(&r, fields = &campos) {
        let linha = text.join(campos[..], "|", alloc = heap)
        print(linha)
        delete(linha)
    }
    switch e in r.erro {
    case csv.CsvError:
        print(descrever_erro(e))
    case none:
        print("ok")
    }
}

// Escreve dois registros (um com campo que precisa de aspas), imprime o texto e le de volta.
proc escrever() {
    var w = csv.writer_new(csv.VIRGULA)
    defer csv.writer_delete(&w)
    var primeiro: [5]str = {"a", "b,c", "d\"e", "f\ng", ""}
    csv.write_record(&w, primeiro[..])
    var segundo: [3]str = {"x", "y z", ""}
    csv.write_record(&w, segundo[..])
    let texto = csv.writer_texto(&w, alloc = heap)
    defer delete(texto)
    print(texto)
    mostrar(texto, csv.VIRGULA)
}

proc main() {
    // RFC 4180, secao 2: CRLF e campos simples.
    mostrar("aaa,bbb,ccc\r\nzzz,yyy,xxx\r\n", csv.VIRGULA)
    // Aspas em volta, aspa dobrada e virgula dentro do campo; ultima linha com LF.
    mostrar("\"campo, com virgula\",\"aspas \"\"dentro\"\"\",fim\n", csv.VIRGULA)
    // Quebra de linha dentro de aspas, CRLF, e ultima linha sem quebra.
    mostrar("\"linha1\nlinha2\",x\r\n\"y\",z", csv.VIRGULA)
    // Campos vazios e linha vazia.
    mostrar(",,\n\nx,", csv.VIRGULA)
    // Separador ponto e virgula e campo citado vazio.
    mostrar("a;\"b;c\";d\n\"\";\"\"", csv.PONTO_VIRGULA)
    // Erros explicitos: aspa nao fechada, texto depois da aspa, separador invalido.
    mostrar("\"abc,def\n", csv.VIRGULA)
    mostrar("\"a\"b,c\n", csv.VIRGULA)
    mostrar("a,b\n", "ab")
    escrever()
}
