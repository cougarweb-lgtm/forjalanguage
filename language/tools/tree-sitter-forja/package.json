{
  "name": "tree-sitter-forja",
  "version": "0.9.0",
  "description": "Gramatica tree-sitter da linguagem Forja (.fj)",
  "main": "bindings/node",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "gerar": "tree-sitter generate",
    "teste": "tree-sitter test"
  },
  "tree-sitter": [
    {
      "scope": "source.forja",
      "file-types": [
