// std:path - testes do modulo (S4 P5). Anexados ao texto de std:path SO em forja test std:path (o build normal nao os ve).
// Versao: 0.1.0. Changelog: 0.1.0 - S4 P5: contrato das fixtures 283 (fatias), 284 (clean), 285 (join), 286 (rel) e 287 (with_ext) com os valores do .esperado do alvo Windows ('\' e o separador nativo).
// Sem import e sem proc main: o pedaco fica dentro do modulo, entao chama as procs dele SEM prefixo path. O import "std:os" do topo do path.fj ja vale aqui.

test "fatias base dir ext stem" {
    expect(base("a/b") == "b")
    expect(base("") == ".")
    expect(base("///") == "\\")
    expect(dir("a/b") == "a")
    expect(dir("a") == ".")
    expect(dir("///") == "/")
    expect(ext("a.tar.gz") == ".gz")
    expect(ext("a") == "")
    expect(stem("a/b") == "b")
    expect(stem("..") == "..")
}

test "is_abs e split" {
    expect(is_abs("/a/b/"))
    expect(is_abs("a/b") == false)
    let dir_parte, arquivo = split("a/b")
    expect(dir_parte == "a/")
    expect(arquivo == "b")
    let dir_raiz, arquivo_raiz = split("/a/b/")
    expect(dir_raiz == "/a/b/")
    expect(arquivo_raiz == "")
}

test "clean normaliza com separador nativo" {
    let barras = clean("a//b", alloc = heap)
    defer delete(barras)
    expect(barras == "a\\b")
    let voltas = clean("a/../b", alloc = heap)
    defer delete(voltas)
    expect(voltas == "b")
    let vazio = clean("", alloc = heap)
    defer delete(vazio)
    expect(vazio == ".")
    let raiz = clean("/..", alloc = heap)
    defer delete(raiz)
    expect(raiz == "\\")
    let acima = clean("../../a", alloc = heap)
    defer delete(acima)
    expect(acima == "..\\..\\a")
    let so_acima = clean("a/b/../../../..", alloc = heap)
    defer delete(so_acima)
    expect(so_acima == "..\\..")
}

test "join junta com separador nativo" {
    let dois = join2("a", "b", alloc = heap)
    defer delete(dois)
    expect(dois == "a\\b")
    let barras = join2("a/", "/b", alloc = heap)
    defer delete(barras)
    expect(barras == "a\\b")
    let so_direita = join2("", "b", alloc = heap)
    defer delete(so_direita)
    expect(so_direita == "b")
    let subiu = join2("a", "..", alloc = heap)
    defer delete(subiu)
    expect(subiu == ".")
    var uma: [1]str = {"a//b/../c"}
    let lista = join(uma[..], alloc = heap)
    defer delete(lista)
    expect(lista == "a\\c")
}

test "rel calcula caminho relativo" {
    let igual = rel("a", "a", alloc = heap)
    defer delete(igual)
    expect(igual == ".")
    let filho = rel("a", "a/b", alloc = heap)
    defer delete(filho)
    expect(filho == "b")
    let pai = rel("a/b", "a", alloc = heap)
    defer delete(pai)
    expect(pai == "..")
    let dois_niveis = rel("a/b/c", "a", alloc = heap)
    defer delete(dois_niveis)
    expect(dois_niveis == "..\\..")
    let irmao = rel("a/b", "a/c", alloc = heap)
    defer delete(irmao)
    expect(irmao == "..\\c")
    let de_ponto = rel(".", "a", alloc = heap)
    defer delete(de_ponto)
    expect(de_ponto == "a")
}

test "with_ext troca a extensao" {
    let md = with_ext("a.txt", ".md", alloc = heap)
    defer delete(md)
    expect(md == "a.md")
    let sem = with_ext("a.txt", "", alloc = heap)
    defer delete(sem)
    expect(sem == "a")
    let sem_ponto = with_ext("a", "md", alloc = heap)
    defer delete(sem_ponto)
    expect(sem_ponto == "a.md")
    let duplo = with_ext("a.tar.gz", ".zip", alloc = heap)
    defer delete(duplo)
    expect(duplo == "a.tar.zip")
    let pasta = with_ext("a/b.txt", "bin", alloc = heap)
    defer delete(pasta)
    expect(pasta == "a/b.bin")
}
