// std:sha - testes do modulo (lote A). Anexados ao texto de std:sha SO em forja test std:sha (o build normal nao os ve).
// Versao: 0.1.0. Changelog: 0.1.0 - converte o teste antigo (programa com main que imprimia, comparado a teste.esperado) para blocos test: cada linha esperada virou um expect, mesma cobertura.
// Sem import e sem proc main: o pedaco fica dentro do modulo, entao chama as procs dele SEM prefixo (sha256, hmac_sha256).

// Bytes de um texto, numa lista do alocador que o chamador passou (delete so se for heap).
proc bytes_de(s: str, alloc: Allocator) -> [dynamic]u8 {
    var out = make([dynamic]u8, alloc = alloc)
    for i in 0..<len(s) {
        append(&out, item = s[i])
    }
    return out
}

// n bytes iguais a valor, numa lista do alocador que o chamador passou.
proc repete(valor: u8, n: int, alloc: Allocator) -> [dynamic]u8 {
    var out = make([dynamic]u8, alloc = alloc, cap = n)
    for i in 0..<n {
        append(&out, item = valor)
    }
    return out
}

// true se os bytes de b, em hex minusculo (2 digitos por byte), sao exatamente o texto hex.
proc hex_bate(b: []u8, hex: str) -> bool {
    if len(hex) != len(b) * 2 {
        return false
    }
    let digitos = "0123456789abcdef"
    for i in 0..<len(b) {
        if hex[i * 2] != digitos[(b[i] >> 4) as int] {
            return false
        }
        if hex[i * 2 + 1] != digitos[(b[i] & 0x0F) as int] {
            return false
        }
    }
    return true
}

test "sha256 vetores publicados: abc, vazio e nist de 56 bytes" {
    var abc = bytes_de("abc", alloc = heap)
    defer delete(abc)
    var vazio = bytes_de("", alloc = heap)
    defer delete(vazio)
    var nist = bytes_de("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq", alloc = heap)
    defer delete(nist)
    var d1 = sha256(abc[..])
    expect(hex_bate(d1[..], "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"))
    var d2 = sha256(vazio[..])
    expect(hex_bate(d2[..], "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"))
    var d3 = sha256(nist[..])
    expect(hex_bate(d3[..], "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1"))
}

test "sha256 bordas de bloco: 55, 56 e 64 bytes de a" {
    var a55 = repete(97, 55, alloc = heap)
    defer delete(a55)
    var a56 = repete(97, 56, alloc = heap)
    defer delete(a56)
    var a64 = repete(97, 64, alloc = heap)
    defer delete(a64)
    var d1 = sha256(a55[..])
    expect(hex_bate(d1[..], "9f4390f8d30c2dd92ec9f095b65e2b9ae9b0a925a5258e241c9f1e910f734318"))
    var d2 = sha256(a56[..])
    expect(hex_bate(d2[..], "b35439a4ac6f0948b6d6f9e3c6af0f5f590ce20f1bde7090ef7970686ec6738a"))
    var d3 = sha256(a64[..])
    expect(hex_bate(d3[..], "ffe054fe7ae0cb6dc65c3af9b61d5209f439851db43d0ba5997337df154668eb"))
}

test "sha256 de um milhao de a" {
    var milhao = repete(97, 1000000, alloc = heap)
    defer delete(milhao)
    var d = sha256(milhao[..])
    expect(hex_bate(d[..], "cdc76e5c9914fb9281a1c7e284d73e67f1809a48a497200e046d39ccc7112cd0"))
}

test "hmac_sha256 RFC 4231 casos 1, 2, 3 e 6" {
    var chave1 = repete(0x0B, 20, alloc = heap)
    defer delete(chave1)
    var dados1 = bytes_de("Hi There", alloc = heap)
    defer delete(dados1)
    var m1 = hmac_sha256(chave1[..], dados1[..])
    expect(hex_bate(m1[..], "b0344c61d8db38535ca8afceaf0bf12b881dc200c9833da726e9376c2e32cff7"))

    var chave2 = bytes_de("Jefe", alloc = heap)
    defer delete(chave2)
    var dados2 = bytes_de("what do ya want for nothing?", alloc = heap)
    defer delete(dados2)
    var m2 = hmac_sha256(chave2[..], dados2[..])
    expect(hex_bate(m2[..], "5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843"))

    var chave3 = repete(0xAA, 20, alloc = heap)
    defer delete(chave3)
    var dados3 = repete(0xDD, 50, alloc = heap)
    defer delete(dados3)
    var m3 = hmac_sha256(chave3[..], dados3[..])
    expect(hex_bate(m3[..], "773ea91e36800e46854db8ebd09181a72959098b3ef8c122d9635514ced565fe"))

    var chave6 = repete(0xAA, 131, alloc = heap)
    defer delete(chave6)
    var dados6 = bytes_de("Test Using Larger Than Block-Size Key - Hash Key First", alloc = heap)
    defer delete(dados6)
    var m6 = hmac_sha256(chave6[..], dados6[..])
    expect(hex_bate(m6[..], "60e431591ee0b67f0d8a26aacbf5b77f8e0bc6213728c5140546040f0ee37f54"))
}
