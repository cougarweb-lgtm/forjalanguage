// std:hash - testes do modulo (lote A). Anexados ao texto de std:hash SO em forja test std:hash (o build normal nao os ve).
// Versao: 0.1.0. Changelog: 0.1.0 - converte o teste antigo (programa com main que imprimia, comparado a teste.esperado) para blocos test: cada linha esperada virou um expect, mesma cobertura.
// Sem import e sem proc main: o pedaco fica dentro do modulo, entao chama as procs dele SEM prefixo (fnv1a_64, xxh64, crc32).

// Bytes de um texto, numa lista do alocador que o chamador passou (delete so se for heap).
proc bytes_de(s: str, alloc: Allocator) -> [dynamic]u8 {
    var out = make([dynamic]u8, alloc = alloc)
    for i in 0..<len(s) {
        append(&out, item = s[i])
    }
    return out
}

test "fnv1a_64 vetores publicados" {
    var vazio = bytes_de("", alloc = heap)
    defer delete(vazio)
    var a = bytes_de("a", alloc = heap)
    defer delete(a)
    var foobar = bytes_de("foobar", alloc = heap)
    defer delete(foobar)
    expect(fnv1a_64(vazio[..]) == 0xCBF29CE484222325)
    expect(fnv1a_64(a[..]) == 0xAF63DC4C8601EC8C)
    expect(fnv1a_64(foobar[..]) == 0x85944171F73967E8)
}

test "xxh64 vetor publicado e seed" {
    var vazio = bytes_de("", alloc = heap)
    defer delete(vazio)
    var abc = bytes_de("abc", alloc = heap)
    defer delete(abc)
    expect(xxh64(vazio[..], 0) == 0xEF46DB3751D8E999)
    expect(xxh64(abc[..], 0) == 0x44BC2CF5AD770999)
    expect(xxh64(abc[..], 1) == 0xBEA9CA8199328908)
    expect(xxh64(vazio[..], 1) == 0xD5AFBA1336A3BE4B)
}

test "xxh64 texto longo com seed zero e seed fixa" {
    var nobody = bytes_de("Nobody inspects the spammish repetition", alloc = heap)
    defer delete(nobody)
    expect(xxh64(nobody[..], 0) == 0xFBCEA83C8A378BF1)
    expect(xxh64(nobody[..], 0x0123456789ABCDEF) == 0xE341C9D9AD9F3C0A)
}

test "crc32 123456789, vazio e texto da raposa" {
    var digitos = bytes_de("123456789", alloc = heap)
    defer delete(digitos)
    var vazio = bytes_de("", alloc = heap)
    defer delete(vazio)
    var raposa = bytes_de("The quick brown fox jumps over the lazy dog", alloc = heap)
    defer delete(raposa)
    expect(crc32(digitos[..]) == 0xCBF43926)
    expect(crc32(vazio[..]) == 0x00000000)
    expect(crc32(raposa[..]) == 0x414FA339)
}
