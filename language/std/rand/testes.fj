// std:rand - testes do modulo (S4 P4). Anexados ao texto de std:rand SO em forja test std:rand (o build normal nao os ve).
// Versao: 0.1.0. Changelog: 0.1.0 - S4 P4: contrato das fixtures 272..277 (xoshiro256** com semente, u32/float/bool, below Lemire, int_range, float_range, perm) com os valores do .esperado. Sem relogio (278) e sem panic (279..282).
// Sem import e sem proc main: o pedaco fica dentro do modulo, entao chama as procs dele SEM prefixo rand.

// true se a lista tem cada numero de 0..<len(itens) exatamente uma vez.
proc e_permutacao(itens: []int) -> bool {
    var visto = make([dynamic]bool, alloc = heap, cap = len(itens))
    defer delete(visto)
    for _i in 0..<len(itens) {
        append(&visto, item = false)
    }
    for item in itens {
        if item < 0 or item >= len(itens) or visto[item] {
            return false
        }
        visto[item] = true
    }
    return true
}

test "xoshiro com semente zero" {
    var rng = seed(0)
    expect(next_u64(&rng) == 11091344671253066420)
    expect(next_u64(&rng) == 13793997310169335082)
    expect(next_u64(&rng) == 1900383378846508768)
    for _i in 3..<99 {
        let _s = next_u64(&rng)
    }
    expect(next_u64(&rng) == 4375015050159202716)
}

test "Rng padrao e copia do estado" {
    var padrao = Rng{}
    var zero = seed(0)
    expect(next_u64(&padrao) == next_u64(&zero))
    expect(next_u64(&padrao) == next_u64(&zero))
    var original = seed(5)
    let _primeiro = next_u64(&original)
    var copia = original
    let da_copia = next_u64(&copia)
    let do_original = next_u64(&original)
    expect(da_copia == do_original)
    expect(next_u64(&copia) == 11982022302389484462)
}

test "u32 e float pelos bits" {
    var a = seed(0)
    expect(next_u32(&a) == 2582404918)
    expect(next_u32(&a) == 3211665272)
    for _i in 2..<99 {
        let _u = next_u32(&a)
    }
    expect(next_u32(&a) == 1018637570)
    var b = seed(0)
    expect(transmute(next_float(&b), to = u64) == 4603590915185536702)
}

test "bool conta 54 em 100" {
    var c = seed(0)
    var verdadeiros: int = 0
    for _i in 0..<100 {
        if next_bool(&c) {
            verdadeiros += 1
        }
    }
    expect(verdadeiros == 54)
}

test "below consome como o oraculo" {
    var mil = seed(2024)
    var soma_mil: u64 = 0
    for _i in 0..<100 {
        soma_mil = wrapping_add(soma_mil, b = below(&mil, n = 1000))
    }
    expect(soma_mil == 45951)
    expect(next_u64(&mil) == 16059786654946897807)
}

test "below com rejeicao em 2 elevado a 63" {
    var rng = seed(2024)
    var soma: u64 = 0
    for _i in 0..<100 {
        soma = wrapping_add(soma, b = below(&rng, n = 9223372036854775809))
    }
    expect(soma == 6226093106183073209)
    expect(next_u64(&rng) == 17037911856846607320)
}

test "int_range das pontas e inclusivo" {
    var rng = seed(99)
    expect(int_range(&rng, min = 1, max = 6) == 3)
    expect(int_range(&rng, min = 1, max = 6) == 4)
    expect(int_range(&rng, min = 1, max = 6) == 3)
    let menor = -9223372036854775807 - 1
    var pontas = seed(99)
    expect(int_range(&pontas, min = menor, max = menor + 1) == menor)
    expect(int_range(&pontas, min = menor, max = menor + 1) == menor + 1)
    var cheio = seed(99)
    expect(int_range(&cheio, min = 0, max = 9223372036854775807) == 3216225398495147354)
}

test "float_range pelos bits e consumo" {
    var rng = seed(31)
    let v = float_range(&rng, min = 0.0, max = 1.0)
    expect(transmute(v, to = u64) == 4604558953161548687)
    var consumo = seed(31)
    for _i in 0..<50 {
        let _f = float_range(&consumo, min = 0.0, max = 1.0)
    }
    expect(next_u64(&consumo) == 3343810582493461484)
}

test "perm valida e consumo" {
    var rng = seed(5)
    var nulo = perm(&rng, n = 0, alloc = heap)
    defer delete(nulo)
    expect(len(nulo) == 0)
    var um = perm(&rng, n = 1, alloc = heap)
    defer delete(um)
    expect(um[0] == 0)
    var dez = perm(&rng, n = 10, alloc = heap)
    defer delete(dez)
    expect(dez[1] == 1)
    expect(dez[2] == 7)
    expect(dez[9] == 9)
    var mil = perm(&rng, n = 1000, alloc = heap)
    defer delete(mil)
    expect(len(mil) == 1000)
    expect(e_permutacao(mil[..]))
    expect(next_u64(&rng) == 4372217400954802786)
}
