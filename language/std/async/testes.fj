// std:async - testes do modulo (M5 P51). Anexados ao texto de std:async SO em forja test std:async (o build normal nao os ve).
// Versao: 0.1.0. Changelog: 0.1.0 - M5 P51: pool_new com 0 workers da erro; grupo de 100 tarefas roda todas (soma 4950) e pool_close junta os workers.
// Sem import e sem proc main: o pedaco fica dentro do modulo, entao chama as procs dele SEM prefixo.

struct Marca {
    indice: int = 0
    saida: int = 0
}

// Tarefa de teste: grava o proprio indice na marca recebida por arg.
proc grava_indice(q: rawptr) -> u32 {
    let m = q as ^Marca
    m.saida = m.indice
    return 0
}

test "pool_new com zero workers da erro" {
    switch p in pool_new(0) {
    case ^Pool:
        expect(false)
    case AsyncError:
        expect(true)
    }
}

test "grupo de 100 tarefas roda todas e pool_close junta os workers" {
    switch p in pool_new(3) {
    case ^Pool:
        var marcas = make([dynamic]Marca, alloc = heap, cap = 100)
        for i in 0..<100 {
            append(&marcas, item = Marca{indice = i})
        }
        let g = group_new(p)
        for k in 0..<100 {
            group_spawn(g, grava_indice, &marcas[k] as rawptr)
        }
        group_wait(g)
        var soma = 0
        for m in marcas {
            soma += m.saida
        }
        pool_close(p)
        delete(p)
        delete(marcas)
        expect(soma == 4950)
    case AsyncError:
        expect(false)
    }
}
