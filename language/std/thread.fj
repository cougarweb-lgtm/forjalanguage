// std:thread - criar e esperar threads (M5 P47). API em ingles (ADR-39); o corpo chama o runtime direto (forja_thread_*, rt_thread_win.c / forja_rt_thread.h).
// Changelog: 0.1.0 - M5 P47: spawn, join e ThreadError { sem_recursos, falha_espera }. Desvio da D-R9 (aceito pelo main): sem ^T generico na linguagem; o arg e rawptr (passe &x as rawptr) e o proc e proc(q: rawptr) -> u32 (passe o NOME do proc: vira o trampolim fjt_, que cria o fio da thread).
// Posse: Thread e opaca (o handle fica em h, nao se mexe fora deste modulo). join fecha o handle: chame uma vez por thread. Copia de Thread e regra do P48 (S18), por ora so documentada.
// Corte (D-R9): detach, nome, afinidade e id ficam para depois.

foreign {
    proc forja_thread_criar(rotina: proc(q: rawptr) -> u32, arg: rawptr) -> u64
    proc forja_thread_esperar(h: u64) -> i32
    proc forja_thread_fechar(h: u64)
}

// Erro do std:thread: sem_recursos = o sistema nao criou a thread; falha_espera = a espera pelo fim falhou.
pub enum ThreadError { sem_recursos, falha_espera }

// Handle opaco de uma thread criada por spawn.
pub struct Thread {
    h: u64 = 0
}

// Cria a thread que roda p(arg) e devolve o Thread. p vai na fronteira C (trampolim), e arg e so o ponteiro que a filha recebe.
pub proc spawn(p: proc(q: rawptr) -> u32, arg: rawptr) -> Thread ! ThreadError {
    let h = forja_thread_criar(p, arg)
    if h == 0 {
        return ThreadError.sem_recursos
    }
    return Thread{h = h}
}

// Espera a thread terminar e fecha o handle. none = ok; falha_espera = a espera falhou (o handle ja foi fechado).
pub proc join(t: Thread) -> ?ThreadError {
    let falhou = forja_thread_esperar(t.h)
    forja_thread_fechar(t.h)
    if falhou != 0 {
        return ThreadError.falha_espera
    }
    return none
}
