// std:uuid - testes do modulo (lote A). Anexados ao texto de std:uuid SO em forja test std:uuid (o build normal nao os ve).
// Versao: 0.1.0. Changelog: 0.1.0 - converte o teste antigo (programa com main que imprimia, comparado a teste.esperado) para blocos test: cada linha esperada virou um expect, mesma cobertura.
// Sem import e sem proc main: o pedaco fica dentro do modulo, entao chama as procs dele SEM prefixo (v4, v7, format_uuid, parse_uuid, versao, variante_rfc).

test "v4 com bytes fixos: texto, versao, variante e ida e volta" {
    var aleatorio16: [16]u8 = {0x00, 0x11, 0x22, 0x33, 0x44, 0x55, 0x66, 0x77, 0x88, 0x99, 0xAA, 0xBB, 0xCC, 0xDD, 0xEE, 0xFF}
    switch r in v4(aleatorio16[..]) {
    case [16]u8:
        let t = format_uuid(r, alloc = heap)
        expect(t == "00112233-4455-4677-8899-aabbccddeeff")
        delete(t)
        expect(versao(r) == 4)
        expect(variante_rfc(r))
        let ida = format_uuid(r, alloc = heap)
        switch p in parse_uuid(ida) {
        case [16]u8:
            let volta = format_uuid(p, alloc = heap)
            expect(volta == "00112233-4455-4677-8899-aabbccddeeff")
            delete(volta)
        case UuidError:
            expect(false)
        }
        delete(ida)
    case UuidError:
        expect(false)
    }
}

test "v4 com 15 bytes e recusado" {
    var curto: [15]u8 = {0x00, 0x11, 0x22, 0x33, 0x44, 0x55, 0x66, 0x77, 0x88, 0x99, 0xAA, 0xBB, 0xCC, 0xDD, 0xEE}
    switch r in v4(curto[..]) {
    case [16]u8:
        expect(false)
    case UuidError:
        expect(r == UuidError.tamanho_invalido)
    }
}

test "v7 com 10 bytes: texto, versao e variante" {
    var aleatorio10: [10]u8 = {0xFF, 0xAB, 0x3F, 0x11, 0x22, 0x33, 0x44, 0x55, 0x66, 0x77}
    switch r in v7(aleatorio10[..], 0x0123456789AB) {
    case [16]u8:
        let t = format_uuid(r, alloc = heap)
        expect(t == "01234567-89ab-7fab-bf11-223344556677")
        delete(t)
        expect(versao(r) == 7)
        expect(variante_rfc(r))
    case UuidError:
        expect(false)
    }
}

test "v7 carimbo de 49 bits e bytes demais sao recusados" {
    var aleatorio10: [10]u8 = {0xFF, 0xAB, 0x3F, 0x11, 0x22, 0x33, 0x44, 0x55, 0x66, 0x77}
    switch r in v7(aleatorio10[..], 0x1000000000000) {
    case [16]u8:
        expect(false)
    case UuidError:
        expect(r == UuidError.tempo_invalido)
    }
    var aleatorio16b: [16]u8 = {0x00, 0x11, 0x22, 0x33, 0x44, 0x55, 0x66, 0x77, 0x88, 0x99, 0xAA, 0xBB, 0xCC, 0xDD, 0xEE, 0xFF}
    switch r in v7(aleatorio16b[..], 0x0123456789AB) {
    case [16]u8:
        expect(false)
    case UuidError:
        expect(r == UuidError.tamanho_invalido)
    }
}

test "parse_uuid aceita maiusculas e recusa entradas ruins" {
    switch r in parse_uuid("01234567-89AB-7FAB-BF11-223344556677") {
    case [16]u8:
        let t = format_uuid(r, alloc = heap)
        expect(t == "01234567-89ab-7fab-bf11-223344556677")
        delete(t)
    case UuidError:
        expect(false)
    }
    switch r in parse_uuid("") {
    case [16]u8:
        expect(false)
    case UuidError:
        expect(r == UuidError.tamanho_invalido)
    }
    switch r in parse_uuid("00112233x4455-4677-8899-aabbccddeeff") {
    case [16]u8:
        expect(false)
    case UuidError:
        expect(r == UuidError.formato_invalido)
    }
    switch r in parse_uuid("0011223Z-4455-4677-8899-aabbccddeeff") {
    case [16]u8:
        expect(false)
    case UuidError:
        expect(r == UuidError.formato_invalido)
    }
}
