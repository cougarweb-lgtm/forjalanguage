// std:mem - testes do modulo (S4 P4). Anexados ao texto de std:mem SO em forja test std:mem (o build normal nao os ve).
// Versao: 0.1.0. Changelog: 0.1.0 - S4 P4: contrato das fixtures 160 (arena e pool), 161 (lista e texto na arena) e 320 (alocador como parametro). 321, 322 e 350 testam std:text/path/fmt e ficam para os pedacos desses modulos.
// Sem import e sem proc main: o pedaco fica dentro do modulo, entao chama as procs dele SEM prefixo mem.

struct Grifo {
    vida: i32 = 100
    x: int = 0
}

test "arena soma e reset" {
    let a = arena_create(64)
    var total = 0
    for i in 0..<10 {
        let g = new(Grifo, alloc = a)
        g.x = i
        total += g.x + g.vida as int
    }
    expect(total == 1045)
    expect(arena_used(a) > 0)
    arena_reset(a)
    expect(arena_used(a) == 0)
    arena_destroy(a)
}

test "pool conta vivos" {
    let p = pool_create()
    let q = new(Grifo, alloc = p)
    let r = new(Grifo, alloc = p)
    expect(pool_live(p) == 2)
    delete(q, alloc = p)
    expect(pool_live(p) == 1)
    expect(r.vida == 100)
    delete(r, alloc = p)
    pool_destroy(p)
}

test "lista e texto na arena" {
    let a = arena_create(64)
    var l = make([dynamic]int, alloc = a)
    for i in 0..<20 {
        append(&l, item = i * 2)
    }
    expect(len(l) == 20)
    expect(l[19] == 38)
    let s = format(f"soma={l[1] + l[2]}", alloc = a)
    expect(s == "soma=6")
    delete(l)
    expect(len(l) == 0)
    arena_destroy(a)
}

test "texto no alocador pedido" {
    let a = arena_create(512)
    let h = format(f"item-{1}", alloc = heap)
    expect(h == "item-1")
    delete(h)
    let f = format(f"item-{2}", alloc = frame)
    expect(f == "item-2")
    let t = format(f"item-{3}", alloc = a)
    expect(t == "item-3")
    frame_reset()
    arena_destroy(a)
}
