// Exemplo de std:rede (libcurl 8.23.0, TLS do Windows/Schannel, ligacao ESTATICA): baixa por HTTPS e trata os erros mais comuns.
// Precisa de internet para os casos 1 e 2; os casos 3 e 4 falham de proposito e nao dependem de servidor.
// RODAR:  forja run language\exemplos_libs\rede_https.fj
// EXE:    forja build language\exemplos_libs\rede_https.fj -o rede_https.exe     (importa so DLLs do Windows)
// SAIDA ESPERADA: rede_https.esperado (com internet). Fora do verificar_libs.py porque depende da internet.

import "vendor:net/net"

proc nome_do_erro(e: net.NetError) -> str {
    if e == net.NetError.invalid_url {
        return "url_invalida"
    }
    if e == net.NetError.cannot_resolve {
        return "sem_resolver"
    }
    if e == net.NetError.http_error {
        return "http_erro"
    }
    return "outro"
}

proc tentar(rotulo: str, url: cstr, tempo_s: i32) {
    switch r in net.download_file(url, dst = "rede_https_teste.tmp", timeout_s = tempo_s) {
    case i32:
        print(f"{rotulo}: HTTP {r}")
    case net.NetError:
        print(f"{rotulo}: erro {nome_do_erro(r)}")
    }
}

proc main() {
    defer net.shutdown()
    let destino: cstr = "rede_https_teste.tmp"
    print(f"libcurl: {net.versao() as str}")
    tentar("1 https robots.txt", url = "https://www.sqlite.org/robots.txt", tempo_s = 30)
    print(f"1 tamanho > 0: {net.file_size(destino) > 0}")
    _ = net.remove_file(destino)
    tentar("2 https 404", url = "https://www.sqlite.org/nao_existe_forja_xyz", tempo_s = 30)
    print(f"2 arquivo apagado: {net.file_size(destino) < 0}")
    tentar("3 host inexistente", url = "https://host-que-nao-existe.invalid/x", tempo_s = 10)
    tentar("4 url invalida", url = "ftpx://x", tempo_s = 10)
}
