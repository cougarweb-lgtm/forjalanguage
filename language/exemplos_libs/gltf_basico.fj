// Exemplo basico da ponte cgltf 1.15 (vendor:gltf/cgltf): abre um .glb real, valida e imprime contagens.
// COMPILAR/RODAR (a partir de language\exemplos_libs; a pasta vendor\ aqui e uma juncao para language\vendor):
//     forja run gltf_basico.fj
//     forja build --release gltf_basico.fj -o gltf_basico.exe     (exe so com DLLs do Windows)
// O .glb e o menor ja existente em C:\ENGINE_GAME3D\GLB (so leitura), por caminho relativo a esta pasta.
// SAIDA ESPERADA: ver gltf_basico.esperado (contagens conferidas com um script Python que le o JSON do .glb).

import "vendor:gltf/cgltf" as gl

proc contar(d: ^gl.CgltfData) {
    print(f"malhas={d.meshes_count} materiais={d.materials_count} animacoes={d.animations_count} nos={d.nodes_count}")
    print(f"cenas={d.scenes_count} skins={d.skins_count} acessores={d.accessors_count} buffers={d.buffers_count}")
    print(f"imagens={d.images_count} texturas={d.textures_count} amostradores={d.samplers_count}")
}

proc main() {
    let caminho: cstr = "../../GLB/animados_ok/otimizados/peixe_04_engine_game_3d.glb"
    var opcoes = gl.CgltfOptions{
        type = gl.CgltfFileType.invalid,
        json_token_count = 0,
        memory = gl.CgltfMemoryOptions{alloc_func = none, free_func = none, user_data = none},
        file = gl.CgltfFileOptions{read = none, release = none, user_data = none}
    }
    var dados: ?^gl.CgltfData = none
    let r = gl.cgltf_parse_file(&opcoes, path = caminho, out_data = &dados)
    print(f"parse_ok={r == gl.CgltfResult.success}")
    switch d in dados {
    case ^gl.CgltfData:
        let v = gl.cgltf_validate(d)
        print(f"validate_ok={v == gl.CgltfResult.success}")
        let b = gl.cgltf_load_buffers(&opcoes, data = d, gltf_path = caminho)
        print(f"buffers_ok={b == gl.CgltfResult.success}")
        contar(d)
        gl.cgltf_free(d)
    case none:
        print("sem dados")
    }
}
