// Exemplo da ponte MariaDB Connector/C 3.4.11 (LGPL-2.1, libmariadb.dll ao lado do .exe): prova que a lib carrega e fala com o servidor.
// NAO conecta com usuario de verdade: usa um usuario que nao existe, entao o servidor responde "acesso negado" (1045) e
// nada e lido nem gravado. Sem servidor nenhum o erro e 2002/2003 (conexao recusada), tambem tratado.
// RODAR:  forja run language\exemplos_libs\mariadb_conexao.fj
// EXE:    forja build language\exemplos_libs\mariadb_conexao.fj -o mariadb_conexao.exe   (copie vendor\libmariadb.dll ao lado do .exe)
// SAIDA ESPERADA: depende do servidor da maquina; ver o comentario no fim do arquivo.

import "vendor:db_server/mariadb" as my

proc tentar(host: cstr, porta: u32, usuario: cstr) -> u32 {
    let bd = my.mysql_init(none)
    var espera: u32 = 3
    _ = my.mysql_options(bd, option = my.MYSQL_OPT_CONNECT_TIMEOUT, arg = &espera as rawptr)
    let ligado = my.mysql_real_connect(bd, host = host, user = usuario, passwd = "senha_que_nao_existe", db = "", port = porta, unix_socket = "", clientflag = 0)
    let codigo = my.mysql_errno(bd)
    let estado = my.mysql_sqlstate(bd) or_else "?"
    print(f"  conectou={ligado != none} errno={codigo} sqlstate={estado as str}")
    my.mysql_close(bd)
    return codigo
}

proc main() {
    let versao = my.mysql_get_client_info() or_else "?"
    print(f"cliente MariaDB {versao as str} (id {my.mysql_get_client_version() as uint})")
    print("porta 1 de 127.0.0.1 (ninguem escuta):")
    let sem_servidor = tentar("127.0.0.1", porta = 1, usuario = "forja_teste_inexistente")
    print(f"  esperado 2002 (conexao recusada): {sem_servidor == 2002}")
    print("porta 3306 de 127.0.0.1 (servidor MySQL/MariaDB local, se houver):")
    let local = tentar("127.0.0.1", porta = 3306, usuario = "forja_teste_inexistente")
    if local == 1045 {
        print("  servidor respondeu: acesso negado (esperado para usuario inexistente)")
    } else {
        print("  sem servidor ou resposta diferente de 1045")
    }
}

