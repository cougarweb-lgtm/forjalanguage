// Marco rede R5: HTTPS contra tests\rede\servidor_http.py --tls (127.0.0.1, porta efemera, sem internet). Certificados de teste em tests\rede\certs\.
// Argumentos (o verificar_libs.py passa): 1 = base https do servidor com servidor.pem; 2 = base https do servidor com outro.pem (SAN errado); 3 = caminho do ca.pem.
// Prova: com ca_file = 200; sem ca_file = NetError.tls (a CA de teste nao esta no Windows); SAN errado com a CA certa = NetError.tls.
// COMPILAR/RODAR: python language\exemplos_libs\verificar_libs.py --so https_local --backend x64   (SAIDA ESPERADA: https_local.esperado)

import "std:mem"
import "std:os"
import "vendor:net/net"

// GET /status/200 na base dada, com o ca_file dado (vazio = so o repositorio do Windows); imprime o status ou se foi NetError.tls.
proc pedir(rotulo: str, base: str, ca: str) {
    let a = mem.arena_create()
    defer mem.arena_destroy(a)
    var nenhum: [1]net.Header = {}
    var sem_corpo: [1]u8 = {}
    var req = net.Request{method = net.Method.get, url = format(f"{base}/status/200", alloc = a), headers = nenhum[0..<0], body = sem_corpo[0..<0], ca_file = ca}
    switch r in net.http_request(&req, alloc = a) {
    case net.Response:
        print(f"{rotulo} status {r.status} corpo={r.body}")
    case net.NetError:
        print(f"{rotulo} erro tls={r == net.NetError.tls}")
    }
}

proc main() {
    defer net.shutdown()
    let args = os.args()
    if len(args) < 4 {
        print("uso: https_local <base https> <base https SAN errado> <ca.pem>")
        os.exit(2)
    }
    let ca = args[3]
    pedir("com_ca", base = args[1], ca = ca)
    pedir("sem_ca", base = args[1], ca = "")
    pedir("san_errado", base = args[2], ca = ca)
}
