// Exemplo basico da raylib 6.2 (vendor:raylib/raylib, ESTATICA): so funcoes de CPU, SEM janela (nao ha GL na prova).
// COMPILAR/RODAR (a pasta vendor\ aqui e uma juncao para language\vendor; rode de dentro de exemplos_libs):
//     forja run raylib_basico.fj
//     forja build raylib_basico.fj -o raylib_basico.exe     (exe importa tambem as DLLs de sistema do Windows: opengl32, gdi32, winmm, user32, shell32)
// SAIDA ESPERADA: ver raylib_basico.esperado

import "vendor:raylib/raylib"

proc main() {
    print(f"raylib {raylib.RAYLIB_VERSION_MAJOR}.{raylib.RAYLIB_VERSION_MINOR}.{raylib.RAYLIB_VERSION_PATCH}")

    // sorteio com semente fixa (rprand, algoritmo da propria lib)
    raylib.SetRandomSeed(42)
    for i in 0..<5 {
        let n = raylib.GetRandomValue(0, max = 100)
        print(f"sorteio[{i}]={n}")
    }

    // cores
    let laranja = raylib.Color{r = 255, g = 161, b = 0, a = 255}
    let meio = raylib.Fade(laranja, alpha = 0.5)
    print(f"fade r={meio.r} g={meio.g} b={meio.b} a={meio.a}")
    print(f"cor_int={raylib.ColorToInt(laranja)}")
    let c = raylib.GetColor(0x336699FF)
    print(f"getcolor r={c.r} g={c.g} b={c.b} a={c.a}")
    let h = raylib.ColorFromHSV(120.0, saturation = 1.0, value = 1.0)
    print(f"hsv r={h.r} g={h.g} b={h.b} a={h.a}")

    // texto e caminhos
    let t: cstr = "forja e raylib"
    print(f"tamanho={raylib.TextLength(t)}")
    let texto_num: cstr = "1234"
    print(f"inteiro={raylib.TextToInteger(texto_num) + 1}")
    let ext: cstr = raylib.GetFileExtension("a/b/modelo.glb") or_else "?"
    let ext_ok: cstr = ".glb"
    print(f"extensao_ok={raylib.TextIsEqual(ext, text2 = ext_ok)}")
    let nome: cstr = raylib.GetFileNameWithoutExt("a/b/modelo.glb") or_else "?"
    let nome_ok: cstr = "modelo"
    print(f"nome_ok={raylib.TextIsEqual(nome, text2 = nome_ok)}")
    let caminho: cstr = "x/modelo.glb"
    print(f"e_glb={raylib.IsFileExtension(caminho, ext = ext_ok)}")

    // arquivos (lib fala com o sistema pelo CRT dela; nenhum FILE* atravessa)
    let pasta: cstr = "."
    let inexistente: cstr = "nao_existe_mesmo.xyz"
    print(f"pasta_atual_existe={raylib.DirectoryExists(pasta)}")
    print(f"arquivo_inexistente={raylib.FileExists(inexistente)}")
    print(f"tamanho_inexistente={raylib.GetFileLength(inexistente)}")

    // geometria
    let a = raylib.Rectangle{x = 0.0, y = 0.0, width = 4.0, height = 4.0}
    let b = raylib.Rectangle{x = 2.0, y = 2.0, width = 4.0, height = 4.0}
    let inter = raylib.GetCollisionRec(a, rec2 = b)
    print(f"colide={raylib.CheckCollisionRecs(a, rec2 = b)} inter_w={inter.width as int} inter_h={inter.height as int}")
}
