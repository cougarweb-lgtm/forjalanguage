// Exemplo de hot reload (M8 H3): o host roda o jogo.dll e troca a DLL quando ela muda no disco. Versao: 1.0.0. Changelog: 1.0.0 - H3: primeira versao.
// Uso: host <jogo.dll> <quadros>. Com o host rodando, recompile o jogo no mesmo caminho e veja o contador seguir sem fechar o host.
import "std:reload"
import "std:os"
import "std:text"

struct Estado {
    passos: i64
    soma: f64
    ultimo: f64
}

// Chama update da geracao atual. Rebusca o simbolo a cada quadro: barato num exemplo; o host de tests\reload guarda por geracao.
proc chama(lib: ^reload.Library, e: ^Estado) {
    switch r in reload.symbol(lib, "update") {
    case rawptr:
        let up = r as proc(e: ^Estado, dt: f64)
        up(e, 1.0)
    case reload.ReloadError:
        print("update ausente")
    }
}

proc main() {
    let a = os.args()
    var lib = reload.open(a[1], alloc = heap) or_else reload.Library{}
    let total = text.parse_int(a[2]) or_else 0
    var e = Estado{passos = 0, soma = 0.0, ultimo = 0.0}
    var q = 0
    while q < total {
        q += 1
        if reload.changed(&lib) {
            switch r in reload.reload(&lib) {
            case none:
                print(f"troca: gen={reload.generation(&lib)}")
            case reload.ReloadError:
                print("troca recusada: segue a versao anterior")
            }
        }
        chama(&lib, &e)
        print(f"q={q} gen={reload.generation(&lib)} passos={e.passos}")
        os.sleep_ms(100)
    }
    reload.close(&lib)
}
