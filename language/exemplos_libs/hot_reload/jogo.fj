// Jogo do exemplo de hot reload (M8 H3): o contador do host sobe 1 por quadro. Versao: 1.0.0. Changelog: 1.0.0 - H3: primeira versao.
// Para trocar o comportamento sem fechar o host, mude o +1 para +10 e recompile no mesmo caminho; nao mude os campos do Estado (a troca seria recusada).
struct Estado {
    passos: i64
    soma: f64
    ultimo: f64
}

pub export proc update(e: ^Estado, dt: f64) {
    e.passos += 1
    e.soma += dt
    e.ultimo = dt
}

proc main() {
}
