// Marco rede R8: leitura POP3 de vendor:net/mail contra tests\rede\servidor_mail.py --pop3 (127.0.0.1, porta efemera, sem internet; caixa fixa em tests\rede\caixa.json).
// Argumentos (o verificar_libs.py passa): 1 = pop3:// (texto claro); 2 = pop3s:// (TLS implicito); 3 = caminho do ca.pem. Usuario "usuario", senha "segredo".
// Prova: list = 3 mensagens com tamanho; fetch 2 confere Subject (dobrado) e a linha que comeca com ponto (o curl desfaz o dot-stuffing); delete 1 marca (list = 2 na mesma sessao) e so o QUIT
// do mail_close apaga de fato (outra sessao ve 2); numero inexistente = erro; senha errada = auth; starttls exigido num servidor sem ele = tls; pop3s com ca_file e sem ele = tls.
// COMPILAR/RODAR: python language\exemplos_libs\verificar_libs.py --so pop3_local --backend x64   (SAIDA ESPERADA: pop3_local.esperado)

import "std:mem"
import "std:os"
import "std:text"
import "vendor:net/mail" as mail

// Nome do erro para a saida.
proc rotular(e: mail.MailError) -> str {
    switch e {
    case mail.MailError.invalid_address:
        return "invalid_address"
    case mail.MailError.cannot_resolve:
        return "cannot_resolve"
    case mail.MailError.cannot_connect:
        return "cannot_connect"
    case mail.MailError.timeout:
        return "timeout"
    case mail.MailError.tls:
        return "tls"
    case mail.MailError.auth:
        return "auth"
    case mail.MailError.rejected:
        return "rejected"
    case mail.MailError.protocol:
        return "protocol"
    case mail.MailError.not_found:
        return "not_found"
    case mail.MailError.out_of_memory:
        return "out_of_memory"
    case mail.MailError.other:
        return "other"
    }
    return "?"
}

// Imprime as mensagens da caixa (numero e tamanho).
proc listar(s: ^mail.MailSession, rotulo: str) {
    let a = mem.arena_create()
    defer mem.arena_destroy(a)
    switch r in mail.pop3_list(s, alloc = a) {
    case [dynamic]mail.Pop3Item:
        print(f"{rotulo} total={len(r)}")
        for item in r {
            print(f"{rotulo} item {item.number} tamanho={item.size}")
        }
    case mail.MailError:
        print(f"{rotulo} erro {rotular(r)}")
    }
}

// Imprime o valor do cabecalho (ou "ausente").
proc mostrar_cabecalho(rotulo: str, bruto: str, nome: str, alloc: Allocator) {
    switch v in mail.message_header(bruto, name = nome, alloc = alloc) {
    case str:
        print(f"{rotulo} {nome}=[{v}]")
    case none:
        print(f"{rotulo} {nome} ausente")
    }
}

// Busca a mensagem n e imprime o tamanho, o Subject e se a linha que comeca com ponto chegou inteira.
proc ler_mensagem(s: ^mail.MailSession, rotulo: str, n: int) {
    let a = mem.arena_create()
    defer mem.arena_destroy(a)
    switch r in mail.pop3_fetch(s, n = n, alloc = a) {
    case str:
        print(f"{rotulo} tamanho={len(r)}")
        mostrar_cabecalho(rotulo, r, "Subject", a)
        let com_ponto = text.str_contains(r, "\r\n.linha que comeca com ponto\r\n")
        print(f"{rotulo} linha com ponto={com_ponto}")
    case mail.MailError:
        print(f"{rotulo} erro {rotular(r)}")
    }
}

// Marca a mensagem n para apagar e imprime "<rotulo> ok" ou "<rotulo> erro <nome>".
proc apagar(s: ^mail.MailSession, rotulo: str, n: int) {
    switch e in mail.pop3_delete(s, n = n) {
    case mail.MailError:
        print(f"{rotulo} erro {rotular(e)}")
    default:
        print(f"{rotulo} ok")
    }
}

// Sessao 1 (texto claro, starttls = false): lista, le, numero inexistente e marca a mensagem 1; o QUIT do mail_close apaga.
proc percorrer_caixa(s: ^mail.MailSession) {
    listar(s, "lista")
    ler_mensagem(s, "msg2", n = 2)
    ler_mensagem(s, "msg99", n = 99)
    apagar(s, "apagar1", n = 1)
    listar(s, "lista_marcada")
}

proc caso_plain(base: str) {
    var cfg = mail.MailConfig{url = base, user = "usuario", password = "segredo", starttls = false}
    switch aberta in mail.pop3_open(&cfg) {
    case mail.MailSession:
        var s = aberta
        percorrer_caixa(&s)
        mail.mail_close(&s)
    case mail.MailError:
        print(f"plain abrir erro {rotular(aberta)}")
        return
    }
    // Segunda sessao: depois do QUIT o servidor apagou a mensagem 1, entao a lista tem 2.
    switch outra in mail.pop3_open(&cfg) {
    case mail.MailSession:
        var s2 = outra
        listar(&s2, "reaberta")
        mail.mail_close(&s2)
        mail.mail_close(&s2)
    case mail.MailError:
        print(f"reaberta abrir erro {rotular(outra)}")
    }
}

// Erros de abertura no servidor de texto claro: senha errada = auth; starttls exigido (padrao) sem o servidor oferecer = tls; url de outro protocolo = other.
proc caso_erros_de_abertura(base: str) {
    var errada = mail.MailConfig{url = base, user = "usuario", password = "errada", starttls = false}
    switch s in mail.pop3_open(&errada) {
    case mail.MailSession:
        print("senha_errada abriu")
    case mail.MailError:
        print(f"senha_errada erro {rotular(s)}")
    }
    var exige = mail.MailConfig{url = base, user = "usuario", password = "segredo"}
    switch s in mail.pop3_open(&exige) {
    case mail.MailSession:
        print("starttls_exigido abriu")
    case mail.MailError:
        print(f"starttls_exigido erro {rotular(s)}")
    }
    var outro = mail.MailConfig{url = "imap://127.0.0.1:1", user = "usuario", password = "segredo"}
    switch s in mail.pop3_open(&outro) {
    case mail.MailSession:
        print("protocolo_trocado abriu")
    case mail.MailError:
        print(f"protocolo_trocado erro {rotular(s)}")
    }
}

// Servidor pop3s: com a CA de teste lista a caixa; sem ela o certificado nao e confiavel = tls.
proc caso_pop3s(base: str, ca: str) {
    var cfg = mail.MailConfig{url = base, user = "usuario", password = "segredo", ca_file = ca}
    switch aberta in mail.pop3_open(&cfg) {
    case mail.MailSession:
        var s = aberta
        listar(&s, "pop3s")
        ler_mensagem(&s, "pop3s1", n = 1)
        mail.mail_close(&s)
    case mail.MailError:
        print(f"pop3s abrir erro {rotular(aberta)}")
    }
    var sem_ca = mail.MailConfig{url = base, user = "usuario", password = "segredo"}
    switch aberta in mail.pop3_open(&sem_ca) {
    case mail.MailSession:
        print("sem_ca abriu")
        var s = aberta
        mail.mail_close(&s)
    case mail.MailError:
        print(f"sem_ca erro {rotular(aberta)}")
    }
}

proc main() {
    defer mail.shutdown()
    let args = os.args()
    if len(args) < 4 {
        print("uso: pop3_local <pop3://> <pop3s://> <ca.pem>")
        os.exit(2)
    }
    caso_plain(args[1])
    caso_erros_de_abertura(args[1])
    caso_pop3s(args[2], ca = args[3])
}
