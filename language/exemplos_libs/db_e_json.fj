// IA1-L8: vendor:db e vendor:json no mesmo programa. Os dois modulos tem um proc `close`; o nome de topo vale so dentro do modulo (db.close x json.close), entao o par compila e roda.
// COMPILAR/RODAR: forja run language\exemplos_libs\db_e_json.fj   (SAIDA ESPERADA: db_e_json.esperado)

import "vendor:db/db"
import "vendor:json/json"

proc ler_vida(texto: str) -> i64 ! json.JsonError {
    let doc = try json.parse_str(texto)
    defer json.close(doc)
    return try json.field_int(doc, name = "vida")
}

proc gravar(bd: db.Db, vida: i64) -> ! db.DbError {
    try db.exec(bd, sql = "CREATE TABLE criatura(vida INTEGER)")
    let q = try db.prepare(bd, sql = "INSERT INTO criatura(vida) VALUES (?)")
    defer db.finalize(q)
    try db.bind_int(q, index = 1, value = vida)
    _ = try db.next(q)
}

proc main() {
    switch vida in ler_vida("{\"vida\": 120}") {
    case i64:
        switch aberto in db.open(":memory:") {
        case db.Db:
            switch r in gravar(aberto, vida = vida) {
            case db.DbError:
                print("erro no banco")
            default:
                print(f"gravada vida {vida}")
            }
            db.close(aberto)
        case db.DbError:
            print("nao abriu")
        }
    case json.JsonError:
        print("json invalido")
    }
}
