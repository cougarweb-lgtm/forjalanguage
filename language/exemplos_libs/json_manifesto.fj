// Caso real: le o manifesto de clipes de animacao (manifesto_clipes.json) e lista o que carregar.
// RODAR (a partir desta pasta, o manifesto e aberto por caminho relativo):
//     cd language\exemplos_libs
//     forja run json_manifesto.fj
// EXE sem DLL externa:
//     forja build json_manifesto.fj -o json_manifesto.exe   e   .\json_manifesto.exe
// SAIDA ESPERADA: json_manifesto.esperado

import "vendor:json/json"

enum ErroManifesto {
    json_ruim
    clipe_sem_campo
}

proc listar_clipes(doc: json.Json) -> ! ErroManifesto {
    let clipes = json.field(doc, name = "clipes") or_else doc
    let total = json.size(clipes)
    for i in 0..<total {
        let c = json.item(clipes, index = i) or_else doc
        let nome = json.field_text(c, name = "nome") or_else ""
        let arquivo = json.field_text(c, name = "arquivo") or_else ""
        if len(nome) == 0 or len(arquivo) == 0 {
            return ErroManifesto.clipe_sem_campo
        }
        let laco = json.field_bool(c, name = "laco") or_else false
        let velocidade = json.field_number(c, name = "velocidade") or_else 1.0
        print(f"clipe {i}: {nome} <- {arquivo} laco={laco} velocidade={velocidade}")
    }
}

proc main() {
    switch aberto in json.parse_file("manifesto_clipes.json") {
    case json.Json:
        let modelo = json.field_text(aberto, name = "modelo") or_else "?"
        let escala = json.field_number(aberto, name = "escala") or_else 1.0
        print(f"modelo {modelo} escala {escala}")
        switch r in listar_clipes(aberto) {
        case ErroManifesto:
            print("manifesto com clipe sem nome/arquivo")
        default:
            print("manifesto ok")
        }
        json.close(aberto)
    case json.JsonError:
        print("nao consegui abrir/ler o manifesto")
    }
    switch falha in json.parse_file("nao_existe.json") {
    case json.Json:
        print("inesperado")
    case json.JsonError:
        print("erro tratado sem derrubar: arquivo inexistente")
    }
}
