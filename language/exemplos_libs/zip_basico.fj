// Exemplo de vendor:compression/zip e zip_ler (0.45.0): grava um .zip com 2 entradas (deflate), le de volta e confere o conteudo.
// COMPILAR/RODAR:
//     forja run language\exemplos_libs\zip_basico.fj
// SAIDA ESPERADA: zip_basico.esperado
// O arquivo temporario zip_basico.tmp.zip nasce e morre na pasta onde o exemplo roda.

import "vendor:compression/zip"
import "vendor:compression/zip_ler"
import "std:file"

const CAMINHO: str = "zip_basico.tmp.zip"

proc gravar() -> ! zip.ZipError {
    var w = try zip.abrir(CAMINHO)
    try zip.adicionar(&w, "ola.txt", as_bytes("ola, zip da Forja"))
    try zip.adicionar(&w, "pasta/dados.bin", as_bytes("AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"))
    try zip.fechar(&w)
}

proc conferir() -> ! zip_ler.LerError {
    var z = try zip_ler.abrir_zip(CAMINHO)
    defer zip_ler.fechar_zip(&z)
    var a = try zip_ler.ler_entrada(&z, "ola.txt")
    defer delete(a)
    var b = try zip_ler.ler_entrada(&z, "pasta/dados.bin")
    defer delete(b)
    print(f"ola.txt {len(a)} bytes")
    print(f"pasta/dados.bin {len(b)} bytes")
    let texto = from_bytes(a[..], alloc = frame)
    let esperado: str = "ola, zip da Forja"
    print(f"conteudo igual: {texto == esperado}")
}

proc main() {
    switch r in gravar() {
    case zip.ZipError:
        print("erro ao gravar")
        return
    default:
        print("gravado")
    }
    switch r in conferir() {
    case zip_ler.LerError:
        print("erro ao ler")
    default:
        print("lido")
    }
    _ = file.remove_file(CAMINHO)
}
