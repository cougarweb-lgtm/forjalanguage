// Exemplo do std:db (SQLite 3.54.1 estatico; antes std:banco): cria tabela em memoria, insere com parametros, consulta e trata erro de SQL.
// COMPILAR/RODAR:
//     forja run language\exemplos_libs\banco_basico.fj
//     forja build language\exemplos_libs\banco_basico.fj -o banco_basico.exe     (exe sem DLL externa)
// SAIDA ESPERADA: banco_basico.esperado

import "vendor:db/db"

proc inserir(bd: db.Db, nome: cstr, vida: i64) -> ! db.DbError {
    let q = try db.prepare(bd, sql = "INSERT INTO criatura(nome, vida) VALUES (?, ?)")
    defer db.finalize(q)
    try db.bind_text(q, index = 1, value = nome)
    try db.bind_int(q, index = 2, value = vida)
    _ = try db.next(q)
}

proc listar(bd: db.Db, minimo: i64) -> ! db.DbError {
    let q = try db.prepare(bd, sql = "SELECT id, nome, vida FROM criatura WHERE vida >= ? ORDER BY id")
    defer db.finalize(q)
    try db.bind_int(q, index = 1, value = minimo)
    while try db.next(q) {
        print(f"  #{db.column_int(q, index = 0)} {db.column_text(q, index = 1)} vida={db.column_int(q, index = 2)}")
    }
}

proc principal(bd: db.Db) -> ! db.DbError {
    try db.exec(bd, sql = "CREATE TABLE criatura(id INTEGER PRIMARY KEY, nome TEXT NOT NULL, vida INTEGER)")
    try inserir(bd, nome = "aguia", vida = 80)
    try inserir(bd, nome = "leao", vida = 120)
    try inserir(bd, nome = "camaleao", vida = 30)
    print(f"ultimo id {db.last_id(bd)}, alteradas {db.changes(bd)}")
    print("vida >= 50:")
    try listar(bd, minimo = 50)
    print("todas:")
    try listar(bd, minimo = 0)
}

proc main() {
    print(f"SQLite {db.version()}")
    switch aberto in db.open(":memory:") {
    case db.Db:
        switch r in principal(aberto) {
        case db.DbError:
            print(f"erro inesperado: {db.message(aberto)}")
        default:
            print("ok")
        }
        switch r in db.exec(aberto, sql = "SELEC 1") {
        case db.DbError:
            print(f"erro tratado: {db.message(aberto)}")
        default:
            print("inesperado")
        }
        switch r in db.exec(aberto, sql = "INSERT INTO criatura(nome) VALUES (NULL)") {
        case db.DbError:
            print(f"erro tratado: {db.message(aberto)}")
        default:
            print("inesperado")
        }
        db.close(aberto)
    case db.DbError:
        print("nao abriu")
    }
}
