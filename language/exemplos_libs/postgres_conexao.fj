// Exemplo da ponte libpq 18.6 (licenca PostgreSQL; libpq.dll e DLLs de apoio ao lado do .exe): prova que a lib carrega e trata falha de conexao.
// Nao precisa de servidor PostgreSQL: conecta a porta 1 de 127.0.0.1 (ninguem escuta) e espera status "bad"; PQping
// na porta 5432 diz se ha servidor. Nada e lido nem gravado.
// RODAR:  forja run language\exemplos_libs\postgres_conexao.fj
// EXE:    forja build language\exemplos_libs\postgres_conexao.fj -o postgres_conexao.exe
//         (copie ao lado do .exe: libpq.dll libssl-3-x64.dll libcrypto-3-x64.dll libintl-9.dll libiconv-2.dll libwinpthread-1.dll; o Windows precisa do VC++ Redistributable 2015-2022)
// SAIDA ESPERADA: postgres_conexao.esperado (sem servidor PostgreSQL na maquina; com servidor a ultima linha muda)

import "vendor:db_server/libpq" as pq

proc main() {
    print(f"libpq versao {pq.PQlibVersion()}")
    let conn = pq.PQconnectdb("host=127.0.0.1 port=1 dbname=x user=forja_teste_inexistente connect_timeout=3")
    let ruim = pq.PQstatus(conn) == pq.ConnStatusType.bad
    print(f"conexao na porta 1 falhou (status bad): {ruim}")
    let mensagem = pq.PQerrorMessage(conn) or_else "?"
    print(f"mensagem nao vazia: {len(mensagem as str) > 0}")
    pq.PQfinish(conn)
    let resposta = pq.PQping("host=127.0.0.1 port=5432 connect_timeout=3")
    print(f"servidor PostgreSQL local na 5432: {resposta == pq.PGPing.ok}")
}
