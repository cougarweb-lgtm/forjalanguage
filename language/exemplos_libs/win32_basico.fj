// Exemplo de vendor:win32/win32 e vendor:win32/ajuda (0.45.0): janela so de mensagens (sem tela) com estado guardado em GWLP_USERDATA,
// sem `var` global: o WndProc le a struct Estado do main pelo ponteiro guardado na janela.
// COMPILAR/RODAR:
//     forja run language\exemplos_libs\win32_basico.fj
// SAIDA ESPERADA: win32_basico.esperado
import "vendor:win32/win32"
import "vendor:win32/ajuda"

const MSG_SOMAR: i32 = 32768 + 1

struct Estado {
    soma: int
    ultima: u32
}

// WndProc: recebe so a janela; o Estado vem do ponteiro guardado nela
proc procedimento(janela: ?^win32.Hwnd, msg: u32, w: u64, l: i64) -> i64 {
    if msg == (MSG_SOMAR as u32) {
        let estado = ajuda.dados_da_janela(janela) as ^Estado
        estado.soma += w as int
        estado.ultima = msg
        return 0
    }
    return win32.DefWindowProcW(janela, msg, w, l)
}

proc main() {
    var estado = Estado{soma = 0, ultima = 0}
    var nome: [8]u16 = {}
    let _gravadas = ajuda.bytes_para_wide(as_bytes("JanelaF"), nome[..])
    let instancia = win32.GetModuleHandleW(none)
    var classe = win32.TagWndclassexw{cb_size = 80, style = 0, lpfn_wnd_proc = procedimento, cb_cls_extra = 0, cb_wnd_extra = 0, h_instance = instancia, h_icon = none, h_cursor = none, hbr_background = none, lpsz_menu_name = none, lpsz_class_name = &nome[0], h_icon_sm = none}
    print(win32.RegisterClassExW(&classe) != 0)
    let janela = win32.CreateWindowExW(0, &nome[0], none, 0, 0, 0, 0, 0, none, none, instancia, none)
    ajuda.guardar_dados_da_janela(janela, &estado as rawptr)
    _ = win32.SendMessageW(janela, MSG_SOMAR as u32, 40, 0)
    _ = win32.SendMessageW(janela, MSG_SOMAR as u32, 2, 0)
    print(estado.soma)
    var volta: [32]u8 = {}
    print(ajuda.wide_para_utf8(nome[..], volta[..]))
    _ = win32.DestroyWindow(janela)
}
