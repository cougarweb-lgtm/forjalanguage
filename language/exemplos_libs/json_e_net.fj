// IA1-L8: vendor:json e vendor:net no mesmo programa (antes colidiam nos nomes de topo dos dois modulos). Sem rede: so mede o tamanho de um arquivo que nao existe.
// COMPILAR/RODAR: forja run language\exemplos_libs\json_e_net.fj   (SAIDA ESPERADA: json_e_net.esperado)

import "vendor:json/json"
import "vendor:net/net"

// O texto lido e uma vista do documento: imprime antes do close do defer.
proc mostrar_nome(texto: str) -> ! json.JsonError {
    let doc = try json.parse_str(texto)
    defer json.close(doc)
    let nome = try json.field_text(doc, name = "nome")
    print(f"nome {nome}")
}

proc main() {
    switch r in mostrar_nome("{\"nome\": \"leao\"}") {
    case json.JsonError:
        print("json invalido")
    default:
        print("json ok")
    }
    let tamanho = net.file_size("nao_existe_l8.bin")
    print(f"tamanho de arquivo ausente {tamanho}")
}
