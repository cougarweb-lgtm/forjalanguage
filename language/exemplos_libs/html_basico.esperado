== seletores
div 7
#a 7
.x 7
div p 10
div > p 10
p ~ svg 12
p + svg 12
[id] 7
[id^=a] 7
[class$=y] 7
[class*=x] 7
div :first-child 10
div :first-child 13
p:nth-child(2n+1) 10
div:not(p) 7
:is(p, svg) 10
:is(p, svg) 12
p:empty -
svg circle 13
div:has(p) 7
== css
regras=18 atrules=2
regra 0 p spec=0,0,1 decls=1
  color=red imp=false
regra 1 #a spec=1,0,0 decls=1
  margin=0 auto imp=false
regra 2 .x.y spec=0,2,0 decls=1
  padding=1px 2px imp=true
regra 3 div > p spec=0,0,2 decls=2
  font-size=12px imp=false
  line-height=1.5 imp=false
regra 4 a, b.c > d spec=0,0,1 decls=2
  color=red imp=true
  margin=0 imp=false
regra 5 ul li:first-child spec=0,0,2 decls=1
  display=none imp=false
regra 6 [href^="http"] spec=0,1,0 decls=1
  text-decoration=underline imp=false
regra 7 h1 + h2 ~ span spec=0,0,3 decls=1
  top=0 imp=false
regra 8 div spec=0,0,1 decls=1
  background=url(a.png) imp=false
regra 9 .a spec=0,1,0 decls=1
  width=calc(100% - 10px) imp=false
regra 10 #b .c .d spec=1,2,0 decls=1
  border=1px solid #fff imp=false
regra 11 p:not(.z) spec=0,1,1 decls=1
  content="x" imp=false
regra 12 table tr:nth-child(odd) spec=0,1,2 decls=1
  color=blue imp=false
regra 13 * spec=0,0,0 decls=1
  box-sizing=border-box imp=false
regra 14 body spec=0,0,1 decls=1
  font-family=Arial, sans-serif imp=false
regra 15 span[title] spec=0,1,1 decls=1
  color=green imp=true
regra 16 q spec=0,0,1 decls=1
  quotes=none imp=false
regra 17 em spec=0,0,1 decls=1
  margin=-1px imp=false
