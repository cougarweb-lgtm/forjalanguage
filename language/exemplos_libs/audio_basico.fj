// Exemplo basico da ponte miniaudio 0.11.26 (vendor:audio/miniaudio) SEM placa de som: engine com noDevice,
// volume, leitura de quadros de PCM (silencio) e um som inexistente. A cola maf_* aloca os tipos opacos.
// COMPILAR/RODAR (a partir de language\exemplos_libs; a pasta vendor\ aqui e uma juncao para language\vendor):
//     forja run audio_basico.fj
//     forja build --release audio_basico.fj -o audio_basico.exe
// SAIDA ESPERADA: ver audio_basico.esperado

import "vendor:audio/miniaudio" as ma

proc descrever(codigo: i32) -> str {
    let texto = ma.ma_result_description(codigo)
    return (texto or_else "?") as str
}

proc tocar_arquivo_inexistente(motor: ^ma.MaEngine) {
    let som = ma.maf_sound_nova()
    switch s in som {
    case ^ma.MaSound:
        let r = ma.ma_sound_init_from_file(motor, p_file_path = "nao_existe.wav", flags = ma.MA_SOUND_FLAG_DECODE as u32, p_group = none, p_done_fence = none, p_sound = s)
        print(f"som_inexistente={r} ({descrever(r)})")
        if r == ma.MA_SUCCESS {
            ma.ma_sound_uninit(s)
        }
        ma.maf_sound_liberar(s)
    case none:
        print("sem memoria para o som")
    }
}

proc usar_motor(motor: ^ma.MaEngine) {
    print(f"canais={ma.ma_engine_get_channels(motor)} taxa={ma.ma_engine_get_sample_rate(motor)}")
    print(f"volume={ma.ma_engine_set_volume(motor, volume = 0.5)}")
    // O miniaudio escreve silencio no buffer (1.0 antes -> 0 depois); p_frames_read volta 0 quando nao ha som tocando
    // (mesmo comportamento do miniaudio.h em C, conferido), por isso so o codigo e a amostra sao impressos.
    var quadros: [512]f32 = {}
    quadros[0] = 1.0
    var lidos: u64 = 0
    let r = ma.ma_engine_read_pcm_frames(motor, p_frames_out = &quadros[0] as rawptr, frame_count = 256, p_frames_read = &lidos)
    print(f"leitura={r} antes=1 depois={quadros[0] as int}")
    tocar_arquivo_inexistente(motor)
}

proc main() {
    let v = ma.ma_version_string()
    let versao = (v or_else "?") as str
    print(f"versao={versao}")
    let config = ma.maf_config_nova()
    let motor = ma.maf_engine_nova()
    switch c in config {
    case ^ma.MaEngineConfig:
        ma.maf_config_sem_dispositivo(c, sem_dispositivo = 1)
        ma.maf_config_formato(c, canais = 2, taxa = 48000)
        switch m in motor {
        case ^ma.MaEngine:
            let r = ma.ma_engine_init(c, p_engine = m)
            print(f"init={r} ({descrever(r)})")
            if r == ma.MA_SUCCESS {
                usar_motor(m)
                ma.ma_engine_uninit(m)
            }
            ma.maf_engine_liberar(m)
        case none:
            print("sem memoria para o motor")
        }
        ma.maf_config_liberar(c)
    case none:
        print("sem memoria para a config")
    }
}
