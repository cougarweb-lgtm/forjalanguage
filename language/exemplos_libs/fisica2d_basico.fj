// Exemplo basico do Box2D 3.2.0 (vendor:physics2d/box2d): mundo 2D, um chao estatico e uma caixa dinamica que cai sobre ele.
// COMPILAR/RODAR (a pasta vendor\ aqui e uma juncao para language\vendor):
//     forja run language\exemplos_libs\fisica2d_basico.fj
//     forja build language\exemplos_libs\fisica2d_basico.fj -o fisica2d_basico.exe     (exe sem DLL externa)
// SAIDA ESPERADA: ver language\exemplos_libs\fisica2d_basico.esperado

import "vendor:physics2d/box2d"

proc main() {
    let v = box2d.b2GetVersion()
    print(f"box2d {v.major}.{v.minor}.{v.revision}")

    var def_mundo = box2d.b2DefaultWorldDef()
    def_mundo.gravity = box2d.B2Vec2{x = 0.0, y = -10.0}
    let mundo = box2d.b2CreateWorld(&def_mundo)
    print(f"mundo valido={box2d.b2World_IsValid(mundo)}")

    // chao estatico: caixa de 100 x 20 centrada em y = -10 (topo em y = 0)
    var def_chao = box2d.b2DefaultBodyDef()
    def_chao.position = box2d.B2Vec2{x = 0.0, y = -10.0}
    let chao = box2d.b2CreateBody(mundo, def = &def_chao)
    var forma_chao = box2d.b2MakeBox(50.0, half_height = 10.0)
    var def_forma = box2d.b2DefaultShapeDef()
    _ = box2d.b2CreatePolygonShape(chao, def = &def_forma, polygon = &forma_chao)

    // caixa dinamica de 2 x 2 que parte de y = 4
    var def_caixa = box2d.b2DefaultBodyDef()
    def_caixa.type = box2d.B2BodyType.dynamic_body
    def_caixa.position = box2d.B2Vec2{x = 0.0, y = 4.0}
    let caixa = box2d.b2CreateBody(mundo, def = &def_caixa)
    var forma_caixa = box2d.b2MakeBox(1.0, half_height = 1.0)
    var def_forma_caixa = box2d.b2DefaultShapeDef()
    def_forma_caixa.density = 1.0
    def_forma_caixa.material.friction = 0.3
    _ = box2d.b2CreatePolygonShape(caixa, def = &def_forma_caixa, polygon = &forma_caixa)

    // 120 passos de 1/60 s com 4 subpassos: a caixa cai e repousa sobre o chao
    for i in 0..<120 {
        box2d.b2World_Step(mundo, time_step = 0.016666668, sub_step_count = 4)
    }

    let p = box2d.b2Body_GetPosition(caixa)
    let x_mil = (p.x * 1000.0) as int
    let y_mil = (p.y * 1000.0) as int
    print(f"caixa x_mil={x_mil} y_mil={y_mil}")
    print(f"caixa acordada={box2d.b2Body_IsAwake(caixa)}")

    box2d.b2DestroyWorld(mundo)
    print(f"mundo valido depois de destruir={box2d.b2World_IsValid(mundo)}")
}
