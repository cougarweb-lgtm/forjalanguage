// Baixar arquivo por HTTPS dentro de um programa Forja SEM lib e SEM .exe externo: URLDownloadToFileA do urlmon.dll (Windows).
// Usa o TLS e o proxy do proprio Windows; bloqueia ate terminar. Para progresso, cancelamento, POST, cabecalhos ou mTLS
// use libcurl (catalogada em MEM-FORJA-GUIA-10).
// RODAR:  forja run language\exemplos_libs\baixar_https.fj      (precisa de internet; por isso nao entra no verificar_libs.py)
// SAIDA ESPERADA: "baixou: true" e o tamanho em bytes do robots.txt do sqlite.org (maior que 0); sem internet: "baixou: false" e o HRESULT.

foreign {
    link "urlmon"
    proc URLDownloadToFileA(chamador: u64, url: cstr, arquivo: cstr, reservado: u32, retorno: u64) -> i32
}

foreign {
    link "msvcrt"
    opaque ArquivoBaixado
    proc baixar_c_fopen = "fopen"(caminho: cstr, modo: cstr) -> ?^ArquivoBaixado
    proc baixar_c_fclose = "fclose"(arquivo: ?^ArquivoBaixado) -> i32
    proc baixar_c_fseek = "fseek"(arquivo: ?^ArquivoBaixado, deslocamento: i32, origem: i32) -> i32
    proc baixar_c_ftell = "ftell"(arquivo: ?^ArquivoBaixado) -> i32
    proc baixar_c_remove = "remove"(caminho: cstr) -> i32
}

proc tamanho_do_arquivo(caminho: cstr) -> i32 {
    let aberto = baixar_c_fopen(caminho, modo = "rb")
    switch a in aberto {
    case ^ArquivoBaixado:
        _ = baixar_c_fseek(a, deslocamento = 0, origem = 2)
        let tamanho = baixar_c_ftell(a)
        _ = baixar_c_fclose(a)
        return tamanho
    case none:
        return -1
    }
    return -1
}

proc main() {
    let destino: cstr = "baixar_https_teste.tmp"
    let hr = URLDownloadToFileA(0, url = "https://www.sqlite.org/robots.txt", arquivo = destino, reservado = 0, retorno = 0)
    let tamanho = tamanho_do_arquivo(destino)
    print(f"baixou: {hr == 0 and tamanho > 0}")
    if hr == 0 {
        print(f"tamanho > 0: {tamanho > 0}")
    } else {
        print(f"HRESULT {hr}")
    }
    _ = baixar_c_remove(destino)
}
