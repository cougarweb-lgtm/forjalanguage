// C2F-1A: LwAlocar tipado das tabelas e dos IR* do programa (zeradas, na arena), como os arena_fatia_<tipo> do pacote.
proc decl_fatia_valor(a: ^common.Arena, n: int) -> []Valor {
    var l = make([dynamic]Valor, alloc = common.arena_mem(a), cap = n)
    for i in 0..<n {
        append(&l, item = Valor{})
    }
    return l[..]
}

proc decl_fatia_i64(a: ^common.Arena, n: int) -> []i64 {
    var l = make([dynamic]i64, alloc = common.arena_mem(a), cap = n)
    for i in 0..<n {
        append(&l, item = 0)
    }
    return l[..]
}

