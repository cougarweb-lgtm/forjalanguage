import "common"
import "frontend"
import "semantic"

struct Conta2 {
    c: ?^LowerCtx
    pos: u32
}

struct TermoHamilton {
    a: u8
    b: u8
    soma: bool
}

struct Quadrado {
    i: u8
    soma: bool
}

struct Cruzado {
    c1: f32
    a1: u8
    b1: u8
    a2: u8
    b2: u8
    soma: bool
}

const QUAT_CAMPOS: i32 = 4
const QUAT_W: i32 = 3
const IX: i32 = 0
const IY: i32 = 1
const IZ: i32 = 2
const IW: i32 = 3
const LINHAS_ROTACAO: i32 = 3
const VETOR_N: i32 = 3
const HAMILTON: [4][4]TermoHamilton = {{TermoHamilton{a = 0, b = 3, soma = true},TermoHamilton{a = 3, b = 0, soma = true}, TermoHamilton{a = 1, b = 2, soma = true}, TermoHamilton{a = 2, b = 1, soma = false}}, {TermoHamilton{a = 1, b = 3, soma = true}, TermoHamilton{a = 3, b = 1, soma = true}, TermoHamilton{a = 2, b = 0, soma = true}, TermoHamilton{a = 0, b = 2, soma = false}}, {TermoHamilton{a = 2, b = 3, soma = true}, TermoHamilton{a = 3, b = 2, soma = true}, TermoHamilton{a = 0, b = 1, soma = true}, TermoHamilton{a = 1, b = 0, soma = false}}, {TermoHamilton{a = 3, b = 3, soma = true}, TermoHamilton{a = 0, b = 0, soma = false}, TermoHamilton{a = 1, b = 1, soma = false}, TermoHamilton{a = 2, b = 2, soma = false}}}
const DIAGONAL: [4][4]Quadrado = {{Quadrado{i = 0, soma = true}, Quadrado{i = 3, soma = true}, Quadrado{i = 1, soma = false}, Quadrado{i = 2, soma = false}}, {Quadrado{i = 3, soma = true}, Quadrado{i = 0, soma = false}, Quadrado{i = 1, soma = true}, Quadrado{i = 2, soma = false}}, {Quadrado{i = 3, soma = true}, Quadrado{i = 0, soma = false}, Quadrado{i = 1, soma = false}, Quadrado{i = 2, soma = true}}, {Quadrado{i = 0, soma = true}, Quadrado{i = 1, soma = true}, Quadrado{i = 2, soma = true}, Quadrado{i = 3, soma = true}}}
const CRUZADO: [3][3]Cruzado = {{Cruzado{c1 = 0.0, a1 = 0, b1 = 0, a2 = 0, b2 = 0, soma = true}, Cruzado{c1 = 2.0, a1 = 0, b1 = 1, a2 = 3, b2 = 2, soma = false}, Cruzado{c1 = 2.0, a1 = 0, b1 = 2, a2 = 3, b2 = 1, soma = true}}, {Cruzado{c1 = 2.0, a1 = 3, b1 = 2, a2 = 0, b2 = 1, soma = true}, Cruzado{c1 = 0.0, a1 = 0, b1 = 0, a2 = 0, b2 = 0, soma = true}, Cruzado{c1 = -2.0, a1 = 3, b1 = 0, a2 = 1, b2 = 2, soma = true}}, {Cruzado{c1 = -2.0, a1 = 3, b1 = 1, a2 = 0, b2 = 2, soma = true}, Cruzado{c1 = 2.0, a1 = 3, b1 = 0, a2 = 1, b2 = 2, soma = true}, Cruzado{c1 = 0.0, a1 = 0, b1 = 0, a2 = 0, b2 = 0, soma = true}}}

// C: ir/lower_quat.c:17
proc componente(c: ^LowerCtx, q: Valor, k: u32, pos: u32) -> Valor {
    let i: ^IrInstr = lw_nova_instr(c, IR_CAMPO, pos)
    i.destino = lw_novo_temp(c)
    i.tipo = semantic.TIPO_F32 as u32
    i.nome = (((c.sem as ^semantic.Semantica).decl_quat as ^frontend.Decl).campos or_else {})[k].nome
    i.a = q
    return lw_valor_temp(i.destino, semantic.TIPO_F32 as u32)
}

// C: ir/lower_quat.c:28
proc operando(c: ^LowerCtx, v: Valor, k: u32, pos: u32) -> Valor {
    var tern_1: Valor = v
    if v.tipo == (c.sem as ^semantic.Semantica).tipo_quat {
        tern_1 = componente(c, v, k, pos)
    }
    return tern_1
}

// C: ir/lower_quat.c:33
proc binario_2(c: ^LowerCtx, operador: u8, a: Valor, b: Valor, pos: u32) -> Valor {
    let i: ^IrInstr = lw_nova_instr(c, IR_BINARIO, pos)
    i.destino = lw_novo_temp(c)
    i.tipo = semantic.TIPO_F32 as u32
    i.op_aux = operador
    i.a = a
    i.b = b
    return lw_valor_temp(i.destino, semantic.TIPO_F32 as u32)
}

// C: ir/lower_quat.c:44
proc negar(c: ^LowerCtx, v: Valor, pos: u32) -> Valor {
    let i: ^IrInstr = lw_nova_instr(c, IR_UNARIO, pos)
    i.destino = lw_novo_temp(c)
    i.tipo = semantic.TIPO_F32 as u32
    i.op_aux = frontend.OP_NEGAR as u8
    i.a = v
    return lw_valor_temp(i.destino, semantic.TIPO_F32 as u32)
}

// C: ir/lower_quat.c:55
proc montar(c: ^LowerCtx, componentes: []Valor, pos: u32) -> Valor {
    let i: ^IrInstr = lw_nova_instr(c, IR_STRUCT, pos)
    i.destino = lw_novo_temp(c)
    i.tipo = (c.sem as ^semantic.Semantica).tipo_quat
    i.args = componentes
    i.nargs = QUAT_CAMPOS as u32
    return lw_valor_temp(i.destino, i.tipo)
}

// C: ir/lower_quat.c:72
proc mul(k: ^Conta2, a: Valor, b: Valor) -> Valor {
    return binario_2(k.c as ^LowerCtx, frontend.OP_MUL as u8, a, b, k.pos)
}

// C: ir/lower_quat.c:78
proc combinar(k: ^Conta2, soma: bool, acumulado: Valor, termo: Valor) -> Valor {
    var tern_1: i32 = frontend.OP_SUB
    if common.c2f_b2i32(soma) != 0 {
        tern_1 = frontend.OP_SOMA
    }
    return binario_2(k.c as ^LowerCtx, tern_1 as u8, acumulado, termo, k.pos)
}

// C: ir/lower_quat.c:84
// C2F-INDECIDIVEL: campos
proc extrair(k: ^Conta2, q: Valor, campos: []Valor) {
    for i in (0 as u32)..<(QUAT_CAMPOS as u32) {
        campos[i] = componente(k.c as ^LowerCtx, q, i, k.pos)
    }
}

// C: ir/lower_quat.c:100
// C2F-INDECIDIVEL: qa, qb
proc componente_hamilton(k: ^Conta2, qa: []Valor, qb: []Valor, alvo: u32) -> Valor {
    let primeiro: TermoHamilton = HAMILTON[alvo][0]
    var acumulado: Valor = mul(k, qa[primeiro.a], qb[primeiro.b])
    for t in (1 as u32)..<(QUAT_CAMPOS as u32) {
        let h: TermoHamilton = HAMILTON[alvo][t]
        acumulado = combinar(k, h.soma, acumulado, mul(k, qa[h.a], qb[h.b]))
    }
    return acumulado
}

// C: ir/lower_quat.c:110
proc lw_produto_quat(c: ^LowerCtx, e: ^frontend.Expr) -> Valor {
    var k: Conta2 = Conta2{c = c, pos = e.pos_op}
    let a: Valor = lw_expr(c, e.a)
    let b: Valor = lw_expr(c, e.b)
    var qa: [4]Valor = {}
    var qb: [4]Valor = {}
    extrair(&k, a, qa[..])
    extrair(&k, b, qb[..])
    var componentes: []Valor = vetor_args_zerados(c, QUAT_CAMPOS as u32)
    for i in (0 as u32)..<(QUAT_CAMPOS as u32) {
        componentes[i] = componente_hamilton(&k, qa[..], qb[..], i)
    }
    return montar(c, componentes, e.pos_op)
}

// C: ir/lower_quat.c:134
// C2F-INDECIDIVEL: q
proc soma_de_quadrados(k: ^Conta2, q: []Valor, linha: u32) -> Valor {
    let primeiro: Quadrado = DIAGONAL[linha][0]
    var acumulado: Valor = mul(k, q[primeiro.i], q[primeiro.i])
    for t in (1 as u32)..<(QUAT_CAMPOS as u32) {
        let s: Quadrado = DIAGONAL[linha][t]
        acumulado = combinar(k, s.soma, acumulado, mul(k, q[s.i], q[s.i]))
    }
    return acumulado
}

// C: ir/lower_quat.c:154
proc escalado(k: ^Conta2, coeficiente: f32, a: Valor, b: Valor) -> Valor {
    return mul(k, mul(k, lw_valor_real(coeficiente as f64, semantic.TIPO_F32 as u32), a), b)
}

// C: ir/lower_quat.c:159
// C2F-INDECIDIVEL: q
proc termo_cruzado(k: ^Conta2, q: []Valor, x: ^Cruzado) -> Valor {
    let primeiro: Valor = escalado(k, x.c1, q[x.a1], q[x.b1])
    let arg_1: Valor = escalado(k, 2.0, q[x.a2], q[x.b2])
    let arg_2: Valor = primeiro
    let arg_3: bool = x.soma
    let arg_4: ^Conta2 = k
    return combinar(arg_4, arg_3, arg_2, arg_1)
}

// C: ir/lower_quat.c:166
proc elemento_rotacao(k: ^Conta2, q: []Valor, linha: u32, coluna: u32) -> Valor {
    if linha == coluna {
        return soma_de_quadrados(k, q, linha)
    }
    var cruzado: Cruzado = CRUZADO[linha][coluna]
    return termo_cruzado(k, q, &cruzado)
}

// C: ir/lower_quat.c:172
// C2F-INDECIDIVEL: v
proc linha_rotacao(k: ^Conta2, q: []Valor, v: []Valor, linha: u32) -> Valor {
    let arg_1: Valor = elemento_rotacao(k, q, linha, 0)
    let arg_2: Valor = v[0]
    let arg_3: ^Conta2 = k
    var acumulado: Valor = mul(arg_3, arg_2, arg_1)
    for coluna in (1 as u32)..<(VETOR_N as u32) {
        let arg_4: Valor = elemento_rotacao(k, q, linha, coluna)
        let arg_5: Valor = v[coluna]
        let arg_6: ^Conta2 = k
        let termo: Valor = mul(arg_6, arg_5, arg_4)
        acumulado = combinar(k, true, acumulado, termo)
    }
    return acumulado
}

// C: ir/lower_quat.c:182
proc lw_girar_quat(c: ^LowerCtx, e: ^frontend.Expr) -> Valor {
    var k: Conta2 = Conta2{c = c, pos = e.pos_op}
    let quat: Valor = lw_expr(c, e.a)
    let vetor: Valor = lw_expr(c, e.b)
    var q: [4]Valor = {}
    var v: [3]Valor = {}
    extrair(&k, quat, q[..])
    for i in (0 as u32)..<(VETOR_N as u32) {
        v[i] = lw_elemento_do_operando(c, vetor, lw_valor_int(i as i64, semantic.TIPO_INT as u32), e.pos_op)
    }
    var elementos: []Valor = vetor_args_zerados(c, VETOR_N as u32)
    for linha in (0 as u32)..<(VETOR_N as u32) {
        elementos[linha] = linha_rotacao(&k, q[..], v[..], linha)
    }
    let i: ^IrInstr = lw_nova_instr(c, IR_ARRAY, e.pos_op)
    i.destino = lw_novo_temp(c)
    i.tipo = e.tipo
    i.args = elementos
    i.nargs = VETOR_N as u32
    return lw_valor_temp(i.destino, i.tipo)
}

// C: ir/lower_quat.c:200
proc lw_abs_quat(c: ^LowerCtx, e: ^frontend.Expr) -> Valor {
    var k: Conta2 = Conta2{c = c, pos = e.pos_op}
    var q: [4]Valor = {}
    let argumento: frontend.Arg = (e.args or_else {})[0]
    extrair(&k, lw_expr(c, argumento.valor), q[..])
    let soma: Valor = soma_de_quadrados(&k, q[..], LINHAS_ROTACAO as u32)
    return lw_raiz(c, e.pos_op, semantic.TIPO_F32 as u32, soma)
}

// C: ir/lower_quat.c:209
proc lw_binario_quat(c: ^LowerCtx, e: ^frontend.Expr) -> Valor {
    let quat: u32 = (c.sem as ^semantic.Semantica).tipo_quat
    if ((e.a as ^frontend.Expr).tipo == quat) and ((e.b as ^frontend.Expr).tipo == quat) and (e.op == (frontend.OP_MUL as u8)) {
        return lw_produto_quat(c, e)
    }
    if e.tipo != quat {
        return lw_girar_quat(c, e)
    }
    let a: Valor = lw_expr(c, e.a)
    let b: Valor = lw_expr(c, e.b)
    var componentes: []Valor = vetor_args_zerados(c, QUAT_CAMPOS as u32)
    for k in (0 as u32)..<(QUAT_CAMPOS as u32) {
        let ak: Valor = operando(c, a, k, e.pos_op)
        let bk: Valor = operando(c, b, k, e.pos_op)
        componentes[k] = binario_2(c, e.op, ak, bk, e.pos_op)
    }
    return montar(c, componentes, e.pos_op)
}

// C: ir/lower_quat.c:225
proc lw_negar_quat(c: ^LowerCtx, e: ^frontend.Expr) -> Valor {
    let q: Valor = lw_expr(c, e.a)
    var componentes: []Valor = vetor_args_zerados(c, QUAT_CAMPOS as u32)
    for k in (0 as u32)..<(QUAT_CAMPOS as u32) {
        componentes[k] = negar(c, componente(c, q, k, e.pos_op), e.pos_op)
    }
    return montar(c, componentes, e.pos_op)
}

// C: ir/lower_quat.c:233
proc lw_conj_quat(c: ^LowerCtx, e: ^frontend.Expr) -> Valor {
    let argumento: frontend.Arg = (e.args or_else {})[0]
    let q: Valor = lw_expr(c, argumento.valor)
    var componentes: []Valor = vetor_args_zerados(c, QUAT_CAMPOS as u32)
    for k in (0 as u32)..<(QUAT_CAMPOS as u32) {
        let campo: Valor = componente(c, q, k, e.pos_op)
        if k == (QUAT_W as u32) {
            componentes[k] = campo
        } else {
            componentes[k] = negar(c, campo, e.pos_op)
        }
    }
    return montar(c, componentes, e.pos_op)
}

// Transcricao das tabelas do C (lower_quat.c HAMILTON, DIAGONAL, CRUZADO): celulas amostradas, valores lidos do C.
test "lower_quat: tabelas HAMILTON, DIAGONAL e CRUZADO batem com o C" {
    expect(HAMILTON[0][0].a == 0 and HAMILTON[0][0].b == 3 and HAMILTON[0][0].soma)
    expect(HAMILTON[0][3].a == 2 and HAMILTON[0][3].b == 1 and not HAMILTON[0][3].soma)
    expect(HAMILTON[3][0].a == 3 and HAMILTON[3][0].b == 3 and HAMILTON[3][0].soma)
    expect(HAMILTON[3][1].a == 0 and HAMILTON[3][1].b == 0 and not HAMILTON[3][1].soma)
    expect(DIAGONAL[2][3].i == 2 and DIAGONAL[2][3].soma)
    expect(DIAGONAL[2][2].i == 1 and not DIAGONAL[2][2].soma)
    expect(CRUZADO[0][1].c1 == 2.0 and CRUZADO[0][1].a2 == 3 and CRUZADO[0][1].b2 == 2 and not CRUZADO[0][1].soma)
    expect(CRUZADO[1][2].c1 == -2.0 and CRUZADO[1][2].a1 == 3 and CRUZADO[1][2].b1 == 0)
    expect(CRUZADO[2][1].c1 == 2.0 and CRUZADO[2][1].a2 == 1 and CRUZADO[2][1].b2 == 2)
}
