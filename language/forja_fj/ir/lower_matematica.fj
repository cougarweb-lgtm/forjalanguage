import "common"
import "frontend"
import "semantic"

struct Escalar {
    c: ?^LowerCtx
    tipo: u32 // TipoId
    pos: u32
}

struct Matematica {
    escalar: Escalar
    operacao: u16
    noperandos: u32
    op: [3]Valor
}

const MATEMATICA_OPERANDOS_MAX: i32 = 3
const MASCARA_SEM_SINAL_32: i64 = 2147483647
const MASCARA_SEM_SINAL_64: i64 = 9223372036854775807
// C2F:? tabela OPERACOES (const Operacao[5]): folha nao escalar {'txt': '[ EMB_MIN - EMB_MIN ] = Operaca

pub const OPERACAO_OPERACAO_MIN: u16 = 1
pub const OPERACAO_OPERACAO_MAX: u16 = 2
pub const OPERACAO_OPERACAO_CLAMP: u16 = 3
pub const OPERACAO_OPERACAO_ABS: u16 = 4
pub const OPERACAO_OPERACAO_RAIZ: u16 = 5
pub proc chamar_operacao(tag: u16, s: ^Escalar, op: []Valor) -> Valor {
    if tag == 1 {
        return operacao_min(s, op)
    }
    if tag == 2 {
        return operacao_max(s, op)
    }
    if tag == 3 {
        return operacao_clamp(s, op)
    }
    if tag == 4 {
        return operacao_abs(s, op)
    }
    if tag == 5 {
        return operacao_raiz(s, op)
    }
    common.falha_interna("lowering: tag de operacao de matematica desconhecida")
    return Valor{}
}

// C: ir/lower_matematica.c:28
proc nova_instr_com_temp(s: ^Escalar, op: i32, tipo: u32, a: Valor, b: Valor) -> Valor {
    let i: ^IrInstr = lw_nova_instr(s.c as ^LowerCtx, op, s.pos)
    i.destino = lw_novo_temp(s.c as ^LowerCtx)
    i.tipo = tipo
    i.a = a
    i.b = b
    return lw_valor_temp(i.destino, tipo)
}

// C: ir/lower_matematica.c:38
proc binario(s: ^Escalar, operador: u8, tipo: u32, a: Valor, b: Valor) -> Valor {
    let i: ^IrInstr = lw_nova_instr(s.c as ^LowerCtx, IR_BINARIO, s.pos)
    i.destino = lw_novo_temp(s.c as ^LowerCtx)
    i.tipo = tipo
    i.op_aux = operador
    i.a = a
    i.b = b
    return lw_valor_temp(i.destino, tipo)
}

// C: ir/lower_matematica.c:50
proc novo_local_com(s: ^Escalar, inicial: Valor) -> i32 {
    let def: ^IrInstr = lw_nova_instr(s.c as ^LowerCtx, IR_LOCAL, s.pos)
    def.destino = lw_novo_local(s.c as ^LowerCtx)
    def.tipo = s.tipo
    def.mutavel = true
    def.a = inicial
    return def.destino
}

// C: ir/lower_matematica.c:60
proc atribuir(s: ^Escalar, local: i32, valor: Valor) {
    let i: ^IrInstr = lw_nova_instr(s.c as ^LowerCtx, IR_ATRIBUICAO, s.pos)
    i.destino = local
    i.tipo = s.tipo
    i.a = valor
}

// C: ir/lower_matematica.c:69
proc entrar_se(s: ^Escalar, cond: Valor) -> ^IrBloco {
    let se: ^IrInstr = lw_nova_instr(s.c as ^LowerCtx, IR_SE, s.pos)
    se.a = cond
    return lw_trocar_bloco(s.c as ^LowerCtx, &se.corpo)
}

// C: ir/lower_matematica.c:77
proc se_atribui(s: ^Escalar, cond: Valor, local: i32, novo: Valor) {
    let externo: ^IrBloco = entrar_se(s, cond)
    atribuir(s, local, novo)
    _ = lw_trocar_bloco(s.c as ^LowerCtx, externo)
}

// C: ir/lower_matematica.c:86
// C2F-INDECIDIVEL: op
proc operacao_min(s: ^Escalar, op: []Valor) -> Valor {
    let resultado: i32 = novo_local_com(s, op[0])
    let arg_1: Valor = op[1]
    let arg_2: i32 = resultado
    let arg_3: Valor = binario(s, frontend.OP_MENOR as u8, semantic.TIPO_BOOL as u32, op[1], op[0])
    let arg_4: ^Escalar = s
    se_atribui(arg_4, arg_3, arg_2, arg_1)
    return lw_valor_local(resultado, s.tipo)
}

// C: ir/lower_matematica.c:93
// C2F-INDECIDIVEL: op
proc operacao_max(s: ^Escalar, op: []Valor) -> Valor {
    let resultado: i32 = novo_local_com(s, op[0])
    let arg_1: Valor = op[1]
    let arg_2: i32 = resultado
    let arg_3: Valor = binario(s, frontend.OP_MENOR as u8, semantic.TIPO_BOOL as u32, op[0], op[1])
    let arg_4: ^Escalar = s
    se_atribui(arg_4, arg_3, arg_2, arg_1)
    return lw_valor_local(resultado, s.tipo)
}

// C: ir/lower_matematica.c:100
// C2F-INDECIDIVEL: op
proc operacao_clamp(s: ^Escalar, op: []Valor) -> Valor {
    let resultado: i32 = novo_local_com(s, op[0])
    let atual: Valor = lw_valor_local(resultado, s.tipo)
    let arg_1: Valor = op[1]
    let arg_2: i32 = resultado
    let arg_3: Valor = binario(s, frontend.OP_MENOR as u8, semantic.TIPO_BOOL as u32, atual, op[1])
    let arg_4: ^Escalar = s
    se_atribui(arg_4, arg_3, arg_2, arg_1)
    let arg_5: Valor = op[2]
    let arg_6: i32 = resultado
    let arg_7: Valor = binario(s, frontend.OP_MENOR as u8, semantic.TIPO_BOOL as u32, op[2], atual)
    let arg_8: ^Escalar = s
    se_atribui(arg_8, arg_7, arg_6, arg_5)
    return atual
}

// C: ir/lower_matematica.c:110
proc abs_inteiro(s: ^Escalar, x: Valor) -> Valor {
    let resultado: i32 = novo_local_com(s, x)
    let zero: Valor = lw_valor_int(0, s.tipo)
    let externo: ^IrBloco = entrar_se(s, binario(s, frontend.OP_MENOR as u8, semantic.TIPO_BOOL as u32, x, zero))
    atribuir(s, resultado, binario(s, frontend.OP_SUB as u8, s.tipo, zero, x))
    _ = lw_trocar_bloco(s.c as ^LowerCtx, externo)
    return lw_valor_local(resultado, s.tipo)
}

// C: ir/lower_matematica.c:121
proc abs_real(s: ^Escalar, x: Valor) -> Valor {
    let dupla: bool = s.tipo == (semantic.TIPO_F64 as u32)
    var tern_1: i32 = semantic.TIPO_U32
    if common.c2f_b2i32(dupla) != 0 {
        tern_1 = semantic.TIPO_UINT
    }
    let bits: u32 = common.c2f_s2u_32(tern_1)
    let cru: Valor = nova_instr_com_temp(s, IR_TRANSMUTA, bits, x, lw_valor_nenhum())
    var tern_2: i64 = MASCARA_SEM_SINAL_32
    if common.c2f_b2i32(dupla) != 0 {
        tern_2 = MASCARA_SEM_SINAL_64
    }
    let mascara: Valor = lw_valor_int(tern_2, bits)
    let limpo: Valor = binario(s, frontend.OP_BIT_E as u8, bits, cru, mascara)
    let arg_1: Valor = lw_valor_nenhum()
    let arg_2: Valor = limpo
    let arg_3: u32 = s.tipo
    let arg_4: ^Escalar = s
    return nova_instr_com_temp(arg_4, IR_TRANSMUTA, arg_3, arg_2, arg_1)
}

// C: ir/lower_matematica.c:131
// C2F-INDECIDIVEL: op
proc operacao_abs(s: ^Escalar, op: []Valor) -> Valor {
    var tern_1: Valor = Valor{}
    if common.c2f_b2i32(semantic.tipo_eh_inteiro(s.tipo)) != 0 {
        tern_1 = abs_inteiro(s, op[0])
    } else {
        tern_1 = abs_real(s, op[0])
    }
    return tern_1
}

// C: ir/lower_matematica.c:137
proc lw_raiz(c: ^LowerCtx, pos: u32, tipo: u32, a: Valor) -> Valor {
    let i: ^IrInstr = lw_nova_instr(c, IR_UNARIO, pos)
    i.destino = lw_novo_temp(c)
    i.tipo = tipo
    i.op_aux = frontend.OP_RAIZ as u8
    i.a = a
    return lw_valor_temp(i.destino, tipo)
}

// C: ir/lower_matematica.c:147
// C2F-INDECIDIVEL: op
proc operacao_raiz(s: ^Escalar, op: []Valor) -> Valor {
    return lw_raiz(s.c as ^LowerCtx, s.pos, s.tipo, op[0])
}

// C: ir/lower_matematica.c:161
// C2F-VOID: dados
proc elemento_da_matematica(c: ^LowerCtx, dados: rawptr, indice: Valor) -> Valor {
    let m: ^Matematica = dados as ^Matematica
    var elementos: [3]Valor = {}
    for k in (0 as u32)..<m.noperandos {
        elementos[k] = lw_elemento_do_operando(c, m.op[k], indice, m.escalar.pos)
    }
    return chamar_operacao(m.operacao, &m.escalar, elementos[..])
}

// C: ir/lower_matematica.c:169
proc lw_matematica(c: ^LowerCtx, e: ^frontend.Expr) -> Valor {
    let vetor: bool = semantic.tipo_classe_de(&(c.sem as ^semantic.Semantica).tipos, e.tipo) == semantic.TC_ARRAY
    var tag: u16 = OPERACAO_OPERACAO_RAIZ
    if e.ref_id == frontend.EMB_MIN {
        tag = OPERACAO_OPERACAO_MIN
    } else if e.ref_id == frontend.EMB_MAX {
        tag = OPERACAO_OPERACAO_MAX
    } else if e.ref_id == frontend.EMB_ABS {
        tag = OPERACAO_OPERACAO_ABS
    } else if e.ref_id == frontend.EMB_CLAMP {
        tag = OPERACAO_OPERACAO_CLAMP
    }
    var escalar_tipo: u32 = e.tipo
    if vetor {
        escalar_tipo = semantic.tipo_de(&(c.sem as ^semantic.Semantica).tipos, e.tipo).a
    }
    var m: Matematica = Matematica{operacao = tag, noperandos = e.nargs}
    m.escalar = Escalar{c = c, tipo = escalar_tipo, pos = e.pos_op}
    for i in (0 as u32)..<e.nargs {
        let argumento: frontend.Arg = (e.args or_else {})[i]
        m.op[argumento.indice] = lw_expr(c, argumento.valor)
    }
    if not vetor {
        return chamar_operacao(m.operacao, &m.escalar, m.op[..])
    }
    let dados_m: ^Matematica = &m
    var por = PorElemento{tipo = e.tipo, pos = e.pos_op, elemento = ELEMENTO_FN_ELEMENTO_DA_MATEMATICA, dados = dados_m as rawptr}
    return lw_por_elemento(c, &por)
}
