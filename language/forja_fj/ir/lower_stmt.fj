import "common"
import "frontend"
import "semantic"

// C2F:? tabela COMANDOS (const LowerComando[14]): folha nao escalar {'txt': '[ ST_LET_MULTIPLO ] = LwStmtLet

pub const LOWER_COMANDO_LW_STMT_DEFER: u16 = 1
pub const LOWER_COMANDO_LW_STMT_IF: u16 = 2
pub const LOWER_COMANDO_LW_STMT_WHILE: u16 = 3
pub const LOWER_COMANDO_LW_STMT_FOR: u16 = 4
pub const LOWER_COMANDO_LW_STMT_BREAK: u16 = 5
pub const LOWER_COMANDO_LW_STMT_CONTINUE: u16 = 6
pub const LOWER_COMANDO_LW_STMT_SWITCH: u16 = 7
pub const LOWER_COMANDO_LW_LET_VAR: u16 = 8
pub const LOWER_COMANDO_LW_ATRIBUICAO: u16 = 9
pub const LOWER_COMANDO_LW_CHAMADA_COMANDO: u16 = 10
pub const LOWER_COMANDO_LW_RETURN: u16 = 11
pub const LOWER_COMANDO_LW_EXPECT: u16 = 12
pub const LOWER_COMANDO_LW_STMT_LET_MULTIPLO: u16 = 13
pub proc chamar_lower_comando(tag: u16, c: ^LowerCtx, s: ?^frontend.Stmt) {
    if tag == 1 {
        lw_stmt_defer(c, s)
        return
    }
    if tag == 2 {
        lw_stmt_if(c, s as ^frontend.Stmt)
        return
    }
    if tag == 3 {
        lw_stmt_while(c, s as ^frontend.Stmt)
        return
    }
    if tag == 4 {
        lw_stmt_for(c, s as ^frontend.Stmt)
        return
    }
    if tag == 5 {
        lw_stmt_break(c, s as ^frontend.Stmt)
        return
    }
    if tag == 6 {
        lw_stmt_continue(c, s as ^frontend.Stmt)
        return
    }
    if tag == 7 {
        lw_stmt_switch(c, s as ^frontend.Stmt)
        return
    }
    if tag == 8 {
        lw_let_var(c, s as ^frontend.Stmt)
        return
    }
    if tag == 9 {
        lw_atribuicao(c, s as ^frontend.Stmt)
        return
    }
    if tag == 10 {
        lw_chamada_comando(c, s as ^frontend.Stmt)
        return
    }
    if tag == 11 {
        lw_return(c, s as ^frontend.Stmt)
        return
    }
    if tag == 12 {
        lw_expect(c, s as ^frontend.Stmt)
        return
    }
    if tag == 13 {
        lw_stmt_let_multiplo(c, s as ^frontend.Stmt)
        return
    }
    lw_falha_stmt(c, s, "comando desconhecido")
}

// C: ir/lower_stmt.c:21 (FalhaInterna com arquivo:linha:coluna do Stmt; caminho '?' quando o fonte nao tem nome)
proc lw_falha_stmt(c: ^LowerCtx, s: ?^frontend.Stmt, motivo: str) {
    let st: ^frontend.Stmt = s as ^frontend.Stmt
    let sem: ^semantic.Semantica = c.sem as ^semantic.Semantica
    let p: common.FontePosicao = common.fonte_localizar_no_arquivo(sem.fonte, st.pos)
    let caminho: str = p.caminho or_else "?"
    let msg = format(f"lowering: {motivo} em {caminho}:{p.linha}:{p.coluna}", alloc = heap)
    defer delete(msg)
    common.falha_interna(msg)
}

// C: ir/lower_stmt.c:30
proc lw_let_var(c: ^LowerCtx, s: ^frontend.Stmt) {
    if s.tipo_local == (frontend.TIPO_NAO_RESOLVIDO as u32) {
        lw_falha_stmt(c, s, "let/var sem tipo resolvido")
    }
    var tern_1: Valor = Valor{}
    if s.expr != none {
        tern_1 = lw_expr(c, s.expr)
    } else {
        tern_1 = lw_valor_nenhum()
    }
    let inicial: Valor = tern_1
    let i: ^IrInstr = lw_nova_instr(c, IR_LOCAL, s.pos)
    i.destino = s.local_id
    i.tipo = s.tipo_local
    i.a = inicial
    i.mutavel = s.tipo_no == (frontend.ST_VAR as u8)
    if s.corpo != none {
        lw_stmt_defer(c, s.corpo)
    }
}

// C: ir/lower_stmt.c:45
proc local_do_alvo(c: ^LowerCtx, s: ^frontend.Stmt, nome: ?^frontend.Expr) -> i32 {
    if ((nome as ^frontend.Expr).tipo_no != (frontend.EX_NOME as u8)) or (((nome as ^frontend.Expr).ref != (frontend.REF_LOCAL as u8)) and ((nome as ^frontend.Expr).ref != (frontend.REF_PARAM as u8))) {
        lw_falha_stmt(c, s, "alvo da atribuicao nao liga a um local")
    }
    return (nome as ^frontend.Expr).ref_id
}

// C: ir/lower_stmt.c:54
proc ler_alvo(c: ^LowerCtx, s: ^frontend.Stmt, base: i32) -> Valor {
    let alvo: ?^frontend.Expr = s.alvo
    if (alvo as ^frontend.Expr).tipo_no == (frontend.EX_NOME as u8) {
        return lw_valor_local(base, (alvo as ^frontend.Expr).tipo)
    }
    let i: ^IrInstr = lw_nova_instr(c, IR_CAMPO, s.pos)
    i.destino = lw_novo_temp(c)
    i.tipo = (alvo as ^frontend.Expr).tipo
    i.a = lw_valor_local(base, ((alvo as ^frontend.Expr).a as ^frontend.Expr).tipo)
    i.nome = (alvo as ^frontend.Expr).nome
    return lw_valor_temp(i.destino, (alvo as ^frontend.Expr).tipo)
}

// C: ir/lower_stmt.c:67
proc combinar_composto(c: ^LowerCtx, s: ^frontend.Stmt, atual: Valor, novo: Valor) -> Valor {
    if common.c2f_s2u_32(semantic.tipo_classe_de(&(c.sem as ^semantic.Semantica).tipos, (s.alvo as ^frontend.Expr).tipo)) == (semantic.TC_ARRAY as u32) {
        var tern_1: i32 = frontend.OP_SUB
        if s.op == (frontend.ATRIB_SOMA as u8) {
            tern_1 = frontend.OP_SOMA
        }
        var conta: ContaVetor = ContaVetor{op = tern_1 as u8, tipo = (s.alvo as ^frontend.Expr).tipo, pos = s.pos, a = atual, b = novo}
        return lw_conta_vetor(c, &conta)
    }
    let i: ^IrInstr = lw_nova_instr(c, IR_BINARIO, s.pos)
    i.destino = lw_novo_temp(c)
    i.tipo = (s.alvo as ^frontend.Expr).tipo
    var tern_2: i32 = frontend.OP_SUB
    if s.op == (frontend.ATRIB_SOMA as u8) {
        tern_2 = frontend.OP_SOMA
    }
    i.op_aux = tern_2 as u8
    i.a = atual
    i.b = novo
    return lw_valor_temp(i.destino, i.tipo)
}

// C: ir/lower_stmt.c:83
proc valor_atribuido(c: ^LowerCtx, s: ^frontend.Stmt, base: i32) -> Valor {
    let novo: Valor = lw_expr(c, s.expr)
    if s.op == 0 {
        return novo
    }
    return combinar_composto(c, s, ler_alvo(c, s, base), novo)
}

// C: ir/lower_stmt.c:91
proc estrutura_do_campo(c: ^LowerCtx, s: ^frontend.Stmt, t: u32) -> ?^frontend.Decl {
    var t_v: u32 = t
    if common.c2f_s2u_32(semantic.tipo_classe_de(&(c.sem as ^semantic.Semantica).tipos, t_v)) == (semantic.TC_PONTEIRO as u32) {
        t_v = semantic.tipo_de(&(c.sem as ^semantic.Semantica).tipos, t_v).a
    }
    if common.c2f_s2u_32(semantic.tipo_classe_de(&(c.sem as ^semantic.Semantica).tipos, t_v)) != (semantic.TC_STRUCT as u32) {
        lw_falha_stmt(c, s, "campo de algo que nao e struct")
    }
    return ((c.sem as ^semantic.Semantica).globais or_else {})[semantic.tipo_de(&(c.sem as ^semantic.Semantica).tipos, t_v).a].decl
}

// C: ir/lower_stmt.c:99
proc alvo_eh_local(alvo: ?^frontend.Expr) -> bool {
    if (alvo as ^frontend.Expr).tipo_no == (frontend.EX_NOME as u8) {
        return true
    }
    return ((alvo as ^frontend.Expr).tipo_no == (frontend.EX_CAMPO as u8)) and (((alvo as ^frontend.Expr).a as ^frontend.Expr).tipo_no == (frontend.EX_NOME as u8))
}

// C: ir/lower_stmt.c:105
proc eh_deref_2(e: ?^frontend.Expr) -> bool {
    return ((e as ^frontend.Expr).tipo_no == (frontend.EX_UNARIO as u8)) and ((e as ^frontend.Expr).op == (frontend.OP_DEREF as u8))
}

// C: ir/lower_stmt.c:111
proc ponteiro_do_alvo(c: ^LowerCtx, s: ^frontend.Stmt) -> Valor {
    let alvo: ?^frontend.Expr = s.alvo
    if eh_deref_2(alvo) {
        return lw_expr(c, (alvo as ^frontend.Expr).a)
    }
    if (alvo as ^frontend.Expr).tipo_no == (frontend.EX_INDICE as u8) {
        return lw_endereco(c, alvo)
    }
    if ((alvo as ^frontend.Expr).tipo_no != (frontend.EX_CAMPO as u8)) or ((alvo as ^frontend.Expr).ref != (frontend.REF_CAMPO as u8)) {
        lw_falha_stmt(c, s, "alvo de gravacao sem ponteiro")
    }
    if eh_deref_2((alvo as ^frontend.Expr).a) {
        return lw_expr(c, ((alvo as ^frontend.Expr).a as ^frontend.Expr).a)
    }
    if common.c2f_s2u_32(semantic.tipo_classe_de(&(c.sem as ^semantic.Semantica).tipos, ((alvo as ^frontend.Expr).a as ^frontend.Expr).tipo)) == (semantic.TC_PONTEIRO as u32) {
        return lw_expr(c, (alvo as ^frontend.Expr).a)
    }
    return lw_endereco(c, (alvo as ^frontend.Expr).a)
}

// C: ir/lower_stmt.c:123
proc ler_apontado(c: ^LowerCtx, s: ^frontend.Stmt, ponteiro: Valor) -> Valor {
    let campo: bool = (s.alvo as ^frontend.Expr).tipo_no == (frontend.EX_CAMPO as u8)
    var tern_1: i32 = IR_UNARIO
    if common.c2f_b2i32(campo) != 0 {
        tern_1 = IR_CAMPO
    }
    let i: ^IrInstr = lw_nova_instr(c, tern_1, s.pos)
    i.destino = lw_novo_temp(c)
    i.tipo = (s.alvo as ^frontend.Expr).tipo
    i.a = ponteiro
    if campo {
        i.nome = (s.alvo as ^frontend.Expr).nome
    } else {
        i.op_aux = frontend.OP_DEREF as u8
    }
    return lw_valor_temp(i.destino, i.tipo)
}

// C: ir/lower_stmt.c:136
proc lw_alvo_na_soa(c: ^LowerCtx, alvo: ?^frontend.Expr) -> bool {
    if (alvo as ^frontend.Expr).tipo_no == (frontend.EX_INDICE as u8) {
        return common.c2f_s2u_32(semantic.tipo_classe_de(&(c.sem as ^semantic.Semantica).tipos, ((alvo as ^frontend.Expr).a as ^frontend.Expr).tipo)) == (semantic.TC_SOA as u32)
    }
    return (((alvo as ^frontend.Expr).tipo_no == (frontend.EX_CAMPO as u8)) and (((alvo as ^frontend.Expr).a as ^frontend.Expr).tipo_no == (frontend.EX_INDICE as u8))) and (common.c2f_s2u_32(semantic.tipo_classe_de(&(c.sem as ^semantic.Semantica).tipos, (((alvo as ^frontend.Expr).a as ^frontend.Expr).a as ^frontend.Expr).tipo)) == (semantic.TC_SOA as u32))
}

// C: ir/lower_stmt.c:144 (a[i] = s espalha a struct pelas colunas; ordem: endereco da soa, indice, valor)
proc lw_gravacao_soa_inteira(c: ^LowerCtx, s: ^frontend.Stmt) {
    let alvo: ^frontend.Expr = s.alvo as ^frontend.Expr
    let ponteiro: Valor = lw_endereco(c, alvo.a)
    let indice: Valor = lw_indice_int(c, alvo.b)
    let novo: Valor = lw_expr(c, s.expr)
    let i: ^IrInstr = lw_nova_instr(c, IR_SOA_GRAVA, s.pos)
    i.a = ponteiro
    i.b = indice
    i.args = lw_args(c, 1)
    let args: []Valor = i.args or_else {}
    args[0] = novo
    i.nargs = 1
}

// C: ir/lower_stmt.c:158
proc lw_gravacao_soa(c: ^LowerCtx, s: ^frontend.Stmt) {
    if (s.alvo as ^frontend.Expr).tipo_no == (frontend.EX_INDICE as u8) {
        lw_gravacao_soa_inteira(c, s)
        return
    }
    let ponteiro: Valor = lw_endereco_campo_soa(c, s.alvo)
    var novo: Valor = lw_expr(c, s.expr)
    if s.op != 0 {
        let atual: ^IrInstr = lw_nova_instr(c, IR_UNARIO, s.pos)
        atual.destino = lw_novo_temp(c)
        atual.tipo = (s.alvo as ^frontend.Expr).tipo
        atual.op_aux = frontend.OP_DEREF as u8
        atual.a = ponteiro
        novo = combinar_composto(c, s, lw_valor_temp(atual.destino, atual.tipo), novo)
    }
    let arg_1: u32 = s.pos
    let arg_2: Valor = novo
    let arg_3: i32 = (s.alvo as ^frontend.Expr).ref_id
    let arg_4: ?^frontend.Decl = estrutura_do_campo(c, s, ((s.alvo as ^frontend.Expr).a as ^frontend.Expr).tipo)
    let arg_5: ^LowerCtx = c
    lw_verifica_faixa(arg_5, arg_4, arg_3, arg_2, arg_1)
    let i: ^IrInstr = lw_nova_instr(c, IR_GRAVA_PONTEIRO, s.pos)
    i.tipo = (s.alvo as ^frontend.Expr).tipo
    i.a = ponteiro
    i.b = novo
    i.nome = -1
}

// C: ir/lower_stmt.c:183
proc lw_gravacao(c: ^LowerCtx, s: ^frontend.Stmt) {
    if (common.c2f_b2i32((c.sem as ^semantic.Semantica).tipos.tem_soa) != 0) and (common.c2f_b2i32(lw_alvo_na_soa(c, s.alvo)) != 0) {
        lw_gravacao_soa(c, s)
        return
    }
    let campo: bool = (s.alvo as ^frontend.Expr).tipo_no == (frontend.EX_CAMPO as u8)
    let ponteiro: Valor = ponteiro_do_alvo(c, s)
    var novo: Valor = lw_expr(c, s.expr)
    if s.op != 0 {
        novo = combinar_composto(c, s, ler_apontado(c, s, ponteiro), novo)
    }
    if campo {
        let arg_1: u32 = s.pos
        let arg_2: Valor = novo
        let arg_3: i32 = (s.alvo as ^frontend.Expr).ref_id
        let arg_4: ?^frontend.Decl = estrutura_do_campo(c, s, ((s.alvo as ^frontend.Expr).a as ^frontend.Expr).tipo)
        let arg_5: ^LowerCtx = c
        lw_verifica_faixa(arg_5, arg_4, arg_3, arg_2, arg_1)
    }
    let i: ^IrInstr = lw_nova_instr(c, IR_GRAVA_PONTEIRO, s.pos)
    i.tipo = (s.alvo as ^frontend.Expr).tipo
    i.a = ponteiro
    i.b = novo
    var tern_1: i32 = -1
    if common.c2f_b2i32(campo) != 0 {
        tern_1 = (s.alvo as ^frontend.Expr).nome
    }
    i.nome = tern_1
}

// C: ir/lower_stmt.c:203
proc lw_atribuicao(c: ^LowerCtx, s: ^frontend.Stmt) {
    if not alvo_eh_local(s.alvo) {
        lw_gravacao(c, s)
        return
    }
    let campo: bool = (s.alvo as ^frontend.Expr).tipo_no == (frontend.EX_CAMPO as u8)
    if (common.c2f_b2i32(campo) != 0) and ((s.alvo as ^frontend.Expr).ref != (frontend.REF_CAMPO as u8)) {
        lw_falha_stmt(c, s, "alvo de campo sem ref de campo")
    }
    var tern_1: ?^frontend.Expr = s.alvo
    if common.c2f_b2i32(campo) != 0 {
        tern_1 = (s.alvo as ^frontend.Expr).a
    }
    let base: i32 = local_do_alvo(c, s, tern_1)
    let novo: Valor = valor_atribuido(c, s, base)
    if campo {
        let arg_1: u32 = s.pos
        let arg_2: Valor = novo
        let arg_3: i32 = (s.alvo as ^frontend.Expr).ref_id
        let arg_4: ?^frontend.Decl = estrutura_do_campo(c, s, ((s.alvo as ^frontend.Expr).a as ^frontend.Expr).tipo)
        let arg_5: ^LowerCtx = c
        lw_verifica_faixa(arg_5, arg_4, arg_3, arg_2, arg_1)
    }
    let ultima: ?^IrInstr = (c.atual as ^IrBloco).ultima
    if (((((not campo) and (novo.tipo_no == (V_NULO as u8))) and (ultima != none)) and ((ultima as ^IrInstr).op == (IR_ATRIBUICAO as u8))) and ((ultima as ^IrInstr).destino == base)) and ((ultima as ^IrInstr).a.tipo_no == (V_NULO as u8)) {
        return
    }
    let i: ^IrInstr = lw_nova_instr(c, IR_ATRIBUICAO, s.pos)
    i.destino = base
    i.tipo = (s.alvo as ^frontend.Expr).tipo
    i.a = novo
    var tern_2: i32 = -1
    if common.c2f_b2i32(campo) != 0 {
        tern_2 = (s.alvo as ^frontend.Expr).nome
    }
    i.nome = tern_2
}

// C: ir/lower_stmt.c:228
proc lw_chamada_comando(c: ^LowerCtx, s: ^frontend.Stmt) {
    if (s.expr as ^frontend.Expr).tipo_no == (frontend.EX_TRY as u8) {
        _ = lw_try(c, s.expr)
    } else if (s.expr as ^frontend.Expr).tipo_no == (frontend.EX_CHAMADA_IND as u8) {
        _ = lw_chamada_ind(c, s.expr)
    } else {
        _ = lw_chamada(c, s.expr)
    }
}

// C: ir/lower_stmt.c:238
proc embrulhar_resultado(c: ^LowerCtx, s: ^frontend.Stmt, v: Valor, retorno: u32) -> Valor {
    let info: semantic.TipoInfo = semantic.tipo_de(&(c.sem as ^semantic.Semantica).tipos, retorno)^
    let t: u32 = (s.expr as ^frontend.Expr).tipo
    var op: i32 = 0
    if t == info.b {
        op = IR_RES_ERRO
    } else if (t == info.a) and (t != (semantic.TIPO_VAZIO as u32)) {
        op = IR_RES_OK
    } else {
        return v
    }
    let i: ^IrInstr = lw_nova_instr(c, op, s.pos)
    i.destino = lw_novo_temp(c)
    i.tipo = retorno
    i.a = v
    return lw_valor_temp(i.destino, retorno)
}

// C: ir/lower_stmt.c:254
proc valor_do_return(c: ^LowerCtx, s: ^frontend.Stmt) -> Valor {
    let retorno: u32 = (c.decl as ^frontend.Decl).retorno.tipo
    let resultado: bool = common.c2f_s2u_32(semantic.tipo_classe_de(&(c.sem as ^semantic.Semantica).tipos, retorno)) == (semantic.TC_RESULTADO as u32)
    if s.expr == none {
        if not resultado {
            return lw_valor_nenhum()
        }
        let ok: ^IrInstr = lw_nova_instr(c, IR_RES_OK, s.pos)
        ok.destino = lw_novo_temp(c)
        ok.tipo = retorno
        ok.a = lw_valor_nenhum()
        return lw_valor_temp(ok.destino, retorno)
    }
    let v: Valor = lw_expr(c, s.expr)
    var tern_1: Valor = v
    if common.c2f_b2i32(resultado) != 0 {
        tern_1 = embrulhar_resultado(c, s, v, retorno)
    }
    return tern_1
}

// C: ir/lower_stmt.c:271
proc proteger_do_defer(c: ^LowerCtx, v: Valor, pos: u32) -> Valor {
    if (v.tipo_no != (V_LOCAL as u8)) or ((len(c.defers) as u64) == 0) {
        return v
    }
    let i: ^IrInstr = lw_nova_instr(c, IR_LOCAL, pos)
    i.destino = lw_novo_local(c)
    i.tipo = v.tipo
    i.a = v
    return lw_valor_local(i.destino, v.tipo)
}

// C: ir/lower_stmt.c:281
proc lw_return(c: ^LowerCtx, s: ^frontend.Stmt) {
    let arg_1: u32 = s.pos
    let arg_2: Valor = valor_do_return(c, s)
    let arg_3: ^LowerCtx = c
    let v: Valor = proteger_do_defer(arg_3, arg_2, arg_1)
    lw_expandir_defers(c, 0)
    let i: ^IrInstr = lw_nova_instr(c, IR_RETORNA, s.pos)
    i.a = v
}

// C: ir/lower_stmt.c:292 (texto da condicao como no fonte, de Expr.pos ate o ')' final, sem espaco/tab no fim)
proc texto_da_condicao(c: ^LowerCtx, s: ^frontend.Stmt) -> i32 {
    let sem: ^semantic.Semantica = c.sem as ^semantic.Semantica
    let f: ^common.Fonte = sem.fonte as ^common.Fonte
    let ini: u32 = (s.expr as ^frontend.Expr).pos
    var fim: u32 = s.pos_fim
    if (fim <= ini) or ((fim as u64) > f.tam) {
        lw_falha_stmt(c, s, "expect sem posicao do ')' final")
    }
    while (fim > ini) and ((f.texto[(fim - 1) as int] == 32) or (f.texto[(fim - 1) as int] == 9)) {
        fim -= 1
    }
    let texto = from_bytes(f.texto[(ini as int)..<(fim as int)], alloc = heap)
    defer delete(texto)
    let nomes: []common.Interner = sem.nomes or_else {}
    return common.internar(&nomes[0], texto, fim - ini)
}

// C: ir/lower_stmt.c:301
proc lw_expect(c: ^LowerCtx, s: ^frontend.Stmt) {
    let condicao: Valor = lw_expr(c, s.expr)
    let i: ^IrInstr = lw_nova_instr(c, IR_EXPECT, s.pos)
    i.a = condicao
    i.nome = texto_da_condicao(c, s)
}

// C: ir/lower_stmt.c:312
proc lw_stmt_let_multiplo(c: ^LowerCtx, s: ^frontend.Stmt) {
    let tupla: Valor = lw_expr(c, s.expr)
    var k: u32 = 0
    while k < s.ncasos {
        let nome: ^frontend.NomeLet = &(s.nomes or_else {})[k]
        if nome.local_id < 0 {
            k += 1
            continue
        }
        let elemento: ^IrInstr = lw_nova_instr(c, IR_TUPLA_ELEMENTO, nome.pos)
        elemento.destino = lw_novo_temp(c)
        elemento.tipo = nome.tipo
        elemento.a = tupla
        elemento.b = lw_valor_int(k as i64, semantic.TIPO_U32 as u32)
        let local: ^IrInstr = lw_nova_instr(c, IR_LOCAL, nome.pos)
        local.destino = nome.local_id
        local.tipo = nome.tipo
        local.a = lw_valor_temp(elemento.destino, elemento.tipo)
        local.mutavel = s.op == 1
        k += 1
    }
}

// C2F:? tabela COMANDOS virou tag: ST_* -> LOWER_COMANDO_* (0 = fora da tabela = comando desconhecido)
proc tag_do_comando(tipo: u8) -> u16 {
    if tipo == (frontend.ST_LET_MULTIPLO as u8) {
        return LOWER_COMANDO_LW_STMT_LET_MULTIPLO
    }
    if (tipo == (frontend.ST_LET as u8)) or (tipo == (frontend.ST_VAR as u8)) {
        return LOWER_COMANDO_LW_LET_VAR
    }
    if tipo == (frontend.ST_ATRIBUICAO as u8) {
        return LOWER_COMANDO_LW_ATRIBUICAO
    }
    if tipo == (frontend.ST_IF as u8) {
        return LOWER_COMANDO_LW_STMT_IF
    }
    if tipo == (frontend.ST_WHILE as u8) {
        return LOWER_COMANDO_LW_STMT_WHILE
    }
    if tipo == (frontend.ST_FOR as u8) {
        return LOWER_COMANDO_LW_STMT_FOR
    }
    if tipo == (frontend.ST_RETURN as u8) {
        return LOWER_COMANDO_LW_RETURN
    }
    if tipo == (frontend.ST_CHAMADA as u8) {
        return LOWER_COMANDO_LW_CHAMADA_COMANDO
    }
    if tipo == (frontend.ST_BREAK as u8) {
        return LOWER_COMANDO_LW_STMT_BREAK
    }
    if tipo == (frontend.ST_CONTINUE as u8) {
        return LOWER_COMANDO_LW_STMT_CONTINUE
    }
    if tipo == (frontend.ST_DEFER as u8) {
        return LOWER_COMANDO_LW_STMT_DEFER
    }
    if tipo == (frontend.ST_SWITCH as u8) {
        return LOWER_COMANDO_LW_STMT_SWITCH
    }
    if tipo == (frontend.ST_EXPECT as u8) {
        return LOWER_COMANDO_LW_EXPECT
    }
    return 0
}

// C: ir/lower_stmt.c:339
proc lw_stmt(c: ^LowerCtx, s: ?^frontend.Stmt) {
    let tag: u16 = tag_do_comando((s as ^frontend.Stmt).tipo_no)
    chamar_lower_comando(tag, c, s)
}

// C: ir/lower_stmt.c:345
proc eh_saida(s: ?^frontend.Stmt) -> bool {
    return (((s as ^frontend.Stmt).tipo_no == (frontend.ST_RETURN as u8)) or ((s as ^frontend.Stmt).tipo_no == (frontend.ST_BREAK as u8))) or ((s as ^frontend.Stmt).tipo_no == (frontend.ST_CONTINUE as u8))
}

// C: ir/lower_stmt.c:350 (empilha o escopo; comandos em ordem; defers do fim normal; desempilha defers e escopo)
proc lw_bloco(c: ^LowerCtx, lista: ?^frontend.Stmt, e_laco: bool) {
    let inicio: u32 = len(c.defers) as u32
    append(&c.escopos, item = LwEscopo{inicio = inicio, e_laco = e_laco})
    var ultimo: ?^frontend.Stmt = none
    var s: ?^frontend.Stmt = lista
    while s != none {
        lw_stmt(c, s)
        ultimo = s
        s = (s as ^frontend.Stmt).prox
    }
    if (ultimo == none) or (not eh_saida(ultimo)) {
        lw_expandir_defers(c, (len(c.escopos) as u32) - 1)
    }
    while len(c.defers) > (inicio as int) {
        _ = pop(&c.defers)
    }
    _ = pop(&c.escopos)
}

// Testes dirigidos (valores do C: COMANDOS e LwBloco em lower_stmt.c).
test "lower_stmt: tag dos comandos e bloco vazio" {
    expect(tag_do_comando(frontend.ST_LET as u8) == LOWER_COMANDO_LW_LET_VAR)
    expect(tag_do_comando(frontend.ST_VAR as u8) == LOWER_COMANDO_LW_LET_VAR)
    expect(tag_do_comando(frontend.ST_EXPECT as u8) == LOWER_COMANDO_LW_EXPECT)
    expect(tag_do_comando(frontend.ST_LET_MULTIPLO as u8) == LOWER_COMANDO_LW_STMT_LET_MULTIPLO)
    expect(tag_do_comando(200) == 0)
    var a = common.Arena{}
    var c = LowerCtx{}
    c.arena = &a
    c.defers = make([dynamic]?^frontend.Stmt, alloc = heap, cap = 4)
    c.escopos = make([dynamic]LwEscopo, alloc = heap, cap = 4)
    var sem = semantic.Semantica{}
    c.sem = &sem
    lw_bloco(&c, none, false)
    expect(len(c.escopos) == 0 and len(c.defers) == 0)
    delete(c.defers)
    delete(c.escopos)
    common.arena_liberar(&a)
}

test "lower_stmt: texto da condicao sem espaco no fim" {
    var arenas = make([dynamic]common.Arena, alloc = heap, cap = 1)
    append(&arenas, item = common.Arena{})
    let a: ^common.Arena = &(arenas[..])[0]
    var lista = make([dynamic]common.Interner, alloc = heap, cap = 1)
    append(&lista, item = common.Interner{})
    common.interner_iniciar(&lista[0], a)
    var fonte_teste = common.Fonte{}
    fonte_teste.texto = as_bytes("abc   ")
    fonte_teste.tam = 6
    var sem = semantic.Semantica{}
    sem.nomes = lista[..]
    sem.fonte = &fonte_teste
    var c = LowerCtx{}
    c.sem = &sem
    c.arena = a
    var ex = frontend.Expr{pos = 0}
    var st = frontend.Stmt{pos_fim = 6}
    st.expr = &ex
    expect(common.interner_texto(&lista[0], texto_da_condicao(&c, &st)) == "abc")
    common.interner_liberar(&lista[0])
    delete(lista)
    common.arena_liberar(a)
    delete(arenas)
}
