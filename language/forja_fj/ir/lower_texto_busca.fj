import "common"
import "frontend"
import "semantic"

struct Texto {
    base: LlBase
    n: Valor
}

struct Reverso {
    s: Texto
    saida: LlBase
}

const BYTE_C2: i32 = 194
const BYTE_DF: i32 = 223
const BYTE_E0: i32 = 224
const BYTE_ED: i32 = 237
const BYTE_EF: i32 = 239
const BYTE_F0: i32 = 240
const BYTE_F4: i32 = 244
const BYTE_CONT_MIN: i32 = 128
const BYTE_CONT_MAX: i32 = 191
const BYTE_A0: i32 = 160
const BYTE_9F: i32 = 159
const BYTE_90: i32 = 144
const BYTE_8F: i32 = 143
// C2F-82 macro de funcao INT_VALOR ( n ) LwValorInt ( ( n ) , TIPO_INT )
// C2F-82 macro de funcao BYTE_VALOR ( n ) LwValorInt ( ( n ) , TIPO_U8 )

// C: ir/lower_texto_busca.c:33
proc texto_do_argumento(k: ^LoCtx, arg: ?^frontend.Expr) -> Texto {
    let arg_1: Valor = lw_expr(k.c as ^LowerCtx, arg)
    let arg_2: u32 = semantic.tipo_fatia(&((k.c as ^LowerCtx).sem as ^semantic.Semantica).tipos, semantic.TIPO_U8 as u32)
    let arg_3: ^LoCtx = k
    let bytes: Valor = lo_transmuta(arg_3, arg_2, arg_1)
    return Texto{base = LlBase{valor = bytes, elemento = semantic.TIPO_U8 as u32, lista = false}, n = ll_tamanho(k, bytes)}
}

// C: ir/lower_texto_busca.c:40
proc batem_em(k: ^LoCtx, s: ^Texto, sub: ^Texto, i: Valor) -> i32 {
    let iguais: i32 = lo_local(k, semantic.TIPO_BOOL as u32, lw_valor_bool(true))
    var externo: ?^IrBloco = none
    let j: Valor = ll_entra_laco(k, lw_valor_int(0, semantic.TIPO_INT as u32), sub.n, &externo)
    let do_texto: Valor = ll_le(k, &s.base, ll_mais(k, i, j), true)
    let da_agulha: Valor = ll_le(k, &sub.base, j, true)
    let fora: ^IrBloco = lo_entra_se(k, lo_binario(k, frontend.OP_DIFERENTE as u8, semantic.TIPO_BOOL as u32, do_texto, da_agulha))
    lo_atribui(k, iguais, semantic.TIPO_BOOL as u32, lw_valor_bool(false))
    ll_pare(k)
    lo_sai_do_se(k, fora)
    ll_sai_do_laco(k, externo as ^IrBloco)
    return iguais
}

// C: ir/lower_texto_busca.c:56
proc lw_texto_acha(c: ^LowerCtx, e: ^frontend.Expr) -> Valor {
    var k: LoCtx = LoCtx{c = c, pos = e.pos_op}
    var s: Texto = texto_do_argumento(&k, ll_argumento(e, 0))
    var sub: Texto = texto_do_argumento(&k, ll_argumento(e, 1))
    let resultado: i32 = lo_local(&k, e.tipo, lw_valor_nenhum())
    let fora_se: ^IrBloco = lo_entra_se(&k, lo_binario(&k, frontend.OP_MENOR_IGUAL as u8, semantic.TIPO_BOOL as u32, sub.n, s.n))
    var externo: ?^IrBloco = none
    let volta: Valor = ll_entra_laco(&k, lw_valor_int(0, semantic.TIPO_INT as u32), ll_mais(&k, ll_menos(&k, s.n, sub.n), lw_valor_int(1, semantic.TIPO_INT as u32)), &externo)
    var posicao: Valor = volta
    if e.ref_id == frontend.EMB_LAST_INDEX_OF {
        posicao = ll_menos(&k, ll_menos(&k, s.n, sub.n), volta)
    }
    let iguais: i32 = batem_em(&k, &s, &sub, posicao)
    let fora: ^IrBloco = lo_entra_se(&k, lw_valor_local(iguais, semantic.TIPO_BOOL as u32))
    if e.ref_id == frontend.EMB_CONTAINS {
        lo_atribui(&k, resultado, semantic.TIPO_BOOL as u32, lw_valor_bool(true))
    } else {
        lo_atribui(&k, resultado, e.tipo, ll_embrulha(&k, e.tipo, posicao))
    }
    ll_pare(&k)
    lo_sai_do_se(&k, fora)
    ll_sai_do_laco(&k, externo as ^IrBloco)
    lo_sai_do_se(&k, fora_se)
    return lw_valor_local(resultado, e.tipo)
}

// C: ir/lower_texto_busca.c:78
proc lw_texto_conta(c: ^LowerCtx, e: ^frontend.Expr) -> Valor {
    var k: LoCtx = LoCtx{c = c, pos = e.pos_op}
    var s: Texto = texto_do_argumento(&k, ll_argumento(e, 0))
    var sub: Texto = texto_do_argumento(&k, ll_argumento(e, 1))
    let total: i32 = lo_local(&k, semantic.TIPO_INT as u32, lw_valor_nenhum())
    let proximo: i32 = lo_local(&k, semantic.TIPO_INT as u32, lw_valor_nenhum())
    let fora_se: ^IrBloco = lo_entra_se(&k, lo_binario(&k, frontend.OP_MENOR_IGUAL as u8, semantic.TIPO_BOOL as u32, sub.n, s.n))
    var externo: ?^IrBloco = none
    let i: Valor = ll_entra_laco(&k, lw_valor_int(0, semantic.TIPO_INT as u32), ll_mais(&k, ll_menos(&k, s.n, sub.n), lw_valor_int(1, semantic.TIPO_INT as u32)), &externo)
    let iguais: i32 = batem_em(&k, &s, &sub, i)
    let fora: ^IrBloco = lo_entra_se(&k, lw_valor_local(iguais, semantic.TIPO_BOOL as u32))
    let livre: ^IrBloco = lo_entra_se(&k, lo_binario(&k, frontend.OP_MAIOR_IGUAL as u8, semantic.TIPO_BOOL as u32, i, lw_valor_local(proximo, semantic.TIPO_INT as u32)))
    lo_atribui(&k, total, semantic.TIPO_INT as u32, ll_mais(&k, lw_valor_local(total, semantic.TIPO_INT as u32), lw_valor_int(1, semantic.TIPO_INT as u32)))
    lo_atribui(&k, proximo, semantic.TIPO_INT as u32, ll_mais(&k, i, sub.n))
    lo_sai_do_se(&k, livre)
    lo_sai_do_se(&k, fora)
    ll_sai_do_laco(&k, externo as ^IrBloco)
    lo_sai_do_se(&k, fora_se)
    return lw_valor_local(total, semantic.TIPO_INT as u32)
}

// C: ir/lower_texto_busca.c:101
proc byte_em(k: ^LoCtx, s: ^Texto, j: Valor, d: i64) -> Valor {
    return ll_le(k, &s.base, ll_mais(k, j, lw_valor_int(d, semantic.TIPO_INT as u32)), true)
}

// C: ir/lower_texto_busca.c:107
proc entre(k: ^LoCtx, b: Valor, lo: i64, hi: i64) -> Valor {
    let acima: Valor = lo_binario(k, frontend.OP_MAIOR_IGUAL as u8, semantic.TIPO_BOOL as u32, b, lw_valor_int(lo, semantic.TIPO_U8 as u32))
    let abaixo: Valor = lo_binario(k, frontend.OP_MENOR_IGUAL as u8, semantic.TIPO_BOOL as u32, b, lw_valor_int(hi, semantic.TIPO_U8 as u32))
    return lo_binario(k, frontend.OP_E as u8, semantic.TIPO_BOOL as u32, acima, abaixo)
}

// C: ir/lower_texto_busca.c:115
proc continua(k: ^LoCtx, b: Valor) -> Valor {
    return entre(k, b, BYTE_CONT_MIN as i64, BYTE_CONT_MAX as i64)
}

// C: ir/lower_texto_busca.c:121
proc diferente_de(k: ^LoCtx, b: Valor, v: i64) -> Valor {
    return lo_binario(k, frontend.OP_DIFERENTE as u8, semantic.TIPO_BOOL as u32, b, lw_valor_int(v, semantic.TIPO_U8 as u32))
}

// C: ir/lower_texto_busca.c:127
proc tamanho_de2(k: ^LoCtx, s: ^Texto, j: Valor, tam: i32) {
    let b0: Valor = byte_em(k, s, j, 0)
    let fora: ^IrBloco = lo_entra_se(k, entre(k, b0, BYTE_C2 as i64, BYTE_DF as i64))
    let cabe: ^IrBloco = lo_entra_se(k, lo_binario(k, frontend.OP_MENOR as u8, semantic.TIPO_BOOL as u32, ll_mais(k, j, lw_valor_int(1, semantic.TIPO_INT as u32)), s.n))
    let ok: ^IrBloco = lo_entra_se(k, continua(k, byte_em(k, s, j, 1)))
    lo_atribui(k, tam, semantic.TIPO_INT as u32, lw_valor_int(2, semantic.TIPO_INT as u32))
    lo_sai_do_se(k, ok)
    lo_sai_do_se(k, cabe)
    lo_sai_do_se(k, fora)
}

