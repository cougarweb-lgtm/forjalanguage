    let menor_8f: Valor = lo_binario(k, frontend.OP_MENOR_IGUAL as u8, semantic.TIPO_BOOL as u32, b1, lw_valor_int(BYTE_8F as i64, semantic.TIPO_U8 as u32))
    let nao_f4: Valor = diferente_de(k, b0, BYTE_F4 as i64)
