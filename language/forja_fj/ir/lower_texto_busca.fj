    let b2: Valor = byte_em(k, s, j, 2)
    // E0 (gcc) avalia o argumento da direita antes (N5): Continua(b2) sai antes de SegundoDe3
    let cont_b2: Valor = continua(k, b2)
    let segundo: Valor = segundo_de3(k, b0, b1)
    let ok: ^IrBloco = lo_entra_se(k, lo_binario(k, frontend.OP_E as u8, semantic.TIPO_BOOL as u32, segundo, cont_b2))
    lo_atribui(k, tam, semantic.TIPO_INT as u32, lw_valor_int(3, semantic.TIPO_INT as u32))
    lo_sai_do_se(k, ok)
