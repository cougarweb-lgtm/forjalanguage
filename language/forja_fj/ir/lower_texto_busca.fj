proc segundo_de3(k: ^LoCtx, b0: Valor, b1: Valor) -> Valor {
    let maior_a0: Valor = lo_binario(k, frontend.OP_MAIOR_IGUAL as u8, semantic.TIPO_BOOL as u32, b1, lw_valor_int(BYTE_A0 as i64, semantic.TIPO_U8 as u32))
    let nao_e0: Valor = diferente_de(k, b0, BYTE_E0 as i64)
    let sem_overlong: Valor = lo_binario(k, frontend.OP_OU as u8, semantic.TIPO_BOOL as u32, nao_e0, maior_a0)
    let menor_9f: Valor = lo_binario(k, frontend.OP_MENOR_IGUAL as u8, semantic.TIPO_BOOL as u32, b1, lw_valor_int(BYTE_9F as i64, semantic.TIPO_U8 as u32))
    let nao_ed: Valor = diferente_de(k, b0, BYTE_ED as i64)
    let sem_surrogate: Valor = lo_binario(k, frontend.OP_OU as u8, semantic.TIPO_BOOL as u32, nao_ed, menor_9f)
    let sem_ambos: Valor = lo_binario(k, frontend.OP_E as u8, semantic.TIPO_BOOL as u32, sem_overlong, sem_surrogate)
    let continuo: Valor = continua(k, b1)
    return lo_binario(k, frontend.OP_E as u8, semantic.TIPO_BOOL as u32, continuo, sem_ambos)
}

// C: ir/lower_texto_busca.c:148
proc tamanho_de3(k: ^LoCtx, s: ^Texto, j: Valor, tam: i32) {
    let b0: Valor = byte_em(k, s, j, 0)
    let fora: ^IrBloco = lo_entra_se(k, entre(k, b0, BYTE_E0 as i64, BYTE_EF as i64))
    let cabe: ^IrBloco = lo_entra_se(k, lo_binario(k, frontend.OP_MENOR as u8, semantic.TIPO_BOOL as u32, ll_mais(k, j, lw_valor_int(2, semantic.TIPO_INT as u32)), s.n))
