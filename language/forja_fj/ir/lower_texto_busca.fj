// C: ir/lower_texto_busca.c:171
proc tamanho_de4(k: ^LoCtx, s: ^Texto, j: Valor, tam: i32) {
    let b0: Valor = byte_em(k, s, j, 0)
    let fora: ^IrBloco = lo_entra_se(k, entre(k, b0, BYTE_F0 as i64, BYTE_F4 as i64))
    let cabe: ^IrBloco = lo_entra_se(k, lo_binario(k, frontend.OP_MENOR as u8, semantic.TIPO_BOOL as u32, ll_mais(k, j, lw_valor_int(3, semantic.TIPO_INT as u32)), s.n))
    let b1: Valor = byte_em(k, s, j, 1)
    let b2: Valor = byte_em(k, s, j, 2)
    let b3: Valor = byte_em(k, s, j, 3)
    // E0 (gcc) avalia o argumento da direita antes (N5): Continua(b3) sai antes de Continua(b2)
    let cont_b3: Valor = continua(k, b3)
    let cont_b2: Valor = continua(k, b2)
    let resto: Valor = lo_binario(k, frontend.OP_E as u8, semantic.TIPO_BOOL as u32, cont_b2, cont_b3)
    let segundo: Valor = segundo_de4(k, b0, b1)
    let ok: ^IrBloco = lo_entra_se(k, lo_binario(k, frontend.OP_E as u8, semantic.TIPO_BOOL as u32, segundo, resto))
    lo_atribui(k, tam, semantic.TIPO_INT as u32, lw_valor_int(4, semantic.TIPO_INT as u32))
    lo_sai_do_se(k, ok)
    lo_sai_do_se(k, cabe)
    lo_sai_do_se(k, fora)
}

// C: ir/lower_texto_busca.c:188
proc tamanho_runa(k: ^LoCtx, s: ^Texto, j: Valor) -> i32 {
    let tam: i32 = lo_local(k, semantic.TIPO_INT as u32, lw_valor_int(1, semantic.TIPO_INT as u32))
    tamanho_de2(k, s, j, tam)
    tamanho_de3(k, s, j, tam)
    tamanho_de4(k, s, j, tam)
    return tam
}

// C: ir/lower_texto_busca.c:198
proc escreve_runa(k: ^LoCtx, r: ^Reverso, j: Valor, tam: Valor) {
    var externo: ?^IrBloco = none
    let t: Valor = ll_entra_laco(k, lw_valor_int(0, semantic.TIPO_INT as u32), tam, &externo)
    let destino: Valor = ll_mais(k, ll_menos(k, ll_menos(k, r.s.n, j), tam), t)
    // E0 (gcc) avalia o argumento da direita antes (N5): le a origem antes do endereco do destino
    let lido: Valor = ll_le(k, &r.s.base, ll_mais(k, j, t), true)
    let endereco: Valor = ll_end(k, &r.saida, destino, false)
    ll_grava(k, endereco, semantic.TIPO_U8 as u32, lido)
    ll_sai_do_laco(k, externo as ^IrBloco)
}

// C: ir/lower_texto_busca.c:208
proc lw_lista_para_texto(c: ^LowerCtx, e: ^frontend.Expr, lista: Valor) -> Valor {
    let i: ^IrInstr = lw_nova_instr(c, IR_REDIMENSIONA, e.pos_op)
    i.op_aux = REDIM_PARA_STR as u8
    i.destino = lw_novo_temp(c)
    i.tipo = semantic.TIPO_STR as u32
    i.a = lista
    return lw_valor_temp(i.destino, semantic.TIPO_STR as u32)
}

// C: ir/lower_texto_busca.c:219
proc lw_reverse_texto(c: ^LowerCtx, e: ^frontend.Expr) -> Valor {
    var k: LoCtx = LoCtx{c = c, pos = e.pos_op}
    var s: Texto = texto_do_argumento(&k, ll_argumento(e, 0))
    let lista_u8: u32 = semantic.tipo_dinamico(&(c.sem as ^semantic.Semantica).tipos, semantic.TIPO_U8 as u32)
    let alocador: Valor = lw_alocador(c, e)
    let cria: ^IrInstr = lw_nova_instr(c, IR_LISTA_CRIA, e.pos_op)
    cria.destino = lw_novo_temp(c)
    cria.tipo = lista_u8
    cria.a = alocador
    cria.b = s.n
    let saida: i32 = lo_local(&k, lista_u8, lw_valor_temp(cria.destino, lista_u8))
    let valor_saida: Valor = lw_valor_local(saida, lista_u8)
    ll_redimensiona(&k, valor_saida, semantic.TIPO_U8 as u32, s.n)
    var r: Reverso = Reverso{s = s, saida = LlBase{valor = valor_saida, elemento = semantic.TIPO_U8 as u32, lista = true}}
    let pular_ate: i32 = lo_local(&k, semantic.TIPO_INT as u32, lw_valor_nenhum())
    var externo: ?^IrBloco = none
    let j: Valor = ll_entra_laco(&k, lw_valor_int(0, semantic.TIPO_INT as u32), s.n, &externo)
    let inicio: ^IrBloco = lo_entra_se(&k, lo_binario(&k, frontend.OP_MAIOR_IGUAL as u8, semantic.TIPO_BOOL as u32, j, lw_valor_local(pular_ate, semantic.TIPO_INT as u32)))
    let tam: i32 = tamanho_runa(&k, &s, j)
    let tamanho: Valor = lw_valor_local(tam, semantic.TIPO_INT as u32)
    escreve_runa(&k, &r, j, tamanho)
    lo_atribui(&k, pular_ate, semantic.TIPO_INT as u32, ll_mais(&k, j, tamanho))
    lo_sai_do_se(&k, inicio)
    ll_sai_do_laco(&k, externo as ^IrBloco)
    return lw_lista_para_texto(c, e, valor_saida)
}

// C: ir/lower_texto_busca.c:247
proc lw_busca_texto(c: ^LowerCtx, e: ^frontend.Expr) -> Valor {
    let sw_1 = e.ref_id
    if sw_1 == frontend.EMB_INDEX_OF or sw_1 == frontend.EMB_LAST_INDEX_OF or sw_1 == frontend.EMB_CONTAINS {
        return lw_texto_acha(c, e)
    } else if sw_1 == frontend.EMB_COUNT {
        return lw_texto_conta(c, e)
    } else if sw_1 == frontend.EMB_REVERSE {
        return lw_reverse_texto(c, e)
    } else {
        let msg_1 = format(f"lowering: embutido de texto desconhecido (offset {e.pos_op})", alloc = heap)
        defer delete(msg_1)
        common.falha_interna(msg_1)
    }
    return Valor{}
}
