}

// C: ir/lower_texto_busca.c:163
// E0 (gcc) avalia os argumentos da direita antes (N5), como em segundo_de3
proc segundo_de4(k: ^LoCtx, b0: Valor, b1: Valor) -> Valor {
    let maior_90: Valor = lo_binario(k, frontend.OP_MAIOR_IGUAL as u8, semantic.TIPO_BOOL as u32, b1, lw_valor_int(BYTE_90 as i64, semantic.TIPO_U8 as u32))
    let nao_f0: Valor = diferente_de(k, b0, BYTE_F0 as i64)
