import "common"
import "semantic"

// C: ir/lower_ir.c:10 (LwAlocar void: C2F-1A. Sem o void, o no zerado sai numa lista de 1 elemento na arena, como os arena_fatia_<tipo>)
proc arena_instr(c: ^LowerCtx) -> ^IrInstr {
    var l = make([dynamic]IrInstr, alloc = common.arena_mem(c.arena as ^common.Arena), cap = 1)
    append(&l, item = IrInstr{})
    let fatia = l[..]
    return &fatia[0]
}

// C: ir/lower_ir.c:15
proc lw_nova_instr(c: ^LowerCtx, op: i32, pos: u32) -> ^IrInstr {
    let i: ^IrInstr = arena_instr(c)
    i.op = op as u8
    i.pos = pos
    i.destino = -1
    i.nome = -1
    let bloco: ^IrBloco = c.atual as ^IrBloco
    if bloco.ultima == none {
        bloco.primeira = i
    } else {
        let anterior: ^IrInstr = bloco.ultima as ^IrInstr
        anterior.prox = i
    }
    bloco.ultima = i
    return i
}

// C: ir/lower_ir.c:28
proc lw_novo_temp(c: ^LowerCtx) -> i32 {
    let antes_1: u32 = c.ntemps
    c.ntemps += 1
    return transmute(antes_1, to = i32)
}

// C: ir/lower_ir.c:33
proc lw_novo_local(c: ^LowerCtx) -> i32 {
    let antes_1: u32 = c.prox_local
    c.prox_local += 1
    return transmute(antes_1, to = i32)
}

// C: ir/lower_ir.c:38
proc lw_trocar_bloco(c: ^LowerCtx, novo: ^IrBloco) -> ^IrBloco {
    let anterior: ?^IrBloco = c.atual
    c.atual = novo
    return anterior as ^IrBloco
}

// C: ir/lower_ir.c:45
proc lw_valor_temp(id: i32, tipo: u32) -> Valor {
    return Valor{tipo_no = V_TEMP as u8, tipo = tipo, id = id}
}

// C: ir/lower_ir.c:50
proc lw_valor_local(id: i32, tipo: u32) -> Valor {
    return Valor{tipo_no = V_LOCAL as u8, tipo = tipo, id = id}
}

// C: ir/lower_ir.c:55
proc lw_valor_int(v: i64, tipo: u32) -> Valor {
    return Valor{tipo_no = V_INT as u8, tipo = tipo, inteiro = v}
}

// C: ir/lower_ir.c:60
proc lw_valor_real(v: f64, tipo: u32) -> Valor {
    return Valor{tipo_no = V_REAL as u8, tipo = tipo, real = v}
}

// C: ir/lower_ir.c:65
proc lw_valor_bool(v: bool) -> Valor {
    var tern_1: i32 = 0
    if common.c2f_b2i32(v) != 0 {
        tern_1 = 1
    }
    return Valor{tipo_no = V_BOOL as u8, tipo = semantic.TIPO_BOOL as u32, inteiro = tern_1 as i64}
}

// C: ir/lower_ir.c:70
proc lw_valor_texto(nome_internado: i32, tipo: u32) -> Valor {
    return Valor{tipo_no = V_TEXTO as u8, tipo = tipo, id = nome_internado}
}

// C: ir/lower_ir.c:75
proc lw_valor_nulo(tipo: u32) -> Valor {
    return Valor{tipo_no = V_NULO as u8, tipo = tipo}
}

// C: ir/lower_ir.c:80
proc lw_valor_nenhum() -> Valor {
    return Valor{tipo_no = V_NENHUM as u8, tipo = semantic.TIPO_VAZIO as u32}
}

// C: ir/lower_ir.c:85 (n == 0 -> NULL = none; senao n Valor zerados (V_NENHUM) na arena)
proc lw_args(c: ^LowerCtx, n: u32) -> ?[]Valor {
    if n == 0 {
        return none
    }
    var l = make([dynamic]Valor, alloc = common.arena_mem(c.arena as ^common.Arena), cap = n as int)
    for k in 0..<n {
        append(&l, item = Valor{})
    }
    return l[..]
}

// Testes dirigidos (valores do C: lower_ir.c). Contexto montado a mao: arena e bloco.
test "lower_ir: contadores e troca de bloco" {
    var c = LowerCtx{}
    c.ntemps = 4
    expect(lw_novo_temp(&c) == 4 and c.ntemps == 5)
    c.prox_local = 2
    expect(lw_novo_local(&c) == 2 and c.prox_local == 3)
    var a = common.Arena{}
    var b1 = IrBloco{}
    var b2 = IrBloco{}
    c.atual = &b1
    let anterior: ^IrBloco = lw_trocar_bloco(&c, &b2)
    expect(anterior == &b1)
    expect((c.atual as ^IrBloco) == &b2)
    common.arena_liberar(&a)
}

test "lower_ir: valores de operando" {
    expect(lw_valor_int(-7, 3).inteiro == -7 and lw_valor_int(-7, 3).tipo_no == V_INT as u8)
    expect(lw_valor_bool(true).inteiro == 1 and lw_valor_bool(false).inteiro == 0)
    expect(lw_valor_bool(true).tipo == semantic.TIPO_BOOL as u32)
    expect(lw_valor_temp(5, 9).id == 5 and lw_valor_local(6, 9).tipo_no == V_LOCAL as u8)
    expect(lw_valor_nulo(12).tipo_no == V_NULO as u8)
    expect(lw_valor_nenhum().tipo_no == V_NENHUM as u8)
}

test "lower_ir: nova instrucao liga no bloco atual" {
    var a = common.Arena{}
    var c = LowerCtx{}
    c.arena = &a
    var bloco = IrBloco{}
    c.atual = &bloco
    let i1: ^IrInstr = lw_nova_instr(&c, IR_LOCAL, 7)
    let i2: ^IrInstr = lw_nova_instr(&c, IR_RETORNA, 9)
    expect(i1.destino == -1 and i1.nome == -1 and i1.pos == 7)
    expect((bloco.primeira as ^IrInstr) == i1 and (bloco.ultima as ^IrInstr) == i2)
    expect((i1.prox as ^IrInstr) == i2 and i2.op == IR_RETORNA as u8)
    expect(lw_args(&c, 0) == none)
    let w = lw_args(&c, 3) or_else {}
    expect(len(w) == 3 and w[2].tipo_no == V_NENHUM as u8)
    common.arena_liberar(&a)
}
