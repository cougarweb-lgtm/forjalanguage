import "common"
import "frontend"
import "semantic"

struct Fatia2 {
    base: LlBase
    n: Valor
}

// C2F-82 macro de funcao INT_VALOR ( n ) LwValorInt ( ( n ) , TIPO_INT )

// C: ir/lower_estat.c:19
proc fatia_do_argumento_2(k: ^LoCtx, arg: ?^frontend.Expr) -> Fatia2 {
    let fatia: Valor = lw_expr(k.c as ^LowerCtx, arg)
    return Fatia2{base = ll_base_de(k.c as ^LowerCtx, fatia), n = ll_tamanho(k, fatia)}
}

// C: ir/lower_estat.c:25
proc zero_de(k: ^LoCtx, tipo: u32) -> Valor {
    var tern_1: Valor = Valor{}
    if common.c2f_b2i32(semantic.tipo_eh_real(&((k.c as ^LowerCtx).sem as ^semantic.Semantica).tipos, tipo)) != 0 {
        tern_1 = lw_valor_real(0.0, tipo)
    } else {
        tern_1 = lw_valor_int(0, tipo)
    }
    return tern_1
}

// C: ir/lower_estat.c:31
proc vence(k: ^LoCtx, minimo: bool, tipo: u32, x: Valor, melhor: Valor) -> Valor {
    var tern_1: i32 = frontend.OP_MAIOR
    if common.c2f_b2i32(minimo) != 0 {
        tern_1 = frontend.OP_MENOR
    }
    let vence: Valor = lo_binario(k, tern_1 as u8, semantic.TIPO_BOOL as u32, x, melhor)
    if not semantic.tipo_eh_real(&((k.c as ^LowerCtx).sem as ^semantic.Semantica).tipos, tipo) {
        return vence
    }
    return lo_binario(k, frontend.OP_OU as u8, semantic.TIPO_BOOL as u32, vence, lo_binario(k, frontend.OP_DIFERENTE as u8, semantic.TIPO_BOOL as u32, melhor, melhor))
}

// C: ir/lower_estat.c:39
proc lw_min_max(c: ^LowerCtx, e: ^frontend.Expr) -> Valor {
    var k: LoCtx = LoCtx{c = c, pos = e.pos_op}
    var f: Fatia2 = fatia_do_argumento_2(&k, ll_argumento(e, 0))
    let t: u32 = f.base.elemento
    let resultado: i32 = lo_local(&k, e.tipo, lw_valor_nenhum())
    let fora: ^IrBloco = lo_entra_se(&k, lo_binario(&k, frontend.OP_MAIOR as u8, semantic.TIPO_BOOL as u32, f.n, lw_valor_int(0, semantic.TIPO_INT as u32)))
    let melhor: i32 = lo_local(&k, t, ll_le(&k, &f.base, lw_valor_int(0, semantic.TIPO_INT as u32), true))
    var externo: ?^IrBloco = none
    let volta: Valor = ll_entra_laco(&k, lw_valor_int(1, semantic.TIPO_INT as u32), f.n, &externo)
    let x: Valor = ll_le(&k, &f.base, volta, true)
    let troca: ^IrBloco = lo_entra_se(&k, vence(&k, e.ref_id == frontend.EMB_MIN_OF, t, x, lw_valor_local(melhor, t)))
    lo_atribui(&k, melhor, t, x)
    lo_sai_do_se(&k, troca)
    ll_sai_do_laco(&k, externo as ^IrBloco)
    lo_atribui(&k, resultado, e.tipo, ll_embrulha(&k, e.tipo, lw_valor_local(melhor, t)))
    lo_sai_do_se(&k, fora)
    return lw_valor_local(resultado, e.tipo)
}

// C: ir/lower_estat.c:60
proc lw_sum(c: ^LowerCtx, e: ^frontend.Expr) -> Valor {
    var k: LoCtx = LoCtx{c = c, pos = e.pos_op}
    var f: Fatia2 = fatia_do_argumento_2(&k, ll_argumento(e, 0))
    let soma: i32 = lo_local(&k, e.tipo, zero_de(&k, e.tipo))
    var externo: ?^IrBloco = none
    let volta: Valor = ll_entra_laco(&k, lw_valor_int(0, semantic.TIPO_INT as u32), f.n, &externo)
    let atual: Valor = lo_binario(&k, frontend.OP_SOMA as u8, e.tipo, lw_valor_local(soma, e.tipo), ll_le(&k, &f.base, volta, true))
    lo_atribui(&k, soma, e.tipo, atual)
    ll_sai_do_laco(&k, externo as ^IrBloco)
    return lw_valor_local(soma, e.tipo)
}

// C: ir/lower_estat.c:74
proc lw_avg(c: ^LowerCtx, e: ^frontend.Expr) -> Valor {
    var k: LoCtx = LoCtx{c = c, pos = e.pos_op}
    var f: Fatia2 = fatia_do_argumento_2(&k, ll_argumento(e, 0))
    let media: i32 = lo_local(&k, semantic.TIPO_F64 as u32, lw_valor_real(0.0, semantic.TIPO_F64 as u32))
    let fora: ^IrBloco = lo_entra_se(&k, lo_binario(&k, frontend.OP_MAIOR as u8, semantic.TIPO_BOOL as u32, f.n, lw_valor_int(0, semantic.TIPO_INT as u32)))
    let soma: i32 = lo_local(&k, semantic.TIPO_F64 as u32, lw_valor_real(0.0, semantic.TIPO_F64 as u32))
    var externo: ?^IrBloco = none
    let volta: Valor = ll_entra_laco(&k, lw_valor_int(0, semantic.TIPO_INT as u32), f.n, &externo)
    let x: Valor = lo_converte(&k, semantic.TIPO_F64 as u32, ll_le(&k, &f.base, volta, true))
    lo_atribui(&k, soma, semantic.TIPO_F64 as u32, lo_binario(&k, frontend.OP_SOMA as u8, semantic.TIPO_F64 as u32, lw_valor_local(soma, semantic.TIPO_F64 as u32), x))
    ll_sai_do_laco(&k, externo as ^IrBloco)
    lo_atribui(&k, media, semantic.TIPO_F64 as u32, lo_binario(&k, frontend.OP_DIV as u8, semantic.TIPO_F64 as u32, lw_valor_local(soma, semantic.TIPO_F64 as u32), lo_converte(&k, semantic.TIPO_F64 as u32, f.n)))
    lo_sai_do_se(&k, fora)
    return lw_valor_local(media, semantic.TIPO_F64 as u32)
}

// C: ir/lower_estat.c:91
proc lw_estat(c: ^LowerCtx, e: ^frontend.Expr) -> Valor {
    let sw_1 = e.ref_id
    if sw_1 == frontend.EMB_MIN_OF or sw_1 == frontend.EMB_MAX_OF {
        return lw_min_max(c, e)
    } else if sw_1 == frontend.EMB_SUM {
        return lw_sum(c, e)
    } else if sw_1 == frontend.EMB_AVG {
        return lw_avg(c, e)
    } else if sw_1 == frontend.EMB_KEYS or sw_1 == frontend.EMB_VALUES {
        return lw_vistas_do_mapa(c, e)
    } else if sw_1 == frontend.EMB_FROM_BYTES {
        return lw_texto_copia(c, e)
    } else if sw_1 == frontend.EMB_AS_BYTES {
        return lw_as_bytes(c, e)
    } else if sw_1 == frontend.EMB_TO_STR {
        return lw_to_str(c, e)
    } else {
        let msg_1 = format(f"lowering: embutido de estatistica desconhecido (offset {e.pos_op})", alloc = heap)
        defer delete(msg_1)
        common.falha_interna(msg_1)
    }
    return Valor{}
}
