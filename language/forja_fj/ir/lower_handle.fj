import "common"
import "frontend"
import "semantic"

// C: ir/lower_handle.c:12
proc handle_escalar(c: ^LowerCtx, tipo: u32) -> bool {
    let classe: i32 = semantic.tipo_classe_de(&(c.sem as ^semantic.Semantica).tipos, tipo)
    return (((common.c2f_b2i32(semantic.tipo_eh_inteiro(tipo)) != 0) or (common.c2f_s2u_32(classe) == (semantic.TC_PONTEIRO as u32))) or (common.c2f_s2u_32(classe) == (semantic.TC_ANULAVEL as u32))) or (common.c2f_s2u_32(classe) == (semantic.TC_RAWPTR as u32))
}

// C: ir/lower_handle.c:20
proc lw_lib_encerra(c: ^LowerCtx, proc_c: ^frontend.Decl, pos: u32) {
    if proc_c.posse_c != (frontend.POSSE_C_ENCERRA as u8) {
        return
    }
    let p_1 = lw_nova_instr(c, IR_LIB_ENCERRA, pos)
    var tern_1: i32 = proc_c.nome
    if proc_c.simbolo >= 0 {
        tern_1 = proc_c.simbolo
    }
    p_1.nome = tern_1
}

// C: ir/lower_handle.c:28
// C2F-INDECIDIVEL: args
proc lw_handle_solta(c: ^LowerCtx, proc_c: ^frontend.Decl, args: []Valor, pos: u32) {
    if (proc_c.posse_c != (frontend.POSSE_C_DESTROI as u8)) and (proc_c.posse_c != (frontend.POSSE_C_ENTREGA as u8)) {
        return
    }
    if not handle_escalar(c, (proc_c.params or_else {})[proc_c.posse_param].tipo.tipo) {
        return
    }
    let p_1 = lw_nova_instr(c, IR_HANDLE_SOLTA, pos)
    p_1.a = args[proc_c.posse_param]
}

// C: ir/lower_handle.c:38
// C2F-INDECIDIVEL: args
proc lw_handle_nasce(c: ^LowerCtx, proc_c: ^frontend.Decl, args: []Valor, chamada: ^IrInstr, pos: u32) {
    let retorno: bool = proc_c.posse_c == (frontend.POSSE_C_CRIA_RETORNO as u8)
    var tipo: u32 = 0
    var nasce: ?^IrInstr = none
    var destruidor: ?^frontend.Decl = none
    if (not retorno) and (proc_c.posse_c != (frontend.POSSE_C_CRIA_SAIDA as u8)) {
        return
    }
    var tern_1: u32 = 0
    if common.c2f_b2i32(retorno) != 0 {
        tern_1 = proc_c.retorno.tipo
    } else {
        tern_1 = semantic.tipo_de(&(c.sem as ^semantic.Semantica).tipos, (proc_c.params or_else {})[proc_c.posse_param].tipo.tipo).a
    }
    tipo = tern_1
    if (not handle_escalar(c, tipo)) or ((common.c2f_b2i32(retorno) != 0) and (chamada.destino < 0)) {
        return
    }
    nasce = lw_nova_instr(c, IR_HANDLE_NASCE, pos)
    let ptr_1: ^IrInstr = nasce as ^IrInstr
    var tern_2: i32 = proc_c.nome
    if proc_c.simbolo >= 0 {
        tern_2 = proc_c.simbolo
    }
    ptr_1.nome = tern_2
    let ptr_2: ^IrInstr = nasce as ^IrInstr
    var tern_3: i32 = 1
    if common.c2f_b2i32(retorno) != 0 {
        tern_3 = 0
    }
    ptr_2.op_aux = tern_3 as u8
    let ptr_3: ^IrInstr = nasce as ^IrInstr
    if common.c2f_b2i32(retorno) != 0 {
        ptr_3.a = lw_valor_temp(chamada.destino, chamada.tipo)
    } else {
        ptr_3.a = args[proc_c.posse_param]
    }
    destruidor = semantic.sem_destruidor_do_tipo(c.sem as ^semantic.Semantica, tipo)
    if destruidor != none {
        let ptr_4: ^IrInstr = nasce as ^IrInstr
        ptr_4.b = lw_valor_texto((destruidor as ^frontend.Decl).nome, semantic.TIPO_CSTR as u32)
    }
}
