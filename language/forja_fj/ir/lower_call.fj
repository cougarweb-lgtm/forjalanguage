pub const LOWER_EMBUTIDO_LOWER_PRINT: u16 = 1
pub const LOWER_EMBUTIDO_LOWER_ASSERT: u16 = 2
pub const LOWER_EMBUTIDO_LOWER_PANIC: u16 = 3
pub proc chamar_lower_embutido(tag: u16, c: ^LowerCtx, e: ^frontend.Expr) {
    if tag == 1 {
        lower_print(c, e)
        return
    }
    if tag == 2 {
        lower_assert(c, e)
        return
    }
    if tag == 3 {
        lower_panic(c, e)
        return
    }
    // tag fora de 1..3 nao existe no C (EMBUTIDOS); falha explicita
    let msg = format(f"lowering: embutido {tag} sem lowering de statement", alloc = heap)
    defer delete(msg)
    common.falha_interna(msg)
}

// C: ir/lower_call.c:49
proc instr_com_temp_2(c: ^LowerCtx, op: i32, e: ?^frontend.Expr, tipo: u32) -> ^IrInstr {
    let i: ^IrInstr = lw_nova_instr(c, op, (e as ^frontend.Expr).pos_op)
    i.destino = lw_novo_temp(c)
    i.tipo = tipo
    return i
}

// C: ir/lower_call.c:57
proc resultado_temp(i: ^IrInstr) -> Valor {
    return lw_valor_temp(i.destino, i.tipo)
}

// C: ir/lower_call.c:62
proc atribuir_local(c: ^LowerCtx, local: i32, v: Valor, pos: u32) {
    let i: ^IrInstr = lw_nova_instr(c, IR_ATRIBUICAO, pos)
    i.destino = local
    i.tipo = v.tipo
    i.a = v
}

// C: ir/lower_call.c:74
proc copiar_struct_local(c: ^LowerCtx, v: Valor, pos: u32) -> Valor {
    if (v.tipo_no != (V_LOCAL as u8)) or (common.c2f_s2u_32(semantic.tipo_classe_de(&(c.sem as ^semantic.Semantica).tipos, v.tipo)) != (semantic.TC_STRUCT as u32)) {
        return v
    }
    let i: ^IrInstr = lw_nova_instr(c, IR_LOCAL, pos)
    i.destino = lw_novo_local(c)
    i.tipo = v.tipo
    i.a = v
    return lw_valor_local(i.destino, v.tipo)
}

// C: ir/lower_call.c:85 (args na ordem do fonte, cada um no slot Arg.indice; nslots 0 = none, como o NULL do C)
proc avaliar_argumentos(c: ^LowerCtx, e: ?^frontend.Expr, nslots: u32) -> ?[]Valor {
    let ex: ^frontend.Expr = e as ^frontend.Expr
    let fatia = lw_args(c, nslots)
    let slots: []Valor = fatia or_else {}
    let args: []frontend.Arg = ex.args or_else {}
    for i in 0..<ex.nargs {
        let g: ^frontend.Arg = &args[i as int]
        if (g.indice < 0) or ((g.indice as u32) >= nslots) {
            let msg = format(f"lowering: argumento sem indice de parametro (offset {(g.valor as ^frontend.Expr).pos_op})", alloc = heap)
            defer delete(msg)
            common.falha_interna(msg)
        }
        let idx: int = g.indice as int
        slots[idx] = lw_expr(c, g.valor)
        if (i + 1) < ex.nargs {
            slots[idx] = copiar_struct_local(c, slots[idx], (g.valor as ^frontend.Expr).pos_op)
        }
    }
    return fatia
}

// C: ir/lower_call.c:99
proc usa_local_nos_argumentos(e: ?^frontend.Expr) -> bool {
    var i: u32 = 0
    while i < (e as ^frontend.Expr).nargs {
        if usa_variavel_local(((e as ^frontend.Expr).args or_else {})[i].valor) {
            return true
        }
        i += 1
    }
    return false
}

// C: ir/lower_call.c:108
proc usa_variavel_local(e: ?^frontend.Expr) -> bool {
    if e == none {
        return false
    }
    if (e as ^frontend.Expr).tipo_no == (frontend.EX_NOME as u8) {
        return ((e as ^frontend.Expr).ref == (frontend.REF_LOCAL as u8)) or ((e as ^frontend.Expr).ref == (frontend.REF_PARAM as u8))
    }
    return ((common.c2f_b2i32(usa_variavel_local((e as ^frontend.Expr).a)) != 0) or (common.c2f_b2i32(usa_variavel_local((e as ^frontend.Expr).b)) != 0)) or (common.c2f_b2i32(usa_local_nos_argumentos(e)) != 0)
}

// C: ir/lower_call.c:116
// C2F-INDECIDIVEL: slots
proc preencher_padroes(c: ^LowerCtx, proc_c: ^frontend.Decl, slots: []Valor, pos: u32) {
    if ((c.sem as ^semantic.Semantica).diag as ^common.Diag).tem {
        return
    }
    var k: u32 = 0
    while k < proc_c.nparams {
        let padrao: ?^frontend.Expr = (proc_c.params or_else {})[k].padrao
        if slots[k].tipo_no != (V_NENHUM as u8) {
            k += 1
            continue
        }
        if (padrao == none) or (common.c2f_b2i32(usa_variavel_local(padrao)) != 0) {
            let msg_1 = format(f"lowering: parametro {k} do proc sem valor nem padrao utilizavel (offset {pos})", alloc = heap)
            defer delete(msg_1)
            common.falha_interna(msg_1)
        }
        slots[k] = lw_expr(c, padrao)
        k += 1
    }
}

// C: ir/lower_call.c:131
proc lower_print(c: ^LowerCtx, e: ^frontend.Expr) {
    if ((e.args or_else {})[0].valor as ^frontend.Expr).tipo_no == (frontend.EX_FTEXTO as u8) {
        var formata: ?^IrInstr = none
        let arg_1: ^?^IrInstr = &formata
        let arg_2: Valor = lw_valor_int(0, semantic.TIPO_U32 as u32)
        let arg_3: ?^frontend.Expr = (e.args or_else {})[0].valor
        let arg_4: ^LowerCtx = c
        lw_formata(arg_4, arg_3, 0, arg_2, arg_1)
        return
    }
    let v: Valor = lw_expr(c, (e.args or_else {})[0].valor)
    let p_1 = lw_nova_instr(c, IR_IMPRIME, e.pos_op)
    p_1.a = v
}

// C: ir/lower_call.c:143
proc lower_e_print(c: ^LowerCtx, e: ^frontend.Expr) -> Valor {
    var formata: ?^IrInstr = none
    let arg_1: ^?^IrInstr = &formata
    let arg_2: Valor = lw_valor_int(0, semantic.TIPO_U32 as u32)
    let arg_3: ?^frontend.Expr = (e.args or_else {})[0].valor
    let arg_4: ^LowerCtx = c
    lw_formata(arg_4, arg_3, 3, arg_2, arg_1)
    return lw_valor_nenhum()
}

// C: ir/lower_call.c:151 (assert(cond, msg = ""): sem mensagem, texto vazio)
proc lower_assert(c: ^LowerCtx, e: ^frontend.Expr) {
    let fatia = avaliar_argumentos(c, e, 2)
    let slots: []Valor = fatia or_else {}
    let i: ^IrInstr = lw_nova_instr(c, IR_ASSERT, e.pos_op)
    i.a = slots[0]
    if slots[1].tipo_no == (V_NENHUM as u8) {
        let nomes: []common.Interner = (c.sem as ^semantic.Semantica).nomes or_else {}
        let vazio: i32 = common.internar(&nomes[0], "", 0)
        i.b = lw_valor_texto(vazio, semantic.TIPO_CSTR as u32)
    } else {
        i.b = slots[1]
    }
}

// C: ir/lower_call.c:159
proc lower_panic(c: ^LowerCtx, e: ^frontend.Expr) {
    let fatia = avaliar_argumentos(c, e, 1)
    let slots: []Valor = fatia or_else {}
    let i: ^IrInstr = lw_nova_instr(c, IR_PANIC, e.pos_op)
    i.a = slots[0]
}

// C: ir/lower_call.c:170
proc lower_transmute(c: ^LowerCtx, e: ^frontend.Expr) -> Valor {
    let origem: Valor = lw_expr(c, (e.args or_else {})[0].valor)
    let i: ^IrInstr = instr_com_temp_2(c, IR_TRANSMUTA, e, e.tipo)
    i.a = origem
    return resultado_temp(i)
}

// C: ir/lower_call.c:179
proc lower_len(c: ^LowerCtx, e: ^frontend.Expr) -> Valor {
    if ((e.args or_else {})[0].valor as ^frontend.Expr).tipo != (semantic.TIPO_TEXTO as u32) {
        return lw_tamanho_colecao(c, (e.args or_else {})[0].valor)
    }
    let texto: Valor = lw_expr(c, (e.args or_else {})[0].valor)
    let i: ^IrInstr = instr_com_temp_2(c, IR_TAMANHO_TEXTO, e, semantic.TIPO_INT as u32)
    i.a = texto
    return resultado_temp(i)
}

// C: ir/lower_call.c:189 (p ja e ponteiro; a quantidade i32 vira int; ordem de avaliacao: a do fonte)
proc lower_slice_from(c: ^LowerCtx, e: ^frontend.Expr) -> Valor {
    let fatia = avaliar_argumentos(c, e, 2)
    let slots: []Valor = fatia or_else {}
    var quantidade: Valor = slots[1]
    if (quantidade.tipo != (semantic.TIPO_INT as u32)) and (quantidade.tipo_no == (V_INT as u8)) {
        quantidade.tipo = semantic.TIPO_INT as u32
    } else if quantidade.tipo != (semantic.TIPO_INT as u32) {
        let conversao: ^IrInstr = instr_com_temp_2(c, IR_CONVERSAO, e, semantic.TIPO_INT as u32)
        conversao.a = quantidade
        quantidade = resultado_temp(conversao)
    }
    let i: ^IrInstr = instr_com_temp_2(c, IR_FATIA_DE_PONTEIRO, e, e.tipo)
    i.a = slots[0]
    i.b = quantidade
    return resultado_temp(i)
}

// C: ir/lower_call.c:207
proc lower_formato(c: ^LowerCtx, e: ^frontend.Expr) -> Valor {
    var i: ?^IrInstr = none
    if e.tipo == (semantic.TIPO_VAZIO as u32) {
        return lw_formato_into(c, e)
    }
    var tern_1: i32 = 2
    if e.ref_id == frontend.EMB_FORMAT {
        tern_1 = 1
    }
    let arg_1: ^?^IrInstr = &i
    let arg_2: Valor = lw_alocador(c, e)
    let arg_3: u8 = tern_1 as u8
    let arg_4: ?^frontend.Expr = (e.args or_else {})[0].valor
    let arg_5: ^LowerCtx = c
    lw_formata(arg_5, arg_4, arg_3, arg_2, arg_1)
    return resultado_temp(i as ^IrInstr)
}

// C: ir/lower_call.c:267 (EXATOS: id -> tag do tratador; 0 = sem tratador exato, o NULL do C)
proc tratador_exato(id: i32) -> u16 {
    if (id == frontend.EMB_FORMAT) or (id == frontend.EMB_FORMAT_C) {
        return TRATADOR_EMBUTIDO_LOWER_FORMATO
    }
    if id == frontend.EMB_SLICE_FROM {
        return TRATADOR_EMBUTIDO_LOWER_SLICE_FROM
    }
    if id == frontend.EMB_CONJ {
        return TRATADOR_EMBUTIDO_LW_CONJ_QUAT
    }
    if id == frontend.EMB_TRANSMUTE {
        return TRATADOR_EMBUTIDO_LOWER_TRANSMUTE
    }
    if id == frontend.EMB_LEN {
        return TRATADOR_EMBUTIDO_LOWER_LEN
    }
    if id == frontend.EMB_EPRINT {
        return TRATADOR_EMBUTIDO_LOWER_E_PRINT
    }
    if id == frontend.EMB_RESIZE {
        return TRATADOR_EMBUTIDO_LW_RESIZE
    }
    if id == frontend.EMB_SORT {
        return TRATADOR_EMBUTIDO_LW_SORT
    }
    if id == frontend.EMB_SORT_BY {
        return TRATADOR_EMBUTIDO_LW_SORT_BY
    }
    if id == frontend.EMB_SORT_BY_KEY {
        return TRATADOR_EMBUTIDO_LW_SORT_BY_KEY
    }
    if id == frontend.EMB_BINARY_SEARCH {
        return TRATADOR_EMBUTIDO_LW_BINARY_SEARCH
    }
    if id == frontend.EMB_SHUFFLE {
        return TRATADOR_EMBUTIDO_LW_SHUFFLE
    }
    if id == frontend.EMB_CHOICE {
        return TRATADOR_EMBUTIDO_LW_CHOICE
    }
    if id == frontend.EMB_DEDUP {
        return TRATADOR_EMBUTIDO_LW_DEDUP
    }
    if id == frontend.EMB_HEAP_PUSH {
        return TRATADOR_EMBUTIDO_LW_HEAP_PUSH
    }
    if id == frontend.EMB_HEAP_PUSH_BY {
        return TRATADOR_EMBUTIDO_LW_HEAP_PUSH_BY
    }
    if id == frontend.EMB_HEAP_POP {
        return TRATADOR_EMBUTIDO_LW_HEAP_POP
    }
    if id == frontend.EMB_HEAP_POP_BY {
        return TRATADOR_EMBUTIDO_LW_HEAP_POP_BY
    }
    if id == frontend.EMB_INDEX_BY {
        return TRATADOR_EMBUTIDO_LW_INDEX_BY
    }
    if id == frontend.EMB_FIND_BY {
        return TRATADOR_EMBUTIDO_LW_FIND_BY
    }
    if id == frontend.EMB_ANY_BY {
        return TRATADOR_EMBUTIDO_LW_ANY_BY
    }
    if id == frontend.EMB_ALL_BY {
        return TRATADOR_EMBUTIDO_LW_ALL_BY
    }
    if id == frontend.EMB_COUNT_BY {
        return TRATADOR_EMBUTIDO_LW_COUNT_BY
    }
    if id == frontend.EMB_SET_UNION {
        return TRATADOR_EMBUTIDO_LW_SET_UNION
    }
    if id == frontend.EMB_SET_INTERSECT {
        return TRATADOR_EMBUTIDO_LW_SET_INTERSECT
    }
    if id == frontend.EMB_SET_DIFF {
        return TRATADOR_EMBUTIDO_LW_SET_DIFF
    }
    return 0
}

// C: ir/lower_call.c:273 (FAIXAS: o 1o grupo cuja base <= id; a ordem da tabela e a do C)
proc tratador_da_faixa(id: i32) -> u16 {
    if id >= frontend.EMB_MIN_OF {
        return TRATADOR_EMBUTIDO_LW_ESTAT
    }
    if id >= frontend.EMB_CAP {
        return TRATADOR_EMBUTIDO_LW_LISTA
    }
    if id >= frontend.EMB_WRAPPING_ADD {
        return TRATADOR_EMBUTIDO_LW_ARITMETICA
    }
    if id >= frontend.EMB_MIN {
        return TRATADOR_EMBUTIDO_LW_MATEMATICA
    }
    if id >= frontend.EMB_SIZE_OF {
        return TRATADOR_EMBUTIDO_LW_LAYOUT_CHAMADA
    }
    if id >= frontend.EMB_INSERT {
        return TRATADOR_EMBUTIDO_LW_EMBUTIDO_V19
    }
    if id >= frontend.EMB_NEW {
        return TRATADOR_EMBUTIDO_LW_MEMORIA
    }
    return 0
}

// C: ir/lower_call.c:282
proc eh_abs_de_quat(c: ^LowerCtx, e: ?^frontend.Expr) -> bool {
    return (((e as ^frontend.Expr).ref_id == frontend.EMB_ABS) and ((c.sem as ^semantic.Semantica).tipo_quat != 0)) and ((((e as ^frontend.Expr).args or_else {})[0].valor as ^frontend.Expr).tipo == (c.sem as ^semantic.Semantica).tipo_quat)
}

// C: ir/lower_call.c:288
proc tratador_de(c: ^LowerCtx, e: ?^frontend.Expr) -> u16 {
    let ex: ^frontend.Expr = e as ^frontend.Expr
    let exato: u16 = tratador_exato(ex.ref_id)
    if exato != 0 {
        return exato
    }
    if eh_abs_de_quat(c, e) {
        return TRATADOR_EMBUTIDO_LW_ABS_QUAT
    }
    return tratador_da_faixa(ex.ref_id)
}

// C: ir/lower_call.c:296 (embutido com tratador -> tratador; print/assert/panic -> EMBUTIDOS; senao chamada de proc)
proc lw_chamada(c: ^LowerCtx, e: ?^frontend.Expr) -> Valor {
    let ex: ^frontend.Expr = e as ^frontend.Expr
    var tratador: u16 = 0
    if ex.ref == (frontend.REF_EMBUTIDO as u8) {
        tratador = tratador_de(c, e)
    }
    if tratador != 0 {
        return chamar_tratador_embutido(tratador, c, e)
    }
    // C: sizeof EMBUTIDOS / sizeof EMBUTIDOS[0] == 3 (print, assert, panic)
    if (ex.ref == (frontend.REF_EMBUTIDO as u8)) and (ex.ref_id >= 0) and (ex.ref_id < 3) {
        chamar_lower_embutido((ex.ref_id + 1) as u16, c, ex)
        return lw_valor_nenhum()
    }
    if ex.ref != (frontend.REF_PROC as u8) {
        let msg = format(f"lowering: chamada sem ligacao da semantica (offset {ex.pos_op})", alloc = heap)
        defer delete(msg)
        common.falha_interna(msg)
    }
    let procs: []?^frontend.Decl = c.procs or_else {}
    let proc_c: ^frontend.Decl = procs[ex.ref_id as int] as ^frontend.Decl
    let fatia_args = avaliar_argumentos(c, e, proc_c.nparams)
    let args: []Valor = fatia_args or_else {}
    preencher_padroes(c, proc_c, args, ex.pos_op)
    if proc_c.posse_c != (frontend.POSSE_C_NENHUMA as u8) {
        lw_handle_solta(c, proc_c, args, ex.pos_op)
    }
    let i: ^IrInstr = lw_nova_instr(c, IR_CHAMADA, ex.pos_op)
    i.nome = proc_c.chave
    i.tipo = ex.tipo
    i.args = fatia_args
    i.nargs = proc_c.nparams
    if ex.tipo != (semantic.TIPO_VAZIO as u32) {
        i.destino = lw_novo_temp(c)
    }
    if proc_c.posse_c != (frontend.POSSE_C_NENHUMA as u8) {
        lw_handle_nasce(c, proc_c, args, i, ex.pos_op)
        lw_lib_encerra(c, proc_c, ex.pos_op)
    }
    if ex.tipo == (semantic.TIPO_VAZIO as u32) {
        return lw_valor_nenhum()
    }
    return resultado_temp(i)
}

// C: ir/lower_call.c:323 (o chamado e avaliado antes dos argumentos; o tipo proc nao tem padrao)
proc lw_chamada_ind(c: ^LowerCtx, e: ?^frontend.Expr) -> Valor {
    let ex: ^frontend.Expr = e as ^frontend.Expr
    let proc_v: Valor = lw_expr(c, ex.a)
    let nparams: u32 = semantic.tipo_proc_qtd(&(c.sem as ^semantic.Semantica).tipos, (ex.a as ^frontend.Expr).tipo)
    let args: ?[]Valor = avaliar_argumentos(c, e, nparams)
    let i: ^IrInstr = lw_nova_instr(c, IR_CHAMADA_IND, ex.pos_op)
    i.a = proc_v
    i.tipo = ex.tipo
    i.args = args
    i.nargs = nparams
    if ex.tipo == (semantic.TIPO_VAZIO as u32) {
        return lw_valor_nenhum()
    }
    i.destino = lw_novo_temp(c)
    return resultado_temp(i)
}

test "lower_call: tratador exato segue a tabela EXATOS do C" {
    expect(tratador_exato(frontend.EMB_FORMAT) == TRATADOR_EMBUTIDO_LOWER_FORMATO)
    expect(tratador_exato(frontend.EMB_FORMAT_C) == TRATADOR_EMBUTIDO_LOWER_FORMATO)
    expect(tratador_exato(frontend.EMB_SET_DIFF) == TRATADOR_EMBUTIDO_LW_SET_DIFF)
    expect(tratador_exato(frontend.EMB_PRINT) == 0)
    expect(tratador_exato(frontend.EMB_NEW) == 0)
}

test "lower_call: usa variavel local segue UsaVariavelLocal do C" {
    var local = frontend.Expr{tipo_no = frontend.EX_NOME as u8, ref = frontend.REF_LOCAL as u8}
    var constante = frontend.Expr{tipo_no = frontend.EX_INT as u8}
    expect(usa_variavel_local(&local))
    expect(not usa_variavel_local(&constante))
    expect(not usa_variavel_local(none))
}

test "lower_call: tratador da faixa segue a ordem de FAIXAS do C" {
    expect(tratador_da_faixa(frontend.EMB_MIN_OF) == TRATADOR_EMBUTIDO_LW_ESTAT)
    expect(tratador_da_faixa(frontend.EMB_MIN) == TRATADOR_EMBUTIDO_LW_MATEMATICA)
    expect(tratador_da_faixa(frontend.EMB_SIZE_OF) == TRATADOR_EMBUTIDO_LW_LAYOUT_CHAMADA)
    expect(tratador_da_faixa(frontend.EMB_NEW) == TRATADOR_EMBUTIDO_LW_MEMORIA)
    expect(tratador_da_faixa(-1) == 0)
}

// C: ir/lower_call.c:342
proc retornar_erro(c: ^LowerCtx, e: ?^frontend.Expr, resultado: Valor) {
    let erro: ^IrInstr = instr_com_temp_2(c, IR_RES_ERRO_DE, e, semantic.tipo_de(&(c.sem as ^semantic.Semantica).tipos, ((e as ^frontend.Expr).a as ^frontend.Expr).tipo).b)
    erro.a = resultado
    lw_expandir_defers(c, 0)
    let novo: ^IrInstr = instr_com_temp_2(c, IR_RES_ERRO, e, (c.decl as ^frontend.Decl).retorno.tipo)
    novo.a = resultado_temp(erro)
    let ptr_1: ^frontend.Expr = e as ^frontend.Expr
    let p_1 = lw_nova_instr(c, IR_RETORNA, ptr_1.pos_op)
    p_1.a = resultado_temp(novo)
}

// C: ir/lower_call.c:352
proc lw_try(c: ^LowerCtx, e: ?^frontend.Expr) -> Valor {
    let resultado: Valor = lw_expr(c, (e as ^frontend.Expr).a)
    let e_erro: ^IrInstr = instr_com_temp_2(c, IR_RES_E_ERRO, e, semantic.TIPO_BOOL as u32)
    e_erro.a = resultado
    let se: ^IrInstr = lw_nova_instr(c, IR_SE, (e as ^frontend.Expr).pos_op)
    se.a = resultado_temp(e_erro)
    let anterior: ^IrBloco = lw_trocar_bloco(c, &se.corpo)
    retornar_erro(c, e, resultado)
    _ = lw_trocar_bloco(c, anterior)
    if (e as ^frontend.Expr).tipo == (semantic.TIPO_VAZIO as u32) {
        return lw_valor_nenhum()
    }
    let valor: ^IrInstr = instr_com_temp_2(c, IR_RES_VALOR, e, (e as ^frontend.Expr).tipo)
    valor.a = resultado
    return resultado_temp(valor)
}

// C: ir/lower_call.c:372
proc lw_or_else(c: ^LowerCtx, e: ^frontend.Expr) -> Valor {
    let resultado: Valor = lw_expr(c, e.a)
    let opcional: bool = common.c2f_s2u_32(semantic.tipo_classe_de(&(c.sem as ^semantic.Semantica).tipos, (e.a as ^frontend.Expr).tipo)) != (semantic.TC_RESULTADO as u32)
    let local: i32 = lw_novo_local(c)
    let def: ^IrInstr = lw_nova_instr(c, IR_LOCAL, e.pos_op)
    def.destino = local
    def.tipo = e.tipo
    def.mutavel = true
    var tern_1: i32 = IR_RES_E_ERRO
    if common.c2f_b2i32(opcional) != 0 {
        tern_1 = IR_OPC_TEM
    }
    let e_erro: ^IrInstr = instr_com_temp_2(c, tern_1, e, semantic.TIPO_BOOL as u32)
    e_erro.a = resultado
    if opcional {
        e_erro.op_aux = 1
    }
    let se: ^IrInstr = lw_nova_instr(c, IR_SE, e.pos_op)
    se.a = resultado_temp(e_erro)
    let anterior: ^IrBloco = lw_trocar_bloco(c, &se.corpo)
    let arg_1: u32 = e.pos_op
    let arg_2: Valor = lw_expr(c, e.b)
    let arg_3: i32 = local
    let arg_4: ^LowerCtx = c
    atribuir_local(arg_4, arg_3, arg_2, arg_1)
    _ = lw_trocar_bloco(c, &se.senao)
    var tern_2: i32 = IR_RES_VALOR
    if common.c2f_b2i32(opcional) != 0 {
        tern_2 = IR_OPC_VALOR
    }
    let valor: ^IrInstr = instr_com_temp_2(c, tern_2, e, e.tipo)
    valor.a = resultado
    let arg_5: u32 = e.pos_op
    let arg_6: Valor = resultado_temp(valor)
    let arg_7: i32 = local
    let arg_8: ^LowerCtx = c
    atribuir_local(arg_8, arg_7, arg_6, arg_5)
    _ = lw_trocar_bloco(c, anterior)
    return lw_valor_local(local, e.tipo)
}
