import "common"
import "frontend"
import "semantic"

// C2F-82 macro de funcao INT_VALOR ( n ) LwValorInt ( ( n ) , TIPO_INT )

// C: ir/lower_mapa_vistas.c:16
proc base_do_mapa(c: ^LowerCtx, e: ?^frontend.Expr) -> Valor {
    if common.c2f_s2u_32(semantic.tipo_classe_de(&(c.sem as ^semantic.Semantica).tipos, (e as ^frontend.Expr).tipo)) == (semantic.TC_PONTEIRO as u32) {
        return lw_expr(c, e)
    }
    var tern_1: Valor = Valor{}
    if common.c2f_b2i32(lw_enderecavel(c, e)) != 0 {
        tern_1 = lw_endereco(c, e)
    } else {
        tern_1 = lw_expr(c, e)
    }
    return tern_1
}

// C: ir/lower_mapa_vistas.c:23
proc mapa_do_tipo_2(c: ^LowerCtx, t: u32) -> u32 {
    var tern_1: u32 = t
    if common.c2f_s2u_32(semantic.tipo_classe_de(&(c.sem as ^semantic.Semantica).tipos, t)) == (semantic.TC_PONTEIRO as u32) {
        tern_1 = semantic.tipo_de(&(c.sem as ^semantic.Semantica).tipos, t).a
    }
    return tern_1
}

// C: ir/lower_mapa_vistas.c:29
proc item_do_mapa_2(k: ^LoCtx, op_aux: u8, tipo: u32, base: Valor, indice: Valor) -> Valor {
    let i: ^IrInstr = lw_nova_instr(k.c as ^LowerCtx, IR_MAPA_ITEM, k.pos)
    i.op_aux = op_aux
    i.tipo = tipo
    i.a = base
    i.b = indice
    i.destino = lw_novo_temp(k.c as ^LowerCtx)
    return lw_valor_temp(i.destino, tipo)
}

// C: ir/lower_mapa_vistas.c:41
proc lw_vistas_do_mapa(c: ^LowerCtx, e: ^frontend.Expr) -> Valor {
    var k: LoCtx = LoCtx{c = c, pos = e.pos_op}
    var externo: ?^IrBloco = none
    let chaves: bool = e.ref_id == frontend.EMB_KEYS
    let base: Valor = base_do_mapa(c, ll_argumento(e, 0))
    let n: Valor = ll_tamanho(&k, base)
    let elemento: u32 = semantic.tipo_de(&(c.sem as ^semantic.Semantica).tipos, e.tipo).a
    let cria: ^IrInstr = lw_nova_instr(c, IR_LISTA_CRIA, e.pos_op)
    cria.destino = lw_novo_temp(c)
    cria.tipo = e.tipo
    cria.a = lw_alocador(c, e)
    cria.b = n
    let lista: i32 = lo_local(&k, e.tipo, lw_valor_temp(cria.destino, e.tipo))
    let endereco: ^IrInstr = lw_nova_instr(c, IR_UNARIO, e.pos_op)
    endereco.destino = lw_novo_temp(c)
    endereco.tipo = semantic.tipo_ponteiro(&(c.sem as ^semantic.Semantica).tipos, e.tipo)
    endereco.op_aux = frontend.OP_ENDERECO as u8
    endereco.a = lw_valor_local(lista, e.tipo)
    let volta: Valor = ll_entra_laco(&k, lw_valor_int(0, semantic.TIPO_INT as u32), n, &externo)
    var op_item: u8 = 1
    if chaves {
        op_item = 0
    }
    let item: Valor = item_do_mapa_2(&k, op_item, elemento, base, volta)
    let anexa: ^IrInstr = lw_nova_instr(c, IR_ANEXA, e.pos_op)
    anexa.tipo = elemento
    anexa.a = lw_valor_temp(endereco.destino, endereco.tipo)
    anexa.b = item
    ll_sai_do_laco(&k, externo as ^IrBloco)
    return lw_valor_local(lista, e.tipo)
}

// C: ir/lower_mapa_vistas.c:71
proc lw_clear_mapa(c: ^LowerCtx, e: ^frontend.Expr) -> Valor {
    var k: LoCtx = LoCtx{c = c, pos = e.pos_op}
    var externo: ?^IrBloco = none
    let mapa: Valor = base_do_mapa(c, ll_argumento(e, 0))
    let tipo_mapa: u32 = mapa_do_tipo_2(c, (ll_argumento(e, 0) as ^frontend.Expr).tipo)
    let tipo_chave: u32 = semantic.tipo_de(&(c.sem as ^semantic.Semantica).tipos, tipo_mapa).a
    let tipo_valor: u32 = semantic.tipo_de(&(c.sem as ^semantic.Semantica).tipos, tipo_mapa).b
    let n: Valor = ll_tamanho(&k, mapa)
    let volta: Valor = ll_entra_laco(&k, lw_valor_int(0, semantic.TIPO_INT as u32), n, &externo)
    let ultimo: Valor = ll_menos(&k, ll_menos(&k, n, lw_valor_int(1, semantic.TIPO_INT as u32)), volta)
    let chave: Valor = item_do_mapa_2(&k, 0, tipo_chave, mapa, ultimo)
    let tira: ^IrInstr = lw_nova_instr(c, IR_MAPA_REMOVE, e.pos_op)
    tira.tipo = tipo_valor
    tira.a = mapa
    tira.b = chave
    ll_sai_do_laco(&k, externo as ^IrBloco)
    return lw_valor_nenhum()
}
