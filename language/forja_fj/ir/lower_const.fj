// C2F:? tabela OPERACOES_INTEIRAS (const OperacaoInteira[5]): folha nao escalar {'ref': 'InteiroSoma'}
// C2F:? tabela OPERACOES_SEM_SINAL (const OperacaoSemSinal[5]): folha nao escalar {'ref': 'SemSinalSoma'}
// C2F:? tabela OPERACOES_REAIS (const OperacaoReal[4]): folha nao escalar {'ref': 'RealSoma'}
// C2F:? tabela OPERACOES_REAIS64 (const OperacaoReal64[4]): folha nao escalar {'ref': 'Real64Soma'}
// C2F:? tabela ORDENS_ACEITAS (const uint8_t[6]): folha nao escalar {'txt': '[ OP_IGUAL - OP_IGUAL ] = 2'}
// C2F:? tabela DOBRAS (const DobraNo[23]): folha nao escalar {'txt': '[ EX_INT ] = DobrarLiteralIntei

pub const DOBRA_NO_DOBRAR_LITERAL_INTEIRO: u16 = 1
pub const DOBRA_NO_DOBRAR_LITERAL_REAL: u16 = 2
pub const DOBRA_NO_DOBRAR_LITERAL_BOOL: u16 = 3
pub const DOBRA_NO_DOBRAR_LITERAL_TEXTO: u16 = 4
pub const DOBRA_NO_DOBRAR_NOME: u16 = 5
pub const DOBRA_NO_DOBRAR_CAMPO: u16 = 6
pub const DOBRA_NO_DOBRAR_CHAMADA: u16 = 7
pub const DOBRA_NO_DOBRAR_UNARIO: u16 = 8
pub const DOBRA_NO_DOBRAR_BINARIO: u16 = 9
pub const DOBRA_NO_DOBRAR_CONVERSAO: u16 = 10
pub proc chamar_dobra_no(tag: u16, c: ^LowerCtx, e: ^frontend.Expr, saida: ^Valor) -> bool {
    if tag == 1 {
        return dobrar_literal_inteiro(c, e, saida)
    }
    if tag == 2 {
        return dobrar_literal_real(c, e, saida)
    }
    if tag == 3 {
        return dobrar_literal_bool(c, e, saida)
    }
    if tag == 4 {
        return dobrar_literal_texto(c, e, saida)
    }
    if tag == 5 {
        return dobrar_nome(c, e, saida)
    }
    if tag == 6 {
        return dobrar_campo(c, e, saida)
    }
    if tag == 7 {
        return dobrar_chamada(c, e, saida)
    }
    if tag == 8 {
        return dobrar_unario(c, e, saida)
    }
    if tag == 9 {
        return dobrar_binario(c, e, saida)
    }
    if tag == 10 {
        return dobrar_conversao(c, e, saida)
    }
    common.falha_interna("lowering: tag de dobra de no desconhecida")
    return false
}

pub const OPERACAO_INTEIRA_INTEIRO_SOMA: u16 = 1
pub const OPERACAO_INTEIRA_INTEIRO_SUB: u16 = 2
pub const OPERACAO_INTEIRA_INTEIRO_MUL: u16 = 3
