// C: ir/lower_const.c:35
proc tipo_anotado(e: ^frontend.Expr) -> u32 {
    if e.tipo == (frontend.TIPO_NAO_RESOLVIDO as u32) {
        let msg_1 = format(f"lowering: expressao sem tipo (offset {e.pos_op})", alloc = heap)
        defer delete(msg_1)
        common.falha_interna(msg_1)
    }
    return e.tipo
}

// C: ir/lower_const.c:42
proc estouro(c: ^LowerCtx, e: ?^frontend.Expr) -> bool {
    let no: ^frontend.Expr = e as ^frontend.Expr
    let diag: ^common.Diag = (c.sem as ^semantic.Semantica).diag as ^common.Diag
    if diag.tem {
        return false
    }
    if semantic.tipo_eh_inteiro(no.tipo) {
        let nome: str = semantic.tipo_nome_fixo(no.tipo) or_else ""
        let minimo: i64 = semantic.tipo_inteiro_min(no.tipo)
        let maximo: u64 = semantic.tipo_inteiro_max(no.tipo)
        let msg = format(f"o valor constante nao cabe no tipo {nome} ({minimo}..={maximo})", alloc = heap)
        defer delete(msg)
        _ = common.diag_relatar(diag, common.E0420, no.pos_op, msg)
        return false
    }
    var nome_real: str = "f32"
    if no.tipo == (semantic.TIPO_F64 as u32) {
        nome_real = "f64"
    }
    let msg_real = format(f"o valor constante nao cabe no tipo {nome_real}", alloc = heap)
    defer delete(msg_real)
    _ = common.diag_relatar(diag, common.E0420, no.pos_op, msg_real)
    return false
}

// Finito como std:math.is_finite: inf e NaN falham em x - x == 0 (C: isfinite).
proc dobra_real_finito(x: f64) -> bool {
    return x - x == 0.0
}

// C: ir/lower_const.c:56
proc mascara_da_largura(largura: u8) -> u64 {
    var tern_1: u64 = (1 << (common.c2f_s2u_64((largura as i32) as i64) & 63)) - 1
    if (largura as i32) >= 64 {
        tern_1 = 18446744073709551615
    }
    return tern_1
}

// C: ir/lower_const.c:64
proc dobrar_literal_inteiro(c: ^LowerCtx, e: ^frontend.Expr, saida: ^Valor) -> bool {
    var mag: u64 = 0
    let tipo: u32 = tipo_anotado(e)
    if e.ref == (frontend.REF_COMPONENTE as u8) {
        saida^ = lw_valor_int(e.ref_id as i64, tipo)
        return true
    }
    let fonte: ^common.Fonte = (c.sem as ^semantic.Semantica).fonte as ^common.Fonte
    let digitos: []u8 = fonte.texto[(e.pos_op as int)..<len(fonte.texto)]
    if semantic.tipo_eh_real(&(c.sem as ^semantic.Semantica).tipos, tipo) {
        if not semantic.tipo_ler_literal_u64(digitos, &mag) {
            return estouro(c, e)
        }
        var valor_real: f64 = (mag as f32) as f64
        if tipo == (semantic.TIPO_F64 as u32) {
            valor_real = mag as f64
        }
        saida^ = lw_valor_real(valor_real, tipo)
        return true
    }
    if (not semantic.tipo_ler_literal_u64(digitos, &mag)) or (not semantic.tipo_inteiro_cabe(tipo, false, mag)) {
        return estouro(c, e)
    }
    saida^ = lw_valor_int(transmute(mag, to = i64), tipo)
    return true
}

// F2: o C chama strtod no ponteiro do literal (custo do literal); copiar o resto do arquivo por literal real era O(arquivo) (12-14% do tempo no corpus_200000).
// Devolve o fim do maior prefixo, a partir de `de`, feito so de caracteres que o strtod pode consumir num numero ([0-9A-Za-z_.+-]); o strtod ja para no 1o
// caractere invalido, entao o resultado e o mesmo de passar o resto do arquivo.
proc fim_do_prefixo_numerico(texto: []u8, de: int) -> int {
    var k: int = de
    while k < len(texto) {
        let b: u8 = texto[k]
        let digito = b >= 48 and b <= 57
        let letra = (b >= 65 and b <= 90) or (b >= 97 and b <= 122)
        if not (digito or letra or b == 95 or b == 46 or b == 43 or b == 45) {
            break
        }
        k += 1
    }
    return k
}

test "fim_do_prefixo_numerico_limita_o_literal" {
    let fonte = as_bytes("x = 1.5e-3 + 2.0\n")
    expect(fim_do_prefixo_numerico(fonte, 4) == 10)
    let colado = as_bytes("1.0-2.0)")
    expect(fim_do_prefixo_numerico(colado, 0) == 7)
    let no_fim = as_bytes("a 3.25")
    expect(fim_do_prefixo_numerico(no_fim, 2) == 6)
}

// C: ir/lower_const.c:84
proc dobrar_literal_real(c: ^LowerCtx, e: ^frontend.Expr, saida: ^Valor) -> bool {
    let tipo: u32 = tipo_anotado(e)
    let fonte: ^common.Fonte = (c.sem as ^semantic.Semantica).fonte as ^common.Fonte
    let texto: str = from_bytes(fonte.texto[(e.pos_op as int)..<fim_do_prefixo_numerico(fonte.texto[..], e.pos_op as int)], alloc = heap)
    defer delete(texto)
    var fim: int = 0
    var v: f64 = common.c2f_strtod(texto, &fim)
    if tipo != (semantic.TIPO_F64 as u32) {
        v = (v as f32) as f64
    }
    if not dobra_real_finito(v) {
        return estouro(c, e)
    }
    saida^ = lw_valor_real(v, tipo)
    return true
}

// C: ir/lower_const.c:95
proc dobrar_literal_bool(c: ^LowerCtx, e: ^frontend.Expr, saida: ^Valor) -> bool {
    saida^ = lw_valor_bool(e.op != 0)
    return true
}

// C: ir/lower_const.c:103
proc dobrar_literal_texto(c: ^LowerCtx, e: ^frontend.Expr, saida: ^Valor) -> bool {
    let arg_1: u32 = e.tipo
    let arg_2: i32 = lw_texto_decodificado(c, e)
    saida^ = lw_valor_texto(arg_2, arg_1)
    return true
}

// C: ir/lower_const.c:109
proc dobrar_nome(c: ^LowerCtx, e: ^frontend.Expr, saida: ^Valor) -> bool {
    if (e.ref != (frontend.REF_CONST as u8)) or (not (c.const_escalar or_else {})[e.ref_id]) {
        return false
    }
    saida^ = (c.const_valor or_else {})[e.ref_id]
    return true
}

// C: ir/lower_const.c:116
proc dobrar_campo(c: ^LowerCtx, e: ^frontend.Expr, saida: ^Valor) -> bool {
    if e.ref != (frontend.REF_MEMBRO as u8) {
        return false
    }
    let arg_1: u32 = tipo_anotado(e)
    let arg_2: i64 = e.ref_id as i64
    saida^ = lw_valor_int(arg_2, arg_1)
    return true
}

// C: ir/lower_const.c:125
proc dobrar_chamada(c: ^LowerCtx, e: ^frontend.Expr, saida: ^Valor) -> bool {
    var valor: i64 = 0
    if ((e.ref != (frontend.REF_EMBUTIDO as u8)) or (e.ref_id < frontend.EMB_SIZE_OF)) or (e.ref_id > frontend.EMB_OFFSET_OF) {
        return false
    }
    if not lw_layout_valor(c, e, &valor) {
        return false
    }
    saida^ = lw_valor_int(valor, semantic.TIPO_INT as u32)
    return true
}

// C: ir/lower_const.c:136
proc dobrar_negacao(c: ^LowerCtx, e: ^frontend.Expr, a: Valor, saida: ^Valor) -> bool {
    if a.tipo_no == (V_REAL as u8) {
        var tern_1: f64 = (-(a.real as f32)) as f64
        if a.tipo == (semantic.TIPO_F64 as u32) {
            tern_1 = -a.real
        }
        saida^ = lw_valor_real(tern_1, a.tipo)
        return true
    }
    if semantic.tipo_eh_sem_sinal(a.tipo) {
        if a.inteiro != 0 {
            return estouro(c, e)
        }
        saida^ = lw_valor_int(0, a.tipo)
        return true
    }
    if (a.inteiro == ((-9223372036854775807) - 1)) or (not semantic.tipo_bits_cabem(a.tipo, -a.inteiro)) {
        return estouro(c, e)
    }
    saida^ = lw_valor_int(-a.inteiro, a.tipo)
    return true
}

// C: ir/lower_const.c:153
proc dobrar_literal_negado(c: ^LowerCtx, e: ^frontend.Expr, saida: ^Valor) -> bool {
    var mag: u64 = 0
    let tipo: u32 = tipo_anotado(e)
    let literal: ^frontend.Expr = e.a as ^frontend.Expr
    let fonte: ^common.Fonte = (c.sem as ^semantic.Semantica).fonte as ^common.Fonte
    let digitos: []u8 = fonte.texto[(literal.pos_op as int)..<len(fonte.texto)]
    if (not semantic.tipo_ler_literal_u64(digitos, &mag)) or (not semantic.tipo_inteiro_cabe(tipo, true, mag)) {
        return estouro(c, e)
    }
    saida^ = lw_valor_int(transmute(wrapping_sub(0 as u64, mag), to = i64), tipo)
    return true
}

// C: ir/lower_const.c:163
proc dobrar_unario(c: ^LowerCtx, e: ^frontend.Expr, saida: ^Valor) -> bool {
    var a: Valor = Valor{}
    if ((e.op == (frontend.OP_NEGAR as u8)) and ((e.a as ^frontend.Expr).tipo_no == (frontend.EX_INT as u8))) and (common.c2f_b2i32(semantic.tipo_eh_inteiro(e.tipo)) != 0) {
        return dobrar_literal_negado(c, e, saida)
    }
    if (((e.op != (frontend.OP_NEGAR as u8)) and (e.op != (frontend.OP_NAO as u8))) and (e.op != (frontend.OP_BIT_NAO as u8))) or (not dobrar_no(c, e.a, &a)) {
        return false
    }
    if e.op == (frontend.OP_NAO as u8) {
        saida^ = lw_valor_bool(a.inteiro == 0)
        return true
    }
    if e.op == (frontend.OP_BIT_NAO as u8) {
        let arg_1: u32 = a.tipo
        let arg_2: i64 = transmute((~common.c2f_s2u_64(a.inteiro)) & mascara_da_largura(semantic.tipo_largura_bits(&(c.sem as ^semantic.Semantica).tipos, a.tipo)), to = i64)
        saida^ = lw_valor_int(arg_2, arg_1)
        return true
    }
    return dobrar_negacao(c, e, a, saida)
}

// C: ir/lower_const.c:181
proc inteiro_soma(x: i64, y: i64, r: ^i64) -> bool {
    let soma: ?i64 = checked_add(x, y)
    if soma == none {
        return false
    }
    r^ = soma or_else 0
    return true
}

// C: ir/lower_const.c:182
proc inteiro_sub(x: i64, y: i64, r: ^i64) -> bool {
    let diferenca: ?i64 = checked_sub(x, y)
    if diferenca == none {
        return false
    }
    r^ = diferenca or_else 0
    return true
}

// C: ir/lower_const.c:183
proc inteiro_mul(x: i64, y: i64, r: ^i64) -> bool {
    let produto: ?i64 = checked_mul(x, y)
    if produto == none {
        return false
    }
    r^ = produto or_else 0
    return true
}

// C: ir/lower_const.c:185
proc inteiro_div(x: i64, y: i64, r: ^i64) -> bool {
    if y == 0 {
        r^ = 0
    } else if (x == ((-9223372036854775807) - 1)) and (y == -1) {
        return false
    } else {
        r^ = x / y
    }
    return true
}

// C: ir/lower_const.c:193
proc inteiro_resto(x: i64, y: i64, r: ^i64) -> bool {
    // C: o ternario so calcula x % y fora de y == 0 e y == -1 (a Forja trapa na divisao por zero)
    var resto: i64 = 0
    if (y != 0) and (y != -1) {
        resto = x % y
    }
    r^ = resto
    return true
}

// C: ir/lower_const.c:199
proc sem_sinal_soma(x: u64, y: u64, r: ^u64) -> bool {
    let soma: ?u64 = checked_add(x, y)
    if soma == none {
        return false
    }
    r^ = soma or_else 0
    return true
}

// C: ir/lower_const.c:200
proc sem_sinal_sub(x: u64, y: u64, r: ^u64) -> bool {
    // 0 - 1 estoura: o checked_sub recusa, como o __builtin_sub_overflow do C
    let diferenca: ?u64 = checked_sub(x, y)
    if diferenca == none {
        return false
    }
    r^ = diferenca or_else 0
    return true
}

// C: ir/lower_const.c:201
proc sem_sinal_mul(x: u64, y: u64, r: ^u64) -> bool {
    let produto: ?u64 = checked_mul(x, y)
    if produto == none {
        return false
    }
    r^ = produto or_else 0
    return true
}

// C: ir/lower_const.c:203
proc sem_sinal_div(x: u64, y: u64, r: ^u64) -> bool {
    // C: y == 0 da 0 sem dividir (a Forja trapa na divisao por zero)
    var quociente: u64 = 0
    if y != 0 {
        quociente = x / y
    }
    r^ = quociente
    return true
}

// C: ir/lower_const.c:209
proc sem_sinal_resto(x: u64, y: u64, r: ^u64) -> bool {
    // C: y == 0 da 0 sem dividir (a Forja trapa na divisao por zero)
    var resto: u64 = 0
    if y != 0 {
        resto = x % y
    }
    r^ = resto
    return true
}

