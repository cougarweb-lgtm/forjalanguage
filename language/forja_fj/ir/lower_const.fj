pub proc chamar_operacao_inteira(tag: u16, x: i64, y: i64, r: ^i64) -> bool {
    if tag == 1 {
        return inteiro_soma(x, y, r)
    }
    if tag == 2 {
        return inteiro_sub(x, y, r)
    }
    if tag == 3 {
        return inteiro_mul(x, y, r)
    }
    if tag == 4 {
        return inteiro_div(x, y, r)
    }
    if tag == 5 {
        return inteiro_resto(x, y, r)
    }
    common.falha_interna("lowering: tag de operacao inteira desconhecida")
    return false
}

