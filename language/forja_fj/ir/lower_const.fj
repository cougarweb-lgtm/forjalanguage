// C: ir/lower_const.c:231
proc dobrar_aritmetica_inteira(c: ^LowerCtx, e: ^frontend.Expr, a: Valor, b: Valor, saida: ^Valor) -> bool {
    let tipo: u32 = tipo_anotado(e)
    let tag: u16 = (((e.op as i32) - frontend.OP_SOMA) + 1) as u16
    var r: i64 = 0
    if semantic.tipo_eh_sem_sinal(tipo) {
        var ru: u64 = 0
        if not chamar_operacao_sem_sinal(tag, common.c2f_s2u_64(a.inteiro), common.c2f_s2u_64(b.inteiro), &ru) {
            return estouro(c, e)
        }
        r = transmute(ru, to = i64)
    } else if not chamar_operacao_inteira(tag, a.inteiro, b.inteiro, &r) {
        return estouro(c, e)
    }
    if not semantic.tipo_bits_cabem(tipo, r) {
        return estouro(c, e)
    }
    saida^ = lw_valor_int(r, tipo)
    return true
}

// C: ir/lower_const.c:248
proc dobrar_aritmetica_real(c: ^LowerCtx, e: ^frontend.Expr, a: Valor, b: Valor, saida: ^Valor) -> bool {
    let tipo: u32 = tipo_anotado(e)
    if (e.op as i32) > frontend.OP_DIV {
        return false
    }
    if ((e.op as i32) == frontend.OP_DIV) and (b.real == 0.0) {
        // divisao real por zero constante nao dobra: a mensagem diz o que escrever no lugar
        let diag: ^common.Diag = (c.sem as ^semantic.Semantica).diag as ^common.Diag
        if not diag.tem {
            _ = common.diag_relatar(diag, common.E0420, e.pos_op, "divisao real por zero numa constante; use math.inf()/math.nan() ou um divisor variavel")
        }
        return false
    }
    let tag: u16 = (((e.op as i32) - frontend.OP_SOMA) + 1) as u16
    var r: f64 = 0.0
    if tipo == (semantic.TIPO_F64 as u32) {
        r = chamar_operacao_real64(tag, a.real, b.real)
    } else {
        r = chamar_operacao_real(tag, a.real as f32, b.real as f32) as f64
    }
    if not dobra_real_finito(r) {
        return estouro(c, e)
    }
    saida^ = lw_valor_real(r, tipo)
    return true
}

// C: ir/lower_const.c:268
proc dobrar_bits(c: ^LowerCtx, e: ^frontend.Expr, a: Valor, b: Valor, saida: ^Valor) -> bool {
    let tipo: u32 = tipo_anotado(e)
    let largura: u8 = semantic.tipo_largura_bits(&(c.sem as ^semantic.Semantica).tipos, tipo)
    let x: u64 = common.c2f_s2u_64(a.inteiro)
    let y: u64 = common.c2f_s2u_64(b.inteiro)
    var r: u64 = 0
    let sw_1 = e.op as i32
    if sw_1 == frontend.OP_BIT_E {
        r = x & y
    } else if sw_1 == frontend.OP_BIT_OU {
        r = x | y
    } else if sw_1 == frontend.OP_BIT_XOU {
        r = x ~ y
    } else if sw_1 == frontend.OP_DESLOCA_ESQ {
        var tern_1: u64 = 0
        if y >= (largura as u64) {
            tern_1 = 0
        } else {
            tern_1 = (x << (y & 63)) & mascara_da_largura(largura)
        }
        r = tern_1
    } else {
        var tern_2: u64 = x >> (y & 63)
        if y >= (largura as u64) {
            tern_2 = 0
        }
        r = tern_2
    }
    saida^ = lw_valor_int(transmute(r, to = i64), tipo)
    return true
}

// C: ir/lower_const.c:286
proc ordem_de(a: Valor, b: Valor) -> i32 {
    if a.tipo_no == (V_REAL as u8) {
        return common.c2f_b2i32(a.real > b.real) - common.c2f_b2i32(a.real < b.real)
    }
    if semantic.tipo_eh_sem_sinal(a.tipo) {
        return common.c2f_b2i32(common.c2f_s2u_64(a.inteiro) > common.c2f_s2u_64(b.inteiro)) - common.c2f_b2i32(common.c2f_s2u_64(a.inteiro) < common.c2f_s2u_64(b.inteiro))
    }
    return common.c2f_b2i32(a.inteiro > b.inteiro) - common.c2f_b2i32(a.inteiro < b.inteiro)
}

// C: ir/lower_const.c:303
proc dobrar_comparacao(op: u8, a: Valor, b: Valor) -> Valor {
    // ORDENS_ACEITAS indexada por op - OP_IGUAL: bit (ordem + 1) diz se a comparacao vale naquela ordem
    let ordens: [6]u8 = {2, 5, 1, 3, 4, 6}
    let indice: i32 = (op as i32) - frontend.OP_IGUAL
    let ordem: i32 = ordem_de(a, b)
    let mascara: u32 = ordens[indice as int] as u32
    let deslocamento: u32 = (ordem + 1) as u32
    return lw_valor_bool(((mascara >> deslocamento) & 1) != 0)
}

// C: ir/lower_const.c:308
proc dobrar_logico(op: u8, a: Valor, b: Valor) -> Valor {
    var tern_1: i32 = common.c2f_b2i32((a.inteiro != 0) or (b.inteiro != 0))
    if op == (frontend.OP_E as u8) {
        tern_1 = common.c2f_b2i32((a.inteiro != 0) and (b.inteiro != 0))
    }
    return lw_valor_bool(tern_1 != 0)
}

// C: ir/lower_const.c:313
proc dobrar_binario(c: ^LowerCtx, e: ^frontend.Expr, saida: ^Valor) -> bool {
    var a: Valor = Valor{}
    var b: Valor = Valor{}
    if (not dobrar_no(c, e.a, &a)) or (not dobrar_no(c, e.b, &b)) {
        return false
    }
    if (e.op == (frontend.OP_E as u8)) or (e.op == (frontend.OP_OU as u8)) {
        saida^ = dobrar_logico(e.op, a, b)
    } else if (e.op as i32) <= frontend.OP_MAIOR_IGUAL {
        saida^ = dobrar_comparacao(e.op, a, b)
    } else if (e.op as i32) >= frontend.OP_BIT_E {
        return dobrar_bits(c, e, a, b, saida)
    } else if a.tipo_no == (V_REAL as u8) {
        return dobrar_aritmetica_real(c, e, a, b, saida)
    } else {
        return dobrar_aritmetica_inteira(c, e, a, b, saida)
    }
    return true
}

// C: ir/lower_const.c:328
proc real_para_inteiro(real: f64, alvo: u32, bits: ^i64) -> bool {
    // trunc sem libm: abaixo de 2^52 o cast para i64 trunca para zero; acima de 2^52 o real ja e inteiro
    var t: f64 = real
    if (real > -4503599627370496.0) and (real < 4503599627370496.0) {
        t = (real as i64) as f64
    }
    // NaN falha em t != t (as comparacoes de faixa sao falsas para NaN, como o isnan do C)
    if (t != t) or (t < -9223372036854775808.0) or (t >= 18446744073709551616.0) {
        return false
    }
    if t < 0 {
        if semantic.tipo_eh_sem_sinal(alvo) or (not semantic.tipo_bits_cabem(alvo, t as i64)) {
            return false
        }
        bits^ = t as i64
        return true
    }
    var magnitude: u64 = 0
    if t >= 9223372036854775808.0 {
        magnitude = ((t - 9223372036854775808.0) as u64) + (9223372036854775807 as u64) + 1
    } else {
        magnitude = t as u64
    }
    if not semantic.tipo_inteiro_cabe(alvo, false, magnitude) {
        return false
    }
    bits^ = transmute(magnitude, to = i64)
    return true
}

// C: ir/lower_const.c:345
proc inteiro_para_inteiro(a: Valor, alvo: u32, bits: ^i64) -> bool {
    let negativo: bool = (not semantic.tipo_eh_sem_sinal(a.tipo)) and (a.inteiro < 0)
    var tern_1: u64 = common.c2f_s2u_64(a.inteiro)
    if common.c2f_b2i32(negativo) != 0 {
        tern_1 = wrapping_sub(0 as u64, common.c2f_s2u_64(a.inteiro))
    }
    let magnitude: u64 = tern_1
    if not semantic.tipo_inteiro_cabe(alvo, negativo, magnitude) {
        return false
    }
    var tern_2: u64 = magnitude
    if common.c2f_b2i32(negativo) != 0 {
        tern_2 = wrapping_sub(0 as u64, magnitude)
    }
    bits^ = transmute(tern_2, to = i64)
    return true
}

// C: ir/lower_const.c:355
proc dobrar_conversao(c: ^LowerCtx, e: ^frontend.Expr, saida: ^Valor) -> bool {
    var a: Valor = Valor{}
    let alvo: u32 = tipo_anotado(e)
    var bits: i64 = 0
    var real: f64 = 0.0
    if not dobrar_no(c, e.a, &a) {
        return false
    }
    if semantic.tipo_eh_inteiro(alvo) {
        var cabe: bool = false
        if a.tipo_no == (V_REAL as u8) {
            cabe = real_para_inteiro(a.real, alvo, &bits)
        } else {
            cabe = inteiro_para_inteiro(a, alvo, &bits)
        }
        if not cabe {
            return estouro(c, e)
        }
        saida^ = lw_valor_int(bits, alvo)
        return true
    }
    if a.tipo_no == (V_REAL as u8) {
        real = a.real
    } else if semantic.tipo_eh_sem_sinal(a.tipo) {
        real = common.c2f_s2u_64(a.inteiro) as f64
    } else {
        real = a.inteiro as f64
    }
    if alvo != (semantic.TIPO_F64 as u32) {
        real = (real as f32) as f64
    }
    if not dobra_real_finito(real) {
        return estouro(c, e)
    }
    saida^ = lw_valor_real(real, alvo)
    return true
}

// C: ir/lower_const.c:385
proc dobrar_no(c: ^LowerCtx, e: ?^frontend.Expr, saida: ^Valor) -> bool {
    // DOBRAS[e->tipo_no]: tipo sem entrada (NULL na tabela do C) nao e constante
    let no: ^frontend.Expr = e as ^frontend.Expr
    let tipo_no: u8 = no.tipo_no
    var tag: u16 = 0
    if tipo_no == (frontend.EX_INT as u8) {
        tag = DOBRA_NO_DOBRAR_LITERAL_INTEIRO
    } else if tipo_no == (frontend.EX_REAL as u8) {
        tag = DOBRA_NO_DOBRAR_LITERAL_REAL
    } else if tipo_no == (frontend.EX_BOOL as u8) {
        tag = DOBRA_NO_DOBRAR_LITERAL_BOOL
    } else if tipo_no == (frontend.EX_TEXTO as u8) {
        tag = DOBRA_NO_DOBRAR_LITERAL_TEXTO
    } else if tipo_no == (frontend.EX_NOME as u8) {
        tag = DOBRA_NO_DOBRAR_NOME
    } else if tipo_no == (frontend.EX_CAMPO as u8) {
        tag = DOBRA_NO_DOBRAR_CAMPO
    } else if tipo_no == (frontend.EX_CHAMADA as u8) {
        tag = DOBRA_NO_DOBRAR_CHAMADA
    } else if tipo_no == (frontend.EX_UNARIO as u8) {
        tag = DOBRA_NO_DOBRAR_UNARIO
    } else if tipo_no == (frontend.EX_BINARIO as u8) {
        tag = DOBRA_NO_DOBRAR_BINARIO
    } else if tipo_no == (frontend.EX_CONVERSAO as u8) {
        tag = DOBRA_NO_DOBRAR_CONVERSAO
    }
    if tag == 0 {
        return false
    }
    return chamar_dobra_no(tag, c, no, saida)
}

// C: ir/lower_const.c:390
proc lw_dobrar(c: ^LowerCtx, e: ?^frontend.Expr, saida: ^Valor) -> bool {
    if not dobrar_no(c, e, saida) {
        return false
    }
    if (saida.tipo_no == (V_INT as u8)) and (not semantic.tipo_bits_cabem(saida.tipo, saida.inteiro)) {
        return estouro(c, e)
    }
    return true
}

test "lower_const: somas e subtracoes com estouro recusam" {
    var r: i64 = 0
    expect(not inteiro_soma(9223372036854775807, 1, &r))
    expect(inteiro_soma(-5, 3, &r) and r == -2)
    expect(not inteiro_sub(-9223372036854775807 - 1, 1, &r))
    expect(not inteiro_mul(4611686018427387904, 2, &r))
    expect(inteiro_mul(-3, 4, &r) and r == -12)
}

test "lower_const: divisao e resto sem trap com zero e MIN / -1" {
    var r: i64 = 7
    expect(inteiro_div(5, 0, &r) and r == 0)
    expect(not inteiro_div(-9223372036854775807 - 1, -1, &r))
    expect(inteiro_div(-7, 2, &r) and r == -3)
    expect(inteiro_resto(5, 0, &r) and r == 0)
    expect(inteiro_resto(-9223372036854775807 - 1, -1, &r) and r == 0)
    expect(inteiro_resto(-7, 2, &r) and r == -1)
    var q: u64 = 9
    expect(sem_sinal_div(7, 0, &q) and q == 0)
    expect(sem_sinal_resto(7, 0, &q) and q == 0)
    expect(sem_sinal_resto(7, 2, &q) and q == 1)
    expect(not sem_sinal_sub(0, 1, &q))
    expect(not sem_sinal_soma(18446744073709551615, 1, &q))
    expect(not sem_sinal_mul(4294967296, 4294967296, &q))
}

test "lower_const: real_para_inteiro nas bordas" {
    var b: i64 = 0
    let infinito: f64 = transmute(0x7FF0000000000000 as u64, to = f64)
    expect(real_para_inteiro(2.9, semantic.TIPO_INT as u32, &b) and b == 2)
    expect(real_para_inteiro(-2.9, semantic.TIPO_INT as u32, &b) and b == -2)
    expect(real_para_inteiro(-0.5, semantic.TIPO_I32 as u32, &b) and b == 0)
    expect(not real_para_inteiro(infinito, semantic.TIPO_INT as u32, &b))
    expect(not real_para_inteiro(9223372036854775808.0, semantic.TIPO_INT as u32, &b))
    expect(real_para_inteiro(9223372036854775808.0, semantic.TIPO_UINT as u32, &b) and b == -9223372036854775807 - 1)
    expect(not real_para_inteiro(-1.0, semantic.TIPO_UINT as u32, &b))
    expect(not real_para_inteiro(18446744073709551616.0, semantic.TIPO_UINT as u32, &b))
}

test "lower_const: comparacoes com sinal e sem sinal" {
    let menos = lw_valor_int(-1, semantic.TIPO_INT as u32)
    let mais = lw_valor_int(1, semantic.TIPO_INT as u32)
    let maior_sem_sinal = lw_valor_int(-1, semantic.TIPO_UINT as u32)
    let um_sem_sinal = lw_valor_int(1, semantic.TIPO_UINT as u32)
    expect(dobrar_comparacao(frontend.OP_MENOR as u8, menos, mais).inteiro == 1)
    expect(dobrar_comparacao(frontend.OP_MENOR as u8, maior_sem_sinal, um_sem_sinal).inteiro == 0)
    expect(dobrar_comparacao(frontend.OP_MAIOR_IGUAL as u8, mais, mais).inteiro == 1)
    expect(dobrar_comparacao(frontend.OP_DIFERENTE as u8, menos, mais).inteiro == 1)
    expect(dobrar_comparacao(frontend.OP_IGUAL as u8, menos, mais).inteiro == 0)
}

test "lower_const: E0420 com a mensagem do tipo" {
    var diag = common.Diag{}
    var sem = semantic.Semantica{}
    sem.diag = &diag
    var lc = LowerCtx{}
    lc.sem = &sem
    var e = frontend.Expr{}
    e.tipo = semantic.TIPO_I8 as u32
    expect(not estouro(&lc, &e))
    expect(diag.tem and diag.codigo == common.E0420)
    expect((diag.causa or_else "") == "o valor constante nao cabe no tipo i8 (-128..=127)")
}

test "lower_const: despacho de no e aritmetica inteira com estouro" {
    var diag = common.Diag{}
    var sem = semantic.Semantica{}
    sem.diag = &diag
    var lc = LowerCtx{}
    lc.sem = &sem
    var e = frontend.Expr{}
    e.tipo_no = frontend.EX_BOOL as u8
    e.op = 1
    var v = Valor{}
    expect(dobrar_no(&lc, &e, &v) and v.inteiro == 1)
    e.tipo_no = (frontend.EX_CHAMADA_IND + 1) as u8
    expect(not dobrar_no(&lc, &e, &v))
    var comp = frontend.Expr{}
    comp.ref = frontend.REF_COMPONENTE as u8
    comp.ref_id = 2
    comp.tipo = semantic.TIPO_INT as u32
    expect(dobrar_literal_inteiro(&lc, &comp, &v) and v.inteiro == 2)
    var soma = frontend.Expr{}
    soma.tipo = semantic.TIPO_I8 as u32
    soma.op = frontend.OP_SOMA as u8
    expect(not dobrar_aritmetica_inteira(&lc, &soma, lw_valor_int(100, semantic.TIPO_I8 as u32), lw_valor_int(100, semantic.TIPO_I8 as u32), &v))
    expect(diag.tem and diag.codigo == common.E0420)
    expect(dobrar_aritmetica_inteira(&lc, &soma, lw_valor_int(3, semantic.TIPO_I8 as u32), lw_valor_int(4, semantic.TIPO_I8 as u32), &v) and v.inteiro == 7)
}

test "lower_const: mascara da largura" {
    expect(mascara_da_largura(0) == 0)
    expect(mascara_da_largura(8) == 255)
    expect(mascara_da_largura(64) == 18446744073709551615)
}
