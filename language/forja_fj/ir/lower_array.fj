import "common"
import "frontend"
import "semantic"

// C: ir/lower_array.c:18
proc classe_de(c: ^LowerCtx, t: u32) -> i32 {
    return semantic.tipo_classe_de(&(c.sem as ^semantic.Semantica).tipos, t)
}

// C: ir/lower_array.c:24
proc instr_com_temp(c: ^LowerCtx, op: i32, pos: u32, tipo: u32) -> ^IrInstr {
    let i: ^IrInstr = lw_nova_instr(c, op, pos)
    i.destino = lw_novo_temp(c)
    i.tipo = tipo
    return i
}

// C: ir/lower_array.c:32
proc eh_deref(e: ?^frontend.Expr) -> bool {
    return ((e as ^frontend.Expr).tipo_no == (frontend.EX_UNARIO as u8)) and ((e as ^frontend.Expr).op == (frontend.OP_DEREF as u8))
}

// C: ir/lower_array.c:38
proc indice_como_int(c: ^LowerCtx, e: ?^frontend.Expr) -> Valor {
    var v: Valor = Valor{}
    if not lw_dobrar(c, e, &v) {
        v = lw_expr(c, e)
    }
    let bits_altos: bool = (common.c2f_b2i32(semantic.tipo_eh_sem_sinal(v.tipo)) != 0) and (v.inteiro < 0)
    if v.tipo == (semantic.TIPO_INT as u32) {
        return v
    }
    if (v.tipo_no == (V_INT as u8)) and (not bits_altos) {
        v.tipo = semantic.TIPO_INT as u32
        return v
    }
    let i: ^IrInstr = instr_com_temp(c, IR_CONVERSAO, (e as ^frontend.Expr).pos_op, semantic.TIPO_INT as u32)
    i.a = v
    return lw_valor_temp(i.destino, semantic.TIPO_INT as u32)
}

// C: ir/lower_array.c:54
proc eh_enderecavel(c: ^LowerCtx, e: ?^frontend.Expr) -> bool {
    let sw_1 = (e as ^frontend.Expr).tipo_no as i32
    if sw_1 == frontend.EX_NOME {
        return ((e as ^frontend.Expr).ref == (frontend.REF_LOCAL as u8)) or ((e as ^frontend.Expr).ref == (frontend.REF_PARAM as u8))
    } else if sw_1 == frontend.EX_UNARIO {
        return (e as ^frontend.Expr).op == (frontend.OP_DEREF as u8)
    } else if sw_1 == frontend.EX_CAMPO {
        return ((e as ^frontend.Expr).ref == (frontend.REF_CAMPO as u8)) and ((common.c2f_s2u_32(classe_de(c, ((e as ^frontend.Expr).a as ^frontend.Expr).tipo)) == (semantic.TC_PONTEIRO as u32)) or (common.c2f_b2i32(eh_enderecavel(c, (e as ^frontend.Expr).a)) != 0))
    } else if sw_1 == frontend.EX_INDICE {
        return (common.c2f_s2u_32(classe_de(c, ((e as ^frontend.Expr).a as ^frontend.Expr).tipo)) != (semantic.TC_ARRAY as u32)) or (common.c2f_b2i32(eh_enderecavel(c, (e as ^frontend.Expr).a)) != 0)
    } else {
        return false
    }
    return false
}

// C: ir/lower_array.c:66
proc conferir_indice_constante(c: ^LowerCtx, indice: Valor, base: u32, pos: u32, op_aux: ^u8) {
    let sem: ^semantic.Semantica = c.sem as ^semantic.Semantica
    let array: u32 = array_do_tipo(c, base)
    if (indice.tipo_no != (V_INT as u8)) or (classe_de(c, array) != semantic.TC_ARRAY) {
        return
    }
    let n: u32 = semantic.tipo_de(&sem.tipos, array).b
    if (indice.inteiro >= 0) and (indice.inteiro < (n as i64)) {
        op_aux^ = 1
        return
    }
    if (sem.diag as ^common.Diag).tem {
        return
    }
    let tipo: str = descreve_array(sem, array)
    defer delete(tipo)
    let msg: str = format(f"indice {indice.inteiro} fora de {tipo} (0..<{n})", alloc = heap)
    defer delete(msg)
    _ = common.diag_relatar(sem.diag as ^common.Diag, common.E0421, pos, msg)
}

// SemDescrever do array em str de heap (o chamador faz delete), cortado em 95 bytes como o char tipo[96] do C (mesmo corpo de sem_descrever_str).
proc descreve_array(sem: ^semantic.Semantica, array: u32) -> str {
    var texto: [96]u8 = {}
    semantic.sem_descrever(sem, array, texto[..], 96)
    return from_bytes(texto[0..<common.c2f_strlen_b(texto[..])], alloc = heap)
}

// C: ir/lower_array.c:82
proc ponteiro_da_base(c: ^LowerCtx, base: ?^frontend.Expr) -> Valor {
    if eh_deref(base) {
        return lw_expr(c, (base as ^frontend.Expr).a)
    }
    if common.c2f_s2u_32(classe_de(c, (base as ^frontend.Expr).tipo)) == (semantic.TC_PONTEIRO as u32) {
        return lw_expr(c, base)
    }
    return lw_endereco(c, base)
}

// C: ir/lower_array.c:89
proc endereco_de_nome(c: ^LowerCtx, e: ?^frontend.Expr) -> Valor {
    let arg_1: u32 = semantic.tipo_ponteiro(&(c.sem as ^semantic.Semantica).tipos, (e as ^frontend.Expr).tipo)
    let arg_2: u32 = (e as ^frontend.Expr).pos_op
    let arg_3: ^LowerCtx = c
    let i: ^IrInstr = instr_com_temp(arg_3, IR_UNARIO, arg_2, arg_1)
    i.op_aux = frontend.OP_ENDERECO as u8
    i.a = lw_valor_local((e as ^frontend.Expr).ref_id, (e as ^frontend.Expr).tipo)
    return lw_valor_temp(i.destino, i.tipo)
}

// C: ir/lower_array.c:97
proc endereco_de_campo(c: ^LowerCtx, e: ?^frontend.Expr) -> Valor {
    if ((common.c2f_b2i32((c.sem as ^semantic.Semantica).tipos.tem_soa) != 0) and (((e as ^frontend.Expr).a as ^frontend.Expr).tipo_no == (frontend.EX_INDICE as u8))) and (common.c2f_s2u_32(classe_de(c, (((e as ^frontend.Expr).a as ^frontend.Expr).a as ^frontend.Expr).tipo)) == (semantic.TC_SOA as u32)) {
        return lw_endereco_campo_soa(c, e)
    }
    let ponteiro: Valor = ponteiro_da_base(c, (e as ^frontend.Expr).a)
    let arg_1: u32 = semantic.tipo_ponteiro(&(c.sem as ^semantic.Semantica).tipos, (e as ^frontend.Expr).tipo)
    let arg_2: u32 = (e as ^frontend.Expr).pos_op
    let arg_3: ^LowerCtx = c
    let i: ^IrInstr = instr_com_temp(arg_3, IR_ENDERECO_CAMPO, arg_2, arg_1)
    i.a = ponteiro
    i.nome = (e as ^frontend.Expr).nome
    return lw_valor_temp(i.destino, i.tipo)
}

// C: ir/lower_array.c:109
proc endereco_de_elemento(c: ^LowerCtx, e: ?^frontend.Expr) -> Valor {
    if common.c2f_b2i32((e as ^frontend.Expr).nargs != 0) != 0 {
        return lw_endereco_matriz(c, e)
    }
    if (common.c2f_b2i32((c.sem as ^semantic.Semantica).qtd_listas_fixas != 0) != 0) and (common.c2f_b2i32(lw_eh_lista_fixa(c, ((e as ^frontend.Expr).a as ^frontend.Expr).tipo)) != 0) {
        return lw_endereco_lista_fixa(c, e)
    }
    var tern_1: Valor = Valor{}
    if common.c2f_s2u_32(classe_de(c, ((e as ^frontend.Expr).a as ^frontend.Expr).tipo)) == (semantic.TC_ARRAY as u32) {
        tern_1 = lw_endereco(c, (e as ^frontend.Expr).a)
    } else {
        tern_1 = lw_expr(c, (e as ^frontend.Expr).a)
    }
    let base: Valor = tern_1
    let indice: Valor = indice_como_int(c, (e as ^frontend.Expr).b)
    let arg_1: u32 = semantic.tipo_ponteiro(&(c.sem as ^semantic.Semantica).tipos, (e as ^frontend.Expr).tipo)
    let arg_2: u32 = (e as ^frontend.Expr).pos_op
    let arg_3: ^LowerCtx = c
    let i: ^IrInstr = instr_com_temp(arg_3, IR_ENDERECO_ELEMENTO, arg_2, arg_1)
    i.a = base
    i.b = indice
    conferir_indice_constante(c, indice, base.tipo, (e as ^frontend.Expr).pos_op, &i.op_aux)
    return lw_valor_temp(i.destino, i.tipo)
}

// C: ir/lower_array.c:122
proc lw_endereco(c: ^LowerCtx, e: ?^frontend.Expr) -> Valor {
    let sw_1 = (e as ^frontend.Expr).tipo_no as i32
    if sw_1 == frontend.EX_NOME {
        return endereco_de_nome(c, e)
    } else if sw_1 == frontend.EX_UNARIO {
        if eh_deref(e) {
            return lw_expr(c, (e as ^frontend.Expr).a)
        }
    } else if sw_1 == frontend.EX_CAMPO {
        return endereco_de_campo(c, e)
    } else if sw_1 == frontend.EX_INDICE {
        return endereco_de_elemento(c, e)
    } else {
    }
    let msg_1 = format(f"lowering: endereco de algo que nao e lvalor (offset {(e as ^frontend.Expr).pos_op})", alloc = heap)
    defer delete(msg_1)
    common.falha_interna(msg_1)
    return Valor{}
}

// C: ir/lower_array.c:137
proc base_do_indice(c: ^LowerCtx, base: ?^frontend.Expr) -> Valor {
    if common.c2f_s2u_32(classe_de(c, (base as ^frontend.Expr).tipo)) != (semantic.TC_ARRAY as u32) {
        return lw_expr(c, base)
    }
    if (base as ^frontend.Expr).tipo_no == (frontend.EX_NOME as u8) {
        return lw_expr(c, base)
    }
    var tern_1: Valor = Valor{}
    if common.c2f_b2i32(eh_enderecavel(c, base)) != 0 {
        tern_1 = lw_endereco(c, base)
    } else {
        tern_1 = lw_expr(c, base)
    }
    return tern_1
}

// C: ir/lower_array.c:145
proc lw_indice_int(c: ^LowerCtx, e: ?^frontend.Expr) -> Valor {
    return indice_como_int(c, e)
}

// C: ir/lower_array.c:146
proc lw_base_indexada(c: ^LowerCtx, base: ?^frontend.Expr) -> Valor {
    return base_do_indice(c, base)
}

// C: ir/lower_array.c:147
proc lw_enderecavel(c: ^LowerCtx, e: ?^frontend.Expr) -> bool {
    return eh_enderecavel(c, e)
}

// C: ir/lower_array.c:150
proc texto_como_fatia(c: ^LowerCtx, texto: ?^frontend.Expr) -> Valor {
    let v: Valor = lw_expr(c, texto)
    let arg_1: u32 = semantic.tipo_fatia(&(c.sem as ^semantic.Semantica).tipos, semantic.TIPO_U8 as u32)
    let arg_2: u32 = (texto as ^frontend.Expr).pos_op
    let arg_3: ^LowerCtx = c
    let i: ^IrInstr = instr_com_temp(arg_3, IR_TRANSMUTA, arg_2, arg_1)
    i.a = v
    return lw_valor_temp(i.destino, i.tipo)
}

// C: ir/lower_array.c:159
proc lw_indice_texto(c: ^LowerCtx, e: ^frontend.Expr) -> Valor {
    let base: Valor = texto_como_fatia(c, e.a)
    let indice: Valor = indice_como_int(c, e.b)
    let i: ^IrInstr = instr_com_temp(c, IR_ELEMENTO, e.pos_op, semantic.TIPO_U8 as u32)
    i.a = base
    i.b = indice
    return lw_valor_temp(i.destino, i.tipo)
}

// C: ir/lower_array.c:170
proc lw_fatia_texto(c: ^LowerCtx, e: ^frontend.Expr) -> Valor {
    if e.op == (frontend.FATIA_INTEIRA as u8) {
        return lw_expr(c, e.a)
    }
    let base: Valor = texto_como_fatia(c, e.a)
    let inicio: Valor = indice_como_int(c, (e.args or_else {})[0].valor)
    let fim: Valor = indice_como_int(c, (e.args or_else {})[1].valor)
    let tipo_fatia_u8: u32 = semantic.tipo_fatia(&(c.sem as ^semantic.Semantica).tipos, semantic.TIPO_U8 as u32)
    let i: ^IrInstr = instr_com_temp(c, IR_FATIA, e.pos_op, tipo_fatia_u8)
    i.a = base
    i.b = inicio
    i.args = lw_args(c, 1)
    let args: []Valor = i.args or_else {}
    args[0] = fim
    i.nargs = 1
    i.faixa_excl = e.op == (frontend.FATIA_EXCL as u8)
    let fatia: Valor = lw_valor_temp(i.destino, i.tipo)
    let volta: ^IrInstr = instr_com_temp(c, IR_TRANSMUTA, e.pos_op, semantic.TIPO_TEXTO as u32)
    volta.a = fatia
    return lw_valor_temp(volta.destino, volta.tipo)
}

// C: ir/lower_array.c:189
proc lw_indice(c: ^LowerCtx, e: ^frontend.Expr) -> Valor {
    if common.c2f_b2i32(e.nargs != 0) != 0 {
        return lw_indice_matriz(c, e)
    }
    if (e.a as ^frontend.Expr).tipo == (semantic.TIPO_TEXTO as u32) {
        return lw_indice_texto(c, e)
    }
    if (common.c2f_b2i32((c.sem as ^semantic.Semantica).tipos.tem_soa) != 0) and (common.c2f_s2u_32(classe_de(c, (e.a as ^frontend.Expr).tipo)) == (semantic.TC_SOA as u32)) {
        return lw_indice_soa(c, e)
    }
    if (common.c2f_b2i32((c.sem as ^semantic.Semantica).qtd_listas_fixas != 0) != 0) and (common.c2f_b2i32(lw_eh_lista_fixa(c, (e.a as ^frontend.Expr).tipo)) != 0) {
        return lw_indice_lista_fixa(c, e)
    }
    var base: Valor = Valor{}
    if not lw_base_dado(c, e.a, &base) {
        base = base_do_indice(c, e.a)
    }
    let indice: Valor = indice_como_int(c, e.b)
    let i: ^IrInstr = instr_com_temp(c, IR_ELEMENTO, e.pos_op, e.tipo)
    i.a = base
    i.b = indice
    conferir_indice_constante(c, indice, base.tipo, e.pos_op, &i.op_aux)
    return lw_valor_temp(i.destino, i.tipo)
}

// C: ir/lower_array.c:205
proc lw_literal_array(c: ^LowerCtx, e: ^frontend.Expr) -> Valor {
    let tipos: ^semantic.Tipos = &(c.sem as ^semantic.Semantica).tipos
    let com_v19: bool = (tipos.tem_bit_set) or (tipos.tem_matriz)
    if com_v19 and (common.c2f_s2u_32(classe_de(c, e.tipo)) >= (semantic.TC_MAPA as u32)) {
        return lw_literal_v19(c, e)
    }
    if ((common.c2f_b2i32((c.sem as ^semantic.Semantica).qtd_listas_fixas != 0) != 0)) and semantic.tipo_eh_lista_fixa(tipos, e.tipo) {
        return lw_zero_do_tipo(c, e.tipo, e.pos)
    }
    let total: u32 = e.nargs
    let elementos: ?[]Valor = lw_args(c, total)
    let vetor: []Valor = elementos or_else {}
    for k in (0 as u32)..<total {
        vetor[k] = lw_expr(c, (e.args or_else {})[k].valor)
    }
    let i: ^IrInstr = instr_com_temp(c, IR_ARRAY, e.pos_op, e.tipo)
    i.args = elementos
    i.nargs = total
    return lw_valor_temp(i.destino, i.tipo)
}

// C: ir/lower_array.c:219
proc lw_zero_composto(c: ^LowerCtx, t: u32, pos: u32) -> Valor {
    let i: ^IrInstr = instr_com_temp(c, IR_ARRAY, pos, t)
    return lw_valor_temp(i.destino, i.tipo)
}

// C: ir/lower_array.c:226
proc array_do_tipo(c: ^LowerCtx, t: u32) -> u32 {
    var tern_1: u32 = t
    if common.c2f_s2u_32(classe_de(c, t)) == (semantic.TC_PONTEIRO as u32) {
        tern_1 = semantic.tipo_de(&(c.sem as ^semantic.Semantica).tipos, t).a
    }
    return tern_1
}

// C: ir/lower_array.c:231
proc lw_eh_lista(c: ^LowerCtx, t: u32) -> bool {
    var t_v: u32 = t
    if common.c2f_s2u_32(classe_de(c, t_v)) == (semantic.TC_PONTEIRO as u32) {
        t_v = semantic.tipo_de(&(c.sem as ^semantic.Semantica).tipos, t_v).a
    }
    return common.c2f_s2u_32(classe_de(c, t_v)) == (semantic.TC_DINAMICO as u32)
}

// C: ir/lower_array.c:238
proc lw_tamanho_colecao(c: ^LowerCtx, arg: ?^frontend.Expr) -> Valor {
    if (common.c2f_b2i32((c.sem as ^semantic.Semantica).qtd_listas_fixas != 0) != 0) and (common.c2f_b2i32(lw_eh_lista_fixa(c, (arg as ^frontend.Expr).tipo)) != 0) {
        return lw_tamanho_lista_fixa(c, arg)
    }
    let array: u32 = array_do_tipo(c, (arg as ^frontend.Expr).tipo)
    if lw_eh_lista(c, (arg as ^frontend.Expr).tipo) {
        let lista: Valor = lw_expr(c, arg)
        let i: ^IrInstr = instr_com_temp(c, IR_TAMANHO_TEXTO, (arg as ^frontend.Expr).pos_op, semantic.TIPO_INT as u32)
        i.a = lista
        return lw_valor_temp(i.destino, semantic.TIPO_INT as u32)
    }
    if common.c2f_s2u_32(classe_de(c, array)) == (semantic.TC_FATIA as u32) {
        let fatia: Valor = lw_expr(c, arg)
        let i: ^IrInstr = instr_com_temp(c, IR_TAMANHO_TEXTO, (arg as ^frontend.Expr).pos_op, semantic.TIPO_INT as u32)
        i.a = fatia
        return lw_valor_temp(i.destino, semantic.TIPO_INT as u32)
    }
    if common.c2f_s2u_32(classe_de(c, array)) != (semantic.TC_ARRAY as u32) {
        if common.c2f_s2u_32(classe_de(c, array)) >= (semantic.TC_MAPA as u32) {
            return lw_tamanho_v19(c, arg)
        }
        let msg_1 = format(f"lowering: len de colecao que nao e array nem fatia (offset {(arg as ^frontend.Expr).pos_op})", alloc = heap)
        defer delete(msg_1)
        common.falha_interna(msg_1)
    }
    return lw_valor_int(semantic.tipo_de(&(c.sem as ^semantic.Semantica).tipos, array).b as i64, semantic.TIPO_INT as u32)
}

// C: ir/lower_array.c:263
proc lw_base_da_colecao(c: ^LowerCtx, e: ?^frontend.Expr, tamanho: ^Valor) -> Valor {
    if (common.c2f_b2i32((c.sem as ^semantic.Semantica).qtd_listas_fixas != 0) != 0) and (common.c2f_b2i32(lw_eh_lista_fixa(c, (e as ^frontend.Expr).tipo)) != 0) {
        return lw_base_lista_fixa(c, e, tamanho)
    }
    let classe: i32 = classe_de(c, (e as ^frontend.Expr).tipo)
    if lw_eh_lista(c, (e as ^frontend.Expr).tipo) {
        var tern_1: Valor = Valor{}
        if (common.c2f_s2u_32(classe) == (semantic.TC_DINAMICO as u32)) and (common.c2f_b2i32(eh_enderecavel(c, e)) != 0) {
            tern_1 = lw_endereco(c, e)
        } else {
            tern_1 = lw_expr(c, e)
        }
        let lista: Valor = tern_1
        let t: ^IrInstr = instr_com_temp(c, IR_TAMANHO_TEXTO, (e as ^frontend.Expr).pos_op, semantic.TIPO_INT as u32)
        t.a = lista
        tamanho^ = lw_valor_temp(t.destino, semantic.TIPO_INT as u32)
        return lista
    }
    if common.c2f_s2u_32(classe) == (semantic.TC_FATIA as u32) {
        let base: Valor = lw_expr(c, e)
        let i: ^IrInstr = instr_com_temp(c, IR_TAMANHO_TEXTO, (e as ^frontend.Expr).pos_op, semantic.TIPO_INT as u32)
        i.a = base
        tamanho^ = lw_valor_temp(i.destino, semantic.TIPO_INT as u32)
        return base
    }
    let arg_1: u32 = array_do_tipo(c, (e as ^frontend.Expr).tipo)
    let arg_2: ^semantic.Tipos = &(c.sem as ^semantic.Semantica).tipos
    tamanho^ = lw_valor_int(semantic.tipo_de(arg_2, arg_1).b as i64, semantic.TIPO_INT as u32)
    if (common.c2f_s2u_32(classe) == (semantic.TC_ARRAY as u32)) and (common.c2f_b2i32(eh_enderecavel(c, e)) != 0) {
        return lw_endereco(c, e)
    }
    return lw_expr(c, e)
}

// C: ir/lower_array.c:287
proc conferir_limites_constantes(c: ^LowerCtx, e: ^frontend.Expr, inicio: Valor, fim: Valor, op_aux: ^u8) {
    let sem: ^semantic.Semantica = c.sem as ^semantic.Semantica
    let array: u32 = array_do_tipo(c, (e.a as ^frontend.Expr).tipo)
    if (inicio.tipo_no != (V_INT as u8)) or (fim.tipo_no != (V_INT as u8)) or (classe_de(c, array) != semantic.TC_ARRAY) {
        return
    }
    let n: i64 = semantic.tipo_de(&sem.tipos, array).b as i64
    var ultimo: i64 = fim.inteiro
    if e.op == (frontend.FATIA_INCL as u8) {
        ultimo = fim.inteiro + 1
    }
    if (inicio.inteiro >= 0) and (inicio.inteiro <= ultimo) and (ultimo <= n) {
        op_aux^ = 1
        return
    }
    if (sem.diag as ^common.Diag).tem {
        return
    }
    let tipo: str = descreve_array(sem, array)
    defer delete(tipo)
    var op_txt: str = "..<"
    if e.op == (frontend.FATIA_INCL as u8) {
        op_txt = "..="
    }
    let msg: str = format(f"fatia {inicio.inteiro}{op_txt}{fim.inteiro} fora de {tipo} (0..={n})", alloc = heap)
    defer delete(msg)
    _ = common.diag_relatar(sem.diag as ^common.Diag, common.E0421, e.pos_op, msg)
}

// C: ir/lower_array.c:305
proc fatia_inteira(c: ^LowerCtx, e: ^frontend.Expr, base: Valor) -> Valor {
    if common.c2f_s2u_32(classe_de(c, (e.a as ^frontend.Expr).tipo)) == (semantic.TC_FATIA as u32) {
        return base
    }
    let lista: bool = lw_eh_lista(c, (e.a as ^frontend.Expr).tipo)
    var tamanho: Valor = Valor{}
    if lista {
        let t: ^IrInstr = instr_com_temp(c, IR_TAMANHO_TEXTO, e.pos_op, semantic.TIPO_INT as u32)
        t.a = base
        tamanho = lw_valor_temp(t.destino, semantic.TIPO_INT as u32)
    } else {
        let arr: u32 = array_do_tipo(c, (e.a as ^frontend.Expr).tipo)
        tamanho = lw_valor_int(semantic.tipo_de(&(c.sem as ^semantic.Semantica).tipos, arr).b as i64, semantic.TIPO_INT as u32)
    }
    let i: ^IrInstr = instr_com_temp(c, IR_FATIA, e.pos_op, e.tipo)
    i.a = base
    i.b = lw_valor_int(0, semantic.TIPO_INT as u32)
    i.args = lw_args(c, 1)
    let args: []Valor = i.args or_else {}
    args[0] = tamanho
    i.nargs = 1
    i.faixa_excl = true
    // lista: o tamanho vem de execucao; o emissor confere a epoca (op_aux 0)
    i.op_aux = 1
    if lista {
        i.op_aux = 0
    }
    return lw_valor_temp(i.destino, i.tipo)
}

// C: ir/lower_array.c:329
proc lw_fatia(c: ^LowerCtx, e: ^frontend.Expr) -> Valor {
    if (e.a as ^frontend.Expr).tipo == (semantic.TIPO_TEXTO as u32) {
        return lw_fatia_texto(c, e)
    }
    if (common.c2f_b2i32((c.sem as ^semantic.Semantica).qtd_listas_fixas != 0) != 0) and lw_eh_lista_fixa(c, (e.a as ^frontend.Expr).tipo) {
        return lw_fatia_lista_fixa(c, e)
    }
    var base: Valor = Valor{}
    if common.c2f_s2u_32(classe_de(c, (e.a as ^frontend.Expr).tipo)) == (semantic.TC_ARRAY as u32) {
        base = lw_endereco(c, e.a)
    } else {
        base = lw_expr(c, e.a)
    }
    if e.op == (frontend.FATIA_INTEIRA as u8) {
        return fatia_inteira(c, e, base)
    }
    let inicio: Valor = indice_como_int(c, (e.args or_else {})[0].valor)
    let fim: Valor = indice_como_int(c, (e.args or_else {})[1].valor)
    let i: ^IrInstr = instr_com_temp(c, IR_FATIA, e.pos_op, e.tipo)
    i.a = base
    i.b = inicio
    i.args = lw_args(c, 1)
    let args: []Valor = i.args or_else {}
    args[0] = fim
    i.nargs = 1
    i.faixa_excl = e.op == (frontend.FATIA_EXCL as u8)
    conferir_limites_constantes(c, e, inicio, fim, &i.op_aux)
    return lw_valor_temp(i.destino, i.tipo)
}
