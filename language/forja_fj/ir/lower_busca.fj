import "common"
import "frontend"
import "semantic"

struct Fatia {
    base: LlBase
    n: Valor
}

// C2F-82 macro de funcao INT_VALOR ( n ) LwValorInt ( ( n ) , TIPO_INT )

// C: ir/lower_busca.c:24
proc fatia_do_argumento(k: ^LoCtx, arg: ?^frontend.Expr) -> Fatia {
    let fatia: Valor = lw_expr(k.c as ^LowerCtx, arg)
    return Fatia{base = ll_base_de(k.c as ^LowerCtx, fatia), n = ll_tamanho(k, fatia)}
}

// C: ir/lower_busca.c:31
proc percorre(k: ^LoCtx, f: ^Fatia, externo: ^?^IrBloco) -> Valor {
    return ll_entra_laco(k, lw_valor_int(0, semantic.TIPO_INT as u32), f.n, externo)
}

// C: ir/lower_busca.c:37
proc lw_index_of(c: ^LowerCtx, e: ^frontend.Expr) -> Valor {
    var k: LoCtx = LoCtx{c = c, pos = e.pos_op}
    var externo: ?^IrBloco = none
    var f: Fatia = fatia_do_argumento(&k, ll_argumento(e, 0))
    let valor: Valor = lw_expr(c, ll_argumento(e, 1))
    let resultado: i32 = lo_local(&k, e.tipo, lw_valor_nenhum())
    let volta: Valor = percorre(&k, &f, &externo)
    var posicao: Valor = volta
    if e.ref_id == frontend.EMB_LAST_INDEX_OF {
        posicao = ll_menos(&k, ll_menos(&k, f.n, lw_valor_int(1, semantic.TIPO_INT as u32)), volta)
    }
    let lido: Valor = ll_le(&k, &f.base, posicao, true)
    let fora: ^IrBloco = lo_entra_se(&k, ll_igual(&k, lido, valor))
    lo_atribui(&k, resultado, e.tipo, ll_embrulha(&k, e.tipo, posicao))
    ll_pare(&k)
    lo_sai_do_se(&k, fora)
    ll_sai_do_laco(&k, externo as ^IrBloco)
    return lw_valor_local(resultado, e.tipo)
}

// C: ir/lower_busca.c:55
proc lw_contains(c: ^LowerCtx, e: ^frontend.Expr) -> Valor {
    var k: LoCtx = LoCtx{c = c, pos = e.pos_op}
    var externo: ?^IrBloco = none
    let contagem: bool = e.ref_id == frontend.EMB_COUNT
    var f: Fatia = fatia_do_argumento(&k, ll_argumento(e, 0))
    let valor: Valor = lw_expr(c, ll_argumento(e, 1))
    let resultado: i32 = lo_local(&k, e.tipo, lw_valor_nenhum())
    let volta: Valor = percorre(&k, &f, &externo)
    let lido: Valor = ll_le(&k, &f.base, volta, true)
    let fora: ^IrBloco = lo_entra_se(&k, ll_igual(&k, lido, valor))
    if contagem {
        lo_atribui(&k, resultado, semantic.TIPO_INT as u32, ll_mais(&k, lw_valor_local(resultado, semantic.TIPO_INT as u32), lw_valor_int(1, semantic.TIPO_INT as u32)))
    } else {
        lo_atribui(&k, resultado, semantic.TIPO_BOOL as u32, lw_valor_bool(true))
        ll_pare(&k)
    }
    lo_sai_do_se(&k, fora)
    ll_sai_do_laco(&k, externo as ^IrBloco)
    return lw_valor_local(resultado, e.tipo)
}

// C: ir/lower_busca.c:77
proc endereco_inicial(k: ^LoCtx, b: ^LlBase) -> Valor {
    return lo_transmuta(k, semantic.TIPO_UINT as u32, ll_end(k, b, lw_valor_int(0, semantic.TIPO_INT as u32), true))
}

// C: ir/lower_busca.c:83
proc copia_elementos(k: ^LoCtx, dst: ^Fatia, src: ^Fatia, m: Valor, de_tras: bool) {
    var externo: ?^IrBloco = none
    let volta: Valor = ll_entra_laco(k, lw_valor_int(0, semantic.TIPO_INT as u32), m, &externo)
    var i: Valor = volta
    if de_tras {
        i = ll_menos(k, ll_menos(k, m, lw_valor_int(1, semantic.TIPO_INT as u32)), volta)
    }
    // E0 (gcc) avalia o argumento da direita antes (N5): le a origem antes do endereco do destino
    let lido: Valor = ll_le(k, &src.base, i, true)
    let endereco: Valor = ll_end(k, &dst.base, i, true)
    ll_grava(k, endereco, dst.base.elemento, lido)
    ll_sai_do_laco(k, externo as ^IrBloco)
}

// C: ir/lower_busca.c:93
proc lw_copy(c: ^LowerCtx, e: ^frontend.Expr) -> Valor {
    var k: LoCtx = LoCtx{c = c, pos = e.pos_op}
    var dst: Fatia = fatia_do_argumento(&k, ll_argumento(e, 0))
    var src: Fatia = fatia_do_argumento(&k, ll_argumento(e, 1))
    let m: i32 = lo_local(&k, semantic.TIPO_INT as u32, dst.n)
    var fora: ^IrBloco = lo_entra_se(&k, lo_binario(&k, frontend.OP_MENOR as u8, semantic.TIPO_BOOL as u32, src.n, dst.n))
    lo_atribui(&k, m, semantic.TIPO_INT as u32, src.n)
    lo_sai_do_se(&k, fora)
    let quantos: Valor = lw_valor_local(m, semantic.TIPO_INT as u32)
    fora = lo_entra_se(&k, lo_binario(&k, frontend.OP_MAIOR as u8, semantic.TIPO_BOOL as u32, quantos, lw_valor_int(0, semantic.TIPO_INT as u32)))
    // E0 (gcc) avalia o argumento da direita antes (N5): o inicio da origem sai antes do do destino
    let inicio_src: Valor = endereco_inicial(&k, &src.base)
    let inicio_dst: Valor = endereco_inicial(&k, &dst.base)
    let para_frente: Valor = lo_binario(&k, frontend.OP_MENOR_IGUAL as u8, semantic.TIPO_BOOL as u32, inicio_dst, inicio_src)
    let se: ^IrInstr = lw_nova_instr(c, IR_SE, e.pos_op)
    se.a = para_frente
    let dentro: ^IrBloco = lw_trocar_bloco(c, &se.corpo)
    copia_elementos(&k, &dst, &src, quantos, false)
    _ = lw_trocar_bloco(c, &se.senao)
    copia_elementos(&k, &dst, &src, quantos, true)
    _ = lw_trocar_bloco(c, dentro)
    lo_sai_do_se(&k, fora)
    return quantos
}

// C: ir/lower_busca.c:117
proc lw_fill(c: ^LowerCtx, e: ^frontend.Expr) -> Valor {
    var k: LoCtx = LoCtx{c = c, pos = e.pos_op}
    var externo: ?^IrBloco = none
    var f: Fatia = fatia_do_argumento(&k, ll_argumento(e, 0))
    let valor: Valor = lw_expr(c, ll_argumento(e, 1))
    let volta: Valor = percorre(&k, &f, &externo)
    let arg_1: Valor = valor
    let arg_2: u32 = f.base.elemento
    let arg_3: Valor = ll_end(&k, &f.base, volta, true)
    let arg_4: ^LoCtx = &k
    ll_grava(arg_4, arg_3, arg_2, arg_1)
    ll_sai_do_laco(&k, externo as ^IrBloco)
    return lw_valor_nenhum()
}

// C: ir/lower_busca.c:130
proc lw_swap(c: ^LowerCtx, e: ^frontend.Expr) -> Valor {
    var k: LoCtx = LoCtx{c = c, pos = e.pos_op}
    var f: Fatia = fatia_do_argumento(&k, ll_argumento(e, 0))
    let a: Valor = ll_indice_int(&k, ll_argumento(e, 1))
    let b: Valor = ll_indice_int(&k, ll_argumento(e, 2))
    let em_a: Valor = ll_le(&k, &f.base, a, false)
    let em_b: Valor = ll_le(&k, &f.base, b, false)
    let arg_1: Valor = em_b
    let arg_2: u32 = f.base.elemento
    let arg_3: Valor = ll_end(&k, &f.base, a, true)
    let arg_4: ^LoCtx = &k
    ll_grava(arg_4, arg_3, arg_2, arg_1)
    let arg_5: Valor = em_a
    let arg_6: u32 = f.base.elemento
    let arg_7: Valor = ll_end(&k, &f.base, b, true)
    let arg_8: ^LoCtx = &k
    ll_grava(arg_8, arg_7, arg_6, arg_5)
    return lw_valor_nenhum()
}

// C: ir/lower_busca.c:144
proc lw_reverse(c: ^LowerCtx, e: ^frontend.Expr) -> Valor {
    var k: LoCtx = LoCtx{c = c, pos = e.pos_op}
    var externo: ?^IrBloco = none
    var f: Fatia = fatia_do_argumento(&k, ll_argumento(e, 0))
    let metade: Valor = lo_binario(&k, frontend.OP_DIV as u8, semantic.TIPO_INT as u32, f.n, lw_valor_int(2, semantic.TIPO_INT as u32))
    let volta: Valor = ll_entra_laco(&k, lw_valor_int(0, semantic.TIPO_INT as u32), metade, &externo)
    let outro: Valor = ll_menos(&k, ll_menos(&k, f.n, lw_valor_int(1, semantic.TIPO_INT as u32)), volta)
    let da_frente: Valor = ll_le(&k, &f.base, volta, true)
    let de_tras: Valor = ll_le(&k, &f.base, outro, true)
    ll_grava(&k, ll_end(&k, &f.base, volta, true), f.base.elemento, de_tras)
    ll_grava(&k, ll_end(&k, &f.base, outro, true), f.base.elemento, da_frente)
    ll_sai_do_laco(&k, externo as ^IrBloco)
    return lw_valor_nenhum()
}

// C: ir/lower_busca.c:161
proc lw_replace_value(c: ^LowerCtx, e: ^frontend.Expr) -> Valor {
    var k: LoCtx = LoCtx{c = c, pos = e.pos_op}
    var externo: ?^IrBloco = none
    var f: Fatia = fatia_do_argumento(&k, ll_argumento(e, 0))
    let antigo: Valor = lw_expr(c, ll_argumento(e, 1))
    let novo: Valor = lw_expr(c, ll_argumento(e, 2))
    let quantas: ?^frontend.Expr = ll_argumento(e, 3)
    // C: sem n, a quantidade e o maior int; com n, o indice de n (so avaliado quando o fonte o escreve)
    var inicial: Valor = lw_valor_int(9223372036854775807, semantic.TIPO_INT as u32)
    if quantas != none {
        inicial = ll_indice_int(&k, quantas)
    }
    let resta: i32 = lo_local(&k, semantic.TIPO_INT as u32, inicial)
    let restantes: Valor = lw_valor_local(resta, semantic.TIPO_INT as u32)
    let volta: Valor = percorre(&k, &f, &externo)
    let lido: Valor = ll_le(&k, &f.base, volta, true)
    let igual: Valor = ll_igual(&k, lido, antigo)
    let ainda: Valor = lo_binario(&k, frontend.OP_MAIOR as u8, semantic.TIPO_BOOL as u32, restantes, lw_valor_int(0, semantic.TIPO_INT as u32))
    let fora: ^IrBloco = lo_entra_se(&k, lo_binario(&k, frontend.OP_E as u8, semantic.TIPO_BOOL as u32, igual, ainda))
    ll_grava(&k, ll_end(&k, &f.base, volta, true), f.base.elemento, novo)
    lo_atribui(&k, resta, semantic.TIPO_INT as u32, ll_menos(&k, restantes, lw_valor_int(1, semantic.TIPO_INT as u32)))
    lo_sai_do_se(&k, fora)
    ll_sai_do_laco(&k, externo as ^IrBloco)
    return lw_valor_nenhum()
}

// C: ir/lower_busca.c:182
proc lw_clone(c: ^LowerCtx, e: ^frontend.Expr) -> Valor {
    if e.tipo == (semantic.TIPO_STR as u32) {
        return lw_texto_copia(c, e)
    }
    var k: LoCtx = LoCtx{c = c, pos = e.pos_op}
    let f: Fatia = fatia_do_argumento(&k, ll_argumento(e, 0))
    let alocador: Valor = lw_alocador(c, e)
    let cria: ^IrInstr = lw_nova_instr(c, IR_LISTA_CRIA, e.pos_op)
    cria.destino = lw_novo_temp(c)
    cria.tipo = e.tipo
    cria.a = alocador
    cria.b = f.n
    let lista: i32 = lo_local(&k, e.tipo, lw_valor_temp(cria.destino, e.tipo))
    let fora: ^IrBloco = lo_entra_se(&k, lo_binario(&k, frontend.OP_MAIOR as u8, semantic.TIPO_BOOL as u32, f.n, lw_valor_int(0, semantic.TIPO_INT as u32)))
    let anexa: ^IrInstr = lw_nova_instr(c, IR_ANEXA_FATIA, e.pos_op)
    anexa.tipo = f.base.elemento
    anexa.a = lw_valor_local(lista, e.tipo)
    anexa.b = f.base.valor
    lo_sai_do_se(&k, fora)
    return lw_valor_local(lista, e.tipo)
}

// C: ir/lower_busca.c:206
proc eh_busca_de_texto(e: ^frontend.Expr) -> bool {
    let alvo: ?^frontend.Expr = ll_argumento(e, 0)
    let sw_1 = e.ref_id
    if sw_1 == frontend.EMB_INDEX_OF or sw_1 == frontend.EMB_LAST_INDEX_OF or sw_1 == frontend.EMB_CONTAINS or sw_1 == frontend.EMB_COUNT or sw_1 == frontend.EMB_REVERSE {
        return (alvo != none) and ((alvo as ^frontend.Expr).tipo == (semantic.TIPO_STR as u32))
    } else {
        return false
    }
    return false
}

// C: ir/lower_busca.c:219
proc lw_busca(c: ^LowerCtx, e: ^frontend.Expr) -> Valor {
    if eh_busca_de_texto(e) {
        return lw_busca_texto(c, e)
    }
    let sw_1 = e.ref_id
    if sw_1 == frontend.EMB_INDEX_OF or sw_1 == frontend.EMB_LAST_INDEX_OF {
        return lw_index_of(c, e)
    } else if sw_1 == frontend.EMB_CONTAINS or sw_1 == frontend.EMB_COUNT {
        return lw_contains(c, e)
    } else if sw_1 == frontend.EMB_COPY {
        return lw_copy(c, e)
    } else if sw_1 == frontend.EMB_FILL {
        return lw_fill(c, e)
    } else if sw_1 == frontend.EMB_CLONE {
        return lw_clone(c, e)
    } else if sw_1 == frontend.EMB_SWAP {
        return lw_swap(c, e)
    } else if sw_1 == frontend.EMB_REVERSE {
        return lw_reverse(c, e)
    } else if sw_1 == frontend.EMB_REPLACE_VALUE {
        return lw_replace_value(c, e)
    } else {
        let msg_1 = format(f"lowering: embutido de busca desconhecido (offset {e.pos_op})", alloc = heap)
        defer delete(msg_1)
        common.falha_interna(msg_1)
    }
    return Valor{}
}
