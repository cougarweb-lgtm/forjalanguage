import "common"
import "frontend"
import "semantic"

// C: ir/lower_layout.c:10
proc lw_layout_calcular(c: ^LowerCtx) {
    if not (c.sem as ^semantic.Semantica).usa_layout {
        return
    }
    layout_calcular(&(c.sem as ^semantic.Semantica).tipos, c.prog as ^IrPrograma, c.arena as ^common.Arena, &c.layouts)
}

// C: ir/lower_layout.c:18
proc lw_layout_valor(c: ^LowerCtx, e: ^frontend.Expr, valor: ^i64) -> bool {
    let no: ?^frontend.Expr = (e.args or_else {})[0].valor
    if e.ref_id == frontend.EMB_OFFSET_OF {
        valor^ = layout_offset_campo(&c.layouts, ((no as ^frontend.Expr).a as ^frontend.Expr).tipo, common.c2f_s2u_32((no as ^frontend.Expr).ref_id)) as i64
        return true
    }
    let lt: ^LayoutTipo = &(c.layouts.tipos or_else {})[(no as ^frontend.Expr).tipo]
    if lt.tam == 0 {
        if not ((c.sem as ^semantic.Semantica).diag as ^common.Diag).tem {
            let msg_1 = format(f"o tipo nao tem forma em C e nao tem tamanho", alloc = heap)
            defer delete(msg_1)
            _ = common.diag_relatar((c.sem as ^semantic.Semantica).diag as ^common.Diag, common.E0328, (no as ^frontend.Expr).pos, msg_1)
        }
        return false
    }
    var tern_1: i64 = lt.ali as i64
    if e.ref_id == frontend.EMB_SIZE_OF {
        tern_1 = lt.tam as i64
    }
    valor^ = tern_1
    return true
}

// C: ir/lower_layout.c:35
proc mensagem_do_assert(c: ^LowerCtx, e: ?^frontend.Expr) -> ?str {
    var v: Valor = Valor{}
    var i: u32 = 0
    while i < (e as ^frontend.Expr).nargs {
        let parte: frontend.Arg = ((e as ^frontend.Expr).args or_else {})[i]
        if parte.indice == 1 {
            if lw_dobrar(c, parte.valor, &v) and (v.tipo_no == (V_TEXTO as u8)) {
                return common.interner_texto(&((c.sem as ^semantic.Semantica).nomes or_else {})[0], v.id)
            }
        }
        i += 1
    }
    return none
}

// C: ir/lower_layout.c:46
proc lw_static_assert(c: ^LowerCtx, e: ?^frontend.Expr) {
    var cond: Valor = Valor{}
    let condicao: ?^frontend.Expr = ((e as ^frontend.Expr).args or_else {})[0].valor
    if not lw_dobrar(c, condicao, &cond) {
        if not ((c.sem as ^semantic.Semantica).diag as ^common.Diag).tem {
            let msg_1 = format(f"a condicao do static_assert nao e constante", alloc = heap)
            defer delete(msg_1)
            _ = common.diag_relatar((c.sem as ^semantic.Semantica).diag as ^common.Diag, common.E0329, (condicao as ^frontend.Expr).pos, msg_1)
        }
        return
    }
    if cond.inteiro != 0 {
        return
    }
    let mensagem: ?str = mensagem_do_assert(c, e)
    let texto: str = mensagem or_else "a condicao e falsa"
    let msg_2 = format(f"static_assert falhou: {texto}", alloc = heap)
    defer delete(msg_2)
    _ = common.diag_relatar((c.sem as ^semantic.Semantica).diag as ^common.Diag, common.E0329, (e as ^frontend.Expr).pos, msg_2)
}

// C: ir/lower_layout.c:60
proc lw_asserts_de_topo(c: ^LowerCtx) {
    var d: ?^frontend.Decl = ((c.sem as ^semantic.Semantica).programa as ^frontend.Programa).primeira
    while (d != none) and (not ((c.sem as ^semantic.Semantica).diag as ^common.Diag).tem) {
        if (d as ^frontend.Decl).tipo_no == (frontend.D_ASSERT as u8) {
            lw_static_assert(c, (d as ^frontend.Decl).init)
        }
        d = (d as ^frontend.Decl).prox
    }
}

// C: ir/lower_layout.c:68
proc lw_layout_chamada(c: ^LowerCtx, e: ^frontend.Expr) -> Valor {
    var valor: i64 = 0
    if e.ref_id == frontend.EMB_STATIC_ASSERT {
        lw_static_assert(c, e)
        return lw_valor_nenhum()
    }
    _ = lw_layout_valor(c, e, &valor)
    return lw_valor_int(valor, semantic.TIPO_INT as u32)
}
