import "frontend"

pub struct Valor {
    tipo_no: u8
    tipo: u32 // TipoId
    id: i32
    inteiro: i64
    real: f64
}

pub struct IrBloco {
    primeira: ?^IrInstr
    ultima: ?^IrInstr
}

pub struct IrCaso {
    membro: i32
    padrao: bool
    ligacao: i32
    tipo: u32 // TipoId
    corpo: IrBloco
}

pub struct IrInstr {
    op: u8
    op_aux: u8
    mutavel: bool
    pos: u32
    destino: i32
    nome: i32
    tipo: u32 // TipoId
    a: Valor
    b: Valor
    args: ?[]Valor
    nargs: u32
    faixa_min: i64
    faixa_max: i64
    faixa_excl: bool
    desloc_chave: i64
    tipo_chave: u8
    cond: IrBloco
    corpo: IrBloco
    senao: IrBloco
    casos: ?[]IrCaso
    ncasos: u32
    prox: ?^IrInstr
}

pub struct IrParam {
    nome: i32
    tipo: u32 // TipoId
}

pub struct IrFuncao {
    nome: i32
    retorno: u32 // TipoId
    params: ?[]IrParam
    nparams: u32
    ntemps: u32
    nlocais: u32
    nomes_locais: ?[]frontend.LocalNome
    nnomes_locais: u32
    corpo: IrBloco
    e_main: bool
    e_teste: bool
    exportado: bool
    titulo: i32
    linha: u32
}

pub struct IrCampo {
    nome: i32
    tipo: u32 // TipoId
    tem_faixa: bool
    faixa_min: i64
    faixa_max: i64
    faixa_excl: bool
}

pub struct IrStruct {
    nome: i32
    campos: ?[]IrCampo
    ncampos: u32
    opaco: bool
}

pub struct IrEnum {
    nome: i32
    membros: ?[]i32
    nmembros: u32
    valores: ?[]i64
}

pub struct IrUniao {
    nome: i32
    tipo: u32 // TipoId
    variantes: ?[]u32
    nvariantes: u32
}

struct IrConst {
    nome: i32
    tipo: u32 // TipoId
    valor: Valor
}

pub struct IrExterno {
    nome: i32
    simbolo: i32
    retorno: u32 // TipoId
    params: ?[]IrParam
    nparams: u32
    linha: u32
    arquivo: u32
    interno: bool
}

// F4 (0.26.0): bytes de uma const de array/struct escalar, emitidos em .rdata (V_DADO.id = indice em IrPrograma.dados)
pub struct IrDado {
    bytes: ?[]u8
    tam: u32
    ali: u32
}

pub struct IrTrampolim {
    nome: i32
    tipo: u32 // TipoId
    linha: u32
    arquivo: u32
}

pub struct IrPrograma {
    funcoes: ?[]IrFuncao
    nfuncoes: u32
    structs: ?[]IrStruct
    nstructs: u32
    indice_struct: ?[]i32 // F2: por nome interno, k+1 da 1a struct com esse nome (0 = nenhuma); montado em layout_indexar_structs
    indice_struct_pronto: bool // F2: true so depois de layout_indexar_structs; antes disso layout_estrutura faz a busca linear
    enums: ?[]IrEnum
    nenums: u32
    consts: ?[]IrConst
    nconsts: u32
    externos: ?[]IrExterno
    nexternos: u32
    bibliotecas: ?[]i32
    nbibliotecas: u32
    unioes: ?[]IrUniao
    nunioes: u32
    trampolins: ?[]IrTrampolim
    ntrampolins: u32
    fins: ?[]i32
    nfins: u32
    usa_ordenar: bool
    usa_ordenar_estavel: bool
    usa_ordenar_chave: bool
    usa_heap: bool
    usa_real_curto: bool
    dados: ?[]IrDado // F4: const de array em .rdata (so criado em lw_indice, leitura)
    ndados: u32
}

