import "frontend"
import "semantic"

const ALOCADOR_DO_HEAP: i32 = 1
const MODO_FORMATA_STR: i32 = 1
const LIBERA_TEXTO: i32 = 2

// C: ir/lower_texto_builder.c:18
proc lw_to_str(c: ^LowerCtx, e: ^frontend.Expr) -> Valor {
    let lista: Valor = lw_expr(c, ll_argumento(e, 0))
    let i: ^IrInstr = lw_nova_instr(c, IR_REDIMENSIONA, e.pos_op)
    i.op_aux = REDIM_PARA_STR as u8
    i.destino = lw_novo_temp(c)
    i.tipo = semantic.TIPO_STR as u32
    i.a = lista
    return lw_valor_temp(i.destino, semantic.TIPO_STR as u32)
}

// C: ir/lower_texto_builder.c:29
proc lw_formato_into(c: ^LowerCtx, e: ^frontend.Expr) -> Valor {
    var formata: ?^IrInstr = none
    let arg_1: ^?^IrInstr = &formata
    let arg_2: Valor = lw_valor_int(ALOCADOR_DO_HEAP as i64, semantic.TIPO_U32 as u32)
    let arg_3: ?^frontend.Expr = (e.args or_else {})[0].valor
    let arg_4: ^LowerCtx = c
    lw_formata(arg_4, arg_3, MODO_FORMATA_STR as u8, arg_2, arg_1)
    let texto: Valor = lw_valor_temp((formata as ^IrInstr).destino, semantic.TIPO_STR as u32)
    let lista: Valor = lw_expr(c, (e.args or_else {})[1].valor)
    let anexa: ^IrInstr = lw_nova_instr(c, IR_ANEXA_FATIA, e.pos_op)
    anexa.tipo = semantic.TIPO_U8 as u32
    anexa.a = lista
    anexa.b = texto
    let libera: ^IrInstr = lw_nova_instr(c, IR_LIBERA, e.pos_op)
    libera.op_aux = LIBERA_TEXTO as u8
    libera.a = texto
    return lw_valor_nenhum()
}
