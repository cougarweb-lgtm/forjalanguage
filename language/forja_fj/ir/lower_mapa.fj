import "common"
import "frontend"
import "semantic"

// C: ir/lower_mapa.c:8
proc classe_de_2(c: ^LowerCtx, t: u32) -> i32 {
    return semantic.tipo_classe_de(&(c.sem as ^semantic.Semantica).tipos, t)
}

// C: ir/lower_mapa.c:14
proc argumento_de(e: ^frontend.Expr, indice: i32) -> ?^frontend.Expr {
    for k in (0 as u32)..<e.nargs {
        if (e.args or_else {})[k].indice == indice {
            return (e.args or_else {})[k].valor
        }
    }
    return none
}

// C: ir/lower_mapa.c:23
proc mapa_do_tipo(c: ^LowerCtx, t: u32) -> u32 {
    var tern_1: u32 = t
    if common.c2f_s2u_32(classe_de_2(c, t)) == (semantic.TC_PONTEIRO as u32) {
        tern_1 = semantic.tipo_de(&(c.sem as ^semantic.Semantica).tipos, t).a
    }
    return tern_1
}

// C: ir/lower_mapa.c:29
proc instrucao_do_mapa(c: ^LowerCtx, op: i32, e: ^frontend.Expr, tipo: u32, m: Valor, chave: Valor) -> Valor {
    let i: ^IrInstr = lw_nova_instr(c, op, e.pos_op)
    i.tipo = tipo
    i.a = m
    i.b = chave
    if (common.c2f_s2u_32(op) == (IR_MAPA_INSERE as u32)) or (common.c2f_s2u_32(op) == (IR_MAPA_REMOVE as u32)) {
        return lw_valor_nenhum()
    }
    i.destino = lw_novo_temp(c)
    return lw_valor_temp(i.destino, tipo)
}

// C: ir/lower_mapa.c:41
proc insere_no_mapa(c: ^LowerCtx, e: ^frontend.Expr, m: Valor, chave: Valor) -> Valor {
    let valor: Valor = lw_expr(c, argumento_de(e, 2))
    let i: ^IrInstr = lw_nova_instr(c, IR_MAPA_INSERE, e.pos_op)
    let mapa: u32 = mapa_do_tipo(c, (argumento_de(e, 0) as ^frontend.Expr).tipo)
    i.tipo = semantic.tipo_de(&(c.sem as ^semantic.Semantica).tipos, mapa).b
    i.a = m
    i.b = chave
    i.args = lw_args(c, 1)
    let args: []Valor = i.args or_else {}
    args[0] = valor
    i.nargs = 1
    return lw_valor_nenhum()
}

// C: ir/lower_mapa.c:55
proc lw_embutido_mapa(c: ^LowerCtx, e: ^frontend.Expr) -> Valor {
    let colecao: ?^frontend.Expr = argumento_de(e, 0)
    let m: Valor = lw_expr(c, colecao)
    let chave: Valor = lw_expr(c, argumento_de(e, 1))
    let arg_1: u32 = mapa_do_tipo(c, (colecao as ^frontend.Expr).tipo)
    let arg_2: ^semantic.Tipos = &(c.sem as ^semantic.Semantica).tipos
    let valor: u32 = semantic.tipo_de(arg_2, arg_1).b
    let sw_1 = e.ref_id
    if sw_1 == frontend.EMB_INSERT {
        return insere_no_mapa(c, e, m, chave)
    } else if sw_1 == frontend.EMB_GET {
        return instrucao_do_mapa(c, IR_MAPA_ACHA, e, e.tipo, m, chave)
    } else if sw_1 == frontend.EMB_GET_PTR {
        return instrucao_do_mapa(c, IR_MAPA_PONTEIRO, e, e.tipo, m, chave)
    } else if sw_1 == frontend.EMB_HAS {
        return instrucao_do_mapa(c, IR_MAPA_TEM, e, semantic.TIPO_BOOL as u32, m, chave)
    } else if sw_1 == frontend.EMB_REMOVE {
        return instrucao_do_mapa(c, IR_MAPA_REMOVE, e, valor, m, chave)
    } else {
        let msg_1 = format(f"lowering: embutido {e.ref_id} invalido para map (offset {e.pos_op})", alloc = heap)
        defer delete(msg_1)
        common.falha_interna(msg_1)
    }
    return Valor{}
}

// C: ir/lower_mapa.c:72
proc item_do_mapa(c: ^LowerCtx, op_aux: u8, pos: u32, tipo: u32, base: Valor, contador: i32) -> Valor {
    let i: ^IrInstr = lw_nova_instr(c, IR_MAPA_ITEM, pos)
    i.op_aux = op_aux
    i.tipo = tipo
    i.a = base
    i.b = lw_valor_local(contador, semantic.TIPO_INT as u32)
    i.destino = lw_novo_temp(c)
    return lw_valor_temp(i.destino, tipo)
}

// C: ir/lower_mapa.c:84
proc local_do_for(c: ^LowerCtx, pos: u32, destino: i32, tipo: u32, inicial: Valor) {
    let l: ^IrInstr = lw_nova_instr(c, IR_LOCAL, pos)
    l.destino = destino
    l.tipo = tipo
    l.a = inicial
    l.mutavel = false
}

// C: ir/lower_mapa.c:94
proc base_do_for_mapa(c: ^LowerCtx, e: ?^frontend.Expr) -> Valor {
    if common.c2f_s2u_32(classe_de_2(c, (e as ^frontend.Expr).tipo)) == (semantic.TC_PONTEIRO as u32) {
        return lw_expr(c, e)
    }
    var tern_1: Valor = Valor{}
    if common.c2f_b2i32(lw_enderecavel(c, e)) != 0 {
        tern_1 = lw_endereco(c, e)
    } else {
        tern_1 = lw_expr(c, e)
    }
    return tern_1
}

// C: ir/lower_mapa.c:101
proc lw_for_mapa(c: ^LowerCtx, s: ^frontend.Stmt) {
    let base: Valor = base_do_for_mapa(c, s.expr)
    let tamanho: ^IrInstr = lw_nova_instr(c, IR_TAMANHO_TEXTO, s.pos)
    tamanho.destino = lw_novo_temp(c)
    tamanho.tipo = semantic.TIPO_INT as u32
    tamanho.a = base
    let contador: i32 = lw_novo_local(c)
    let laco: ^IrInstr = lw_nova_instr(c, IR_PARA, s.pos)
    laco.destino = contador
    laco.tipo = semantic.TIPO_INT as u32
    laco.a = lw_valor_int(0, semantic.TIPO_INT as u32)
    laco.b = lw_valor_temp(tamanho.destino, semantic.TIPO_INT as u32)
    laco.faixa_excl = true
    let externo: ^IrBloco = lw_trocar_bloco(c, &laco.corpo)
    let arg_1: u32 = mapa_do_tipo(c, (s.expr as ^frontend.Expr).tipo)
    let arg_2: ^semantic.Tipos = &(c.sem as ^semantic.Semantica).tipos
    let chave: u32 = semantic.tipo_de(arg_2, arg_1).a
    let arg_3: Valor = item_do_mapa(c, 0, s.pos, chave, base, contador)
    let arg_4: u32 = chave
    let arg_5: i32 = s.local_indice
    let arg_6: u32 = s.pos
    let arg_7: ^LowerCtx = c
    local_do_for(arg_7, arg_6, arg_5, arg_4, arg_3)
    var tern_1: i32 = 1
    if common.c2f_b2i32(s.item_ref) != 0 {
        tern_1 = 2
    }
    let item: Valor = item_do_mapa(c, tern_1 as u8, s.pos, s.tipo_local, base, contador)
    local_do_for(c, s.pos, s.local_id, s.tipo_local, item)
    lw_bloco(c, s.corpo, true)
    _ = lw_trocar_bloco(c, externo)
}
