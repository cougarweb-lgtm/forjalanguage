import "common"
import "frontend"
import "semantic"

struct LwEscopo {
    inicio: u32
    e_laco: bool
}

struct LowerCtx {
    sem: ?^semantic.Semantica
    arena: ?^common.Arena
    prog: ?^IrPrograma
    funcao: ?^IrFuncao
    decl: ?^frontend.Decl
    atual: ?^IrBloco
    ntemps: u32
    prox_local: u32
    defers: [dynamic]?^frontend.Stmt
    escopos: [dynamic]LwEscopo
    procs: ?[]?^frontend.Decl
    structs: ?[]?^frontend.Decl
    consts: ?[]?^frontend.Decl
    enums: ?[]?^frontend.Decl
    const_valor: ?[]Valor
    const_escalar: ?[]bool
    seq_teste: u32
    seq_teste_modulo: u32
    layouts: Layouts
    dado_idx: ?[]i32 // F4: por const, 0 = nao tentou, -1 = inelegivel, k+1 = IrPrograma.dados[k]
    const_rdata: bool // F4: false com FORJA_CONST_RDATA=0
}

struct ContaVetor {
    op: u8
    tipo: u32 // TipoId
    pos: u32
    a: Valor
    b: Valor
}

struct PorElemento {
    tipo: u32 // TipoId
    pos: u32
    elemento: u16
    dados: rawptr // C2F-VOID
}

pub const ELEMENTO_FN_ELEMENTO_DA_MATEMATICA: u16 = 1
pub const ELEMENTO_FN_ELEMENTO_DO_RESULTADO: u16 = 2
pub proc chamar_elemento_fn(tag: u16, c: ^LowerCtx, dados: rawptr, indice: Valor) -> Valor {
    if tag == 1 {
        return elemento_da_matematica(c, dados, indice)
    }
    if tag == 2 {
        return elemento_do_resultado(c, dados, indice)
    }
    // tag 0 = ponteiro NULL no C (o C cairia aqui com segfault); tag fora de 1..2 = tag nova sem despachante
    panic("ElementoFn sem despachante: tag 0 (NULL no C) ou tag desconhecida")
    return Valor{}
}
