import "common"
import "frontend"
import "semantic"

const VETOR_DESENROLA_MAX: i32 = 16

// C: ir/lower_vetor.c:18
proc eh_vetor(c: ^LowerCtx, t: u32) -> bool {
    return common.c2f_s2u_32(semantic.tipo_classe_de(&(c.sem as ^semantic.Semantica).tipos, t)) == (semantic.TC_ARRAY as u32)
}

// C: ir/lower_vetor.c:24
proc elemento_de(c: ^LowerCtx, t: u32) -> u32 {
    var tern_1: u32 = t
    if common.c2f_b2i32(eh_vetor(c, t)) != 0 {
        tern_1 = semantic.tipo_de(&(c.sem as ^semantic.Semantica).tipos, t).a
    }
    return tern_1
}

// C: ir/lower_vetor.c:30
proc lw_elemento_do_operando(c: ^LowerCtx, v: Valor, indice: Valor, pos: u32) -> Valor {
    if (v.tipo_no == (V_NENHUM as u8)) or (not eh_vetor(c, v.tipo)) {
        return v
    }
    let i: ^IrInstr = lw_nova_instr(c, IR_ELEMENTO, pos)
    i.destino = lw_novo_temp(c)
    i.tipo = elemento_de(c, v.tipo)
    i.a = v
    i.b = indice
    i.op_aux = 1
    return lw_valor_temp(i.destino, i.tipo)
}

// Fatia de n Valor zerados na arena do LowerCtx (o LwArgs do C). O lw_args do esqueleto devolve ?^Valor e nao serve para i.args (?[]Valor).
proc vetor_args_zerados(c: ^LowerCtx, n: u32) -> []Valor {
    let total: int = n as int
    var l = make([dynamic]Valor, alloc = common.arena_mem(c.arena as ^common.Arena), cap = total)
    for k in 0..<total {
        append(&l, item = Valor{})
    }
    return l[..]
}

// C: ir/lower_vetor.c:43
// C2F-VOID: dados
proc elemento_do_resultado(c: ^LowerCtx, dados: rawptr, indice: Valor) -> Valor {
    let conta: ^ContaVetor = dados as ^ContaVetor
    let a: Valor = lw_elemento_do_operando(c, conta.a, indice, conta.pos)
    let b: Valor = lw_elemento_do_operando(c, conta.b, indice, conta.pos)
    var op_ir: i32 = IR_BINARIO
    if conta.op == (frontend.OP_NEGAR as u8) {
        op_ir = IR_UNARIO
    }
    let i: ^IrInstr = lw_nova_instr(c, op_ir, conta.pos)
    i.destino = lw_novo_temp(c)
    i.tipo = elemento_de(c, conta.tipo)
    i.op_aux = conta.op
    i.a = a
    i.b = b
    return lw_valor_temp(i.destino, i.tipo)
}

// C: ir/lower_vetor.c:58
proc desenrolada(c: ^LowerCtx, por: ^PorElemento, n: u32) -> Valor {
    var elementos: []Valor = vetor_args_zerados(c, n)
    for k in (0 as u32)..<n {
        elementos[k] = chamar_elemento_fn(por.elemento, c, por.dados, lw_valor_int(k as i64, semantic.TIPO_INT as u32))
    }
    let i: ^IrInstr = lw_nova_instr(c, IR_ARRAY, por.pos)
    i.destino = lw_novo_temp(c)
    i.tipo = por.tipo
    i.args = elementos
    i.nargs = n
    return lw_valor_temp(i.destino, i.tipo)
}

// C: ir/lower_vetor.c:71
proc gravar_elemento(c: ^LowerCtx, resultado: Valor, indice: Valor, valor: Valor, pos: u32) {
    let elemento: u32 = elemento_de(c, resultado.tipo)
    let base: ^IrInstr = lw_nova_instr(c, IR_UNARIO, pos)
    base.destino = lw_novo_temp(c)
    base.tipo = semantic.tipo_ponteiro(&(c.sem as ^semantic.Semantica).tipos, resultado.tipo)
    base.op_aux = frontend.OP_ENDERECO as u8
    base.a = resultado
    let alvo: ^IrInstr = lw_nova_instr(c, IR_ENDERECO_ELEMENTO, pos)
    alvo.destino = lw_novo_temp(c)
    alvo.tipo = semantic.tipo_ponteiro(&(c.sem as ^semantic.Semantica).tipos, elemento)
    alvo.a = lw_valor_temp(base.destino, base.tipo)
    alvo.b = indice
    alvo.op_aux = 1
    let grava: ^IrInstr = lw_nova_instr(c, IR_GRAVA_PONTEIRO, pos)
    grava.tipo = elemento
    grava.a = lw_valor_temp(alvo.destino, alvo.tipo)
    grava.b = valor
    grava.nome = -1
}

// C: ir/lower_vetor.c:93
proc em_laco(c: ^LowerCtx, por: ^PorElemento, n: u32) -> Valor {
    let def: ^IrInstr = lw_nova_instr(c, IR_LOCAL, por.pos)
    def.destino = lw_novo_local(c)
    def.tipo = por.tipo
    def.mutavel = true
    let resultado: Valor = lw_valor_local(def.destino, por.tipo)
    let contador: i32 = lw_novo_local(c)
    let laco: ^IrInstr = lw_nova_instr(c, IR_PARA, por.pos)
    laco.destino = contador
    laco.tipo = semantic.TIPO_INT as u32
    laco.a = lw_valor_int(0, semantic.TIPO_INT as u32)
    laco.b = lw_valor_int(n as i64, semantic.TIPO_INT as u32)
    laco.faixa_excl = true
    let externo: ^IrBloco = lw_trocar_bloco(c, &laco.corpo)
    let indice: Valor = lw_valor_local(contador, semantic.TIPO_INT as u32)
    let valor: Valor = chamar_elemento_fn(por.elemento, c, por.dados, indice)
    gravar_elemento(c, resultado, indice, valor, por.pos)
    _ = lw_trocar_bloco(c, externo)
    return resultado
}

// C: ir/lower_vetor.c:114
proc lw_por_elemento(c: ^LowerCtx, por: ^PorElemento) -> Valor {
    let n: u32 = semantic.tipo_de(&(c.sem as ^semantic.Semantica).tipos, por.tipo).b
    if n <= (VETOR_DESENROLA_MAX as u32) {
        return desenrolada(c, por, n)
    }
    return em_laco(c, por, n)
}

// C: ir/lower_vetor.c:121
proc lw_conta_vetor(c: ^LowerCtx, conta: ^ContaVetor) -> Valor {
    var por = PorElemento{tipo = conta.tipo, pos = conta.pos, elemento = ELEMENTO_FN_ELEMENTO_DO_RESULTADO, dados = conta as rawptr}
    return lw_por_elemento(c, &por)
}

// C: ir/lower_vetor.c:128
proc lw_binario_vetor(c: ^LowerCtx, e: ^frontend.Expr, saida: ^Valor) -> bool {
    if not eh_vetor(c, e.tipo) {
        return false
    }
    let a: Valor = lw_expr(c, e.a)
    let b: Valor = lw_expr(c, e.b)
    var conta: ContaVetor = ContaVetor{op = e.op, tipo = e.tipo, pos = e.pos_op, a = a, b = b}
    saida^ = lw_conta_vetor(c, &conta)
    return true
}

// C: ir/lower_vetor.c:139
proc lw_unario_vetor(c: ^LowerCtx, e: ^frontend.Expr, saida: ^Valor) -> bool {
    if (e.op != (frontend.OP_NEGAR as u8)) or (not eh_vetor(c, e.tipo)) {
        return false
    }
    var conta: ContaVetor = ContaVetor{op = frontend.OP_NEGAR as u8, tipo = e.tipo, pos = e.pos_op, a = lw_expr(c, e.a), b = lw_valor_nenhum()}
    saida^ = lw_conta_vetor(c, &conta)
    return true
}

// C: ir/lower_vetor.c:149
proc lw_swizzle(c: ^LowerCtx, e: ^frontend.Expr) -> Valor {
    let letras: u32 = common.c2f_s2u_32(e.ref_id) >> 8
    let base: Valor = lw_base_indexada(c, e.a)
    var elementos: []Valor = vetor_args_zerados(c, letras)
    for j in (0 as u32)..<letras {
        let i: ^IrInstr = lw_nova_instr(c, IR_ELEMENTO, e.pos_op)
        i.destino = lw_novo_temp(c)
        i.tipo = elemento_de(c, e.tipo)
        i.a = base
        i.b = lw_valor_int(common.c2f_e_i32(common.c2f_sar_i32(e.ref_id, (frontend.SWIZZLE_BITS_POR_LETRA as u32) * j), frontend.SWIZZLE_MASCARA_LETRA) as i64, semantic.TIPO_INT as u32)
        i.op_aux = 1
        elementos[j] = lw_valor_temp(i.destino, i.tipo)
    }
    let junta: ^IrInstr = lw_nova_instr(c, IR_ARRAY, e.pos_op)
    junta.destino = lw_novo_temp(c)
    junta.tipo = e.tipo
    junta.args = elementos
    junta.nargs = letras
    return lw_valor_temp(junta.destino, junta.tipo)
}
