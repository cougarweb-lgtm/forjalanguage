import "common"
import "frontend"
import "semantic"

const BITS_POR_BYTE: i32 = 8
const PADRAO_PARES: i32 = 85
const PADRAO_QUARTETOS: i32 = 51
const PADRAO_NIBBLE_BAIXO: i32 = 15
const PADRAO_BYTE: i32 = 255
const PADRAO_UM: i32 = 1

// C: ir/lower_bits.c:18
proc repetido(k: ^LoCtx, tipo: u32, padrao: u64) -> Valor {
    var bits: u64 = 0
    var b: u32 = 0
    while b < (lo_largura(k, tipo) / (BITS_POR_BYTE as u32)) {
        bits = bits | (padrao << ((((BITS_POR_BYTE as u32) * b) as u64) & 63))
        b += 1
    }
    return lw_valor_int(transmute(bits, to = i64), tipo)
}

// C: ir/lower_bits.c:25
proc deslocar(k: ^LoCtx, sentido: u8, x: Valor, quanto: u32) -> Valor {
    let arg_1: Valor = lw_valor_int(quanto as i64, x.tipo)
    let arg_2: Valor = x
    let arg_3: u32 = x.tipo
    let arg_4: u8 = sentido
    let arg_5: ^LoCtx = k
    return lo_binario(arg_5, arg_4, arg_3, arg_2, arg_1)
}

// C: ir/lower_bits.c:30
proc operar_2(k: ^LoCtx, operador: u8, a: Valor, b: Valor) -> Valor {
    return lo_binario(k, operador, a.tipo, a, b)
}

// C: ir/lower_bits.c:36
proc unidades(k: ^LoCtx, x: Valor) -> Valor {
    let t: u32 = x.tipo
    let arg_1: Valor = repetido(k, t, PADRAO_PARES as u64)
    let arg_2: Valor = deslocar(k, frontend.OP_DESLOCA_DIR as u8, x, 1)
    let arg_3: ^LoCtx = k
    let pares: Valor = operar_2(k, frontend.OP_SUB as u8, x, operar_2(arg_3, frontend.OP_BIT_E as u8, arg_2, arg_1))
    let q: Valor = repetido(k, t, PADRAO_QUARTETOS as u64)
    let arg_4: Valor = operar_2(k, frontend.OP_BIT_E as u8, deslocar(k, frontend.OP_DESLOCA_DIR as u8, pares, 2), q)
    let arg_5: Valor = operar_2(k, frontend.OP_BIT_E as u8, pares, q)
    let arg_6: ^LoCtx = k
    let quartetos: Valor = operar_2(arg_6, frontend.OP_SOMA as u8, arg_5, arg_4)
    let arg_7: Valor = repetido(k, t, PADRAO_NIBBLE_BAIXO as u64)
    let arg_8: Valor = operar_2(k, frontend.OP_SOMA as u8, quartetos, deslocar(k, frontend.OP_DESLOCA_DIR as u8, quartetos, 4))
    let arg_9: ^LoCtx = k
    let bytes: Valor = operar_2(arg_9, frontend.OP_BIT_E as u8, arg_8, arg_7)
    let largura: u32 = lo_largura(k, t)
    if largura == (BITS_POR_BYTE as u32) {
        return bytes
    }
    return deslocar(k, frontend.OP_DESLOCA_DIR as u8, operar_2(k, frontend.OP_MUL_VOLTA as u8, bytes, repetido(k, t, PADRAO_UM as u64)), largura - (BITS_POR_BYTE as u32))
}

// C: ir/lower_bits.c:50
proc espalhar(k: ^LoCtx, x: Valor) -> Valor {
    var x_v: Valor = x
    var passo: u32 = 1
    while passo < lo_largura(k, x_v.tipo) {
        x_v = operar_2(k, frontend.OP_BIT_OU as u8, x_v, deslocar(k, frontend.OP_DESLOCA_DIR as u8, x_v, passo))
        passo = passo * 2
    }
    return x_v
}

// C: ir/lower_bits.c:56
proc zeros_na_frente(k: ^LoCtx, x: Valor) -> Valor {
    return unidades(k, lo_bit_nao(k, espalhar(k, x)))
}

// C: ir/lower_bits.c:61
proc zeros_atras(k: ^LoCtx, x: Valor) -> Valor {
    let menos_um: Valor = operar_2(k, frontend.OP_SUB_VOLTA as u8, x, lw_valor_int(1, x.tipo))
    return unidades(k, operar_2(k, frontend.OP_BIT_E as u8, lo_bit_nao(k, x), menos_um))
}

// C: ir/lower_bits.c:67
proc trocar_bytes(k: ^LoCtx, x: Valor) -> Valor {
    let bytes: u32 = lo_largura(k, x.tipo) / (BITS_POR_BYTE as u32)
    var trocado: Valor = lw_valor_nenhum()
    for b in (0 as u32)..<bytes {
        let arg_1: Valor = lw_valor_int(PADRAO_BYTE as i64, x.tipo)
        let arg_2: Valor = deslocar(k, frontend.OP_DESLOCA_DIR as u8, x, (BITS_POR_BYTE as u32) * b)
        let arg_3: ^LoCtx = k
        let byte: Valor = operar_2(arg_3, frontend.OP_BIT_E as u8, arg_2, arg_1)
        let posto: Valor = deslocar(k, frontend.OP_DESLOCA_ESQ as u8, byte, (BITS_POR_BYTE as u32) * ((bytes - 1) - b))
        var tern_1: Valor = Valor{}
        if b == 0 {
            tern_1 = posto
        } else {
            tern_1 = operar_2(k, frontend.OP_BIT_OU as u8, trocado, posto)
        }
        trocado = tern_1
    }
    return trocado
}

// C: ir/lower_bits.c:80
proc contagem_da_rotacao(k: ^LoCtx, sem_sinal: u32, n: Valor) -> Valor {
    let volta: u64 = (lo_largura(k, sem_sinal) - 1) as u64
    if n.tipo_no == (V_INT as u8) {
        return lw_valor_int(transmute(common.c2f_s2u_64(n.inteiro) & volta, to = i64), sem_sinal)
    }
    let tipo_n: u32 = lo_sem_sinal(n.tipo)
    let arg_1: Valor = lw_valor_int(transmute(volta, to = i64), tipo_n)
    let arg_2: Valor = lo_transmuta(k, tipo_n, n)
    let arg_3: u32 = tipo_n
    let arg_4: ^LoCtx = k
    let mascarado: Valor = lo_binario(arg_4, frontend.OP_BIT_E as u8, arg_3, arg_2, arg_1)
    return lo_converte(k, sem_sinal, mascarado)
}

// C: ir/lower_bits.c:89
proc rotacionar(k: ^LoCtx, esquerda: bool, x: Valor, n: Valor) -> Valor {
    let tipo: u32 = x.tipo
    let sem_sinal: u32 = lo_sem_sinal(tipo)
    let bits: Valor = lo_transmuta(k, sem_sinal, x)
    let passos: Valor = contagem_da_rotacao(k, sem_sinal, n)
    let largura: Valor = lw_valor_int(lo_largura(k, sem_sinal) as i64, sem_sinal)
    var tern_1: Valor = Valor{}
    if passos.tipo_no == (V_INT as u8) {
        tern_1 = lw_valor_int(largura.inteiro - passos.inteiro, sem_sinal)
    } else {
        tern_1 = operar_2(k, frontend.OP_SUB as u8, largura, passos)
    }
    let resto: Valor = tern_1
    var tern_2: i32 = frontend.OP_DESLOCA_DIR
    if common.c2f_b2i32(esquerda) != 0 {
        tern_2 = frontend.OP_DESLOCA_ESQ
    }
    let um_lado: Valor = operar_2(k, tern_2 as u8, bits, passos)
    var tern_3: i32 = frontend.OP_DESLOCA_ESQ
    if common.c2f_b2i32(esquerda) != 0 {
        tern_3 = frontend.OP_DESLOCA_DIR
    }
    let outro_lado: Valor = operar_2(k, tern_3 as u8, bits, resto)
    return lo_transmuta(k, tipo, operar_2(k, frontend.OP_BIT_OU as u8, um_lado, outro_lado))
}

// C: ir/lower_bits.c:101
proc lw_bits(c: ^LowerCtx, e: ^frontend.Expr) -> Valor {
    var k = LoCtx{c = c, pos = e.pos_op}
    var op: [2]Valor = {}
    var i: u32 = 0
    while i < e.nargs {
        let parte: frontend.Arg = (e.args or_else {})[i]
        op[parte.indice as u32] = lw_expr(c, parte.valor)
        i += 1
    }
    op[0] = lo_em_local(&k, op[0])
    if (e.ref_id == frontend.EMB_ROTATE_LEFT) or (e.ref_id == frontend.EMB_ROTATE_RIGHT) {
        return rotacionar(&k, e.ref_id == frontend.EMB_ROTATE_LEFT, op[0], op[1])
    }
    let tipo: u32 = op[0].tipo
    let sem_sinal: u32 = lo_sem_sinal(tipo)
    let bits: Valor = lo_transmuta(&k, sem_sinal, op[0])
    if e.ref_id == frontend.EMB_BYTE_SWAP {
        return lo_transmuta(&k, tipo, trocar_bytes(&k, bits))
    }
    var contagem: Valor = Valor{}
    if e.ref_id == frontend.EMB_COUNT_ONES {
        contagem = unidades(&k, bits)
    } else {
        if e.ref_id == frontend.EMB_LEADING_ZEROS {
            contagem = zeros_na_frente(&k, bits)
        } else {
            contagem = zeros_atras(&k, bits)
        }
    }
    return lo_converte(&k, semantic.TIPO_INT as u32, contagem)
}

// Valores do C (Repetido e ContagemDaRotacao em lower_bits.c; constantes, sem instrucao).
test "lower_bits: repetido e contagem da rotacao segue o C" {
    var lc = LowerCtx{}
    var sem = semantic.Semantica{}
    lc.sem = &sem
    var k = LoCtx{c = &lc, pos = 1}
    expect(repetido(&k, semantic.TIPO_U16 as u32, 0x55).inteiro == 0x5555)
    expect(repetido(&k, semantic.TIPO_U32 as u32, 0x33).inteiro == 0x33333333)
    expect(repetido(&k, semantic.TIPO_U8 as u32, 0x0F).inteiro == 0x0F)
    expect(contagem_da_rotacao(&k, semantic.TIPO_U32 as u32, lw_valor_int(35, semantic.TIPO_INT as u32)).inteiro == 3)
    expect(contagem_da_rotacao(&k, semantic.TIPO_U8 as u32, lw_valor_int(-1, semantic.TIPO_INT as u32)).inteiro == 7)
}
