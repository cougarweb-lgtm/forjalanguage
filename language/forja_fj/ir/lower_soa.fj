import "common"
import "frontend"
import "semantic"

// C: ir/lower_soa.c:8
proc classe_de_3(c: ^LowerCtx, t: u32) -> i32 {
    return semantic.tipo_classe_de(&(c.sem as ^semantic.Semantica).tipos, t)
}

// C: ir/lower_soa.c:14
proc instr_com_temp_6(c: ^LowerCtx, op: i32, pos: u32, tipo: u32) -> ^IrInstr {
    let i: ^IrInstr = lw_nova_instr(c, op, pos)
    i.destino = lw_novo_temp(c)
    i.tipo = tipo
    return i
}

// C: ir/lower_soa.c:23
proc base_da_soa(c: ^LowerCtx, base: ?^frontend.Expr) -> Valor {
    if ((base as ^frontend.Expr).tipo_no != (frontend.EX_NOME as u8)) and (common.c2f_b2i32(lw_enderecavel(c, base)) != 0) {
        return lw_endereco(c, base)
    }
    return lw_base_indexada(c, base)
}

// C: ir/lower_soa.c:30
proc lw_indice_soa(c: ^LowerCtx, e: ^frontend.Expr) -> Valor {
    let base: Valor = base_da_soa(c, e.a)
    let indice: Valor = lw_indice_int(c, e.b)
    let i: ^IrInstr = instr_com_temp_6(c, IR_SOA_ELEMENTO, e.pos_op, e.tipo)
    i.a = base
    i.b = indice
    return lw_valor_temp(i.destino, i.tipo)
}

// C: ir/lower_soa.c:41
proc lw_campo_de_soa(c: ^LowerCtx, e: ^frontend.Expr) -> bool {
    if e.ref != (frontend.REF_CAMPO as u8) {
        return false
    }
    if ((e.a as ^frontend.Expr).tipo_no == (frontend.EX_INDICE as u8)) and (common.c2f_s2u_32(classe_de_3(c, ((e.a as ^frontend.Expr).a as ^frontend.Expr).tipo)) == (semantic.TC_SOA as u32)) {
        return true
    }
    return common.c2f_s2u_32(classe_de_3(c, (e.a as ^frontend.Expr).tipo)) == (semantic.TC_SOA as u32)
}

// C: ir/lower_soa.c:49
proc lw_campo_soa(c: ^LowerCtx, e: ^frontend.Expr) -> Valor {
    if ((e.a as ^frontend.Expr).tipo_no == (frontend.EX_INDICE as u8)) and (common.c2f_s2u_32(classe_de_3(c, ((e.a as ^frontend.Expr).a as ^frontend.Expr).tipo)) == (semantic.TC_SOA as u32)) {
        let base: Valor = base_da_soa(c, (e.a as ^frontend.Expr).a)
        let indice: Valor = lw_indice_int(c, (e.a as ^frontend.Expr).b)
        let i: ^IrInstr = instr_com_temp_6(c, IR_SOA_CAMPO, e.pos_op, e.tipo)
        i.a = base
        i.b = indice
        i.nome = e.nome
        return lw_valor_temp(i.destino, i.tipo)
    }
    let soa: Valor = lw_endereco(c, e.a)
    let i: ^IrInstr = instr_com_temp_6(c, IR_SOA_COLUNA, e.pos_op, e.tipo)
    i.a = soa
    i.nome = e.nome
    return lw_valor_temp(i.destino, i.tipo)
}

// C: ir/lower_soa.c:68
proc lw_endereco_campo_soa(c: ^LowerCtx, e: ?^frontend.Expr) -> Valor {
    let base: Valor = base_da_soa(c, ((e as ^frontend.Expr).a as ^frontend.Expr).a)
    let indice: Valor = lw_indice_int(c, ((e as ^frontend.Expr).a as ^frontend.Expr).b)
    let arg_1: u32 = semantic.tipo_ponteiro(&(c.sem as ^semantic.Semantica).tipos, (e as ^frontend.Expr).tipo)
    let arg_2: u32 = (e as ^frontend.Expr).pos_op
    let arg_3: ^LowerCtx = c
    let i: ^IrInstr = instr_com_temp_6(arg_3, IR_SOA_END_CAMPO, arg_2, arg_1)
    i.a = base
    i.b = indice
    i.nome = (e as ^frontend.Expr).nome
    return lw_valor_temp(i.destino, i.tipo)
}

// C: ir/lower_soa.c:80
proc soa_do_tipo(c: ^LowerCtx, t: u32) -> u32 {
    var tern_1: u32 = t
    if common.c2f_s2u_32(classe_de_3(c, t)) == (semantic.TC_PONTEIRO as u32) {
        tern_1 = semantic.tipo_de(&(c.sem as ^semantic.Semantica).tipos, t).a
    }
    return tern_1
}

// C: ir/lower_soa.c:86
proc base_do_for_soa(c: ^LowerCtx, e: ?^frontend.Expr, tamanho: ^Valor) -> Valor {
    let soa: u32 = soa_do_tipo(c, (e as ^frontend.Expr).tipo)
    var tern_1: Valor = Valor{}
    if common.c2f_b2i32(lw_enderecavel(c, e)) != 0 {
        tern_1 = lw_endereco(c, e)
    } else {
        tern_1 = lw_expr(c, e)
    }
    let base: Valor = tern_1
    let colunas: u32 = semantic.tipo_de(&(c.sem as ^semantic.Semantica).tipos, soa).a
    if common.c2f_s2u_32(classe_de_3(c, colunas)) == (semantic.TC_ARRAY as u32) {
        tamanho^ = lw_valor_int(semantic.tipo_de(&(c.sem as ^semantic.Semantica).tipos, colunas).b as i64, semantic.TIPO_INT as u32)
        return base
    }
    let t: ^IrInstr = instr_com_temp_6(c, IR_TAMANHO_TEXTO, (e as ^frontend.Expr).pos_op, semantic.TIPO_INT as u32)
    t.a = base
    tamanho^ = lw_valor_temp(t.destino, semantic.TIPO_INT as u32)
    return base
}

// C: ir/lower_soa.c:102
proc lw_for_soa(c: ^LowerCtx, s: ^frontend.Stmt) {
    var n: Valor = Valor{}
    let base: Valor = base_do_for_soa(c, s.expr, &n)
    var tern_1: i32 = 0
    if s.local_indice >= 0 {
        tern_1 = s.local_indice
    } else {
        tern_1 = lw_novo_local(c)
    }
    let contador: i32 = tern_1
    let laco: ^IrInstr = lw_nova_instr(c, IR_PARA, s.pos)
    laco.destino = contador
    laco.tipo = semantic.TIPO_INT as u32
    laco.a = lw_valor_int(0, semantic.TIPO_INT as u32)
    laco.b = n
    laco.faixa_excl = true
    let externo: ^IrBloco = lw_trocar_bloco(c, &laco.corpo)
    let elemento: ^IrInstr = instr_com_temp_6(c, IR_SOA_ELEMENTO, s.pos, s.tipo_local)
    elemento.a = base
    elemento.b = lw_valor_local(contador, semantic.TIPO_INT as u32)
    let item: ^IrInstr = lw_nova_instr(c, IR_LOCAL, s.pos)
    item.destino = s.local_id
    item.tipo = s.tipo_local
    item.a = lw_valor_temp(elemento.destino, elemento.tipo)
    item.mutavel = false
    lw_bloco(c, s.corpo, true)
    _ = lw_trocar_bloco(c, externo)
}
