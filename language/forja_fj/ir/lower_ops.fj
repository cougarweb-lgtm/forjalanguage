import "common"
import "frontend"
import "semantic"

struct LoCtx {
    c: ?^LowerCtx
    pos: u32
}

const BITS_POR_INT64: i32 = 64

// C: ir/lower_ops.c:12
proc lo_sem_sinal(tipo: u32) -> u32 {
    if tipo == (semantic.TIPO_I8 as u32) {
        return semantic.TIPO_U8 as u32
    } else if tipo == (semantic.TIPO_I16 as u32) {
        return semantic.TIPO_U16 as u32
    } else if tipo == (semantic.TIPO_I32 as u32) {
        return semantic.TIPO_U32 as u32
    } else if tipo == (semantic.TIPO_INT as u32) {
        return semantic.TIPO_UINT as u32
    } else {
        return tipo
    }
    return 0
}

// C: ir/lower_ops.c:23
proc lo_largura(k: ^LoCtx, tipo: u32) -> u32 {
    return semantic.tipo_largura_bits(&((k.c as ^LowerCtx).sem as ^semantic.Semantica).tipos, tipo) as u32
}

// C: ir/lower_ops.c:28
proc lo_mascara(k: ^LoCtx, tipo_sem_sinal: u32, bits: u64) -> Valor {
    var bits_v: u64 = bits
    let largura: u32 = lo_largura(k, tipo_sem_sinal)
    if largura < (BITS_POR_INT64 as u32) {
        let um: u64 = 1
        bits_v = bits_v & ((um << ((largura as u64) & 63)) - 1)
    }
    return lw_valor_int(transmute(bits_v, to = i64), tipo_sem_sinal)
}

// C: ir/lower_ops.c:35
proc instr_com_temp_5(k: ^LoCtx, op: i32, tipo: u32, a: Valor, b: Valor) -> Valor {
    let i: ^IrInstr = lw_nova_instr(k.c as ^LowerCtx, op, k.pos)
    i.destino = lw_novo_temp(k.c as ^LowerCtx)
    i.tipo = tipo
    i.a = a
    i.b = b
    return lw_valor_temp(i.destino, tipo)
}

// C: ir/lower_ops.c:45
proc lo_binario(k: ^LoCtx, operador: u8, tipo: u32, a: Valor, b: Valor) -> Valor {
    let i: ^IrInstr = lw_nova_instr(k.c as ^LowerCtx, IR_BINARIO, k.pos)
    i.destino = lw_novo_temp(k.c as ^LowerCtx)
    i.tipo = tipo
    i.op_aux = operador
    i.a = a
    i.b = b
    return lw_valor_temp(i.destino, tipo)
}

// C: ir/lower_ops.c:56
proc unario(k: ^LoCtx, operador: u8, tipo: u32, a: Valor) -> Valor {
    let i: ^IrInstr = lw_nova_instr(k.c as ^LowerCtx, IR_UNARIO, k.pos)
    i.destino = lw_novo_temp(k.c as ^LowerCtx)
    i.tipo = tipo
    i.op_aux = operador
    i.a = a
    return lw_valor_temp(i.destino, tipo)
}

// C: ir/lower_ops.c:66
proc lo_nao(k: ^LoCtx, a: Valor) -> Valor {
    return unario(k, frontend.OP_NAO as u8, semantic.TIPO_BOOL as u32, a)
}

// C: ir/lower_ops.c:71
proc lo_bit_nao(k: ^LoCtx, a: Valor) -> Valor {
    return unario(k, frontend.OP_BIT_NAO as u8, a.tipo, a)
}

// C: ir/lower_ops.c:77
proc lo_converte(k: ^LoCtx, alvo: u32, a: Valor) -> Valor {
    if a.tipo == alvo {
        return a
    }
    if a.tipo_no == (V_INT as u8) {
        return lw_valor_int(a.inteiro, alvo)
    }
    return instr_com_temp_5(k, IR_CONVERSAO, alvo, a, lw_valor_nenhum())
}

// C: ir/lower_ops.c:85
proc lo_transmuta(k: ^LoCtx, alvo: u32, a: Valor) -> Valor {
    if a.tipo == alvo {
        return a
    }
    if (a.tipo_no == (V_INT as u8)) and (common.c2f_b2i32(semantic.tipo_eh_sem_sinal(alvo)) != 0) {
        return lo_mascara(k, alvo, common.c2f_s2u_64(a.inteiro))
    }
    return instr_com_temp_5(k, IR_TRANSMUTA, alvo, a, lw_valor_nenhum())
}

// C: ir/lower_ops.c:92
proc lo_local(k: ^LoCtx, tipo: u32, inicial: Valor) -> i32 {
    let def: ^IrInstr = lw_nova_instr(k.c as ^LowerCtx, IR_LOCAL, k.pos)
    def.destino = lw_novo_local(k.c as ^LowerCtx)
    def.tipo = tipo
    def.mutavel = true
    def.a = inicial
    return def.destino
}

// C: ir/lower_ops.c:102
proc lo_em_local(k: ^LoCtx, v: Valor) -> Valor {
    if v.tipo_no != (V_INT as u8) {
        return v
    }
    let arg_1: u32 = v.tipo
    let arg_2: i32 = lo_local(k, v.tipo, v)
    return lw_valor_local(arg_2, arg_1)
}

// C: ir/lower_ops.c:108
proc lo_atribui(k: ^LoCtx, local: i32, tipo: u32, valor: Valor) {
    let i: ^IrInstr = lw_nova_instr(k.c as ^LowerCtx, IR_ATRIBUICAO, k.pos)
    i.destino = local
    i.tipo = tipo
    i.a = valor
}

// C: ir/lower_ops.c:116
proc lo_entra_se(k: ^LoCtx, condicao: Valor) -> ^IrBloco {
    let se: ^IrInstr = lw_nova_instr(k.c as ^LowerCtx, IR_SE, k.pos)
    se.a = condicao
    return lw_trocar_bloco(k.c as ^LowerCtx, &se.corpo)
}

// C: ir/lower_ops.c:123
proc lo_sai_do_se(k: ^LoCtx, externo: ^IrBloco) {
    _ = lw_trocar_bloco(k.c as ^LowerCtx, externo)
}

// Testes dirigidos (valores do C: lower_ops.c; LARGURA_FIXA do semantic/tipos).
test "lower_ops: sem sinal e mascara" {
    expect(lo_sem_sinal(semantic.TIPO_I8 as u32) == semantic.TIPO_U8 as u32)
    expect(lo_sem_sinal(semantic.TIPO_INT as u32) == semantic.TIPO_UINT as u32)
    expect(lo_sem_sinal(semantic.TIPO_BOOL as u32) == semantic.TIPO_BOOL as u32)
    var lc = LowerCtx{}
    var sem = semantic.Semantica{}
    lc.sem = &sem
    var k = LoCtx{c = &lc, pos = 1}
    expect(lo_mascara(&k, semantic.TIPO_U8 as u32, 0x1FF).inteiro == 0xFF)
    expect(lo_mascara(&k, semantic.TIPO_U32 as u32, 0x1FFFFFFFF).inteiro == 0xFFFFFFFF)
    expect(lo_transmuta(&k, semantic.TIPO_U8 as u32, lw_valor_int(-1, semantic.TIPO_INT as u32)).inteiro == 0xFF)
    expect(lo_converte(&k, semantic.TIPO_U16 as u32, lw_valor_int(5, semantic.TIPO_INT as u32)).tipo == semantic.TIPO_U16 as u32)
}

test "lower_ops: instrucoes no bloco e se" {
    var a = common.Arena{}
    var sem = semantic.Semantica{}
    var lc = LowerCtx{}
    lc.sem = &sem
    lc.arena = &a
    var bloco = IrBloco{}
    lc.atual = &bloco
    var k = LoCtx{c = &lc, pos = 3}
    let nao = lo_nao(&k, lw_valor_bool(true))
    expect(nao.tipo_no == V_TEMP as u8 and nao.tipo == semantic.TIPO_BOOL as u32)
    let primeira_nao: ^IrInstr = bloco.primeira as ^IrInstr
    expect(primeira_nao.op == (IR_UNARIO as u8) and primeira_nao.op_aux == (frontend.OP_NAO as u8))
    let fora = lo_entra_se(&k, lw_valor_bool(true))
    expect((fora as ^IrBloco) == &bloco)
    lo_sai_do_se(&k, fora)
    expect((lc.atual as ^IrBloco) == &bloco)
    common.arena_liberar(&a)
}
