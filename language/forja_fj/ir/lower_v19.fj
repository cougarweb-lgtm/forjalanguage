import "common"
import "frontend"
import "semantic"

// C: ir/lower_v19.c:12
proc classe_de_4(c: ^LowerCtx, t: u32) -> i32 {
    return semantic.tipo_classe_de(&(c.sem as ^semantic.Semantica).tipos, t)
}

// C: ir/lower_v19.c:18
proc conjunto(c: ^LowerCtx, op_aux: u8, pos: u32, tipo: u32, a: Valor, b: Valor) -> Valor {
    let i: ^IrInstr = lw_nova_instr(c, IR_CONJUNTO, pos)
    i.op_aux = op_aux
    i.tipo = tipo
    i.a = a
    i.b = b
    if tipo == (semantic.TIPO_VAZIO as u32) {
        return lw_valor_nenhum()
    }
    i.destino = lw_novo_temp(c)
    return lw_valor_temp(i.destino, tipo)
}

// C: ir/lower_v19.c:31
proc matriz(c: ^LowerCtx, op_aux: u8, pos: u32, tipo: u32, a: Valor, b: Valor) -> Valor {
    let i: ^IrInstr = lw_nova_instr(c, IR_MATRIZ, pos)
    i.op_aux = op_aux
    i.tipo = tipo
    i.a = a
    i.b = b
    i.destino = lw_novo_temp(c)
    return lw_valor_temp(i.destino, tipo)
}

// C: ir/lower_v19.c:43
proc argumento_de_3(e: ^frontend.Expr, indice: i32) -> ?^frontend.Expr {
    for k in (0 as u32)..<e.nargs {
        if (e.args or_else {})[k].indice == indice {
            return (e.args or_else {})[k].valor
        }
    }
    return none
}

// C: ir/lower_v19.c:52
proc classe_sem_ponteiro(c: ^LowerCtx, t: u32) -> i32 {
    var t_v: u32 = t
    if common.c2f_s2u_32(classe_de_4(c, t_v)) == (semantic.TC_PONTEIRO as u32) {
        t_v = semantic.tipo_de(&(c.sem as ^semantic.Semantica).tipos, t_v).a
    }
    return classe_de_4(c, t_v)
}

// C: ir/lower_v19.c:59
proc eh_bit_set(c: ^LowerCtx, t: u32) -> bool {
    return common.c2f_s2u_32(classe_sem_ponteiro(c, t)) == (semantic.TC_BIT_SET as u32)
}

// C: ir/lower_v19.c:65
proc eh_mapa(c: ^LowerCtx, t: u32) -> bool {
    return common.c2f_s2u_32(classe_sem_ponteiro(c, t)) == (semantic.TC_MAPA as u32)
}

// C: ir/lower_v19.c:70
proc lw_eh_v19(c: ^LowerCtx, t: u32) -> bool {
    var t_v: u32 = t
    if common.c2f_s2u_32(classe_de_4(c, t_v)) == (semantic.TC_PONTEIRO as u32) {
        t_v = semantic.tipo_de(&(c.sem as ^semantic.Semantica).tipos, t_v).a
    }
    return common.c2f_s2u_32(classe_de_4(c, t_v)) >= (semantic.TC_MAPA as u32)
}

// C: ir/lower_v19.c:77
proc literal_matriz(c: ^LowerCtx, e: ^frontend.Expr) -> Valor {
    if e.nargs == 0 {
        return lw_zero_composto(c, e.tipo, e.pos_op)
    }
    var elementos: []Valor = vetor_args_zerados(c, e.nargs)
    for k in (0 as u32)..<e.nargs {
        let argumento: frontend.Arg = (e.args or_else {})[k]
        elementos[k] = lw_expr(c, argumento.valor)
    }
    let i: ^IrInstr = lw_nova_instr(c, IR_MATRIZ, e.pos_op)
    i.op_aux = 8
    i.tipo = e.tipo
    i.args = elementos
    i.nargs = e.nargs
    i.destino = lw_novo_temp(c)
    return lw_valor_temp(i.destino, e.tipo)
}

// C: ir/lower_v19.c:92
proc lw_literal_v19(c: ^LowerCtx, e: ^frontend.Expr) -> Valor {
    if classe_de_4(c, e.tipo) == semantic.TC_MATRIZ {
        return literal_matriz(c, e)
    }
    if classe_de_4(c, e.tipo) == semantic.TC_SOA {
        return lw_zero_composto(c, e.tipo, e.pos_op)
    }
    if classe_de_4(c, e.tipo) != semantic.TC_BIT_SET {
        let msg_1 = format(f"lowering: literal de tipo {e.tipo} sem lowering (offset {e.pos_op})", alloc = heap)
        defer delete(msg_1)
        common.falha_interna(msg_1)
    }
    var mascara: u64 = 0
    var variaveis: []Valor = vetor_args_zerados(c, e.nargs)
    var qtd: u32 = 0
    for k in (0 as u32)..<e.nargs {
        let argumento: frontend.Arg = (e.args or_else {})[k]
        let v: Valor = lw_expr(c, argumento.valor)
        if v.tipo_no == (V_INT as u8) {
            let bit: u64 = (1 as u64) << (v.inteiro as u64)
            mascara = mascara | bit
        } else {
            variaveis[qtd] = v
            qtd += 1
        }
    }
    var resultado: Valor = lw_valor_int(mascara as i64, e.tipo)
    for k in (0 as u32)..<qtd {
        resultado = conjunto(c, 7, e.pos_op, e.tipo, resultado, variaveis[k])
    }
    return resultado
}

// C: ir/lower_v19.c:112
proc binario_matriz(c: ^LowerCtx, e: ^frontend.Expr, ca: i32, cb: i32) -> Valor {
    var tern_1: i32 = 1
    if e.op == (frontend.OP_SOMA as u8) {
        tern_1 = 0
    }
    var op_aux: u8 = tern_1 as u8
    if e.op == (frontend.OP_MUL as u8) {
        if (common.c2f_s2u_32(ca) == (semantic.TC_MATRIZ as u32)) and (common.c2f_s2u_32(cb) == (semantic.TC_MATRIZ as u32)) {
            op_aux = 2
        } else if common.c2f_s2u_32(ca) != (semantic.TC_MATRIZ as u32) {
            op_aux = 4
        } else {
            var tern_2: i32 = 3
            if common.c2f_s2u_32(cb) == (semantic.TC_ARRAY as u32) {
                tern_2 = 5
            }
            op_aux = tern_2 as u8
        }
    }
    let a: Valor = lw_expr(c, e.a)
    let b: Valor = lw_expr(c, e.b)
    return matriz(c, op_aux, e.pos_op, e.tipo, a, b)
}

// C: ir/lower_v19.c:126
proc lw_binario_v19(c: ^LowerCtx, e: ^frontend.Expr, saida: ^Valor) -> bool {
    let ca: i32 = classe_de_4(c, (e.a as ^frontend.Expr).tipo)
    let cb: i32 = classe_de_4(c, (e.b as ^frontend.Expr).tipo)
    if (common.c2f_s2u_32(ca) == (semantic.TC_MATRIZ as u32)) or (common.c2f_s2u_32(cb) == (semantic.TC_MATRIZ as u32)) {
        saida^ = binario_matriz(c, e, ca, cb)
        return true
    }
    if (e.op != (frontend.OP_SUB as u8)) or (common.c2f_s2u_32(classe_de_4(c, e.tipo)) != (semantic.TC_BIT_SET as u32)) {
        return false
    }
    let a: Valor = lw_expr(c, e.a)
    let b: Valor = lw_expr(c, e.b)
    saida^ = conjunto(c, 2, e.pos_op, e.tipo, a, b)
    return true
}

// C: ir/lower_v19.c:141
proc lw_matriz_unaria(c: ^LowerCtx, e: ^frontend.Expr, op_aux: u8) -> Valor {
    let a: Valor = lw_expr(c, e.a)
    let arg_1: Valor = lw_valor_nenhum()
    let arg_2: Valor = a
    let arg_3: u32 = e.tipo
    let arg_4: u32 = e.pos
    let arg_5: u8 = op_aux
    let arg_6: ^LowerCtx = c
    return matriz(arg_6, arg_5, arg_4, arg_3, arg_2, arg_1)
}

// C: ir/lower_v19.c:148
proc lw_indice_matriz(c: ^LowerCtx, e: ^frontend.Expr) -> Valor {
    let base: Valor = lw_base_indexada(c, e.a)
    let linha: Valor = lw_indice_int(c, e.b)
    let argumento: frontend.Arg = (e.args or_else {})[0]
    let coluna: Valor = lw_indice_int(c, argumento.valor)
    let i: ^IrInstr = lw_nova_instr(c, IR_MATRIZ_ELEMENTO, e.pos_op)
    i.destino = lw_novo_temp(c)
    i.tipo = e.tipo
    i.a = base
    i.b = linha
    var args: []Valor = vetor_args_zerados(c, 1)
    args[0] = coluna
    i.args = args
    i.nargs = 1
    return lw_valor_temp(i.destino, i.tipo)
}

// C: ir/lower_v19.c:165
proc lw_endereco_matriz(c: ^LowerCtx, e: ?^frontend.Expr) -> Valor {
    let ex: ^frontend.Expr = e as ^frontend.Expr
    let pelo_endereco: bool = ((ex.a as ^frontend.Expr).tipo_no != (frontend.EX_NOME as u8)) and (classe_de_4(c, (ex.a as ^frontend.Expr).tipo) == semantic.TC_MATRIZ) and lw_enderecavel(c, ex.a)
    var base: Valor = lw_valor_nenhum()
    if pelo_endereco {
        base = lw_endereco(c, ex.a)
    } else {
        base = lw_base_indexada(c, ex.a)
    }
    let linha: Valor = lw_indice_int(c, ex.b)
    let argumento: frontend.Arg = (ex.args or_else {})[0]
    let coluna: Valor = lw_indice_int(c, argumento.valor)
    let i: ^IrInstr = lw_nova_instr(c, IR_MATRIZ_END_ELEMENTO, ex.pos_op)
    i.destino = lw_novo_temp(c)
    i.tipo = semantic.tipo_ponteiro(&(c.sem as ^semantic.Semantica).tipos, ex.tipo)
    i.a = base
    i.b = linha
    var args: []Valor = vetor_args_zerados(c, 1)
    args[0] = coluna
    i.args = args
    i.nargs = 1
    return lw_valor_temp(i.destino, i.tipo)
}

// C: ir/lower_v19.c:183
proc lw_embutido_v19(c: ^LowerCtx, e: ^frontend.Expr) -> Valor {
    if e.ref_id == frontend.EMB_TRANSPOSE {
        let origem: Valor = lw_expr(c, argumento_de_3(e, 0))
        let arg_1: Valor = lw_valor_nenhum()
        let arg_2: Valor = origem
        let arg_3: u32 = e.tipo
        let arg_4: u32 = e.pos_op
        let arg_5: ^LowerCtx = c
        return matriz(arg_5, 7, arg_4, arg_3, arg_2, arg_1)
    }
    let colecao: ?^frontend.Expr = argumento_de_3(e, 0)
    let chave: ?^frontend.Expr = argumento_de_3(e, 1)
    if ((colecao != none) and (chave != none)) and (common.c2f_b2i32(eh_mapa(c, (colecao as ^frontend.Expr).tipo)) != 0) {
        return lw_embutido_mapa(c, e)
    }
    if (((((colecao == none) or (chave == none)) or (e.ref_id == frontend.EMB_GET)) or (e.ref_id == frontend.EMB_GET_PTR)) or (e.ref_id == frontend.EMB_TRANSPOSE)) or (not eh_bit_set(c, (colecao as ^frontend.Expr).tipo)) {
        let msg_1 = format(f"lowering: embutido {e.ref_id} invalido para a colecao (offset {e.pos_op})", alloc = heap)
        defer delete(msg_1)
        common.falha_interna(msg_1)
    }
    let s: Valor = lw_expr(c, colecao)
    let m: Valor = lw_expr(c, chave)
    if e.ref_id == frontend.EMB_HAS {
        return conjunto(c, 3, e.pos_op, semantic.TIPO_BOOL as u32, s, m)
    }
    var tern_1: i32 = 5
    if e.ref_id == frontend.EMB_INSERT {
        tern_1 = 4
    }
    return conjunto(c, tern_1 as u8, e.pos_op, semantic.TIPO_VAZIO as u32, s, m)
}

// C: ir/lower_v19.c:202
proc tamanho_da_soa(c: ^LowerCtx, arg: ?^frontend.Expr, soa: u32) -> Valor {
    let colunas: u32 = semantic.tipo_de(&(c.sem as ^semantic.Semantica).tipos, soa).a
    if common.c2f_s2u_32(classe_de_4(c, colunas)) == (semantic.TC_ARRAY as u32) {
        return lw_valor_int(semantic.tipo_de(&(c.sem as ^semantic.Semantica).tipos, colunas).b as i64, semantic.TIPO_INT as u32)
    }
    let origem: Valor = lw_expr(c, arg)
    let i: ^IrInstr = lw_nova_instr(c, IR_TAMANHO_TEXTO, (arg as ^frontend.Expr).pos_op)
    i.destino = lw_novo_temp(c)
    i.tipo = semantic.TIPO_INT as u32
    i.a = origem
    return lw_valor_temp(i.destino, semantic.TIPO_INT as u32)
}

// C: ir/lower_v19.c:215
proc tamanho_do_mapa(c: ^LowerCtx, arg: ?^frontend.Expr) -> Valor {
    let origem: Valor = lw_expr(c, arg)
    let i: ^IrInstr = lw_nova_instr(c, IR_TAMANHO_TEXTO, (arg as ^frontend.Expr).pos_op)
    i.destino = lw_novo_temp(c)
    i.tipo = semantic.TIPO_INT as u32
    i.a = origem
    return lw_valor_temp(i.destino, semantic.TIPO_INT as u32)
}

// C: ir/lower_v19.c:226
proc lw_tamanho_v19(c: ^LowerCtx, arg: ?^frontend.Expr) -> Valor {
    var t: u32 = (arg as ^frontend.Expr).tipo
    if common.c2f_s2u_32(classe_de_4(c, t)) == (semantic.TC_PONTEIRO as u32) {
        t = semantic.tipo_de(&(c.sem as ^semantic.Semantica).tipos, t).a
    }
    if common.c2f_s2u_32(classe_de_4(c, t)) == (semantic.TC_SOA as u32) {
        return tamanho_da_soa(c, arg, t)
    }
    if common.c2f_s2u_32(classe_de_4(c, t)) == (semantic.TC_MAPA as u32) {
        return tamanho_do_mapa(c, arg)
    }
    if common.c2f_s2u_32(classe_de_4(c, (arg as ^frontend.Expr).tipo)) != (semantic.TC_BIT_SET as u32) {
        let msg_1 = format(f"lowering: len de tipo {(arg as ^frontend.Expr).tipo} sem lowering (offset {(arg as ^frontend.Expr).pos_op})", alloc = heap)
        defer delete(msg_1)
        common.falha_interna(msg_1)
    }
    let arg_1: Valor = lw_valor_nenhum()
    let arg_2: Valor = lw_expr(c, arg)
    let arg_3: u32 = (arg as ^frontend.Expr).pos_op
    let arg_4: ^LowerCtx = c
    return conjunto(arg_4, 6, arg_3, semantic.TIPO_INT as u32, arg_2, arg_1)
}

// C: ir/lower_v19.c:238
proc lw_stmt_for_v19(c: ^LowerCtx, s: ^frontend.Stmt) {
    let colecao: u32 = (s.expr as ^frontend.Expr).tipo
    if common.c2f_s2u_32(classe_de_4(c, colecao)) == (semantic.TC_SOA as u32) {
        lw_for_soa(c, s)
        return
    }
    if common.c2f_s2u_32(classe_sem_ponteiro(c, colecao)) == (semantic.TC_MAPA as u32) {
        lw_for_mapa(c, s)
        return
    }
    if common.c2f_s2u_32(classe_de_4(c, colecao)) != (semantic.TC_BIT_SET as u32) {
        lw_falha_stmt(c, s, "for de colecao v1.9 sem lowering")
    }
    let conjunto: u32 = (s.expr as ^frontend.Expr).tipo
    let base: Valor = lw_expr(c, s.expr)
    let foto: ^IrInstr = lw_nova_instr(c, IR_LOCAL, s.pos)
    foto.destino = lw_novo_local(c)
    foto.tipo = conjunto
    foto.a = base
    foto.mutavel = false
    let contador: i32 = lw_novo_local(c)
    let laco: ^IrInstr = lw_nova_instr(c, IR_PARA, s.pos)
    laco.destino = contador
    laco.tipo = semantic.TIPO_INT as u32
    laco.a = lw_valor_int(0, semantic.TIPO_INT as u32)
    laco.b = lw_valor_int(semantic.tipo_de(&(c.sem as ^semantic.Semantica).tipos, conjunto).b as i64, semantic.TIPO_INT as u32)
    laco.faixa_excl = true
    let externo: ^IrBloco = lw_trocar_bloco(c, &laco.corpo)
    let se: ^IrInstr = lw_nova_instr(c, IR_SE, s.pos)
    _ = lw_trocar_bloco(c, &se.cond)
    let arg_1: Valor = lw_valor_local(contador, semantic.TIPO_INT as u32)
    let arg_2: Valor = lw_valor_local(foto.destino, conjunto)
    let arg_3: u32 = s.pos
    let arg_4: ^LowerCtx = c
    se.a = conjunto(arg_4, 3, arg_3, semantic.TIPO_BOOL as u32, arg_2, arg_1)
    _ = lw_trocar_bloco(c, &se.corpo)
    let arg_5: Valor = lw_valor_local(contador, semantic.TIPO_INT as u32)
    let arg_6: Valor = lw_valor_nenhum()
    let arg_7: u32 = s.tipo_local
    let arg_8: u32 = s.pos
    let arg_9: ^LowerCtx = c
    let membro: Valor = conjunto(arg_9, 8, arg_8, arg_7, arg_6, arg_5)
    let item: ^IrInstr = lw_nova_instr(c, IR_LOCAL, s.pos)
    item.destino = s.local_id
    item.tipo = s.tipo_local
    item.a = membro
    item.mutavel = false
    lw_bloco(c, s.corpo, true)
    _ = lw_trocar_bloco(c, externo)
}
