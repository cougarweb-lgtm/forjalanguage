import "std:os"

// C: common/base.c:19
// C2F-37: `fmt, ...` virou `msg: str` (mensagem ja pronta)
// C2F-62: stderr em modo texto (CRLF) pelo shim; o C faz exit(3), aqui os.exit(3) (descarrega stdout)
pub proc falha_interna(msg: str) {
    let e = c2f_saida_stderr()
    c2f_saida_escrever_texto(e, "forja: erro interno: ")
    c2f_saida_formatar(e, msg)
    c2f_saida_putc(e, 10) // '\n'
    _ = c2f_saida_fechar(e)
    os.exit(3)
}

// C: common/base.c:32
// C2F-C1: QueryPerformanceCounter/Frequency -> os.time_ns (relogio monotonico em ns, mesma ideia do C)
pub proc relogio_ns() -> u64 {
    return os.time_ns() as u64
}
