// C: common/idiomas.c:151
// C: DiagRelatar(d, E0110, off, IDIOMAS[id].causa, achado) com a causa como formato printf de UM %s: aqui a mensagem sai pronta (C2F-37), com o %s trocado pelo achado.
pub proc idioma_relatar(d: ^Diag, id: i32, off: u32, achado: str) -> bool {
    let causa = IDIOMAS[id as int].causa or_else ""
    var corte = len(causa)
    var depois = len(causa)
    var i = 0
    while i + 1 < len(causa) {
        if causa[i] == 37 and causa[i + 1] == 115 { // '%' 's'
            corte = i
            depois = i + 2
            break
        }
        i += 1
    }
    // C: DiagRelatar usa o achado so quando a causa tem %s; sem %s ele e ignorado (IDI_TERNARIO, IDI_TRY_RUST).
    if corte == len(causa) {
        return diag_relatar(d, E0110, off, causa)
    }
    let ante = causa[0..<corte]
    let apos = causa[depois..<len(causa)]
    let msg = format(f"{ante}{achado}{apos}", alloc = heap)
    defer delete(msg)
    return diag_relatar(d, E0110, off, msg)
}

// C: common/idiomas.c:157
// C2F-N1: texto era `const char *` e quem chama passa Fonte.texto, que e []u8 (nao str): o parametro e []u8 (o ponteiros.tsv trazia str). O novo que o C copiava em char[32] vira copia no heap
// (sem arena de dono aqui; a raiz sai por os.exit).
// LIMITE: parametros 5 (a troca acumulada + o texto + a faixa [ini, fim) + o texto novo: uma troca so; agrupar criaria um tipo de uso unico).
pub proc idioma_troca_somar(t: ^IdiomaTroca, texto: []u8, ini: u32, fim: u32, novo: str) {
    var uma_linha = fim >= ini
    if uma_linha {
        for k in (ini as int)..<(fim as int) {
            if texto[k] == 10 { // '\n'
                uma_linha = false
                break
            }
        }
    }
    if t.falhou {
        return
    }
    if t.n >= (DIAG_EDICOES_MAX as u32) or not uma_linha or (fim - ini) > (DIAG_ANTIGO_MAX as u32) or (len(novo) as u64) >= (DIAG_NOVO_MAX as u64) {
        t.falhou = true
        return
    }
    t.itens[t.n as int] = DiagEdicao{ini = ini, fim = fim, novo = ""}
    t.n += 1
    t.itens[(t.n - 1) as int].novo = from_bytes(as_bytes(novo), alloc = heap)
}

// C: common/idiomas.c:170
pub proc idioma_sugerir(d: ^Diag, confianca: i32, descricao: str, t: ?^IdiomaTroca) {
    let aplica: bool = (((t != none) and (not (t as ^IdiomaTroca).falhou)) and ((t as ^IdiomaTroca).n > 0)) and (c2f_s2u_32(confianca) != (DIAG_SO_DICA as u32))
    var tern_1: u32 = DIAG_SO_DICA as u32
    if c2f_b2i32(aplica) != 0 {
        tern_1 = c2f_s2u_32(confianca)
    }
    let msg_1 = format(f"{descricao}", alloc = heap)
    defer delete(msg_1)
    _ = diag_sugerir(&d.sug, transmute(tern_1, to = i32), msg_1)
    if not aplica {
        return
    }
    for i in (0 as u32)..<(t as ^IdiomaTroca).n {
        _ = diag_editar(&d.sug, (t as ^IdiomaTroca).itens[i].ini, (t as ^IdiomaTroca).itens[i].fim, (t as ^IdiomaTroca).itens[i].novo)
    }
}

// C: common/idiomas.c:179
proc pede_espaco_antes(antes: u8) -> bool {
    let alnum = (antes >= 48 and antes <= 57) or (antes >= 65 and antes <= 90) or (antes >= 97 and antes <= 122) // isalnum no locale C: '0'..'9' 'A'..'Z' 'a'..'z'
    return alnum or antes == 95 or antes == 41 or antes == 93 or antes == 34 // '_' ')' ']' '"'
}

// C: common/idiomas.c:185
// LIMITE: parametros 5 (Diag e Fonte sao os dois donos do texto; [ini, fim) e a palavra descrevem uma troca so; agrupar criaria um tipo de uso unico).
pub proc idioma_sugerir_palavra(d: ^Diag, f: ^Fonte, ini: u32, fim: u32, palavra: ?str) {
    var antes: u8 = 0
    if ini > 0 {
        antes = f.texto[(ini - 1) as int]
    }
    let depois = f.texto[fim as int]
    let espaco_depois = depois != 32 and depois != 9 and depois != 13 and depois != 10 and depois != 0 // ' ' TAB CR LF NUL
    var pre = ""
    if pede_espaco_antes(antes) {
        pre = " "
    }
    var pos = ""
    if espaco_depois {
        pos = " "
    }
    let pal = palavra or_else "(null)"
    let tudo = format(f"{pre}{pal}{pos}", alloc = heap)
    defer delete(tudo)
    let novo = tudo[0..<min(len(tudo), (DIAG_NOVO_MAX as int) - 1)] // snprintf em char[DIAG_NOVO_MAX]: no maximo DIAG_NOVO_MAX - 1 bytes
    let desc = format(f"troque pelo '{pal}' da Forja", alloc = heap)
    defer delete(desc)
    _ = diag_sugerir(&d.sug, DIAG_CERTA, desc)
    _ = diag_editar(&d.sug, ini, fim, novo)
}
