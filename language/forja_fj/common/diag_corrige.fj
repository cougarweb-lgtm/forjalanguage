// gerado por c2forja esqueleto 0.3.2; corpo real do P-common C3
// Versao: 0.2.0
//
// Textos que o C guardava em char[N] (Alvo.nome1/nome2/token/recuo e DiagEdicao.novo) viram str de heap feita por from_bytes (nao ha arena de dono aqui; a raiz sai por os.exit).
// Ponteiro para linha da tabela REGRAS (const: sem endereco) = copia por valor (`var r = REGRAS[i]` + &r) e escolher_regra devolve o INDICE (-1 = NULL) (C2F-N2).

import "std:text"

struct RegraCorrecao {
    codigo: i32
    trecho_da_causa: ?str
    texto: ?str
    descricao: ?str
    acao: i32
    confianca: i32
}

struct Alvo {
    f: ?^Fonte
    d: ?^Diag
    t: []u8
    causa: ?str
    off: u32
    fim_token: u32
    ini_linha: u32
    ini_texto: u32
    fim_linha: u32
    nome1: ?str
    nome2: ?str
    token: ?str
    recuo: ?str
}

struct Saida2 {
    saida: []u8
    cap: u64
    uso: u64
    estourou: bool
}

struct Operandos {
    ini1: u32
    fim1: u32
    ini2: u32
    fim2: u32
}

// Onde o sscanf do for de C achou var, lo e hi (offsets em `inner`): ver ler_for_de_c.
struct LeituraFor {
    v_ini: int
    v_fim: int
    lo_ini: int
    lo_fim: int
    hi_ini: int
    hi_fim: int
}

