}

// C: common/diag_corrige.c:193
proc eh_nome_char(c: u8) -> bool {
    return ((((c2f_char_i32(c) >= 97) and (c2f_char_i32(c) <= 122)) or ((c2f_char_i32(c) >= 65) and (c2f_char_i32(c) <= 90))) or ((c2f_char_i32(c) >= 48) and (c2f_char_i32(c) <= 57))) or (c == 95) // 'a' 'z' 'A' 'Z' '0' '9' '_'
}

// C: common/diag_corrige.c:198
proc eh_espaco(c: u8) -> bool {
    return (c == 32) or (c == 9) // ' ' '\t'
}

// A partir de t[p], os bytes de s (strncmp(t + p, s, len(s)) == 0, lendo 0 alem do fim: o sentinela da Fonte).
proc prefixo_em(t: []u8, p: int, s: str) -> bool {
    for k in 0..<len(s) {
        if c2f_nul_em_b(t, p + k) != s[k] {
            return false
        }
    }
    return true
}

// C: common/diag_corrige.c:204
// Copia ate n bytes (cortando em NOME_MAX - 1) e fecha com NUL. O C gravava em char[NOME_MAX]; aqui devolve o str (frame: o Alvo nao tem dono
// que libere, como o diag.fj do C2; o compilador nao chama frame_reset) com esses bytes.
proc copiar_texto(origem: []u8, ini: u32, n: u64) -> str {
    var n_v: u64 = n
    if n_v >= (NOME_MAX as u64) {
        n_v = (NOME_MAX as u64) - 1
    }
    return from_bytes(origem[(ini as int)..<((ini as int) + (n_v as int))], alloc = frame)
}

// C: common/diag_corrige.c:211
proc preparar_alvo(a: ^Alvo, d: ^Diag, f: ^Fonte) {
    let t = f.texto
    var off: u32 = f.tam as u32
    if (d.off as u64) < f.tam {
        off = d.off
    }
    a.f = f
    a.d = d
    a.t = t
    a.causa = d.causa
    a.off = off
    a.ini_linha = off
    while a.ini_linha > 0 and t[a.ini_linha - 1] != 10 { // '\n'
        a.ini_linha -= 1
    }
    a.ini_texto = a.ini_linha
    while eh_espaco(t[a.ini_texto]) {
        a.ini_texto += 1
    }
    a.fim_linha = off
    while t[a.fim_linha] != 0 and t[a.fim_linha] != 10 { // '\0' '\n'
        a.fim_linha += 1
    }
    if a.fim_linha > a.ini_linha and t[a.fim_linha - 1] == 13 { // '\r'
        a.fim_linha -= 1
    }
    a.fim_token = off + diag_tamanho_do_token(f, off)
    if t[off] >= 128 {
        while t[a.fim_token] >= 128 { // acento: a sequencia inteira de bytes nao ASCII
            a.fim_token += 1
        }
    }
    let causa = d.causa or_else ""
    var nome1: [64]u8 = {}
    var nome2: [64]u8 = {}
    diag_nome_entre_aspas(causa, 0, nome1[..])
    diag_nome_entre_aspas(causa, 1, nome2[..])
    a.nome1 = from_bytes(nome1[0..<c2f_strlen_b(nome1[..])], alloc = frame)
    a.nome2 = from_bytes(nome2[0..<c2f_strlen_b(nome2[..])], alloc = frame)
    var tam_token: u64 = 0
    if a.fim_token > off {
        tam_token = (a.fim_token - off) as u64
    }
    a.token = copiar_texto(t, off, tam_token)
    var tam_recuo: u64 = 0
    if (a.ini_texto - a.ini_linha) < ((RECUO_MAX as u32) - 1) {
        tam_recuo = (a.ini_texto - a.ini_linha) as u64
    }
    a.recuo = copiar_texto(t, a.ini_linha, tam_recuo)
}

// C: common/diag_corrige.c:246
proc escrever(s: ^Saida2, texto: ?str, n: u64) {
    if s.uso + n >= s.cap {
        s.estourou = true
        return
    }
    copy(s.saida[(s.uso as int)..<((s.uso + n) as int)], as_bytes(texto or_else "")[0..<(n as int)])
    s.uso += n
    s.saida[s.uso as int] = 0
}

// C: common/diag_corrige.c:257
proc valor_da_marca(a: ^Alvo, marca: u8) -> ?str {
    let sw_1 = c2f_char_i32(marca)
    if sw_1 == 49 { // '1'
        return a.nome1
    } else if sw_1 == 50 { // '2'
        return a.nome2
    } else if sw_1 == 84 { // 'T'
        return a.token
    } else if sw_1 == 82 { // 'R'
        return a.recuo
    } else {
        return none
    }
    return none
}

// C: common/diag_corrige.c:269
// Expande $1 $2 $T $R de 'modelo' em 'saida'; false se o resultado nao coube.
proc expandir(a: ^Alvo, modelo: str, saida: []u8, cap: u64) -> bool {
    var s = Saida2{saida = saida, cap = cap, uso = 0, estourou = false}
    saida[0] = 0
    var p = 0
    while c2f_nul_em(modelo, p) != 0 {
        var valor: ?str = none
        if modelo[p] == 36 { // '$'
            valor = valor_da_marca(a, c2f_nul_em(modelo, p + 1))
        }
        if valor != none {
            let v = valor or_else ""
            escrever(&s, v, len(v) as u64)
            p += 1
        } else {
            escrever(&s, modelo[p..<p + 1], 1)
        }
        p += 1
    }
    return not s.estourou
}

// C: common/diag_corrige.c:287
// Monta a edicao [ini, fim) -> modelo expandido. O novo (char[DIAG_NOVO_MAX] no C) so e gravado se coube; e uma copia no heap.
proc poe(a: ^Alvo, e: ^DiagEdicao, ini: u32, fim: u32, modelo: str) -> bool {
    if fim < ini or (fim as u64) > (a.f as ^Fonte).tam {
        return false
    }
    e.ini = ini
    e.fim = fim
    var buf: [32]u8 = {} // DIAG_NOVO_MAX
    let coube = expandir(a, modelo, buf[..], DIAG_NOVO_MAX as u64)
    if coube {
        e.novo = from_bytes(buf[0..<c2f_strlen_b(buf[..])], alloc = heap)
    }
    return coube
}

// C: common/diag_corrige.c:298
// Offset da 1a ocorrencia de 'texto' em [de, fim_linha); NAO_ACHEI se nao ha.
proc procurar(a: ^Alvo, de: u32, texto: str) -> u32 {
    let n = len(texto)
    var i: u32 = de
    while ((i as u64) + (n as u64)) <= (a.fim_linha as u64) {
        if c2f_memcmp(a.t[(i as int)..<((i as int) + n)], as_bytes(texto)) == 0 {
            return i
        }
        i += 1
    }
    return NAO_ACHEI
}

// C: common/diag_corrige.c:309
proc token_util(a: ^Alvo) -> bool {
    let c: u8 = a.t[a.off]
    return ((c != 0) and (c != 10)) and (c != 13) // '\0' '\n' '\r'
}

// C: common/diag_corrige.c:316
proc fim_do_caminho(a: ^Alvo, de: u32) -> u32 {
    var i: u32 = de
    while (c2f_b2i32(eh_nome_char(a.t[i])) != 0) or ((a.t[i] == 46) and (c2f_b2i32(eh_nome_char(a.t[i + 1])) != 0)) { // '.'
        i += 1
    }
    return i
}

// C: common/diag_corrige.c:325
// Inicio da declaracao de topo (letra na coluna 1, fora os import) que contem a linha do erro.
proc inicio_da_declaracao_de_topo(a: ^Alvo) -> u32 {
    var p: u32 = a.ini_linha
    while true {
        let c = a.t[p]
        let letra = (c >= 97 and c <= 122) or (c >= 65 and c <= 90) // 'a' 'z' 'A' 'Z'
        if letra and not prefixo_em(a.t, p as int, "import") {
            return p
        }
        if p == 0 {
            return 0
        }
        p -= 1
        while p > 0 and a.t[p - 1] != 10 { // '\n'
            p -= 1
        }
    }
    return 0
}

// C: common/diag_corrige.c:341
proc acao_antes_decl_topo(a: ^Alvo, e: ^DiagEdicao, texto: str) -> bool {
    let p: u32 = inicio_da_declaracao_de_topo(a)
    return poe(a, e, p, p, texto)
}

// C: common/diag_corrige.c:348
proc acao_remover_ate(a: ^Alvo, e: ^DiagEdicao, texto: str, incluindo: bool) -> bool {
    let p: u32 = procurar(a, a.off, texto)
    if p == NAO_ACHEI {
        return false
    }
    var tern_1: u32 = p
    if c2f_b2i32(incluindo) != 0 {
        tern_1 = p + ((len(texto) as u64) as u32)
    }
    return poe(a, e, a.off, tern_1, "")
}

// C: common/diag_corrige.c:356
proc acao_remover_achado(a: ^Alvo, e: ^DiagEdicao, texto: str) -> bool {
    let p: u32 = procurar(a, a.off, texto)
    return (p != NAO_ACHEI) and (c2f_b2i32(poe(a, e, p, p + ((len(texto) as u64) as u32), "")) != 0)
}

// C: common/diag_corrige.c:363
proc acao_remover_decl(a: ^Alvo, e: ^DiagEdicao) -> bool {
    var fim: u32 = a.off
    while fim > a.ini_texto and eh_espaco(a.t[fim - 1]) {
        fim -= 1
    }
    var ini: u32 = fim
    while ini > a.ini_texto and eh_nome_char(a.t[ini - 1]) {
        ini -= 1
    }
    if (fim - ini) != 3 or (not prefixo_em(a.t, ini as int, "let") and not prefixo_em(a.t, ini as int, "var")) {
        return false
    }
    return poe(a, e, ini, a.off, "")
}

// C: common/diag_corrige.c:375
proc acao_remover_qualificador(a: ^Alvo, e: ^DiagEdicao) -> bool {
    var ini: u32 = a.off
    if (ini == 0) or (a.t[ini - 1] != 46) { // '.'
        return false
    }
    ini -= 1
    while (ini > 0) and (c2f_b2i32(eh_nome_char(a.t[ini - 1])) != 0) {
        ini -= 1
    }
    return (ini < (a.off - 1)) and (c2f_b2i32(poe(a, e, ini, a.off, "")) != 0)
}

// C: common/diag_corrige.c:385
proc acao_remover_argumento(a: ^Alvo, e: ^DiagEdicao) -> bool {
    var i: u32 = a.off
    while (i > a.ini_linha) and (a.t[i - 1] != 44) { // ','
        i -= 1
    }
    return (i > a.ini_linha) and (c2f_b2i32(poe(a, e, i - 1, a.fim_token, "")) != 0)
}

// C: common/diag_corrige.c:393
proc acao_remover_linha(a: ^Alvo, e: ^DiagEdicao, exige: str) -> bool {
    return (procurar(a, a.ini_texto, exige) != NAO_ACHEI) and (c2f_b2i32(poe(a, e, a.ini_texto, a.fim_linha, "")) != 0)
}

// C: common/diag_corrige.c:399
// O nome do modulo da causa ("std:x nao existe; a std tem: a, b, c") mais parecido com x, a distancia 1..DISTANCIA_STD_MAX; false se nenhum.
proc acao_trocar_std(a: ^Alvo, e: ^DiagEdicao) -> bool {
    let causa = a.causa or_else ""
    let achou_nome = text.str_index_of(causa, "std:")
    let achou_lista = text.str_index_of(causa, "a std tem: ")
    if achou_nome == none or achou_lista == none {
        return false
    }
    let nome_i = (achou_nome or_else 0) + 4
    var tam_nome = 0
    while c2f_nul_em(causa, nome_i + tam_nome) != 0 and c2f_nul_em(causa, nome_i + tam_nome) != 32 { // ' '
        tam_nome += 1
    }
    var p = (achou_lista or_else 0) + 11 // strlen("a std tem: ")
    var melhor = -1
    var tam_melhor = 0
    var menor: u32 = (DISTANCIA_STD_MAX as u32) + 1
    while c2f_nul_em(causa, p) != 0 {
        var n = 0
        while c2f_nul_em(causa, p + n) != 0 and c2f_nul_em(causa, p + n) != 44 { // ','
            n += 1
        }
        let dist = parecido(causa[nome_i..<nome_i + tam_nome], tam_nome as u64, causa[p..<p + n], n as u64)
        if dist > 0 and dist < menor and n < (MODULO_MAX as int) {
            menor = dist
            melhor = p
            tam_melhor = n
        }
        p += n
        while c2f_nul_em(causa, p) == 44 or c2f_nul_em(causa, p) == 32 { // ',' ' '
            p += 1
        }
    }
    if melhor < 0 {
        return false
    }
    let modulo = causa[melhor..<melhor + tam_melhor]
    let aspa = "\""
    let novo = format(f"{aspa}std:{modulo}{aspa}", alloc = heap)
    defer delete(novo)
    return poe(a, e, a.off, a.fim_token, novo)
}

// C: common/diag_corrige.c:429
proc acao_depois_caminho(a: ^Alvo, e: ^DiagEdicao, texto: str) -> bool {
    let fim: u32 = fim_do_caminho(a, a.off)
    return (fim > a.off) and (c2f_b2i32(poe(a, e, fim, fim, texto)) != 0)
}

// C: common/diag_corrige.c:439
// Os dois operandos (caminhos a.b.c) de uma conta "a OP b" cujo operador comeca no erro: [ini1, fim1) e [ini2, fim2).
proc ler_operandos(a: ^Alvo, o: ^Operandos) -> bool {
    var i: u32 = a.off
    while (i > a.ini_texto) and (c2f_b2i32(eh_espaco(a.t[i - 1])) != 0) {
        i -= 1
    }
    o.fim1 = i
    while (i > a.ini_texto) and ((c2f_b2i32(eh_nome_char(a.t[i - 1])) != 0) or (a.t[i - 1] == 46)) { // '.'
        i -= 1
    }
    o.ini1 = i
    i = a.fim_token
    while eh_espaco(a.t[i]) {
        i += 1
    }
    o.ini2 = i
    o.fim2 = fim_do_caminho(a, i)
    return (o.fim1 > o.ini1) and (o.fim2 > o.ini2)
}

// C: common/diag_corrige.c:455
// "a + b" de str vira f"{a}{b}"; "a == b" de cstr vira (a as str) == (b as str). snprintf em char[DIAG_NOVO_MAX]: n < tamanho = coube.
proc acao_reescrever_conta(a: ^Alvo, e: ^DiagEdicao, soma: bool) -> bool {
    var o = Operandos{}
    if not ler_operandos(a, &o) {
        return false
    }
    let op1 = from_bytes(a.t[(o.ini1 as int)..<(o.fim1 as int)], alloc = heap)
    defer delete(op1)
    let op2 = from_bytes(a.t[(o.ini2 as int)..<(o.fim2 as int)], alloc = heap)
    defer delete(op2)
    if soma {
        let aspa = "\""
        let abre = "{"
        let fecha = "}"
        let novo_soma = format(f"f{aspa}{abre}{op1}{fecha}{abre}{op2}{fecha}{aspa}", alloc = heap)
        defer delete(novo_soma)
        return len(novo_soma) < (DIAG_NOVO_MAX as int) and poe(a, e, o.ini1, o.fim2, novo_soma)
    }
    let novo = format(f"({op1} as str) == ({op2} as str)", alloc = heap)
    defer delete(novo)
    return len(novo) < (DIAG_NOVO_MAX as int) and poe(a, e, o.ini1, o.fim2, novo)
}

// C: common/diag_corrige.c:471
proc acao_membro_no_enum(a: ^Alvo, e: ^DiagEdicao) -> bool {
    var k: u8 = 0
    while (k as i32) < ((a.d as ^Diag).rel.n as i32) {
        var i: u32 = (a.d as ^Diag).rel.itens[k].off
        let ini: u32 = i
        if ((a.d as ^Diag).rel.itens[k].papel != (DIAG_REL_TIPO as u8)) or ((i as u64) >= (a.f as ^Fonte).tam) {
            k += 1
            continue
        }
        while (a.t[i] != 0) and (a.t[i] != 10) { // '\0' '\n'
            i += 1
        }
        while (i > ini) and (a.t[i - 1] != 125) { // '}'
            i -= 1
        }
        if i <= ini {
            k += 1
            continue
        }
        i -= 1
        while (i > ini) and (c2f_b2i32(eh_espaco(a.t[i - 1])) != 0) {
            i -= 1
        }
        var tern_1: str = ", $2"
        if a.t[i - 1] == 123 {
            tern_1 = "$2"
        }
        return poe(a, e, i, i, tern_1) // '{'
    }
    return false
}

// C: common/diag_corrige.c:488
proc acao_campo_na_struct(a: ^Alvo, e: ^DiagEdicao) -> bool {
    var k: u8 = 0
    while (k as i32) < ((a.d as ^Diag).rel.n as i32) {
        var i: u32 = (a.d as ^Diag).rel.itens[k].off
        if ((a.d as ^Diag).rel.itens[k].papel != (DIAG_REL_TIPO as u8)) or ((i as u64) >= (a.f as ^Fonte).tam) {
            k += 1
            continue
        }
        while (a.t[i] != 0) and (a.t[i] != 10) { // '\0' '\n'
            i += 1
        }
        if (i > 0) and (a.t[i - 1] == 13) { // '\r'
            i -= 1
        }
        if (i == 0) or (a.t[i - 1] != 123) { // '{'
            k += 1
            continue
        }
        return poe(a, e, i, i, "\n    $2: int = 0")
    }
    return false
}

// Espaco do isspace do C (32 e 9..13).
proc eh_espaco_c(c: u8) -> bool {
    return c == 32 or (c >= 9 and c <= 13)
}

proc pular_espacos(s: []u8, q: ^int) {
    while eh_espaco_c(c2f_nul_em_b(s, q^)) {
        q^ += 1
    }
}

// O c esta no conjunto do scanf: tipo 0 = [a-z], 1 = [A-Za-z0-9_], 2 = [^;].
proc no_conjunto(c: u8, tipo: i32) -> bool {
    if tipo == 0 {
        return c >= 97 and c <= 122 // 'a' 'z'
    }
    if tipo == 1 {
        return eh_nome_char(c)
    }
    return c != 59 // ';'
}

// `%[conjunto]` do scanf: le ate `maximo` bytes do conjunto a partir de q (nao pula espaco antes) e devolve quantos leu; para no fim do texto.
proc varrer_conjunto(s: []u8, q: ^int, tipo: i32, maximo: int) -> int {
    var n = 0
    while n < maximo and c2f_nul_em_b(s, q^) != 0 and no_conjunto(c2f_nul_em_b(s, q^), tipo) {
        q^ += 1
        n += 1
    }
    return n
}

// sscanf(inner, " %*[a-z] %63[A-Za-z0-9_] = %63[^;]; %*[A-Za-z0-9_] < %63[^;];", var, lo, hi) == 3, em offsets de `inner` (a ultima ';' nao conta: o retorno ja e 3 depois do hi).
proc ler_for_de_c(inner: []u8, r: ^LeituraFor) -> bool {
    var q = 0
    pular_espacos(inner, &q)
    if varrer_conjunto(inner, &q, 0, len(inner)) == 0 { // %*[a-z]
        return false
    }
    pular_espacos(inner, &q)
    r.v_ini = q
    if varrer_conjunto(inner, &q, 1, 63) == 0 { // %63[A-Za-z0-9_]
        return false
    }
    r.v_fim = q
    pular_espacos(inner, &q)
    if c2f_nul_em_b(inner, q) != 61 { // '='
        return false
    }
    q += 1
    pular_espacos(inner, &q)
    r.lo_ini = q
    if varrer_conjunto(inner, &q, 2, 63) == 0 { // %63[^;]
        return false
    }
    r.lo_fim = q
    if c2f_nul_em_b(inner, q) != 59 { // ';'
        return false
    }
    q += 1
    pular_espacos(inner, &q)
    if varrer_conjunto(inner, &q, 1, len(inner)) == 0 { // %*[A-Za-z0-9_]
        return false
    }
    pular_espacos(inner, &q)
    if c2f_nul_em_b(inner, q) != 60 { // '<'
        return false
    }
    q += 1
    pular_espacos(inner, &q)
    r.hi_ini = q
    if varrer_conjunto(inner, &q, 2, 63) == 0 { // %63[^;]
        return false
    }
    r.hi_fim = q
    return true
}

// C: common/diag_corrige.c:502
// for (var i = 0; i < n; i++) { vira for i in 0..<n { (so a forma de contador simples; o erro cai no ';', por isso parte do inicio da linha).
proc acao_for_de_c(a: ^Alvo, e: ^DiagEdicao) -> bool {
    let abre = procurar(a, a.ini_texto, "(")
    var fecha: u32 = a.fim_linha
    while fecha > a.ini_texto and a.t[fecha - 1] != 41 { // ')'
        fecha -= 1
    }
    if abre == NAO_ACHEI or fecha <= (abre + 1) or ((fecha - abre - 2) as u64) >= 96 { // sizeof inner
        return false
    }
    let inner = a.t[((abre + 1) as int)..<((abre + 1 + (fecha - abre - 2)) as int)]
    var r = LeituraFor{}
    if not ler_for_de_c(inner, &r) {
        return false
    }
    var tem_incremento = false // strstr(inner, "++") != NULL
    for k in 0..<(len(inner) - 1) {
        if inner[k] == 43 and inner[k + 1] == 43 { // '+' '+'
            tem_incremento = true
            break
        }
    }
    if inner[r.hi_ini] == 61 or not tem_incremento { // '='
        return false
    }
    let v = from_bytes(inner[r.v_ini..<r.v_fim], alloc = heap)
    defer delete(v)
    let lo = from_bytes(inner[r.lo_ini..<r.lo_fim], alloc = heap)
    defer delete(lo)
    let hi = from_bytes(inner[r.hi_ini..<r.hi_fim], alloc = heap)
    defer delete(hi)
    let novo = format(f"for {v} in {lo}..<{hi}", alloc = heap)
    defer delete(novo)
    if len(novo) >= (DIAG_NOVO_MAX as int) {
        return false
    }
    return poe(a, e, a.ini_texto, fecha, novo)
}

// C: common/diag_corrige.c:518
// let a = [3]int{1, 2} vira let a: [3]int = {1, 2} (o tipo vai para a declaracao).
proc acao_anotar_tipo(a: ^Alvo, e: ^DiagEdicao) -> bool {
    let brace = procurar(a, a.off, "{")
    var i: u32 = a.off
    if a.t[a.off] != 91 or a.t[a.off + 1] < 48 or a.t[a.off + 1] > 57 or brace == NAO_ACHEI { // '[' '0' '9'
        return false
    }
    while i > a.ini_texto and eh_espaco(a.t[i - 1]) {
        i -= 1
    }
    if i == a.ini_texto or a.t[i - 1] != 61 { // '='
        return false
    }
    i -= 1
    while i > a.ini_texto and eh_espaco(a.t[i - 1]) {
        i -= 1
    }
    var ini: u32 = i
    while ini > a.ini_texto and eh_nome_char(a.t[ini - 1]) {
        ini -= 1
    }
    if ini == i {
        return false
    }
    let nome = from_bytes(a.t[(ini as int)..<(i as int)], alloc = heap)
    defer delete(nome)
    let tipo = from_bytes(a.t[(a.off as int)..<(brace as int)], alloc = heap)
    defer delete(tipo)
    let novo = format(f"{nome}: {tipo} = ", alloc = heap)
    defer delete(novo)
    if len(novo) >= (DIAG_NOVO_MAX as int) {
        return false
    }
    return poe(a, e, ini, brace, novo)
}

// C: common/diag_corrige.c:538
proc acao_trocar_chamada(a: ^Alvo, e: ^DiagEdicao, novo_nome: str) -> bool {
    var fim: u32 = a.off
    var ini: u32 = 0
    if (fim == 0) or (a.t[fim - 1] != 40) { // '('
        return false
    }
    fim -= 1
    ini = fim
    while (ini > 0) and (c2f_b2i32(eh_nome_char(a.t[ini - 1])) != 0) {
        ini -= 1
    }
    return (ini < fim) and (c2f_b2i32(poe(a, e, ini, fim, novo_nome)) != 0)
}

// C: common/diag_corrige.c:551
// ++nome e --nome (so os que comecam no erro) viram nome += 1 e nome -= 1.
proc acao_incremento(a: ^Alvo, e: ^DiagEdicao) -> bool {
    let op = a.t[a.off]
    let fim = fim_do_caminho(a, a.off + 2)
    if (op != 43 and op != 45) or a.t[a.off + 1] != op or fim == a.off + 2 { // '+' '-'
        return false
    }
    let nome = from_bytes(a.t[((a.off + 2) as int)..<(fim as int)], alloc = heap)
    defer delete(nome)
    var sinal = "+"
    if op == 45 {
        sinal = "-"
    }
    let tudo = format(f"{nome} {sinal}= 1", alloc = heap)
    defer delete(tudo)
    let novo = tudo[0..<min(len(tudo), (DIAG_NOVO_MAX as int) - 1)] // snprintf em char[DIAG_NOVO_MAX], sem teste de corte
    return poe(a, e, a.off, fim, novo)
}

// C: common/diag_corrige.c:563
// for (x in xs) { vira for x in xs { (o for de C com ';' nao se converte).
proc acao_tirar_parenteses_for(a: ^Alvo, e: ^DiagEdicao) -> bool {
    let abre = procurar(a, a.off, "(")
    var fecha: u32 = a.fim_linha
    while fecha > a.off and a.t[fecha - 1] != 41 { // ')'
        fecha -= 1
    }
    if abre == NAO_ACHEI or fecha <= (abre + 1) {
        return false
    }
    let miolo = from_bytes(a.t[((abre + 1) as int)..<((abre + 1 + (fecha - abre - 2)) as int)], alloc = heap)
    defer delete(miolo)
    let novo = format(f"for {miolo}", alloc = heap)
    defer delete(novo)
    if len(novo) >= (DIAG_NOVO_MAX as int) {
        return false
    }
    return text.str_index_of(novo, ";") == none and poe(a, e, a.off, fecha, novo)
}

// C: common/diag_corrige.c:576
// "for i, x in faixa" perde "i, " e "for &x in faixa" perde o '&'.
proc acao_tirar_indice_for(a: ^Alvo, e: ^DiagEdicao) -> bool {
    let p: u32 = a.ini_texto + 4
    var fim: u32 = p
    if not prefixo_em(a.t, a.ini_texto as int, "for ") {
        return false
    }
    if a.t[p] == 38 { // '&'
        return poe(a, e, p, p + 1, "")
    }
    while fim < a.off and a.t[fim] != 44 { // ','
        fim += 1
    }
    if a.t[fim] != 44 {
        return false
    }
    fim += 1
    while eh_espaco(a.t[fim]) {
        fim += 1
    }
    return poe(a, e, p, fim, "")
}

// C: common/diag_corrige.c:591
proc acao_pub_na_declaracao(a: ^Alvo, e: ^DiagEdicao) -> bool {
    var k: u8 = 0
    while (k as i32) < ((a.d as ^Diag).rel.n as i32) {
        let r: ^DiagRelacionado = &(a.d as ^Diag).rel.itens[k]
        var ini: u32 = r.off
        if ((r.papel as i32) > DIAG_REL_ASSINATURA) or ((ini as u64) >= (a.f as ^Fonte).tam) {
            k += 1
            continue
        }
        while (ini > 0) and (a.t[ini - 1] != 10) { // '\n'
            ini -= 1
        }
        while eh_espaco(a.t[ini]) {
            ini += 1
        }
        return poe(a, e, ini, ini, "pub ")
    }
    return false
}

// C: common/diag_corrige.c:605
proc calcular_edicao(a: ^Alvo, r: ^RegraCorrecao, e: ^DiagEdicao) -> bool {
    let sw_1 = c2f_s2u_32(r.acao)
    if sw_1 == (ACAO_ANTES as u32) {
        return poe(a, e, a.off, a.off, (r.texto or_else ""))
    } else if sw_1 == (ACAO_DEPOIS as u32) {
        return (c2f_b2i32(token_util(a)) != 0) and (c2f_b2i32(poe(a, e, a.fim_token, a.fim_token, (r.texto or_else ""))) != 0)
    } else if sw_1 == (ACAO_DEPOIS_CAMINHO as u32) {
        return acao_depois_caminho(a, e, (r.texto or_else ""))
    } else if sw_1 == (ACAO_FIM_LINHA as u32) {
        return poe(a, e, a.fim_linha, a.fim_linha, (r.texto or_else ""))
    } else if sw_1 == (ACAO_INICIO_LINHA as u32) {
        return poe(a, e, a.ini_texto, a.ini_texto, (r.texto or_else ""))
    } else if sw_1 == (ACAO_ANTES_DECL_TOPO as u32) {
        return acao_antes_decl_topo(a, e, (r.texto or_else ""))
    } else if sw_1 == (ACAO_TROCAR as u32) {
        return (c2f_b2i32(token_util(a)) != 0) and (c2f_b2i32(poe(a, e, a.off, a.fim_token, (r.texto or_else ""))) != 0)
    } else if sw_1 == (ACAO_REMOVER_TOKEN as u32) {
        return (c2f_b2i32(token_util(a)) != 0) and (c2f_b2i32(poe(a, e, a.off, a.fim_token, "")) != 0)
    } else if sw_1 == (ACAO_REMOVER_LINHA as u32) {
        return acao_remover_linha(a, e, (r.texto or_else ""))
    } else if sw_1 == (ACAO_REMOVER_ATE as u32) {
        return acao_remover_ate(a, e, (r.texto or_else ""), false)
    } else if sw_1 == (ACAO_REMOVER_ATE_INCLUINDO as u32) {
        return acao_remover_ate(a, e, (r.texto or_else ""), true)
    } else if sw_1 == (ACAO_REMOVER_ACHADO as u32) {
        return acao_remover_achado(a, e, (r.texto or_else ""))
    } else if sw_1 == (ACAO_REMOVER_DECL as u32) {
        return acao_remover_decl(a, e)
    } else if sw_1 == (ACAO_REMOVER_QUALIFICADOR as u32) {
        return acao_remover_qualificador(a, e)
    } else if sw_1 == (ACAO_REMOVER_ARGUMENTO as u32) {
        return acao_remover_argumento(a, e)
    } else if sw_1 == (ACAO_REMOVER_DO_INICIO as u32) {
        return (a.off > a.ini_texto) and (c2f_b2i32(poe(a, e, a.ini_texto, a.off, "")) != 0)
    } else if sw_1 == (ACAO_TROCAR_STD as u32) {
        return acao_trocar_std(a, e)
    } else if sw_1 == (ACAO_REMOVER_RESTO as u32) {
        return (a.fim_linha > a.fim_token) and (c2f_b2i32(poe(a, e, a.fim_token, a.fim_linha, "")) != 0)
    } else if sw_1 == (ACAO_TROCAR_CHAMADA as u32) {
        return acao_trocar_chamada(a, e, (r.texto or_else ""))
    } else if sw_1 == (ACAO_REESCREVER_SOMA as u32) {
        return acao_reescrever_conta(a, e, true)
    } else if sw_1 == (ACAO_COMPARAR_CSTR as u32) {
        return acao_reescrever_conta(a, e, false)
    } else if sw_1 == (ACAO_MEMBRO_NO_ENUM as u32) {
        return acao_membro_no_enum(a, e)
    } else if sw_1 == (ACAO_FOR_DE_C as u32) {
        return acao_for_de_c(a, e)
    } else if sw_1 == (ACAO_CAMPO_NA_STRUCT as u32) {
        return acao_campo_na_struct(a, e)
    } else if sw_1 == (ACAO_ANOTAR_TIPO as u32) {
        return acao_anotar_tipo(a, e)
    } else if sw_1 == (ACAO_PUB_NA_DECLARACAO as u32) {
        return acao_pub_na_declaracao(a, e)
    } else if sw_1 == (ACAO_INCREMENTO as u32) {
        return acao_incremento(a, e)
    } else if sw_1 == (ACAO_TIRAR_PARENTESES_FOR as u32) {
        return acao_tirar_parenteses_for(a, e)
    } else if sw_1 == (ACAO_TIRAR_INDICE_FOR as u32) {
        return acao_tirar_indice_for(a, e)
    } else {
        return false
    }
    return false
}

// C: common/diag_corrige.c:644
// A 1a regra do codigo cuja causa casa e cuja edicao cabe nesta linha: devolve o INDICE em REGRAS (o C devolvia o ponteiro; const nao tem endereco). -1 = NULL (nenhuma, ou uma
// regra NENHUMA casou antes).
proc escolher_regra(a: ^Alvo, d: ^Diag, e: ^DiagEdicao) -> int {
    let causa = d.causa or_else ""
    for i in 0..<95 { // REGRAS_QTD
        var r = REGRAS[i]
        if r.codigo != d.codigo or text.str_index_of(causa, r.trecho_da_causa or_else "") == none {
            continue
        }
        if r.acao == ACAO_NENHUMA {
            return -1
        }
        if calcular_edicao(a, &r, e) {
            return i
        }
    }
    return -1
}

// C: common/diag_corrige.c:656
// Sugestao so_dica que ja existe (texto da analise): ganha a edicao e sobe para provavel, no maximo (nunca certa: a analise a quis so dica). r por ponteiro para a COPIA da regra.
proc acrescentar_edicao(s: ^DiagSugestoes, r: ^RegraCorrecao, e: ^DiagEdicao) -> bool {
    let principal: ^DiagSugestao = &s.itens[0]
    if (e.fim - e.ini) > (DIAG_ANTIGO_MAX as u32) {
        return false
    }
    principal.edicoes[0] = e^
    principal.nedicoes = 1
    var tern_1: u32 = c2f_s2u_32(r.confianca)
    if c2f_s2u_32(r.confianca) == (DIAG_CERTA as u32) {
        tern_1 = DIAG_PROVAVEL as u32
    }
    principal.confianca = tern_1 as u8
    return true
}

// C: common/diag_corrige.c:668
// Diagnostico sem sugestao: abre a da regra (descricao com as marcas expandidas) e poe a edicao.
proc abrir_sugestao(s: ^DiagSugestoes, a: ^Alvo, r: ^RegraCorrecao, e: ^DiagEdicao) -> bool {
    var buf: [120]u8 = {} // DIAG_DESCRICAO_MAX
    if not expandir(a, r.descricao or_else "", buf[..], DIAG_DESCRICAO_MAX as u64) {
        return false
    }
    let descricao = from_bytes(buf[0..<c2f_strlen_b(buf[..])], alloc = heap)
    defer delete(descricao)
    return diag_sugerir(s, r.confianca, descricao) and diag_editar(s, e.ini, e.fim, e.novo)
}

// C: common/diag_corrige.c:676
proc diag_corrigir_padrao(d: ^Diag, f: ^Fonte, saida: ^DiagSugestoes) -> bool {
    let tem: bool = (d.sug.n as i32) > 0
    var e: DiagEdicao = DiagEdicao{}
    var a: Alvo = Alvo{}
    if (c2f_b2i32(tem) != 0) and (((d.sug.itens[0].nedicoes as i32) > 0) or (d.sug.itens[0].confianca != (DIAG_SO_DICA as u8))) {
        return false
    }
    preparar_alvo(&a, d, f)
    let idx = escolher_regra(&a, d, &e)
    if idx < 0 {
        return false
    }
    var regra = REGRAS[idx]
    saida^ = d.sug
    if tem {
        return acrescentar_edicao(saida, &regra, &e)
    }
    return abrir_sugestao(saida, &a, &regra, &e)
}
