// Changelog: 0.2.0 - G3 P-common C2: corpo real. Textos do Diag (causa, extras, explicacao, forma, descricao, nota, novo) sao str imutavel de heap:
//            cada escrita troca o str por um novo (nunca muda no lugar), entao a copia rasa de Diag/DiagLista e segura (R21) e o antigo nao e liberado
//            (pode estar na copia). Saida pelo shim c2f_saida_*; o estado ModoResumo/CodigoJaVisto virou SaidaDiag (C2F-70, parametro sd).

import "std:os"
import "std:text"

struct DiagEdicao {
    ini: u32
    fim: u32
    novo: ?str
}

pub struct DiagSugestao {
    confianca: u8
    nedicoes: u8
    edicoes: [2]DiagEdicao
    descricao: ?str
}

pub struct DiagSugestoes {
    n: u8
    itens: [2]DiagSugestao
}

pub struct DiagRelacionado {
    papel: u8
    off: u32
    nota: ?str
}

pub struct DiagRelacionados {
    n: u8
    itens: [5]DiagRelacionado
}

pub struct Diag {
    tem: bool
    calado: bool
    codigo: i32
    off: u32
    causa: ?str
    extras: ?str
    sug: DiagSugestoes
    rel: DiagRelacionados
    explicacao: ?str
    forma: ?str
    trocas: ?^RenTrocas
}

pub struct DiagLista {
    itens: [100]Diag
    modulo: [100]u32
    n: u32
    teto: u32
    cortado: bool
}

// C2F-30: os 4 textos do catalogo nunca sao NULL (tabela const), entao str e nao ?str.
struct ItemCatalogo {
    codigo: str
    tipo: str
    explicacao: str
    forma: str
}

struct DadosSemFonte {
    codigo: i32
    causa: ?str
    ferramenta: ?str
    saida_ferramenta: ?str
}

