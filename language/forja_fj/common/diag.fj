// C2F-A0: CATALOGO (static const ItemCatalogo[160], diag.c:110), na ordem do enum (indice = valor do codigo)
const CATALOGO: [161]ItemCatalogo = {
    ItemCatalogo{codigo = "E0001", tipo = "lexico", explicacao = "O texto tem um caractere que a Forja nao reconhece ou uma string sem fechar na linha.", forma = "Remova o caractere ou feche a string com \"."},
    ItemCatalogo{codigo = "E0101", tipo = "sintaxe", explicacao = "O token nao cabe aqui pela gramatica da Forja.", forma = "Confira o comando: um por linha, com os delimitadores no lugar."},
    ItemCatalogo{codigo = "E0201", tipo = "nome", explicacao = "O nome nao foi declarado antes do uso (ou falta proc main sem parametros e sem retorno).", forma = "Declare o nome ou corrija a grafia."},
    ItemCatalogo{codigo = "E0301", tipo = "tipo", explicacao = "Os tipos nao pertencem a mesma categoria e a Forja nao converte sozinha.", forma = "Converta com '<valor> as <Tipo>' ou ajuste o tipo declarado; literal inteiro vira real sozinho quando exato; real em inteiro pede 'as' (e trunca)."},
    ItemCatalogo{codigo = "E0302", tipo = "tipo", explicacao = "Proc com retorno precisa terminar em return.", forma = "Acrescente return <expr> como ultimo comando do corpo."},
    ItemCatalogo{codigo = "E0412", tipo = "unidade", explicacao = "As dimensoes das unidades nao combinam, ou o resultado nao tem unidade declarada.", forma = "Use a mesma unidade ou declare a unidade do resultado."},
    ItemCatalogo{codigo = "E0420", tipo = "faixa", explicacao = "A constante esta fora da faixa declarada para o campo ou nao cabe na largura do tipo (u8 vai de 0 a 255; int de -9223372036854775808 a 9223372036854775807).", forma = "Use um valor dentro da faixa ou da largura, declare um tipo maior (i64, uint) ou converta em runtime com 'as'."},
    ItemCatalogo{codigo = "E0501", tipo = "argumento", explicacao = "Argumento nomeado fora da ordem declarada ou repetido.", forma = "Passe os argumentos nomeados na ordem do proc, sem repetir."},
    ItemCatalogo{codigo = "E0502", tipo = "argumento", explicacao = "Argumento posicional depois de um nomeado, ou argumento a mais que os parametros.", forma = "Escreva os posicionais primeiro e os nomeados depois: proc(valor, nome = valor)."},
    ItemCatalogo{codigo = "E0503", tipo = "argumento", explicacao = "Falta um argumento obrigatorio (sem padrao).", forma = "Passe o argumento que falta ou de um padrao ao parametro."},
    ItemCatalogo{codigo = "E0504", tipo = "argumento", explicacao = "O nome nao existe entre os parametros do proc ou os campos da struct.", forma = "Use um nome declarado."},
    ItemCatalogo{codigo = "E0102", tipo = "caixa", explicacao = "O nome nao segue a caixa da Forja: tipo, unidade, struct e enum em PascalCase; constante em MAIUSCULO; o resto em snake_case; sempre ASCII sem acento.", forma = "Renomeie para a forma sugerida na causa (ex.: MetrosPorSegundo, VIDA_MAX, soma_ate)."},
    ItemCatalogo{codigo = "E0202", tipo = "nome", explicacao = "O nome ja foi declarado (ou e reservado pela linguagem); a Forja nao tem sombra nem sobrecarga.", forma = "Escolha outro nome."},
    ItemCatalogo{codigo = "E0601", tipo = "resultado", explicacao = "Um valor 'T ! E' nao pode ser ignorado: o erro precisa ser tratado.", forma = "Use try (repassa o erro), _ = try f() (repassa o erro e descarta o valor), or_else (valor padrao), switch (trata os dois casos) ou let (guarda o resultado)."},
    ItemCatalogo{codigo = "E0602", tipo = "resultado", explicacao = "'try' so repassa o erro dentro de um proc cujo retorno e '! E' ou 'T ! E'.", forma = "Declare o retorno do proc como 'T ! E' ou trate o resultado com or_else ou switch."},
    ItemCatalogo{codigo = "E0603", tipo = "resultado", explicacao = "O enum de erro do 'try' e diferente do enum de erro declarado no retorno do proc.", forma = "Use o mesmo enum de erro no retorno do proc ou trate o resultado com switch."},
    ItemCatalogo{codigo = "E0604", tipo = "resultado", explicacao = "or_else exige um resultado com valor a esquerda e, a direita, um valor do mesmo tipo desse valor.", forma = "Escreva <resultado> or_else <padrao> com padrao do tipo T de 'T ! E'."},
    ItemCatalogo{codigo = "E0605", tipo = "resultado", explicacao = "O tipo depois de '!' precisa ser um enum de erro.", forma = "Declare enum <NomeDoErro> { ... } e escreva T ! <NomeDoErro>."},
    ItemCatalogo{codigo = "E0606", tipo = "resultado", explicacao = "'try' so se aplica a resultado ('T ! E'); 'or_else' aplica-se a resultado com valor, a ?T e a ?^T.", forma = "r or_else padrao  -  x or_else 0 (x: ?i32)  -  p or_else &g (p: ?^T)  -  try so com 'T ! E'"},
    ItemCatalogo{codigo = "E0607", tipo = "resultado", explicacao = "O switch precisa cobrir todos os casos (membros do enum; valor e erro; T e none; todas as variantes da union) ou ter 'default'.", forma = "Acrescente os case que faltam ou um 'default:'."},
    ItemCatalogo{codigo = "E0608", tipo = "resultado", explicacao = "O switch aceita enum, resultado, ?T, ?^T e union; cada case precisa ser valido, unico e do tipo do valor.", forma = "enum: case Enum.membro:  -  resultado: case Tipo: / case Erro:  -  ?T: case T: / case none:  -  union: case Variante:"},
    ItemCatalogo{codigo = "E0701", tipo = "fluxo", explicacao = "break e continue so existem dentro de while ou for.", forma = "Mova o comando para dentro do laco ou remova-o."},
    ItemCatalogo{codigo = "E0702", tipo = "fluxo", explicacao = "O erro de uma chamada adiada com defer nao tem para onde ir.", forma = "Adie uma chamada que nao devolve resultado, ou trate o resultado antes."},
    ItemCatalogo{codigo = "E0703", tipo = "fluxo", explicacao = "O return nao combina com o retorno do proc: em 'T ! E' devolva um T ou um membro do enum E.", forma = "Use return <valor do tipo T> ou return <E>.membro."},
    ItemCatalogo{codigo = "E0704", tipo = "fluxo", explicacao = "Comando depois de return, break ou continue nunca executa.", forma = "Remova o comando ou mova-o para antes."},
    ItemCatalogo{codigo = "E0705", tipo = "fluxo", explicacao = "Variavel de let, parametro, variavel de for e ligacao de switch sao imutaveis; so 'var' aceita atribuicao. Tambem vale para '&', fatia e 'for &item' de algo imutavel (let, parametro, item de for, valor de chamada); elemento de fatia e campo atraves de ponteiro sao alteraveis. Tambem vale para append(&x) e delete(x) de lista imutavel. '&x' de let ou parametro tambem e E0705: o endereco deixaria alterar o valor.", forma = "Declare com 'var' ou passe um ponteiro '^T' para alterar o valor, ou escreva atraves de um ponteiro (p^ = v, p.campo = v)  -  var a: [4]int = {} antes de for &x in a  -  var x = 3  let p = &x."},
    ItemCatalogo{codigo = "E0801", tipo = "teste", explicacao = "expect so pode aparecer dentro de um bloco test.", forma = "Use assert(cond, msg = \"...\") fora de test."},
    ItemCatalogo{codigo = "E0802", tipo = "teste", explicacao = "O test precisa de um titulo entre aspas, nao vazio e unico no modulo.", forma = "Escreva test \"o que o teste prova\" { ... }."},
    ItemCatalogo{codigo = "E0901", tipo = "exportacao", explicacao = "Um proc exportado so aceita e devolve tipos de forma fixa em C: i8..i64, u8..u64, int, uint, f32, f64, bool, enum e ponteiro para struct. Struct por valor atravessa (o .h define a struct) se todos os campos atravessam; resultado 'T ! E' e texto (str) ainda nao atravessam a fronteira. Array e fatia nao atravessam: passe ^T do 1o elemento e n: u64. Lista [dynamic]T tambem nao atravessa. ?T (menos ?cstr), union e retorno multiplo nao atravessam. cstr devolvido sai so com return format_c(..., alloc = heap) direto, e o C libera com forja_liberar(p).", forma = "Troque o tipo por um dos aceitos (ex.: devolva i32 com o codigo de erro, ou passe a struct por ponteiro ^<Struct>)  -  pub export proc nome() -> cstr { return format_c(f\"texto\", alloc = heap) }."},
    ItemCatalogo{codigo = "E0902", tipo = "exportacao", explicacao = "O nome exportado vira simbolo de DLL e nao pode ser palavra do C, nome da libc usado pelo C gerado, 'main', nem comecar com fj_ ou forja_.", forma = "Escolha outro nome para o proc exportado (ex.: somar_valores)."},
    ItemCatalogo{codigo = "E0903", tipo = "exportacao", explicacao = "'export' so existe junto de 'pub' e so em proc; 'pub' nao vale em test.", forma = "Escreva pub export proc <nome>(...) ou tire o 'export'."},
    ItemCatalogo{codigo = "E0303", tipo = "bits", explicacao = "Operadores de bits (& | ~ << >>) so valem em inteiro sem sinal (u8, u16, u32, u64, uint); em inteiro com sinal o bit de sinal deixaria o resultado dependente da representacao.", forma = "Declare o valor como sem sinal (let m: u32 = 1 << 3), ou converta: (x as u32) & 255, ou transmute(x, to = u32) para os bits crus."},
    ItemCatalogo{codigo = "E0304", tipo = "transmute", explicacao = "transmute reinterpreta os bits de um valor como outro tipo; so vale entre tipos numericos do mesmo tamanho (1: i8 u8; 2: i16 u16; 4: i32 u32 f32 e unidades; 8: int uint i64 u64 f64).", forma = "Use transmute(x, to = u32) com x de 4 bytes; para mudar o VALOR (e nao os bits) use <x> as <T>."},
    ItemCatalogo{codigo = "E0305", tipo = "tipo", explicacao = "O '-' unario nao existe em inteiro sem sinal: o resultado seria negativo.", forma = "Use um tipo com sinal (i32, int) ou escreva a subtracao explicita (0 - x trava em dev se x > 0)."},
    ItemCatalogo{codigo = "E0609", tipo = "resultado", explicacao = "Em 'T ! E' o tipo do valor e o enum de erro precisam ser diferentes; iguais, um 'return E.membro' nao diz se e valor ou erro.", forma = "Crie um enum de erro proprio (ex.: enum <ErroDoModulo> { ... }) e use T ! <ErroDoModulo>."},
    ItemCatalogo{codigo = "E0306", tipo = "ponteiro", explicacao = "'^T' e o ponteiro que nunca e nulo: le-se com 'p^' (ou 'p.campo' em struct, um nivel so). '?^T' pode ser none: leia com switch q in p { case ^T: ... case none: ... } ou p or_else &padrao (o 'p as ^T' antigo continua); rawptr e o 'void *' do C e nao se le. Ponteiro nao tem conta nem ordem, nao vira numero, e 'as' nao troca o tipo apontado direto.", forma = "if p != none { let q = p as ^T  q.campo = 1 }  -  pp^.campo para ^^T  -  (p as rawptr) as ^Outro para trocar o tipo apontado  -  let p: ?^T = none  -  switch q in p { case ^T: q.campo = 1 case none: }."},
    ItemCatalogo{codigo = "E0307", tipo = "texto", explicacao = "'str' e o texto da Forja (ponteiro + tamanho em bytes UTF-8, sem NUL obrigatorio); 'cstr' e o texto do C terminado em NUL, para foreign e export. Um literal \"...\" vira o que o contexto pede. cstr -> str e 'c as str'; str -> cstr precisa alocar (v1.6). == em cstr compararia enderecos; str nao se soma nem tem ordem.", forma = "let c: cstr = \"texto\"  -  (c as str) == \"abc\"  -  len(s) com s: str."},
    ItemCatalogo{codigo = "E0706", tipo = "fluxo", explicacao = "Variavel local e array local deixam de existir quando o proc retorna. O endereco deles (&x, &x.campo, &a[i]) e a fatia de array local (a[..]) nao saem do proc por caminho nenhum: return (direto, por let/var, dentro de struct, array, tupla ou ?T), gravacao em global, em memoria de heap ou apontada por parametro, append/insert em lista que sai do proc, ou argumento de proc que guarda o parametro. A causa mostra a cadeia (x -> p -> return). Emprestar a um proc que so usa durante a chamada vale; foreign nao e conferido.", forma = "Devolva o valor (return x) ou receba o destino do chamador por ponteiro (proc preencher(saida: ^T) { saida.campo = 1 }), ou copie o valor."},
    ItemCatalogo{codigo = "E0904", tipo = "foreign", explicacao = "Um proc foreign e uma funcao C: so atravessam tipos de forma fixa em C - i8..i64, u8..u64, int, uint, f32, f64, bool, enum (int32_t), unidade (float), ^T, ?^T, rawptr, cstr (entrando e saindo) e struct por valor cujos campos atravessam. str, 'T ! E', '! E' e struct com str ficam de fora. Array e fatia nao atravessam: passe ^T do 1o elemento e n: u64. Lista [dynamic]T tambem nao atravessa. ?cstr (NULL = none) atravessa; outros ?T, union e retorno multiplo nao. Mapa do C: int = i32, long = i32 no Windows, long long = i64, size_t = u64, double = f64, char* de leitura = cstr, handle opaco = rawptr ou ^Struct sem campo; funcao C que devolve int como verdadeiro/falso = i32, nao bool. Callback: parametro 'proc(nome: T) -> R' (E0907). Tipo opaco: 'opaque Nome' e ^Nome (E0908). Struct por valor pode ter campo struct e array [N]T de tipos que atravessam. Funcao variadica ('...') nao atravessa: declare uma funcao C de parametros fixos. char ** = ?^cstr; retorno char * = ?cstr emprestado (delete nao libera).", forma = "foreign { link \"m\"  proc sqrt(x: f64) -> f64 } (um item por linha)  -  erro do C volta como i32 e vira enum na Forja  -  texto para o C: cstr (literal ou let c: cstr = \"...\")."},
    ItemCatalogo{codigo = "E0905", tipo = "foreign", explicacao = "O nome do proc foreign e o simbolo C, igual ao do header (a caixa do C vale; os parametros seguem snake_case); com alias 'proc c_remove = \"remove\"(...)' o nome e da Forja (snake_case) e o simbolo C vem entre aspas (identificador C, sem repetir outro nome de topo nem outro alias); 'main' e os prefixos fj_ e forja_ sao do compilador (no simbolo C tambem). Em 'link \"x\"' vai so o nome da biblioteca, que vira -lx no gcc: sem caminho, sem extensao, sem prefixo de opcao; o ld procura libx.a, libx.dll.a, x.lib, libx.dll e x.dll na pasta do .fj e nas pastas do gcc.", forma = "link \"raylib\" (raylib.dll ou libraylib.a ao lado do .fj)  -  proc InitWindow(largura: i32, altura: i32, titulo: cstr)."},
    ItemCatalogo{codigo = "E0906", tipo = "foreign", explicacao = "'export' nao se aplica a foreign: o proc foreign e um simbolo de outra biblioteca; quem exporta e a Forja, por 'pub export proc'. 'pub foreign' vale: deixa os procs visiveis a quem importa o modulo.", forma = "pub export proc raiz(x: f64) -> f64 { return sqrt(x) }"},
    ItemCatalogo{codigo = "E0308", tipo = "array", explicacao = "[N]T e um array de N elementos (N literal inteiro ou const inteira, maior que zero): e um valor - copia ao atribuir, passar e devolver. []T e uma fatia (ponteiro + tamanho) que empresta os elementos de um array e pode altera-los. ^[N]T aponta um array. Indexe com a[i], fatie com a[lo..<hi], a[lo..=hi] ou a[..]; len(x) da o tamanho (em array e constante e nao avalia o argumento). Nao existem nesta versao: ==/!=/ordem e conta em array ou fatia, campo (.x .y .z .w) e [Enum]T (depois da v1.9; para vetor e matriz com conta use matrix[R, C]T), indexar ou fatiar str, faixa em campo array, array de 'T ! E'. Lista [dynamic]T: mesmas leituras (l[i], fatia, len, for), sem ==, conta nem campo.", forma = "var a: [4]int = {1, 2, 3, 4}  -  a[0] = 9  -  for i, x in a { ... }  -  let s = a[1..<3]  -  igualdade: for i, x in a { if x != b[i] { ... } }"},
    ItemCatalogo{codigo = "E0309", tipo = "array", explicacao = "O literal de array {a, b, c} pega o tipo do contexto (let/var tipado, atribuicao, argumento, return, campo) e tem exatamente N elementos; {} e o valor zero (todos zero) e, num contexto []T, a fatia vazia. Sem contexto nao ha tipo; ^T e union nao tem zero (o literal precisa de todos os elementos); fatia nao tem literal com elementos (declare o array e fatie). Lista dinamica nao tem literal: nasce de make.", forma = "let a: [3]int = {1, 2, 3}  -  var z: [8]f32 = {}  -  let p: [2]^T = {&a, &b}  -  let s = a[..]"},
    ItemCatalogo{codigo = "E0421", tipo = "array", explicacao = "Indice ou limite de fatia conhecido na compilacao (literal, const ou conta de constantes) fora do array: [N]T aceita indice 0..<N e limite de fatia 0..=N; negativo nunca vale. Valor so conhecido em execucao e conferido em dev/test (R0006).", forma = "a[len(a) - 1] e o ultimo  -  a[..] e o array inteiro  -  if i < len(a) { usar(a[i]) }"},
    ItemCatalogo{codigo = "E0310", tipo = "memoria", explicacao = "Alocacao explicita: new(T, alloc = heap|frame) devolve ^T com o valor inicial de T (struct: os padroes); make([dynamic]T, alloc = heap|frame, cap = N) cria uma lista vazia com espaco para N; append(&lista, item = x) acrescenta; delete(p) libera o que veio de new e delete(lista) libera a lista (e a deixa vazia); frame_reset() esvazia o alocador frame (chame uma vez por quadro; memoria de frame so vale dentro do quadro). alloc so aceita heap ou frame nesta versao (Arena e Pool existem na v1.8). O resultado de new e make precisa ser guardado. new nao cria lista (use make) nem ^T sem valor; delete de lista apontada e delete(p^). format e format_c tambem alocam: o resultado precisa ser guardado; delete(s) libera str, cstr ou ?cstr vindo de format/format_c alloc = heap. Em v1.8: alloc recebe heap, frame, scope, Arena ou Pool (import \"std:mem\"); Pool so em new, e volta com delete(p, alloc = pool); objeto de Arena se libera com arena_reset/arena_destroy. Texto (?cstr ou cstr) e ponteiro (^T ou ?^T) devolvidos por proc foreign sao emprestados da biblioteca C: delete deles nao existe.", forma = "var lista = make([dynamic]T, alloc = heap, cap = 256)  -  append(&lista, item = valor)  -  let p = new(T, alloc = heap)  -  defer delete(p)  -  delete(lista)  -  frame_reset()"},
    ItemCatalogo{codigo = "E0311", tipo = "memoria", explicacao = "[dynamic]T e dono da memoria dos elementos; struct com campo lista e array de listas tambem. Dono nao se copia (copiar criaria duas donas: um append numa deixaria a outra apontando memoria liberada). Para alterar passe o endereco (^[dynamic]T); para ler ou alterar elementos empreste uma fatia (l[..]); valores novos (make, chamada, literal) se movem para a variavel, e 'return local' move a lista para fora. Parametro por valor, 'for item' sobre listas e campo dono com padrao nao existem; 'T ! E' aceita a lista dona no sucesso (proc ler() -> [dynamic]u8 ! FileError).", forma = "proc encher(l: ^[dynamic]int) { append(l, item = 1) }  -  encher(&lista)  -  somar(lista[..])  -  for &linha in grade { ... }  -  proc criar() -> [dynamic]int { var l = make(...)  return l }  -  proc ler() -> (lista: [dynamic]int, erro: ?E)"},
    ItemCatalogo{codigo = "E0312", tipo = "opcional", explicacao = "?T guarda um valor de T ou none. Nasce de um T (a conversao e automatica) ou de none; le-se so desembrulhando: switch v in x { case T: ... case none: ... } ou x or_else padrao. Compara-se so com none (x == none, x != none); nao faz conta nem tem campo. Nao existem ??T, ?rawptr (rawptr ja aceita none), ??^T, nem ?dono ([dynamic]T ou struct com lista: a lista vazia ja e a ausencia). ?^T continua o ponteiro anulavel; ?cstr e o char* que pode ser NULL. try nao se aplica a ?T.", forma = "let a: ?i32 = none  -  a = 5  -  let v = a or_else 0  -  switch v in a { case i32: print(v) case none: print(0) }  -  if a != none { ... }"},
    ItemCatalogo{codigo = "E0313", tipo = "union", explicacao = "union Nome { A, B } guarda exatamente um valor de uma das variantes (2 a 255 tipos distintos); o valor da variante vira union sozinho (let f: U = A{...}). Le-se so por switch v in f { case A: ... }, cobrindo todas as variantes ou com default. Union nao tem valor zero, ==, campo, conta nem literal proprio, e nao atravessa a fronteira C. Variante nao pode ser ?T, union, 'T ! E', lista nem struct com lista. Literal solto precisa do tipo (3 as i32).", forma = "union U { A, B }  -  let f: U = A{campo = 2.0}  -  switch c in f { case A: print(c.campo) case B: print(c.outro) }  -  let v: U = 3 as i32 (se i32 e variante de U)"},
    ItemCatalogo{codigo = "E0314", tipo = "retorno", explicacao = "Retorno multiplo: proc f() -> (q: int, r: int) devolve de 2 a 8 valores nomeados com return a, b (na ordem) ou return g() do mesmo tipo. Quem chama desestrutura com let q, r = f() (ou var), um nome por valor; _ descarta. A tupla nao vira variavel, nao tem campo e nao vai para argumento, print ou conta. Nao existe '(..) ! E': ponha o erro num elemento ?E. Nao atravessa export nem foreign.", forma = "proc dividir(a: int, b: int) -> (q: int, r: int) { return a / b, a % b }  -  let q, r = dividir(7, b = 2)  -  let q, _ = dividir(7, b = 2)  -  proc ler() -> (dados: [dynamic]u8, erro: ?E)"},
    ItemCatalogo{codigo = "E0315", tipo = "texto", explicacao = "f\"...\" monta texto com pedacos e {expressao} ou {expressao:formato}; vale so como 1o argumento de print, format (devolve str) e format_c (devolve cstr terminado em NUL). {expressao} aceita inteiros, bool, str, cstr, f32, f64 e unidade. Formato: [0][largura 1..255][.precisao 0..30][x] - largura alinha a direita, 0 preenche com zeros (so numero), .precisao so em real, x (hexadecimal) so em inteiro sem sinal. {{ e }} escrevem uma chave; dentro de {} nao vale aspas nem chaves. format e format_c pedem alloc = heap|frame: heap se libera com delete(s), frame vale ate o frame_reset().", forma = "print(f\"Vida: {g.vida}\")  -  let s = format(f\"{x:08.3}\", alloc = frame)  -  let c = format_c(f\"id {n:x}\", alloc = heap)  defer delete(c)  -  print(f\"{{chave}}\")"},
    ItemCatalogo{codigo = "E0316", tipo = "memoria", explicacao = "alloc = scope aloca no heap e libera sozinho no fim do bloco do let (defer delete automatico). Por isso so vale direto no let/var e o valor nao sai do bloco: return, guardar em campo, elemento ou ponteiro, literal, append, copia para outro local, reatribuicao e delete sao recusados. Emprestar para um proc (argumento) vale.", forma = "let p = new(T, alloc = scope)  -  var l = make([dynamic]int, alloc = scope)  -  para entregar a outro dono use alloc = heap e delete"},
    ItemCatalogo{codigo = "E0317", tipo = "memoria", explicacao = "Memoria de heap tem UM dono, que precisa liberar (delete) ou entregar (return, proc, campo, append) o bloco antes do fim do bloco e antes de return, break ou continue. Copiar o dono para outro local criaria dois donos; reatribuir antes do delete perderia o bloco.", forma = "let p = new(T, alloc = heap)  defer delete(p)  -  return p  -  guardar(p)  -  alloc = scope quando o valor nao sai do bloco"},
    ItemCatalogo{codigo = "E0318", tipo = "map", explicacao = "map[K]V e uma tabela de chave para valor, DONA da memoria como a lista: nasce de make(map[K]V, alloc = heap, frame, scope ou uma Arena, cap = N) (Pool nao serve), copiar e recusado (E0311) e delete(m) libera e a deixa vazia com o mesmo alocador. Chave: inteiro, enum, bool ou str (o texto da chave e emprestado: precisa viver tanto quanto o map). Valor: qualquer tipo menos ?T, ?^T, rawptr, resultado com erro e dono. insert(&m, key = k, value = v) grava (sobrescreve se a chave existe); get(m, key = k) devolve ?V; get_ptr(&m, key = k) devolve ?^V, valido ate o proximo insert, remove ou delete do mesmo map; has(m, key = k) devolve bool; remove(&m, key = k) apaga; len(m) conta. for k, v in m (ou for k, &v in m) percorre na ordem de insercao; remove move o ultimo par para o buraco. Dentro do for de m, insert, remove e delete de m sao recusados. m[k] nao existe.", forma = "var m = make(map[str]int, alloc = heap)  defer delete(m)  -  insert(&m, key = \"ouro\", value = 10)  -  let n = get(m, key = \"ouro\") or_else 0  -  for k, v in m { ... }"},
    ItemCatalogo{codigo = "E0319", tipo = "bit_set", explicacao = "bit_set[E] guarda um conjunto de membros do enum E num inteiro sem sinal (1 bit por membro, ate 64 membros, enum sem valor explicito). Literal pelo contexto: let s: bit_set[E] = {E.a, E.b} ({} = vazio). Operadores: | (uniao), & (intersecao), - (diferenca), == e !=. insert(&s, key = m), remove(&s, key = m), has(s, key = m) e len(s) (quantos membros). for item in s percorre os membros na ordem do enum; for &item e for i, item nao existem. Ordem (<, >), <<, >> e indice s[k] nao existem.", forma = "enum E { a, b, c }  -  var s: bit_set[E] = {E.a}  -  insert(&s, key = E.b)  -  if has(s, key = E.a) { ... }  -  let u = s | t"},
    ItemCatalogo{codigo = "E0320", tipo = "soa", explicacao = "soa[N]S e soa[dynamic]S guardam structs S coluna por coluna (cada campo num array proprio: melhor para a cache em laco que le poucos campos). S e struct da Forja com ao menos 1 campo e sem campo dono. a[i].campo le e grava; a[i] le a struct inteira (copia) e a[i] = s grava todos os campos; &a[i].campo vale; a.campo e a fatia []T da coluna (pede var); len(a); for item in a e for i, item in a. &a[i] e for &item nao existem (a struct nao fica inteira na memoria). soa[dynamic]S e dona como a lista: make(soa[dynamic]S, alloc = heap, cap = N), append(&a, item = s), delete(a). soa[]S nao existe.", forma = "var a: soa[1024]S = {}  -  a[i].x += a[i].vx  -  soma(a.x)  -  var b = make(soa[dynamic]S, alloc = heap)  append(&b, item = S{x = 1.0})"},
    ItemCatalogo{codigo = "E0321", tipo = "matrix", explicacao = "matrix[R, C]T e uma matriz de R linhas e C colunas (R e C literais de 2 a 4; T = f32 ou f64), guardada por coluna (a ordem da GPU). Literal por linhas, com R*C elementos: let m: matrix[2, 2]f32 = {1.0, 2.0, 3.0, 4.0} ({} = zero). m[linha, coluna] le e grava; &m[i, j] vale. Contas: + e - entre matrizes do mesmo tipo, * de matriz por matriz (colunas da 1a = linhas da 2a), * por escalar T (dos dois lados), * por vetor [C]T (devolve [R]T), -m e transpose(m). Nao existem: ==, /, m[i], for, len, print e unidade no elemento.", forma = "var mvp: matrix[4, 4]f32 = {}  -  let p = proj * view  -  let v = mvp * pos  -  mvp[0, 3] = 1.0  -  let t = transpose(mvp)"},
    ItemCatalogo{codigo = "E1001", tipo = "modulo", explicacao = "import \"caminho\" so no topo do arquivo. O caminho e relativo a pasta do arquivo raiz, com segmentos snake_case separados por '/', sem extensao, sem '..' e sem caminho absoluto; \"std:mem\" e a biblioteca padrao embutida; \"vendor:x/y\" le vendor\\x\\y.fj ao lado do arquivo raiz (as bibliotecas de link do modulo ficam em vendor\\); \"engine:x\" le %FORJA_ENGINE%\\forja\\x.fj (bibliotecas em %FORJA_ENGINE%\\lib). O apelido (ultimo segmento ou 'as nome') e unico no arquivo.", forma = "import \"std:mem\"  -  import \"jogo/fisica\"  -  import \"jogo/fisica\" as fis  -  import \"std:os\" (o antigo std:proc)"},
    ItemCatalogo{codigo = "E1002", tipo = "modulo", explicacao = "Os imports formam um grafo sem ciclo: um modulo nao pode importar, direta ou indiretamente, quem o importa (nem o arquivo raiz). Leve o que os dois usam para um terceiro modulo.", forma = "a importa comum e b importa comum (em vez de a <-> b)"},
    ItemCatalogo{codigo = "E1003", tipo = "modulo", explicacao = "Nome de outro modulo se escreve apelido.nome e so e visivel se foi declarado com pub. Sem apelido, so os nomes do proprio arquivo (e os da linguagem) sao visiveis.", forma = "pub proc area(l: int) -> int  -  geo.area(3)  -  let p: geo.Ponto"},
    ItemCatalogo{codigo = "E1004", tipo = "modulo", explicacao = "'proc main' e 'pub export proc' so valem no arquivo raiz (o que o forja recebe): o modulo importado e uma biblioteca do programa.", forma = "deixe main e os export no arquivo raiz e chame o modulo de la"},
    ItemCatalogo{codigo = "E0907", tipo = "foreign", explicacao = "Callback: um parametro de proc foreign pode ter o tipo 'proc(nome: T, ...) -> R' (ponteiro de funcao do C). O argumento e o nome de um proc da Forja com a mesma assinatura; o compilador gera um trampolim C que confere os ^T e cstr que o C passa (R0005 se vier NULL). O tipo proc(nome: T, ...) -> R tambem vale como campo de struct (inclusive de foreign), let/var, parametro e retorno de proc da Forja, e o valor e o nome de um proc da Forja (sem captura: nada de closure); a assinatura precisa ser igual (os nomes dos parametros nao contam). E0907 diz onde isso NAO vale: ?proc, proc dentro de [N]/[]/[dynamic]/map/union/soa/^, proc foreign como valor, proc dentro da assinatura de outro proc e proc de assinatura diferente da pedida. O contexto do C (void *user_data) chega como rawptr: converta com 'ctx as ^T'.", forma = "foreign { proc qsort(base: rawptr, n: u64, tamanho: u64, comparar: proc(a: rawptr, b: rawptr) -> i32) }  -  qsort(&v[0] as rawptr, n = 5, tamanho = 4, comparar = comparar_i32)"},
    ItemCatalogo{codigo = "E0908", tipo = "foreign", explicacao = "Tipo opaco: 'opaque Nome' dentro de foreign declara um tipo cujo layout so a biblioteca C conhece (struct incompleta do header). Ele so existe atras de ponteiro: ^Nome ou ?^Nome em parametro, retorno, campo e variavel. Valor por valor, literal Nome{}, new(Nome), leitura p^ e acesso a campo nao existem.", forma = "foreign { opaque Handle  proc criar() -> ?^Handle  proc fechar(h: ?^Handle) }  -  let h = criar()"},
    ItemCatalogo{codigo = "R0001", tipo = "runtime", explicacao = "Um valor saiu da faixa declarada ('in a..=b' do campo ou da constante); a checagem so existe em dev e test.", forma = "Corrija a conta ou o valor de entrada para ficar dentro da faixa declarada."},
    ItemCatalogo{codigo = "R0002", tipo = "runtime", explicacao = "Uma conta de inteiro estourou o tipo (soma, subtracao, multiplicacao, negacao, MIN / -1) ou uma conversao 'as' recebeu um valor que nao cabe no destino (inclusive real NaN ou infinito), em dev e test. Em release a conta da a volta e a conversao de real satura.", forma = "Use um tipo maior, limite os valores antes, ou mascare antes do 'as' ((x & 255) as u8) quando quiser truncar."},
    ItemCatalogo{codigo = "R0003", tipo = "runtime", explicacao = "Um panic ou assert do programa falhou; fora de test o processo sai com 101.", forma = "Corrija a condicao que falhou ou trate o caso antes de chamar panic."},
    ItemCatalogo{codigo = "R0004", tipo = "runtime", explicacao = "O proc main devolveu um erro ('main -> ! E'); o programa sai com 1.", forma = "Trate o erro dentro do main (switch ou or_else) se ele nao deve terminar o programa."},
    ItemCatalogo{codigo = "R0005", tipo = "runtime", explicacao = "Um ponteiro nulo chegou onde a Forja exige '^T' ou cstr: 'as ^T' de none/rawptr nulo, 'as str' de cstr nulo, ou parametro '^T'/cstr de proc exportado chamado com NULL, ou um proc foreign com retorno '^T' ou cstr devolveu NULL. Checado em dev e test e, em release, com --checagem sim (--checagem nao tira a checagem). Tambem: parametro ^T/cstr de um proc da Forja chamado pelo C como callback recebeu NULL; chamada por proc nulo (campo proc de uma struct que o C deixou sem valor, 'as proc(...)' de rawptr ou ?^T nulo).", forma = "Teste 'p != none' antes do 'as ^T'; num proc exportado que aceita NULL declare o parametro como '?^T' ou rawptr; proc foreign que pode devolver NULL: declare o retorno como ?^T ou rawptr e teste 'p != none' antes do 'as'."},
    ItemCatalogo{codigo = "R0006", tipo = "runtime", explicacao = "Em execucao um indice saiu de 0..<len ou um limite de fatia saiu de 0..=len (ou o inicio passou do fim); o programa sai com 101 (tambem dentro de uma DLL). Vale em dev e test e, em release, com --checagem sim; com --checagem nao o acesso fora e comportamento indefinido do C.", forma = "if i < len(a) { usar(a[i]) }  -  'for i, x in a' nunca sai dos limites"},
    ItemCatalogo{codigo = "R0007", tipo = "memoria", explicacao = "Uma alocacao nao pode ser feita: sem memoria no heap, frame cheio (16 MiB; chame frame_reset() a cada quadro), cap negativo em make, append numa lista sem alocador (valor zero de campo omitido) ou append numa [dynamic, N]T cheia. Conferido em dev e em release; sai com 101 (tambem dentro de uma DLL).", forma = "frame_reset() no fim de cada quadro  -  if n >= 0 { var l = make([dynamic]int, alloc = heap, cap = n) }  -  S{lista = make([dynamic]int, alloc = heap)}"},
    ItemCatalogo{codigo = "R0008", tipo = "memoria", explicacao = "Em dev/test: delete de um ponteiro que nao veio de new(alloc = heap) ou que ja passou por delete (delete(p) zera o nome p, entao delete duplo pelo mesmo nome nao acontece: o R0008 vem de ponteiro guardado em estrutura ou liberado dentro de outro proc), ou uma lista criada no frame usada depois do frame_reset(). Em release nao ha checagem (comportamento indefinido do C). Memoria liberada fica envenenada (0xDD) em dev. A linha do x64 dev traz o campo bloco (heap, lista ou arena) e 3 pilhas: pilha (onde o uso falhou), pilha_alocacao (onde o bloco nasceu) e pilha_delete (onde morreu: delete, append que moveu a lista ou arena_destroy); em dev o append de lista de heap sempre move o buffer.", forma = "delete uma vez so, de quem veio de new  -  lista de frame so dentro do quadro; para atravessar quadros use alloc = heap"},
    ItemCatalogo{codigo = "R0009", tipo = "memoria", explicacao = "Em dev/test: no fim do programa ainda havia blocos de heap vivos (new, make, format ou format_c com alloc = heap sem delete). Cada linha diz onde o bloco foi alocado. Com \"tipo\": \"lib\" (dev, x64) a linha conta a memoria que uma biblioteca C estatica alocou e nao soltou. Em release nao ha checagem.", forma = "delete(x) quando o valor deixa de ser usado  -  defer delete(x) logo depois do let  -  alloc = scope para valor que nao sai do bloco"},
    ItemCatalogo{codigo = "R0010", tipo = "runtime", explicacao = "Uma excecao C++ escapou de uma funcao chamada pela Forja pelo wrapper C que 'forja ligar --cpp' gera. O wrapper a captura (excecao nao atravessa a fronteira C), escreve este JSON com Classe::metodo e o texto de what() e encerra o programa com 101. Vale em dev e release.", forma = "Confira os argumentos antes da chamada (o JSON diz qual metodo falhou) ou trate o erro dentro do C++ e devolva um codigo (i32) que a Forja testa."},
    ItemCatalogo{codigo = "B0001", tipo = "build", explicacao = "Codigo historico e reservado desde a Forja 0.21.0: o backend C foi aposentado, e o forja nao chama mais o compilador C (gcc) para o programa do usuario. O codigo fica no catalogo para a cobertura de docs.", forma = "Nenhuma acao: use o backend x64 (o padrao) e nao precisa de gcc nem de FORJA_CC."},
    ItemCatalogo{codigo = "B0002", tipo = "build", explicacao = "O gcc recusou o C gerado; o defeito esta no compilador ou no IR, nao no codigo .fj.", forma = "Leia o erro do gcc acima; o .c mantido em %TEMP% serve para inspecao."},
    ItemCatalogo{codigo = "B0003", tipo = "build", explicacao = "O build --modo dll precisa de pelo menos um 'pub export proc': sem ele a DLL nao teria nenhum simbolo para chamar.", forma = "Marque o proc que PHP ou Python vao chamar com pub export proc <nome>(...)."},
    ItemCatalogo{codigo = "B0004", tipo = "build", explicacao = "A ligacao com as bibliotecas de foreign falhou: o ld nao achou uma biblioteca de 'link' ou um proc foreign nao existe nela com esse nome (a mensagem do ld vai em ferramenta.saida deste JSON). O C gerado esta certo; o defeito esta no bloco foreign ou na pasta.", forma = "Confira cada 'link \"x\"' (libx.a, libx.dll.a ou x.dll na pasta do .fj) e se cada proc tem o nome exato do C, com a mesma caixa; o exe que usa .dll precisa da .dll ao lado dele para rodar."},
    ItemCatalogo{codigo = "G0001", tipo = "ligar", explicacao = "Tipo C sem forma na Forja: long double, __int128, _Complex, vetor SIMD, _Atomic ou array sem tamanho fora de struct. O simbolo que o usa fica fora do modulo gerado.", forma = "Escreva um wrapper C com tipos simples (double, int64_t) e gere o modulo dele."},
    ItemCatalogo{codigo = "G0003", tipo = "ligar", explicacao = "Ponteiro de funcao fora de parametro de funcao (campo de struct, retorno, variavel global ou ponteiro para ponteiro de funcao): na Forja o tipo proc(...) so existe em parametro de proc foreign.", forma = "Guarde o ponteiro de funcao no lado C (wrapper que recebe o callback por parametro) ou use rawptr no campo."},
    ItemCatalogo{codigo = "G0004", tipo = "ligar", explicacao = "Macro que nao vira const: macro com parametros (macro-funcao) ou cujo valor nao e um literal inteiro, real ou texto simples.", forma = "Escreva a const a mao no .fj (pub const NOME: i32 = ...) ou um proc Forja que faz a conta da macro."},
    ItemCatalogo{codigo = "G0005", tipo = "ligar", explicacao = "Simbolo sem ligacao externa: variavel global (extern int x) ou funcao static/inline do header; foreign so liga funcoes exportadas.", forma = "Exponha a variavel por funcoes get/set num wrapper C; funcao inline: escreva o equivalente em Forja ou um wrapper C nao inline."},
    ItemCatalogo{codigo = "G0006", tipo = "ligar", explicacao = "Struct com bitfield (int x : 3): a Forja nao tem campo de bits e o layout dependeria do compilador. A struct e os simbolos que a usam ficam fora.", forma = "Passe a struct por ponteiro opaco e leia os campos por funcoes C."},
    ItemCatalogo{codigo = "G0007", tipo = "ligar", explicacao = "Struct com layout diferente do natural (#pragma pack, packed ou aligned): a Forja so gera o layout natural do C.", forma = "Use a struct por ponteiro (opaque) e acesse por funcoes C."},
    ItemCatalogo{codigo = "G0008", tipo = "ligar", explicacao = "Funcao variadica (...) ou com va_list: no Windows x64 o C le os reais variadicos em outro registrador e a Forja nao gera essa chamada.", forma = "Escreva uma funcao C de parametros fixos que chama a variadica (ex.: log_texto(const char *s) chamando log(\"%s\", s))."},
    ItemCatalogo{codigo = "G0013", tipo = "ligar", explicacao = "Nome que nao vira simbolo Forja: palavra reservada da Forja, prefixo fj_ ou forja_, 'main', ou dois simbolos C que viram o mesmo nome na Forja.", forma = "Use --prefixo para filtrar ou declare o proc a mao com alias do simbolo C: proc c_remove = \"remove\"(caminho: cstr) -> i32 (o forja ligar gera o alias sozinho com prefixo)."},
    ItemCatalogo{codigo = "G0014", tipo = "ligar", explicacao = "Struct ou union anonima dentro de struct, ou membro flexivel (array sem tamanho no fim da struct): sem nome nem tamanho fixo na Forja.", forma = "De nome ao tipo de dentro no header (typedef) ou use a struct por ponteiro."},
    ItemCatalogo{codigo = "G0016", tipo = "ligar", explicacao = "Enum com valor fora de i32 ou membro que repete o valor de outro (apelido): o enum da Forja vira int no C e cada membro tem valor proprio.", forma = "O apelido sai do modulo (use o membro original); valor fora de i32: declare a const a mao com i64 ou u32."},
    ItemCatalogo{codigo = "G0017", tipo = "ligar", explicacao = "Tipo incompleto (struct so declarada no header) usado por valor: sem o layout nao da para passar por valor.", forma = "Passe por ponteiro: struct incompleta atras de ponteiro vira opaque."},
    ItemCatalogo{codigo = "G0019", tipo = "ligar", explicacao = "O simbolo usa um tipo que foi recusado antes (veja o JSON anterior com o codigo do tipo).", forma = "Resolva a recusa do tipo (wrapper C) e gere de novo; o simbolo volta sozinho."},
    ItemCatalogo{codigo = "G0021", tipo = "ligar", explicacao = "C++: funcao ou metodo sobrecarregado (mesmo nome, parametros diferentes); extern \"C\" nao tem sobrecarga.", forma = "Declare no header uma funcao C++ de nome unico que chama a sobrecarga desejada."},
    ItemCatalogo{codigo = "G0022", tipo = "ligar", explicacao = "C++: template (classe ou funcao); so instancias concretas atravessam.", forma = "Escreva uma funcao ou classe concreta (sem template) que usa a instancia desejada."},
    ItemCatalogo{codigo = "G0023", tipo = "ligar", explicacao = "C++: construcao fora do minimo do wrapper: operador, metodo estatico ou virtual, referencia (&), heranca, campo publico, mais de um construtor, classe aninhada ou tipo que nao e C (std::string, std::vector).", forma = "Exponha funcoes livres e classes com metodos de tipos C (int32_t, double, const char *, ponteiro)."},
    ItemCatalogo{codigo = "G0025", tipo = "ligar", explicacao = "Arquivo de assinaturas (--dll): o nome da linha nao esta na tabela de exportacao da DLL.", forma = "Confira a grafia (a caixa vale) com 'forja ligar --dll x.dll --listar'."},
    ItemCatalogo{codigo = "G0026", tipo = "ligar", explicacao = "Arquivo de assinaturas (--dll): a linha nao e 'proc nome(...) [-> T]', 'opaque Nome', comentario '//' nem linha vazia.", forma = "opaque Handle  -  proc criar(n: i32) -> ?^Handle  (um item por linha, sintaxe do foreign)"},
    ItemCatalogo{codigo = "G0101", tipo = "ligar", explicacao = "forja ligar roda um script Python embutido no forja.exe e o Python nao foi encontrado.", forma = "Instale o Python 3.10+ (python no PATH) ou aponte FORJA_PYTHON para o python.exe."},
    ItemCatalogo{codigo = "G0102", tipo = "ligar", explicacao = "O modulo Python clang.cindex (pacote pip libclang) nao foi encontrado: forja ligar le o header pelo clang.", forma = "python -m pip install --user libclang"},
    ItemCatalogo{codigo = "G0103", tipo = "ligar", explicacao = "O clang nao conseguiu ler o header (arquivo nao encontrado ou erro de compilacao); a causa traz a 1a mensagem do clang.", forma = "Confira o caminho, passe -I <pasta> para os includes e -D NOME para as macros que o header exige."},
    ItemCatalogo{codigo = "G0104", tipo = "ligar", explicacao = "Argumentos invalidos para forja ligar.", forma = "forja ligar <header.h> --link <lib> [-o saida.fj] [--prefixo p] [-I pasta] [-D macro] [--estrito]  -  forja ligar --cpp <x.hpp> --link <lib> -o saida.fj  -  forja ligar --dll <x.dll> --assinaturas <arq> [-o saida.fj]  -  forja ligar --dll <x.dll> --listar"},
    ItemCatalogo{codigo = "G0105", tipo = "ligar", explicacao = "Modo --dll: o modulo Python pefile nao foi encontrado, ou o arquivo nao e uma DLL PE valida.", forma = "python -m pip install --user pefile; confira o caminho da DLL."},
    ItemCatalogo{codigo = "X0001", tipo = "backend", explicacao = "Recurso da IR ainda nao suportado no backend nativo: op, op_aux e tipo dizem o que falta, e a linha do .fj mostra a construcao.", forma = "Nao ha backend alternativo (o backend C foi aposentado na 0.21.0): reduza o trecho do .fj que usa o recurso ou envie o caso a quem mantem a Forja."},
    ItemCatalogo{codigo = "X0002", tipo = "backend", explicacao = "Alvo desconhecido em --target. Os alvos validos sao x86_64-windows, x86_64-linux, wasm32-wasip1, aarch64-linux, aarch64-linux-android, aarch64-apple-ios e aarch64-apple-ios-sim.", forma = "Use --target x86_64-windows, --target x86_64-linux, --target wasm32-wasip1, --target aarch64-linux, --target aarch64-linux-android, --target aarch64-apple-ios ou --target aarch64-apple-ios-sim."},
    ItemCatalogo{codigo = "X0003", tipo = "backend", explicacao = "Combinacao ou opcao de backend ou de alvo ainda nao suportada nesta versao (ex.: --modo dll ou run no linux, std:thread/std:sync/std:atomic/std:net no linux, lib .so no linux, TLS, o escritor ELF), ou opcao aposentada na 0.21.0 (--backend c, --modo c, --prova-layout); a causa diz qual.", forma = "Remova --backend c / --modo c / --prova-layout (o padrao e x64); no alvo x86_64-linux use build (ou test com -o) com --backend x64 e sem --modo dll; foreign so com lib estatica .a em vendor\\linux; no Windows, --target x86_64-windows."},
    ItemCatalogo{codigo = "X0302", tipo = "backend", explicacao = "Nao consegui gravar o executavel de saida: arquivo em uso (o programa ainda roda) ou pasta sem escrita.", forma = "Feche o programa ou escolha outro -o."},
    ItemCatalogo{codigo = "X0801", tipo = "diferencial", explicacao = "Saida diferente entre o exe e a referencia (oraculo congelado ou build sem plantio) (stdout ou stderr): 'byte' e o offset do 1o byte divergente, 'esperado' e 'obtido' o trecho de cada lado.", forma = "Rode o verificar_nativo com o traco (nivel 2) para achar a instrucao."},
    ItemCatalogo{codigo = "X0802", tipo = "diferencial", explicacao = "Valor divergente no traco do exe x traco da referencia: a primeira gravacao de local ou temporario em que os dois discordam (funcao, IrInstr, linha e coluna do .fj; esperado = referencia, obtido = exe).", forma = "O erro e do backend nativo na instrucao apontada; envie a pasta do relato."},
    ItemCatalogo{codigo = "X0803", tipo = "diferencial", explicacao = "Codigo de saida diferente entre o exe e a referencia (oraculo congelado ou build sem plantio) (inclui queda do processo, ex.: 0xC0000005 ou 0xC0000094).", forma = "Rode o verificar_nativo com o traco (nivel 2) para achar a instrucao."},
    ItemCatalogo{codigo = "X0901", tipo = "interno", explicacao = "Erro interno do backend nativo: a selecao de instrucoes nao tem regra para uma operacao da BIR.", forma = "Ajuste o programa: este recurso nao e aceito pelo backend x64 nesta versao; veja `forja explicar CODIGO`. Envie a pasta do relato."},
    ItemCatalogo{codigo = "X0902", tipo = "interno", explicacao = "Erro interno do backend nativo: o codificador recusou uma instrucao de maquina.", forma = "Ajuste o programa: este recurso nao e aceito pelo backend x64 nesta versao; veja `forja explicar CODIGO`. Envie a pasta do relato."},
    ItemCatalogo{codigo = "X0903", tipo = "interno", explicacao = "Erro interno do backend nativo: simbolo ou relocacao sem definicao, ou formato COFF inesperado.", forma = "Ajuste o programa: este recurso nao e aceito pelo backend x64 nesta versao; veja `forja explicar CODIGO`. Envie a pasta do relato."},
    ItemCatalogo{codigo = "X0904", tipo = "interno", explicacao = "Erro interno do backend nativo: o validador da BIR ou das instrucoes de maquina achou uma forma invalida.", forma = "Ajuste o programa: este recurso nao e aceito pelo backend x64 nesta versao; veja `forja explicar CODIGO`. Envie a pasta do relato."},
    ItemCatalogo{codigo = "X0905", tipo = "interno", explicacao = "Erro interno do backend nativo: a autoconferencia do executavel (PE ou ELF) achou cabecalho, secao ou diretorio inconsistente; o arquivo nao foi aceito.", forma = "Ajuste o programa: este recurso nao e aceito pelo backend x64 nesta versao; veja `forja explicar CODIGO`. Envie a pasta do relato."},
    ItemCatalogo{codigo = "X0906", tipo = "interno", explicacao = "Erro interno do backend nativo: o layout calculado diverge do esperado (layout incoerente em algum tipo, ou o str do backend difere do str do runtime nativo).", forma = "Ajuste o programa: este recurso nao e aceito pelo backend x64 nesta versao; veja `forja explicar CODIGO`. Envie a pasta do relato."},
    ItemCatalogo{codigo = "E0330", tipo = "tipo", explicacao = "Um literal inteiro vira real sozinho no contexto real (let x: f32 = 1, x * 2, {1, 2, 3} em [3]f32, argumento, return, campo) quando o valor e exato no tipo: f32 guarda todo inteiro ate 16777216 (2^24) e f64 ate 9007199254740992 (2^53); acima disso so alguns valores existem.", forma = "Escreva o real que voce quer (16777216.0) ou use f64; valor de execucao converte com <n> as f32."},
    ItemCatalogo{codigo = "E0328", tipo = "layout", explicacao = "size_of(T) e align_of(T) dao o tamanho e o alinhamento em bytes (int constante) de T como o C o guarda; offset_of(Struct.campo) da o deslocamento do campo. Valem em expressao, const e static_assert; nao valem no tamanho de [N]T. Tipo opaco (so a biblioteca C conhece) e tipo proc nao tem tamanho.", forma = "size_of(S)  -  align_of(f64)  -  offset_of(S.campo)  -  static_assert(size_of(S) == 32, msg = \"layout do shader\")"},
    ItemCatalogo{codigo = "E0329", tipo = "layout", explicacao = "static_assert(cond, msg = \"...\") confere na compilacao uma condicao constante (literal, const, size_of, align_of, offset_of e contas entre eles); vale no topo do arquivo e dentro de proc. Falsa: a compilacao para com a msg na causa. Valor que so existe em execucao nao vale.", forma = "static_assert(size_of(S) == 32, msg = \"S mudou: confira o shader\")  -  assert(x > 0) para valor de execucao"},
    ItemCatalogo{codigo = "E0707", tipo = "fluxo", explicacao = "Uma var que nunca e alterada (atribuicao inteira ou de parte, '&', fatia, for &item, append) deve ser let: var avisa a quem le que o valor muda. Em 'var a, b = f()' a palavra var vale pela declaracao inteira: so e erro se nenhum dos nomes muda.", forma = "let g = S{}  (troque var por let)  -  var n = 0  n += 1"},
    ItemCatalogo{codigo = "E0708", tipo = "fluxo", explicacao = "let/var que nunca e lido e codigo morto ou erro de digitacao (o valor foi parar em outro nome). Vale fora de test; parametro, variavel de for e ligacao de switch nao entram; um nome com sublinhado na frente (_r, _unused) diz que o nao-uso e de proposito e fica isento.", forma = "remova o let  -  let q, _ = dividir(7, b = 2)  -  _ = registrar(x) para descartar um retorno  -  let _r = f() para guardar sem ler"},
    ItemCatalogo{codigo = "E0709", tipo = "fluxo", explicacao = "O valor devolvido por um proc (da Forja ou foreign) nao some em silencio: guarde, use, ou descarte de proposito com '_ = f()'. '_ =' so aceita chamada que devolve valor; 'T ! E' continua pedindo tratamento (E0601): descarte o payload repassando o erro com '_ = try f()'.", forma = "let n = contar(l)  -  _ = puts(\"oi\")  -  _ = try ler(f)  -  if salvar(x) != 0 { ... }"},
    ItemCatalogo{codigo = "E1005", tipo = "modulo", explicacao = "Import cujo apelido nunca aparece (apelido.nome) so atrasa o build e confunde quem le.", forma = "remova a linha do import  -  use apelido.nome"},
    ItemCatalogo{codigo = "E0331", tipo = "array", explicacao = "[N]T de numero (inteiro, real ou unidade) faz conta elemento a elemento: a + b, a - b, a * b, a / b (mesmo N e T; * e / sao por elemento, nao produto escalar), a * k, k * a e a / k com k do tipo T, -a e as formas += e -=. Cada elemento segue a regra do escalar (estouro trava em dev, divisao inteira por 0 da 0, unidade confere). Nao existem: N diferentes, bool/str/struct, ==, ordem, conta em fatia ou lista.", forma = "pos += vel * dt  -  let m: [3]f32 = (a + b) / 2.0  -  for i, x in a { ... } para o resto"},
    ItemCatalogo{codigo = "E0332", tipo = "array", explicacao = "Em [2]T, [3]T e [4]T as letras x y z w (ou r g b a) sao os elementos 0..3: v.x e v[0]; v.xy, v.zyx, c.bgra montam um array novo [k]T (1 a 4 letras do mesmo grupo, cada uma menor que N). Uma letra so tambem grava (v.x = 1.0) e aceita &v.x. Gravar varias letras (v.xy = ...) nao existe; em [5]T ou mais use o indice.", forma = "let p = v.xy  -  c.a = 1.0  -  let bgr = cor.bgr  -  v.y = v.y - 9.8 * dt"},
    ItemCatalogo{codigo = "E0334", tipo = "tipo", explicacao = "min(a, b = c) e max(a, b = c) devolvem o menor e o maior de dois valores do MESMO tipo numerico (inteiro, real, unidade; [N]T por elemento); com NaN devolvem a. clamp(x, lo = a, hi = b) prende x em [a, b] (lo > hi constante e erro). abs(x): inteiro com sinal (abs do minimo trava em dev), real (zera o bit de sinal), quat (norma); sem sinal nao tem abs. sqrt(x): f32 ou f64 sem unidade (negativo da nan). wrapping_, saturating_, checked_ e overflowing_ de add, sub e mul pedem dois inteiros do MESMO tipo; rotate_left/right, count_ones, leading_zeros, trailing_zeros e byte_swap pedem inteiro; mul_hi_u64 pede dois u64. math.<fn> (std:math, S3 P3): os argumentos reais sao todos f32 ou todos f64 (um literal sozinho vale f64 e se adapta ao outro); misturar f32 e f64, passar inteiro, bool, texto ou unidade = E0334 (math.sqrt nao existe: sqrt e embutido).", forma = "let v = clamp(vida, lo = 0, hi = 100)  -  let m = min(a, b = 3.5)  -  let d = sqrt(x * x + y * y)  -  let p = math.pow(x32, y = 2.0)"},
    ItemCatalogo{codigo = "E0333", tipo = "quat", explicacao = "quat e o quaternion embutido de f32 (campos x, y, z, w; 16 bytes, mesma ordem do Quaternion da raylib). Literal quat{x = .., y = .., z = .., w = ..} (omitido = 0.0; identidade = quat{w = 1.0}). Contas: q + r, q - r, -q, q * r (Hamilton), q * k e k * q com k: f32, q * v com v: [3]f32 (gira o vetor; q unitario), conj(q) e abs(q) (norma). Nao existem: q / r, ==, ordem, quat de f64, unidade.", forma = "let giro = quat{y = 0.70710677, w = 0.70710677}  -  let v2 = giro * v  -  let u = q * (1.0 / abs(q))"},
    ItemCatalogo{codigo = "E0335", tipo = "array", explicacao = "[dynamic, N]T e uma lista de capacidade fixa N dentro do proprio valor (sem alocador, sem delete): e VALOR como [N]T (copia ao atribuir, passar e devolver). Tem len, l[i] (fora de 0..<len = R0006), fatia l[..], for e append(&l, item = x); append com len == N e R0007 em dev e release. Nasce de {} (vazia); l = {} esvazia. N literal ou const de 1 a 65536. Nao existem: make, delete, cap e literal com elementos.", forma = "var lista: [dynamic, 64]T = {}  -  append(&lista, item = valor)  -  if len(lista) < 64 { ... }"},
    ItemCatalogo{codigo = "R0011", tipo = "runtime", explicacao = "Em test (dev): o teste causou uma excecao do processador (acesso a memoria invalida ou instrucao ilegal); o executor marca o teste como falho, diz o titulo e segue para o proximo. Fora de test o processo cai como antes.", forma = "Confira ponteiros vindos de foreign e rawptr convertido com 'as ^T' no teste apontado."},
    ItemCatalogo{codigo = "X0105", tipo = "backend", explicacao = "A biblioteca achada para um 'link' nao e do tipo que o backend nativo liga: DLL, executavel ou import library de 32 bits (PE32, i386), PE ou ar malformado, objeto /GL, simbolo de import library que e dado ou so por ordinal, ou executavel sem nenhum simbolo exportado.", forma = "Use a versao de 64 bits (x64) da biblioteca ou importe so funcoes por nome."},
    ItemCatalogo{codigo = "X0101", tipo = "backend", explicacao = "Um proc foreign chama um simbolo que nenhuma biblioteca do 'link' exporta: procurei_em lista as DLLs lidas, na ordem dos 'link'; proc e simbolo dizem quem falhou (o simbolo e o nome do proc, ou o alias depois do '=').", forma = "Corrija o nome do proc (a caixa conta) ou o alias, confira o 'link' e a pasta da biblioteca."},
    ItemCatalogo{codigo = "X0102", tipo = "backend", explicacao = "O backend nativo nao achou a biblioteca de um 'link': procurei_em lista os candidatos tentados em cada pasta (a do .fj, vendor\\ e %FORJA_ENGINE%\\lib quando ha vendor:/engine:) e no System32.", forma = "Confira o nome do 'link' (lib<x>.dll.a, <x>.dll.a, lib<x>.a, <x>.lib, lib<x>.lib, lib<x>.dll ou <x>.dll) e ponha a biblioteca na pasta do .fj ou em vendor\\."},
    ItemCatalogo{codigo = "X0103", tipo = "backend", explicacao = "A biblioteca achada para um 'link' tem um formato que o backend nativo ainda nao liga: DLL, executavel e import library (MSVC .lib curta, GNU .dll.a) ligam; .a e .lib estaticas chegam no M3b.", forma = "Aponte o 'link' para a DLL ou para a import library (MSVC .lib curta, GNU .dll.a)."},
    ItemCatalogo{codigo = "E0909", tipo = "foreign", explicacao = "A assinatura de um tipo proc(nome: T, ...) -> R usado como valor (campo, let/var, parametro, retorno, 'as proc', nome de proc da Forja passado como valor) e um ponteiro de funcao do C: so atravessam tipos de forma fixa em C (inteiros, f32, f64, bool, enum, ^T, ?^T, rawptr, cstr, struct por valor cujos campos atravessam). str, fatia, array, lista, ?T, 'T ! E' e retorno multiplo ficam de fora. A causa diz qual parametro (ou o retorno) e por que.", forma = "proc(self: ^Objeto, n: i32) -> u32  -  troque str por cstr, fatia por ^T e n: u64"},
    ItemCatalogo{codigo = "E0910", tipo = "foreign", explicacao = "'x as proc(...) -> R' so converte de rawptr, ^T ou ?^T (um endereco de funcao que veio do C, como o de GetProcAddress) ou de um proc com a mesma assinatura. Numero, texto, struct e outro tipo de proc nao viram proc: um endereco de funcao nao se inventa. Em dev, um rawptr/?^T NULL vira R0005 na conversao.", forma = "let f = GetProcAddress(modulo, \"MessageBoxA\") as proc(janela: rawptr, texto: cstr, titulo: cstr, tipo: u32) -> i32"},
    ItemCatalogo{codigo = "E0911", tipo = "argumento", explicacao = "Um tipo proc nao tem valor zero (nao existe ponteiro de funcao nulo na Forja): uma struct com campo proc sem padrao precisa do campo em todo literal, e nao pode nascer de '{}', new/make nem de [N]S zerado. De o proc em todo literal que cria a struct; nesta versao o campo proc nao tem padrao.", forma = "WndClass{ procedimento = janela_proc, instancia = h }"},
    ItemCatalogo{codigo = "B0005", tipo = "build", explicacao = "O forja.proj (manifesto do projeto) tem uma declaracao invalida; a causa diz o arquivo, a linha e o motivo: nome de produto repetido ou fora de [a-z0-9_]+, tipo diferente de exe e dll, arquivo de entrada que nao existe, 'depende' de produto que nao existe, 'saida' declarada duas vezes, nenhum produto, ou uma linha que nao e 'saida = <pasta>' nem 'produto'.", forma = "saida = bin  -  produto motor dll src/motor.fj  -  produto jogo exe src/jogo.fj depende motor"},
    ItemCatalogo{codigo = "B0007", tipo = "build", explicacao = "Os produtos do forja.proj dependem uns dos outros em ciclo: a causa lista o ciclo na ordem (a -> b -> a). Sem uma ordem de build nenhum deles pode ser compilado primeiro.", forma = "Tire uma das dependencias do ciclo (a clausula 'depende' de um dos produtos listados) ou junte os produtos em um so."},
    ItemCatalogo{codigo = "B0006", tipo = "build", explicacao = "O build de um produto ligou a saida de outro produto do forja.proj (uma DLL ou exe em <saida>) sem declarar 'depende': e uma corrida de build, porque nada garante que a saida do outro ja esteja pronta. A causa diz o produto, o arquivo e o produto dono dele.", forma = "Acrescente o produto dono na clausula 'depende' do produto (produto jogo exe src/jogo.fj depende motor)."},
    ItemCatalogo{codigo = "B0008", tipo = "build", explicacao = "Outro processo do forja ja esta construindo este projeto: a trava <pasta>\\.forja_cache\\trava esta aberta por ele (a trava some sozinha se o processo morrer). Dois orquestradores no mesmo projeto pisariam no estado e nas saidas um do outro.", forma = "Espere o outro build terminar e rode de novo."},
    ItemCatalogo{codigo = "X0106", tipo = "backend", explicacao = "Um simbolo que o programa exige e definido por membros de DUAS bibliotecas estaticas (.a ou .lib) diferentes dos 'link': a causa lista o simbolo, as duas bibliotecas e o membro de cada uma. O ligador nativo nao escolhe uma em silencio, porque os dois codigos podem divergir.", forma = "Tire um dos 'link' (ou a biblioteca que repete o simbolo), ou ligue so a que traz a versao certa."},
    ItemCatalogo{codigo = "X0108", tipo = "backend", explicacao = "Um membro de biblioteca estatica de terceiros pede, pelo .drectve (/DEFAULTLIB ou -l), outra biblioteca que o ligador nativo nao encontrou nas pastas de busca: a causa diz a biblioteca pedida e o membro.", forma = "Ponha a biblioteca pedida numa das pastas de busca (ou em --lib-pasta), ou ligue com a toolchain que a lib usa."},
    ItemCatalogo{codigo = "X0107", tipo = "backend", explicacao = "Um membro de biblioteca estatica de terceiros tem a secao .tls (dado thread_local do C: __thread, _Thread_local, __declspec(thread)): o ligador nativo ainda nao monta o diretorio TLS do PE, e sem ele cada thread leria o mesmo dado. A causa diz o membro e a secao.", forma = "Ligue a biblioteca na DLL dela (o 'link' sem .a), ou use uma versao da biblioteca compilada sem armazenamento por thread."},
    ItemCatalogo{codigo = "X0109", tipo = "backend", explicacao = "O programa pede mais DLLs com import (no maximo 17 no .idata, contando a KERNEL32 e a ADVAPI32 do runtime) ou mais nomes importados de DLL (no maximo 320 no total) do que o ligador nativo aceita. A causa diz quantos o programa pede e o teto.", forma = "Tire 'link' ou procs de foreign que o programa nao usa."},
    ItemCatalogo{codigo = "R0012", tipo = "runtime", explicacao = "exit(code) de std:os recebeu um codigo fora de 0..255: o sistema guarda so 8 bits (o Windows aceita mais, mas o Linux trunca), entao a Forja recusa em vez de truncar em silencio. O processo sai com 101.", forma = "Passe um codigo de 0 a 255: exit(0) para sucesso, exit(1)..exit(255) para falha."},
    ItemCatalogo{codigo = "E1006", tipo = "modulo", explicacao = "O ultimo segmento do caminho do import e palavra reservada da linguagem (proc, let, if...): sem 'as', ele viraria o apelido do modulo (apelido.nome), e uma palavra reservada nao pode ser apelido.", forma = "import \"x/proc\" as processo  -  escreva 'as <nome>' com um nome que nao seja palavra reservada."},
    ItemCatalogo{codigo = "R0013", tipo = "runtime", explicacao = "O programa que o forja run ou o forja test executa passou do limite de tempo de parede dado em --limite-tempo <seg>: o forja encerrou o processo e todos os filhos dele e saiu com 102. A saida que o programa ja tinha despejado ficou; o que estava no buffer dele se perde.", forma = "Corrija o laco que nao termina, ou suba o limite (--limite-tempo 30); programa que espera entrada ou outro processo precisa receber o que espera."},
    ItemCatalogo{codigo = "R0014", tipo = "memoria", explicacao = "O programa que o forja run ou o forja test executa passou do limite de memoria dado em --limite-mem <MiB> (memoria confirmada do processo e dos filhos): o forja encerrou a arvore de processos e saiu com 103. A saida que o programa ja tinha despejado ficou; o que estava no buffer dele se perde.", forma = "Libere o que nao usa mais (delete) ou processe em partes; se o uso e legitimo, suba o limite (--limite-mem 512)."},
    ItemCatalogo{codigo = "R0015", tipo = "runtime", explicacao = "O programa que o forja run ou o forja test executa escreveu em stdout e stderr mais bytes que o limite de --limite-saida <bytes|KiB|MiB>: a saida foi cortada nesse limite (o que saiu antes ficou), o resto foi descartado, a causa diz quantos bytes, e o forja encerrou a arvore de processos e saiu com 104.", forma = "Pare o laco que imprime sem fim ou imprima menos; se a saida e legitima, suba o limite (--limite-saida 1MiB)."},
    ItemCatalogo{codigo = "E0110", tipo = "sintaxe", explicacao = "O codigo esta escrito numa forma de outra linguagem (C, Java, JS, Python, Go, Rust...) que a Forja nao aceita nem tolera: ';', '&&', '||', '!x', 'i++', 'c ? a : b', 'x?', 'fn', ':=', 'elif', '/* */', 'try { } catch', bloco na mesma linha do '{', 'main' devolvendo inteiro. A causa diz a forma achada e a que a Forja usa no lugar; a forma nunca e aceita em silencio. Tambem e E0110 um NOME ANTIGO que a Forja renomeou para ingles (rotulo em = heap virou alloc = heap, o valor escopo virou scope, para = T virou to = T, std:arquivo virou std:file, vendor:banco virou vendor:db, abrir virou open, ErroBanco virou DbError...): a causa diz 'forma antiga: X agora e Y'.", forma = "Troque pela forma da Forja que a causa e a sugestao indicam (forja corrigir --aplicar faz a troca quando ela e mecanica). Para um nome antigo renomeado rode forja migrar <arquivo.fj|pasta> --aplicar (sem --aplicar so mostra as trocas): ele troca no projeto todo, sem regex."},
    ItemCatalogo{codigo = "E0336", tipo = "memoria", explicacao = "Allocator e o tipo embutido (sem import) do alocador que um proc do usuario recebe do chamador: proc nome(..., alloc: Allocator) -> T. So existe como PARAMETRO, chamado alloc, o ULTIMO da lista, uma vez so e sem valor padrao (o chamador sempre escolhe o alocador). Nao existe como let, var, campo de struct, retorno, ^Allocator, ?Allocator, elemento de array, lista ou map, nem em tipo proc(...); nao se escreve o literal Allocator{...} e o .id dele nao se le (o handle e do runtime). Em pub export e em foreign o tipo nao atravessa a fronteira C (E0901 e E0904).", forma = "proc juntar(partes: []str, sep: str, alloc: Allocator) -> str  -  o parametro se chama alloc, vem por ultimo e nao tem valor padrao"},
    ItemCatalogo{codigo = "E0337", tipo = "ordenacao", explicacao = "binary_search so busca em fatia de inteiro, real (f32, f64) ou str, porque compara o elemento inteiro com value; sort_by_key so ordena fatia de struct pela chave key = Struct.campo, com campo direto de inteiro, f32, f64 ou str. Enum, struct, bool, ponteiro e lista nao tem a ordem que o runtime usa. Campo aninhado e proc como chave nao valem: a chave e so um campo direto da struct do elemento.", forma = "binary_search(ns, value = 3) com ns de enum  -  sort_by_key(ps, key = Pessoa.nome) com nome: str"},
    ItemCatalogo{codigo = "E0338", tipo = "colecoes", explicacao = "shuffle e choice sorteiam com o gerador de std:rand e pedem rng = &r, onde r e um Rng de rand.seed (ponteiro ^rand.Rng de std:rand). O rng e obrigatorio: sem ele, passado por valor (rng = r, sem &) ou de outro modulo, o sorteio nao tem de onde tirar a sequencia, e o compilador nao inventa um gerador global.", forma = "shuffle(l, rng = &r) com var r = rand.seed(42)  -  shuffle(l) sem rng  -  choice(l, rng = r) com r por valor"},
    ItemCatalogo{codigo = "F0001", tipo = "formato", explicacao = "O arquivo passa no check mas nao esta na forma canonica da Forja (vaos entre tokens, indentacao, linha em branco, espaco no fim da linha, BOM ou CRLF). O forja fmt troca so os vaos, a indentacao e os fins de linha; token e quebra de linha ficam como estao.", forma = "rode forja fmt --aplicar <arq>"},
    ItemCatalogo{codigo = "E1007", tipo = "arquivo", explicacao = "O #load(\"arquivo\") nao consegue ler o arquivo: ele nao existe ou nao abre na pasta do arquivo raiz, ou passa do limite de 16 MiB (o conteudo vira um str do programa). O caminho e relativo a pasta do .fj raiz; '/' funciona no Windows; caminho com unidade (C:...) nao vale, pois nao junta com a pasta raiz.", forma = "use um caminho relativo a pasta do arquivo raiz (sem unidade C:), que exista, de ate 16 MiB: #load(\"dados/tabela.bin\")"},
    ItemCatalogo{codigo = "E0339", tipo = "memoria", explicacao = "Mutex, Cond e os Atomic* de std:sync e std:atomic guardam um estado que nao se copia: copiar um lvalor, passar por valor, devolver ou por em union, map ou [dynamic] criaria dois donos do mesmo lock ou contador. Como campo de struct pode (a struct herda a marca) e o valor zero e valido.", forma = "passe ^Mutex (o endereco): use por & ou pelo campo; nunca copie"},
    ItemCatalogo{codigo = "X0110", tipo = "backend", explicacao = "Um membro ELF de biblioteca estatica tem relocacao de um tipo fora do censo que o ligador nativo trata (o do libc.a do musl: R_X86_64_64, PC32, PLT32, 32, 32S, GOTPCREL, GOTPCRELX, REX_GOTPCRELX, TPOFF32, GOTTPOFF). A causa diz o tipo e o membro.", forma = "Use uma biblioteca estatica cujas relocacoes sejam do censo do libc.a; o ligador nativo ainda nao aplica o tipo que a causa diz."},
    ItemCatalogo{codigo = "X0111", tipo = "backend", explicacao = "Um membro ELF de biblioteca estatica pede relocacao de TLS (TPOFF32 ou GOTTPOFF) de um simbolo que nao esta no bloco TLS (indefinido ou que nao e __thread): o ligador nao sabe o deslocamento dele. O diagnostico cita o simbolo.", forma = "Confira o simbolo: a variavel tem de ser __thread (ou _Thread_local) e estar definida no objeto ou na biblioteca linkada."},
    ItemCatalogo{codigo = "X0112", tipo = "backend", explicacao = "Com --pie (ELF static-pie) o ligador nao aceita relocacao absoluta de 32 bits (ABS32 ou ABS32S: o campo nao recebe a base do carregador) nem ADDR64 dentro de .text (TEXTREL). O diagnostico cita o simbolo.", forma = "Compile o objeto ou a biblioteca com -fPIC (sem enderecos absolutos de 32 bits) ou tire --pie: o ELF sem --pie segue como era."},
    ItemCatalogo{codigo = "X0113", tipo = "backend", explicacao = "Um membro ELF de biblioteca estatica tem TLS (.tdata ou .tbss: variavel __thread) e a ligacao e crua (sem a libc musl): o bloco TLS so e montado com a semente musl, que o PT_TLS pede ao carregador. O diagnostico cita a secao e o objeto.", forma = "Ligue pela variante libc (foreign no alvo linux, ou std:thread/std:async que ja a puxam), ou tire a variavel __thread do membro."},
    ItemCatalogo{codigo = "X0114", tipo = "backend", explicacao = "Relocacao GOTTPOFF (initial-exec de __thread) com uma forma de instrucao que o relaxamento para local-exec nao reconhece: so mov e add com [rip+d] (8b ou 03 com modrm 05) sem prefixo REX.R. O diagnostico cita o simbolo.", forma = "Compile o objeto com -ftls-model=local-exec, ou com a forma padrao do gcc (mov/add [rip+d] sem REX.R)."},
    ItemCatalogo{codigo = "E0342", tipo = "foreign", explicacao = "c_long e c_ulong sao o long do C: 32 bits no Windows e 64 bits no Linux. So valem na fronteira com o C: parametro e retorno de proc foreign, campo de struct (espelho do header), let/var e ^c_long ou ?^c_long (saida). Fora dai (proc da Forja, pub export, array, fatia, lista, map, union, ?T, const) o tamanho mudaria por alvo e o codigo so compilaria num deles. Um c_long le-se como operando de 'as', argumento de parametro c_long ou '&x' para ^c_long; recebe literal, 'x as c_long' ou outro c_long; conta ('+=', '+') e mistura com i32/int sao o erro.", forma = "converta nas pontas: labs(x) as i32 para ler, e (n as int + 1) as c_long para gravar"},
    ItemCatalogo{codigo = "E0912", tipo = "foreign", explicacao = "Depois da assinatura de um proc foreign so cabe uma clausula de posse do handle: creates (o retorno e o handle novo), creates p (o parametro de saida ^H recebe o handle), destroys p (o proc fecha o handle de p) takes p (o handle de p passa a pertencer a outro objeto da lib) ou ends (sem parametro: o proc encerra a lib inteira). No maximo uma por proc; p tem de ser parametro do proc e de tipo handle (^T, ?^T, rawptr, inteiro ou struct por valor); creates sem nome precisa de retorno de handle e creates p precisa de p do tipo ^H.", forma = "proc fopen(caminho: cstr, modo: cstr) -> ?^File creates"},
    ItemCatalogo{codigo = "E0913", tipo = "memoria", explicacao = "Um ponteiro para dentro de uma lista ou map (&l[i], l[..], get_ptr(&m, ...)) guarda o endereco do buffer; append, insert, remove, delete, clear e resize da MESMA colecao (pelo mesmo nome) podem mover ou liberar o buffer, e o ponteiro passa a apontar para memoria velha. Erro quando o ponteiro e lido depois da mutacao, quando a mutacao esta num laco e o ponteiro, declarado fora, e usado no corpo, e quando a colecao muda dentro de for &x in l. Nova atribuicao ao ponteiro (p = &l[i]) o revalida. So se confere o mesmo nome no mesmo proc; entre procs a guarda de memoria (--guarda-memoria) e o R0008 cobrem.", forma = "Guarde o indice e leia l[i] depois da mutacao; ou pegue o ponteiro de novo logo depois dela (var p = &l[0] ... append(&l, item = 2); p = &l[0]); no for &x, junte os novos numa lista auxiliar e faca o append depois do for."},
    ItemCatalogo{codigo = "E1008", tipo = "modulo", explicacao = "O import de uma pasta junta todos os .fj dela num modulo so (pacote); o caminho tem de designar uma coisa so. Erro quando o mesmo caminho e um arquivo (geo.fj) e uma pasta com .fj (geo\\), e quando o mesmo arquivo entraria duas vezes no programa (import \"geo\" junto de import \"geo/ponto\", se ponto.fj mora em geo\\).", forma = "renomeie a pasta ou o arquivo para o caminho nao repetir; ou importe so a pasta (import \"geo\") ou so o arquivo (import \"geo/ponto\"), nao os dois"},
    ItemCatalogo{codigo = "R0016", tipo = "runtime", explicacao = "O programa executado (forja run, forja test ou um .wasm no Node) estourou a pilha de chamadas: uma recursao foi funda demais, ou um quadro com array local grande nao coube na pilha. O processo sai com 101; no wasm a falha vem como JSON no stderr, igual as demais falhas de execucao.", forma = "Troque a recursao por laco, ou limite a profundidade; array grande de uso local vai para o heap (new/make com alloc = heap) em vez de ficar na pilha."},
}
// C2F-A0: tabelas static const de fim_do_operador_diag (TRES, DOIS) e primeiro_corte_da_sugestao (CORTES)
const TRES: [2]str = {"..<", "..="}
const DOIS: [10]str = {"==", "!=", "<=", ">=", "<<", ">>", "+=", "-=", "->", ".."}
const CORTES: [4]str = {"  -  ", ". ", "; ", " ("}

// C2F-70: o estado de saida que o C guardava em globais (ModoResumo de diag.c; CodigoJaVisto e PrimeiraVezDoCodigo de diag_spec.c).
// O driver cria UM e o passa (sd) a quem imprime diagnostico.
// SaidaDiag no heap (new(T) de outro pacote e E1003, por isso o alocador mora aqui); vale ate o fim do processo.
pub proc saida_diag_nova() -> ^SaidaDiag {
    return new(SaidaDiag, alloc = heap)
}

pub struct SaidaDiag {
    resumo: bool
    ja_visto: [DIAG_QTD]bool
    primeira_vez: bool
}

// Texto de um buffer []u8 terminado em NUL (o char[] do C): copia na heap ate o 1o byte 0; o chamador faz delete.
proc diag_texto_do_buffer(b: []u8) -> str {
    return from_bytes(b[0..<c2f_strlen_b(b)], alloc = heap)
}

// Texto novo que o Diag guarda (os n primeiros bytes de s, como o snprintf do C). Vai para o alocador frame: o Diag nunca libera o texto antigo (R21: a copia rasa
// de Diag/DiagLista pode te-lo) e heap daria R0009 em todo `forja test`; o compilador nunca chama frame_reset (16 MiB sobram: no maximo DIAG_MAX diagnosticos por execucao).
proc diag_texto_novo(s: str, n: int) -> str {
    let m = min(max(n, 0), len(s))
    return from_bytes(as_bytes(s)[0..<m], alloc = frame)
}

// C: common/diag.c:273
// C2F-37: `fmt, ...` virou `msg: str` (mensagem ja pronta)
pub proc diag_relatar(d: ^Diag, codigo: i32, off: u32, msg: str) -> bool {
    d.tem = true
    d.calado = false
    d.codigo = codigo
    d.off = off
    d.extras = ""
    d.sug.n = 0
    d.rel.n = 0
    d.explicacao = ""
    d.forma = ""
    d.causa = diag_texto_novo(msg, 511) // C2F-32: char causa[512] -> 511 bytes
    return false
}

// C: common/diag.c:291
pub proc diag_forma(d: ^Diag, explicacao: ?str, forma: ?str) {
    let nova_explicacao = explicacao or_else ""
    let nova_forma = forma or_else ""
    if c2f_nul_em(nova_explicacao, 0) != 0 {
        d.explicacao = diag_texto_novo(nova_explicacao, 255) // char explicacao[DIAG_FORMA_MAX = 256]
    }
    if c2f_nul_em(nova_forma, 0) != 0 {
        d.forma = diag_texto_novo(nova_forma, 255)
    }
}

// C: common/diag.c:297
// LIMITE: 4 parametros posicionais - a assinatura e a do C (saida e cap descrevem o buffer do chamador).
pub proc diag_descrever_onde(f: ?^Fonte, off: u32, saida: []u8, cap: u64) {
    let pos = fonte_localizar_no_arquivo(f, off)
    let caminho = pos.caminho or_else ""
    var inicio_base = 0
    for i in 0..<len(caminho) {
        if caminho[i] == 47 or caminho[i] == 92 { // '/' '\\'
            inicio_base = i + 1
        }
    }
    let base = from_bytes(as_bytes(caminho)[inicio_base..<len(caminho)], alloc = heap)
    defer delete(base)
    let destino = saida[0..<(cap as int)]
    if len(base) > 0 {
        let t = format(f"linha {pos.linha}, coluna {pos.coluna} de {base}", alloc = heap)
        defer delete(t)
        _ = c2f_snprintf(destino, t)
    } else {
        let t = format(f"linha {pos.linha}, coluna {pos.coluna}", alloc = heap)
        defer delete(t)
        _ = c2f_snprintf(destino, t)
    }
}

// C: common/diag.c:309
pub proc diag_acrescentar_extra(d: ^Diag, chave: str, valor_json: str) {
    let velho = d.extras or_else ""
    let usado = len(velho)
    var separador = ", "
    if usado == 0 {
        separador = ""
    }
    let pedaco = format(f"{separador}\"{chave}\": {valor_json}", alloc = heap)
    defer delete(pedaco)
    if len(pedaco) >= 384 - usado { // nao coube em char extras[384]: nenhum extra a meio
        return
    }
    d.extras = format(f"{velho}{pedaco}", alloc = frame)
}

// C: common/diag.c:316
proc imprimir_texto_json(saida: ^Saida, s: ?str) {
    let texto = s or_else ""
    var b = make([dynamic]u8, alloc = heap, cap = len(texto) + 2)
    defer delete(b)
    append(&b, item = 34 as u8) // '"'
    for i in 0..<len(texto) {
        let ch: u8 = texto[i]
        if ch == 0 {
            break // o laco do C para no NUL
        }
        if (ch == 34) or (ch == 92) { // '"' '\\'
            append(&b, item = 92 as u8)
            append(&b, item = ch)
        } else if ch < 32 {
            format(f"\\u{ch:04x}", into = &b)
        } else {
            append(&b, item = ch)
        }
    }
    append(&b, item = 34 as u8)
    c2f_saida_escrever(saida, b[..])
}

// C: common/diag.c:333
proc imprimir_caminho_json(saida: ^Saida, caminho: ?str) {
    let normal = caminho_normal(caminho or_else "", 1024)
    defer delete(normal)
    imprimir_texto_json(saida, normal)
}

// C: common/diag.c:344
proc eh_inicio_de_nome_diag(ch: u8) -> bool {
    return (((c2f_char_i32(ch) >= 65) and (c2f_char_i32(ch) <= 90)) or ((c2f_char_i32(ch) >= 97) and (c2f_char_i32(ch) <= 122))) or (ch == 95) // 'A' 'Z' 'a' 'z' '_'
}

// C: common/diag.c:345
proc eh_digito_diag(ch: u8) -> bool {
    return (c2f_char_i32(ch) >= 48) and (c2f_char_i32(ch) <= 57) // '0' '9'
}

// C: common/diag.c:346
proc eh_parte_de_nome_diag(ch: u8) -> bool {
    return (c2f_b2i32(eh_inicio_de_nome_diag(ch)) != 0) or (c2f_b2i32(eh_digito_diag(ch)) != 0)
}

// C: common/diag.c:349
proc fim_do_texto_diag(s: []u8, j: u32) -> u32 {
    var k: u32 = j + 1
    while ((s[k] != 0) and (s[k] != 34)) and (s[k] != 10) { // '\0' '"' '\n'
        let escape: bool = ((s[k] == 92) and (s[k + 1] != 0)) and (s[k + 1] != 10) // '\\' '\0' '\n'
        var tern_1: i32 = 1
        if c2f_b2i32(escape) != 0 {
            tern_1 = 2
        }
        k += c2f_s2u_32(tern_1)
    }
    var tern_2: u32 = k
    if s[k] == 34 {
        tern_2 = k + 1
    }
    return tern_2 // '"'
}

// C: common/diag.c:360
proc fim_do_numero_diag(s: []u8, i: u32) -> u32 {
    var k: u32 = i
    if (s[i] == 48) and ((s[i + 1] == 120) or (s[i + 1] == 98)) { // '0' 'x' 'b'
        while eh_parte_de_nome_diag(s[k]) {
            k += 1
        }
        return k
    }
    while eh_digito_diag(s[k]) {
        k += 1
    }
    if (s[k] == 46) and (c2f_b2i32(eh_digito_diag(s[k + 1])) != 0) { // '.'
        k += 1
        while eh_digito_diag(s[k]) {
            k += 1
        }
    }
    return k
}

// C: common/diag.c:376
proc fim_do_operador_diag(s: []u8, i: u32) -> u32 {
    for t in TRES {
        if prefixo_casa_diag(s, i, t) {
            return i + 3
        }
    }
    for t in DOIS {
        if prefixo_casa_diag(s, i, t) {
            return i + 2
        }
    }
    return i + 1
}

// strncmp(s + i, p, len(p)) == 0: p so tem bytes nao nulos, entao o NUL de sentinela de s nunca casa.
proc prefixo_casa_diag(s: []u8, i: u32, p: str) -> bool {
    for k in 0..<len(p) {
        if s[(i as int) + k] != p[k] {
            return false
        }
    }
    return true
}

// C: common/diag.c:391
proc fim_do_token_diag(s: []u8, i: u32) -> u32 {
    if (s[i] == 102) and (s[i + 1] == 34) { // 'f' '"'
        return fim_do_texto_diag(s, i + 1)
    }
    if eh_inicio_de_nome_diag(s[i]) {
        var k: u32 = i + 1
        while eh_parte_de_nome_diag(s[k]) {
            k += 1
        }
        return k
    }
    if eh_digito_diag(s[i]) {
        return fim_do_numero_diag(s, i)
    }
    if s[i] == 34 { // '"'
        return fim_do_texto_diag(s, i)
    }
    return fim_do_operador_diag(s, i)
}

// C: common/diag.c:405
proc diag_tamanho_do_token(f: ^Fonte, off: u32) -> u32 {
    if (off as u64) >= f.tam {
        return 1
    }
    return fim_do_token_diag(f.texto, off) - off
}

// C: common/diag.c:413
// C2F-70: sd = o estado de saida (resumo, spec ja visto); 5 parametros porque o C passava o FILE * e o estado era global.
// LIMITE: 5 parametros posicionais - o sd e a assinatura nova do plano C2F-70.
proc escrever_completo(d: ^Diag, f: ^Fonte, extras_json: ?str, saida: ^Saida, sd: ^SaidaDiag) {
    let item = CATALOGO[d.codigo]
    let pos = fonte_localizar_no_arquivo(f, d.off)
    var forma: FormaTextos = FormaTextos{explicacao = "", forma = ""}
    var corrigida: DiagSugestoes = DiagSugestoes{}
    var copia: Diag = d^
    var alvo: ^Diag = d
    if diag_corrigir_padrao(d, f, &corrigida) { // P72: erro sem edicao ganha a correcao da tabela; o diagnostico original nao muda
        copia.sug = corrigida
        alvo = &copia
    }
    diag_forma_da_ocorrencia(alvo, f, item.forma, &forma) // b08: explicacao e forma_certa da ocorrencia
    defer delete(forma.explicacao)
    defer delete(forma.forma)
    let cabeca = format(f"{{\"codigo\": \"{item.codigo}\", \"tipo\": \"{item.tipo}\", \"arquivo\": ", alloc = heap)
    defer delete(cabeca)
    c2f_saida_formatar(saida, cabeca)
    imprimir_caminho_json(saida, pos.caminho)
    let linha_coluna = format(f", \"linha\": {pos.linha}, \"coluna\": {pos.coluna}", alloc = heap)
    defer delete(linha_coluna)
    c2f_saida_formatar(saida, linha_coluna)
    if item.codigo[0] == 69 { // 'E'
        let coluna_fim = format(f", \"coluna_fim\": {pos.coluna + diag_tamanho_do_token(f, alvo.off)}", alloc = heap)
        defer delete(coluna_fim)
        c2f_saida_formatar(saida, coluna_fim)
    }
    diag_pacote_trecho(alvo, f, diag_tamanho_do_token(f, alvo.off), saida) // z5: o trecho sai em todo diagnostico
    c2f_saida_escrever_texto(saida, ", \"causa\": ")
    imprimir_texto_json(saida, alvo.causa)
    c2f_saida_escrever_texto(saida, ", \"explicacao\": ")
    imprimir_texto_json(saida, forma.explicacao)
    c2f_saida_escrever_texto(saida, ", \"forma_certa\": ")
    imprimir_texto_json(saida, forma.forma)
    escrever_extras_diag(alvo, extras_json, saida)
    if alvo.sug.n > 0 {
        diag_pacote_fim(alvo, f, item.codigo, saida, sd)
    } else {
        diag_pacote_sem_sugestao(alvo, f, item.codigo, saida, sd) // z5: correcao [] e confianca "so_dica"
    }
    c2f_saida_escrever_texto(saida, "}\n")
}

// Os extras do proprio Diag e os do chamador, cada um precedido de ", " se nao vazio.
proc escrever_extras_diag(d: ^Diag, extras_json: ?str, saida: ^Saida) {
    let proprios = d.extras or_else ""
    let do_chamador = extras_json or_else ""
    if c2f_nul_em(proprios, 0) != 0 {
        c2f_saida_escrever_texto(saida, ", ")
        c2f_saida_escrever_texto(saida, proprios)
    }
    if c2f_nul_em(do_chamador, 0) != 0 {
        c2f_saida_escrever_texto(saida, ", ")
        c2f_saida_escrever_texto(saida, do_chamador)
    }
}

// C: common/diag.c:451
// C2F-70: o ModoResumo global virou sd.resumo.
pub proc diag_modo_resumo(sd: ^SaidaDiag, ligado: bool) {
    sd.resumo = ligado
}

// C: common/diag.c:457
proc abrir_log_diag() -> ?^Saida {
    let caminho = os.env("FORJA_LOG_DIAG") or_else ""
    if len(caminho) == 0 {
        return none
    }
    return c2f_saida_abrir(caminho, "ab")
}

// C: common/diag.c:466
// Indice da aspa de fechamento do texto JSON que abre em ini (a aspa de abertura); -1 se o texto nao fecha.
proc fim_do_texto_json(s: str, ini: int) -> int {
    var k = ini + 1
    while (c2f_nul_em(s, k) != 0) and (c2f_nul_em(s, k) != 34) { // '"'
        if (s[k] == 92) and (c2f_nul_em(s, k + 1) != 0) { // '\\'
            k += 1
        }
        k += 1
    }
    if c2f_nul_em(s, k) == 34 {
        return k
    }
    return -1
}

// C: common/diag.c:476
// O extra "sugestao": "<texto>" do Diag: devolve em inicio/tam o texto JSON COM as aspas (indices em d.extras); false = nao tem.
proc sugestao_dos_extras(extras: str, inicio: ^int, tam: ^int) -> bool {
    let chave = text.str_index_of(extras, "\"sugestao\": \"")
    if chave == none {
        return false
    }
    inicio^ = (chave or_else 0) + 12 // strlen("\"sugestao\": ")
    let fim = fim_do_texto_json(extras, inicio^)
    if fim < 0 {
        return false
    }
    tam^ = (fim - inicio^) + 1
    return true
}

// C: common/diag.c:494
proc primeiro_corte_da_sugestao(forma: str) -> int {
    var fim = len(forma)
    for corte in CORTES {
        let achou = text.str_index_of(forma, corte)
        if achou != none {
            let pos = achou or_else 0
            if (pos >= RESUMO_SUGESTAO_MINIMO) and (pos < fim) {
                fim = pos
            }
        }
    }
    return fim
}

// C: common/diag.c:506
proc fim_da_sugestao_curta(forma: str) -> int {
    var fim = primeiro_corte_da_sugestao(forma)
    if fim > RESUMO_SUGESTAO_MAX {
        fim = RESUMO_SUGESTAO_MAX
        while (fim > RESUMO_SUGESTAO_MINIMO) and (forma[fim] != 32) { // ' '
            fim -= 1
        }
    }
    // strchr(".,;:", forma[fim - 1]) != NULL
    while (fim > 0) and ((forma[fim - 1] == 46) or (forma[fim - 1] == 44) or (forma[fim - 1] == 59) or (forma[fim - 1] == 58)) {
        fim -= 1
    }
    return fim
}

// C: common/diag.c:519
// O campo "sugestao" do --resumo: a da propria ocorrencia ou a forma_certa encurtada. d none = sem Diag (diagnostico sem fonte).
proc escrever_sugestao_resumo(d: ?^Diag, f: ?^Fonte, item: ItemCatalogo, saida: ^Saida) {
    let forma = item.forma
    if d != none {
        let dd = d as ^Diag
        if dd.sug.n > 0 {
            imprimir_texto_json(saida, dd.sug.itens[0].descricao) // IA1-b04: a descricao da sugestao principal
            return
        }
        let extras = dd.extras or_else ""
        var inicio = 0
        var tam = 0
        if sugestao_dos_extras(extras, &inicio, &tam) {
            c2f_saida_escrever(saida, as_bytes(extras)[inicio..<(inicio + tam)])
            return
        }
        var ocorrencia: FormaTextos = FormaTextos{explicacao = "", forma = ""}
        diag_forma_da_ocorrencia(dd, f as ^Fonte, item.forma, &ocorrencia) // b07/b08
        defer delete(ocorrencia.explicacao)
        defer delete(ocorrencia.forma)
        imprimir_sugestao_curta(saida, ocorrencia.forma)
        return
    }
    imprimir_sugestao_curta(saida, forma)
}

// A forma_certa encurtada (fim_da_sugestao_curta) como texto JSON.
proc imprimir_sugestao_curta(saida: ^Saida, forma: str) {
    let curta = c2f_cortar(forma, fim_da_sugestao_curta(forma))
    defer delete(curta)
    imprimir_texto_json(saida, curta)
}

// C: common/diag.c:547
proc escrever_resumo(d: ^Diag, f: ^Fonte, saida: ^Saida) {
    let item = CATALOGO[d.codigo]
    let pos = fonte_localizar_no_arquivo(f, d.off)
    let cabeca = format(f"{{\"codigo\": \"{item.codigo}\", \"arquivo\": ", alloc = heap)
    defer delete(cabeca)
    c2f_saida_formatar(saida, cabeca)
    imprimir_caminho_json(saida, pos.caminho)
    let linha_coluna = format(f", \"linha\": {pos.linha}, \"coluna\": {pos.coluna}, \"causa\": ", alloc = heap)
    defer delete(linha_coluna)
    c2f_saida_formatar(saida, linha_coluna)
    imprimir_texto_json(saida, d.causa)
    c2f_saida_escrever_texto(saida, ", \"sugestao\": ")
    escrever_sugestao_resumo(d, f, item, saida)
    c2f_saida_escrever_texto(saida, "}\n")
}

// C: common/diag.c:562
// A saida padrao (stdout ou stderr): so ela vira --resumo e vai para o FORJA_LOG_DIAG.
proc saida_padrao(saida: ^Saida) -> bool {
    return (saida.tipo == SAIDA_STDOUT) or (saida.tipo == SAIDA_STDERR)
}

// C: common/diag.c:567
// LIMITE: 6 parametros posicionais - os 5 do C mais o sd (C2F-70).
proc escrever_na_forma(d: ^Diag, f: ^Fonte, extras_json: ?str, saida: ^Saida, resumo: bool, sd: ^SaidaDiag) {
    if resumo {
        escrever_resumo(d, f, saida)
    } else {
        escrever_completo(d, f, extras_json, saida, sd)
    }
}

// C: common/diag.c:574
proc imprimir_diagnostico(d: ^Diag, f: ^Fonte, extras_json: ?str, saida: ^Saida, sd: ^SaidaDiag) {
    let padrao = saida_padrao(saida)
    let resumo = padrao and sd.resumo
    var log: ?^Saida = none
    if padrao {
        log = abrir_log_diag()
    }
    if not resumo {
        diag_spec_iniciar_linha(sd, d.codigo) // o "spec" do codigo sai inteiro so na 1a vez da execucao, na tela e no log
    }
    escrever_na_forma(d, f, extras_json, saida, resumo, sd)
    c2f_saida_flush(saida)
    if log == none {
        return
    }
    escrever_na_forma(d, f, extras_json, log as ^Saida, resumo, sd)
    _ = c2f_saida_fechar(log as ^Saida)
}

// C: common/diag.c:588
pub proc diag_imprimir_json(d: ^Diag, f: ^Fonte, saida: ^Saida, sd: ^SaidaDiag) {
    imprimir_diagnostico(d, f, none, saida, sd)
}

// C: common/diag.c:593
pub proc diag_imprimir_json_extras(d: ^Diag, f: ^Fonte, extras_json: ?str, saida: ^Saida, sd: ^SaidaDiag) {
    imprimir_diagnostico(d, f, extras_json, saida, sd)
}

// C: common/diag.c:598
pub proc diag_lista_guardar(l: ?^DiagLista, d: ^Diag, modulo: u32) -> bool {
    let lista = l as ^DiagLista
    var teto: u32 = lista.teto
    if lista.teto == 0 {
        teto = DIAG_TETO_PADRAO as u32
    }
    if teto > (DIAG_MAX as u32) {
        teto = DIAG_MAX as u32
    }
    let calado: bool = d.calado
    d.tem = false
    d.calado = false
    if calado {
        return true // cascata de declaracao envenenada: o erro de origem ja esta (ou vai estar) na lista
    }
    if lista.n >= teto {
        lista.cortado = true
        return false
    }
    lista.itens[lista.n] = d^ // copia rasa: os str sao imutaveis (R21)
    lista.modulo[lista.n] = modulo
    lista.n += 1
    return true
}

// C: common/diag.c:617
proc sai_antes(l: ^DiagLista, a: u32, b: u32) -> bool {
    if l.modulo[a] != l.modulo[b] {
        return l.modulo[a] < l.modulo[b]
    }
    return l.itens[a].off < l.itens[b].off
}

// C: common/diag.c:624
pub proc diag_lista_ordenar(l: ^DiagLista) {
    var i: u32 = 1
    while i < l.n {
        var k: u32 = i
        while (k > 0) and (c2f_b2i32(sai_antes(l, k, k - 1)) != 0) {
            let item: Diag = l.itens[k]
            let modulo: u32 = l.modulo[k]
            l.itens[k] = l.itens[k - 1]
            l.modulo[k] = l.modulo[k - 1]
            l.itens[k - 1] = item
            l.modulo[k - 1] = modulo
            k -= 1
        }
        i += 1
    }
}

// C: common/diag.c:638
pub proc diag_lista_imprimir(l: ^DiagLista, f: ^Fonte, saida: ^Saida, sd: ^SaidaDiag) {
    for k in (0 as u32)..<l.n {
        diag_imprimir_json(&l.itens[k], f, saida, sd)
    }
}

// C: common/diag.c:643
pub proc diag_codigo_texto(codigo: i32) -> str {
    return CATALOGO[codigo].codigo
}

// C: common/diag.c:648
pub proc diag_codigo_explicacao(codigo: i32) -> str {
    return CATALOGO[codigo].explicacao
}

// C: common/diag.c:653
pub proc diag_codigo_forma(codigo: i32) -> str {
    return CATALOGO[codigo].forma
}

// C: common/diag.c:658
pub proc diag_codigo_por_texto(texto: ?str) -> i32 {
    let procurado = texto or_else ""
    for i in 0..<DIAG_QTD {
        if CATALOGO[i].codigo == procurado {
            return i
        }
    }
    return -1
}

// C: common/diag.c:667
proc imprimir_resto(saida: ^Saida, item: ItemCatalogo) {
    c2f_saida_escrever_texto(saida, ", \"tipo\": ")
    imprimir_texto_json(saida, item.tipo)
    c2f_saida_escrever_texto(saida, ", \"explicacao\": ")
    imprimir_texto_json(saida, item.explicacao)
    c2f_saida_escrever_texto(saida, ", \"forma_certa\": ")
    imprimir_texto_json(saida, item.forma)
}

// C: common/diag.c:677
pub proc diag_explicar_json(codigo: i32, saida: ^Saida) {
    let item = CATALOGO[codigo]
    c2f_saida_escrever_texto(saida, "{\"codigo\": ")
    imprimir_texto_json(saida, item.codigo)
    imprimir_resto(saida, item)
    diag_spec_imprimir_completo(codigo, saida)
    c2f_saida_escrever_texto(saida, "}\n")
    c2f_saida_flush(saida)
}

// C: common/diag.c:699
// Sem linha do .fj: codigo e causa, depois tipo, explicacao, forma_certa e "ferramenta": {"nome","saida"} (b03); no --resumo, codigo, causa e sugestao.
proc escrever_sem_fonte(d: ^DadosSemFonte, saida: ^Saida, resumo: bool, sd: ^SaidaDiag) {
    let item = CATALOGO[d.codigo]
    c2f_saida_escrever_texto(saida, "{\"codigo\": ")
    imprimir_texto_json(saida, item.codigo)
    c2f_saida_escrever_texto(saida, ", \"causa\": ")
    imprimir_texto_json(saida, d.causa)
    if resumo {
        c2f_saida_escrever_texto(saida, ", \"sugestao\": ")
        escrever_sugestao_resumo(none, none, item, saida)
    } else {
        imprimir_resto(saida, item)
        if d.ferramenta != none {
            c2f_saida_escrever_texto(saida, ", \"ferramenta\": {\"nome\": ")
            imprimir_texto_json(saida, d.ferramenta)
            c2f_saida_escrever_texto(saida, ", \"saida\": ")
            imprimir_texto_json(saida, d.saida_ferramenta or_else "")
            c2f_saida_putc(saida, 125) // '}'
        }
        diag_spec_imprimir(d.codigo, saida, sd)
    }
    c2f_saida_escrever_texto(saida, "}\n")
}

// C: common/diag.c:724
proc imprimir_sem_fonte(d: ^DadosSemFonte, saida: ^Saida, sd: ^SaidaDiag) {
    let padrao = saida_padrao(saida)
    let resumo = padrao and sd.resumo
    var log: ?^Saida = none
    if padrao {
        log = abrir_log_diag()
    }
    if not resumo {
        diag_spec_iniciar_linha(sd, d.codigo)
    }
    escrever_sem_fonte(d, saida, resumo, sd)
    c2f_saida_flush(saida)
    if log == none {
        return
    }
    escrever_sem_fonte(d, log as ^Saida, resumo, sd)
    _ = c2f_saida_fechar(log as ^Saida)
}

// C: common/diag.c:738
pub proc diag_imprimir_json_sem_fonte(codigo: i32, causa: ?str, saida: ^Saida, sd: ^SaidaDiag) {
    var d: DadosSemFonte = DadosSemFonte{codigo = codigo, causa = causa}
    imprimir_sem_fonte(&d, saida, sd)
}

// C: common/diag.c:745
// LIMITE: 6 parametros posicionais - os 5 do C mais o sd (C2F-70).
proc diag_imprimir_json_ferramenta(codigo: i32, causa: str, ferramenta: str, saida_ferramenta: str, saida: ^Saida, sd: ^SaidaDiag) {
    var d: DadosSemFonte = DadosSemFonte{codigo = codigo, causa = causa, ferramenta = ferramenta, saida_ferramenta = saida_ferramenta}
    imprimir_sem_fonte(&d, saida, sd)
}
