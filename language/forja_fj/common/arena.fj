import "std:mem"

// C2F-20: embrulho de std:mem; a arena nasce na 1a alocacao (bloco 16384 como o C) e pode ser usada de novo depois de liberada
pub struct Arena {
    m: mem.Arena
    viva: bool
}

pub proc arena_mem(a: ^Arena) -> mem.Arena {
    if not a.viva {
        a.m = mem.arena_create(block_size = 16384)
        a.viva = true
    }
    return a.m
}

pub proc arena_liberar(a: ^Arena) {
    if a.viva {
        mem.arena_destroy(a.m)
        a.viva = false
    }
}

pub proc arena_fatia_bool(a: ^Arena, n: int) -> []bool {
    var l = make([dynamic]bool, alloc = arena_mem(a), cap = n)
    for i in 0..<n {
        append(&l, item = false)
    }
    return l[..]
}

pub proc arena_fatia_i32(a: ^Arena, n: int) -> []i32 {
    var l = make([dynamic]i32, alloc = arena_mem(a), cap = n)
    for i in 0..<n {
        append(&l, item = 0)
    }
    return l[..]
}

pub proc arena_fatia_str(a: ^Arena, n: int) -> []str {
    var l = make([dynamic]str, alloc = arena_mem(a), cap = n)
    for i in 0..<n {
        append(&l, item = "")
    }
    return l[..]
}

pub proc arena_fatia_u32(a: ^Arena, n: int) -> []u32 {
    var l = make([dynamic]u32, alloc = arena_mem(a), cap = n)
    for i in 0..<n {
        append(&l, item = 0)
    }
    return l[..]
}

pub proc arena_fatia_u64(a: ^Arena, n: int) -> []u64 {
    var l = make([dynamic]u64, alloc = arena_mem(a), cap = n)
    for i in 0..<n {
        append(&l, item = 0)
    }
    return l[..]
}

pub proc arena_fatia_u8(a: ^Arena, n: int) -> []u8 {
    var l = make([dynamic]u8, alloc = arena_mem(a), cap = n)
    for i in 0..<n {
        append(&l, item = 0)
    }
    return l[..]
}

// Do TestaArena do teste_common.c: pedacos zerados, bloco grande, copia de texto e arena reutilizavel depois de liberada (C2F-20)
test "arena" {
    var a: Arena = Arena{}
    let x = arena_fatia_u8(&a, 3)
    let y = arena_fatia_u8(&a, 100)
    expect(x[0] == 0 and y[99] == 0)
    expect(a.viva)
    let grande = arena_fatia_u8(&a, 9437184)
    expect(len(grande) == (9437184) and grande[(9437184) - 1] == 0)
    let t = from_bytes(as_bytes("forja!")[0..<5], alloc = arena_mem(&a))
    expect(t == "forja")
    arena_liberar(&a)
    expect(not a.viva)
    let z = arena_fatia_u32(&a, 4)
    expect(a.viva and len(z) == 4 and z[3] == 0)
    arena_liberar(&a)
}
