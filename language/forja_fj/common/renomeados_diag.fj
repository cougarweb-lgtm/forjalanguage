// C2F-70 global mutavel TolerarAntiga (_Bool): nao ha var de topo. O estado vira o parametro `tolerar` de renomeado_recusa_com (plano C2F-70: o cmd_migrar passa true no trecho em que o C
// ligava o modo, cmd_migrar.c:218..220, e false nos demais). renomeado_recusa(r) segue com a assinatura do esqueleto (8 chamadores ja portados fora do lote) e e o caso tolerar = false;
// renomeado_tolerar_antiga (o setter) nao tem mais estado para ligar: continua stub de proposito (quem portar o cmd_migrar troca a chamada por renomeado_recusa_com(.., true)).

// C: common/renomeados_diag.c:14
pub proc renomeado_recusa_com(r: ?^Renomeado, tolerar: bool) -> bool {
    return (r as ^Renomeado).recusar and not tolerar
}

pub proc renomeado_recusa(r: ?^Renomeado) -> bool {
    return renomeado_recusa_com(r, false)
}

// C2F-70 (decisao do main, V5): o modo "tolerar forma antiga" do C (global ligado so dentro do forja migrar) vira "o Diag tem d.trocas": so o migrar liga d.trocas,
// entao renomeado_recusa_em(d, r) e equivalente a RenomeadoRecusa(r) do C com o global.
pub proc renomeado_recusa_em(d: ^Diag, r: ?^Renomeado) -> bool {
    return renomeado_recusa_com(r, d.trocas != none)
}

// C: common/renomeados_diag.c:19 (RenomeadoTolerarAntiga: sem global; ver renomeado_recusa_em) - proc removido, sem chamador

// C: common/renomeados_diag.c:22 (RenTrocas por ponteiro, no heap: new(T) de outro pacote e E1003, por isso o alocador mora aqui)
pub proc ren_trocas_novo() -> ^RenTrocas {
    return new(RenTrocas, alloc = heap)
}

// C: common/renomeados_diag.c:24
pub proc ren_trocas_iniciar(t: ^RenTrocas) {
    t.itens = make([dynamic]RenTroca, alloc = heap)
}

// C: common/renomeados_diag.c:29
pub proc ren_trocas_liberar(t: ^RenTrocas) {
    delete(t.itens)
}

// C: common/renomeados_diag.c:34
pub proc renomeado_notar(d: ^Diag, troca: ^RenTroca) {
    if d.trocas == none {
        return
    }
    let ptr_1: ^RenTrocas = d.trocas as ^RenTrocas
    append(&ptr_1.itens, item = RenTroca{})
    ptr_1.itens[len(ptr_1.itens) - 1] = troca^
}

// C: common/renomeados_diag.c:40
pub proc renomeado_notar_tabela(d: ^Diag, pos: u32, tam: u32, r: ?^Renomeado) {
    var lit_1 = RenTroca{off = pos, tam = tam, classe = (r as ^Renomeado).classe, antigo = (r as ^Renomeado).antigo, novo = (r as ^Renomeado).novo}
    renomeado_notar(d, &lit_1)
}

// C: common/renomeados_diag.c:45
pub proc renomeado_recusar(d: ^Diag, pos: u32, tam: u32, r: ?^Renomeado) -> bool {
    let txt_1 = (r as ^Renomeado).antigo or_else "(null)"
    let txt_2 = (r as ^Renomeado).novo or_else "(null)"
    let msg_1 = format(f"forma antiga: '{txt_1}' agora e '{txt_2}' ({renomeado_classe_texto((r as ^Renomeado).classe)}); rode forja migrar", alloc = heap)
    defer delete(msg_1)
    _ = diag_relatar(d, E0110, pos, msg_1)
    let txt_3 = (r as ^Renomeado).antigo or_else "(null)"
    let txt_4 = (r as ^Renomeado).novo or_else "(null)"
    let msg_2 = format(f"troque '{txt_3}' por '{txt_4}': o nome foi renomeado; 'forja migrar' faz a troca no projeto todo", alloc = heap)
    defer delete(msg_2)
    _ = diag_sugerir(&d.sug, DIAG_CERTA, msg_2)
    if (len(((r as ^Renomeado).novo or_else "")) as u64) < (DIAG_NOVO_MAX as u64) {
        _ = diag_editar(&d.sug, pos, pos + tam, (r as ^Renomeado).novo)
    }
    return false
}
