// C2F-N2: o C devolve &RENOMEADOS[k]; const da Forja nao tem endereco (E0301) e nao ha var de topo para guardar a tabela. O ponteiro devolvido e uma COPIA rasa (os str apontam
// para os mesmos literais) no heap; quem recebe e o dono (entrega). A raiz sai por os.exit, entao nao ha relato de vazamento (R0009) fora do `forja test`.
proc renomeado_copia(k: int) -> ?^Renomeado {
    let c = new(Renomeado, alloc = heap)
    c^ = RENOMEADOS[k]
    return c
}

// C: common/renomeados.c:208
pub proc renomeados_contagem() -> u64 {
    return QTD_RENOMEADOS as u64
}

// C: common/renomeados.c:213
pub proc renomeado_por_indice(indice: u64) -> ?^Renomeado {
    if indice < (QTD_RENOMEADOS as u64) {
        return renomeado_copia(indice as int)
    }
    return none
}

// C: common/renomeados.c:218
pub proc renomeado_buscar(classe: i32, antigo: str) -> ?^Renomeado {
    let tabela = RENOMEADOS
    for k in 0..<167 {
        let r = tabela[k]
        if r.classe == classe and (r.antigo or_else "") == antigo {
            return renomeado_copia(k)
        }
    }
    return none
}

// C: common/renomeados.c:226
pub proc renomeado_buscar_novo(classe: i32, novo: str) -> ?^Renomeado {
    let tabela = RENOMEADOS
    for k in 0..<167 {
        let r = tabela[k]
        if r.classe == classe and (r.novo or_else "") == novo {
            return renomeado_copia(k)
        }
    }
    return none
}

// C: common/renomeados.c:235
// O escopo tem 'palavra' como palavra inteira (separadores: espaco e parenteses).
proc escopo_tem_palavra(escopo: str, palavra: str) -> bool {
    let tam = len(palavra)
    var p = 0
    while c2f_nul_em(escopo, p) != 0 {
        var n = 0
        while c2f_nul_em(escopo, p + n) != 0 and c2f_nul_em(escopo, p + n) != 32 and c2f_nul_em(escopo, p + n) != 40 and c2f_nul_em(escopo, p + n) != 41 { // espaco abre-parentese fecha-parentese
            n += 1
        }
        if n == tam and escopo[p..<p + tam] == palavra {
            return true
        }
        if n > 0 {
            p += n
        } else {
            p += 1
        }
    }
    return false
}

// C: common/renomeados.c:249
// O escopo tem todas as palavras da lista (C: terminada em NULL; aqui a fatia ja vem sem o NULL; lista vazia = qualquer escopo).
proc escopo_tem_palavras(escopo: str, palavras: []str) -> bool {
    for i in 0..<len(palavras) {
        if not escopo_tem_palavra(escopo, palavras[i]) {
            return false
        }
    }
    return true
}

// 0.25.0 (FORJA-D0814): pre-filtro de renomeado_achar_em. O backend remonta a const RENOMEADOS inteira (167 itens) a cada uso, e quase todo nome pesquisado
// (campo ou chamada do usuario) nao esta na tabela; esta mascara de 4096 posicoes (FNV-1a de 32 bits & 4095 sobre cada antigo e cada novo; '#' = ocupada) recusa o nome
// antes de tocar na tabela. E uma const str (vive em .rdata, indexar um byte e O(1); const de array seria remontada a cada uso). Pode ter falso positivo (cai na busca
// normal), nunca falso negativo: o test "ren_filtro_cobre_a_tabela" confere os 167 itens; ao mexer na tabela, regerar a string (gerador: scratchpad GerarFiltroRen.py,
// mesmo hash de ren_hash_nome).
const REN_FILTRO: str = ".................................................................#...........................#.....#......................#..............................#......#..#....................#...............#...............#...#..#...........#................#...................#...................................##...#.....#......#..........#......#.......................#........................................#...............#.......#....................#.##..#.....#..................#.................................##..........#........................#.....#.....#..#.......#......................#..........#.#...............................#..........#.........#........#.....#................................................................#.............#...............................................#................#.........#.............##......................#........................#...#..................#...#..................#.............#.........#...#............................#...........#.#.......#...........#.......................................................##...............#..#...............#...................................#..........#..........................#.......#.............#........................#....................##................#........................#...#.#.......#............#.....#.......#....................................#........................................#.......#..............#........................#............#.........................#.......................................................................................................................#...............#..........#...#.......#..................#..........#.....................#.....#.................................#..#.......#..............#..................................#......##............#.....#.#....#.....#....................................#...#.........#...................#..............#............................#.....#.....#..........#..##.#..#...#.............##..............#....................#.........#...#..#.#........#......#..#.............#........................##...#....................#.....#..................#.....#........#.........................#...............#................#..........#..............#....................#..............................................................#.........#..................................#...#.............#...#......#...#.......#..#..................................#.............................#...........#..#...#.#...................................#...............#......#................#.#............#.....................##...............#.........#..............#..................................#.....................#...............#.....................................#..........#....#.....#.#............................................#.................#........#...............#.............................#..........#..........#......#..............#.........#........#.#............................#.................#..........#......#.#........#..#............................#...........................#.......................................................................................#..#.....................#................................#.................#............#....#..#..........................##.......#.................................................................#...........#.....................................#.........................#......................#.#.#.....#......#..#......#...................................#........................#.#.....#.....................................................#............................#........#.....#........................#.........#...............#.......#..........##............................................#....#............#...................#....................#......#.............#...................................#.............................................#.............#.#.......#............................#.....#........"

// FNV-1a de 32 bits do nome (mesmo calculo do gerador da mascara).
proc ren_hash_nome(nome: str) -> u32 {
    var h: u32 = 2166136261
    for i in 0..<len(nome) {
        h = wrapping_mul(h ~ (nome[i] as u32), 16777619)
    }
    return h
}

// O nome pode estar na tabela? falso = com certeza nao esta.
proc ren_nome_possivel(nome: str) -> bool {
    return REN_FILTRO[ren_hash_nome(nome) & 4095] == 35 // '#'
}

// C: common/renomeados.c:257
// C2F-N1: palavras era `const char *const *` terminado em NULL; vira []str (o ponteiros.tsv trazia ^?^u8 por engano de papel).
pub proc renomeado_achar_em(classe: i32, palavras: []str, nome: ?str, era_antigo: ^bool) -> ?^Renomeado {
    let nome_t = nome or_else ""
    if not ren_nome_possivel(nome_t) {
        return none
    }
    let tabela = RENOMEADOS
    for k in 0..<167 {
        let r = tabela[k]
        let antigo = (r.antigo or_else "") == nome_t
        if r.classe != classe or (not antigo and (r.novo or_else "") != nome_t) {
            continue
        }
        if not escopo_tem_palavras(r.escopo or_else "", palavras) {
            continue
        }
        era_antigo^ = antigo
        return renomeado_copia(k)
    }
    return none
}

// C: common/renomeados.c:271
pub proc renomeado_achar(classe: i32, palavra: ?str, nome: str, era_antigo: ^bool) -> ?^Renomeado {
    if palavra == none { // palavra NULL = lista vazia
        return renomeado_achar_em(classe, {}, nome, era_antigo)
    }
    var palavras: [1]str = {palavra or_else ""}
    return renomeado_achar_em(classe, palavras[..], nome, era_antigo)
}

// C: common/renomeados.c:278
pub proc renomeado_classe_texto(classe: i32) -> str {
    if c2f_s2u_32(classe) < (REN_CLASSE_QTD as u32) {
        return CLASSE_TEXTO[classe]
    }
    return "?"
}

// ---- Testes: porte do teste_common_renomeados.c (RenomeadosVerificacoes). Os resultados de renomeado_* sao copias no heap: cada teste os libera.

const REN_TESTE_MARCA_SECAO: str = "\nRENOMEADOS (Emenda 4)"
const REN_TESTE_CABECALHO_SECAO: str = "classe\tescopo\tantigo\tnovo\tnota\n"

proc ren_teste_livre(r: ?^Renomeado) {
    if r != none {
        delete(r as ^Renomeado)
    }
}

// O r existe e tem esse antigo e esse novo?
proc ren_teste_eh(r: ?^Renomeado, antigo: str, novo: str) -> bool {
    if r == none {
        return false
    }
    let c = r as ^Renomeado
    return (c.antigo or_else "") == antigo and (c.novo or_else "") == novo
}

// A mesma linha da tabela (a Forja devolve copias, nao o mesmo endereco: compara os campos).
proc ren_teste_mesmo(a: ?^Renomeado, b: ?^Renomeado) -> bool {
    if a == none or b == none {
        return a == none and b == none
    }
    let x = a as ^Renomeado
    let y = b as ^Renomeado
    return x.classe == y.classe and (x.escopo or_else "") == (y.escopo or_else "") and (x.antigo or_else "") == (y.antigo or_else "") and (x.novo or_else "") == (y.novo or_else "")
}

// O campo tem texto e nenhum byte que quebre a linha da migracao.txt (TAB, LF, CR, barra invertida, aspas).
proc ren_teste_campo_valido(campo: ?str) -> bool {
    if campo == none {
        return false
    }
    let b = as_bytes(campo or_else "")
    if len(b) == 0 {
        return false
    }
    for i in 0..<len(b) {
        if b[i] == 9 or b[i] == 10 or b[i] == 13 or b[i] == 92 or b[i] == 34 {
            return false
        }
    }
    return true
}

test "ren_campos" {
    var invalidas = 0
    var iguais = 0
    var classes = 0
    for k in 0..<167 {
        let r = RENOMEADOS[k]
        if not ren_teste_campo_valido(r.escopo) or not ren_teste_campo_valido(r.antigo) or not ren_teste_campo_valido(r.novo) or not ren_teste_campo_valido(r.nota) {
            invalidas += 1
        }
        if (r.antigo or_else "") == (r.novo or_else "") and r.classe != REN_LIBM { // S3 P4: sqrt -> sqrt (embutido) nao e renome
            iguais += 1
        }
        if r.classe < 0 or r.classe >= REN_CLASSE_QTD or renomeado_classe_texto(r.classe) == "?" {
            classes += 1
        }
    }
    expect(renomeados_contagem() > 0)
    expect(invalidas == 0)
    expect(iguais == 0)
    expect(classes == 0)
}

// A mascara de renomeado_achar_em nunca recusa um nome da tabela (falso negativo esconderia um renome).
test "ren_filtro_cobre_a_tabela" {
    var fora = 0
    for k in 0..<167 {
        let r = RENOMEADOS[k]
        if not ren_nome_possivel(r.antigo or_else "") or not ren_nome_possivel(r.novo or_else "") {
            fora += 1
        }
    }
    expect(fora == 0)
}

test "ren_sem_repeticao" {
    var repetidas = 0
    for a in 0..<167 {
        for b in (a + 1)..<167 {
            let x = RENOMEADOS[a]
            let y = RENOMEADOS[b]
            if x.classe == y.classe and (x.escopo or_else "") == (y.escopo or_else "") and (x.antigo or_else "") == (y.antigo or_else "") {
                repetidas += 1
            }
        }
    }
    expect(repetidas == 0)
}

test "ren_api" {
    let n = renomeados_contagem()
    let fora = renomeado_por_indice(n)
    let primeira = renomeado_por_indice(0)
    let ultima = renomeado_por_indice(n - 1)
    let em = renomeado_buscar(REN_ROTULO, "em")
    let banco = renomeado_buscar(REN_TIPO, "ErroBanco")
    let rotulo_com_tipo = renomeado_buscar(REN_ROTULO, "ErroBanco")
    let pacote_com_rotulo = renomeado_buscar(REN_PACOTE, "em")
    expect(n == 167)
    expect(fora == none)
    expect(primeira != none and ultima != none)
    expect(ren_teste_eh(ultima, "sqrtf", "sqrt"))
    expect(ren_teste_eh(em, "em", "alloc"))
    expect(ren_teste_eh(banco, "ErroBanco", "DbError"))
    expect(rotulo_com_tipo == none)
    expect(pacote_com_rotulo == none)
    expect(renomeado_classe_texto(REN_VALOR_ALOCADOR) == "valor-alocador")
    expect(renomeado_classe_texto(REN_CLASSE_QTD) == "?")
    ren_teste_livre(primeira)
    ren_teste_livre(ultima)
    ren_teste_livre(em)
    ren_teste_livre(banco)
}

test "ren_dupla_aceitacao" {
    var era_antigo = true
    var recusadas = 0
    let novo = renomeado_buscar_novo(REN_ROTULO, "alloc")
    let por_novo = renomeado_achar(REN_ROTULO, "make", "alloc", &era_antigo)
    expect(ren_teste_eh(novo, "em", "alloc"))
    expect(ren_teste_mesmo(por_novo, novo) and not era_antigo)
    let por_antigo = renomeado_achar(REN_ROTULO, "format_c", "em", &era_antigo)
    expect(ren_teste_mesmo(por_antigo, novo) and era_antigo)
    let format_em = renomeado_achar(REN_ROTULO, "format", "em", &era_antigo)
    let forma_em = renomeado_achar(REN_ROTULO, "forma", "em", &era_antigo)
    let transmute_em = renomeado_achar(REN_ROTULO, "transmute", "em", &era_antigo)
    let transmute_para = renomeado_achar(REN_ROTULO, "transmute", "para", &era_antigo)
    expect(ren_teste_mesmo(format_em, novo))
    expect(forma_em == none)
    expect(transmute_em == none)
    expect(transmute_para != none and era_antigo)
    let abrir = renomeado_achar(REN_PROC, "vendor:db/db", "abrir", &era_antigo)
    let abrir_outro = renomeado_achar(REN_PROC, "vendor:db/outro", "abrir", &era_antigo)
    let qual_arquivo = renomeado_achar(REN_QUALIFICADOR, none, "arquivo", &era_antigo)
    let mod_file = renomeado_buscar_novo(REN_MODULO, "std:file")
    let mod_arquivo = renomeado_buscar_novo(REN_MODULO, "std:arquivo")
    expect(abrir != none)
    expect(abrir_outro == none)
    expect(qual_arquivo != none)
    expect(mod_file != none and mod_arquivo == none)
    for k in 0..<167 {
        if not RENOMEADOS[k].recusar and RENOMEADOS[k].classe != REN_LIBM { // S3 P4: libm e codigo valido, nao E0110
            recusadas += 1
        }
    }
    expect(recusadas == 0)
    ren_teste_livre(novo)
    ren_teste_livre(por_novo)
    ren_teste_livre(por_antigo)
    ren_teste_livre(format_em)
    ren_teste_livre(transmute_para)
    ren_teste_livre(abrir)
    ren_teste_livre(qual_arquivo)
    ren_teste_livre(mod_file)
}

// C2F-70: o modo "tolerar forma antiga" e o parametro de renomeado_recusa_com.
test "ren_recusa" {
    let em = renomeado_buscar(REN_ROTULO, "em")
    expect(em != none and renomeado_recusa(em))
    expect(not renomeado_recusa_com(em, true))
    expect(renomeado_recusa_com(em, false))
    ren_teste_livre(em)
}

test "ren_classes_do_l3c2" {
    var era_antigo = false
    var db_erro: [2]str = {"vendor:db/db", "DbError"}
    var db_outro: [2]str = {"vendor:db/db", "ZlibError"}
    var outro_modulo: [2]str = {"vendor:compression/compression", "DbError"}
    let m = renomeado_achar_em(REN_MEMBRO, db_erro[..], "nao_abriu", &era_antigo)
    expect(m != none and era_antigo and ren_teste_eh(m, "nao_abriu", "not_opened"))
    let m_novo = renomeado_achar_em(REN_MEMBRO, db_erro[..], "not_opened", &era_antigo)
    expect(ren_teste_mesmo(m_novo, m) and not era_antigo)
    let m_outro = renomeado_achar_em(REN_MEMBRO, db_outro[..], "sem_memoria", &era_antigo)
    let m_modulo = renomeado_achar_em(REN_MEMBRO, outro_modulo[..], "sem_memoria", &era_antigo)
    expect(m_outro == none)
    expect(m_modulo == none)
    let p_db = renomeado_achar(REN_PARAM, "vendor:db/db", "caminho", &era_antigo)
    expect(p_db != none and era_antigo)
    let p_json = renomeado_achar(REN_PARAM, "vendor:json/outro", "caminho", &era_antigo)
    expect(p_json == none)
    let pacote = renomeado_achar(REN_PACOTE, "import", "banco_servidor", &era_antigo)
    expect(pacote != none and era_antigo)
    let physics_novo = renomeado_buscar_novo(REN_PACOTE, "physics2d")
    let physics_antigo = renomeado_buscar(REN_PACOTE, "physics2d")
    expect(physics_novo != none and physics_antigo == none)
    let banco = renomeado_buscar(REN_MODULO, "vendor:banco/banco")
    let db = renomeado_buscar_novo(REN_MODULO, "vendor:db/db")
    expect(banco != none and db != none)
    expect(renomeado_classe_texto(REN_PARAM) == "param")
    ren_teste_livre(m)
    ren_teste_livre(m_novo)
    ren_teste_livre(p_db)
    ren_teste_livre(pacote)
    ren_teste_livre(physics_novo)
    ren_teste_livre(banco)
    ren_teste_livre(db)
}

test "ren_params_do_json" {
    let antigos: [4]str = {"indice", "valor", "texto", "caminho"}
    let novos: [4]str = {"index", "value", "text", "path"}
    var era_antigo = false
    for k in 0..<4 {
        let r = renomeado_achar(REN_PARAM, "vendor:json/json", antigos[k], &era_antigo)
        expect(r != none and era_antigo and ren_teste_eh(r, antigos[k], novos[k]) and renomeado_recusa(r))
        let pelo_novo = renomeado_achar(REN_PARAM, "vendor:json/json", novos[k], &era_antigo)
        expect(ren_teste_mesmo(pelo_novo, r) and not era_antigo)
        let em_net = renomeado_achar(REN_PARAM, "vendor:net/net", antigos[k], &era_antigo)
        expect(em_net == none)
        ren_teste_livre(r)
        ren_teste_livre(pelo_novo)
    }
    let proc_texto = renomeado_achar(REN_PROC, "vendor:json/json", "texto", &era_antigo)
    let param_valor_db = renomeado_achar(REN_PARAM, "vendor:db/db", "valor", &era_antigo)
    expect(proc_texto != none)
    expect(param_valor_db != none)
    ren_teste_livre(proc_texto)
    ren_teste_livre(param_valor_db)
}

test "ren_trocas" {
    var d = Diag{}
    var reg = RenTrocas{}
    ren_trocas_iniciar(&reg)
    var t1 = RenTroca{off = 10, tam = 2, classe = REN_ROTULO, antigo = "em", novo = "alloc"}
    renomeado_notar(&d, &t1)
    expect(len(reg.itens) == 0)
    d.trocas = &reg
    let em = renomeado_buscar(REN_ROTULO, "em")
    renomeado_notar_tabela(&d, 10, 2, em)
    var t2 = RenTroca{off = 30, tam = 4, classe = REN_QUALIFICADOR, antigo = "arquivo", novo = "file"}
    renomeado_notar(&d, &t2)
    expect(len(reg.itens) == 2)
    expect(reg.itens[0].off == 10 and reg.itens[0].tam == 2 and reg.itens[0].classe == REN_ROTULO)
    expect((reg.itens[0].antigo or_else "") == "em" and (reg.itens[0].novo or_else "") == "alloc")
    expect(reg.itens[1].off == 30 and reg.itens[1].classe == REN_QUALIFICADOR and (reg.itens[1].novo or_else "") == "file")
    ren_teste_livre(em)
    ren_trocas_liberar(&reg)
}

// 0 = ok; 1 marca ausente; 2 marca repetida; 3 cabecalho ausente; 4 linha divergente; 5 sobra texto depois da ultima linha.
proc ren_teste_doc_contra_tabela() -> i32 {
    let doc = doc_embutida_texto(DOC_MIGRACAO)
    let marca = text.str_index_of(doc, REN_TESTE_MARCA_SECAO)
    if marca == none {
        return 1
    }
    let m = marca or_else 0
    if text.str_index_of(doc[m + 1..<len(doc)], REN_TESTE_MARCA_SECAO) != none {
        return 2
    }
    let cab = text.str_index_of(doc[m..<len(doc)], REN_TESTE_CABECALHO_SECAO)
    if cab == none {
        return 3
    }
    var p = m + (cab or_else 0) + len(REN_TESTE_CABECALHO_SECAO)
    for k in 0..<167 {
        let r = RENOMEADOS[k]
        let escopo = r.escopo or_else ""
        let antigo = r.antigo or_else ""
        let novo = r.novo or_else ""
        let nota = r.nota or_else ""
        let linha = format(f"{renomeado_classe_texto(r.classe)}\t{escopo}\t{antigo}\t{novo}\t{nota}\n", alloc = heap)
        defer delete(linha)
        if p + len(linha) > len(doc) or doc[p..<p + len(linha)] != linha {
            return 4
        }
        p += len(linha)
    }
    if p != len(doc) {
        return 5
    }
    return 0
}

test "ren_doc_igual_a_tabela" {
    expect(ren_teste_doc_contra_tabela() == 0)
}
