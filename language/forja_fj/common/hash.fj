// common/hash.fj - porte de compiler/common/hash.c, compiler/common/hash.h
// sha256 de common/hash.c: 3dad2a10ad051f99b7890c1600789c0fc988d7c520742044114454407fb242d2
// sha256 de common/hash.h: 44d8ee29fdcdbbf2b5285a1a4242d0552bfcd4dbbf873535a932f3416113ba7a
// gerado por c2forja esqueleto 0.3.2
// Versao: 0.2.0
// Changelog: 0.2.0 - G3 P-common C1a: corpo real; dados passa de rawptr (C2F-VOID) para []u8 (dados crus), o chamador com texto passa as_bytes(s).

const HASH64_PRIMO: u64 = 1099511628211
pub const HASH64_SEMENTE: u64 = 14695981039346656037

// C: common/hash.c:10
// C2F-VOID: dados -> []u8 (bytes crus); n bytes lidos (n <= len(dados))
// C2F-55: FNV-1a com a volta do uint64 (wrapping_mul)
pub proc hash64(dados: []u8, n: u64, semente: u64) -> u64 {
    var h: u64 = semente
    for k in (0 as u64)..<n {
        h = wrapping_mul(h ~ (dados[k] as u64), HASH64_PRIMO)
    }
    return h
}

// Do teste_common_atomico.c (VerificaHash) e vetores FNV-1a de 64 bits conhecidos; o diferencial contra o Hash64 do C esta no relatorio do lote
test "hash64" {
    expect(hash64(as_bytes(""), 0, HASH64_SEMENTE) == 0xcbf29ce484222325)
    expect(hash64(as_bytes("a"), 1, HASH64_SEMENTE) == 0xaf63dc4c8601ec8c)
    expect(hash64(as_bytes("foobar"), 6, HASH64_SEMENTE) == 0x85944171f73967e8)
    expect(hash64(as_bytes("foobar"), 3, HASH64_SEMENTE) == hash64(as_bytes("foo"), 3, HASH64_SEMENTE))
    let meio: u64 = hash64(as_bytes("foo"), 3, HASH64_SEMENTE)
    expect(hash64(as_bytes("bar"), 3, meio) == hash64(as_bytes("foobar"), 6, HASH64_SEMENTE))
}
