// sha256 de common/doc_embutida.h: f3ca65904189b6ae14c31451364ccd4e9cf982e1560117411fac4e227f131db6
// gerado por c2forja esqueleto 0.3.2; corpo real do P-common C3
// Versao: 0.2.0

// Vista de texto em memoria: texto e uma fatia que vai ate o fim do buffer de origem e tam e o tamanho logico (tam <= len(texto)); ponteiro + k do C = texto[k..<len(texto)].
// Os arquivos de language\doc vem por #load (C2F-A1, relativo a raiz forja_fj): len(texto) == tam e NAO ha o NUL depois do fim que o .incbin do C deixava (nada em common le alem de tam).
pub struct DocTexto {
    texto: []u8
    tam: u64
}

pub const DOC_CARTAO: i32 = 0
pub const DOC_SPEC: i32 = 1
const DOC_MAPA: i32 = 2
pub const DOC_MIGRACAO: i32 = 3
const DOC_EXEMPLOS: i32 = 4
pub const DOC_RECEITAS: i32 = 5
const DOC_QTD: i32 = 6

// C2F-82 macros FORJA_TEXTO_AUX, FORJA_TEXTO e DOC_INCBIN (texto do .incbin) e o -DFORJA_DOC_PASTA: a pasta language\doc entra pelo caminho relativo do #load.
const TEXTO_CARTAO: str = #load("../doc/cartao.txt")
const TEXTO_SPEC: str = #load("../doc/spec.txt")
const TEXTO_MAPA: str = #load("../doc/mapa_spec.tsv")
const TEXTO_MIGRACAO: str = #load("../doc/migracao.txt")
const TEXTO_EXEMPLOS: str = #load("../doc/exemplos.txt")
const TEXTO_RECEITAS: str = #load("../doc/receitas.txt")

// O mesmo arquivo como str ("" fora da faixa). Proc novo ao lado de doc_embutida: o spec_doc guarda os nomes de secao como fatia deste str (sem copia), porque nao ha visao str de []u8.
pub proc doc_embutida_texto(qual: i32) -> str {
    if qual == DOC_CARTAO {
        return TEXTO_CARTAO
    } else if qual == DOC_SPEC {
        return TEXTO_SPEC
    } else if qual == DOC_MAPA {
        return TEXTO_MAPA
    } else if qual == DOC_MIGRACAO {
        return TEXTO_MIGRACAO
    } else if qual == DOC_EXEMPLOS {
        return TEXTO_EXEMPLOS
    } else if qual == DOC_RECEITAS {
        return TEXTO_RECEITAS
    }
    return ""
}

// C: common/doc_embutida.c:40
pub proc doc_embutida(qual: i32) -> DocTexto {
    let t = doc_embutida_texto(qual)
    return DocTexto{texto = as_bytes(t), tam = len(t) as u64}
}
