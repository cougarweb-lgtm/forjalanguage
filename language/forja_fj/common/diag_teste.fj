// common/diag_teste.fj - os grupos b de tests/unidade/teste_common.c que tocam diag (TestaDiag, TestaDiagV13..V19, TestaDiagV111, TestaDiagSugestao,
// TestaDiagRelacionados, TestaDiagQueda, TestaDiagLayout, TestaDiagHigiene, TestaDiagLista, TestaDiagCalado) como blocos test (so blocos test; sem proc main).
// Versao: 0.1.0
// Changelog: 0.1.0 - G3 P-common C2: criacao. Cada test usa um SaidaDiag proprio (C2F-70): o "spec na 1a vez, spec_ref na 2a" vale por test.
//            Fora daqui: a parte (6) do TestaDiagRelacionados (ParecidosVerEm/ParecidosVer) e do pacote parecido.fj (C1); TestaTextoDoSpec e TestaSpecNoJson dependem do spec_doc (C3).
// Verificacao: forja test forja.fj --filtro diag

import "std:text"

// Primeira linha (ate o LF) do que foi escrito numa Saida em memoria, como texto novo do heap.
proc primeira_linha_da_saida(saida: ^Saida) -> str {
    let bytes = saida.buf[..]
    var fim = 0
    while (fim < len(bytes)) and (bytes[fim] != 10) {
        fim += 1
    }
    let linha = from_bytes(bytes[0..<fim], alloc = heap)
    _ = c2f_saida_fechar(saida)
    return linha
}

// Uma linha do JSON do diagnostico (C: LinhaDoDiag).
proc linha_do_diag(d: ^Diag, f: ^Fonte, sd: ^SaidaDiag) -> str {
    let saida = c2f_saida_memoria(false)
    diag_imprimir_json(d, f, saida, sd)
    return primeira_linha_da_saida(saida)
}

// A linha do catalogo (forja explicar) do codigo (C: LinhaDoCatalogo).
proc linha_do_catalogo_teste(codigo: i32) -> str {
    let saida = c2f_saida_memoria(false)
    diag_explicar_json(codigo, saida)
    return primeira_linha_da_saida(saida)
}

proc tem(texto: str, trecho: str) -> bool {
    return text.str_contains(texto, trecho)
}

// Posicao do trecho no texto, ou -1 (os testes comparam ordem entre campos).
proc pos(texto: str, trecho: str) -> int {
    return text.str_index_of(texto, trecho) or_else -1
}

// O codigo sabe seu texto e o texto devolve o mesmo codigo (o laco dos TestaDiagV13..V19).
proc codigos_conferem(lista: []str) -> bool {
    for i in 0..<len(lista) {
        let c = diag_codigo_por_texto(lista[i])
        if (c == -1) or (diag_codigo_texto(c) != lista[i]) {
            return false
        }
    }
    return true
}

proc guardar_de_teste(l: ^DiagLista, modulo: u32, off: u32, causa: str) {
    var d: Diag = Diag{}
    _ = diag_relatar(&d, E0201, off, causa)
    _ = diag_lista_guardar(l, &d, modulo)
}

// C: TestaDiag
test "diag: relatar, imprimir e codigo por texto" {
    var f: Fonte = fonte_de_texto("pasta\\a.fj", "ab\ncd\n")
    defer fonte_liberar(&f)
    var d: Diag = Diag{}
    var sd: SaidaDiag = SaidaDiag{}
    expect((not diag_relatar(&d, E0301, 4, "tipo \"x\" errado")) and d.tem)
    let linha = linha_do_diag(&d, &f, &sd)
    defer delete(linha)
    expect(tem(linha, "\"codigo\": \"E0301\"") and tem(linha, "\"arquivo\": \"pasta/a.fj\""))
    expect(tem(linha, "\"linha\": 2, \"coluna\": 2") and tem(linha, "tipo \\\"x\\\" errado"))
    expect(diag_codigo_por_texto("E0504") == E0504)
    expect(diag_codigo_por_texto("E9999") == -1)
    expect(diag_codigo_texto(E0420) == "E0420")
    expect((diag_codigo_por_texto("R0001") == R0001) and (diag_codigo_por_texto("B0002") == B0002))
    expect((diag_codigo_texto(R0003) == "R0003") and (diag_codigo_texto(B0001) == "B0001"))
}

// C: TestaDiagV13 .. TestaDiagV19
test "diag: codigos das versoes 1.3 a 1.9" {
    var v13: [4]str = {"E0306", "E0307", "E0706", "R0005"}
    var v14: [4]str = {"E0904", "E0905", "E0906", "B0004"}
    var v15: [4]str = {"E0308", "E0309", "E0421", "R0006"}
    var v16: [4]str = {"E0310", "E0311", "R0007", "R0008"}
    var v17: [4]str = {"E0312", "E0313", "E0314", "E0315"}
    var v18: [7]str = {"E0316", "E0317", "E1001", "E1002", "E1003", "E1004", "R0009"}
    var v18b: [25]str = {"E0907", "E0908", "R0010", "G0001", "G0003", "G0004", "G0005", "G0006", "G0007", "G0008", "G0013", "G0014", "G0016", "G0017", "G0019", "G0021", "G0022", "G0023", "G0025", "G0026", "G0101", "G0102", "G0103", "G0104", "G0105"}
    var v19: [4]str ={"E0318", "E0319", "E0320", "E0321"}
    expect(codigos_conferem(v13[..]))
    expect(codigos_conferem(v14[..]))
    expect(codigos_conferem(v15[..]))
    expect(codigos_conferem(v16[..]))
    expect(codigos_conferem(v17[..]))
    expect(codigos_conferem(v18[..]))
    expect(codigos_conferem(v18b[..]))
    expect(codigos_conferem(v19[..]))
}

// C: TestaDiagV111
test "diag: extras na ordem fixa depois de forma_certa" {
    var f: Fonte = fonte_de_texto("a.fj", "let x: i32 = 1.5\n")
    defer fonte_liberar(&f)
    var d: Diag = Diag{}
    var sd: SaidaDiag = SaidaDiag{}
    expect((diag_codigo_por_texto("E0330") == E0330) and (diag_codigo_texto(E0330) == "E0330"))
    _ = diag_relatar(&d, E0301, 13, "tipo diferente")
    diag_acrescentar_extra(&d, "sugestao", "\"1.5 as i32\"")
    diag_acrescentar_extra(&d, "cadeia", "[\"x (local, 1:5)\"]")
    let l1 = linha_do_diag(&d, &f, &sd)
    defer delete(l1)
    let forma = pos(l1, "\"forma_certa\"")
    let sugestao = pos(l1, "\"sugestao\": \"1.5 as i32\"")
    let cadeia = pos(l1, "\"cadeia\": [")
    expect((forma >= 0) and (sugestao >= 0) and (cadeia >= 0) and (forma < sugestao) and (sugestao < cadeia))
    _ = diag_relatar(&d, E0301, 13, "outro")
    let l2 = linha_do_diag(&d, &f, &sd)
    defer delete(l2)
    expect((not tem(l2, "\"sugestao\"")) and tem(l2, "\"causa\": \"outro\""))
    _ = diag_relatar(&d, E0706, 13, "'x' e local de 'caixa' e o endereco sai por return: x -> p -> return")
    diag_acrescentar_extra(&d, "cadeia", "[\"x (local, 2:9)\", \"p (3:9)\", \"return (4:5)\"]")
    let l3 = linha_do_diag(&d, &f, &sd)
    defer delete(l3)
    let forma3 = pos(l3, "\"forma_certa\"")
    let cadeia3 = pos(l3, "\"cadeia\": [\"x (local, 2:9)\", \"p (3:9)\", \"return (4:5)\"], \"correcao")
    expect((forma3 >= 0) and (cadeia3 >= 0) and (forma3 < cadeia3) and tem(l3, "x -> p -> return"))
}

// C: TestaDiagSugestao
test "diag: sugestoes por ocorrencia" {
    var f: Fonte = fonte_de_texto("a.fj", "proc main() {\n    var n = 3\n}\n")
    defer fonte_liberar(&f)
    var d: Diag = Diag{}
    var sd: SaidaDiag = SaidaDiag{}
    var b = make([dynamic]u8, alloc = heap)
    defer delete(b)
    for i in 0..<((DIAG_NOVO_MAX as int) + 1) {
        append(&b, item = 120)
    }
    let novo_longo = to_str(&b)
    defer delete(novo_longo)
    _ = diag_relatar(&d, E0707, 22, "'n' nunca e alterada")
    expect(not diag_editar(&d.sug, 18, 21, "let"))
    var abriu = diag_sugerir(&d.sug, DIAG_CERTA, "troque var por let") and diag_editar(&d.sug, 18, 21, "let")
    abriu = abriu and diag_sugerir(&d.sug, DIAG_SO_DICA, "ou use o valor")
    expect(abriu)
    expect(not diag_sugerir(&d.sug, DIAG_PROVAVEL, "terceira"))
    expect(not diag_editar(&d.sug, 18, 21, novo_longo))
    expect(not diag_editar(&d.sug, 0, (DIAG_ANTIGO_MAX as u32) + 1, ""))
    let l1 = linha_do_diag(&d, &f, &sd)
    defer delete(l1)
    expect(tem(l1, "\"trecho\": [\"1 | proc main() {\", \"2 |     var n = 3\", \"  |         ^\", \"3 | }\"]"))
    expect(tem(l1, "\"correcao\": [{\"arquivo\": \"a.fj\", \"linha\": 2, \"coluna\": 5, \"coluna_fim\": 8, \"antigo\": \"var\", \"novo\": \"let\"}], \"confianca\": \"certa\""))
    expect(tem(l1, "\"alternativas\": [{\"confianca\": \"so_dica\", \"sugestao\": \"ou use o valor\", \"correcao\": []}]"))
    expect(tem(l1, "\"spec\": "))
    expect(tem(l1, "\"id\": \"E0707@a.fj:2:9\"}"))
    let l2 = linha_do_diag(&d, &f, &sd)
    defer delete(l2)
    expect(tem(l2, "\"spec_ref\": \"forja explicar E0707\"") and (not tem(l2, "\"spec\": ")))
    _ = diag_relatar(&d, E0707, 22, "outra")
    let l3 = linha_do_diag(&d, &f, &sd)
    defer delete(l3)
    expect(tem(l3, "\"correcao\": [], \"confianca\": \"so_dica\"") and (not tem(l3, "\"alternativas\"")) and tem(l3, "\"id\": \"E0707@a.fj:2:9\"}"))
}

// C: TestaDiagRelacionados (partes 1 a 5)
test "diag: relacionados por ocorrencia" {
    var f: Fonte = fonte_de_texto("a.fj", "proc dobrar(x: i32) -> i32 {\n    return x\n}\n")
    defer fonte_liberar(&f)
    let off_dobrar = pos("proc dobrar(x: i32) -> i32 {\n    return x\n}\n", "dobrar") as u32
    var d: Diag = Diag{}
    var sd: SaidaDiag = SaidaDiag{}
    _ = diag_relatar(&d, E0502, 40, "x")
    var cabem = true
    for k in 0..<(DIAG_REL_MAX as int) {
        let nota = format(f"n{k}", alloc = heap)
        defer delete(nota)
        cabem = cabem and diag_relacionar(&d, DIAG_REL_PARECIDO, off_dobrar + (k as u32), nota)
    }
    expect(cabem and (not diag_relacionar(&d, DIAG_REL_PARECIDO, off_dobrar + 9, "sexto")) and ((d.rel.n as i32) == DIAG_REL_MAX))
    _ = diag_relatar(&d, E0502, 40, "x")
    expect(d.rel.n == 0)
    expect(diag_relacionar(&d, DIAG_REL_ASSINATURA, off_dobrar, "assinatura de dobrar"))
    expect(not diag_relacionar(&d, DIAG_REL_ASSINATURA, off_dobrar, "repetido"))
    expect(diag_relacionar(&d, DIAG_REL_TIPO, off_dobrar, "outro papel no mesmo offset"))
    d.rel.n = 1
    _ = diag_sugerir(&d.sug, DIAG_SO_DICA, "dica")
    let l1 = linha_do_diag(&d, &f, &sd)
    defer delete(l1)
    expect(tem(l1, "\"relacionados\": [{\"papel\": \"assinatura\", \"arquivo\": \"a.fj\", \"linha\": 1, \"coluna\": 6, \"texto\": \"proc dobrar(x: i32) -> i32\", \"nota\": \"assinatura de dobrar\"}], \"spec"))
    d.sug.n = 0
    let l2 = linha_do_diag(&d, &f, &sd)
    defer delete(l2)
    let relacionados = pos(l2, "\"relacionados\": [{\"papel\": \"assinatura\"")
    let spec = pos(l2, "\"spec")
    expect((relacionados >= 0) and (spec >= 0) and (relacionados < spec) and tem(l2, "\"correcao\": []"))
    var b = make([dynamic]u8, alloc = heap)
    defer delete(b)
    for i in 0..<299 {
        append(&b, item = 121)
    }
    let longa = to_str(&b)
    defer delete(longa)
    var f2: Fonte = fonte_de_texto("b.fj", longa)
    defer fonte_liberar(&f2)
    _ = diag_relatar(&d, E0502, 0, "x")
    _ = diag_relacionar(&d, DIAG_REL_DECLARACAO, 0, "longa")
    let l3 = linha_do_diag(&d, &f2, &sd)
    defer delete(l3)
    expect(tem(l3, "\"texto\": \"yyyyyyyyyy") and tem(l3, "yyyy...\", \"nota\": \"longa\"") and (not tem(l3, "yyyyy....")))
    _ = diag_relatar(&d, E0502, 0, "outra")
    let l4 = linha_do_diag(&d, &f2, &sd)
    defer delete(l4)
    expect((d.rel.n == 0) and tem(l4, "\"relacionados\": []"))
}

// C: TestaDiagQueda
test "diag: R0011 no catalogo" {
    var f: Fonte = fonte_de_texto("a.fj", "test \"x\" { }\n")
    defer fonte_liberar(&f)
    var d: Diag = Diag{}
    var sd: SaidaDiag = SaidaDiag{}
    _ = diag_relatar(&d, R0011, 0, "o teste \"x\" causou uma excecao do processador: acesso a memoria invalida")
    let linha = linha_do_diag(&d, &f, &sd)
    defer delete(linha)
    let catalogo = linha_do_catalogo_teste(R0011)
    defer delete(catalogo)
    expect(diag_codigo_por_texto("R0011") == R0011)
    expect(tem(linha, "\"tipo\": \"runtime\""))
    expect(tem(catalogo, "excecao do processador (acesso a memoria invalida ou instrucao ilegal)"))
    expect(tem(linha, "rawptr convertido com 'as ^T' no teste apontado"))
}

// C: TestaDiagLayout
test "diag: E0328 e E0329 no catalogo" {
    var f: Fonte = fonte_de_texto("a.fj", "static_assert(size_of(int) == 8)\n")
    defer fonte_liberar(&f)
    var d: Diag = Diag{}
    var sd: SaidaDiag = SaidaDiag{}
    _ = diag_relatar(&d, E0328, 0, "size_of(Janela): tipo opaco")
    let l1 = linha_do_diag(&d, &f, &sd)
    defer delete(l1)
    expect((diag_codigo_por_texto("E0328") == E0328) and tem(l1, "\"tipo\": \"layout\""))
    expect(tem(l1, "\"causa\": \"size_of(Janela): tipo opaco\"") and tem(l1, "offset_of(S.campo)"))
    _ = diag_relatar(&d, E0329, 0, "static_assert falhou: msg")
    let l2 = linha_do_diag(&d, &f, &sd)
    defer delete(l2)
    expect((diag_codigo_por_texto("E0329") == E0329) and tem(l2, "\"tipo\": \"layout\""))
    expect(tem(l2, "\"causa\": \"static_assert falhou: msg\"") and tem(l2, "assert(x > 0) para valor de execucao"))
}

// C: CodigoDeHigieneConfere
proc codigo_de_higiene_confere(codigo: i32, tipo: str, trecho_explicacao: str, trecho_forma: str) -> bool {
    var f: Fonte = fonte_de_texto("a.fj", "var n = 0\n")
    defer fonte_liberar(&f)
    var d: Diag = Diag{}
    var sd: SaidaDiag = SaidaDiag{}
    let esperado = format(f"\"tipo\": \"{tipo}\"", alloc = heap)
    defer delete(esperado)
    _ = diag_relatar(&d, codigo, 0, "causa de teste")
    let linha = linha_do_diag(&d, &f, &sd)
    defer delete(linha)
    let catalogo = linha_do_catalogo_teste(codigo)
    defer delete(catalogo)
    return (diag_codigo_por_texto(diag_codigo_texto(codigo)) == codigo) and tem(linha, esperado) and tem(linha, "\"causa\": \"causa de teste\"") and tem(catalogo, trecho_explicacao) and tem(linha, trecho_forma)
}

// C: TestaDiagHigiene
test "diag: codigos da higiene no catalogo" {
    expect(codigo_de_higiene_confere(E0707, "fluxo", "nunca e alterada", "troque var por let"))
    expect(codigo_de_higiene_confere(E0708, "fluxo", "nunca e lido", "_ = registrar(x) para descartar um retorno"))
    expect(codigo_de_higiene_confere(E0709, "fluxo", "nao some em silencio", "_ = puts("))
    expect(codigo_de_higiene_confere(E1005, "modulo", "apelido nunca aparece", "remova a linha do import"))
    expect(codigo_de_higiene_confere(E0707, "fluxo", "vale pela declaracao inteira", "var n = 0"))
    expect(codigo_de_higiene_confere(E0708, "fluxo", "(_r, _unused)", "let _r = f() para guardar sem ler"))
    expect(codigo_de_higiene_confere(E0709, "fluxo", "'_ = try f()'", "_ = try ler(f)"))
    expect(codigo_de_higiene_confere(E0601, "resultado", "tratado", "_ = try f() (repassa o erro e descarta o valor)"))
    expect(codigo_de_higiene_confere(E1006, "modulo", "palavra reservada", "as <nome>"))
}

// C: TestaDiagLista
test "diag: ordem estavel e teto da lista" {
    var l: DiagLista = DiagLista{}
    var d: Diag = Diag{}
    guardar_de_teste(&l, 1, 5, "e")
    guardar_de_teste(&l, 0, 9, "a")
    guardar_de_teste(&l, 1, 2, "d")
    guardar_de_teste(&l, 0, 9, "b")
    diag_lista_ordenar(&l)
    expect(l.n == 4)
    expect((l.itens[0].causa or_else "") == "a")
    expect((l.itens[1].causa or_else "") == "b")
    expect((l.itens[2].causa or_else "") == "d")
    expect((l.itens[3].causa or_else "") == "e")
    l = DiagLista{}
    l.teto = 2
    guardar_de_teste(&l, 0, 1, "x")
    guardar_de_teste(&l, 0, 2, "y")
    let cabe_antes = (l.n == 2) and (not l.cortado)
    _ = diag_relatar(&d, E0201, 3, "z")
    let recusou = (not diag_lista_guardar(&l, &d, 0)) and (not d.tem) and (l.n == 2) and l.cortado
    l = DiagLista{}
    for k in 0..<25 {
        guardar_de_teste(&l, 0, k as u32, "p")
    }
    expect(cabe_antes and recusou)
    expect((l.n == (DIAG_TETO_PADRAO as u32)) and l.cortado)
}

// C: TestaDiagCalado
test "diag: diagnostico calado nao entra na lista" {
    var l: DiagLista = DiagLista{}
    var d: Diag = Diag{}
    l.teto = 1
    _ = diag_relatar(&d, E0301, 1, "cascata")
    d.calado = true
    let silenciou = diag_lista_guardar(&l, &d, 0) and (not d.tem) and (not d.calado) and (l.n == 0) and (not l.cortado)
    _ = diag_relatar(&d, E0201, 2, "origem")
    d.calado = true
    _ = diag_relatar(&d, E0201, 3, "origem")
    let entrou = diag_lista_guardar(&l, &d, 0) and (l.n == 1) and (l.itens[0].off == 3) and (not l.itens[0].calado)
    expect(silenciou and entrou and (not l.cortado))
}
