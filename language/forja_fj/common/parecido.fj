pub struct ParecidoNome {
    texto: ?str
    tam: u64
    distancia: u32
    pos: u32
}

pub struct Parecidos {
    alvo: ?str
    tam_alvo: u64
    limite: u32
    qtd: u32
    nomes: [3]ParecidoNome
}

const PARECIDO_DIST_MAX: i32 = 2
const PARECIDOS_MAX: i32 = 3
const PARECIDO_TAM: i32 = 64
const PARECIDO_LONGE: u32 = 1000
pub const PARECIDO_SEM_POS: u32 = 4294967295

// C: common/parecido.c:11
proc menor(x: u32, y: u32) -> u32 {
    return min(x, y)
}

// C: common/parecido.c:14
proc eh_transposicao(a: ?str, b: ?str, i: u64, j: u64) -> bool {
    return (((i > 1) and (j > 1)) and (c2f_char_i32((a or_else "")[i - 1]) == c2f_char_i32((b or_else "")[j - 2]))) and (c2f_char_i32((a or_else "")[i - 2]) == c2f_char_i32((b or_else "")[j - 1]))
}

// C: common/parecido.c:19
proc celula_parecido(m: [][65]u32, a: ?str, b: ?str, i: u64, j: u64) -> u32 {
    var tern_1: i32 = 1
    if c2f_char_i32((a or_else "")[i - 1]) == c2f_char_i32((b or_else "")[j - 1]) {
        tern_1 = 0
    }
    let custo: u32 = c2f_s2u_32(tern_1)
    let arg_1: u32 = m[i - 1][j - 1] + custo
    let arg_2: u32 = menor(m[i - 1][j] + 1, m[i][j - 1] + 1)
    var v: u32 = menor(arg_2, arg_1)
    if eh_transposicao(a, b, i, j) {
        v = menor(v, m[i - 2][j - 2] + 1)
    }
    return v
}

// C: common/parecido.c:27
proc parecido(a: ?str, na: u64, b: ?str, nb: u64) -> u32 {
    var m: [65][65]u32 = {}
    if (na > (PARECIDO_TAM as u64)) or (nb > (PARECIDO_TAM as u64)) {
        return PARECIDO_LONGE
    }
    for i in (0 as u64)..=na {
        m[i][0] = i as u32
    }
    for j in (0 as u64)..=nb {
        m[0][j] = j as u32
    }
    for i in (1 as u64)..=na {
        for j in (1 as u64)..=nb {
            m[i][j] = celula_parecido(m[..], a, b, i, j)
        }
    }
    return m[na][nb]
}

// C: common/parecido.c:40
proc compara_nomes(a: ^ParecidoNome, b: ^ParecidoNome) -> i32 {
    var m: u64 = b.tam
    if a.tam < b.tam {
        m = a.tam
    }
    let c: i32 = c2f_memcmp(as_bytes(a.texto or_else "")[0..<m], as_bytes(b.texto or_else "")[0..<m])
    if c != 0 {
        return c
    }
    if a.tam < b.tam {
        return -1
    }
    return c2f_b2i32(a.tam > b.tam)
}

// C: common/parecido.c:48
proc parecido_antes(a: ^ParecidoNome, b: ^ParecidoNome) -> bool {
    if a.distancia != b.distancia {
        return a.distancia < b.distancia
    }
    return compara_nomes(a, b) < 0
}

// C: common/parecido.c:54
proc parecido_inserir(p: ^Parecidos, novo: ParecidoNome) {
    var novo_v: ParecidoNome = novo
    let antes_1: u32 = p.qtd
    p.qtd += 1
    var i: u32 = antes_1
    while (i > 0) and (c2f_b2i32(parecido_antes(&novo_v, &p.nomes[i - 1])) != 0) {
        p.nomes[i] = p.nomes[i - 1]
        i -= 1
    }
    p.nomes[i] = novo_v
}

// C: common/parecido.c:64
pub proc parecidos_iniciar(p: ^Parecidos, alvo: str, tam: u64) {
    let tercos: u64 = tam / 3
    p.alvo = alvo
    p.tam_alvo = tam
    var limite: u32 = 1
    if tercos > (PARECIDO_DIST_MAX as u64) {
        limite = PARECIDO_DIST_MAX as u32
    } else if tercos >= 1 {
        limite = tercos as u32
    }
    p.limite = limite
    p.qtd = 0
}

// C: common/parecido.c:73
proc parecidos_ver(p: ^Parecidos, nome: str, tam: u64) {
    parecidos_ver_em(p, nome, tam, PARECIDO_SEM_POS)
}

// C: common/parecido.c:78
pub proc parecidos_ver_em(p: ^Parecidos, nome: str, tam: u64, pos: u32) {
    var novo: ParecidoNome = ParecidoNome{texto = nome, tam = tam, distancia = parecido(p.alvo, p.tam_alvo, nome, tam), pos = pos}
    if (novo.distancia == 0) or (novo.distancia > p.limite) {
        return
    }
    if p.qtd == (PARECIDOS_MAX as u32) {
        if not parecido_antes(&novo, &p.nomes[PARECIDOS_MAX - 1]) {
            return
        }
        p.qtd -= 1
    }
    parecido_inserir(p, novo)
}

// Do TestaParecido do teste_common.c (v1.11 L5): transposicao conta 1, lista vazia, empate ordena pelo nome, limite = min(2, max(1, len/3)); mais o limite de 64 bytes
test "parecido" {
    var p: Parecidos = Parecidos{}
    expect(parecido("vida", 4, "vdia", 4) == 1)
    expect(parecido("", 0, "ab", 2) == 2)
    expect(parecido("kitten", 6, "sitting", 7) == 3)
    parecidos_iniciar(&p, "vida", 4)
    expect(p.qtd == 0)
    parecidos_iniciar(&p, "abcdef", 6)
    parecidos_ver(&p, "abcdez", 6)
    parecidos_ver(&p, "abcdeg", 6)
    expect(p.qtd == 2 and (p.nomes[0].texto or_else "") == "abcdeg" and (p.nomes[1].texto or_else "") == "abcdez")
    parecidos_iniciar(&p, "vida", 4)
    parecidos_ver(&p, "vidaxx", 6)
    parecidos_ver(&p, "vidas", 5)
    expect(p.qtd == 1 and (p.nomes[0].texto or_else "") == "vidas")
    parecidos_ver_em(&p, "vidas", 5, 7)
    expect(p.nomes[0].pos == PARECIDO_SEM_POS or p.nomes[0].pos == 7)
    var longo: [65]u8 = {}
    for i in 0..<65 {
        longo[i] = 97
    }
    let nome_longo: str = from_bytes(longo[..], alloc = heap)
    expect(parecido(nome_longo, 65, "a", 1) == PARECIDO_LONGE)
    expect(parecido(nome_longo, 64, nome_longo, 64) == 0)
    delete(nome_longo)
}
