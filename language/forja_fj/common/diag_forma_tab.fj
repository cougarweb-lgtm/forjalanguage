const FORMAS_DA_CAUSA: [121]FormaDaCausa = {
    // ---- E0308: array, fatia, lista ----
    FormaDaCausa{codigo = E0308, trecho_da_causa = "array nao tem campo", explicacao = "Na $O a linha '$L' le um campo de um array; array nao tem campo, so os elementos (e x, y, z, w nos de 2 a 4 numeros).", forma = "Indexe o elemento na linha '$L': a[0], a[1]...; as letras x y z w valem so em array de 2 a 4 numeros, e matrix[R, C]T usa m[i, j]."},
    FormaDaCausa{codigo = E0308, trecho_da_causa = "lista nao tem campo", explicacao = "Na $O a linha '$L' le um campo de uma lista; lista nao tem campo.", forma = "Leia pelo indice (l[0]) ou pelo tamanho len(l) na linha '$L'; para percorrer escreva for x in l."},
    FormaDaCausa{codigo = E0308, trecho_da_causa = "faixa em campo struct", explicacao = "Na $O o campo '$L' declara uma faixa (in a..b) sobre uma struct, e a faixa so vale em campo numerico.", forma = "Tire a faixa (in a..b) da linha '$L' e ponha a faixa nos campos numericos da struct de dentro."},
    FormaDaCausa{codigo = E0308, trecho_da_causa = "faixa em campo array", explicacao = "Na $O o campo '$L' declara uma faixa (in a..b) sobre um array; a faixa vale so em campo numerico unico.", forma = "Tire a faixa do campo '$L' e confira os elementos com assert onde forem gravados, ou ponha a faixa num struct do elemento."},
    FormaDaCausa{codigo = E0308, trecho_da_causa = "faixa em campo", explicacao = "Na $O o campo '$L' declara uma faixa (in a..b) num tipo que nao a aceita.", forma = "Tire a faixa da linha '$L' e confira o valor com assert onde ele for gravado."},
    FormaDaCausa{codigo = E0308, trecho_da_causa = "for de item percorre", explicacao = "Na $O o for de '$L' nao percorre o que vem depois de 'in': $C.", forma = "Para contar escreva for i in 0..<n na linha '$L'; para percorrer elementos o valor depois de 'in' precisa ser array, fatia ou lista."},
    FormaDaCausa{codigo = E0308, trecho_da_causa = "pede array, fatia, lista", explicacao = "Na $O a linha '$L' indexa com [ ] um valor que nao e array, fatia, lista nem ponteiro para eles ($C).", forma = "Indexe so array, fatia ou lista na linha '$L': declare o valor como [N]T ou [dynamic]T, ou tire o indice."},
    FormaDaCausa{codigo = E0308, trecho_da_causa = "indice duplo", explicacao = "Na $O a linha '$L' usa um indice duplo a[i, j], que so existe em matrix[R, C]T.", forma = "Use um indice por vez (a[i]) na linha '$L', ou declare o valor como matrix[R, C]T para usar m[i, j]."},
    FormaDaCausa{codigo = E0308, trecho_da_causa = "len de array e constante", explicacao = "Na $O o len da linha '$L' recebe uma chamada; o len de array e constante e nao avalia o argumento.", forma = "Guarde o valor numa variavel antes (let v = <a chamada>) e escreva len(v) na linha '$L'."},
    FormaDaCausa{codigo = E0308, trecho_da_causa = "precisa ser um literal inteiro", explicacao = "Na $O o tamanho do array da linha '$L' vem de uma const que nao e um literal inteiro puro.", forma = "Escreva a const com literal inteiro (sem conta) ou ponha o literal direto no tamanho, na linha '$L'."},
    FormaDaCausa{codigo = E0308, trecho_da_causa = "o tamanho do array", explicacao = "Na $O o tamanho do array da linha '$L' nao e literal inteiro nem const inteira.", forma = "Escreva um literal inteiro ou uma const inteira maior que zero como tamanho na linha '$L' ([4]T), ou use uma lista [dynamic]T."},
    FormaDaCausa{codigo = E0308, trecho_da_causa = "tamanho 0", explicacao = "Na $O a linha '$L' declara um array de tamanho 0, que a Forja nao tem.", forma = "Escreva um tamanho maior que zero na linha '$L' ([1]T ou mais) ou, para tamanho variavel, uma lista [dynamic]T."},
    FormaDaCausa{codigo = E0308, trecho_da_causa = "tamanho maximo", explicacao = "Na $O o array da linha '$L' passa do tamanho maximo permitido ($C).", forma = "Use um array menor na linha '$L' ou uma lista [dynamic]T (make com alloc = heap), que cresce no heap."},
    FormaDaCausa{codigo = E0308, trecho_da_causa = "T ! E' nao existe", explicacao = "Na $O a linha '$L' declara uma colecao de 'T ! E', que nao existe.", forma = "Guarde o valor ou o erro em campos separados na linha '$L' (um [N]T e um ?E, por exemplo)."},
    FormaDaCausa{codigo = E0308, trecho_da_causa = "Enum]T", explicacao = "Na $O a linha '$L' usa um enum como tamanho do array, o que ficou para depois da v1.9.", forma = "Escreva [N]T com uma const N, ou map[Enum]T, na linha '$L'."},
    FormaDaCausa{codigo = E0308, trecho_da_causa = "lista nao tem ==", explicacao = "Na $O a linha '$L' compara duas listas com ==, != ou ordem, que lista nao tem.", forma = "Compare elemento a elemento: troque a comparacao da linha '$L' por um for que testa cada par de elementos."},
    FormaDaCausa{codigo = E0308, trecho_da_causa = "array e fatia nao tem ==", explicacao = "Na $O a linha '$L' compara array ou fatia com ==, != ou ordem, que eles nao tem.", forma = "Compare elemento a elemento: troque a comparacao da linha '$L' por um for i, x in <array> que testa cada elemento."},
    // ---- E0306: ponteiro ----
    FormaDaCausa{codigo = E0306, trecho_da_causa = "ponteiro nao tem conta", explicacao = "Na $O a conta da linha '$L' soma ou subtrai com um ponteiro; a Forja nao tem aritmetica de ponteiro.", forma = "Para andar numa sequencia use fatia e indice (s[i]) na linha '$L'; para o valor apontado escreva p^ (ou p.campo)."},
    FormaDaCausa{codigo = E0306, trecho_da_causa = "nao troca o tipo apontado", explicacao = "Na $O a linha '$L' troca o tipo apontado de um ponteiro direto com 'as'; a Forja so troca passando por rawptr.", forma = "Passe pelo rawptr na linha '$L': escreva (<o ponteiro> as rawptr) as ^<o outro tipo>."},
    FormaDaCausa{codigo = E0306, trecho_da_causa = "desreferencia um nivel so", explicacao = "Na $O a linha '$L' usa '.' sobre um ponteiro de ponteiro, e o '.' desreferencia um nivel so.", forma = "Escreva $2 na linha '$L': o '^' desreferencia o primeiro nivel antes do campo."},
    FormaDaCausa{codigo = E0306, trecho_da_causa = "campo de '?^", explicacao = "Na $O a linha '$L' le um campo de um ponteiro anulavel ($1), que pode estar em none.", forma = "Teste contra none e converta antes de ler o campo da linha '$L' ($2), ou use switch sobre o ponteiro com case none."},
    FormaDaCausa{codigo = E0306, trecho_da_causa = "pode ser none", explicacao = "Na $O a linha '$L' le ($1) um ponteiro anulavel, que pode ser none.", forma = "Teste $2 (com o nome do ponteiro) e converta com as ^<tipo> antes de ler na linha '$L', ou use switch sobre o ponteiro com case none."},
    FormaDaCausa{codigo = E0306, trecho_da_causa = "rawptr nao tem tipo apontado", explicacao = "Na $O a linha '$L' le um rawptr, que nao sabe o tipo apontado.", forma = "Converta com as ^<tipo> antes de ler na linha '$L' (teste contra none se o rawptr vier do C)."},
    FormaDaCausa{codigo = E0306, trecho_da_causa = "cstr nao se desreferencia", explicacao = "Na $O a linha '$L' desreferencia um cstr; cstr e o texto do C, nao um ponteiro que se leia com ^.", forma = "Converta para str na linha '$L' com <o cstr> as str e use a str."},
    FormaDaCausa{codigo = E0306, trecho_da_causa = "depois de um valor que nao e ponteiro", explicacao = "Na $O a linha '$L' usa '^' num valor que nao e ponteiro ($C).", forma = "Tire o '^' da linha '$L' (o valor ja e o proprio dado) ou declare o valor como ponteiro e passe o endereco com &."},
    FormaDaCausa{codigo = E0306, trecho_da_causa = "nunca e none", explicacao = "Na $O a linha '$L' guarda none num ponteiro '^T', que nunca e nulo.", forma = "Declare o ponteiro como ?^<tipo> para aceitar none, ou aponte para um valor real com & (linha '$L')."},
    FormaDaCausa{codigo = E0306, trecho_da_causa = "none precisa de um tipo", explicacao = "Na $O o none da linha '$L' nao tem tipo: o contexto nao diz se e ?T, ?^T ou rawptr.", forma = "De o tipo na declaracao da linha '$L' (let a: ?<tipo> = none) ou so compare com none em vez de guardar none solto."},
    FormaDaCausa{codigo = E0306, trecho_da_causa = "ponteiro nao tem ordem", explicacao = "Na $O a linha '$L' ordena ponteiros com < > <= >=; ponteiro so se compara com == e !=.", forma = "Compare os valores apontados (p^ < q^) ou so a igualdade dos enderecos, na linha '$L'."},
    FormaDaCausa{codigo = E0306, trecho_da_causa = "nao vira numero", explicacao = "Na $O a linha '$L' converte entre ponteiro e numero com 'as', o que a Forja nao permite.", forma = "Handle de C: use rawptr ou ^T no foreign, ou transmute(x, to = u64) (so rawptr <-> int/uint de 64 bits); valor apontado: p^. Linha '$L'."},
    // ---- E0307: texto ----
    FormaDaCausa{codigo = E0307, trecho_da_causa = "compararia enderecos", explicacao = "Na $O a linha '$L' compara dois cstr com ==, o que compararia enderecos e nao o texto.", forma = "Converta os dois lados para str na linha '$L': (<um cstr> as str) == (<o outro> as str)."},
    FormaDaCausa{codigo = E0307, trecho_da_causa = "len de cstr", explicacao = "Na $O o len da linha '$L' recebe um cstr; contar ate o NUL exigiria varrer o texto.", forma = "Converta antes na linha '$L': len(<o cstr> as str)."},
    FormaDaCausa{codigo = E0307, trecho_da_causa = "nao se soma", explicacao = "Na $O a linha '$L' soma texto com '+', e str nao tem conta: juntar textos precisa alocar.", forma = "Em print junte num f\"...\" (f\"{x}{y}\" com os nomes da linha '$L'); para guardar o texto use format(f\"...\", alloc = heap) e delete depois."},
    FormaDaCausa{codigo = E0307, trecho_da_causa = "str nao tem ordem", explicacao = "Na $O a linha '$L' ordena str com < > <= >=, que a Forja nao tem nesta versao.", forma = "Compare so com == ou != na linha '$L', ou compare o tamanho com len."},
    FormaDaCausa{codigo = E0307, trecho_da_causa = "str nao termina em NUL", explicacao = "Na $O a linha '$L' converte str em cstr com 'as', mas str nao termina em NUL e converter precisa alocar.", forma = "Use format_c(f\"...\", alloc = heap) na linha '$L' para um cstr novo (e delete depois); para literal escreva let c: cstr = \"...\"."},
    // ---- E0301: busca de texto com value que nao e str (S2a) ----
    FormaDaCausa{codigo = E0301, trecho_da_causa = "de str pede value str", explicacao = "Na $O a chamada da linha '$L' passa a busca de texto um value que nao e str: a busca em str compara texto com texto, por bytes.", forma = "Passe value = <texto> na chamada da linha '$L'; para um byte so, use text.index_byte."},
    // ---- E0503: argumento ou campo que falta ----
    FormaDaCausa{codigo = E0503, trecho_da_causa = "falta o argumento 'to'", explicacao = "Na $O o transmute da linha '$L' nao diz o tipo de destino.", forma = "Acrescente to = <tipo> no transmute da linha '$L', com um tipo do mesmo tamanho do valor."},
    FormaDaCausa{codigo = E0503, trecho_da_causa = "falta o argumento 'alloc'", explicacao = "Na $O a chamada da linha '$L' nao diz de onde vem a memoria: o proc recebe alloc: Allocator e o chamador sempre escolhe o alocador.", forma = "Acrescente alloc = heap no fim da chamada da linha '$L' (ou alloc = frame, uma Arena, ou o seu proprio alloc = alloc)."},
    FormaDaCausa{codigo = E0503, trecho_da_causa = "falta o argumento", explicacao = "Na $O a chamada da linha '$L' nao passa o argumento '$1', que nao tem valor padrao.", forma = "Passe $1 = <valor> na chamada da linha '$L' (depois dos argumentos posicionais), ou de um valor padrao ao parametro '$1' no proc."},
    FormaDaCausa{codigo = E0503, trecho_da_causa = "falta o campo", explicacao = "Na $O o literal da linha '$L' deixa sem valor o campo '$1', e esse campo nao tem valor zero.", forma = "Escreva $1 = <valor> no literal da linha '$L' (campo ^T e union nao tem valor zero), ou declare o campo '$1' como ?^T para aceitar none."},
    FormaDaCausa{codigo = E0503, trecho_da_causa = "falta", explicacao = "Na $O a linha '$L' deixa de passar um valor obrigatorio ($C).", forma = "Complete a linha '$L' com o valor que falta."},
    // ---- E0504: nome que nao existe ----
    FormaDaCausa{codigo = E0504, trecho_da_causa = "o proc nao tem o parametro", explicacao = "Na $O a chamada da linha '$L' passa '$1 = ...', mas o proc nao tem parametro com esse nome.", forma = "Troque '$1' por um parametro do proc (os parecidos aparecem na causa) ou tire o '$1 = ' da chamada da linha '$L'."},
    FormaDaCausa{codigo = E0504, trecho_da_causa = "a struct nao tem o campo", explicacao = "Na $O o literal da linha '$L' escreve o campo '$1', que a struct nao declara.", forma = "Troque '$1' por um campo declarado na struct, ou declare o campo '$1' nela."},
    FormaDaCausa{codigo = E0504, trecho_da_causa = "transmute nao tem o parametro", explicacao = "Na $O o transmute da linha '$L' nomeia um argumento '$1', que ele nao tem.", forma = "Escreva transmute(<valor>, to = <tipo>) na linha '$L': o unico argumento nomeado e 'to'."},
    FormaDaCausa{codigo = E0504, trecho_da_causa = "recebe so", explicacao = "Na $O a chamada da linha '$L' passa argumento a mais ($C).", forma = "Tire o argumento extra da chamada da linha '$L'."},
    FormaDaCausa{codigo = E0504, trecho_da_causa = "so recebe", explicacao = "Na $O a chamada da linha '$L' passa argumento a mais ($C).", forma = "Tire o argumento extra da chamada da linha '$L'."},
    // ---- E0601: resultado ignorado ----
    FormaDaCausa{codigo = E0601, trecho_da_causa = "nao se descarta com", explicacao = "Na $O a linha '$L' descarta com '_ =' um resultado 'T ! E'; o erro nao pode sumir.", forma = "Repasse o erro e descarte so o valor: escreva _ = try <a chamada> na linha '$L', num proc cujo retorno e '! E'; ou trate com or_else ou switch."},
    FormaDaCausa{codigo = E0601, trecho_da_causa = "foi ignorado", explicacao = "Na $O a linha '$L' chama '$1', que devolve um resultado ('T ! E'), e ignora o resultado: o erro precisa ser tratado.", forma = "Guarde com let r = $1(...) e trate com switch, ou escreva $1(...) or_else <valor padrao>, ou try $1(...) num proc cujo retorno e '! E'."},
    // ---- E0607: switch incompleto ----
    FormaDaCausa{codigo = E0607, trecho_da_causa = "nao cobre o membro", explicacao = "Na $O o switch da linha '$L' nao trata o membro '$1' do enum '$2'.", forma = "Acrescente 'case $2.$1:' ao switch da linha '$L' (ou um 'default:' que cubra o resto)."},
    FormaDaCausa{codigo = E0607, trecho_da_causa = "nao cobre a variante", explicacao = "Na $O o switch da linha '$L' nao trata a variante '$1' da union '$2'.", forma = "Acrescente 'case $1:' ao switch da linha '$L' (ou um 'default:' que cubra o resto)."},
    FormaDaCausa{codigo = E0607, trecho_da_causa = "sobre resultado", explicacao = "Na $O o switch da linha '$L' sobre um resultado nao cobre o valor e o erro.", forma = "Acrescente os dois case ao switch da linha '$L' (o do tipo do valor e o do enum de erro); em '! E' o lado do valor so se cobre com 'default:'."},
    FormaDaCausa{codigo = E0607, trecho_da_causa = "o switch sobre", explicacao = "Na $O o switch da linha '$L' sobre um opcional nao cobre os dois casos: o valor e o none.", forma = "Acrescente 'case none:' e o case do tipo do valor ao switch da linha '$L' (ou um 'default:')."},
    // ---- E0310: memoria explicita ----
    FormaDaCausa{codigo = E0310, trecho_da_causa = "append recebe o endereco da lista", explicacao = "Na $O o append da linha '$L' recebe a lista por valor, mas append altera a lista e pede o endereco dela.", forma = "Escreva & antes da lista no append da linha '$L' (append(&lista, item = x)); a lista precisa ser var."},
    FormaDaCausa{codigo = E0310, trecho_da_causa = "append recebe o endereco da soa", explicacao = "Na $O o append da linha '$L' recebe a soa por valor, mas append altera e pede o endereco.", forma = "Escreva & antes do primeiro argumento do append da linha '$L'; a soa precisa ser var."},
    FormaDaCausa{codigo = E0310, trecho_da_causa = "append pede", explicacao = "Na $O o append da linha '$L' recebe algo que nao e lista nem soa dinamica ($C).", forma = "Passe no append da linha '$L' o endereco de uma lista [dynamic]T ou de uma soa[dynamic]S (&lista)."},
    FormaDaCausa{codigo = E0310, trecho_da_causa = "veio de um proc foreign", explicacao = "Na $O o delete da linha '$L' libera '$1', que veio de um proc foreign: a memoria e emprestada da biblioteca C.", forma = "Tire o delete de '$1' na linha '$L'; se a biblioteca pede para liberar, chame a funcao de liberar dela."},
    FormaDaCausa{codigo = E0310, trecho_da_causa = "guarda um texto literal", explicacao = "Na $O o delete da linha '$L' libera '$1', que guarda um texto literal e nao veio de format.", forma = "Tire o delete de '$1' na linha '$L': so se libera o que veio de format ou format_c com alloc = heap."},
    FormaDaCausa{codigo = E0310, trecho_da_causa = "objeto de Arena", explicacao = "Na $O o delete da linha '$L' libera um objeto de Arena um a um, o que a Arena nao faz.", forma = "Tire o delete da linha '$L' e libere tudo de uma vez com arena_reset ou arena_destroy."},
    FormaDaCausa{codigo = E0310, trecho_da_causa = "objeto de Pool volta", explicacao = "Na $O o delete da linha '$L' libera um objeto de Pool sem dizer o pool.", forma = "Escreva delete($T, alloc = <o pool do new>) na linha '$L'."},
    FormaDaCausa{codigo = E0310, trecho_da_causa = "so recebe um Pool", explicacao = "Na $O o delete da linha '$L' passa 'alloc =' com algo que nao e Pool; so objeto de Pool leva 'alloc' no delete.", forma = "Tire o 'alloc = ...' do delete da linha '$L' (memoria de heap se libera so com delete)."},
    FormaDaCausa{codigo = E0310, trecho_da_causa = "delete de texto literal", explicacao = "Na $O o delete da linha '$L' tenta liberar um texto literal, que vive no proprio programa.", forma = "Tire o delete da linha '$L': so se libera o que veio de format ou format_c com alloc = heap."},
    FormaDaCausa{codigo = E0310, trecho_da_causa = "apaga a lista apontada", explicacao = "Na $O o delete da linha '$L' libera um ponteiro para lista, mas o ponteiro nao veio de new.", forma = "Apague a lista apontada na linha '$L' com delete(<ponteiro>^), e nao o ponteiro."},
    FormaDaCausa{codigo = E0310, trecho_da_causa = "delete pede", explicacao = "Na $O o delete da linha '$L' recebe um valor que nao e ponteiro de new nem lista ($C).", forma = "Passe ao delete da linha '$L' um ponteiro vindo de new ou uma lista [dynamic]T; valor simples nao se libera, entao tire o delete."},
    FormaDaCausa{codigo = E0310, trecho_da_causa = "alloc recebe heap", explicacao = "Na $O o 'alloc' da linha '$L' recebeu algo que nao e alocador ($C).", forma = "Escreva heap, frame, scope, ou uma Arena ou Pool (import \"std:mem\") no 'alloc' da linha '$L'."},
    FormaDaCausa{codigo = E0310, trecho_da_causa = "precisa ser guardado", explicacao = "Na $O a chamada da linha '$L' aloca memoria e joga o resultado fora; ninguem mais consegue libera-la.", forma = "Guarde o resultado na linha '$L' (let x = <a chamada>) e libere com delete(x) quando acabar."},
    FormaDaCausa{codigo = E0310, trecho_da_causa = "make de fatia", explicacao = "Na $O a linha '$L' faz make de uma fatia, que nao existe: fatia empresta memoria, nao a possui.", forma = "Crie a lista com make([dynamic]T, alloc = heap) na linha '$L' e empreste uma fatia dela com l[..]."},
    FormaDaCausa{codigo = E0310, trecho_da_causa = "new([dynamic]T)", explicacao = "Na $O a linha '$L' usa new numa lista; a lista ja guarda os elementos fora do proprio valor.", forma = "Use make([dynamic]T, alloc = heap) no lugar de new na linha '$L'."},
    FormaDaCausa{codigo = E0310, trecho_da_causa = "nao tem valor zero e new", explicacao = "Na $O a linha '$L' faz new de um tipo sem valor zero (ponteiro ^T ou union), e new cria o valor zero.", forma = "Guarde o ponteiro como ?^T ou ponha-o num struct com padrao; para union, crie o valor direto da variante em vez de new."},
    FormaDaCausa{codigo = E0310, trecho_da_causa = "Pool so serve new", explicacao = "Na $O a linha '$L' usa um Pool com make ou format, mas Pool so serve para new.", forma = "Use heap, frame, scope ou uma Arena no 'alloc' da linha '$L', ou troque a chamada por new com o Pool."},
    // ---- nomes: E0201, E0202, E0102, E1003 ----
    FormaDaCausa{codigo = E0201, trecho_da_causa = "nao declarado como variavel", explicacao = "Na $O o nome '$1' da linha '$L' nao foi declarado antes do uso como variavel ou constante.", forma = "Declare '$1' antes dessa linha (let $1 = <valor>) ou corrija a grafia; os nomes parecidos aparecem na causa."},
    FormaDaCausa{codigo = E0201, trecho_da_causa = "proc '", explicacao = "Na $O a linha '$L' chama o proc '$1', que nao foi declarado.", forma = "Declare proc $1(...) antes do uso ou corrija o nome na linha '$L'."},
    FormaDaCausa{codigo = E0201, trecho_da_causa = "tipo '", explicacao = "Na $O a linha '$L' usa o tipo '$1', que nao foi declarado.", forma = "Declare struct $1 { ... } (ou enum $1 { ... }) antes do uso, ou corrija o nome do tipo na linha '$L'."},
    FormaDaCausa{codigo = E0201, trecho_da_causa = "nao tem o campo", explicacao = "Na $O a linha '$L' le o campo '$2', que a struct '$1' nao declara.", forma = "Troque '$2' por um campo de '$1' (os parecidos aparecem na causa) ou declare o campo '$2' na struct."},
    FormaDaCausa{codigo = E0201, trecho_da_causa = "nao tem o membro", explicacao = "Na $O a linha '$L' usa o membro '$2', que o enum '$1' nao declara.", forma = "Troque '$2' por um membro de '$1' (os parecidos aparecem na causa) ou declare '$2' no enum."},
    FormaDaCausa{codigo = E0201, trecho_da_causa = "falta 'proc main()", explicacao = "Na $O o arquivo raiz nao tem o proc main sem parametros e sem retorno, que e o ponto de entrada.", forma = "Escreva proc main() { ... } no arquivo raiz."},
    FormaDaCausa{codigo = E0201, trecho_da_causa = "pedido em valor que nao e struct", explicacao = "Na $O a linha '$L' le o campo '$1' de um valor que nao e struct.", forma = "Leia '$1' de uma struct, ou tire o '.$1' da linha '$L' se o valor ja e o que voce quer."},
    FormaDaCausa{codigo = E0202, trecho_da_causa = "e reservado pela linguagem", explicacao = "Na $O o nome '$1' da linha '$L' e reservado pela linguagem e nao pode ser declarado de novo.", forma = "Escolha outro nome para '$1' na linha '$L'; para uma funcao C com esse nome, declare dentro do foreign um alias: proc c_$1 = \"$1\"(...)."},
    FormaDaCausa{codigo = E0202, trecho_da_causa = "nao tem sombra", explicacao = "Na $O a linha '$L' declara '$1', que ja existe neste proc, e a Forja nao tem sombra.", forma = "Escolha outro nome para a variavel nova da linha '$L', ou reuse '$1' com uma atribuicao (se for var)."},
    FormaDaCausa{codigo = E0202, trecho_da_causa = "ja foi declarado no modulo", explicacao = "Na $O o nome '$1' da linha '$L' ja foi declarado em outro modulo do programa; nomes de topo sao unicos no programa inteiro.", forma = "Renomeie '$1' em um dos dois modulos."},
    FormaDaCausa{codigo = E0202, trecho_da_causa = "apelido de um import", explicacao = "Na $O a linha '$L' usa '$1', que ja e o apelido de um import deste arquivo.", forma = "Escolha outro nome para '$1' na linha '$L', ou troque o apelido do import com as."},
    FormaDaCausa{codigo = E0202, trecho_da_causa = "com outra assinatura", explicacao = "Na $O a linha '$L' declara um proc foreign para um simbolo C que ja foi declarado com outra assinatura ($C).", forma = "Na linha '$L' deixe a mesma aridade e a mesma ABI da outra declaracao (inteiros do mesmo tamanho; ponteiro, rawptr e cstr contam como inteiro de 64 bits; f32 e f64 a parte), ou use outro simbolo C."},
    FormaDaCausa{codigo = E0202, trecho_da_causa = "simbolo C", explicacao = "Na $O a linha '$L' escolhe um nome que colide com o simbolo C de um alias de foreign ($C).", forma = "Use outro nome na linha '$L'; so um proc foreign sem alias pode ter o nome de um simbolo C que ja tem alias."},
    FormaDaCausa{codigo = E0202, trecho_da_causa = "repete o valor", explicacao = "Na $O o membro '$1' da linha '$L' repete o valor de '$2', e dois nomes com o mesmo valor colidem no switch.", forma = "Use o membro '$2' no lugar de '$1', ou ponha outro valor em '$1' na linha '$L'."},
    FormaDaCausa{codigo = E0202, trecho_da_causa = "ja existe no", explicacao = "Na $O a linha '$L' repete o nome '$1', que ja foi declarado no mesmo grupo (membro, campo, parametro ou elemento).", forma = "Renomeie um dos dois '$1' ou tire o repetido na linha '$L'."},
    FormaDaCausa{codigo = E0202, trecho_da_causa = "ja foi declarado", explicacao = "Na $O a linha '$L' declara '$1', que ja foi declarado antes; a Forja nao tem sobrecarga.", forma = "Escolha outro nome para '$1' na linha '$L'."},
    FormaDaCausa{codigo = E0102, trecho_da_causa = "caixa errada", explicacao = "Na $O o nome '$1' da linha '$L' esta na caixa errada para o papel dele.", forma = "Renomeie '$1' para '$2' na linha '$L' (e em todos os usos)."},
    FormaDaCausa{codigo = E0102, trecho_da_causa = "so descarta", explicacao = "Na $O a linha '$L' usa o '_' como nome de variavel, e o '_' so descarta um valor numa desestruturacao.", forma = "Troque o '_' por um nome na linha '$L', ou desestruture com let a, _ = f()."},
    FormaDaCausa{codigo = E1003, trecho_da_causa = "mas nao e pub", explicacao = "Na $O a linha '$L' usa '$1', que existe no modulo mas nao e pub.", forma = "Declare '$1' com pub no modulo (pub proc, pub struct...) ou use outro nome que seja publico."},
    FormaDaCausa{codigo = E1003, trecho_da_causa = "importe-o e escreva", explicacao = "Na $O a linha '$L' usa '$1' sem o apelido do modulo de onde ele vem.", forma = "Escreva apelido.$1 na linha '$L' (apelido = o do import do modulo); se o modulo nao foi importado, importe-o."},
    FormaDaCausa{codigo = E1003, trecho_da_causa = "nao existe no modulo", explicacao = "Na $O a linha '$L' usa '$1', que o modulo nao declara.", forma = "Troque '$1' por um nome do modulo (os parecidos aparecem na causa) ou declare '$1' com pub nele."},
    FormaDaCausa{codigo = E1003, trecho_da_causa = "e da linguagem", explicacao = "Na $O a linha '$L' escreve '$1' com apelido de modulo, mas '$1' e da linguagem.", forma = "Escreva '$1' sem apelido na linha '$L'."},
