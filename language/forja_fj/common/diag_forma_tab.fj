    FormaDaCausa{codigo = E0336, trecho_da_causa = "precisa se chamar 'alloc'", explicacao = "Na $O o parametro '$1' da linha '$L' e um Allocator com outro nome; a Forja so reconhece o alocador pelo nome alloc.", forma = "Renomeie o parametro '$1' da linha '$L' para alloc (alloc: Allocator) e use alloc no corpo."},
    FormaDaCausa{codigo = E0336, trecho_da_causa = "vem por ultimo", explicacao = "Na $O o parametro alloc: Allocator da linha '$L' nao e o ultimo da lista de parametros do proc.", forma = "Mova alloc: Allocator para o fim da lista de parametros da linha '$L'."},
    FormaDaCausa{codigo = E0336, trecho_da_causa = "so existe como parametro", explicacao = "Na $O a linha '$L' usa Allocator fora de um parametro de proc; o alocador so se recebe do chamador, nao se guarda nem se devolve.", forma = "Tire Allocator da linha '$L' e receba o alocador no ultimo parametro (alloc: Allocator), repassando-o em vez de guarda-lo."},
    FormaDaCausa{codigo = E0336, trecho_da_causa = "nao se le o campo", explicacao = "Na $O a linha '$L' le o campo .id de um Allocator; o handle e do runtime e o alocador so se repassa.", forma = "Tire o .id da linha '$L' e repasse o proprio alloc (alloc = alloc) para quem precisa do alocador."},
    FormaDaCausa{codigo = E0336, trecho_da_causa = "nao se escreve o literal", explicacao = "Na $O a linha '$L' escreve um literal Allocator{...}; o valor do alocador vem do chamador, nao se monta no codigo.", forma = "Tire o literal da linha '$L', receba alloc: Allocator como ultimo parametro e use o alloc recebido."},
