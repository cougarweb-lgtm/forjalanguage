    FormaDaCausa{codigo = E0706, trecho_da_causa = "sai por", explicacao = "Na $O a linha '$L' faz o endereco de '$1', que e local, sobreviver ao proc ($C).", forma = "Guarde o valor de '$1' (e nao o endereco) na linha '$L', ou aloque com new(..., alloc = heap)."},
    FormaDaCausa{codigo = E0706, trecho_da_causa = "deixa de existir", explicacao = "Na $O o return da linha '$L' devolve o endereco (ou a fatia) de um local, que deixa de existir quando o proc retorna.", forma = "Devolva o valor (return <o valor>) ou receba o destino por ponteiro do chamador, na linha '$L'; ou copie o valor para fora."},
