    FormaDaCausa{codigo = E0502, trecho_da_causa = "sobra argumento", explicacao = "Na $O a chamada da linha '$L' passa mais argumentos do que o proc tem parametros.", forma = "Tire o argumento que sobra da chamada da linha '$L'."},
    FormaDaCausa{codigo = E0502, trecho_da_causa = "posicional depois de um nomeado", explicacao = "Na $O a chamada da linha '$L' tem um argumento posicional depois de um nomeado; os posicionais vem primeiro, na ordem dos parametros, e os nomeados depois.", forma = "Escreva <nome do parametro> = <valor> no argumento posicional da linha '$L', ou ponha os posicionais antes dos nomeados."},
    FormaDaCausa{codigo = E0502, trecho_da_causa = "deve ser posicional", explicacao = "Na $O a chamada da linha '$L' nomeia o primeiro argumento, que deve ser posicional.", forma = "Tire o nome e o = do primeiro argumento da linha '$L' (fica so o valor)."},
    // ---- E0001: lexico ----
    FormaDaCausa{codigo = E0001, trecho_da_causa = "caractere invalido ';'", explicacao = "Na $O a linha '$L' usa ';', que a Forja nao usa: os comandos se separam por quebra de linha.", forma = "Tire o ; da linha '$L' e ponha cada comando na sua linha."},
    FormaDaCausa{codigo = E0001, trecho_da_causa = "caractere invalido", explicacao = "Na $O a linha '$L' tem um caractere que a Forja nao reconhece ($1).", forma = "Remova o caractere $1 da linha '$L' (ou ponha-o dentro de um texto entre aspas)."},
    FormaDaCausa{codigo = E0001, trecho_da_causa = "fora do ASCII", explicacao = "Na $O a linha '$L' usa um caractere fora do ASCII num nome; nome, tipo e comando so usam a-z, A-Z, 0-9 e _.", forma = "Troque o nome da linha '$L' por letras sem acento (acento so vale dentro de texto entre aspas)."},
    FormaDaCausa{codigo = E0001, trecho_da_causa = "digito", explicacao = "Na $O o numero da linha '$L' tem um digito que a base escolhida nao aceita ($C).", forma = "Troque o digito na linha '$L' por um da base (0 e 1 em 0b; 0-9 e a-f em 0x) ou escreva o numero sem prefixo."},
    FormaDaCausa{codigo = E0001, trecho_da_causa = "faltam digitos", explicacao = "Na $O o numero da linha '$L' tem o prefixo da base mas nenhum digito depois dele.", forma = "Escreva os digitos depois do prefixo na linha '$L' ou tire o prefixo."},
    FormaDaCausa{codigo = E0001, trecho_da_causa = "sem fechar na linha", explicacao = "Na $O o texto da linha '$L' abre aspas e nao fecha na mesma linha.", forma = "Feche o texto com \" no fim da linha '$L' (texto nao atravessa linhas)."},
    FormaDaCausa{codigo = E0001, trecho_da_causa = "no f\"", explicacao = "Na $O o f\"...\" da linha '$L' esta malformado: $C.", forma = "Corrija o f\"...\" da linha '$L': uma expressao entre as chaves, {{ e }} para chave literal e as aspas fechadas."},
