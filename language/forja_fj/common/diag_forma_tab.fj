    FormaDaCausa{codigo = E0337, trecho_da_causa = "a chave nao e um campo da struct", explicacao = "Na $O a linha '$L' passa a chave de sort_by_key que nao e um campo direto da struct do elemento (um proc, um valor ou um campo aninhado).", forma = "Escreva key = Struct.campo na linha '$L', com um campo direto da struct da fatia."},
    FormaDaCausa{codigo = E0337, trecho_da_causa = "o campo da chave nao e ordenavel", explicacao = "Na $O a linha '$L' ordena por um campo sem ordem (enum, struct, bool, ponteiro ou lista); sort_by_key so compara inteiro, f32, f64 e str.", forma = "Escolha na linha '$L' um campo inteiro, f32, f64 ou str, ou use sort_by(s, less = p) com um proc que compare o que voce quer."},
