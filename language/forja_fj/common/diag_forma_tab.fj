    FormaDaCausa{codigo = E0420, trecho_da_causa = "do membro", explicacao = "Na $O o membro '$1' do enum tem um valor que nao cabe em i32 (o enum vira int no C).", forma = "Use em '$1' um valor de -2147483648 a 2147483647 na linha '$L', ou tire o valor explicito de algum membro."},
    FormaDaCausa{codigo = E0420, trecho_da_causa = "passa de 64 bits", explicacao = "Na $O o literal da linha '$L' passa de 64 bits.", forma = "Escreva na linha '$L' um literal de ate 18446744073709551615 (uint), ou parta o valor em duas contas."},
    FormaDaCausa{codigo = E0420, trecho_da_causa = "nao cabe em", explicacao = "Na $O o literal da linha '$L' nao cabe no tipo pedido ($C).", forma = "Use na linha '$L' um literal dentro da faixa do tipo, ou declare um tipo maior (i64, uint)."},
    // ---- E0706: endereco de local que escapa ----
