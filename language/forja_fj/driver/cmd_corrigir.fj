import "common"
import "cache"
import "nativo"

struct Pedido {
    arquivo: ?str
    codigo: ?str
    aplicar: bool
    provavel: bool
}

struct Selecao {
    diags: ?[]?^DiagLido
    ndiags: u32
    edicoes: ?[]Edicao
    nedicoes: u32
    puladas: u32
}

struct Efeito {
    aplicado: bool
    desfeito: bool
    erros_depois: i64
    motivo: ?str
    diff: [dynamic]u8
}

struct Contexto {
    pedido: ?^Pedido
    antes: ?^ResultadoCheck
    selecao: ?^Selecao
    arena: ?^common.Arena
    original: ?str
    tam: u64
}

const SAIDA_OK: i32 = 0
const SAIDA_DESFEITO: i32 = 1
const SAIDA_USO: i32 = 2
const SAIDA_INTERNO: i32 = 3
const TEXTO_MAX: i32 = 400

// C: driver/cmd_corrigir.c:39
proc uso_errado_2(motivo: ?str) -> i32 {
    let txt_1 = motivo or_else "(null)"
    let msg_1 = format(f"forja: corrigir: {txt_1}\n", alloc = heap)
    defer delete(msg_1)
    common.c2f_saida_formatar(common.c2f_saida_stderr(), msg_1)
    common.c2f_saida_escrever_texto(common.c2f_saida_stderr(), "uso: forja corrigir <arq.fj> [--codigo CODIGO] [--aplicar] [--tambem-provavel]\n")
    return SAIDA_USO
}

// C: driver/cmd_corrigir.c:47
proc ler_codigo(argc: i32, argv: []str, k: ^i32, p: ^Pedido) -> ?str {
    if (k^ + 1) >= argc {
        return "--codigo exige um valor (ex.: --codigo E0707)"
    }
    k^ += 1
    p.codigo = argv[k^]
    if common.diag_codigo_por_texto(p.codigo) < 0 {
        return "codigo de diagnostico desconhecido (veja 'forja explicar')"
    }
    return none
}

// C: driver/cmd_corrigir.c:55
// Le as opcoes e o arquivo; devolve o motivo do uso errado ou none.
proc ler_argumentos(argc: i32, argv: []str, p: ^Pedido) -> ?str {
    p^ = Pedido{}
    var k: i32 = 0
    while k < argc {
        let opcao: str = argv[k]
        if opcao == "--aplicar" {
            p.aplicar = true
        } else if opcao == "--tambem-provavel" {
            p.provavel = true
        } else if opcao == "--codigo" {
            let motivo = ler_codigo(argc, argv, &k, p)
            if motivo != none {
                return motivo
            }
        } else if (len(opcao) > 0) and (opcao[0] == 45) { // '-'
            return "opcao desconhecida"
        } else if p.arquivo != none {
            return "so um arquivo por vez"
        } else {
            p.arquivo = opcao
        }
        k += 1
    }
    if p.arquivo == none {
        return "falta o arquivo .fj"
    }
    return none
}

// C: driver/cmd_corrigir.c:82
proc diag_serve(p: ^Pedido, d: ^DiagLido) -> bool {
    let confianca: bool = (d.confianca != none) and (((d.confianca or_else "") == "certa") or ((common.c2f_b2i32(p.provavel) != 0) and ((d.confianca or_else "") == "provavel")))
    if ((not confianca) or (d.nedicoes == 0)) or (not d.edicoes_no_alvo) {
        return false
    }
    return (p.codigo == none) or ((p.codigo or_else "") == (d.codigo or_else ""))
}

// C: driver/cmd_corrigir.c:91
proc conflita_com_escolhidas(s: ^Selecao, e: ^Edicao) -> bool {
    var j: u32 = 0
    while j < s.nedicoes {
        if (not edicoes_iguais(e, &(s.edicoes or_else {})[j])) and (common.c2f_b2i32(edicoes_conflitam(e, &(s.edicoes or_else {})[j])) != 0) {
            return true
        }
        j += 1
    }
    return false
}

// C: driver/cmd_corrigir.c:98
proc ja_escolhida(s: ^Selecao, e: ^Edicao) -> bool {
    var j: u32 = 0
    while j < s.nedicoes {
        if edicoes_iguais(e, &(s.edicoes or_else {})[j]) {
            return true
        }
        j += 1
    }
    return false
}

// C: driver/cmd_corrigir.c:106
proc juntar(s: ^Selecao, d: ^DiagLido) {
    var k: u32 = 0
    while k < d.nedicoes {
        if conflita_com_escolhidas(s, &(d.edicoes or_else {})[k]) {
            s.puladas += 1
            return
        }
        k += 1
    }
    var k_2: u32 = 0
    while k_2 < d.nedicoes {
        if not ja_escolhida(s, &(d.edicoes or_else {})[k_2]) {
            let antes_1: u32 = s.nedicoes
            s.nedicoes += 1
            let p_1 = s.edicoes or_else {}
            p_1[antes_1] = (d.edicoes or_else {})[k_2]
        }
        k_2 += 1
    }
    let antes_2: u32 = s.ndiags
    s.ndiags += 1
    let p_2 = s.diags or_else {}
    p_2[antes_2] = d
}

// C: driver/cmd_corrigir.c:119
// Escolhe as sugestoes boas (diag_serve) e junta as edicoes delas; a memoria sai da arena do comando.
proc selecionar(p: ^Pedido, antes: ^ResultadoCheck, arena: ^common.Arena, s: ^Selecao) {
    s^ = Selecao{}
    let itens = antes.itens or_else {}
    var total: int = 1
    for k in (0 as u32)..<antes.n {
        total += (itens[k].nedicoes as int)
    }
    s.edicoes = arena_fatia_edicao(arena, total)
    s.diags = arena_fatia_ptr_diag_lido(arena, (antes.n as int) + 1)
    for k in (0 as u32)..<antes.n {
        if diag_serve(p, &itens[k]) {
            juntar(s, &itens[k])
        }
    }
}

// Byte k da etiqueta do codigo; 0 fora do texto (o C le o NUL do fim da string).
proc byte_do_codigo(codigo: []u8, k: int) -> u8 {
    if k < len(codigo) {
        return codigo[k]
    }
    return 0
}

// C: driver/cmd_corrigir.c:134
// Etapa do codigo: 0 = sintaxe (E00xx e E01xx), 1 = os demais E, 2 = o resto (R, B, G, X).
proc etapa_do_codigo(codigo: []u8) -> i32 {
    if byte_do_codigo(codigo, 0) != 69 { // 'E'
        return 2
    }
    var tern_1: i32 = 1
    if (byte_do_codigo(codigo, 1) == 48) and ((byte_do_codigo(codigo, 2) == 48) or (byte_do_codigo(codigo, 2) == 49)) {
        tern_1 = 0
    }
    return tern_1 // '0' '0' '1'
}

// C: driver/cmd_corrigir.c:140
proc etapa_minima(r: ^ResultadoCheck) -> i32 {
    var minima: i32 = 2
    let itens = r.itens or_else {}
    for k in (0 as u32)..<r.n {
        let etapa: i32 = etapa_do_codigo(as_bytes(itens[k].codigo or_else ""))
        if etapa < minima {
            minima = etapa
        }
    }
    return minima
}

// C: driver/cmd_corrigir.c:153
// O erro que a sugestao tratava (mesmo codigo, na linha onde ele ficou depois das edicoes) continua no arquivo?
proc erro_original_que_ficou(s: ^Selecao, depois: ^ResultadoCheck) -> ?^DiagLido {
    var k: u32 = 0
    while k < s.ndiags {
        let linha: u32 = edicoes_linha_nova((s.edicoes or_else {})[0..<s.nedicoes], ((s.diags or_else {})[k] as ^DiagLido).linha)
        for j in (0 as u32)..<depois.n {
            let x: ^DiagLido = &(depois.itens or_else {})[j]
            if (x.linha == linha) and ((x.codigo or_else "") == (((s.diags or_else {})[k] as ^DiagLido).codigo or_else "")) {
                return x
            }
        }
        k += 1
    }
    return none
}

// C: driver/cmd_corrigir.c:168 (TEXTO_MAX - 1 bytes, como o snprintf do C)
proc limitar_motivo(texto: str) -> str {
    let teto: int = (TEXTO_MAX - 1) as int
    if len(texto) > teto {
        return texto[0..<teto]
    }
    return texto
}

// C: driver/cmd_corrigir.c:168
// Frase quando o arquivo ficou pior que antes (M-D2 e M-D13); none quando nao piorou. Mensagens na arena do comando.
// Assinatura: o C grava em motivo (char[]); aqui o motivo volta como ?str da arena (none = nao piorou).
proc motivo_da_piora(arena: ^common.Arena, s: ^Selecao, antes: ^ResultadoCheck, depois: ^ResultadoCheck) -> ?str {
    let ficou = erro_original_que_ficou(s, depois)
    let etapa_antes: i32 = etapa_minima(antes)
    var motivo: ?str = none
    if depois.n > antes.n {
        motivo = format(f"o numero de erros subiu de {antes.n} para {depois.n}", alloc = common.arena_mem(arena))
    } else if ficou != none {
        let cod_ficou: str = (ficou as ^DiagLido).codigo or_else ""
        motivo = format(f"o erro original continua: {cod_ficou} na linha {(ficou as ^DiagLido).linha}", alloc = common.arena_mem(arena))
    }
    let itens = depois.itens or_else {}
    var k: u32 = 0
    while (k < depois.n) and (motivo == none) {
        let x: ^DiagLido = &itens[k]
        if (not corrigir_tem_codigo(antes, x.codigo)) and (etapa_do_codigo(as_bytes(x.codigo or_else "")) < etapa_antes) {
            let cod_x: str = x.codigo or_else ""
            motivo = format(f"apareceu erro de etapa anterior: {cod_x} na linha {x.linha}", alloc = common.arena_mem(arena))
        }
        k += 1
    }
    if motivo == none {
        return none
    }
    return limitar_motivo(motivo or_else "")
}

// C: driver/cmd_corrigir.c:168 (o motivo vazio do C e 'none' aqui)
proc motivo_vazio(motivo: ?str) -> bool {
    return len(motivo or_else "") == 0
}

// C: driver/cmd_corrigir.c:134 (texto do buffer da arena ate o NUL, no maximo 'limite' bytes; o %.Ns do C)
proc texto_c_limitado(arena: ^common.Arena, b: []u8, limite: int) -> str {
    var n: int = 0
    while (n < len(b)) and (n < limite) and (b[n] != 0) {
        n += 1
    }
    return from_bytes(b[0..<n], alloc = common.arena_mem(arena))
}

// C: driver/cmd_corrigir.c:192 (ponteiro para a 1a edicao da selecao; none se nao ha nenhuma)
proc primeira_edicao(s: ^Selecao) -> ?^Edicao {
    if s.nedicoes == 0 {
        return none
    }
    return &(s.edicoes or_else {})[0]
}

// C: driver/cmd_corrigir.c:192
// Mensagem de arquivo que nao foi gravado ou de check que nao rodou, no stderr, com o prefixo do comando.
proc corrigir_avisar(prefixo: str, texto: str) {
    let msg = format(f"forja: corrigir: {prefixo}{texto}\n", alloc = heap)
    defer delete(msg)
    common.c2f_saida_formatar(common.c2f_saida_stderr(), msg)
}

// C: driver/cmd_corrigir.c:192
// Grava as edicoes, roda o check de novo e desfaz se piorou. Devolve o exit do comando.
proc aplicar_e_conferir(c: ^Contexto, ef: ^Efeito) -> i32 {
    let pedido = c.pedido as ^Pedido
    let sel = c.selecao as ^Selecao
    let arena = c.arena as ^common.Arena
    let arquivo: str = pedido.arquivo or_else ""
    let original: str = c.original or_else ""
    var novo = make([dynamic]u8, alloc = heap)
    defer delete(novo)
    if not edicoes_montar_arquivo(original, c.tam, primeira_edicao(sel), sel.nedicoes, &novo) {
        ef.motivo = "as edicoes nao se aplicam ao arquivo"
        return SAIDA_INTERNO
    }
    let novo_txt: str = from_bytes(novo[..], alloc = heap)
    defer delete(novo_txt)
    if not common.arquivo_gravar_atomico(pedido.arquivo, novo_txt, len(novo) as u64, none) {
        ef.motivo = format(f"nao consegui gravar {arquivo}", alloc = common.arena_mem(arena))
        return SAIDA_INTERNO
    }
    var depois = ResultadoCheck{}
    let erro = common.arena_fatia_u8(arena, TEXTO_MAX as int)
    if corrigir_rodar_check(arena, pedido.arquivo, &depois, erro, TEXTO_MAX as u64) {
        ef.motivo = motivo_da_piora(arena, sel, c.antes as ^ResultadoCheck, &depois)
        ef.erros_depois = depois.n as i64
    } else {
        let trecho: str = texto_c_limitado(arena, erro, 300)
        ef.motivo = format(f"o check depois da correcao falhou: {trecho}", alloc = common.arena_mem(arena))
    }
    ef.aplicado = motivo_vazio(ef.motivo)
    if ef.aplicado {
        return SAIDA_OK
    }
    ef.desfeito = true
    var codigo: i32 = SAIDA_DESFEITO
    if not edicoes_desfazer(pedido.arquivo, c.original, c.tam) {
        ef.desfeito = false
        ef.motivo = format(f"GRAVE: nao consegui devolver {arquivo} ao conteudo original", alloc = common.arena_mem(arena))
        codigo = SAIDA_INTERNO
    }
    return codigo
}

// C: driver/cmd_corrigir.c:230
proc emitir_correcao(b: ^[dynamic]u8, d: ^DiagLido, arquivo: ?str) {
    append(b, item = "{\"id\": ")
    edicoes_json_texto_ou_nulo(b, d.id)
    let txt_1 = d.codigo or_else "(null)"
    let txt_2 = d.confianca or_else "(null)"
    format(f", \"codigo\": \"{txt_1}\", \"linha\": {d.linha}, \"coluna\": {d.coluna}, \"confianca\": \"{txt_2}\", \"sugestao\": ", into = b)
    edicoes_json_texto_ou_nulo(b, d.sugestao)
    append(b, item = ", \"edicoes\": [")
    var k: u32 = 0
    while k < d.nedicoes {
        if k > 0 {
            append(b, item = ", ")
        }
        edicoes_json_edicao(b, &(d.edicoes or_else {})[k], arquivo)
        k += 1
    }
    append(b, item = "]}")
}

// C: driver/cmd_corrigir.c:245
// Uma linha JSON no stdout, chaves em ordem fixa (M-D6: mesma entrada, mesmos bytes).
proc emitir_resultado(c: ^Contexto, ef: ^Efeito) {
    let p = c.pedido as ^Pedido
    let sel = c.selecao as ^Selecao
    let erros_antes: u32 = (c.antes as ^ResultadoCheck).n
    var b = make([dynamic]u8, alloc = heap)
    defer delete(b)
    append(&b, item = "{\"comando\": \"corrigir\", \"arquivo\": ")
    nativo.json_caminho(&b, p.arquivo)
    var aplicar_txt: str = "false"
    if p.aplicar {
        aplicar_txt = "true"
    }
    format(f", \"aplicar\": {aplicar_txt}, \"codigo\": ", into = &b)
    edicoes_json_texto_ou_nulo(&b, p.codigo)
    var confianca_txt: str = "certa"
    if p.provavel {
        confianca_txt = "certa+provavel"
    }
    format(f", \"confianca\": \"{confianca_txt}\", \"erros_antes\": {erros_antes}, \"correcoes\": [", into = &b)
    var k: u32 = 0
    while k < sel.ndiags {
        if k > 0 {
            append(&b, item = ", ")
        }
        emitir_correcao(&b, (sel.diags or_else {})[k] as ^DiagLido, p.arquivo)
        k += 1
    }
    format(f"], \"puladas\": {sel.puladas}, \"edicoes\": {sel.nedicoes}, \"diff\": ", into = &b)
    let diff_txt: str = from_bytes(ef.diff[..], alloc = heap)
    defer delete(diff_txt)
    edicoes_json_texto(&b, diff_txt, len(diff_txt) as u64)
    var aplicado_txt: str = "false"
    if ef.aplicado {
        aplicado_txt = "true"
    }
    var desfeito_txt: str = "false"
    if ef.desfeito {
        desfeito_txt = "true"
    }
    format(f", \"aplicado\": {aplicado_txt}, \"desfeito\": {desfeito_txt}, \"erros_depois\": ", into = &b)
    if ef.erros_depois < 0 {
        append(&b, item = "null")
    } else {
        format(f"{ef.erros_depois}", into = &b)
    }
    append(&b, item = ", \"motivo\": ")
    edicoes_json_texto_ou_nulo(&b, ef.motivo)
    append(&b, item = "}\n")
    common.c2f_saida_escrever(common.c2f_saida_stdout(), b[..])
}

// C: driver/cmd_corrigir.c:274
// O diff das correcoes escolhidas (sem gravar nada). false = as edicoes nao cabem no arquivo (o check e o arquivo discordam).
proc calcular_diff(c: ^Contexto, ef: ^Efeito) -> bool {
    let p = c.pedido as ^Pedido
    let sel = c.selecao as ^Selecao
    let original: str = c.original or_else ""
    var bom: u64 = 0
    if edicoes_tem_bom(as_bytes(original), c.tam) {
        bom = EDICOES_BOM_TAM as u64
    }
    let arquivo: str = p.arquivo or_else ""
    var nome_b = make([dynamic]u8, alloc = heap)
    defer delete(nome_b)
    var k: int = 0
    while (k < len(arquivo)) and (k < 599) { // nome[600] do C: 599 bytes + NUL
        if arquivo[k] == 92 { // '\\'
            append(&nome_b, item = 47) // '/'
        } else {
            append(&nome_b, item = arquivo[k])
        }
        k += 1
    }
    let nome: str = from_bytes(nome_b[..], alloc = heap)
    defer delete(nome)
    let st: i32 = edicoes_diff(original[(bom as int)..<len(original)], c.tam - bom, primeira_edicao(sel), sel.nedicoes, nome, &ef.diff)
    if st != EDICAO_OK {
        ef.motivo = edicao_status_texto(st)
    }
    return st == EDICAO_OK
}

// C: driver/cmd_corrigir.c:288
// Roda o check, calcula o diff e (com --aplicar) grava e confere; a saida JSON sai sempre que o diff foi calculado.
proc executar(p: ^Pedido, arena: ^common.Arena, original: ?str, tam: u64) -> i32 {
    var antes = ResultadoCheck{}
    var selecao = Selecao{}
    var ef = Efeito{aplicado = false, desfeito = false, erros_depois = -1, motivo = none, diff = make([dynamic]u8, alloc = heap)}
    defer delete(ef.diff)
    var c = Contexto{pedido = p, antes = &antes, selecao = &selecao, arena = arena, original = original, tam = tam}
    let erro = common.arena_fatia_u8(arena, TEXTO_MAX as int)
    if not corrigir_rodar_check(arena, p.arquivo, &antes, erro, TEXTO_MAX as u64) {
        corrigir_avisar("", texto_c_limitado(arena, erro, (TEXTO_MAX - 1) as int))
        return SAIDA_INTERNO
    }
    selecionar(p, &antes, arena, &selecao)
    if not calcular_diff(&c, &ef) {
        corrigir_avisar("", ef.motivo or_else "")
        return SAIDA_INTERNO
    }
    var codigo: i32 = SAIDA_OK
    if p.aplicar and (selecao.nedicoes > 0) {
        codigo = aplicar_e_conferir(&c, &ef)
    }
    emitir_resultado(&c, &ef)
    if not motivo_vazio(ef.motivo) {
        var prefixo: str = ""
        if ef.desfeito {
            prefixo = "a correcao piorou o arquivo e foi desfeita: "
        }
        corrigir_avisar(prefixo, ef.motivo or_else "")
    }
    return codigo
}

// C: driver/cmd_corrigir.c:314
// Ponto de entrada: 'forja corrigir <arq.fj> [--codigo X] [--aplicar] [--tambem-provavel]'.
proc rodar_corrigir(argc: i32, argv: []str) -> i32 {
    var pedido = Pedido{}
    var arena = common.Arena{}
    let erro = ler_argumentos(argc, argv, &pedido)
    if erro != none {
        return uso_errado_2(erro)
    }
    let arquivo: str = pedido.arquivo or_else ""
    var dados = make([dynamic]u8, alloc = heap)
    defer delete(dados)
    if not cache.arquivo_ler_inteiro(arquivo, &dados) {
        let msg = format(f"forja: nao consegui abrir '{arquivo}' para leitura\n", alloc = heap)
        defer delete(msg)
        common.c2f_saida_formatar(common.c2f_saida_stderr(), msg)
        return SAIDA_USO
    }
    // arquivo_ler_inteiro acrescenta um NUL depois dos bytes: o texto do arquivo e um a menos (como o cmd_editar)
    let original: str = from_bytes(dados[0..<(len(dados) - 1)], alloc = heap)
    defer delete(original)
    let codigo: i32 = executar(&pedido, &arena, original, len(original) as u64)
    common.arena_liberar(&arena)
    return codigo
}
