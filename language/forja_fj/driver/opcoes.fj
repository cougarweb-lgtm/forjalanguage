import "std:os"
import "common"
import "nativo"
import "nativo/optimizer"

struct Opcoes {
    comando: ?str
    entrada: ?str
    saida: ?str
    modo: ?str
    tempos: ?str
    backend: ?str
    target: ?str
    prova: ?str
    debug_code: ?str
    max_erros: ?str
    simbolos: ?str
    checagem: ?str
    sem_otim: ?str
    filtro: ?str
    entradas: ?str
    lib_pasta: ?str
    runpath: ?str
    jobs: ?str
    limite_tempo: ?str
    limite_mem: ?str
    limite_saida: ?str
    args_file: ?str
    no: ?str
    alvo_teste: ?str
    caminho_alvo: ?str
    raiz_alvo: ?str
    linha: ?str
    args_programa: ?[]str
    nargs_programa: i32
    tipos: bool
    release: bool
    suporte: bool
    json: bool
    sem_pos: bool
    resumo: bool
    traco: bool
    pie: bool
    guarda_memoria: bool
    perfil: bool
    rastreio: bool
    stdin_fonte: bool
    projeto: bool
    plano: bool
    tudo: bool
    canonico: bool
}

struct OpcaoCli {
    nome: ?str
    tipo: i32
    destino: u64
}

const OPCAO_VALOR: i32 = 0
const OPCAO_MARCA: i32 = 1
const OPCOES_ALVO_WINDOWS: str = "x86_64-windows"
const OPCOES_ALVO_LINUX: str = "x86_64-linux"
const OPCOES_ALVO_WASM: str = "wasm32-wasip1"
const OPCOES_ALVO_WASM_APELIDO: str = "wasm"
const OPCOES_ALVO_A64: str = "aarch64-linux" // A1.2: so build (ELF AArch64); run/test/perfil recusados com X0003
const OPCOES_ALVO_ANDROID: str = "aarch64-linux-android" // A4.1: ELF Android (PIE dinamico no A4.2); build e --modo exe/dll; run/test com X0003
const OPCOES_ALVO_IOS: str = "aarch64-apple-ios" // I1: Mach-O do aparelho; build com X0003 ate a I2, run/test com X0003
const OPCOES_ALVO_IOS_SIM: str = "aarch64-apple-ios-sim" // I1: Mach-O do simulador; mesmo tratamento do aparelho nesta fatia
const OPCOES_FILTRO_MAX: i32 = 255
const OPCOES_JOBS_MAX: i32 = 64
const CHECAGEM_PADRAO_RELEASE: bool = true
const CAUSA_SEM_OTIM_MAX: int = 300
const CAUSA_ALVO_MAX: int = 256
const PASTA_ALVO_MAX: int = 256
const NOME_ALVO_MAX: int = 256
const CAMINHO_ALVO_MAX: int = 512
const RAIZ_ALVO_MAX: int = 320

