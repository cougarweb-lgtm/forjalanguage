    }
    if (common.c2f_b2i32(modo_eh_dll(o)) != 0) or (common.c2f_b2i32(o.suporte) != 0) {
        return "--rastreio nao vale com --modo dll nem com --suporte"
    }
    return none
}

// C: driver/opcoes.c:359
proc validar_guarda(o: ^Opcoes) -> ?str {
    let comando_ok: bool = ((common.c2f_b2i32(comando_eh(o, "build")) != 0) or (common.c2f_b2i32(comando_eh(o, "run")) != 0)) or (common.c2f_b2i32(comando_eh(o, "test")) != 0)
    let backend_c: bool = (o.backend != none) and ((o.backend or_else "") != "x64")
    if not o.guarda_memoria {
        return none
    }
    if ((((not comando_ok) or (common.c2f_b2i32(o.release) != 0)) or (common.c2f_b2i32(backend_c) != 0)) or (common.c2f_b2i32(modo_eh_dll(o)) != 0)) or (common.c2f_b2i32(o.suporte) != 0) {
        return "--guarda-memoria so vale em dev, backend x64, exe"
    }
    return none
}

