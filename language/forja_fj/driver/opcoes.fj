        return "--traco so vale em build, run e test"
    }
    if (common.c2f_b2i32(modo_eh_dll(o)) != 0) or (common.c2f_b2i32(o.suporte) != 0) {
        return "--traco nao vale com --modo dll nem com --suporte"
    }
    return none
}

