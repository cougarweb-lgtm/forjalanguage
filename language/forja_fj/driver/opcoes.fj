        return none
    }
    if ((common.c2f_b2i32(comando_eh(o, "build")) != 0) or (common.c2f_b2i32(comando_eh(o, "test")) != 0)) or (common.c2f_b2i32(comando_eh(o, "run")) != 0) {
        return none
    }
    return "--backend e --target so valem em build, run e test"
