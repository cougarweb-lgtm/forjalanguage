}

// C: driver/opcoes.c:403
proc validar_checagem(o: ^Opcoes) -> ?str {
    let comando_ok: bool = ((common.c2f_b2i32(comando_eh(o, "build")) != 0) or (common.c2f_b2i32(comando_eh(o, "run")) != 0)) or (common.c2f_b2i32(comando_eh(o, "test")) != 0)
    if o.checagem == none {
        return none
    }
    if ((o.checagem or_else "") != "sim") and ((o.checagem or_else "") != "nao") {
        return "--checagem aceita so sim ou nao"
    }
    if not comando_ok {
        return "--checagem so vale em build, run e test"
    }
    if (not o.release) and ((o.checagem or_else "") == "nao") {
        return "--checagem nao so vale com --release (o dev sempre confere indice e nulo)"
    }
    return none
}

