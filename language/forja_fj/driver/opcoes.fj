    if not o.release {
        return true
    }
    if o.checagem == none {
        return CHECAGEM_PADRAO_RELEASE
    }
    return (o.checagem or_else "") == "sim"
}

// C: driver/opcoes.c:422
// --sem-otim (M7a F0): passes de otimizacao da BIR desligados; so build, run e test, so --release; passo desconhecido lista os validos.
// A causa (static char[300] no C) volta como texto do alocador frame: nenhum dono a libera.
proc validar_sem_otim(o: ^Opcoes) -> ?str {
    let comando_ok: bool = comando_eh(o, "build") or comando_eh(o, "run") or comando_eh(o, "test")
    if o.sem_otim == none {
        return none
    }
    if not comando_ok {
        return "--sem-otim so vale em build, run e test"
    }
    if not o.release {
        return "--sem-otim so vale com --release (o dev nunca roda passe de otimizacao)"
    }
    var causa = make([dynamic]u8, alloc = heap, len = CAUSA_SEM_OTIM_MAX)
    defer delete(causa)
    if not optimizer.otim_conferir_lista(o.sem_otim, causa[..], CAUSA_SEM_OTIM_MAX as u64) {
        return from_bytes(causa[0..<common.c2f_strlen_b(causa[..])], alloc = frame)
    }
    return none
}

// C: driver/opcoes.c:435
proc validar_entradas(o: ^Opcoes) -> ?str {
    if (o.entradas == none) and (o.lib_pasta == none) {
        return none
    }
    if not comando_eh(o, "build") {
        return "--entradas e --lib-pasta so valem em build"
    }
    if o.suporte {
        return "--suporte nao gera arquivo: sem --entradas nem --lib-pasta"
    }
    return none
}

// C: driver/opcoes.c:443
proc opcoes_conferir_so_x64(o: ^Opcoes, sd: ^common.SaidaDiag) -> bool {
    if ((o.entradas == none) and (o.lib_pasta == none)) or backend_eh_x64(o) {
        return true
    }
    relatar_sem_fonte_stderr(common.X0003, "--entradas e --lib-pasta so existem com --backend x64", sd)
    return false
}

// C: driver/opcoes.c:452
proc opcoes_conferir_aposentados(o: ^Opcoes, sd: ^common.SaidaDiag) -> bool {
    if modo_eh_c(o) {
        relatar_sem_fonte_stderr(common.X0003, "o modo c (emissao de C portavel) foi aposentado na Forja 0.21.0; use --modo exe ou --modo dll", sd)
        return false
    }
    if o.prova != none {
        relatar_sem_fonte_stderr(common.X0003, "--prova-layout dependia do backend C, aposentado na Forja 0.21.0", sd)
        return false
    }
    return true
}

// C: driver/opcoes.c:466
// --backend (padrao: x64): so x64 existe; c foi aposentado na 0.21.0 e outro valor sai com X0003. false = saiu o diagnostico.
proc conferir_backend(o: ^Opcoes, sd: ^common.SaidaDiag) -> bool {
    let backend_texto: str = o.backend or_else ""
    if (o.backend == none) or (backend_texto == "x64") {
        return true
    }
    if backend_texto == "c" {
        relatar_sem_fonte_stderr(common.X0003, "o backend C foi aposentado na Forja 0.21.0: o unico backend e o x64 (o padrao); --backend c nao existe mais", sd)
        return false
    }
    let causa = format(f"backend desconhecido em --backend: '{backend_texto}' (validos: x64)", alloc = heap)
    defer delete(causa)
    relatar_sem_fonte_stderr(common.X0003, cortar_causa(causa), sd)
    return false
}

// char causa[256] do snprintf: no maximo 255 bytes (a vista aponta para o proprio texto; o corte nao copia)
proc cortar_causa(causa: str) -> str {
    return causa[0..<min(len(causa), CAUSA_ALVO_MAX - 1)]
}

// C: driver/opcoes.c:482
proc recusa_do_alvo_linux(o: ^Opcoes) -> ?str {
    if not backend_eh_x64(o) {
        return "o alvo x86_64-linux so existe no backend x64 (o padrao)"
    }
    if o.projeto {
        return "build --projeto so gera x86_64-windows nesta versao"
    }
    if modo_eh_dll(o) {
        return nativo.NATIVO_X0003_SO
    }
    if comando_eh(o, "run") {
        return "o Windows nao executa ELF: build e rode no Linux"
    }
    if (common.c2f_b2i32(comando_eh(o, "test")) != 0) and (o.saida == none) {
        return "forja test no alvo x86_64-linux so constroi o exe de teste: passe -o <saida>"
    }
    return none
}

// Filtro do forja test no wasm: o executor guarda o trecho em [832,1024) da memoria linear (rt_wasm_teste.fj); o x64 aceita 255
const TESTE_WASM_FILTRO_MAX: int = 191

// Alvo wasm32-wasip1: build, run e test (0.33.0, pelo Node); as demais combinacoes saem com X0003 e a causa diz qual.
proc recusa_do_alvo_wasm(o: ^Opcoes) -> ?str {
    if not backend_eh_x64(o) {
        return "o alvo wasm32-wasip1 so existe no backend x64 (o padrao)"
    }
    if o.projeto {
        return "build --projeto so gera x86_64-windows nesta versao"
    }
    if comando_eh(o, "test") and (o.alvo_teste != none) {
        return "forja test <modulo> nao existe no alvo wasm32-wasip1: passe um arquivo .fj"
    }
    if comando_eh(o, "test") and (len(o.filtro or_else "") > TESTE_WASM_FILTRO_MAX) {
        return "forja test --filtro no alvo wasm32-wasip1 aceita ate 191 bytes"
    }
    if o.perfil {
        return "--perfil nao existe no alvo wasm32-wasip1"
    }
    if o.guarda_memoria {
        return "--guarda-memoria nao existe no alvo wasm32-wasip1"
    }
    if o.simbolos != none {
        return "--simbolos nao existe no alvo wasm32-wasip1"
    }
    return none
}

// A1.2: aarch64-linux so faz build (ELF); run/test/--modo dll/perfil/guarda/simbolos saem com X0003 e a causa
proc recusa_do_alvo_a64(o: ^Opcoes) -> ?str {
    if not backend_eh_x64(o) {
        return "o alvo aarch64-linux so existe no backend x64 (o padrao)"
    }
    if o.projeto {
        return "build --projeto so gera x86_64-windows nesta versao"
    }
    // I2: iOS faz build (Mach-O exe); run e test recusados (o simulador do CI roda o binario); --modo dll e a fatia I5
    if alvo_eh_ios(o) {
        if comando_eh(o, "run") or comando_eh(o, "test") {
            return "o alvo iOS nao roda neste host (run e test recusados): rode o binario no simulador do CI"
        }
    }
    if alvo_eh_android(o) and (comando_eh(o, "run") or comando_eh(o, "test")) {
        return "o alvo aarch64-linux-android nao roda neste host (run e test recusados): gere com build -o e rode no emulador Android ou pelo APK (A5)"
    }
    if comando_eh(o, "run") {
        return "forja run nao executa o alvo aarch64-linux neste host: gere com build -o e rode o ELF no qemu-aarch64 ou no emulador Android"
    }
    if comando_eh(o, "test") {
        return "forja test nao roda o alvo aarch64-linux nesta versao: gere com build -o e rode o ELF no qemu-aarch64"
    }
    // A4.1: o android aceita --modo dll (placeholder ate o A4.2 emitir o .so); o aarch64-linux puro segue sem
    if modo_eh_dll(o) and (not alvo_eh_android(o)) and (not alvo_eh_ios(o)) {
        return "--modo dll nao existe no alvo aarch64-linux nesta versao (o .so chega no A4)"
    }
    if o.perfil {
        return "--perfil nao existe no alvo aarch64-linux nesta versao"
    }
    if o.guarda_memoria {
        return "--guarda-memoria nao existe no alvo aarch64-linux nesta versao"
    }
    if o.simbolos != none {
        return "--simbolos nao existe no alvo aarch64-linux nesta versao"
    }
    return none
}

// C: driver/opcoes.c:493
// --target: x86_64-windows e o padrao; x86_64-linux vale nas combinacoes de recusa_do_alvo_linux (X0003 nas outras), wasm32-wasip1 nas de recusa_do_alvo_wasm, e outro valor sai com X0002.
proc conferir_alvo(o: ^Opcoes, sd: ^common.SaidaDiag) -> bool {
    let alvo: str = o.target or_else ""
    if (o.target == none) or (alvo == OPCOES_ALVO_WINDOWS) {
        return true
    }
    if alvo_eh_linux(o) {
        let recusa: ?str = recusa_do_alvo_linux(o)
        if recusa != none {
            relatar_sem_fonte_stderr(common.X0003, recusa or_else "", sd)
        }
        return recusa == none
    }
    if alvo_eh_wasm(o) {
        let recusa_wasm: ?str = recusa_do_alvo_wasm(o)
        if recusa_wasm != none {
            relatar_sem_fonte_stderr(common.X0003, recusa_wasm or_else "", sd)
        }
        return recusa_wasm == none
    }
    if alvo_eh_a64(o) {
        let recusa_a64: ?str = recusa_do_alvo_a64(o)
        if recusa_a64 != none {
            relatar_sem_fonte_stderr(common.X0003, recusa_a64 or_else "", sd)
        }
        return recusa_a64 == none
    }
    let causa = format(f"alvo desconhecido em --target: '{alvo}' (validos: x86_64-windows|x86_64-linux|wasm32-wasip1|wasm|aarch64-linux|aarch64-linux-android|aarch64-apple-ios|aarch64-apple-ios-sim)", alloc = heap)
    defer delete(causa)
    relatar_sem_fonte_stderr(common.X0002, cortar_causa(causa), sd)
    return false
}

// C: driver/opcoes.c:510
proc conferir_debug_code(o: ^Opcoes, sd: ^common.SaidaDiag) -> bool {
    if (o.debug_code == none) or backend_eh_x64(o) {
        return true
    }
    relatar_sem_fonte_stderr(common.X0003, "--debug-code so existe com --backend x64", sd)
    return false
}

// C: driver/opcoes.c:517
// Curto-circuito como o && do C: a 1a falha para as conferencias seguintes.
proc opcoes_conferir_backend_alvo(o: ^Opcoes, sd: ^common.SaidaDiag) -> bool {
    return conferir_backend(o, sd) and conferir_debug_code(o, sd) and opcoes_conferir_so_x64(o, sd) and conferir_alvo(o, sd)
}

// C: driver/opcoes.c:523
proc validar_stdin(o: ^Opcoes) -> ?str {
    if (not o.stdin_fonte) or (common.c2f_b2i32(comando_eh(o, "check")) != 0) {
        return none
    }
    return "--stdin so vale no comando check"
}

// C: driver/opcoes.c:530
proc validar_filtro(o: ^Opcoes) -> ?str {
    if o.filtro == none {
        return none
    }
    if not comando_eh(o, "test") {
        return "--filtro so vale no comando test"
    }
    if (len((o.filtro or_else "")) as u64) > (OPCOES_FILTRO_MAX as u64) {
        return "--filtro aceita no maximo 255 bytes"
    }
    return none
}

// C: driver/opcoes.c:539
proc validar_args_programa(o: ^Opcoes) -> ?str {
    if (o.nargs_programa > 0) and (not comando_eh(o, "run")) {
        return "argumentos depois de -- so valem em run"
    }
    return none
}

// C: driver/opcoes.c:546
proc validar_limites(o: ^Opcoes) -> ?str {
    var limites: Limites = Limites{}
    let tem_limite: bool = ((o.limite_tempo != none) or (o.limite_mem != none)) or (o.limite_saida != none)
    if (not tem_limite) and (o.args_file == none) {
        return none
    }
    if ((common.c2f_b2i32(tem_limite) != 0) and (not comando_eh(o, "run"))) and (not comando_eh(o, "test")) {
        return "--limite-tempo, --limite-mem e --limite-saida so valem em run e test"
    }
    if (o.args_file != none) and (not comando_eh(o, "run")) {
        return "--args-file so vale em run"
    }
    return limites_ler(o, &limites)
}

// C: driver/opcoes.c:558
// Alguma opcao que so faz sentido para UM arquivo .fj (saida, modo, tempos, --suporte, ...): nenhuma delas vale no build de projeto.
proc tem_opcao_de_arquivo(o: ^Opcoes) -> bool {
    if (o.saida != none) or (o.modo != none) or (o.tempos != none) or (o.prova != none) or (o.debug_code != none) {
        return true
    }
    if (o.max_erros != none) or (o.filtro != none) or (o.entradas != none) or (o.lib_pasta != none) {
        return true
    }
    if (o.limite_tempo != none) or (o.limite_mem != none) or (o.limite_saida != none) or (o.args_file != none) {
        return true
    }
    if (o.checagem != none) or (o.sem_otim != none) {
        return true
    }
    return o.tipos or o.suporte or o.traco or o.rastreio or o.guarda_memoria or o.perfil or o.stdin_fonte or o.resumo or (o.nargs_programa > 0)
}

// C: driver/opcoes.c:570
proc validar_resumo(o: ^Opcoes) -> ?str {
    if ((((not o.resumo) or (common.c2f_b2i32(comando_eh(o, "check")) != 0)) or (common.c2f_b2i32(comando_eh(o, "build")) != 0)) or (common.c2f_b2i32(comando_eh(o, "test")) != 0)) or (common.c2f_b2i32(comando_eh(o, "run")) != 0) {
        return none
    }
    return "--resumo so vale em check, build, run e test"
}

// C: driver/opcoes.c:577
// --projeto [forja.proj] [--release] [--plano] [--tudo] [--json]: so no build; o argumento e o manifesto, nunca um .fj.
proc validar_projeto(o: ^Opcoes) -> ?str {
    let entrada: str = o.entrada or_else ""
    let tam: int = len(entrada)
    var jobs: u32 = 0
    if not comando_eh(o, "build") {
        return "--projeto, --plano, --tudo e --jobs so valem em build"
    }
    if not o.projeto {
        return "--plano, --tudo e --jobs so valem com --projeto"
    }
    if (o.jobs != none) and (not opcoes_jobs_texto(o.jobs, &jobs)) {
        return "--jobs aceita um numero inteiro de 1 a 64"
    }
    if tem_opcao_de_arquivo(o) {
        return "--projeto nao aceita -o, --modo, --tempos, --suporte nem as opcoes de um arquivo .fj"
    }
    if (tam >= 3) and (common.c2f_stricmp(entrada[(tam - 3)..<tam], ".fj") == 0) {
        return "--projeto recebe o forja.proj, nao um arquivo .fj"
    }
    return none
}

// C: driver/opcoes.c:590
proc opcoes_validar(o: ^Opcoes) -> ?str {
    var erro: ?str = none
    if not comando_conhecido(o) {
        return "comando desconhecido"
    }
    if ((common.c2f_b2i32(o.sem_pos) != 0) or (o.no != none)) and (not comando_eh(o, "ast")) {
        return "--sem-pos e --no so valem no comando ast"
    }
    if (common.c2f_b2i32(o.canonico) != 0) and (not comando_eh(o, "check")) {
        return "--canonico so vale no comando check"
    }
    if ((((common.c2f_b2i32(o.projeto) != 0) and (not comando_eh(o, "ast"))) or (common.c2f_b2i32(o.plano) != 0)) or (common.c2f_b2i32(o.tudo) != 0)) or (o.jobs != none) {
        return validar_projeto(o)
    }
    erro = validar_args_programa(o)
    if erro != none {
        return erro
    }
    erro = validar_limites(o)
    if erro != none {
        return erro
    }
    erro = validar_traco(o)
    if erro != none {
        return erro
    }
    erro = validar_rastreio(o)
    if erro != none {
        return erro
    }
    erro = validar_pie(o)
    if erro != none {
        return erro
    }
    erro = validar_guarda(o)
    if erro != none {
        return erro
    }
    erro = validar_perfil(o)
    if erro != none {
        return erro
    }
    erro = validar_simbolos(o)
    if erro != none {
        return erro
    }
    erro = validar_checagem(o)
    if erro != none {
        return erro
    }
    erro = validar_sem_otim(o)
    if erro != none {
        return erro
    }
    erro = validar_resumo(o)
    if erro != none {
        return erro
    }
    erro = validar_filtro(o)
    if erro != none {
        return erro
    }
    erro = validar_stdin(o)
    if erro != none {
        return erro
    }
    erro = validar_entradas(o)
    if erro != none {
        return erro
    }
    erro = validar_max_erros(o)
    if erro != none {
        return erro
    }
    erro = validar_suporte(o)
    if erro != none {
        return erro
    }
    erro = validar_debug_code(o)
    if erro != none {
        return erro
    }
    erro = validar_backend_alvo(o)
    if erro != none {
        return erro
    }
    if comando_eh(o, "explicar") {
        return validar_explicar(o)
    }
    if comando_eh(o, "build") {
        return validar_build(o)
    }
    if (common.c2f_b2i32(comando_eh(o, "test")) != 0) or (common.c2f_b2i32(comando_eh(o, "run")) != 0) {
        return validar_test_run(o)
    }
    return validar_check_ast(o)
}

// C: driver/opcoes.c:641
// Nome do alvo sem ':' e '/' (vira so o nome do arquivo virtual): std:text/parse -> std_text_parse. snprintf(saida, n, "%s") e a troca ate o NUL.
proc nome_do_alvo_saneado(alvo: ?str, saida: []u8, n: u64) {
    _ = common.c2f_snprintf(saida[0..<(n as int)], alvo or_else "")
    let tam: int = common.c2f_strlen_b(saida[0..<(n as int)])
    for k in 0..<tam {
        if (saida[k] == 58) or (saida[k] == 47) { // ':' '/'
            saida[k] = 95 // '_'
        }
    }
}

// C: driver/opcoes.c:651
// forja test <alvo> (S4 P2): raiz sintetica em memoria (import "<alvo>" as alvo_teste + proc main) e caminho virtual <pasta>\<prefixo>_<nome>.teste.fj.
// entrada passa a apontar para o caminho virtual; alvo_teste guarda o texto do import. none = ok ou nao e alvo.
// raiz_alvo[320] e caminho_alvo[512] do C viram texto do alocador frame (nenhum dono os libera; o limite do buffer continua o erro de uso).
proc opcoes_preparar_alvo_do_teste(o: ^Opcoes) -> ?str {
    if (not comando_eh(o, "test")) or (o.entrada == none) or (not entrada_eh_alvo(o.entrada)) {
        return none
    }
    let entrada: str = o.entrada or_else ""
    var pasta: str = ""
    switch r in os.cwd(alloc = heap) {
    case str:
        if len(r) >= PASTA_ALVO_MAX { // _getcwd(pasta, 256) falha (ERANGE) se nao cabe com o NUL
            delete(r)
            return "forja test std:<modulo>: nao consegui ler a pasta atual"
        }
        pasta = cortar_em_frame(r, PASTA_ALVO_MAX)
        delete(r)
    case os.OsError:
        return "forja test std:<modulo>: nao consegui ler a pasta atual"
    }
    let raiz = format(f"import \"{entrada}\" as alvo_teste\nproc main() {{\n}}\n", alloc = heap)
    defer delete(raiz)
    if len(raiz) >= RAIZ_ALVO_MAX {
        return "nome do modulo longo demais para forja test"
    }
    var nome_buf = make([dynamic]u8, alloc = heap, len = NOME_ALVO_MAX)
    defer delete(nome_buf)
    nome_do_alvo_saneado(o.entrada, nome_buf[..], NOME_ALVO_MAX as u64)
    let nome: str = from_bytes(nome_buf[0..<common.c2f_strlen_b(nome_buf[..])], alloc = frame)
    let caminho = format(f"{pasta}\\{nome}.teste.fj", alloc = heap)
    defer delete(caminho)
    if len(caminho) >= CAMINHO_ALVO_MAX {
        return "caminho da pasta atual longo demais para forja test"
    }
    o.raiz_alvo = cortar_em_frame(raiz, RAIZ_ALVO_MAX)
    o.caminho_alvo = cortar_em_frame(caminho, CAMINHO_ALVO_MAX)
    o.alvo_teste = o.entrada
    o.entrada = o.caminho_alvo
    return none
}
