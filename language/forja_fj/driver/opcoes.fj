const COMANDOS: [6]str = {"check", "ast", "build", "test", "run", "explicar"}
const PREFIXOS_3: [3]str = {"std", "vendor", "engine"}

// Diagnostico sem fonte no stderr (DiagImprimirJsonSemFonte(codigo, causa, stderr)): o objeto de saida e novo a cada chamada e fechado (flush) aqui.
proc relatar_sem_fonte_stderr(codigo: i32, causa: str, sd: ^common.SaidaDiag) {
    let erro = common.c2f_saida_stderr()
    common.diag_imprimir_json_sem_fonte(codigo, causa, erro, sd)
    _ = common.c2f_saida_fechar(erro)
}

// C: driver/opcoes.c:96
// Indice da opcao na tabela OPCOES_CLI (o C devolvia o ponteiro para a entrada); -1 = nao existe.
proc achar_opcao(nome: str) -> int {
    for k in 0..<len(OPCOES_CLI) {
        if (OPCOES_CLI[k].nome or_else "") == nome {
            return k
        }
    }
    return -1
}

// o campo de Opcoes que o id (destino) da tabela nomeia: opcao com valor (o proximo argv)
proc opcao_gravar_valor(o: ^Opcoes, id: u64, valor: str) {
    if id == 1 { // -o
        o.saida = valor
    } else if id == 2 { // --modo
        o.modo = valor
    } else if id == 3 { // --tempos
        o.tempos = valor
    } else if id == 4 { // --backend
        o.backend = valor
    } else if id == 5 { // --target (o apelido "wasm" vira o nome canonico aqui, ponto unico)
        if valor == OPCOES_ALVO_WASM_APELIDO {
            o.target = OPCOES_ALVO_WASM
        } else {
            o.target = valor
        }
    } else if id == 6 { // --prova-layout
        o.prova = valor
    } else if id == 7 { // --debug-code
        o.debug_code = valor
    } else if id == 8 { // --max-erros
        o.max_erros = valor
    } else if id == 9 { // --filtro
        o.filtro = valor
    } else if id == 10 { // --entradas
        o.entradas = valor
    } else if id == 11 { // --lib-pasta
        o.lib_pasta = valor
    } else if id == 12 { // --jobs
        o.jobs = valor
    } else if id == 13 { // --limite-tempo
        o.limite_tempo = valor
    } else if id == 14 { // --limite-mem
        o.limite_mem = valor
    } else if id == 15 { // --limite-saida
        o.limite_saida = valor
    } else if id == 16 { // --args-file
        o.args_file = valor
    } else if id == 17 { // --no
        o.no = valor
    } else if id == 29 { // --simbolos
        o.simbolos = valor
    } else if id == 30 { // --checagem
        o.checagem = valor
    } else if id == 31 { // --sem-otim
        o.sem_otim = valor
    } else if id == 37 { // --runpath
        o.runpath = valor
    }
}

// opcao marca: liga o bool do campo que o id nomeia
proc opcao_gravar_marca(o: ^Opcoes, id: u64) {
    if id == 18 { // --sem-pos
        o.sem_pos = true
    } else if id == 19 { // --tipos
        o.tipos = true
    } else if id == 20 { // --release
        o.release = true
    } else if id == 21 { // --suporte
        o.suporte = true
    } else if id == 22 { // --json
        o.json = true
    } else if id == 23 { // --resumo
        o.resumo = true
    } else if id == 24 { // --traco
        o.traco = true
    } else if id == 25 { // --rastreio
        o.rastreio = true
    } else if id == 26 { // --pie
        o.pie = true
    } else if id == 27 { // --guarda-memoria
        o.guarda_memoria = true
    } else if id == 28 { // --perfil
        o.perfil = true
    } else if id == 32 { // --stdin
        o.stdin_fonte = true
    } else if id == 33 { // --projeto
        o.projeto = true
    } else if id == 34 { // --plano
        o.plano = true
    } else if id == 35 { // --tudo
        o.tudo = true
    } else if id == 36 { // --canonico
        o.canonico = true
    }
}

// C: driver/opcoes.c:105
// Uma opcao (ou o arquivo de entrada) em argv[*i]. none se ok, ou o motivo do uso errado.
proc ler_opcao(argc: i32, argv: []str, i: ^i32, o: ^Opcoes) -> ?str {
    let a: str = argv[i^ as int]
    if common.c2f_nul_em(a, 0) != 45 { // '-'
        if o.entrada != none {
            return "mais de um arquivo de entrada"
        }
        o.entrada = a
        return none
    }
    let k: int = achar_opcao(a)
    if k < 0 {
        return "opcao desconhecida"
    }
    let op: OpcaoCli = OPCOES_CLI[k]
    if op.tipo == OPCAO_MARCA {
        opcao_gravar_marca(o, op.destino)
        return none
    }
    if i^ + 1 >= argc {
        return "opcao sem valor"
    }
    i^ = i^ + 1
    opcao_gravar_valor(o, op.destino, argv[i^ as int])
    return none
}

// C: driver/opcoes.c:127
// none se ok, ou o motivo do uso errado.
proc opcoes_ler(argc: i32, argv: []str, o: ^Opcoes) -> ?str {
    o.comando = argv[1]
    var i: i32 = 2
    while i < argc {
        if argv[i as int] == "--" { // o resto e do programa, nao do forja
            o.args_programa = argv[((i as int) + 1)..<len(argv)]
            o.nargs_programa = argc - i - 1
            break
        }
        let erro: ?str = ler_opcao(argc, argv, &i, o)
        if erro != none {
            return erro
        }
        i = i + 1
    }
    if (o.entrada != none) or o.suporte or o.projeto {
        return none
    }
    if (o.comando or_else "") == "explicar" {
        return "falta o codigo do diagnostico"
    }
    return "falta o arquivo .fj"
}

// C: driver/opcoes.c:146
// Acrescenta " arg" (entre aspas se tiver espaco) a saida[usado..n); devolve o novo usado, no maximo n - 1.
proc anexar_argumento(saida: []u8, n: u64, usado: u64, arg: str) -> u64 {
    var aspas: str = ""
    for k in 0..<len(arg) {
        if arg[k] == 32 { // ' '
            aspas = "\""
            break
        }
    }
    let texto = format(f" {aspas}{arg}{aspas}", alloc = heap)
    defer delete(texto)
    let escrito: u64 = len(texto) as u64
    _ = common.c2f_snprintf(saida[(usado as int)..<(n as int)], texto)
    if escrito >= (n - usado) {
        return n - 1
    }
    return usado + escrito
}

// C: driver/opcoes.c:155
proc opcoes_linha_de_comando(argc: i32, argv: []str, saida: []u8, n: u64) {
    var usado: u64 = common.c2f_snprintf(saida[0..<(n as int)], "forja") as u64
    var k: i32 = 1
    while (k < argc) and (usado < (n - 1)) {
        usado = anexar_argumento(saida, n, usado, argv[k as int])
        k = k + 1
    }
}

// C: driver/opcoes.c:163
// Variavel de ambiente do filho: valor vazio remove a variavel do processo (_putenv_s: set_env aceita valor vazio, entao o vazio vai para unset_env).
proc definir_ambiente(nome: str, valor: ?str) {
    let v: str = valor or_else ""
    if len(v) == 0 {
        _ = os.unset_env(nome)
    } else {
        _ = os.set_env(nome, v)
    }
}

// C: driver/opcoes.c:168
proc opcoes_ambiente_do_teste(o: ^Opcoes) {
    var json: ?str = none
    if o.json {
        json = "1"
    }
    definir_ambiente("FORJA_TESTE_FILTRO", o.filtro)
    definir_ambiente("FORJA_TESTE_JSON", json)
}

// C: driver/opcoes.c:174
proc comando_eh(o: ?^Opcoes, nome: str) -> bool {
    return ((o as ^Opcoes).comando or_else "") == nome
}

// C: driver/opcoes.c:179
proc comando_conhecido(o: ^Opcoes) -> bool {
    for k in 0..<len(COMANDOS) {
        if comando_eh(o, COMANDOS[k]) {
            return true
        }
    }
    return false
}

// C: driver/opcoes.c:189
proc modo_eh_c(o: ^Opcoes) -> bool {
    return (o.modo != none) and ((o.modo or_else "") == "c")
}

// C: driver/opcoes.c:194
proc modo_eh_dll(o: ^Opcoes) -> bool {
    return (o.modo != none) and ((o.modo or_else "") == "dll")
}

// C: driver/opcoes.c:199
proc backend_eh_x64(o: ^Opcoes) -> bool {
    return (o.backend != none) and ((o.backend or_else "") == "x64")
}

// C: driver/opcoes.c:204
proc alvo_eh_linux(o: ?^Opcoes) -> bool {
    return ((o as ^Opcoes).target != none) and (((o as ^Opcoes).target or_else "") == OPCOES_ALVO_LINUX)
}

proc alvo_eh_wasm(o: ?^Opcoes) -> bool {
    return ((o as ^Opcoes).target or_else "") == OPCOES_ALVO_WASM
}

proc alvo_eh_android(o: ?^Opcoes) -> bool {
    return ((o as ^Opcoes).target or_else "") == OPCOES_ALVO_ANDROID
}

// I1: os dois alvos iOS (aparelho e simulador) entram no mesmo ramo a64
proc alvo_eh_ios(o: ?^Opcoes) -> bool {
    let alvo: str = (o as ^Opcoes).target or_else ""
    return (alvo == OPCOES_ALVO_IOS) or (alvo == OPCOES_ALVO_IOS_SIM)
}

// A4.1: o android e um a64 (mesmo backend, runtime a64_rt e libm); so a recusa e a aceitacao de --modo dll divergem
proc alvo_eh_a64(o: ?^Opcoes) -> bool {
    return ((((o as ^Opcoes).target or_else "") == OPCOES_ALVO_A64) or alvo_eh_android(o)) or alvo_eh_ios(o)
}

// C: driver/opcoes.c:210
proc compilacao_de_dev(o: ^Opcoes) -> bool {
    if o.projeto {
        return false
    }
    return ((common.c2f_b2i32(comando_eh(o, "build")) != 0) or (common.c2f_b2i32(comando_eh(o, "run")) != 0)) or (common.c2f_b2i32(comando_eh(o, "test")) != 0)
}

// C: driver/opcoes.c:216
proc opcoes_resolver_backend(o: ^Opcoes) {
    if (o.backend == none) and ((common.c2f_b2i32(compilacao_de_dev(o)) != 0) or (common.c2f_b2i32(alvo_eh_linux(o)) != 0) or alvo_eh_wasm(o) or alvo_eh_a64(o)) {
        o.backend = "x64"
    }
}

// C: driver/opcoes.c:221
proc opcoes_max_erros(o: ?^Opcoes) -> u32 {
    let oo: ^Opcoes = o as ^Opcoes
    if oo.max_erros == none {
        return 0
    }
    let texto: str = oo.max_erros or_else ""
    var fim: int = 0
    let n: i32 = common.c2f_strtol(texto, 10, &fim)
    // strtol leu algum numero (fim != inicio), parou no NUL (fim no fim do texto) e o valor esta em 1..DIAG_MAX
    if (fim > 0) and (fim == len(texto)) and (n >= 1) and (n <= common.DIAG_MAX) {
        return n as u32
    }
    return 0
}

// C: driver/opcoes.c:231
proc opcoes_jobs_texto(texto: ?str, n: ^u32) -> bool {
    let t: str = texto or_else ""
    if (texto == none) or (common.c2f_nul_em(t, 0) < 48) or (common.c2f_nul_em(t, 0) > 57) {
        return false
    }
    var fim: int = 0
    let v: i32 = common.c2f_strtol(t, 10, &fim)
    if (fim != len(t)) or (v < 1) or (v > OPCOES_JOBS_MAX) {
        return false
    }
    n^ = v as u32
    return true
}

// C: driver/opcoes.c:244
proc validar_max_erros(o: ^Opcoes) -> ?str {
    if (o.max_erros == none) or (opcoes_max_erros(o) != 0) {
        return none
    }
    return "--max-erros aceita um numero inteiro de 1 a 100"
}

// C: driver/opcoes.c:251
proc validar_build(o: ^Opcoes) -> ?str {
    if ((o.modo != none) and (not modo_eh_dll(o))) and ((o.modo or_else "") != "exe") {
        return "--modo aceita exe ou dll"
    }
    if (o.saida == none) and (not o.suporte) {
        return "build exige -o <saida>"
    }
    return none
}

// C: driver/opcoes.c:259
// forja test <prefixo>:<nome> (S4 P2): o ':' so conta depois de 2 caracteres e antes de '\' ou '/' (C:\x.fj e um arquivo).
proc entrada_eh_alvo(entrada: ?str) -> bool {
    let e: str = entrada or_else ""
    var dois: int = -1 // strchr(entrada, ':')
    var barra: int = len(e) // strcspn(entrada, "\\/")
    for k in 0..<len(e) {
        if (e[k] == 58) and (dois < 0) {
            dois = k
        }
        if ((e[k] == 92) or (e[k] == 47)) and (barra == len(e)) {
            barra = k
        }
    }
    if (dois < 0) or (dois < 2) {
        return false
    }
    return barra > dois
}

// C: driver/opcoes.c:267
// Prefixo do alvo (o texto antes do ':') tem que ser std, vendor ou engine.
proc prefixo_de_alvo_conhecido(entrada: ?str) -> bool {
    let e: str = entrada or_else ""
    var n: int = len(e) // strcspn(entrada, ":")
    for k in 0..<len(e) {
        if e[k] == 58 {
            n = k
            break
        }
    }
    for k in 0..<len(PREFIXOS_3) {
        if e[0..<n] == PREFIXOS_3[k] {
            return true
        }
    }
    return false
}

// C: driver/opcoes.c:279
proc validar_alvo_do_teste(o: ^Opcoes) -> ?str {
    if ((not comando_eh(o, "test")) or (o.entrada == none)) or (not entrada_eh_alvo(o.entrada)) {
        return none
    }
    if not prefixo_de_alvo_conhecido(o.entrada) {
        return "forja test aceita std:<modulo>, vendor:<modulo> ou engine:<modulo>"
    }
    return none
}

// C: driver/opcoes.c:287
proc validar_test_run(o: ^Opcoes) -> ?str {
    let saida_do_test_linux: bool = (common.c2f_b2i32(comando_eh(o, "test")) != 0) and (common.c2f_b2i32(alvo_eh_linux(o)) != 0)
    let erro_alvo: ?str = validar_alvo_do_teste(o)
    if erro_alvo != none {
        return erro_alvo
    }
    if (((o.saida != none) and (not saida_do_test_linux)) or (o.modo != none)) or (common.c2f_b2i32(o.tipos) != 0) {
        return "test e run nao aceitam -o, --modo ou --tipos"
    }
    if (common.c2f_b2i32(o.release) != 0) and (common.c2f_b2i32(comando_eh(o, "test")) != 0) {
        return "--release so vale em run e build exe"
    }
    return none
}

// C: driver/opcoes.c:299
proc validar_explicar(o: ^Opcoes) -> ?str {
    if (((((o.saida != none) or (o.modo != none)) or (o.tempos != none)) or (common.c2f_b2i32(o.tipos) != 0)) or (common.c2f_b2i32(o.release) != 0)) or (o.max_erros != none) {
        return "explicar so aceita o codigo do diagnostico"
    }
    return none
}

// C: driver/opcoes.c:306
proc validar_check_ast(o: ^Opcoes) -> ?str {
    if (common.c2f_b2i32(o.tipos) != 0) and (not comando_eh(o, "ast")) {
        return "--tipos so vale no comando ast"
    }
    if (o.no != none) and (common.c2f_nul_em(o.no or_else "", 0) == 0) { // '\0': o texto vazio (indexar o vazio daria R0006)
        return "--no precisa do id do no (campo \"id\" do forja ast)"
    }
    if o.release {
        return "--release so vale no build exe"
    }
    return none
}

