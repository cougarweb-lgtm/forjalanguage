}

// C: driver/opcoes.c:330
// --suporte --json lista o que o backend x64 recusa, sem gerar exe: so build --backend x64, e as duas marcas andam juntas.
proc validar_suporte(o: ^Opcoes) -> ?str {
    if (not o.suporte) and (not o.json) {
        return none
    }
    if not o.suporte {
        if comando_eh(o, "test") {
            return none
        }
        return "--json so vale com --suporte ou no test"
    }
    if (not comando_eh(o, "build")) or (not backend_eh_x64(o)) {
        return "--suporte so vale em build --backend x64"
    }
    if not o.json {
        return "--suporte exige --json"
    }
    if (o.saida != none) or (o.debug_code != none) {
        return "--suporte nao gera arquivo: sem -o nem --debug-code"
    }
    return none
}

