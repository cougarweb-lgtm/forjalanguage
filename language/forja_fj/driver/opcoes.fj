proc validar_perfil(o: ^Opcoes) -> ?str {
    let comando_ok: bool = ((common.c2f_b2i32(comando_eh(o, "build")) != 0) or (common.c2f_b2i32(comando_eh(o, "run")) != 0)) or (common.c2f_b2i32(comando_eh(o, "test")) != 0)
    if not o.perfil {
        return none
    }
    if ((not comando_ok) or (common.c2f_b2i32(modo_eh_dll(o)) != 0)) or (common.c2f_b2i32(o.suporte) != 0) {
