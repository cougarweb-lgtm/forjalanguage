import "common"
import "frontend"

// C: driver/consultar_modulos.c:15 (NOMES, indexada pelo campo origem do modulo)
const ORIGENS_DO_MODULO: [5]str = {"raiz", "arquivo", "std", "vendor", "engine"}

// C: driver/consultar_modulos.c:13
proc consulta_origem_do_modulo(q: ^Consulta, modulo: u8) -> str {
    let origem: u8 = (q.c as ^Compilacao).modulos.itens[modulo].origem
    return ORIGENS_DO_MODULO[origem]
}

// C: driver/consultar_modulos.c:19
proc consulta_qtd_arquivos(q: ^Consulta, modulo: u8) -> u32 {
    var primeiro: u32 = 0
    return frontend.modulos_trechos_do_pacote(&(q.c as ^Compilacao).modulos, (q.c as ^Compilacao).fonte.ntrechos, modulo, &primeiro)
}

// C: driver/consultar_modulos.c:26
proc consulta_offset_do_modulo(q: ^Consulta, modulo: u8) -> u32 {
    let f: ^common.Fonte = &(q.c as ^Compilacao).fonte
    var primeiro: u32 = 0
    _ = frontend.modulos_trechos_do_pacote(&(q.c as ^Compilacao).modulos, f.ntrechos, modulo, &primeiro)
    var tern_1: u32 = 0
    if f.ntrechos != 0 {
        tern_1 = (f.trechos or_else {})[primeiro].inicio
    }
    return tern_1
}

// C: driver/consultar_modulos.c:35
proc consulta_trecho_do_offset(q: ^Consulta, off: u32) -> u32 {
    return common.fonte_trecho_do_offset(&(q.c as ^Compilacao).fonte, off)
}

// C: driver/consultar_modulos.c:40
proc consulta_inicio_do_arquivo(q: ^Consulta, off: u32) -> u32 {
    let f: ^common.Fonte = &(q.c as ^Compilacao).fonte
    var tern_1: u32 = 0
    if f.ntrechos == 0 {
        tern_1 = 0
    } else {
        tern_1 = (f.trechos or_else {})[common.fonte_trecho_do_offset(f, off)].inicio
    }
    return tern_1
}

// C: driver/consultar_modulos.c:47
proc consulta_fim_do_arquivo(q: ^Consulta, off: u32) -> u32 {
    let f: ^common.Fonte = &(q.c as ^Compilacao).fonte
    var tern_1: u32 = 0
    if f.ntrechos == 0 {
        tern_1 = f.tam as u32
    } else {
        tern_1 = (f.trechos or_else {})[common.fonte_trecho_do_offset(f, off)].fim
    }
    return tern_1
}

// C: driver/consultar_modulos.c:54
proc consulta_modulo_do_offset(q: ^Consulta, off: u32) -> u8 {
    let arg_1: u32 = common.fonte_trecho_do_offset(&(q.c as ^Compilacao).fonte, off)
    let arg_2: ^frontend.Modulos = &(q.c as ^Compilacao).modulos
    return frontend.modulos_pacote_do_arquivo(arg_2, arg_1)
}

// C: driver/consultar_modulos.c:60
proc linhas_do_texto(f: ^common.Fonte, ini: u32, fim: u32) -> u64 {
    var linhas: u64 = 0
    for i in ini..<fim {
        if f.texto[i] == 10 { // '\n'
            linhas += 1
        }
    }
    if (fim > ini) and (f.texto[fim - 1] != 10) { // '\n'
        linhas += 1
    }
    return linhas
}

// C: driver/consultar_modulos.c:71
proc consulta_linhas_do_modulo(q: ^Consulta, modulo: u8) -> u64 {
    let f: ^common.Fonte = &(q.c as ^Compilacao).fonte
    var primeiro: u32 = 0
    let n: u32 = frontend.modulos_trechos_do_pacote(&(q.c as ^Compilacao).modulos, f.ntrechos, modulo, &primeiro)
    var linhas: u64 = 0
    if f.ntrechos == 0 {
        return linhas_do_texto(f, 0, f.tam as u32)
    }
    for t in primeiro..<(primeiro + n) {
        linhas += linhas_do_texto(f, (f.trechos or_else {})[t].inicio, (f.trechos or_else {})[t].fim)
    }
    return linhas
}

// C: driver/consultar_modulos.c:82
proc consulta_bytes_do_modulo(q: ^Consulta, modulo: u8) -> u64 {
    let f: ^common.Fonte = &(q.c as ^Compilacao).fonte
    var primeiro: u32 = 0
    let n: u32 = frontend.modulos_trechos_do_pacote(&(q.c as ^Compilacao).modulos, f.ntrechos, modulo, &primeiro)
    var bytes: u64 = 0
    if f.ntrechos == 0 {
        return f.tam
    }
    for t in primeiro..<(primeiro + n) {
        bytes += ((f.trechos or_else {})[t].fim - (f.trechos or_else {})[t].inicio) as u64
    }
    return bytes
}

// C: driver/consultar_modulos.c:93
proc consulta_chave_arquivo_se_pacote(q: ^Consulta, off: u32) {
    if consulta_qtd_arquivos(q, consulta_modulo_do_offset(q, off)) > 1 {
        consulta_chave_arquivo(q, off)
    }
}

// C: driver/consultar_modulos.c:99
proc consulta_chave_arquivos(q: ^Consulta, modulo: u8) {
    let f: ^common.Fonte = &(q.c as ^Compilacao).fonte
    var primeiro: u32 = 0
    let n: u32 = frontend.modulos_trechos_do_pacote(&(q.c as ^Compilacao).modulos, f.ntrechos, modulo, &primeiro)
    if n < 2 {
        return
    }
    consulta_abrir_lista(q, "arquivos")
    for t in primeiro..<(primeiro + n) {
        consulta_item_caminho(q, ((f.trechos or_else {})[t].caminho or_else ""))
    }
    consulta_fechar_lista(q)
}

// C: driver/consultar_modulos.c:110
// C2F-INDECIDIVEL: ordem
proc consulta_ordem_dos_modulos(q: ^Consulta, ordem: []u8) -> i32 {
    let m: ^frontend.Modulos = &(q.c as ^Compilacao).modulos
    var n: i32 = 1
    ordem[0] = 0
    var i: u32 = 0
    while (m.n > 1) and (i < m.n) {
        if (m.ordem or_else {})[i] != 0 {
            let antes_1: i32 = n
            n += 1
            ordem[antes_1] = (m.ordem or_else {})[i]
        }
        i += 1
    }
    return n
}

// C: driver/consultar_modulos.c:122
proc consulta_achar_modulo(q: ^Consulta, caminho: ?str) -> i32 {
    let alvo: str = caminho or_else ""
    let nomes: ^common.Interner = &(q.c as ^Compilacao).nomes
    var k: u32 = 0
    while k < (q.c as ^Compilacao).modulos.n {
        let nome: i32 = (q.c as ^Compilacao).modulos.itens[k].caminho
        if common.interner_texto(nomes, nome)[0..<common.interner_tam(nomes, nome)] == alvo {
            return k as i32
        }
        k += 1
    }
    return -1
}

// C: driver/consultar_modulos.c:134
proc apelido_do_import_2(q: ^Consulta, imp: ?^frontend.Decl) -> i32 {
    var tern_1: i32 = 0
    if (imp as ^frontend.Decl).nome_a >= 0 {
        tern_1 = (imp as ^frontend.Decl).nome_a
    } else {
        tern_1 = (q.c as ^Compilacao).modulos.itens[(imp as ^frontend.Decl).indice].apelido
    }
    return tern_1
}

// C: driver/consultar_modulos.c:139
proc importa_json(q: ^Consulta, modulo: u8) {
    consulta_abrir_lista(q, "importa")
    var d: ?^frontend.Decl = ((q.c as ^Compilacao).sem.programa as ^frontend.Programa).primeira
    while d != none {
        if ((d as ^frontend.Decl).tipo_no != (frontend.D_IMPORT as u8)) or (((d as ^frontend.Decl).modulo as i32) != (modulo as i32)) {
            d = (d as ^frontend.Decl).prox
            continue
        }
        consulta_abrir_obj(q)
        consulta_chave_modulo(q, "modulo", (d as ^frontend.Decl).indice as u8)
        consulta_chave_nome(q, "apelido", apelido_do_import_2(q, d))
        consulta_chave_arquivo_se_pacote(q, (d as ^frontend.Decl).pos)
        consulta_chave_pos(q, "pos", (d as ^frontend.Decl).pos)
        consulta_fechar_obj(q)
        d = (d as ^frontend.Decl).prox
    }
    consulta_fechar_lista(q)
}

// C: driver/consultar_modulos.c:155
proc ja_importou_antes(q: ^Consulta, imp: ?^frontend.Decl) -> bool {
    let alvo: ^frontend.Decl = imp as ^frontend.Decl
    var d: ?^frontend.Decl = ((q.c as ^Compilacao).sem.programa as ^frontend.Programa).primeira
    while (d != none) and (d != imp) {
        let atual: ^frontend.Decl = d as ^frontend.Decl
        if (atual.tipo_no == (frontend.D_IMPORT as u8)) and (atual.indice == alvo.indice) and (atual.modulo == alvo.modulo) {
            return true
        }
        d = atual.prox
    }
    return false
}

// C: driver/consultar_modulos.c:163
proc importado_por_json(q: ^Consulta, modulo: u8) {
    consulta_abrir_lista(q, "importado_por")
    var d: ?^frontend.Decl = ((q.c as ^Compilacao).sem.programa as ^frontend.Programa).primeira
    while d != none {
        if (((d as ^frontend.Decl).tipo_no == (frontend.D_IMPORT as u8)) and ((d as ^frontend.Decl).indice == (modulo as i32))) and (not ja_importou_antes(q, d)) {
            consulta_item_modulo(q, (d as ^frontend.Decl).modulo)
        }
        d = (d as ^frontend.Decl).prox
    }
    consulta_fechar_lista(q)
}

// C: driver/consultar_modulos.c:172
proc consulta_links_json(q: ^Consulta, chave: str, modulo: i32) {
    consulta_abrir_lista(q, chave)
    var d: ?^frontend.Decl = ((q.c as ^Compilacao).sem.programa as ^frontend.Programa).primeira
    while d != none {
        if ((d as ^frontend.Decl).tipo_no != (frontend.D_LINK as u8)) or ((modulo >= 0) and (((d as ^frontend.Decl).modulo as i32) != modulo)) {
            d = (d as ^frontend.Decl).prox
            continue
        }
        consulta_abrir_obj(q)
        consulta_chave_nome(q, "lib", (d as ^frontend.Decl).nome)
        consulta_chave_modulo(q, "modulo", (d as ^frontend.Decl).modulo)
        consulta_chave_arquivo_se_pacote(q, (d as ^frontend.Decl).pos)
        consulta_chave_pos(q, "pos", (d as ^frontend.Decl).pos)
        consulta_fechar_obj(q)
        d = (d as ^frontend.Decl).prox
    }
    consulta_fechar_lista(q)
}

// C: driver/consultar_modulos.c:187
proc consulta_modulo_json(q: ^Consulta, modulo: u8) {
    consulta_abrir_obj(q)
    consulta_chave_modulo(q, "modulo", modulo)
    let arg_1: u64 = len(consulta_origem_do_modulo(q, modulo)) as u64
    let arg_2: str = consulta_origem_do_modulo(q, modulo)
    let arg_3: str = "origem"
    let arg_4: ^Consulta = q
    consulta_chave_texto(arg_4, arg_3, arg_2, arg_1)
    consulta_chave_arquivo(q, consulta_offset_do_modulo(q, modulo))
    consulta_chave_arquivos(q, modulo)
    consulta_chave_int(q, "linhas", transmute(consulta_linhas_do_modulo(q, modulo), to = i64))
    importa_json(q, modulo)
    importado_por_json(q, modulo)
    consulta_links_json(q, "links", modulo as i32)
    consulta_fechar_obj(q)
}

// C: driver/consultar_modulos.c:201
proc consultar_imports(q: ^Consulta, p: ^PedidoConsulta) -> i32 {
    var ordem: [255]u8 = {}
    let n: i32 = consulta_ordem_dos_modulos(q, ordem[..])
    consulta_abrir(q, "imports")
    consulta_abrir_lista(q, "modulos")
    var i: i32 = 0
    while i < n {
        consulta_modulo_json(q, ordem[i])
        i += 1
    }
    consulta_fechar_lista(q)
    consulta_links_json(q, "links", -1)
    consulta_fechar(q)
    return CONSULTAR_OK
}
