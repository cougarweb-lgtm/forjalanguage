import "frontend"
import "semantic"

struct PedidoConsulta {
    pergunta: ?str
    arg: ?str
    alvo: ?str
    modulo: ?str
    resumo: bool
    limite: u32
    contexto: rawptr // C2F-VOID
}

struct Consulta {
    c: ?^Compilacao
    indice: semantic.Indice
    fim: frontend.AstFim
    saida: [dynamic]u8
    primeiro: bool
}

struct AlvoRefs {
    tipo: i32
    decl: ?^frontend.Decl
    indice: i32
    nome: i32
    decl_pos: u32
}

struct ListaAlvos {
    itens: [64]AlvoRefs
    n: u32
}

struct PosicaoPedida {
    off: u32
    linha: u32
    coluna: u32
    arquivo: ?str
}

const CONSULTAR_OK: i32 = 0
const CONSULTAR_DIAGNOSTICO: i32 = 1
const CONSULTAR_USO: i32 = 2
const CONSULTAR_INTERNO: i32 = 3
const CONSULTAR_VERSAO: str = "1.1.0"

pub const FUNCAO_RESPOSTA_RESPONDER: u16 = 1
pub const FUNCAO_RESPOSTA_MAPA_RESPONDER: u16 = 2
pub const FUNCAO_RESPOSTA_CONSULTAR_API: u16 = 3
pub const FUNCAO_RESPOSTA_CONSULTAR_TESTES: u16 = 4
pub const FUNCAO_RESPOSTA_CONSULTAR_ENTRADA: u16 = 5
pub const FUNCAO_RESPOSTA_CONSULTAR_SIMBOLOS: u16 = 6
pub const FUNCAO_RESPOSTA_CONSULTAR_ASSINATURA: u16 = 7
pub const FUNCAO_RESPOSTA_CONSULTAR_CAMPOS: u16 = 8
pub const FUNCAO_RESPOSTA_CONSULTAR_ESCOPO: u16 = 9
pub const FUNCAO_RESPOSTA_CONSULTAR_CALLERS: u16 = 10
pub const FUNCAO_RESPOSTA_CONSULTAR_CALLEES: u16 = 11
pub const FUNCAO_RESPOSTA_CONSULTAR_IMPORTS: u16 = 12
pub const FUNCAO_RESPOSTA_CONSULTAR_TIPO: u16 = 13
pub const FUNCAO_RESPOSTA_CONSULTAR_REFS: u16 = 14
pub proc chamar_funcao_resposta(tag: u16, q: ^Consulta, pc: ^PedidoConsulta) -> i32 {
    if tag == 1 {
        return responder(q, pc)
    }
    if tag == 2 {
        return mapa_responder(q, pc)
    }
    if tag == 3 {
        return consultar_api(q, pc)
    }
    if tag == 4 {
        return consultar_testes(q, pc)
    }
    if tag == 5 {
        return consultar_entrada(q, pc)
    }
    if tag == 6 {
        return consultar_simbolos(q, pc)
    }
    if tag == 7 {
        return consultar_assinatura(q, pc)
    }
    if tag == 8 {
        return consultar_campos(q, pc)
    }
    if tag == 9 {
        return consultar_escopo(q, pc)
    }
    if tag == 10 {
        return consultar_callers(q, pc)
    }
    if tag == 11 {
        return consultar_callees(q, pc)
    }
    if tag == 12 {
        return consultar_imports(q, pc)
    }
    if tag == 13 {
        return consultar_tipo(q, pc)
    }
    if tag == 14 {
        return consultar_refs(q, pc)
    }
    // C: o ponteiro de FuncaoResposta nunca e nulo; tag fora de 1..14 e erro de programa (o C cairia num ponteiro nulo)
    panic("driver.chamar_funcao_resposta: tag de resposta desconhecida")
    return 0
}
