import "common"
import "nativo"

// C: driver/main_uso.c:40
proc main_uso_errado(motivo: ?str) -> i32 {
    let txt_1 = motivo or_else "(null)"
    let msg_1 = format(f"forja: {txt_1}\n", alloc = heap)
    defer delete(msg_1)
    common.c2f_saida_formatar(common.c2f_saida_stderr(), msg_1)
    common.c2f_saida_escrever_texto(common.c2f_saida_stderr(), "uso: forja check [--stdin] [--canonico] [--max-erros N] <arq.fj> [--tempos <t.json>]\n     forja ast [--tipos] [--sem-pos] [--no <id>] [--projeto] <arq.fj | pasta> [--tempos <t.json>]\n     forja build [--modo exe] [--release] <arq.fj> -o <saida.exe> [--tempos <t.json>]\n     forja build --modo dll [--release] <arq.fj> -o <saida.dll> [--tempos <t.json>]\n     forja build --projeto [forja.proj] [--release] [--jobs N] [--plano] [--tudo] [--json]\n     forja test <arq.fj> [--filtro <trecho>] [--json] [--limite-tempo <seg>] [--limite-mem <MiB>] [--limite-saida <bytes|KiB|MiB>]\n     forja run [--release] <arq.fj> [--args-file <arq>] [limites do test] [-- <argumentos do programa>]\n     limites (run e test; valem so para o programa, nao para a compilacao): passou do tempo = R0013 e exit 102, da memoria = R0014 e exit 103, da saida = R0015 e exit 104 (saida cortada no limite)\n     --args-file: UTF-8, um argumento por linha (LF ou CRLF); linha vazia = argumento vazio; \\n e \\\\ escapam; vem antes dos argumentos depois do '--'\n     forja explicar <CODIGO> | --lista [--json] | [CODIGO] --exemplos\n     forja spec [--cartao] [--receitas] [--secao S] [--json] [--exemplo CODIGO] [CODIGO]\n     forja corrigir <arq.fj> [--codigo CODIGO] [--aplicar] [--tambem-provavel]\n     forja migrar <arq.fj | pasta> ... [--dry-run | --aplicar] [--comentarios] [--json]\n     forja fmt <arq.fj | pasta> ... [--aplicar] [--json] [--stdin]\n     forja editar <arq.fj | pasta> --ops <ops.json> [--aplicar]\n     forja consultar simbolos|escopo|refs|tipo|assinatura|campos|callers|callees|api <argumento> [<arq.fj | pasta>] [--modulo <caminho>] [--json]\n     forja consultar api std:<modulo> | vendor:<modulo>: sem arquivo; o E1001 de modulo ausente lista os disponiveis e sugere o parecido\n     forja consultar imports|testes|entrada [<arq.fj | pasta>] [--json]\n     forja mapa [<arq.fj | pasta>] [--json | --resumo] [--modulo <caminho>] [--limite <N>]\n     forja ligar <header.h> --link <lib> [-o saida.fj] [--propor: propoe creates/destroys nos procs, com comentario para conferir]\n     forja --versao\n     --resumo (check, build, run e test): cada diagnostico so com codigo, arquivo, linha, coluna, causa e sugestao; FORJA_LOG_DIAG=<arq.jsonl> anexa cada diagnostico ao arquivo\n     --rastreio (build, run e test): o erro de execucao (R-code) leva coluna, valor (R0006: indice e tamanho) e pilha .fj; no backend x64 em dev isso e o padrao (a flag fica redundante)\n     --checagem sim|nao (build, run e test): so com --release; padrao sim: confere indice/fatia (R0006) e nulo (R0005) como o dev; nao desliga por build; o dev sempre confere\n     --sem-otim <passo[,passo...]|tudo> (build, run e test): so com --release; desliga passes de otimizacao da BIR (passos registrados: checagem, que tira conferencia provada; copia_arg, que passa o endereco da origem no argumento agregado quando o chamado so le; inline, que troca a chamada de funcao folha pequena (com ou sem laco) pela copia do corpo e desenrola 1 nivel da recursao direta curta; sroa, que troca o agregado local pequeno de acesso simples por variaveis (registradores); slp, que troca 4 gravacoes f32 (2 f64) contiguas da mesma conta lane a lane por carga, conta e gravacao vetoriais (SSE); selecao, que troca losango ou triangulo puro (sem trap, memoria ou chamada) por selecao sem desvio (cmov; minss/maxss em real); cfg, que enfia salto em salto e funde bloco com o unico sucessor; costura, que copia bloco pequeno puro para a aresta em que o desvio dele ja se decide (jump threading com faixa do parametro);numeracao, que reaproveita conta, carga e copia ja calculadas; licm, que sobe para o pre-cabecalho a aritmetica pura invariante do laco; endereco, que recoloca a conta de endereco compartilhada na frente de cada carga e gravacao; layout, que ordena os blocos para o sucessor quente cair direto; alocador, que poe os inteiros em registradores; isel; divconst, que troca divisao e resto por constante por multiplicacao e deslocamento e so age com o isel ligado: --sem-otim isel desliga os dois)\n     --guarda-memoria (build, run e test): o exe leva a tabela de linhas para o relato de uso de memoria liberada; so vale em dev, backend x64, exe (nao com --release nem --modo dll)\n     --perfil (build, run e test; dev e --release; so exe, windows e linux): cada proc de usuario ganha entrada e saida medidas; ao fim o exe grava <exe>.perfil.json (Chrome Trace, abre no Perfetto) e <exe>.perfil.txt (agregado por proc, o que a IA le); FORJA_PERFIL_SAIDA=<base sem extensao> troca o caminho; procs inlinadas nao aparecem (--sem-otim inline); nao vale com --modo dll nem --suporte\n     --simbolos sim|nao (build e test): grava DWARF no executavel para depurar com gdb e, no windows x64, o .pdb ao lado do exe; padrao: sim em dev, nao em --release (alvos windows e linux)\n     --backend x64 (build, run e test; o unico valor; padrao: x64 em dev e --release)\n     --target x86_64-windows|x86_64-linux|wasm32-wasip1|aarch64-linux|aarch64-linux-android|aarch64-apple-ios|aarch64-apple-ios-sim (aarch64-linux e aarch64-linux-android so build, este aceita --modo dll; os iOS saem com X0003 ate o Mach-O da I2; build e test; o linux implica --backend x64 e test exige -o; wasm32-wasip1 so aceita build e gera .wasm WASI preview1)\n")
    return nativo.SAIDA_USO
}
