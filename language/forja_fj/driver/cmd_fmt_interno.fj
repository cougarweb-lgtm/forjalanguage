struct FmtPedido {
    entradas: ?[]str
    nentradas: i32
    aplicar: bool
    json: bool
    stdin_padrao: bool
    regras: bool
}

struct FmtTotais {
    arquivos: u32
    canonicos: u32
    mudariam: u32
    gravados: u32
    nao_analisados: u32
}

struct FmtExecucao {
    pedido: ?^FmtPedido
    totais: FmtTotais
    json: [dynamic]u8
}

const FMT_ARQ_CANONICO: i32 = 0
const FMT_ARQ_MUDARIA: i32 = 1
const FMT_ARQ_GRAVADO: i32 = 2
const FMT_ARQ_NAO_ANALISADO: i32 = 3
