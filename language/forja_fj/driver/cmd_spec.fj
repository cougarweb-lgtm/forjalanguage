// Changelog: 0.2.0 - G3 V5-X: corpos reais (stubs zerados). A saida (stdout) e um Saida criado em rodar_spec e passado aos procs; ler_valor recebe ^?str; listar_secoes e a lista passam como fatia do tamanho exato (n); emitir_bruto e os procs de impressao recebem a saida.

import "common"

struct Pedido5 {
    cartao: bool
    json: bool
    receitas: bool
    secao: ?str
    exemplo: ?str
    codigo: ?str
}

const SAIDA_OK_5: i32 = 0
const SAIDA_USO_5: i32 = 2

// C: driver/cmd_spec.c:28
proc uso_errado_8(motivo: ?str) -> i32 {
    let txt_1 = motivo or_else "(null)"
    let msg_1 = format(f"forja: spec: {txt_1}\n", alloc = heap)
    defer delete(msg_1)
    let erro = common.c2f_saida_stderr()
    common.c2f_saida_formatar(erro, msg_1)
    common.c2f_saida_escrever_texto(erro, "uso: forja spec [--cartao] [--receitas] [--secao S] [--json] [--exemplo CODIGO] [CODIGO]\n")
    _ = common.c2f_saida_fechar(erro)
    return SAIDA_USO_5
}

// C: driver/cmd_spec.c:36
// Muda o tipo de destino para ^?str: o C guardava const char* no campo do Pedido (NULL = ausente); k e o indice do argv, avancado aqui.
proc ler_valor(argc: i32, argv: []str, k: ^i32, destino: ^?str) -> ?str {
    if k^ + 1 >= argc {
        return "a opcao exige um valor"
    }
    k^ = k^ + 1
    destino^ = argv[k^]
    return none
}

// C: driver/cmd_spec.c:44
proc ler_opcoes(argc: i32, argv: []str, p: ^Pedido5) -> ?str {
    var motivo: ?str = none
    var k: i32 = 0
    while k < argc and motivo == none {
        let arg = argv[k]
        if arg == "--cartao" {
            p.cartao = true
        } else if arg == "--receitas" {
            p.receitas = true
        } else if arg == "--json" {
            p.json = true
        } else if arg == "--secao" {
            motivo = ler_valor(argc, argv, &k, &p.secao)
        } else if arg == "--exemplo" {
            motivo = ler_valor(argc, argv, &k, &p.exemplo)
        } else if common.c2f_nul_em(arg, 0) == 45 { // '-'
            motivo = "opcao desconhecida"
        } else if p.codigo != none {
            motivo = "so um codigo por vez"
        } else {
            p.codigo = arg
        }
        k += 1
    }
    return motivo
}

// C: driver/cmd_spec.c:63
proc validar_pedido(p: ^Pedido5) -> ?str {
    if (common.c2f_b2i32(p.receitas) != 0) and (((((p.secao != none) or (common.c2f_b2i32(p.cartao) != 0)) or (common.c2f_b2i32(p.json) != 0)) or (p.exemplo != none)) or (p.codigo != none)) {
        return "--receitas nao combina com as outras opcoes"
    }
    if (p.exemplo != none) and (((p.secao != none) or (common.c2f_b2i32(p.cartao) != 0)) or (p.codigo != none)) {
        return "--exemplo nao combina com --secao, --cartao nem CODIGO"
    }
    if (p.codigo != none) and ((p.secao != none) or (common.c2f_b2i32(p.cartao) != 0)) {
        return "CODIGO nao combina com --secao nem --cartao"
    }
    if (p.codigo != none) and (common.diag_codigo_por_texto(p.codigo) < 0) {
        return "codigo de diagnostico desconhecido (veja 'forja explicar --lista')"
    }
    if (p.exemplo != none) and (common.diag_codigo_por_texto(p.exemplo) < 0) {
        return "codigo de diagnostico desconhecido (veja 'forja explicar --lista')"
    }
    return none
}

// C: driver/cmd_spec.c:73
proc emitir_bruto(saida: ^common.Saida, t: common.DocTexto) {
    common.c2f_saida_escrever(saida, t.texto[0..<(t.tam as int)])
}

// C: driver/cmd_spec.c:81
// A lista tem 17 posicoes (SPEC_SECOES_MAX + 1: a migracao cabe na ultima); o retorno n diz quantas estao preenchidas.
proc listar_secoes(cartao: bool, lista: []common.SpecSecao) -> u64 {
    var fonte = common.DOC_SPEC
    if cartao {
        fonte = common.DOC_CARTAO
    }
    let n = common.spec_secoes(fonte, lista, common.SPEC_SECOES_MAX as u64)
    if cartao {
        return n
    }
    lista[n].nome = "migracao"
    lista[n].bloco = common.doc_embutida(common.DOC_MIGRACAO)
    lista[n].corpo = lista[n].bloco
    return n + 1
}

// C: driver/cmd_spec.c:91
// C2F-13: lista fundido em n (len)
proc secao_desconhecida(nome: ?str, lista: []common.SpecSecao) -> i32 {
    let erro = common.c2f_saida_stderr()
    let txt_1 = nome or_else "(null)"
    let msg_1 = format(f"forja: spec: secao desconhecida: {txt_1}\nsecoes:", alloc = heap)
    defer delete(msg_1)
    common.c2f_saida_formatar(erro, msg_1)
    for k in (0 as u64)..<(len(lista) as u64) {
        let txt_2 = lista[k].nome or_else "(null)"
        let msg_2 = format(f" {txt_2}", alloc = heap)
        defer delete(msg_2)
        common.c2f_saida_formatar(erro, msg_2)
    }
    common.c2f_saida_putc(erro, 10) // '\n'
    _ = common.c2f_saida_fechar(erro)
    return SAIDA_USO_5
}

// C: driver/cmd_spec.c:99
proc mostrar_secao(saida: ^common.Saida, p: ^Pedido5) -> i32 {
    var lista: [17]common.SpecSecao = {}
    let n = listar_secoes(p.cartao, lista[..])
    let secoes = lista[0..<(n as int)]
    let achada = common.spec_achar_secao(secoes, p.secao)
    if achada == none {
        return secao_desconhecida(p.secao, secoes)
    }
    emitir_bruto(saida, (achada as ^common.SpecSecao).bloco)
    return SAIDA_OK_5
}

// C: driver/cmd_spec.c:110
// strchr(" \r\n\t", c) do C tambem casa o NUL: por isso o 0 entra no conjunto.
proc sem_fim_em_branco(t: common.DocTexto) -> common.DocTexto {
    var fim = t
    while fim.tam > 0 {
        let c = fim.texto[(fim.tam - 1) as int]
        if c != 32 and c != 13 and c != 10 and c != 9 and c != 0 {
            break
        }
        fim.tam -= 1
    }
    return fim
}

// C: driver/cmd_spec.c:116
proc imprimir_secao_json(saida: ^common.Saida, s: ^common.SpecSecao) {
    let nome = s.nome or_else ""
    common.c2f_saida_escrever_texto(saida, "{\"id\": \"")
    common.c2f_saida_escrever_texto(saida, nome)
    common.c2f_saida_escrever_texto(saida, "\", \"titulo\": \"")
    var primeiro = common.c2f_nul_em(nome, 0)
    if primeiro >= 97 and primeiro <= 122 { // toupper ASCII (locale C)
        primeiro -= 32
    }
    common.c2f_saida_putc(saida, primeiro)
    if len(nome) > 1 {
        common.c2f_saida_escrever_texto(saida, nome[1..<len(nome)])
    }
    common.c2f_saida_escrever_texto(saida, "\", \"texto\": ")
    common.spec_imprimir_texto_json(saida, sem_fim_em_branco(s.corpo))
    common.c2f_saida_putc(saida, 125) // '}'
}

// C: driver/cmd_spec.c:123
proc mostrar_json(saida: ^common.Saida, p: ^Pedido5, versao: str) -> i32 {
    var lista: [17]common.SpecSecao = {}
    let n = listar_secoes(p.cartao, lista[..])
    let secoes = lista[0..<(n as int)]
    if p.secao != none and common.spec_achar_secao(secoes, p.secao) == none {
        return secao_desconhecida(p.secao, secoes)
    }
    common.c2f_saida_escrever_texto(saida, "{\"versao\": \"")
    common.c2f_saida_escrever_texto(saida, versao)
    common.c2f_saida_escrever_texto(saida, "\", \"secoes\": [")
    var primeira = true
    for k in (0 as u64)..<n {
        if p.secao != none and (lista[k].nome or_else "") != (p.secao or_else "") {
            continue
        }
        if not primeira {
            common.c2f_saida_escrever_texto(saida, ", ")
        }
        imprimir_secao_json(saida, &lista[k])
        primeira = false
    }
    common.c2f_saida_escrever_texto(saida, "]}\n")
    return SAIDA_OK_5
}

// C: driver/cmd_spec.c:143
proc mostrar_spec_do_codigo(saida: ^common.Saida, p: ^Pedido5) -> i32 {
    var texto: [2048]u8 = {}
    common.diag_spec_texto(p.codigo, texto[..], common.DIAG_SPEC_MAX as u64)
    let tam = common.c2f_strlen_b(texto[..])
    if not p.json {
        common.c2f_saida_escrever(saida, texto[0..<tam])
        common.c2f_saida_putc(saida, 10) // '\n'
        return SAIDA_OK_5
    }
    common.c2f_saida_escrever_texto(saida, "{\"codigo\": \"")
    common.c2f_saida_escrever_texto(saida, p.codigo or_else "")
    common.c2f_saida_escrever_texto(saida, "\", \"spec\": ")
    common.spec_imprimir_texto_json(saida, common.DocTexto{texto = texto[0..<tam], tam = tam as u64})
    common.c2f_saida_escrever_texto(saida, "}\n")
    return SAIDA_OK_5
}

// C: driver/cmd_spec.c:158
proc imprimir_bloco_texto(saida: ^common.Saida, bloco: common.DocTexto) {
    var resto = bloco
    var linha = common.DocTexto{}
    while common.spec_proxima_linha(&resto, &linha) {
        var pular: u64 = 0
        if linha.tam >= 2 {
            pular = 2
        } else {
            pular = linha.tam
        }
        common.c2f_saida_escrever_texto(saida, "    ")
        common.c2f_saida_escrever(saida, linha.texto[(pular as int)..<(linha.tam as int)])
        common.c2f_saida_putc(saida, 10) // '\n'
    }
}

// C: driver/cmd_spec.c:171
proc imprimir_exemplo_texto(saida: ^common.Saida, e: ^common.SpecExemplo) {
    let codigo = e.codigo or_else ""
    let linha = format(f"{e.linha}", alloc = heap)
    defer delete(linha)
    common.c2f_saida_escrever_texto(saida, "exemplo ")
    common.c2f_saida_escrever_texto(saida, codigo)
    common.c2f_saida_escrever_texto(saida, " (")
    common.c2f_saida_escrever(saida, e.fixture.texto[0..<(e.fixture.tam as int)])
    common.c2f_saida_escrever_texto(saida, ", linha ")
    common.c2f_saida_escrever_texto(saida, linha)
    common.c2f_saida_escrever_texto(saida, ")\nerrado:\n")
    imprimir_bloco_texto(saida, e.errado)
    if e.certo.tam > 0 {
        common.c2f_saida_escrever_texto(saida, "certo:\n")
        imprimir_bloco_texto(saida, e.certo)
    } else {
        common.c2f_saida_escrever_texto(saida, "certo: (a bateria nao tem conserto automatico verificado para este codigo)\n")
    }
    common.c2f_saida_escrever_texto(saida, "forma certa: ")
    common.c2f_saida_escrever(saida, e.forma.texto[0..<(e.forma.tam as int)])
    common.c2f_saida_escrever_texto(saida, "\n")
}

// C: driver/cmd_spec.c:184
proc mostrar_exemplo(saida: ^common.Saida, p: ^Pedido5) -> i32 {
    var e: common.SpecExemplo = common.SpecExemplo{}
    if not common.spec_exemplo_do_codigo(p.exemplo, &e) {
        let txt_1 = p.exemplo or_else "(null)"
        let txt_2 = p.exemplo or_else "(null)"
        let msg_1 = format(f"forja: spec: {txt_1} nao tem exemplo na bateria (veja 'forja explicar {txt_2}')\n", alloc = heap)
        defer delete(msg_1)
        let erro = common.c2f_saida_stderr()
        common.c2f_saida_formatar(erro, msg_1)
        _ = common.c2f_saida_fechar(erro)
        return SAIDA_USO_5
    }
    if p.json {
        common.spec_imprimir_exemplo_json(saida, &e)
        common.c2f_saida_putc(saida, 10) // '\n'
    } else {
        imprimir_exemplo_texto(saida, &e)
    }
    return SAIDA_OK_5
}

// C: driver/cmd_spec.c:201 (o despacho dos ramos de RodarSpec, na ordem do C)
proc despachar_spec(saida: ^common.Saida, p: ^Pedido5, versao: str) -> i32 {
    if p.receitas {
        emitir_bruto(saida, common.doc_embutida(common.DOC_RECEITAS))
        return SAIDA_OK_5
    }
    if p.exemplo != none {
        return mostrar_exemplo(saida, p)
    }
    if p.codigo != none {
        return mostrar_spec_do_codigo(saida, p)
    }
    if p.json {
        return mostrar_json(saida, p, versao)
    }
    if p.secao != none {
        return mostrar_secao(saida, p)
    }
    var fonte = common.DOC_SPEC
    if p.cartao {
        fonte = common.DOC_CARTAO
    }
    emitir_bruto(saida, common.doc_embutida(fonte))
    return SAIDA_OK_5
}

// C: driver/cmd_spec.c:201
proc rodar_spec(argc: i32, argv: []str, versao: str) -> i32 {
    var p = Pedido5{}
    var motivo = ler_opcoes(argc, argv, &p)
    if motivo == none {
        motivo = validar_pedido(&p)
    }
    if motivo != none {
        return uso_errado_8(motivo)
    }
    let saida = common.c2f_saida_stdout()
    common.c2f_saida_binaria(saida) // _setmode(_fileno(stdout), _O_BINARY): o texto da doc ja leva o CRLF dele
    let resultado = despachar_spec(saida, &p, versao)
    _ = common.c2f_saida_fechar(saida)
    return resultado
}
