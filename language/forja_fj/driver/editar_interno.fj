import "common"

struct ArquivoEditado {
    caminho: ?str
    relativo: ?str
    original: ?str
    tam: u64
    edicoes: [dynamic]Edicao
    n: u32
    cap: u32
}

struct Operacao {
    op: ?str
    alvo: ?str
    novo: ?str
    edicoes: u32
}

struct Plano {
    q: ?^Consulta
    arena: ?^common.Arena
    arquivos: [dynamic]ArquivoEditado
    narquivos: u32
    cap: u32
    operacoes: [dynamic]Operacao
    noperacoes: u32
    sintatica: ?^Compilacao
    item: ?^JsonValor
    erro: ?str
}

struct FaixaDecl {
    ini_texto: u32
    fim_texto: u32
    ini_remocao: u32
    fim_remocao: u32
}

struct Resposta {
    alvo: ?str
    aplicar: bool
    valido: bool
    aplicado: bool
    erros_depois: i64
    prefixo_copia: ?str
    motivo: ?str
    depois: ?^ResultadoCheck
    diff: ?^[dynamic]u8
}

