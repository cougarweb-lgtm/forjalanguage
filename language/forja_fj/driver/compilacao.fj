import "common"
import "frontend"
import "ir"
import "nativo"
import "semantic"

struct Compilacao {
    fonte: common.Fonte
    arena: common.Arena
    nomes: common.Interner
    diag: common.Diag
    lexer: frontend.Lexer
    parser: frontend.Parser
    modulos: frontend.Modulos
    cargas: [dynamic]?^frontend.Expr
    resolvidos: [dynamic]nativo.NativoCarga
    pastas_carregadas: [dynamic]nativo.NativoPacote
    sem: semantic.Semantica
    ir: ir.IrPrograma
    emit_ns: u64
    tempos: nativo.NativoTempos
    nativo_medido: bool
    opcoes: ?^Opcoes
}
