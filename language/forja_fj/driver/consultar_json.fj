const TRECHO_MAX: i32 = 160
// C2F:? tabela PALAVRAS_POSSE (const char *const[6]): folha {'s': ''} para ^u8

// C: driver/consultar_json.c:19
proc separar(q: ^Consulta) {
    if q.primeiro {
        q.primeiro = false
    } else {
        append(&q.saida, item = ", ")
    }
}

// C: driver/consultar_json.c:25
proc chave(q: ^Consulta, chave: str) {
    separar(q)
    format(f"\"{chave}\": ", into = &q.saida)
}

// C: driver/consultar_json.c:31
proc consulta_abrir(q: ^Consulta, pergunta: str) {
    format(f"{{\"consultar_versao\": \"{CONSULTAR_VERSAO}\", \"pergunta\": \"{pergunta}\"", into = &q.saida)
    q.primeiro = false
}

// C: driver/consultar_json.c:37
proc consulta_fechar(q: ^Consulta) {
    append(&q.saida, item = "}\n")
}

// C: driver/consultar_json.c:42
proc consulta_abrir_obj(q: ^Consulta) {
    separar(q)
    append(&q.saida, item = "{"[0..<1])
    q.primeiro = true
}

// C: driver/consultar_json.c:49
proc consulta_fechar_obj(q: ^Consulta) {
    append(&q.saida, item = "}"[0..<1])
    q.primeiro = false
}

