}

// C: driver/consultar_json.c:139
proc consulta_chave_id(q: ^Consulta, chave: str, d: ?^frontend.Decl) {
    var id = make([dynamic]u8, alloc = heap)
    defer delete(id)
    semantic.ast_id_base_da_decl(&id, &(q.c as ^Compilacao).modulos, &(q.c as ^Compilacao).nomes, d)
    let s = to_str(&id)
    defer delete(s)
    consulta_chave_texto(q, chave, s, len(s) as u64)
}

// C: driver/consultar_json.c:147
proc consulta_chave_modulo(q: ^Consulta, chave: str, modulo: u8) {
    let caminho: i32 = (q.c as ^Compilacao).modulos.itens[modulo].caminho
    let arg_1: u64 = common.interner_tam(&(q.c as ^Compilacao).nomes, caminho) as u64
    let arg_2: str = common.interner_texto(&(q.c as ^Compilacao).nomes, caminho)
    let arg_3: str = chave
    let arg_4: ^Consulta = q
    consulta_chave_texto(arg_4, arg_3, arg_2, arg_1)
}

// C: driver/consultar_json.c:153
proc consulta_chave_trecho(q: ^Consulta, chave: str, ini: u32, fim: u32) {
    let fonte: ^common.Fonte = &(q.c as ^Compilacao).fonte
    var n: u64 = 0
    if (fim > ini) and ((ini as u64) <= fonte.tam) {
        n = (fim - ini) as u64
        if n > fonte.tam - (ini as u64) {
            n = fonte.tam - (ini as u64)
        }
    }
    if n > (TRECHO_MAX as u64) {
        n = TRECHO_MAX as u64
    }
    if n == 0 {
        consulta_chave_texto(q, chave, "", 0)
        return
    }
    let trecho = from_bytes(fonte.texto[(ini as int)..<((ini as int) + (n as int))], alloc = heap)
    defer delete(trecho)
    consulta_chave_texto(q, chave, trecho, n)
}

// C: driver/consultar_json.c:161
proc consulta_uso_errado(pergunta: str, argumento: ?str, motivo: str) -> i32 {
    let txt_1 = argumento or_else "(null)"
    let msg_1 = format(f"forja: consultar {pergunta}: '{txt_1}' {motivo}\n", alloc = heap)
    defer delete(msg_1)
    common.c2f_saida_formatar(common.c2f_saida_stderr(), msg_1)
    return CONSULTAR_USO
}

// C: driver/consultar_json.c:168
proc achar_test(q: ^Consulta, texto: ?str) -> ?^frontend.Decl {
    let alvo: str = texto or_else ""
    var achado: ?^frontend.Decl = none
    var d: ?^frontend.Decl = ((q.c as ^Compilacao).sem.programa as ^frontend.Programa).primeira
    while (d != none) and (achado == none) {
        let atual: ^frontend.Decl = d as ^frontend.Decl
        if atual.tipo_no == (frontend.D_TEST as u8) {
            var id = make([dynamic]u8, alloc = heap)
            semantic.ast_id_base_da_decl(&id, &(q.c as ^Compilacao).modulos, &(q.c as ^Compilacao).nomes, d)
            let s = to_str(&id)
            if s == alvo {
                achado = d
            }
            delete(s)
            delete(id)
        }
        d = atual.prox
    }
    return achado
}

// C: driver/consultar_json.c:183
proc achar_decl_no_modulo(q: ^Consulta, id: i32, texto: ?str, n_modulo: u64) -> ?^frontend.Decl {
    let alvo: str = texto or_else ""
    let nomes: ^common.Interner = &(q.c as ^Compilacao).nomes
    var k: u32 = 0
    while k < (q.c as ^Compilacao).modulos.n {
        let caminho: i32 = (q.c as ^Compilacao).modulos.itens[k].caminho
        let nome_modulo: str = common.interner_texto(nomes, caminho)[0..<common.interner_tam(nomes, caminho)]
        if ((common.interner_tam(nomes, caminho) as u64) == n_modulo) and (nome_modulo == alvo[0..<(n_modulo as int)]) {
            let d: ?^frontend.Decl = semantic.indice_decl_do_nome(&q.indice, id, k as u8)
            if d != none {
                if (d as ^frontend.Decl).modulo == (k as u8) {
                    return d
                }
            }
            return none
        }
        k += 1
    }
    return none
}

// C: driver/consultar_json.c:194
proc consulta_achar_decl(q: ^Consulta, texto: ?str) -> ?^frontend.Decl {
    let alvo: str = texto or_else ""
    let nomes: ^common.Interner = &(q.c as ^Compilacao).nomes
    // strrchr: a ultima ':' do texto (-1 = nenhuma); strstr: ":test:" em qualquer lugar
    var dois_pontos: int = -1
    var tem_test: bool = false
    var i: int = 0
    while i < len(alvo) {
        if alvo[i..<(i + 1)] == ":" {
            dois_pontos = i
        }
        if ((i + 6) <= len(alvo)) and (alvo[i..<(i + 6)] == ":test:") {
            tem_test = true
        }
        i += 1
    }
    if tem_test {
        let achado_teste: ?^frontend.Decl = achar_test(q, texto)
        if achado_teste != none {
            return achado_teste
        }
    }
    var nome: str = alvo
    if dois_pontos >= 0 {
        nome = alvo[(dois_pontos + 1)..<len(alvo)]
    }
    let id: i32 = common.interner_achar(nomes, nome, len(nome) as u32)
    if id < 0 {
        return none
    }
    if dois_pontos < 0 {
        return semantic.indice_decl_do_nome(&q.indice, id, 0)
    }
    return achar_decl_no_modulo(q, id, texto, dois_pontos as u64)
}

// C: driver/consultar_json.c:207
proc consulta_inicio_decl(q: ^Consulta, d: ?^frontend.Decl) -> u32 {
    return frontend.ast_inicio_decl(&q.fim, d)
}

// C: driver/consultar_json.c:213
proc anexar_trecho(q: ^Consulta, saida: ^[dynamic]u8, ini: u32, fim: u32) {
    let fonte: ^common.Fonte = &(q.c as ^Compilacao).fonte
    var k: u64 = ini as u64
    while (k < (fim as u64)) and (k < fonte.tam) {
        let ch: u8 = fonte.texto[k as int]
        if (ch == 10) or (ch == 13) {
            append(saida, item = " ")
        } else {
            append(saida, item = ch)
        }
        k += 1
    }
}

// C: driver/consultar_json.c:221
proc assinatura_parametros(q: ^Consulta, d: ?^frontend.Decl, s: ^[dynamic]u8) {
    let nomes: ^common.Interner = &(q.c as ^Compilacao).nomes
    var i: u32 = 0
    while i < (d as ^frontend.Decl).nparams {
        let p: ^frontend.Param = &((d as ^frontend.Decl).params or_else {})[i]
        if i > 0 {
            append(s, item = ", ")
        }
        format(f"{common.interner_texto(nomes, p.nome)[0..<transmute(common.interner_tam(nomes, p.nome), to = i32)]}: ", into = s)
        semantic.tipo_anexar_texto(&(q.c as ^Compilacao).sem.tipos, p.tipo.tipo, s)
        if p.padrao == none {
            i += 1
            continue
        }
        append(s, item = " = ")
        let arg_1: u32 = frontend.ast_fim_expr(&q.fim, p.padrao)
        let arg_2: u32 = (p.padrao as ^frontend.Expr).pos
        let arg_3: ^[dynamic]u8 = s
        let arg_4: ^Consulta = q
        anexar_trecho(arg_4, arg_3, arg_2, arg_1)
        i += 1
    }
}

// C: driver/consultar_json.c:236
proc consulta_assinatura_texto(q: ^Consulta, d: ?^frontend.Decl, s: ^[dynamic]u8) {
    let nomes: ^common.Interner = &(q.c as ^Compilacao).nomes
    let dec: ^frontend.Decl = d as ^frontend.Decl
    format(f"proc {common.interner_texto(nomes, dec.nome)[0..<common.interner_tam(nomes, dec.nome)]}(", into = s)
    assinatura_parametros(q, d, s)
    append(s, item = ")")
    if dec.tem_retorno {
        append(s, item = " -> ")
        semantic.tipo_anexar_texto(&(q.c as ^Compilacao).sem.tipos, dec.retorno.tipo, s)
    }
    if dec.posse_c == (frontend.POSSE_C_NENHUMA as u8) {
        return
    }
    // M6c P85 / P92b: clausula de posse do proc foreign (PALAVRAS_POSSE do C: creates, creates p, destroys p, takes p, ends)
    var palavra: str = ""
    if dec.posse_c == (frontend.POSSE_C_CRIA_RETORNO as u8) {
        palavra = "creates"
    } else if dec.posse_c == (frontend.POSSE_C_CRIA_SAIDA as u8) {
        palavra = "creates"
    } else if dec.posse_c == (frontend.POSSE_C_DESTROI as u8) {
        palavra = "destroys"
    } else if dec.posse_c == (frontend.POSSE_C_ENTREGA as u8) {
        palavra = "takes"
    } else if dec.posse_c == (frontend.POSSE_C_ENCERRA as u8) {
        palavra = "ends"
    }
    format(f" {palavra}", into = s)
    if dec.posse_param < 0 {
        return
    }
    let alvo: ^frontend.Param = &((dec.params or_else {})[dec.posse_param as int])
    format(f" {common.interner_texto(nomes, alvo.nome)[0..<common.interner_tam(nomes, alvo.nome)]}", into = s)
}
