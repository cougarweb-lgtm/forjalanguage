    append(&q.saida, item = "["[0..<1])
    q.primeiro = true
}

// C: driver/consultar_json.c:62
proc consulta_fechar_lista(q: ^Consulta) {
    append(&q.saida, item = "]"[0..<1])
    q.primeiro = false
}

// C: driver/consultar_json.c:68
proc consulta_chave_texto(q: ^Consulta, chave: str, texto: ?str, n: u64) {
    chave(q, chave)
    if texto == none {
        append(&q.saida, item = "null")
    } else {
        nativo.json_texto(&q.saida, texto, n)
    }
}

// C: driver/consultar_json.c:75
proc consulta_chave_nome(q: ^Consulta, chave: str, nome: i32) {
    let nomes: ^common.Interner = &(q.c as ^Compilacao).nomes
    if nome < 0 {
        consulta_chave_texto(q, chave, none, 0)
    } else {
        let arg_1: u64 = common.interner_tam(nomes, nome) as u64
        let arg_2: str = common.interner_texto(nomes, nome)
        let arg_3: str = chave
        let arg_4: ^Consulta = q
        consulta_chave_texto(arg_4, arg_3, arg_2, arg_1)
    }
}

// C: driver/consultar_json.c:82
proc consulta_chave_tipo(q: ^Consulta, chave: str, tipo: u32) {
    chave(q, chave)
    if tipo == (frontend.TIPO_NAO_RESOLVIDO as u32) {
        append(&q.saida, item = "null")
        return
    }
    var texto = make([dynamic]u8, alloc = heap)
    defer delete(texto)
    semantic.tipo_anexar_texto(&(q.c as ^Compilacao).sem.tipos, tipo, &texto)
    let s = to_str(&texto)
    defer delete(s)
    nativo.json_texto(&q.saida, s, len(s) as u64)
}

// C: driver/consultar_json.c:95
proc consulta_item_texto(q: ^Consulta, texto: ?str, n: u64) {
    separar(q)
    nativo.json_texto(&q.saida, texto, n)
}

// C: driver/consultar_json.c:101
proc consulta_item_caminho(q: ^Consulta, caminho: str) {
