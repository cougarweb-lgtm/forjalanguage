// C: driver/consultar_json.c:132
proc consulta_chave_arquivo(q: ^Consulta, off: u32) {
    let p: common.FontePosicao = common.fonte_localizar_no_arquivo(&(q.c as ^Compilacao).fonte, off)
    chave(q, "arquivo")
