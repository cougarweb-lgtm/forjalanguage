}

// C: driver/consultar_json.c:107
proc consulta_item_modulo(q: ^Consulta, modulo: u8) {
    let caminho: i32 = (q.c as ^Compilacao).modulos.itens[modulo].caminho
    let arg_1: u64 = common.interner_tam(&(q.c as ^Compilacao).nomes, caminho) as u64
    let arg_2: str = common.interner_texto(&(q.c as ^Compilacao).nomes, caminho)
    let arg_3: ^Consulta = q
    consulta_item_texto(arg_3, arg_2, arg_1)
}

// C: driver/consultar_json.c:113
proc consulta_chave_bool(q: ^Consulta, chave: str, valor: bool) {
    chave(q, chave)
    var tern_1: str = "false"
    if common.c2f_b2i32(valor) != 0 {
        tern_1 = "true"
    }
    append(&q.saida, item = tern_1)
}

