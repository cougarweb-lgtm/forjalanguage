}

// C: driver/consultar_json.c:125
proc consulta_chave_pos(q: ^Consulta, chave: str, off: u32) {
    let p: common.FontePosicao = common.fonte_localizar_no_arquivo(&(q.c as ^Compilacao).fonte, off)
    chave(q, chave)
