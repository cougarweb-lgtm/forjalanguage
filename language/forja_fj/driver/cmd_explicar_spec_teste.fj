// driver/cmd_explicar_spec_teste.fj - testes do porte de compiler/driver/cmd_explicar.c e cmd_spec.c (G3, V5-X)
// Versao: 0.1.0
// Changelog: 0.1.0 - G3 V5-X: saida em memoria comparada byte a byte com a saida REAL do compiler\forja.exe (ref\*.txt, gerados por ele); parse e mensagens conferidos contra o C.

import "common"

const REF_EXPLICAR_LISTA: str = #load("../tests/g3/ref_driver/explicar_lista.txt")
const REF_EXPLICAR_LISTA_JSON: str = #load("../tests/g3/ref_driver/explicar_lista_json.txt")
const REF_EXPLICAR_EXEMPLOS: str = #load("../tests/g3/ref_driver/explicar_exemplos.txt")
const REF_EXPLICAR_EXEMPLO_E0001: str = #load("../tests/g3/ref_driver/explicar_exemplo_E0001.txt")
const REF_SPEC: str = #load("../tests/g3/ref_driver/spec.txt")
const REF_SPEC_JSON: str = #load("../tests/g3/ref_driver/spec_json.txt")
const REF_SPEC_CARTAO: str = #load("../tests/g3/ref_driver/spec_cartao.txt")
const REF_SPEC_CARTAO_JSON: str = #load("../tests/g3/ref_driver/spec_cartao_json.txt")
const REF_SPEC_RECEITAS: str = #load("../tests/g3/ref_driver/spec_receitas.txt")
const REF_SPEC_SECAO_FORMATO: str = #load("../tests/g3/ref_driver/spec_secao_formato.txt")
const REF_SPEC_SECAO_FORMATO_JSON: str = #load("../tests/g3/ref_driver/spec_secao_formato_json.txt")
const REF_SPEC_SECAO_MIGRACAO: str = #load("../tests/g3/ref_driver/spec_secao_migracao.txt")
const REF_SPEC_CODIGO: str = #load("../tests/g3/ref_driver/spec_codigo_E0001.txt")
const REF_SPEC_CODIGO_JSON: str = #load("../tests/g3/ref_driver/spec_codigo_E0001_json.txt")
const REF_SPEC_EXEMPLO: str = #load("../tests/g3/ref_driver/spec_exemplo_E0001.txt")
const REF_SPEC_EXEMPLO_JSON: str = #load("../tests/g3/ref_driver/spec_exemplo_E0301_json.txt")
const REF_SPEC_EXEMPLO_E0201: str = #load("../tests/g3/ref_driver/spec_exemplo_E0201.txt")
const REF_SPEC_EXEMPLO_E0201_JSON: str = #load("../tests/g3/ref_driver/spec_exemplo_E0201_json.txt")
const VERSAO_TESTE: str = "forja 0.23.0 (Linguagem v1.13)"

// Os bytes da Saida em memoria batem com o texto esperado (o mesmo teste do c2f_teste, visto de fora do common).
proc xs_saida_igual(s: ^common.Saida, esperado: str) -> bool {
    let e = as_bytes(esperado)
    return len(s.buf) == len(e) and common.c2f_memcmp(s.buf[..], e) == 0
}

// Roda despachar_spec em memoria com as opcoes dadas e devolve se a saida bate com o esperado.
proc spec_despacha_igual(p: ^Pedido5, esperado: str) -> bool {
    let s = common.c2f_saida_memoria(false)
    let codigo = despachar_spec(s, p, VERSAO_TESTE)
    let igual = codigo == 0 and xs_saida_igual(s, esperado)
    _ = common.c2f_saida_fechar(s)
    return igual
}

// As listagens do explicar sao de stdout em modo texto no C (CRLF no Windows): memoria com texto = true.
test "explicar_lista_texto_igual_forja_exe" {
    let s = common.c2f_saida_memoria(true)
    expect(listar_codigos(s, false) == 0)
    expect(xs_saida_igual(s, REF_EXPLICAR_LISTA))
    _ = common.c2f_saida_fechar(s)
}

test "explicar_lista_json_igual_forja_exe" {
    let s = common.c2f_saida_memoria(true)
    expect(listar_codigos(s, true) == 0)
    expect(xs_saida_igual(s, REF_EXPLICAR_LISTA_JSON))
    _ = common.c2f_saida_fechar(s)
}

test "explicar_exemplos_todos_igual_forja_exe" {
    let s = common.c2f_saida_memoria(true)
    expect(listar_exemplos(s, none) == 0)
    expect(xs_saida_igual(s, REF_EXPLICAR_EXEMPLOS))
    _ = common.c2f_saida_fechar(s)
}

test "explicar_exemplos_de_um_codigo_igual_forja_exe" {
    let s = common.c2f_saida_memoria(true)
    expect(listar_exemplos(s, "E0001") == 0)
    expect(xs_saida_igual(s, REF_EXPLICAR_EXEMPLO_E0001))
    _ = common.c2f_saida_fechar(s)
}

test "explicar_titulo_e_item_do_catalogo" {
    // E0301 = 3 no catalogo; E0001 = 0. Titulos e spec conferidos na linha do --lista do forja.exe.
    expect(titulo_do_codigo(3) == "Os tipos nao pertencem a mesma categoria e a Forja nao converte sozinha")
    var item = ItemLista{}
    montar_item(0, &item)
    expect((item.codigo or_else "") == "E0001")
    expect((item.etapa or_else "") == "check")
    expect((item.spec or_else "") == "formato")
    expect((item.titulo or_else "") == "O texto tem um caractere que a Forja nao reconhece ou uma string sem fechar na linha")
}

test "explicar_argumentos_casos_do_c" {
    var a1: [1]str = {"--lista"}
    var p1 = Pedido3{}
    expect(ler_argumentos_3(1, a1[..], &p1) == none)
    expect(p1.lista)
    var a2: [2]str = {"--lista", "E0001"}
    var p2 = Pedido3{}
    expect((ler_argumentos_3(2, a2[..], &p2) or_else "") == "--lista nao combina com --exemplos nem com CODIGO")
    var a3: [1]str = {"E9999"}
    var p3 = Pedido3{}
    expect((ler_argumentos_3(1, a3[..], &p3) or_else "") == "codigo de diagnostico desconhecido (veja 'forja explicar --lista')")
    var a4: [1]str = {"--x"}
    var p4 = Pedido3{}
    expect((ler_argumentos_3(1, a4[..], &p4) or_else "") == "opcao desconhecida")
    var a5: [2]str = {"E0001", "E0002"}
    var p5 = Pedido3{}
    expect((ler_argumentos_3(2, a5[..], &p5) or_else "") == "so um codigo por vez")
    var a6: [2]str = {"--exemplos", "E0301"}
    var p6 = Pedido3{}
    expect(ler_argumentos_3(2, a6[..], &p6) == none)
    expect(p6.exemplos and (p6.codigo or_else "") == "E0301")
}

test "spec_texto_json_cartao_igual_forja_exe" {
    var p0 = Pedido5{}
    expect(spec_despacha_igual(&p0, REF_SPEC))
    var pj = Pedido5{json = true}
    expect(spec_despacha_igual(&pj, REF_SPEC_JSON))
    var pc = Pedido5{cartao = true}
    expect(spec_despacha_igual(&pc, REF_SPEC_CARTAO))
    var pcj = Pedido5{cartao = true, json = true}
    expect(spec_despacha_igual(&pcj, REF_SPEC_CARTAO_JSON))
    var pr = Pedido5{receitas = true}
    expect(spec_despacha_igual(&pr, REF_SPEC_RECEITAS))
}

test "spec_secao_e_codigo_e_exemplo_igual_forja_exe" {
    var ps = Pedido5{secao = "formato"}
    expect(spec_despacha_igual(&ps, REF_SPEC_SECAO_FORMATO))
    var psj = Pedido5{secao = "formato", json = true}
    expect(spec_despacha_igual(&psj, REF_SPEC_SECAO_FORMATO_JSON))
    var pm = Pedido5{secao = "migracao"}
    expect(spec_despacha_igual(&pm, REF_SPEC_SECAO_MIGRACAO))
    var pcod = Pedido5{codigo = "E0001"}
    expect(spec_despacha_igual(&pcod, REF_SPEC_CODIGO))
    var pcodj = Pedido5{codigo = "E0001", json = true}
    expect(spec_despacha_igual(&pcodj, REF_SPEC_CODIGO_JSON))
    var pex = Pedido5{exemplo = "E0001"}
    expect(spec_despacha_igual(&pex, REF_SPEC_EXEMPLO))
    var pexj = Pedido5{exemplo = "E0301", json = true}
    expect(spec_despacha_igual(&pexj, REF_SPEC_EXEMPLO_JSON))
    var pexc = Pedido5{exemplo = "E0201"}
    expect(spec_despacha_igual(&pexc, REF_SPEC_EXEMPLO_E0201))
    var pexcj = Pedido5{exemplo = "E0201", json = true}
    expect(spec_despacha_igual(&pexcj, REF_SPEC_EXEMPLO_E0201_JSON))
}

test "spec_ler_opcoes_casos_do_c" {
    var a1: [1]str = {"--secao"}
    var p1 = Pedido5{}
    expect((ler_opcoes(1, a1[..], &p1) or_else "") == "a opcao exige um valor")
    var a2: [1]str = {"-x"}
    var p2 = Pedido5{}
    expect((ler_opcoes(1, a2[..], &p2) or_else "") == "opcao desconhecida")
    var a3: [2]str = {"E0001", "E0002"}
    var p3 = Pedido5{}
    expect((ler_opcoes(2, a3[..], &p3) or_else "") == "so um codigo por vez")
    var a4: [3]str = {"--secao", "formato", "--cartao"}
    var p4 = Pedido5{}
    expect(ler_opcoes(3, a4[..], &p4) == none)
    expect((p4.secao or_else "") == "formato")
    expect(p4.cartao)
    var a5: [1]str = {""}
    var p5 = Pedido5{}
    expect(ler_opcoes(1, a5[..], &p5) == none)
    expect((p5.codigo or_else "x") == "")
}

test "spec_validar_pedido_casos_do_c" {
    var p1 = Pedido5{receitas = true, json = true}
    expect((validar_pedido(&p1) or_else "") == "--receitas nao combina com as outras opcoes")
    var p2 = Pedido5{exemplo = "E0001", secao = "formato"}
    expect((validar_pedido(&p2) or_else "") == "--exemplo nao combina com --secao, --cartao nem CODIGO")
    var p3 = Pedido5{codigo = "E0001", cartao = true}
    expect((validar_pedido(&p3) or_else "") == "CODIGO nao combina com --secao nem --cartao")
    var p4 = Pedido5{codigo = "E9999"}
    expect((validar_pedido(&p4) or_else "") == "codigo de diagnostico desconhecido (veja 'forja explicar --lista')")
    var p5 = Pedido5{json = true}
    expect(validar_pedido(&p5) == none)
}

test "spec_ler_valor_avanca_o_indice" {
    var a: [2]str = {"--secao", "formato"}
    var k: i32 = 0
    var destino: ?str = none
    expect(ler_valor(2, a[..], &k, &destino) == none)
    expect(k == 1)
    expect((destino or_else "") == "formato")
    var k2: i32 = 0
    var sem: ?str = none
    expect((ler_valor(1, a[..], &k2, &sem) or_else "") == "a opcao exige um valor")
}

test "spec_sem_fim_em_branco_corta_so_o_fim" {
    let d = common.DocTexto{texto = as_bytes("ab \r\n\t"), tam = 6}
    expect(sem_fim_em_branco(d).tam == 2)
    let e = common.DocTexto{texto = as_bytes(" x y"), tam = 4}
    expect(sem_fim_em_branco(e).tam == 4)
}

// Caminhos de erro: vao para o stderr; o teste so prova o codigo de saida e que nao vaza o objeto de saida (R0009).
test "caminhos_de_erro_saem_com_uso" {
    expect(uso_errado_4("x") == 2)
    expect(uso_errado_8(none) == 2)
    var sem_secoes: [1]common.SpecSecao = {}
    expect(secao_desconhecida("x", sem_secoes[0..<0]) == 2)
    var a1: [2]str = {"--receitas", "--json"}
    expect(rodar_spec(2, a1[..], VERSAO_TESTE) == 2)
    var a2: [1]str = {"--x"}
    expect(rodar_explicar_extenso(1, a2[..]) == 2)
}
