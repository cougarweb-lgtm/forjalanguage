//            argv dos procs vira []str (era ^?^u8); pasta_do_modulo devolve str de heap, "" = sem FORJA_ENGINE (era buffer de saida + bool); ler_load_arquivo devolve os bytes em ^[dynamic]u8 (era char ** + size_t *);
