// Versao: 0.2.0
// Changelog: 0.2.0 - G3 P-driver DA: corpo real. C2F-80: ponteiro de funcao da tabela SUBCOMANDOS -> tag u16 + despachante (chamar_subcomando_aplica, chamar_subcomando_rodar);
//            argv dos despachantes e dos rodar_* vira []str (era ^?^u8: `char **argv` classificado SAIDA_PTR; o main ratifica a troca nos arquivos dos rodar_*).

struct Subcomando {
    nome: str
    argc_min: i32
    aplica: u16
    rodar: u16
}

// argc_min = argc total (com "forja" e o nome) a partir do qual o subcomando vale; aplica (opcional, 0 = nenhum) decide pelos argumentos que sobram.
const SUBCOMANDOS: [9]Subcomando = {
    Subcomando{nome = "ligar", argc_min = 2, aplica = 0, rodar = SUBCOMANDO_RODAR_RODAR_LIGAR},
    Subcomando{nome = "corrigir", argc_min = 2, aplica = 0, rodar = SUBCOMANDO_RODAR_RODAR_CORRIGIR},
    Subcomando{nome = "migrar", argc_min = 2, aplica = 0, rodar = SUBCOMANDO_RODAR_RODAR_MIGRAR},
    Subcomando{nome = "fmt", argc_min = 2, aplica = 0, rodar = SUBCOMANDO_RODAR_RODAR_FMT},
    Subcomando{nome = "editar", argc_min = 2, aplica = 0, rodar = SUBCOMANDO_RODAR_RODAR_EDITAR},
    Subcomando{nome = "consultar", argc_min = 2, aplica = 0, rodar = SUBCOMANDO_RODAR_RODAR_CONSULTAR},
    Subcomando{nome = "mapa", argc_min = 2, aplica = 0, rodar = SUBCOMANDO_RODAR_RODAR_MAPA},
    Subcomando{nome = "spec", argc_min = 2, aplica = 0, rodar = SUBCOMANDO_RODAR_RODAR_SPEC_COM_VERSAO},
    Subcomando{nome = "explicar", argc_min = 3, aplica = SUBCOMANDO_APLICA_EXPLICAR_EH_EXTENSO, rodar = SUBCOMANDO_RODAR_RODAR_EXPLICAR_EXTENSO},
}

pub const SUBCOMANDO_APLICA_EXPLICAR_EH_EXTENSO: u16 = 1
pub proc chamar_subcomando_aplica(tag: u16, argc: i32, argv: []str) -> bool {
    if tag == SUBCOMANDO_APLICA_EXPLICAR_EH_EXTENSO {
        return explicar_eh_extenso(argc, argv)
    }
    panic("driver.chamar_subcomando_aplica: tag desconhecida")
    return false
}

pub const SUBCOMANDO_RODAR_RODAR_CONSULTAR: u16 = 1
pub const SUBCOMANDO_RODAR_RODAR_CORRIGIR: u16 = 2
pub const SUBCOMANDO_RODAR_RODAR_EDITAR: u16 = 3
pub const SUBCOMANDO_RODAR_RODAR_EXPLICAR_EXTENSO: u16 = 4
pub const SUBCOMANDO_RODAR_RODAR_FMT: u16 = 5
pub const SUBCOMANDO_RODAR_RODAR_MAPA: u16 = 6
pub const SUBCOMANDO_RODAR_RODAR_MIGRAR: u16 = 7
pub const SUBCOMANDO_RODAR_RODAR_LIGAR: u16 = 8
pub const SUBCOMANDO_RODAR_RODAR_SPEC_COM_VERSAO: u16 = 9
pub proc chamar_subcomando_rodar(tag: u16, argc: i32, argv: []str) -> i32 {
    if tag == SUBCOMANDO_RODAR_RODAR_CONSULTAR {
        return rodar_consultar(argc, argv)
    }
    if tag == SUBCOMANDO_RODAR_RODAR_CORRIGIR {
        return rodar_corrigir(argc, argv)
    }
    if tag == SUBCOMANDO_RODAR_RODAR_EDITAR {
        return rodar_editar(argc, argv)
    }
    if tag == SUBCOMANDO_RODAR_RODAR_EXPLICAR_EXTENSO {
        return rodar_explicar_extenso(argc, argv)
    }
    if tag == SUBCOMANDO_RODAR_RODAR_FMT {
        return rodar_fmt(argc, argv)
    }
    if tag == SUBCOMANDO_RODAR_RODAR_MAPA {
        return rodar_mapa(argc, argv)
    }
    if tag == SUBCOMANDO_RODAR_RODAR_MIGRAR {
        return rodar_migrar(argc, argv)
    }
    if tag == SUBCOMANDO_RODAR_RODAR_LIGAR {
        return rodar_ligar(argc, argv)
    }
    if tag == SUBCOMANDO_RODAR_RODAR_SPEC_COM_VERSAO {
        return rodar_spec_com_versao(argc, argv)
    }
    panic("driver.chamar_subcomando_rodar: tag desconhecida")
    return 0
}

// C: driver/main_despacho.c:23
// O 'spec' imprime a linha do --versao; a tabela so guarda funcoes (argc, argv). FORJA_VERSAO_TEXTO = "forja " FORJA_VERSAO " (Linguagem v1.13)"
proc rodar_spec_com_versao(argc: i32, argv: []str) -> i32 {
    let versao_texto = format(f"forja {FORJA_VERSAO} (Linguagem v1.13)", alloc = heap)
    defer delete(versao_texto)
    return rodar_spec(argc, argv, versao_texto)
}

// C: driver/main_despacho.c:48
// Despacha pelo nome do 1o argumento (argv[1]); argv[2..] e o que o subcomando recebe. true = rodou (o exit fica em codigo).
proc despachar_subcomando(argc: i32, argv: []str, codigo: ^i32) -> bool {
    for k in 0..<len(SUBCOMANDOS) {
        let s: Subcomando = SUBCOMANDOS[k]
        if (argc < s.argc_min) or (argv[1] != s.nome) {
            continue
        }
        if (s.aplica != 0) and (not chamar_subcomando_aplica(s.aplica, argc - 2, argv[2..<len(argv)])) {
            continue
        }
        codigo^ = chamar_subcomando_rodar(s.rodar, argc - 2, argv[2..<len(argv)])
        return true
    }
    return false
}
