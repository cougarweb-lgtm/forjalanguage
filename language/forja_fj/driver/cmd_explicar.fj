import "common"

struct Pedido3 {
    lista: bool
    exemplos: bool
    json: bool
    codigo: ?str
}

struct ItemLista {
    codigo: ?str
    etapa: ?str
    spec: ?str
    titulo: ?str
}

const SAIDA_OK_2: i32 = 0
const SAIDA_USO_2: i32 = 2
const TITULO_MAX: i32 = 100

// C: driver/cmd_explicar.c:23
proc explicar_eh_extenso(argc: i32, argv: []str) -> bool {
    for k in (0 as i32)..<argc {
        if (argv[k] == "--lista") or (argv[k] == "--exemplos") {
            return true
        }
    }
    return false
}

// C: driver/cmd_explicar.c:30
proc uso_errado_4(motivo: ?str) -> i32 {
    let txt_1 = motivo or_else "(null)"
    let msg_1 = format(f"forja: explicar: {txt_1}\n", alloc = heap)
    defer delete(msg_1)
    let erro = common.c2f_saida_stderr()
    common.c2f_saida_formatar(erro, msg_1)
    common.c2f_saida_escrever_texto(erro, "uso: forja explicar <CODIGO>\n     forja explicar --lista [--json]\n     forja explicar [CODIGO] --exemplos\n")
    _ = common.c2f_saida_fechar(erro)
    return SAIDA_USO_2
}

// C: driver/cmd_explicar.c:37
proc ler_argumentos_3(argc: i32, argv: []str, p: ^Pedido3) -> ?str {
    p^ = Pedido3{}
    for k in (0 as i32)..<argc {
        let arg = argv[k]
        if arg == "--lista" {
            p.lista = true
        } else if arg == "--exemplos" {
            p.exemplos = true
        } else if arg == "--json" {
            p.json = true
        } else if common.c2f_nul_em(arg, 0) == 45 { // '-'
            return "opcao desconhecida"
        } else if p.codigo != none {
            return "so um codigo por vez"
        } else {
            p.codigo = arg
        }
    }
    if p.lista and (p.exemplos or p.codigo != none) {
        return "--lista nao combina com --exemplos nem com CODIGO"
    }
    if p.codigo != none and common.diag_codigo_por_texto(p.codigo) < 0 {
        return "codigo de diagnostico desconhecido (veja 'forja explicar --lista')"
    }
    return none
}

// C: driver/cmd_explicar.c:55
proc etapa_do_codigo_2(codigo: str) -> str {
    let sw_1 = common.c2f_char_i32(codigo[0])
    if sw_1 == 69 { // 'E'
        return "check"
    } else if sw_1 == 82 { // 'R'
        return "execucao"
    } else if sw_1 == 66 { // 'B'
        return "build"
    } else if sw_1 == 71 { // 'G'
        return "ligar"
    } else {
        return "backend"
    }
    return ""
}

// C: driver/cmd_explicar.c:67
// O titulo e a fatia do texto do catalogo (o C copiava para char[TITULO_MAX + 1]).
proc titulo_do_codigo(codigo: i32) -> str {
    let texto = common.diag_codigo_explicacao(codigo)
    var n: int = len(texto)
    var achou = false
    var i: int = 0
    // strstr(texto, ". "): a 1a ocorrencia; sem ela, o titulo vai ate o fim
    while i + 1 < len(texto) and not achou {
        if texto[i] == 46 and texto[i + 1] == 32 {
            n = i
            achou = true
        } else {
            i += 1
        }
    }
    if n > 0 and not achou and texto[n - 1] == 46 { // ponto final sem ". " depois
        n -= 1
    }
    if n > (TITULO_MAX as int) {
        n = TITULO_MAX as int
        while n > 1 and texto[n] != 32 { // corta em palavra
            n -= 1
        }
    }
    return texto[0..<n]
}

// C: driver/cmd_explicar.c:88
// Muda a assinatura: a secao sai como str do mapa (spec_secao_do_codigo deixa "" quando nao acha, como secao[0] = 0 do C).
proc montar_item(codigo: i32, item: ^ItemLista) {
    let texto = common.diag_codigo_texto(codigo)
    var secao: str = ""
    item.codigo = texto
    item.etapa = etapa_do_codigo_2(texto)
    _ = common.spec_secao_do_codigo(texto, &secao)
    item.spec = secao
    item.titulo = titulo_do_codigo(codigo)
}

// C: driver/cmd_explicar.c:97
proc imprimir_item_json(saida: ^common.Saida, item: ^ItemLista) {
    let titulo = item.titulo or_else ""
    common.c2f_saida_escrever_texto(saida, "{\"codigo\": \"")
    common.c2f_saida_escrever_texto(saida, item.codigo or_else "")
    common.c2f_saida_escrever_texto(saida, "\", \"titulo\": ")
    common.spec_imprimir_texto_json(saida, common.DocTexto{texto = as_bytes(titulo), tam = len(titulo) as u64})
    common.c2f_saida_escrever_texto(saida, ", \"etapa\": \"")
    common.c2f_saida_escrever_texto(saida, item.etapa or_else "")
    common.c2f_saida_escrever_texto(saida, "\", \"spec\": \"")
    common.c2f_saida_escrever_texto(saida, item.spec or_else "")
    common.c2f_saida_escrever_texto(saida, "\"}")
}

// C: driver/cmd_explicar.c:104 (o ramo sem --json do printf "%s\t%s\t%s\t%s\n")
proc imprimir_item_texto(saida: ^common.Saida, item: ^ItemLista) {
    common.c2f_saida_escrever_texto(saida, item.codigo or_else "")
    common.c2f_saida_putc(saida, 9) // '\t'
    common.c2f_saida_escrever_texto(saida, item.etapa or_else "")
    common.c2f_saida_putc(saida, 9)
    common.c2f_saida_escrever_texto(saida, item.spec or_else "")
    common.c2f_saida_putc(saida, 9)
    common.c2f_saida_escrever_texto(saida, item.titulo or_else "")
    common.c2f_saida_putc(saida, 10) // '\n'
}

// C: driver/cmd_explicar.c:104
proc listar_codigos(saida: ^common.Saida, json_c: bool) -> i32 {
    if json_c {
        common.c2f_saida_putc(saida, 91) // '['
    }
    for k in (0 as i32)..<common.DIAG_QTD {
        var item = ItemLista{}
        montar_item(k, &item)
        if json_c {
            if k > 0 {
                common.c2f_saida_escrever_texto(saida, ", ")
            }
            imprimir_item_json(saida, &item)
        } else {
            imprimir_item_texto(saida, &item)
        }
    }
    if json_c {
        common.c2f_saida_escrever_texto(saida, "]\n")
    }
    return SAIDA_OK_2
}

// C: driver/cmd_explicar.c:122
proc imprimir_exemplos_do_codigo(saida: ^common.Saida, codigo: ?str) {
    var e: common.SpecExemplo = common.SpecExemplo{}
    common.c2f_saida_escrever_texto(saida, "{\"codigo\": \"")
    common.c2f_saida_escrever_texto(saida, codigo or_else "")
    common.c2f_saida_escrever_texto(saida, "\", \"exemplos\": [")
    if common.spec_exemplo_do_codigo(codigo, &e) {
        common.spec_imprimir_exemplo_json(saida, &e)
    }
    common.c2f_saida_escrever_texto(saida, "]}\n")
}

// C: driver/cmd_explicar.c:131
proc listar_exemplos(saida: ^common.Saida, codigo: ?str) -> i32 {
    if codigo != none {
        imprimir_exemplos_do_codigo(saida, codigo)
        return SAIDA_OK_2
    }
    for k in (0 as i32)..<common.DIAG_QTD {
        imprimir_exemplos_do_codigo(saida, common.diag_codigo_texto(k))
    }
    return SAIDA_OK_2
}

// C: driver/cmd_explicar.c:141
proc rodar_explicar_extenso(argc: i32, argv: []str) -> i32 {
    var p = Pedido3{}
    let motivo = ler_argumentos_3(argc, argv, &p)
    if motivo != none {
        return uso_errado_4(motivo)
    }
    let saida = common.c2f_saida_stdout()
    // o C nao faz _setmode aqui: stdout em modo texto (\n sai CRLF); no E1 quem traduz e o CRT (texto = false, sem dobrar)
    var resultado: i32 = 0
    if p.lista {
        resultado = listar_codigos(saida, p.json)
    } else {
        resultado = listar_exemplos(saida, p.codigo)
    }
    _ = common.c2f_saida_fechar(saida)
    return resultado
}
