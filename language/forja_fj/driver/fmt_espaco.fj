import "common"
import "frontend"

// Linha = papel do token de antes; coluna = papel do de depois; mesma ordem de FmtPapel (W K PR | LP RP LB RB | LK LL RK RL | CM CO DT RG | BI UN PO).
// '0' = nenhum espaco, '1' = um espaco, '?' = fora da tabela (mantem o vao). C2F-A0: const char[18][19] -> [18]str de 18 bytes (o NUL do C nao entra).
const TABELA_PARES: [18]str = {
    "1110000101000001?0", // W
    "1111010111000??11?", // K
    "1??0??????????????", // PR
    "0000000?0?0??0??0?", // LP
    "11100001?1000001?0", // RP
    "0000000?0?0??00?0?", // LB
    "010000010100000100", // RB
    "1111?1??1???????1?", // LK
    "0000?0??0?0?????0?", // LL
    "?1????????????????", // RK
    "111?0?01?1000001?0", // RL
    "11110101110?????1?", // CM
    "1111010?1?00????1?", // CO
    "0?????????????????", // DT
    "0??0??0???????????", // RG
    "1111?1??1????1??1?", // BI
    "0?00?0????????????", // UN
    "?1?00001?1000001?0", // PO
}

// C: driver/fmt_espaco.c:37
proc fmt_espaco_do_par(antes: i32, depois: i32) -> i32 {
    let c: u8 = TABELA_PARES[antes as int][depois as int]
    if c == 48 { // '0'
        return 0
    }
    if c == 49 { // '1'
        return 1
    }
    return -1
}

// C: driver/fmt_espaco.c:44
proc fmt_papel_fecha(p: i32) -> bool {
    return (((common.c2f_s2u_32(p) == (PAPEL_RP as u32)) or (common.c2f_s2u_32(p) == (PAPEL_RB as u32))) or (common.c2f_s2u_32(p) == (PAPEL_RK as u32))) or (common.c2f_s2u_32(p) == (PAPEL_RL as u32))
}

// C: driver/fmt_espaco.c:50
proc fim_de_operando(p: i32) -> bool {
    return ((((common.c2f_s2u_32(p) == (PAPEL_W as u32)) or (common.c2f_s2u_32(p) == (PAPEL_RP as u32))) or (common.c2f_s2u_32(p) == (PAPEL_RB as u32))) or (common.c2f_s2u_32(p) == (PAPEL_RL as u32))) or (common.c2f_s2u_32(p) == (PAPEL_PO as u32))
}

// C: driver/fmt_espaco.c:56
proc papel_do_tipo(tipo: u8) -> i32 {
    let sw_1 = tipo as i32
    if sw_1 == frontend.TK_IDENT or sw_1 == frontend.TK_INT or sw_1 == frontend.TK_REAL or sw_1 == frontend.TK_TEXTO or sw_1 == frontend.TK_FTEXTO_INICIO or sw_1 == frontend.KW_TRUE or sw_1 == frontend.KW_FALSE or sw_1 == frontend.KW_NONE {
        return PAPEL_W
    } else if sw_1 == frontend.KW_PROC {
        return PAPEL_PR
    } else if sw_1 == frontend.TK_LPAREN {
        return PAPEL_LP
    } else if sw_1 == frontend.TK_RPAREN {
        return PAPEL_RP
    } else if sw_1 == frontend.TK_LCOLCHETE {
        return PAPEL_LB
    } else if sw_1 == frontend.TK_RCOLCHETE {
        return PAPEL_RB
    } else if sw_1 == frontend.TK_COMMA {
        return PAPEL_CM
    } else if sw_1 == frontend.TK_COLON {
        return PAPEL_CO
    } else if sw_1 == frontend.TK_DOT {
        return PAPEL_DT
    } else if sw_1 == frontend.TK_DOTDOT or sw_1 == frontend.TK_DOTDOTLT or sw_1 == frontend.TK_DOTDOTEQ {
        return PAPEL_RG
    } else if sw_1 == frontend.TK_ASSIGN or sw_1 == frontend.TK_PLUSEQ or sw_1 == frontend.TK_MINUSEQ or sw_1 == frontend.TK_ARROW or sw_1 == frontend.TK_PLUS or sw_1 == frontend.TK_STAR or sw_1 == frontend.TK_SLASH or sw_1 == frontend.TK_PERCENT or sw_1 == frontend.TK_EQ or sw_1 == frontend.TK_NE or sw_1 == frontend.TK_LT or sw_1 == frontend.TK_LE or sw_1 == frontend.TK_GT or sw_1 == frontend.TK_GE or sw_1 == frontend.TK_PIPE or sw_1 == frontend.TK_SHL or sw_1 == frontend.TK_SHR or sw_1 == frontend.TK_BANG or sw_1 == frontend.KW_AND or sw_1 == frontend.KW_OR or sw_1 == frontend.KW_AS or sw_1 == frontend.KW_IN or sw_1 == frontend.KW_OR_ELSE {
        return PAPEL_BI
    } else if sw_1 == frontend.TK_MINUS or sw_1 == frontend.TK_AMP or sw_1 == frontend.TK_TIL or sw_1 == frontend.TK_INTERROGA or sw_1 == frontend.TK_CARET or sw_1 == frontend.TK_LBRACE or sw_1 == frontend.TK_RBRACE or sw_1 == frontend.TK_HASH {
        return PAPEL_UN
    } else {
        return PAPEL_K
    }
    return 0
}

// C: driver/fmt_espaco.c:78
// C2F-INDECIDIVEL: t
proc caret_pos_fixo(t: []FmtToken, i: u64, n: u64) -> bool {
    var tipo_depois: bool = false
    if ((common.c2f_b2i32(t[i].primeiro) != 0) or (i == 0)) or (not fim_de_operando(t[i - 1].papel as i32)) {
        return false
    }
    tipo_depois = (((i + 1) < n) and (not t[i + 1].primeiro)) and (((t[i + 1].tipo == (frontend.TK_IDENT as u8)) or (t[i + 1].tipo == (frontend.KW_PROC as u8))) or (t[i + 1].tipo == (frontend.TK_INTERROGA as u8)))
    return not tipo_depois
}

// C: driver/fmt_espaco.c:88
// A '{' que comeca em 'off' esta na lista de literais? A lista e a posicao dela avancam juntas (os dois crescem).
proc chave_eh_literal(chaves: ^[dynamic]u32, pos: ^u64, off: u32) -> bool {
    let lista = chaves^[..]
    while (pos^ < (len(lista) as u64)) and (lista[pos^] < off) {
        pos^ += 1
    }
    return (pos^ < (len(lista) as u64)) and (lista[pos^] == off)
}

// C: driver/fmt_espaco.c:97
// C2F-INDECIDIVEL: t
proc papel_ambiguo(t: []FmtToken, i: u64, n: u64) -> i32 {
    let depois_de_operando: bool = ((not t[i].primeiro) and (i > 0)) and (common.c2f_b2i32(fim_de_operando(t[i - 1].papel as i32)) != 0)
    if t[i].tipo == (frontend.TK_CARET as u8) {
        var tern_1: i32 = PAPEL_UN
        if common.c2f_b2i32(caret_pos_fixo(t, i, n)) != 0 {
            tern_1 = PAPEL_PO
        }
        return tern_1
    }
    if t[i].tipo == (frontend.TK_INTERROGA as u8) {
        return PAPEL_UN
    }
    var tern_2: i32 = PAPEL_UN
    if common.c2f_b2i32(depois_de_operando) != 0 {
        tern_2 = PAPEL_BI
    }
    return tern_2
}

// C: driver/fmt_espaco.c:106
// C2F-13: t fundido em n (len)
// chaves_literal passa de ^ para ?^ (o C testa NULL: `chaves_literal != NULL && ...`).
proc fmt_atribuir_papeis(t: []FmtToken, chaves_literal: ?^[dynamic]u32) {
    let n: u64 = len(t) as u64
    var abertas = make([dynamic]bool, alloc = heap) // por '{' aberta: era de literal?
    resize(&abertas, len(t) + 1)
    var topo: u64 = 0
    var pos_literal: u64 = 0
    for i in (0 as u64)..<n {
        var p: i32 = papel_do_tipo(t[i].tipo)
        if t[i].tipo == (frontend.TK_LBRACE as u8) {
            abertas[topo] = false
            if chaves_literal != none {
                abertas[topo] = chave_eh_literal(chaves_literal as ^[dynamic]u32, &pos_literal, t[i].ini)
            }
            p = PAPEL_LK
            if abertas[topo] {
                p = PAPEL_LL
            }
            topo += 1
        } else if t[i].tipo == (frontend.TK_RBRACE as u8) {
            p = PAPEL_RK
            if topo > 0 {
                topo -= 1
                if abertas[topo] {
                    p = PAPEL_RL
                }
            }
        } else if p == PAPEL_UN {
            p = papel_ambiguo(t, i, n)
        }
        t[i].papel = p as u8
    }
    delete(abertas)
}

// Valores do oraculo C (FmtEspacoDoPar, FmtPapelFecha, PapelDoTipo).
test "fmt_espaco: tabela de pares, papeis que fecham e papel do tipo" {
    expect(fmt_espaco_do_par(0, 0) == 1)
    expect(fmt_espaco_do_par(0, 3) == 0)
    expect(fmt_espaco_do_par(0, 16) == -1)
    expect(fmt_espaco_do_par(3, 7) == -1)
    expect(fmt_espaco_do_par(4, 8) == -1)
    expect(fmt_espaco_do_par(17, 0) == -1)
    expect(fmt_espaco_do_par(17, 1) == 1)
    expect(fmt_papel_fecha(4))
    expect(not fmt_papel_fecha(3))
    expect(not fmt_papel_fecha(0))
    expect(papel_do_tipo(frontend.KW_PROC as u8) == PAPEL_PR)
    expect(papel_do_tipo(frontend.KW_SWITCH as u8) == PAPEL_K)
    expect(papel_do_tipo(frontend.TK_IDENT as u8) == PAPEL_W)
    expect(papel_do_tipo(frontend.TK_LPAREN as u8) == PAPEL_LP)
    expect(papel_do_tipo(frontend.TK_COMMA as u8) == PAPEL_CM)
}

// A '{' de literal (em chaves_literal) e a '}' que a fecha ficam como o par de literal (LL/RL); sem a lista, LK/RK.
test "fmt_atribuir_papeis: chave de literal x chave de bloco" {
    var t: [2]FmtToken = {FmtToken{}, FmtToken{}}
    t[0].tipo = frontend.TK_LBRACE as u8
    t[0].ini = 0
    t[0].fim = 1
    t[1].tipo = frontend.TK_RBRACE as u8
    t[1].ini = 2
    t[1].fim = 3
    fmt_atribuir_papeis(t[..], none)
    expect((t[0].papel as i32) == PAPEL_LK)
    expect((t[1].papel as i32) == PAPEL_RK)
    var chaves = make([dynamic]u32, alloc = heap)
    append(&chaves, item = 0 as u32)
    fmt_atribuir_papeis(t[..], &chaves)
    expect((t[0].papel as i32) == PAPEL_LL)
    expect((t[1].papel as i32) == PAPEL_RL)
    delete(chaves)
}
