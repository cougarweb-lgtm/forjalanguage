import "common"
import "frontend"
import "semantic"

struct LocalVisivel {
    nome: i32
    categoria: ?str
    tipo: u32 // TipoId
    pos: u32
}

// C: driver/consultar_escopo.c:19
proc local_json(q: ^Consulta, l: ^LocalVisivel) {
    consulta_abrir_obj(q)
    consulta_chave_nome(q, "nome", l.nome)
    let arg_1: u64 = len((l.categoria or_else "")) as u64
    let arg_2: ?str = l.categoria
    let arg_3: str = "categoria"
    let arg_4: ^Consulta = q
    consulta_chave_texto(arg_4, arg_3, arg_2, arg_1)
    consulta_chave_tipo(q, "tipo", l.tipo)
    consulta_chave_pos(q, "pos", l.pos)
    consulta_fechar_obj(q)
}

// C: driver/consultar_escopo.c:31
proc locais_do_for(q: ^Consulta, off: u32, s: ?^frontend.Stmt) {
    var tern_1: ?^frontend.Expr = (s as ^frontend.Stmt).expr
    if (s as ^frontend.Stmt).expr2 != none {
        tern_1 = (s as ^frontend.Stmt).expr2
    }
    let cabeca: ?^frontend.Expr = tern_1
    if (cabeca != none) and (off >= frontend.ast_fim_expr(&q.fim, cabeca)) {
        var lit_1 = LocalVisivel{nome = (s as ^frontend.Stmt).nome, categoria = "for", tipo = (s as ^frontend.Stmt).tipo_local, pos = (s as ^frontend.Stmt).pos}
        local_json(q, &lit_1)
        if (s as ^frontend.Stmt).nome_indice >= 0 {
            var lit_2 = LocalVisivel{nome = (s as ^frontend.Stmt).nome_indice, categoria = "for_indice", tipo = semantic.TIPO_INT as u32, pos = (s as ^frontend.Stmt).pos}
            local_json(q, &lit_2)
        }
    }
    locais_dos_stmts(q, off, (s as ^frontend.Stmt).corpo)
}

// C: driver/consultar_escopo.c:42
proc locais_do_switch(q: ^Consulta, off: u32, s: ?^frontend.Stmt) {
    var i: u32 = 0
    while i < (s as ^frontend.Stmt).ncasos {
        let k: ^frontend.Caso = &((s as ^frontend.Stmt).casos or_else {})[i]
        if (k.pos > off) or (off >= frontend.ast_fim_caso(&q.fim, k)) {
            i += 1
            continue
        }
        if ((s as ^frontend.Stmt).nome >= 0) and (k.local_id >= 0) {
            var lit_1 = LocalVisivel{nome = (s as ^frontend.Stmt).nome, categoria = "switch", tipo = k.tipo, pos = k.pos}
            local_json(q, &lit_1)
        }
        locais_dos_stmts(q, off, k.corpo)
        i += 1
    }
}

// C: driver/consultar_escopo.c:53
proc locais_do_let(q: ^Consulta, s: ?^frontend.Stmt) {
    if ((s as ^frontend.Stmt).tipo_no == (frontend.ST_LET as u8)) or ((s as ^frontend.Stmt).tipo_no == (frontend.ST_VAR as u8)) {
        var tern_1: str = "let"
        if (s as ^frontend.Stmt).tipo_no == (frontend.ST_VAR as u8) {
            tern_1 = "var"
        }
        var lit_1 = LocalVisivel{nome = (s as ^frontend.Stmt).nome, categoria = tern_1, tipo = (s as ^frontend.Stmt).tipo_local, pos = (s as ^frontend.Stmt).pos}
        local_json(q, &lit_1)
        return
    }
    var i: u32 = 0
    while ((s as ^frontend.Stmt).tipo_no == (frontend.ST_LET_MULTIPLO as u8)) and (i < (s as ^frontend.Stmt).ncasos) {
        if ((s as ^frontend.Stmt).nomes or_else {})[i].local_id >= 0 {
            var tern_2: str = "let"
            if (s as ^frontend.Stmt).op == 1 {
                tern_2 = "var"
            }
            var lit_2 = LocalVisivel{nome = ((s as ^frontend.Stmt).nomes or_else {})[i].nome, categoria = tern_2, tipo = ((s as ^frontend.Stmt).nomes or_else {})[i].tipo, pos = ((s as ^frontend.Stmt).nomes or_else {})[i].pos}
            local_json(q, &lit_2)
        }
        i += 1
    }
}

// C: driver/consultar_escopo.c:65
proc locais_dentro(q: ^Consulta, off: u32, s: ?^frontend.Stmt) {
    if (s as ^frontend.Stmt).tipo_no == (frontend.ST_FOR as u8) {
        locais_do_for(q, off, s)
    } else if (s as ^frontend.Stmt).tipo_no == (frontend.ST_SWITCH as u8) {
        locais_do_switch(q, off, s)
    } else if ((s as ^frontend.Stmt).tipo_no != (frontend.ST_LET as u8)) and ((s as ^frontend.Stmt).tipo_no != (frontend.ST_VAR as u8)) {
        locais_dos_stmts(q, off, (s as ^frontend.Stmt).corpo)
        locais_dos_stmts(q, off, (s as ^frontend.Stmt).senao)
    }
}

// C: driver/consultar_escopo.c:76
proc locais_dos_stmts(q: ^Consulta, off: u32, s: ?^frontend.Stmt) {
    var s_v: ?^frontend.Stmt = s
    while (s_v != none) and ((s_v as ^frontend.Stmt).pos <= off) {
        if off < frontend.ast_fim_stmt(&q.fim, s_v) {
            locais_dentro(q, off, s_v)
        } else {
            locais_do_let(q, s_v)
        }
        s_v = (s_v as ^frontend.Stmt).prox
    }
}

// C: driver/consultar_escopo.c:84
proc locais_json(q: ^Consulta, off: u32, d: ?^frontend.Decl) {
    consulta_abrir_lista(q, "locais")
    if (d != none) and (((d as ^frontend.Decl).tipo_no == (frontend.D_PROC as u8)) or ((d as ^frontend.Decl).tipo_no == (frontend.D_TEST as u8))) {
        for i in (0 as u32)..<(d as ^frontend.Decl).nparams {
            var lit_1 = LocalVisivel{nome = ((d as ^frontend.Decl).params or_else {})[i].nome, categoria = "param", tipo = ((d as ^frontend.Decl).params or_else {})[i].tipo.tipo, pos = ((d as ^frontend.Decl).params or_else {})[i].pos}
            local_json(q, &lit_1)
        }
        locais_dos_stmts(q, off, (d as ^frontend.Decl).corpo)
    }
    consulta_fechar_lista(q)
}

// C: driver/consultar_escopo.c:96
// qualificado = none nos globais do proprio modulo; o texto "apelido.nome" nos importados (C: Buf* NULL ou nao)
proc global_json(q: ^Consulta, d: ?^frontend.Decl, qualificado: ?str) {
    let dec: ^frontend.Decl = d as ^frontend.Decl
    let categoria: str = semantic.indice_categoria(d)
    consulta_abrir_obj(q)
    consulta_chave_nome(q, "nome", dec.nome)
    consulta_chave_texto(q, "categoria", categoria, len(categoria) as u64)
    consulta_chave_modulo(q, "modulo", dec.modulo)
    consulta_chave_texto(q, "qualificado", qualificado, len(qualificado or_else "") as u64)
    consulta_chave_bool(q, "publico", dec.publico)
    consulta_chave_arquivo_se_pacote(q, dec.pos)
    consulta_chave_pos(q, "pos", dec.pos)
    consulta_fechar_obj(q)
}

// C: driver/consultar_escopo.c:110
proc apelido_do_import(q: ^Consulta, imp: ?^frontend.Decl) -> i32 {
    var tern_1: i32 = 0
    if (imp as ^frontend.Decl).nome_a >= 0 {
        tern_1 = (imp as ^frontend.Decl).nome_a
    } else {
        tern_1 = (q.c as ^Compilacao).modulos.itens[(imp as ^frontend.Decl).indice].apelido
    }
    return tern_1
}

// C: driver/consultar_escopo.c:115
proc globais_importados(q: ^Consulta, imp: ?^frontend.Decl) {
    let nomes: ^common.Interner = &(q.c as ^Compilacao).nomes
    let apelido: i32 = apelido_do_import(q, imp)
    let indice_imp: i32 = (imp as ^frontend.Decl).indice as i32
    var d: ?^frontend.Decl = ((q.c as ^Compilacao).sem.programa as ^frontend.Programa).primeira
    while d != none {
        let dec: ^frontend.Decl = d as ^frontend.Decl
        if ((dec.modulo as i32) != indice_imp) or (not dec.publico) or (not consulta_eh_simbolo(d)) {
            d = dec.prox
            continue
        }
        var nome = make([dynamic]u8, alloc = heap)
        let nome_ap: str = common.interner_texto(nomes, apelido)[0..<common.interner_tam(nomes, apelido)]
        let nome_dec: str = common.interner_texto(nomes, dec.nome)[0..<common.interner_tam(nomes, dec.nome)]
        format(f"{nome_ap}.{nome_dec}", into = &nome)
        let qualificado = to_str(&nome)
        global_json(q, d, qualificado)
        delete(qualificado)
        delete(nome)
        d = dec.prox
    }
}

// C: driver/consultar_escopo.c:130
proc import_do_arquivo_do_ponto(q: ^Consulta, d: ?^frontend.Decl, off: u32) -> bool {
    return ((d as ^frontend.Decl).tipo_no == (frontend.D_IMPORT as u8)) and (consulta_trecho_do_offset(q, (d as ^frontend.Decl).pos) == consulta_trecho_do_offset(q, off))
}

// C: driver/consultar_escopo.c:135
proc globais_json(q: ^Consulta, modulo: u8, off: u32) {
    consulta_abrir_lista(q, "globais")
    var d: ?^frontend.Decl = ((q.c as ^Compilacao).sem.programa as ^frontend.Programa).primeira
    while d != none {
        let dec: ^frontend.Decl = d as ^frontend.Decl
        if (dec.modulo == modulo) and consulta_eh_simbolo(d) {
            global_json(q, d, none)
        }
        d = dec.prox
    }
    d = ((q.c as ^Compilacao).sem.programa as ^frontend.Programa).primeira
    while d != none {
        let dec: ^frontend.Decl = d as ^frontend.Decl
        if (dec.modulo == modulo) and import_do_arquivo_do_ponto(q, d, off) {
            globais_importados(q, d)
        }
        d = dec.prox
    }
    consulta_fechar_lista(q)
}

// C: driver/consultar_escopo.c:147
proc importados_json(q: ^Consulta, modulo: u8, off: u32) {
    consulta_abrir_lista(q, "importados")
    var d: ?^frontend.Decl = ((q.c as ^Compilacao).sem.programa as ^frontend.Programa).primeira
    while d != none {
        if (((d as ^frontend.Decl).modulo as i32) != (modulo as i32)) or (not import_do_arquivo_do_ponto(q, d, off)) {
            d = (d as ^frontend.Decl).prox
            continue
        }
        consulta_abrir_obj(q)
        consulta_chave_nome(q, "apelido", apelido_do_import(q, d))
        consulta_chave_modulo(q, "modulo", (d as ^frontend.Decl).indice as u8)
        consulta_fechar_obj(q)
        d = (d as ^frontend.Decl).prox
    }
    consulta_fechar_lista(q)
}

// C: driver/consultar_escopo.c:160
proc consultar_escopo(q: ^Consulta, p: ^PedidoConsulta) -> i32 {
    var pos: PosicaoPedida = PosicaoPedida{}
    var d: ?^frontend.Decl = none
    var modulo: u8 = 0
    if not consulta_ler_posicao(q, (p.arg or_else ""), &pos) {
        return CONSULTAR_USO
    }
    d = consulta_decl_em(q, pos.off)
    modulo = consulta_modulo_do_offset(q, pos.off)
    consulta_abrir(q, "escopo")
    let arg_1: u64 = len((pos.arquivo or_else "")) as u64
    let arg_2: ?str = pos.arquivo
    let arg_3: str = "arquivo"
    let arg_4: ^Consulta = q
    consulta_chave_texto(arg_4, arg_3, arg_2, arg_1)
    consulta_chave_int(q, "linha", pos.linha as i64)
    consulta_chave_int(q, "coluna", pos.coluna as i64)
    consulta_chave_modulo(q, "modulo", modulo)
    if d != none {
        consulta_chave_id(q, "em", d)
    } else {
        consulta_chave_texto(q, "em", none, 0)
    }
    locais_json(q, pos.off, d)
    globais_json(q, modulo, pos.off)
    importados_json(q, modulo, pos.off)
    consulta_fechar(q)
    return CONSULTAR_OK
}
