import "common"
import "frontend"
import "semantic"

// C: driver/consultar_decl.c:12
proc consulta_eh_simbolo(d: ?^frontend.Decl) -> bool {
    let sw_1 = common.c2f_s2u_32(((d as ^frontend.Decl).tipo_no as i32))
    if sw_1 == (frontend.D_UNIDADE_BASE as u32) or sw_1 == (frontend.D_UNIDADE_DERIV as u32) or sw_1 == (frontend.D_CONST as u32) or sw_1 == (frontend.D_STRUCT as u32) or sw_1 == (frontend.D_ENUM as u32) or sw_1 == (frontend.D_PROC as u32) or sw_1 == (frontend.D_UNIAO as u32) {
        return true
    } else {
        return false
    }
    return false
}

// C: driver/consultar_decl.c:26
proc modulo_casa(q: ^Consulta, d: ?^frontend.Decl, modulo: ?str) -> bool {
    if modulo == none {
        return true
    }
    let alvo: str = modulo or_else ""
    let nomes: ^common.Interner = &(q.c as ^Compilacao).nomes
    let caminho: i32 = (q.c as ^Compilacao).modulos.itens[(d as ^frontend.Decl).modulo].caminho
    let tam_caminho: int = common.interner_tam(nomes, caminho) as int
    if tam_caminho != len(alvo) {
        return false
    }
    return common.interner_texto(nomes, caminho)[0..<tam_caminho] == alvo
}

// C: driver/consultar_decl.c:36
proc nome_eh(q: ^Consulta, d: ?^frontend.Decl, texto: str) -> bool {
    let dec: ^frontend.Decl = d as ^frontend.Decl
    if dec.nome < 0 {
        return false
    }
    let nomes: ^common.Interner = &(q.c as ^Compilacao).nomes
    let tam_nome: int = common.interner_tam(nomes, dec.nome) as int
    if tam_nome != len(texto) {
        return false
    }
    return common.interner_texto(nomes, dec.nome)[0..<tam_nome] == texto
}

// C: driver/consultar_decl.c:41
proc consulta_entrada_de(q: ^Consulta, d: ?^frontend.Decl) -> ?str {
    let dec: ^frontend.Decl = d as ^frontend.Decl
    if (dec.tipo_no != (frontend.D_PROC as u8)) or dec.externo {
        return none
    }
    if dec.exportado {
        return "export"
    }
    if (dec.modulo == 0) and nome_eh(q, d, "main") {
        return "main"
    }
    return none
}

// C: driver/consultar_decl.c:48
proc chave_entrada(q: ^Consulta, d: ?^frontend.Decl) {
    let entrada: ?str = consulta_entrada_de(q, d)
    var tern_1: u64 = 0
    if entrada != none {
        tern_1 = len((entrada or_else "")) as u64
    }
    consulta_chave_texto(q, "entrada", entrada, tern_1)
}

// C: driver/consultar_decl.c:54
proc chave_local_da_decl(q: ^Consulta, d: ?^frontend.Decl) {
    consulta_chave_id(q, "id", d)
    consulta_chave_modulo(q, "modulo", (d as ^frontend.Decl).modulo)
    consulta_chave_arquivo(q, (d as ^frontend.Decl).pos)
    consulta_chave_pos(q, "pos", consulta_inicio_decl(q, d))
    consulta_chave_pos(q, "pos_nome", (d as ^frontend.Decl).pos)
    consulta_chave_pos(q, "fim", frontend.ast_fim_decl(&q.fim, d))
    consulta_chave_bool(q, "publico", (d as ^frontend.Decl).publico)
    consulta_chave_bool(q, "exportado", (d as ^frontend.Decl).exportado)
}

// C: driver/consultar_decl.c:66
proc simbolo_json(q: ^Consulta, d: ?^frontend.Decl) {
    let dec: ^frontend.Decl = d as ^frontend.Decl
    let categoria: str = semantic.indice_categoria(d)
    consulta_abrir_obj(q)
    consulta_chave_nome(q, "nome", dec.nome)
    consulta_chave_texto(q, "categoria", categoria, len(categoria) as u64)
    chave_local_da_decl(q, d)
    chave_entrada(q, d)
    if dec.tipo_no == (frontend.D_PROC as u8) {
        var assinatura = make([dynamic]u8, alloc = heap)
        defer delete(assinatura)
        consulta_assinatura_texto(q, d, &assinatura)
        let assinatura_txt = to_str(&assinatura)
        defer delete(assinatura_txt)
        consulta_chave_texto(q, "assinatura", assinatura_txt, len(assinatura_txt) as u64)
    } else if dec.tipo_no == (frontend.D_CONST as u8) {
        consulta_chave_tipo(q, "tipo", dec.tipo.tipo)
    }
    consulta_fechar_obj(q)
}

// C: driver/consultar_decl.c:86
proc consultar_simbolos(q: ^Consulta, p: ^PedidoConsulta) -> i32 {
    var achou_modulo: bool = p.modulo == none
    consulta_abrir(q, "simbolos")
    consulta_abrir_lista(q, "simbolos")
    var d: ?^frontend.Decl = ((q.c as ^Compilacao).sem.programa as ^frontend.Programa).primeira
    while d != none {
        if (not consulta_eh_simbolo(d)) or (not modulo_casa(q, d, p.modulo)) {
            d = (d as ^frontend.Decl).prox
            continue
        }
        achou_modulo = true
        simbolo_json(q, d)
        d = (d as ^frontend.Decl).prox
    }
    consulta_fechar_lista(q)
    consulta_fechar(q)
    if not achou_modulo {
        return consulta_uso_errado("simbolos", p.modulo, "nao e modulo do projeto (use o caminho do import, ex.: std:mem)")
    }
    return CONSULTAR_OK
}

// C: driver/consultar_decl.c:105
proc chave_padrao(q: ^Consulta, padrao: ?^frontend.Expr) {
    if padrao == none {
        consulta_chave_texto(q, "padrao", none, 0)
    } else {
        let arg_1: u32 = frontend.ast_fim_expr(&q.fim, padrao)
        let arg_2: u32 = (padrao as ^frontend.Expr).pos
        let arg_3: str = "padrao"
        let arg_4: ^Consulta = q
        consulta_chave_trecho(arg_4, arg_3, arg_2, arg_1)
    }
}

// C: driver/consultar_decl.c:111
proc parametros_json(q: ^Consulta, d: ?^frontend.Decl) {
    consulta_abrir_lista(q, "params")
    var i: u32 = 0
    while i < (d as ^frontend.Decl).nparams {
        let p: ^frontend.Param = &((d as ^frontend.Decl).params or_else {})[i]
        consulta_abrir_obj(q)
        consulta_chave_nome(q, "nome", p.nome)
        consulta_chave_tipo(q, "tipo", p.tipo.tipo)
        chave_padrao(q, p.padrao)
        consulta_chave_int(q, "indice", i as i64)
        consulta_chave_pos(q, "pos", p.pos)
        consulta_fechar_obj(q)
        i += 1
    }
    consulta_fechar_lista(q)
}

// C: driver/consultar_decl.c:127
proc retornos_json(q: ^Consulta, d: ?^frontend.Decl) {
    let multiplo: bool = (common.c2f_b2i32((d as ^frontend.Decl).tem_retorno) != 0) and ((d as ^frontend.Decl).retorno.forma == (frontend.TR_TUPLA as u8))
    consulta_abrir_lista(q, "retornos")
    var i: u32 = 0
    while (common.c2f_b2i32(multiplo) != 0) and (i < (d as ^frontend.Decl).nretornos) {
        consulta_abrir_obj(q)
        consulta_chave_nome(q, "nome", ((d as ^frontend.Decl).retornos or_else {})[i].nome)
        consulta_chave_tipo(q, "tipo", ((d as ^frontend.Decl).retornos or_else {})[i].tipo.tipo)
        consulta_fechar_obj(q)
        i += 1
    }
    consulta_fechar_lista(q)
}

// C: driver/consultar_decl.c:141
proc consultar_assinatura(q: ^Consulta, p: ^PedidoConsulta) -> i32 {
    let d: ?^frontend.Decl = consulta_achar_decl(q, p.arg)
    if d == none {
        return consulta_uso_errado("assinatura", p.arg, "nao existe no projeto")
    }
    let dec: ^frontend.Decl = d as ^frontend.Decl
    if dec.tipo_no != (frontend.D_PROC as u8) {
        return consulta_uso_errado("assinatura", p.arg, "nao e proc (struct, union e enum: forja consultar campos)")
    }
    consulta_abrir(q, "assinatura")
    consulta_chave_nome(q, "nome", dec.nome)
    let categoria: str = semantic.indice_categoria(d)
    consulta_chave_texto(q, "categoria", categoria, len(categoria) as u64)
    chave_local_da_decl(q, d)
    chave_entrada(q, d)
    consulta_chave_bool(q, "externo", dec.externo)
    parametros_json(q, d)
    if dec.tem_retorno {
        consulta_chave_tipo(q, "retorno", dec.retorno.tipo)
        consulta_chave_nome(q, "erro", dec.retorno.erro)
    } else {
        consulta_chave_tipo(q, "retorno", frontend.TIPO_NAO_RESOLVIDO as u32)
        consulta_chave_nome(q, "erro", -1)
    }
    retornos_json(q, d)
    var texto = make([dynamic]u8, alloc = heap)
    defer delete(texto)
    consulta_assinatura_texto(q, d, &texto)
    let texto_txt = to_str(&texto)
    defer delete(texto_txt)
    consulta_chave_texto(q, "texto", texto_txt, len(texto_txt) as u64)
    consulta_fechar(q)
    return CONSULTAR_OK
}

// C: driver/consultar_decl.c:167
proc campos_json(q: ^Consulta, d: ?^frontend.Decl) {
    consulta_abrir_lista(q, "campos")
    var i: u32 = 0
    while i < (d as ^frontend.Decl).ncampos {
        let c: ^frontend.Campo = &((d as ^frontend.Decl).campos or_else {})[i]
        consulta_abrir_obj(q)
        consulta_chave_nome(q, "nome", c.nome)
        consulta_chave_tipo(q, "tipo", c.tipo.tipo)
        chave_padrao(q, c.padrao)
        consulta_chave_int(q, "indice", i as i64)
        consulta_chave_pos(q, "pos", c.pos)
        consulta_fechar_obj(q)
        i += 1
    }
    consulta_fechar_lista(q)
}

// C: driver/consultar_decl.c:183
proc membros_json(q: ^Consulta, d: ?^frontend.Decl) {
    consulta_abrir_lista(q, "membros")
    var i: u32 = 0
    while i < (d as ^frontend.Decl).nmembros {
        let m: ^frontend.Membro = &((d as ^frontend.Decl).membros or_else {})[i]
        consulta_abrir_obj(q)
        consulta_chave_nome(q, "nome", m.nome)
        consulta_chave_int(q, "indice", i as i64)
        if (d as ^frontend.Decl).op == 1 {
            consulta_chave_int(q, "valor", m.valor)
        } else {
            consulta_chave_texto(q, "valor", none, 0)
        }
        consulta_chave_pos(q, "pos", m.pos)
        consulta_fechar_obj(q)
        i += 1
    }
    consulta_fechar_lista(q)
}

// C: driver/consultar_decl.c:199
proc consultar_campos(q: ^Consulta, p: ^PedidoConsulta) -> i32 {
    let d: ?^frontend.Decl = consulta_achar_decl(q, p.arg)
    if d == none {
        return consulta_uso_errado("campos", p.arg, "nao existe no projeto")
    }
    if (((d as ^frontend.Decl).tipo_no != (frontend.D_STRUCT as u8)) and ((d as ^frontend.Decl).tipo_no != (frontend.D_UNIAO as u8))) and ((d as ^frontend.Decl).tipo_no != (frontend.D_ENUM as u8)) {
        return consulta_uso_errado("campos", p.arg, "nao e struct, union nem enum (campos vale so para esses)")
    }
    consulta_abrir(q, "campos")
    consulta_chave_nome(q, "nome", (d as ^frontend.Decl).nome)
    let arg_1: u64 = len(semantic.indice_categoria(d)) as u64
    let arg_2: str = semantic.indice_categoria(d)
    let arg_3: str = "categoria"
    let arg_4: ^Consulta = q
    consulta_chave_texto(arg_4, arg_3, arg_2, arg_1)
    chave_local_da_decl(q, d)
    if (d as ^frontend.Decl).tipo_no == (frontend.D_ENUM as u8) {
        membros_json(q, d)
    } else {
        campos_json(q, d)
    }
    consulta_fechar(q)
    return CONSULTAR_OK
}
