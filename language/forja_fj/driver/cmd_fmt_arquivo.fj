import "std:file"
import "cache"
import "common"

// C: driver/cmd_fmt_arquivo.c:19
proc classificar_arquivo(r: ^FmtResultado) -> i32 {
    if common.c2f_s2u_32(r.estado) == (FMT_NAO_ANALISADO as u32) {
        return FMT_ARQ_NAO_ANALISADO
    }
    var tern_1: i32 = FMT_ARQ_MUDARIA
    if common.c2f_s2u_32(r.estado) == (FMT_CANONICO as u32) {
        tern_1 = FMT_ARQ_CANONICO
    }
    return tern_1
}

// C: driver/cmd_fmt_arquivo.c:26
proc contar_linhas(txt: ?str, tam: u64) -> u32 {
    var n: u32 = 0
    for k in (0 as u64)..<tam {
        n += common.c2f_b2u32((txt or_else "")[k] == 10) // '\n'
    }
    var tern_1: i32 = 0
    if (tam > 0) and ((txt or_else "")[tam - 1] != 10) {
        tern_1 = 1
    }
    return n + common.c2f_s2u_32(tern_1) // '\n'
}

// C: driver/cmd_fmt_arquivo.c:34
proc emitir_linha_apagada(saida: ^[dynamic]u8, ini: str, n: u64, tem_fim: bool) {
    append(saida, item = "-")
    append(saida, item = ini[0..<n])
    var tern_1: str = "\n\\ No newline at end of file\n"
    if common.c2f_b2i32(tem_fim) != 0 {
        tern_1 = "\n"
    }
    append(saida, item = tern_1)
}

// c2f_saida_stdout/stderr devolvem objeto NOVO no heap: cada escrita cria o seu e o solta (saida_soltar, de cmd_fmt.fj).
proc escrever_stdout(dados: []u8) {
    let out = common.c2f_saida_stdout()
    defer saida_soltar(out)
    common.c2f_saida_escrever(out, dados)
}

proc escrever_stderr(msg: str) {
    let err = common.c2f_saida_stderr()
    defer saida_soltar(err)
    common.c2f_saida_formatar(err, msg)
}

// C: driver/cmd_fmt_arquivo.c:26 (posicao do '\n' a partir de ini; tam quando a linha nao tem fim)
proc posicao_do_fim_de_linha(txt: str, ini: u64, tam: u64) -> u64 {
    for k in ini..<tam {
        if txt[k] == 10 {
            return k
        }
    }
    return tam
}

// C: driver/cmd_fmt_arquivo.c:42
// Diff de apagamento total: cada linha do texto original sai com '-'.
proc diff_apagamento_total(saida: ^[dynamic]u8, caminho: str, r: ^FmtResultado) {
    let texto: str = from_bytes(r.normalizado[..], alloc = heap)
    defer delete(texto)
    let tam: u64 = len(r.normalizado) as u64
    let n_linhas: u32 = contar_linhas(texto, tam)
    format(f"--- a/{caminho}\n+++ b/{caminho}\n@@ -1,{n_linhas} +0,0 @@\n", into = saida)
    var ini: u64 = 0
    while ini < tam {
        let fim_idx: u64 = posicao_do_fim_de_linha(texto, ini, tam)
        emitir_linha_apagada(saida, texto[ini..<tam], fim_idx - ini, fim_idx < tam)
        ini = fim_idx + 1
    }
}

// C: driver/cmd_fmt_arquivo.c:58
// O diff do arquivo anexado a saida; so BOM ou CRLF nao tem diff de texto e sai um comentario. false = o motor recusou as edicoes (erro interno).
proc diff_do_arquivo(saida: ^[dynamic]u8, caminho: str, r: ^FmtResultado) -> bool {
    if (len(r.formatado) == 0) and (len(r.normalizado) > 0) {
        diff_apagamento_total(saida, caminho, r)
        return true
    }
    if len(r.edicoes) == 0 {
        format(f"# {caminho}: so BOM e/ou fim de linha CRLF; o texto ja e canonico\n", into = saida)
        return true
    }
    let texto: str = from_bytes(r.normalizado[..], alloc = heap)
    defer delete(texto)
    let tam: u64 = len(r.normalizado) as u64
    return edicoes_diff(texto, tam, &r.edicoes[0], len(r.edicoes) as u32, caminho, saida) == EDICAO_OK
}

// C: driver/cmd_fmt_arquivo.c:71
proc mostrar_diff(caminho: str, r: ^FmtResultado) -> bool {
    var diff = make([dynamic]u8, alloc = heap)
    defer delete(diff)
    let ok = diff_do_arquivo(&diff, caminho, r)
    if ok and (len(diff) > 0) {
        escrever_stdout(diff[..])
    }
    if not ok {
        let msg = format(f"forja: fmt: nao consegui montar o diff de '{caminho}' (erro interno)\n", alloc = heap)
        defer delete(msg)
        escrever_stderr(msg)
    }
    return ok
}

// C: driver/cmd_fmt_arquivo.c:82
proc imprimir_nao_analisado(caminho: str, r: ^FmtResultado) {
    let codigo: str = r.codigo or_else ""
    var rotulo: str = "sem codigo"
    if len(codigo) > 0 {
        rotulo = codigo
    }
    let motivo: str = r.motivo or_else "(null)"
    let msg = format(f"forja: fmt: {caminho}: nao analisado ({rotulo}, linha {r.diag_linha}, coluna {r.diag_coluna}): {motivo}\n", alloc = heap)
    defer delete(msg)
    escrever_stderr(msg)
}

// C: driver/cmd_fmt_arquivo.c:88
proc texto_eh_canonico(dados: ?str, tam: u64) -> bool {
    var r: FmtResultado = FmtResultado{estado = 0}
    var canonico: bool = false
    fmt_formatar(dados, tam, &r)
    canonico = common.c2f_s2u_32(r.estado) == (FMT_CANONICO as u32)
    fmt_resultado_liberar(&r)
    return canonico
}

// C: driver/cmd_fmt_arquivo.c:99
proc desfazer_gravacao(caminho: str, original: ?str, tam: u64) {
    if edicoes_desfazer(caminho, original, tam) {
        let msg_1 = format(f"forja: fmt: a conferencia de '{caminho}' falhou; o arquivo voltou ao original\n", alloc = heap)
        defer delete(msg_1)
        common.c2f_saida_formatar(common.c2f_saida_stderr(), msg_1)
    } else {
        let msg_2 = format(f"forja: fmt: a conferencia de '{caminho}' falhou e nao consegui devolver o original (confira o arquivo)\n", alloc = heap)
        defer delete(msg_2)
        common.c2f_saida_formatar(common.c2f_saida_stderr(), msg_2)
    }
}

// C: driver/cmd_fmt_arquivo.c:106
// Relê o arquivo gravado: tem de dar canonico; senao volta ao original.
proc conferir_gravado(caminho: str, original: ?str, tam: u64) -> bool {
    var novo = make([dynamic]u8, alloc = heap)
    defer delete(novo)
    var ok = false
    if cache.arquivo_ler_inteiro(caminho, &novo) {
        let tam_novo: u64 = (len(novo) - 1) as u64
        let texto: str = from_bytes(novo[0..<(tam_novo as int)], alloc = heap)
        ok = texto_eh_canonico(texto, tam_novo)
        delete(texto)
    } else {
        let msg = format(f"forja: fmt: nao consegui reler '{caminho}' depois de gravar\n", alloc = heap)
        defer delete(msg)
        escrever_stderr(msg)
    }
    if not ok {
        desfazer_gravacao(caminho, original, tam)
    }
    return ok
}

// C: _access(caminho, 2) para o arquivo: aproximacao igual a eh_somente_leitura de common/fonte.fj (std:file nao tem o atributo de so-leitura).
proc arquivo_tem_escrita(caminho: str) -> bool {
    if not file.exists(caminho) {
        return false
    }
    switch r in file.open(caminho, file.OpenMode.append) {
    case file.File:
        var arq: file.File = r
        file.close(&arq)
        return true
    case file.FileError:
        return not (r == file.FileError.no_permission)
    }
    return false
}

// C: driver/cmd_fmt_arquivo.c:120
// O atributo so-leitura do Windows vale: a gravacao atomica trocaria o arquivo mesmo assim, por isso a permissao e conferida antes (false = nao grava).
proc gravacao_permitida(caminho: str) -> bool {
    if arquivo_tem_escrita(caminho) {
        return true
    }
    let msg = format(f"forja: fmt: '{caminho}' e so-leitura; nao gravei (o arquivo ficou como estava)\n", alloc = heap)
    defer delete(msg)
    escrever_stderr(msg)
    return false
}

// C: driver/cmd_fmt_arquivo.c:128
// Grava o texto canonico (LF, sem BOM) de forma atomica e confere a gravacao. false = nao gravou (o arquivo fica como estava) ou a conferencia falhou.
proc gravar_formatado(caminho: str, original: ?str, tam: u64, r: ^FmtResultado) -> bool {
    if not gravacao_permitida(caminho) {
        return false
    }
    let dados: str = from_bytes(r.formatado[..], alloc = heap)
    defer delete(dados)
    var erro: i32 = 0
    if not common.arquivo_gravar_atomico(caminho, dados, len(r.formatado) as u64, &erro) {
        let msg = format(f"forja: fmt: nao consegui gravar '{caminho}' (errno {erro}); o arquivo ficou como estava\n", alloc = heap)
        defer delete(msg)
        escrever_stderr(msg)
        return false
    }
    return conferir_gravado(caminho, original, tam)
}

// C: driver/cmd_fmt_arquivo.c:142
// A saida padrao de um arquivo (so sem --json): o diff no dry-run, a linha 'gravado:' com --aplicar, a causa do nao analisado no stderr.
proc mostrar_arquivo(x: ^FmtExecucao, caminho: str, estado: i32, r: ^FmtResultado) -> bool {
    if (x.pedido as ^FmtPedido).json {
        return true
    }
    if estado == FMT_ARQ_MUDARIA {
        return mostrar_diff(caminho, r)
    }
    if estado == FMT_ARQ_GRAVADO {
        let msg = format(f"gravado: {caminho}\n", alloc = heap)
        defer delete(msg)
        escrever_stdout(as_bytes(msg))
        return true
    }
    if estado == FMT_ARQ_NAO_ANALISADO {
        imprimir_nao_analisado(caminho, r)
    }
    return true
}

// C: driver/cmd_fmt_arquivo.c:154
proc contar_arquivo(totais: ^FmtTotais, estado: i32) {
    totais.arquivos += 1
    let sw_1 = common.c2f_s2u_32(estado)
    if sw_1 == (FMT_ARQ_CANONICO as u32) {
        totais.canonicos += 1
    } else if sw_1 == (FMT_ARQ_MUDARIA as u32) {
        totais.mudariam += 1
    } else if sw_1 == (FMT_ARQ_GRAVADO as u32) {
        totais.gravados += 1
    } else if sw_1 == (FMT_ARQ_NAO_ANALISADO as u32) {
        totais.nao_analisados += 1
    }
}

// C: driver/cmd_fmt_arquivo.c:165
// Le, formata e (com --aplicar) grava um arquivo; anexa o resultado ao texto ou ao JSON da execucao. false = erro de leitura, gravacao ou verificacao (mensagem no stderr; exit 2).
proc fmt_processar_arquivo(caminho: str, x: ^FmtExecucao) -> bool {
    var lido = make([dynamic]u8, alloc = heap)
    defer delete(lido)
    if not cache.arquivo_ler_inteiro(caminho, &lido) {
        let msg = format(f"forja: fmt: nao consegui ler '{caminho}'\n", alloc = heap)
        defer delete(msg)
        escrever_stderr(msg)
        return false
    }
    let tam: u64 = (len(lido) - 1) as u64
    let original: str = from_bytes(lido[0..<(tam as int)], alloc = heap)
    defer delete(original)
    var r: FmtResultado = FmtResultado{estado = 0}
    fmt_formatar(original, tam, &r)
    var estado: i32 = classificar_arquivo(&r)
    var ok = true
    if (estado == FMT_ARQ_MUDARIA) and (x.pedido as ^FmtPedido).aplicar {
        ok = gravar_formatado(caminho, original, tam, &r)
        if ok {
            estado = FMT_ARQ_GRAVADO
        }
    }
    if ok {
        ok = mostrar_arquivo(x, caminho, estado, &r)
    }
    if ok {
        contar_arquivo(&x.totais, estado)
        if (x.pedido as ^FmtPedido).json {
            fmt_json_arquivo(&x.json, caminho, estado, &r)
        }
    }
    fmt_resultado_liberar(&r)
    return ok
}

test "contar_linhas, posicao_do_fim_de_linha e emitir_linha_apagada" {
    expect(contar_linhas("a\nb", 3) == 2)
    expect(contar_linhas("a\n", 2) == 1)
    expect(contar_linhas("", 0) == 0)
    expect(posicao_do_fim_de_linha("ab\ncd", 0, 5) == 2)
    expect(posicao_do_fim_de_linha("ab\ncd", 2, 5) == 2)
    expect(posicao_do_fim_de_linha("ab\ncd", 3, 5) == 5)
    expect(posicao_do_fim_de_linha("abc", 0, 3) == 3)
    var a = make([dynamic]u8, alloc = heap)
    emitir_linha_apagada(&a, "abc", 3, true)
    let t1 = to_str(&a)
    expect(t1 == "-abc\n")
    delete(t1)
    var b = make([dynamic]u8, alloc = heap)
    emitir_linha_apagada(&b, "abc", 3, false)
    let t2 = to_str(&b)
    expect(t2 == "-abc\n\\ No newline at end of file\n")
    delete(t2)
}

test "diff_apagamento_total, classificar_arquivo, contar_arquivo e diff_do_arquivo sem edicoes" {
    var r: FmtResultado = FmtResultado{}
    r.normalizado = make([dynamic]u8, alloc = heap)
    append(&r.normalizado, items = as_bytes("a\nb"))
    var saida = make([dynamic]u8, alloc = heap)
    diff_apagamento_total(&saida, "x.fj", &r)
    let t1 = to_str(&saida)
    expect(t1 == "--- a/x.fj\n+++ b/x.fj\n@@ -1,2 +0,0 @@\n-a\n-b\n\\ No newline at end of file\n")
    delete(t1)
    delete(r.normalizado)
    var s: FmtResultado = FmtResultado{estado = FMT_CANONICO}
    expect(classificar_arquivo(&s) == FMT_ARQ_CANONICO)
    s.estado = FMT_NAO_ANALISADO
    expect(classificar_arquivo(&s) == FMT_ARQ_NAO_ANALISADO)
    s.estado = FMT_MUDARIA
    expect(classificar_arquivo(&s) == FMT_ARQ_MUDARIA)
    var t: FmtTotais = FmtTotais{}
    contar_arquivo(&t, FMT_ARQ_MUDARIA)
    contar_arquivo(&t, FMT_ARQ_NAO_ANALISADO)
    expect((t.arquivos == 2) and (t.mudariam == 1) and (t.nao_analisados == 1) and (t.canonicos == 0))
    var c: FmtResultado = FmtResultado{}
    c.formatado = make([dynamic]u8, alloc = heap)
    c.normalizado = make([dynamic]u8, alloc = heap)
    c.edicoes = make([dynamic]Edicao, alloc = heap)
    append(&c.formatado, items = as_bytes("a\n"))
    append(&c.normalizado, items = as_bytes("a\n"))
    var d = make([dynamic]u8, alloc = heap)
    expect(diff_do_arquivo(&d, "x.fj", &c))
    let t2 = to_str(&d)
    expect(t2 == "# x.fj: so BOM e/ou fim de linha CRLF; o texto ja e canonico\n")
    delete(t2)
    delete(c.formatado)
    delete(c.normalizado)
    delete(c.edicoes)
}

test "arquivo_tem_escrita: arquivo que nao existe nao tem escrita e nada e criado; mostrar_arquivo com --json nao imprime" {
    expect(arquivo_tem_escrita("nao_existe_v5m1_xyz.fj") == false)
    expect(file.exists("nao_existe_v5m1_xyz.fj") == false)
    var p: FmtPedido = FmtPedido{json = true}
    var x: FmtExecucao = FmtExecucao{}
    x.pedido = &p
    var r: FmtResultado = FmtResultado{}
    expect(mostrar_arquivo(&x, "x.fj", FMT_ARQ_GRAVADO, &r))
}
