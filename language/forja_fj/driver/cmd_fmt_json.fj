import "common"
import "nativo"

// C: driver/cmd_fmt_json.c:13
proc estado_texto(estado: i32) -> str {
    let sw_1 = common.c2f_s2u_32(estado)
    if sw_1 == (FMT_ARQ_CANONICO as u32) {
        return "canonico"
    } else if sw_1 == (FMT_ARQ_MUDARIA as u32) {
        return "mudaria"
    } else if sw_1 == (FMT_ARQ_GRAVADO as u32) {
        return "gravado"
    } else if sw_1 == (FMT_ARQ_NAO_ANALISADO as u32) {
        return "nao_analisado"
    }
    return "nao_analisado"
}

// C: driver/cmd_fmt_json.c:25
proc emitir_edicao(b: ^[dynamic]u8, e: ^Edicao, regra: str) {
    format(f"{{\"linha\": {e.linha}, \"coluna\": {e.coluna}, ", into = b)
    if e.linha_fim > e.linha {
        format(f"\"linha_fim\": {e.linha_fim}, ", into = b)
    }
    format(f"\"coluna_fim\": {e.coluna_fim}, \"antigo\": ", into = b)
    let arg_1: u64 = len((e.antigo or_else "")) as u64
    let arg_2: ?str = e.antigo
    let arg_3: ^[dynamic]u8 = b
    edicoes_json_texto(arg_3, arg_2, arg_1)
    append(b, item = ", \"novo\": ")
    let arg_4: u64 = len((e.novo or_else "")) as u64
    let arg_5: ?str = e.novo
    let arg_6: ^[dynamic]u8 = b
    edicoes_json_texto(arg_6, arg_5, arg_4)
    format(f", \"regra\": \"{regra}\"}}", into = b)
}

// C: driver/cmd_fmt_json.c:36
proc emitir_edicoes(b: ^[dynamic]u8, r: ^FmtResultado) {
    append(b, item = "[")
    for k in 0..<len(r.edicoes) {
        if k > 0 {
            append(b, item = ", ")
        }
        emitir_edicao(b, &r.edicoes[k], r.regras[k])
    }
    append(b, item = "]")
}

// C: driver/cmd_fmt_json.c:50
// O primeiro desvio do arquivo, ou null quando ele ja e canonico.
proc emitir_primeiro(b: ^[dynamic]u8, r: ^FmtResultado) {
    if r.desvios == 0 {
        append(b, item = "null")
        return
    }
    let regra: str = r.primeiro.regra or_else "-"
    format(f"{{\"linha\": {r.primeiro.linha}, \"coluna\": {r.primeiro.coluna}, \"regra\": \"{regra}\"}}", into = b)
}

// C: driver/cmd_fmt_json.c:59
proc fmt_json_arquivo(json_c: ^[dynamic]u8, caminho: str, estado: i32, r: ^FmtResultado) {
    if (len(json_c^) as u64) > 0 {
        append(json_c, item = ",\n")
    }
    append(json_c, item = "  {\"arquivo\": ")
    nativo.json_caminho(json_c, caminho)
    format(f", \"estado\": \"{estado_texto(estado)}\", \"desvios\": {r.desvios}, \"primeiro\": ", into = json_c)
    emitir_primeiro(json_c, r)
    append(json_c, item = ", \"edicoes\": ")
    emitir_edicoes(json_c, r)
    append(json_c, item = ", \"diagnostico\": ")
    edicoes_json_texto_ou_nulo(json_c, r.codigo)
    append(json_c, item = ", \"motivo\": ")
    edicoes_json_texto_ou_nulo(json_c, r.motivo)
    if common.c2f_s2u_32(estado) == (FMT_ARQ_NAO_ANALISADO as u32) {
        format(f", \"diag_linha\": {r.diag_linha}, \"diag_coluna\": {r.diag_coluna}", into = json_c)
    }
    append(json_c, item = "}")
}

// C: driver/cmd_fmt_json.c:76
proc fmt_json_documento(doc: ^[dynamic]u8, x: ^FmtExecucao) {
    append(doc, item = "{\"arquivos\": [\n")
    if len(x.json) > 0 {
        append(doc, items = x.json[..])
    }
    let t: FmtTotais = x.totais
    format(f"\n], \"totais\": {{\"arquivos\": {t.arquivos}, \"canonicos\": {t.canonicos}, \"mudariam\": {t.mudariam}, \"gravados\": {t.gravados}, \"nao_analisados\": {t.nao_analisados}}}}}\n", into = doc)
}

test "emitir_primeiro: canonico vira null; desvio sai com a regra ou '-'" {
    var r: FmtResultado = FmtResultado{}
    var b = make([dynamic]u8, alloc = heap)
    emitir_primeiro(&b, &r)
    let t1 = to_str(&b)
    expect(t1 == "null")
    delete(t1)
    r.desvios = 1
    r.primeiro = FmtDesvio{linha = 3, coluna = 5, regra = "R0007"}
    var c = make([dynamic]u8, alloc = heap)
    emitir_primeiro(&c, &r)
    let t2 = to_str(&c)
    expect(t2 == "{\"linha\": 3, \"coluna\": 5, \"regra\": \"R0007\"}")
    delete(t2)
    r.primeiro = FmtDesvio{linha = 1, coluna = 1}
    var d = make([dynamic]u8, alloc = heap)
    emitir_primeiro(&d, &r)
    let t3 = to_str(&d)
    expect(t3 == "{\"linha\": 1, \"coluna\": 1, \"regra\": \"-\"}")
    delete(t3)
}

test "emitir_edicoes: lista vazia e duas edicoes (com linha_fim so quando a faixa tem varias linhas)" {
    var r: FmtResultado = FmtResultado{}
    r.edicoes = make([dynamic]Edicao, alloc = heap)
    r.regras = make([dynamic]str, alloc = heap)
    var b = make([dynamic]u8, alloc = heap)
    emitir_edicoes(&b, &r)
    let t1 = to_str(&b)
    expect(t1 == "[]")
    delete(t1)
    append(&r.edicoes, item = Edicao{linha = 1, coluna = 2, coluna_fim = 4, antigo = "abc", novo = "XY"})
    append(&r.edicoes, item = Edicao{linha = 3, coluna = 1, coluna_fim = 2, linha_fim = 4, antigo = "", novo = "z"})
    append(&r.regras, item = "R0001")
    append(&r.regras, item = "R0002")
    var c = make([dynamic]u8, alloc = heap)
    emitir_edicoes(&c, &r)
    let t2 = to_str(&c)
    expect(t2 == "[{\"linha\": 1, \"coluna\": 2, \"coluna_fim\": 4, \"antigo\": \"abc\", \"novo\": \"XY\", \"regra\": \"R0001\"}, {\"linha\": 3, \"coluna\": 1, \"linha_fim\": 4, \"coluna_fim\": 2, \"antigo\": \"\", \"novo\": \"z\", \"regra\": \"R0002\"}]")
    delete(t2)
    delete(r.edicoes)
    delete(r.regras)
}

test "fmt_json_documento: documento vazio e com um arquivo, com os totais" {
    var x: FmtExecucao = FmtExecucao{}
    var doc = make([dynamic]u8, alloc = heap)
    fmt_json_documento(&doc, &x)
    let t1 = to_str(&doc)
    expect(t1 == "{\"arquivos\": [\n\n], \"totais\": {\"arquivos\": 0, \"canonicos\": 0, \"mudariam\": 0, \"gravados\": 0, \"nao_analisados\": 0}}\n")
    delete(t1)
    x.json = make([dynamic]u8, alloc = heap)
    append(&x.json, item = "  {\"arquivo\": \"a.fj\"}")
    x.totais = FmtTotais{arquivos = 1, canonicos = 1}
    var doc2 = make([dynamic]u8, alloc = heap)
    fmt_json_documento(&doc2, &x)
    let t2 = to_str(&doc2)
    expect(t2 == "{\"arquivos\": [\n  {\"arquivo\": \"a.fj\"}\n], \"totais\": {\"arquivos\": 1, \"canonicos\": 1, \"mudariam\": 0, \"gravados\": 0, \"nao_analisados\": 0}}\n")
    delete(t2)
    delete(x.json)
}

test "fmt_json_arquivo: objeto de um arquivo canonico, com a virgula so a partir do 2o" {
    var json = make([dynamic]u8, alloc = heap)
    var r: FmtResultado = FmtResultado{}
    r.edicoes = make([dynamic]Edicao, alloc = heap)
    r.regras = make([dynamic]str, alloc = heap)
    fmt_json_arquivo(&json, "a.fj", FMT_ARQ_CANONICO, &r)
    fmt_json_arquivo(&json, "b.fj", FMT_ARQ_NAO_ANALISADO, &r)
    let t = to_str(&json)
    expect(t == "  {\"arquivo\": \"a.fj\", \"estado\": \"canonico\", \"desvios\": 0, \"primeiro\": null, \"edicoes\": [], \"diagnostico\": null, \"motivo\": null},\n  {\"arquivo\": \"b.fj\", \"estado\": \"nao_analisado\", \"desvios\": 0, \"primeiro\": null, \"edicoes\": [], \"diagnostico\": null, \"motivo\": null, \"diag_linha\": 0, \"diag_coluna\": 0}")
    delete(t)
    delete(r.edicoes)
    delete(r.regras)
}
