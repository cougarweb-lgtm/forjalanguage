import "common"
import "ir"
import "nativo/obj"

struct DwarfAbrev {
    codigo: u64
    tag: u64
    filhos: u8
    pares: ?[]u8
    qtd: u64
}

struct DwarfItem {
    tipo: u8
    id: u32 // TipoId
}

struct DwarfRef {
    pos: u64
    indice: u32
}

struct DwarfTipos {
    ntipos: u32
    off: ?[]u32
    na_fila: ?[]u8
    fila: [dynamic]DwarfItem
    refs: [dynamic]DwarfRef
}

struct DwarfCtx {
    o: ?^obj.Objeto
    d: ?^DbgPrograma
    s: ?^DwarfSemantica
    f: ?^common.Fonte
    lay: ir.Layouts
    arena: common.Arena
    sec_abrev: u32
    sec_info: u32
    sec_linha: u32
    sec_frame: u32
    arquivos: [dynamic]str
    simb_proc: [dynamic]u32
    dica: u32
    ult_cru: ?str
    ult_arquivo: u32
    tipos: DwarfTipos
}

const DWARF_ABREV_CU: i32 = 1
const DWARF_ABREV_SUB: i32 = 2
const DWARF_ABREV_PARAM: i32 = 3
const DWARF_ABREV_VAR: i32 = 4
const DWARF_ABREV_BASE: i32 = 5
const DWARF_ABREV_PONTEIRO: i32 = 6
const DWARF_ABREV_PONTEIRO_VOID: i32 = 7
const DWARF_ABREV_ESTRUTURA: i32 = 8
const DWARF_ABREV_MEMBRO: i32 = 9
const DWARF_ABREV_VETOR: i32 = 10
const DWARF_ABREV_INTERVALO: i32 = 11
const DWARF_ABREV_ENUM: i32 = 12
const DWARF_ABREV_ENUMERADOR: i32 = 13
const DWARF_ABREV_QTD: i32 = 14
const DWARF_ITEM_TIPO: i32 = 0
const DWARF_ITEM_PONTEIRO: i32 = 1
const DWARF_ITEM_VOID: i32 = 2
const DWARF_SEM_DIE: u32 = 4294967295
