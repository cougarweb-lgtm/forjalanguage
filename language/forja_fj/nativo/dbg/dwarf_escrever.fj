import "common"
import "ir"
import "semantic"
import "nativo/bir"
import "nativo/obj"

const DWARF_VERSAO: i32 = 4
const DWARF_LANG_C99: i32 = 12
const DWARF_TAG_CU: i32 = 17
const DWARF_TAG_SUB: i32 = 46
const DWARF_TAG_PARAM: i32 = 5
const DWARF_TAG_VAR: i32 = 52
const DWARF_TAG_BASE: i32 = 36
const DWARF_TAG_PONTEIRO: i32 = 15
const DWARF_TAG_ESTRUTURA: i32 = 19
const DWARF_TAG_MEMBRO: i32 = 13
const DWARF_TAG_VETOR: i32 = 1
const DWARF_TAG_INTERVALO: i32 = 33
const DWARF_TAG_ENUM: i32 = 4
const DWARF_TAG_ENUMERADOR: i32 = 40
const DWARF_CHILDREN_NAO: i32 = 0
const DWARF_CHILDREN_SIM: i32 = 1
const DWARF_TAM_ENDERECO: i32 = 8
const DW_OP_REG6: i32 = 86
const DW_OP_BREG6: i32 = 118
const DW_OP_DEREF: i32 = 6
// C2F-82 macro de funcao PARES ( v ) ( v ) , sizeof ( v )
const PARES_CU: [12]u8 = {37, 8, 19, 11, 3, 8, 16, 23, 17, 1, 18, 7}
const PARES_SUB: [16]u8 = {3, 8, 110, 8, 58, 11, 59, 5, 17, 1, 18, 7, 64, 24, 63, 25}
const PARES_VARIAVEL: [6]u8 = {3, 8, 73, 19, 2, 24}
const PARES_BASE: [6]u8 = {3, 8, 11, 15, 62, 11}
const PARES_PONTEIRO: [4]u8 = {11, 15, 73, 19}
const PARES_PONTEIRO_VOID: [2]u8 = {11, 15}
const PARES_ESTRUTURA: [4]u8 = {3, 8, 11, 15}
const PARES_MEMBRO: [6]u8 = {3, 8, 73, 19, 56, 15}
const PARES_VETOR: [2]u8 = {73, 19}
const PARES_INTERVALO: [2]u8 = {55, 15}
const PARES_ENUM: [4]u8 = {3, 8, 11, 15}
const PARES_ENUMERADOR: [4]u8 = {3, 8, 28, 13}
// C2F:? tabela ABREVIACOES (const DwarfAbrev[13]): ponteiro nao nulo

// C: nativo/dbg/dwarf_escrever.c:71
proc dwarf_bytes_u8(b: ^[dynamic]u8, v: u8) {
    append(b, item = v)
}

// C: nativo/dbg/dwarf_escrever.c:76
proc dwarf_bytes_u16(b: ^[dynamic]u8, v: u16) {
    var c: [2]u8 = {common.c2f_trunc_u8(v as u64), common.c2f_trunc_u8((v >> 8) as u64)}
    append(b, items = c[..])
}

// C: nativo/dbg/dwarf_escrever.c:83
proc dwarf_bytes_u32(b: ^[dynamic]u8, v: u32) {
    var c: [4]u8 = {common.c2f_trunc_u8(v as u64), common.c2f_trunc_u8((v >> 8) as u64), common.c2f_trunc_u8((v >> 16) as u64), common.c2f_trunc_u8((v >> 24) as u64)}
    append(b, items = c[..])
}

// C: nativo/dbg/dwarf_escrever.c:90
proc dwarf_bytes_u64(b: ^[dynamic]u8, v: u64) {
    dwarf_bytes_u32(b, common.c2f_trunc_u32(v & 4294967295))
    dwarf_bytes_u32(b, common.c2f_trunc_u32(v >> 32))
}

// C: nativo/dbg/dwarf_escrever.c:96
proc dwarf_bytes_uleb(b: ^[dynamic]u8, v: u64) {
    var v_v: u64 = v
    while true {
        let byte: u8 = common.c2f_trunc_u8(v_v & 127)
        v_v = v_v >> 7
        var tern_1: i32 = byte as i32
        if v_v != 0 {
            tern_1 = common.c2f_trunc_u8(common.c2f_s2u_64(common.c2f_ou_i32(byte as i32, 128) as i64)) as i32
        }
        dwarf_bytes_u8(b, tern_1 as u8)
        if not (v_v != 0) {
            break
        }
    }
}

// C: nativo/dbg/dwarf_escrever.c:105
proc dwarf_bytes_sleb(b: ^[dynamic]u8, v: i64) {
    var v_v: i64 = v
    var mais: i32 = 1
    while mais != 0 {
        var byte: u8 = common.c2f_trunc_u8(common.c2f_s2u_64(common.c2f_e_i64(v_v, 127)))
        v_v = common.c2f_sar_i64(v_v, 7)
        if ((v_v == 0) and (common.c2f_e_i32(byte as i32, 64) == 0)) or ((v_v == -1) and (common.c2f_e_i32(byte as i32, 64) != 0)) {
            mais = 0
        } else {
            byte = byte | 128
        }
        dwarf_bytes_u8(b, byte)
    }
}

// C: nativo/dbg/dwarf_escrever.c:120
// Texto terminado em NUL (strlen + 1), como o C grava.
proc dwarf_bytes_texto(b: ^[dynamic]u8, s: ?str) {
    let texto: str = s or_else ""
    append(b, items = as_bytes(texto))
    append(b, item = 0 as u8)
}

// C: nativo/dbg/dwarf_escrever.c:125
proc dwarf_patch_u32(b: ^[dynamic]u8, pos: u64, v: u32) {
    let d: []u8 = b^[..]
    for k in (0 as u32)..<4 {
        d[pos + (k as u64)] = common.c2f_trunc_u8(((v >> (8 * k)) & 0xFF) as u64)
    }
}

// C: nativo/dbg/dwarf_escrever.c:133
proc dwarf_buf_secao(x: ^DwarfCtx, idx: u32) -> ^[dynamic]u8 {
    return &(x.o as ^obj.Objeto).secoes[idx as u64].bytes
}

// C: nativo/dbg/dwarf_escrever.c:139
// Caminho com barra normal (o gdb do Linux so casa '/'); a copia vive na arena, como a do C.
proc dwarf_caminho_normal(x: ^DwarfCtx, caminho: ?str) -> str {
    let cru: []u8 = as_bytes(caminho or_else "")
    let copia: []u8 = common.arena_fatia_u8(&x.arena, len(cru))
    for k in (0 as u64)..<(len(cru) as u64) {
        var byte: u8 = cru[k]
        if byte == 92 {
            byte = 47
        }
        copia[k] = byte
    }
    return from_bytes(copia[..], alloc = common.arena_mem(&x.arena))
}

// C: nativo/dbg/dwarf_escrever.c:153
// Compara o caminho normal com o cru tratando '\' como '/'; mesmo tamanho e mesmos bytes (o C para no NUL de ambos).
proc dwarf_caminho_igual(normal: str, cru: ?str) -> bool {
    let nb: []u8 = as_bytes(normal)
    let cb: []u8 = as_bytes(cru or_else "")
    if len(nb) != len(cb) {
        return false
    }
    for k in (0 as u64)..<(len(nb) as u64) {
        var c: u8 = cb[k]
        if c == 92 {
            c = 47
        }
        if nb[k] != c {
            return false
        }
    }
    return true
}

// C: nativo/dbg/dwarf_escrever.c:164
// Arquivo (1-based no DWARF) e linha de uma posicao; registra o arquivo na tabela da 1a vez. O cache do ultimo caminho e por conteudo.
proc dwarf_arquivo_de(x: ^DwarfCtx, pos: u32, linha: ^u32) -> u32 {
    var fp = common.FontePosicao{caminho = (x.f as ^common.Fonte).caminho, linha = 0, coluna = 0}
    if pos != bir.BIR_SEM_POS {
        fp = dbg_posicao_com_dica(x.f, pos, &x.dica)
    }
    let caminho: str = fp.caminho or_else ""
    linha^ = fp.linha
    if x.ult_cru != none {
        if (x.ult_cru or_else "") == caminho {
            return x.ult_arquivo
        }
    }
    x.ult_cru = caminho
    var i: u64 = 0
    while i < (len(x.arquivos) as u64) {
        if dwarf_caminho_igual(x.arquivos[i], caminho) {
            x.ult_arquivo = (i as u32) + 1
            return x.ult_arquivo
        }
        i += 1
    }
    append(&x.arquivos, item = dwarf_caminho_normal(x, caminho))
    x.ult_arquivo = len(x.arquivos) as u32
    return x.ult_arquivo
}

// C: nativo/dbg/dwarf_escrever.c:187
proc dwarf_relocar(x: ^DwarfCtx, secao: u32, off: u64, simbolo: str) {
    let idx: i64 = obj.obj_achar_simbolo(x.o as ^obj.Objeto, simbolo)
    if idx < 0 {
        let msg_1 = format(f"dwarf: simbolo '{simbolo}' ausente no objeto do programa", alloc = heap)
        defer delete(msg_1)
        common.falha_interna(msg_1)
    }
    obj.obj_relocar(x.o as ^obj.Objeto, obj.ObjAlvoReloc{secao = secao, off = off as u32}, obj.ObjCorrecao{tipo = obj.OR_ADDR64, simbolo = idx as u32, adendo = 0})
}

// C: nativo/dbg/dwarf_escrever.c:196
proc dwarf_relocar_proc(x: ^DwarfCtx, secao: u32, off: u64, proc_c: u64) {
    let memo: ^u32 = &x.simb_proc[proc_c]
    if memo^ == 0 {
        let simbolo: ?str = (x.d as ^DbgPrograma).procs[proc_c].simbolo
        let idx: i64 = obj.obj_achar_simbolo(x.o as ^obj.Objeto, simbolo)
        if idx < 0 {
            let txt_1 = simbolo or_else "(null)"
            let msg_1 = format(f"dwarf: simbolo '{txt_1}' ausente no objeto do programa", alloc = heap)
            defer delete(msg_1)
            common.falha_interna(msg_1)
        }
        memo^ = (idx as u32) + 1
    }
    obj.obj_relocar(x.o as ^obj.Objeto, obj.ObjAlvoReloc{secao = secao, off = off as u32}, obj.ObjCorrecao{tipo = obj.OR_ADDR64, simbolo = memo^ - 1, adendo = 0})
}

// C: nativo/dbg/dwarf_escrever.c:211
proc dwarf_abreviacao(b: ^[dynamic]u8, a: ^DwarfAbrev) {
    dwarf_bytes_uleb(b, a.codigo)
    dwarf_bytes_uleb(b, a.tag)
    dwarf_bytes_u8(b, a.filhos)
    var i: u64 = 0
    while i < a.qtd {
        dwarf_bytes_uleb(b, (a.pares or_else {})[i] as u64)
        dwarf_bytes_uleb(b, (a.pares or_else {})[i + 1] as u64)
        i += 2
    }
    dwarf_bytes_u8(b, 0)
    dwarf_bytes_u8(b, 0)
}

// C: nativo/dbg/dwarf_escrever.c:224
// Tabela ABREVIACOES do C (13 entradas, na ordem dos codigos DWARF_ABREV_*), fim com um 0.
proc dwarf_escrever_abreviacoes(b: ^[dynamic]u8) {
    var p_cu: [12]u8 = PARES_CU
    var p_sub: [16]u8 = PARES_SUB
    var p_var: [6]u8 = PARES_VARIAVEL
    var p_base: [6]u8 = PARES_BASE
    var p_ponteiro: [4]u8 = PARES_PONTEIRO
    var p_ponteiro_void: [2]u8 = PARES_PONTEIRO_VOID
    var p_estrutura: [4]u8 = PARES_ESTRUTURA
    var p_membro: [6]u8 = PARES_MEMBRO
    var p_vetor: [2]u8 = PARES_VETOR
    var p_intervalo: [2]u8 = PARES_INTERVALO
    var p_enum: [4]u8 = PARES_ENUM
    var p_enumerador: [4]u8 = PARES_ENUMERADOR
    var a_cu = DwarfAbrev{codigo = DWARF_ABREV_CU as u64, tag = DWARF_TAG_CU as u64, filhos = DWARF_CHILDREN_SIM as u8, pares = p_cu[..], qtd = 12}
    var a_sub = DwarfAbrev{codigo = DWARF_ABREV_SUB as u64, tag = DWARF_TAG_SUB as u64, filhos = DWARF_CHILDREN_SIM as u8, pares = p_sub[..], qtd = 16}
    var a_param = DwarfAbrev{codigo = DWARF_ABREV_PARAM as u64, tag = DWARF_TAG_PARAM as u64, filhos = DWARF_CHILDREN_NAO as u8, pares = p_var[..], qtd = 6}
    var a_var = DwarfAbrev{codigo = DWARF_ABREV_VAR as u64, tag = DWARF_TAG_VAR as u64, filhos = DWARF_CHILDREN_NAO as u8, pares = p_var[..], qtd = 6}
    var a_base = DwarfAbrev{codigo = DWARF_ABREV_BASE as u64, tag = DWARF_TAG_BASE as u64, filhos = DWARF_CHILDREN_NAO as u8, pares = p_base[..], qtd = 6}
    var a_ponteiro = DwarfAbrev{codigo = DWARF_ABREV_PONTEIRO as u64, tag = DWARF_TAG_PONTEIRO as u64, filhos = DWARF_CHILDREN_NAO as u8, pares = p_ponteiro[..], qtd = 4}
    var a_ponteiro_void = DwarfAbrev{codigo = DWARF_ABREV_PONTEIRO_VOID as u64, tag = DWARF_TAG_PONTEIRO as u64, filhos = DWARF_CHILDREN_NAO as u8, pares = p_ponteiro_void[..], qtd = 2}
    var a_estrutura = DwarfAbrev{codigo = DWARF_ABREV_ESTRUTURA as u64, tag = DWARF_TAG_ESTRUTURA as u64, filhos = DWARF_CHILDREN_SIM as u8, pares = p_estrutura[..], qtd = 4}
    var a_membro = DwarfAbrev{codigo = DWARF_ABREV_MEMBRO as u64, tag = DWARF_TAG_MEMBRO as u64, filhos = DWARF_CHILDREN_NAO as u8, pares = p_membro[..], qtd = 6}
    var a_vetor = DwarfAbrev{codigo = DWARF_ABREV_VETOR as u64, tag = DWARF_TAG_VETOR as u64, filhos = DWARF_CHILDREN_SIM as u8, pares = p_vetor[..], qtd = 2}
    var a_intervalo = DwarfAbrev{codigo = DWARF_ABREV_INTERVALO as u64, tag = DWARF_TAG_INTERVALO as u64, filhos = DWARF_CHILDREN_NAO as u8, pares = p_intervalo[..], qtd = 2}
    var a_enum = DwarfAbrev{codigo = DWARF_ABREV_ENUM as u64, tag = DWARF_TAG_ENUM as u64, filhos = DWARF_CHILDREN_SIM as u8, pares = p_enum[..], qtd = 4}
    var a_enumerador = DwarfAbrev{codigo = DWARF_ABREV_ENUMERADOR as u64, tag = DWARF_TAG_ENUMERADOR as u64, filhos = DWARF_CHILDREN_NAO as u8, pares = p_enumerador[..], qtd = 4}
    dwarf_abreviacao(b, &a_cu)
    dwarf_abreviacao(b, &a_sub)
    dwarf_abreviacao(b, &a_param)
    dwarf_abreviacao(b, &a_var)
    dwarf_abreviacao(b, &a_base)
    dwarf_abreviacao(b, &a_ponteiro)
    dwarf_abreviacao(b, &a_ponteiro_void)
    dwarf_abreviacao(b, &a_estrutura)
    dwarf_abreviacao(b, &a_membro)
    dwarf_abreviacao(b, &a_vetor)
    dwarf_abreviacao(b, &a_intervalo)
    dwarf_abreviacao(b, &a_enum)
    dwarf_abreviacao(b, &a_enumerador)
    dwarf_bytes_u8(b, 0)
}

// C: nativo/dbg/dwarf_escrever.c:232
proc dwarf_faixa(d: ^DbgPrograma, menor: ^?^DbgProc, fim: ^u32) {
    menor^ = &d.procs[0]
    fim^ = 0
    var i: u64 = 0
    while i < (len(d.procs) as u64) {
        let p: ^DbgProc = &d.procs[i]
        if p.inicio < (menor^ as ^DbgProc).inicio {
            menor^ = p
        }
        if p.fim > fim^ {
            fim^ = p.fim
        }
        i += 1
    }
}

// C: nativo/dbg/dwarf_escrever.c:247
// Localizacao: rbp + rbp_off (DW_OP_breg6); no indireto acrescenta DW_OP_deref. O tamanho da expressao e preenchido ao fim.
proc dwarf_escrever_localizacao(b: ^[dynamic]u8, v: ^DbgVar) {
    let campo: u64 = len(b^) as u64
    dwarf_bytes_u8(b, 0)
    dwarf_bytes_u8(b, DW_OP_BREG6 as u8)
    dwarf_bytes_sleb(b, v.loc.rbp_off as i64)
    if v.loc.indireto {
        dwarf_bytes_u8(b, DW_OP_DEREF as u8)
    }
    let d: []u8 = b^[..]
    d[campo] = common.c2f_trunc_u8((len(b^) as u64) - campo - 1)
}

// C: nativo/dbg/dwarf_escrever.c:259
proc dwarf_escrever_variavel(x: ^DwarfCtx, b: ^[dynamic]u8, v: ^DbgVar) {
    var tern_1: i32 = DWARF_ABREV_VAR
    if common.c2f_b2i32(v.parametro) != 0 {
        tern_1 = DWARF_ABREV_PARAM
    }
    dwarf_bytes_uleb(b, common.c2f_s2u_64(tern_1 as i64))
    dwarf_bytes_texto(b, v.nome)
    dwarf_ref_tipo(x, b, v.tipo)
    dwarf_escrever_localizacao(b, v)
}

// C: nativo/dbg/dwarf_escrever.c:267
proc dwarf_escrever_variaveis(x: ^DwarfCtx, b: ^[dynamic]u8, p: ^DbgProc) {
    for k in (0 as u32)..<p.nvars {
        dwarf_escrever_variavel(x, b, &(x.d as ^DbgPrograma).vars[(p.var_ini + k) as u64])
    }
}

// C: nativo/dbg/dwarf_escrever.c:273
proc dwarf_escrever_subprograma(x: ^DwarfCtx, b: ^[dynamic]u8, indice: u64) {
    let p: ^DbgProc = &(x.d as ^DbgPrograma).procs[indice]
    var linha: u32 = 0
    let arquivo: u32 = dwarf_arquivo_de(x, p.pos, &linha)
    dwarf_bytes_uleb(b, DWARF_ABREV_SUB as u64)
    dwarf_bytes_texto(b, p.nome)
    dwarf_bytes_texto(b, p.simbolo)
    dwarf_bytes_u8(b, common.c2f_trunc_u8(arquivo as u64))
    dwarf_bytes_u16(b, common.c2f_trunc_u16(linha as u64))
    dwarf_relocar_proc(x, x.sec_info, len(b^) as u64, indice)
    dwarf_bytes_u64(b, 0)
    dwarf_bytes_u64(b, (p.fim - p.inicio) as u64)
    dwarf_bytes_uleb(b, 1)
    dwarf_bytes_u8(b, DW_OP_REG6 as u8)
    dwarf_escrever_variaveis(x, b, p)
    dwarf_bytes_u8(b, 0)
}

// C: nativo/dbg/dwarf_escrever.c:293
// Unidade de compilacao (.debug_info): cabecalho, a CU com o low/high pc, os subprogramas, os tipos e o fim dos filhos.
proc dwarf_escrever_info(x: ^DwarfCtx) {
    let b: ^[dynamic]u8 = dwarf_buf_secao(x, x.sec_info)
    let programa: ^DbgPrograma = x.d as ^DbgPrograma
    var menor: ?^DbgProc = none
    var fim: u32 = 0
    dwarf_faixa(programa, &menor, &fim)
    let menor_p: ^DbgProc = menor as ^DbgProc
    let tam_pos: u64 = len(b^) as u64
    let caminho_cu: str = (x.f as ^common.Fonte).caminho or_else "programa"
    dwarf_bytes_u32(b, 0)
    dwarf_bytes_u16(b, DWARF_VERSAO as u16)
    dwarf_bytes_u32(b, 0)
    dwarf_bytes_u8(b, DWARF_TAM_ENDERECO as u8)
    dwarf_bytes_uleb(b, DWARF_ABREV_CU as u64)
    dwarf_bytes_texto(b, "Forja")
    dwarf_bytes_u8(b, DWARF_LANG_C99 as u8)
    dwarf_bytes_texto(b, caminho_cu)
    dwarf_bytes_u32(b, 0)
    dwarf_relocar(x, x.sec_info, len(b^) as u64, menor_p.simbolo or_else "")
    dwarf_bytes_u64(b, 0)
    dwarf_bytes_u64(b, wrapping_sub(fim, menor_p.inicio) as u64)
    var i: u64 = 0
    while i < (len(programa.procs) as u64) {
        dwarf_escrever_subprograma(x, b, i)
        i += 1
    }
    dwarf_escrever_tipos(x)
    dwarf_bytes_u8(b, 0)
    dwarf_patch_refs(x)
    dwarf_patch_u32(b, tam_pos, ((len(b^) as u64) - tam_pos - 4) as u32)
}

// C: nativo/dbg/dwarf_escrever.c:321
// Ponto de entrada: abre as secoes do DWARF no objeto, monta o contexto e escreve abbrev, info, linha e (ELF) frame.
pub proc dwarf_escrever(o: ^obj.Objeto, d: ^DbgPrograma, s: ^DwarfSemantica) {
    if len(d.procs) == 0 {
        return
    }
    var x = DwarfCtx{o = o, d = d, s = s, f = s.fonte}
    x.sec_abrev = obj.obj_secao_abrir(o, ".debug_abbrev", obj.OS_DEBUG_ABBREV, 1)
    x.sec_info = obj.obj_secao_abrir(o, ".debug_info", obj.OS_DEBUG_INFO, 1)
    x.sec_linha = obj.obj_secao_abrir(o, ".debug_line", obj.OS_DEBUG_LINE, 1)
    if s.com_frame {
        x.sec_frame = obj.obj_secao_abrir(o, ".debug_frame", obj.OS_DEBUG_FRAME, 1)
    }
    x.arquivos = make([dynamic]str, alloc = heap)
    x.simb_proc = make([dynamic]u32, alloc = heap)
    var i: u64 = 0
    while i < (len(d.procs) as u64) {
        append(&x.simb_proc, item = 0 as u32)
        i += 1
    }
    ir.layout_calcular(s.tipos as ^semantic.Tipos, s.ir as ^ir.IrPrograma, &x.arena, &x.lay)
    dwarf_tipos_iniciar(&x)
    dwarf_escrever_abreviacoes(dwarf_buf_secao(&x, x.sec_abrev))
    dwarf_escrever_info(&x)
    dwarf_escrever_linhas(&x)
    if s.com_frame {
        dwarf_escrever_frames(&x)
    }
    delete(x.tipos.fila)
    delete(x.tipos.refs)
    delete(x.arquivos)
    delete(x.simb_proc)
    common.arena_liberar(&x.arena)
}

test "dwarf_leb128_exemplos_da_especificacao" {
    var b = make([dynamic]u8, alloc = heap)
    defer delete(b)
    dwarf_bytes_uleb(&b, 624485)
    expect(len(b) == 3)
    expect(b[0] == 229)
    expect(b[1] == 142)
    expect(b[2] == 38)
    var c = make([dynamic]u8, alloc = heap)
    defer delete(c)
    dwarf_bytes_sleb(&c, -123456)
    expect(len(c) == 3)
    expect(c[0] == 192)
    expect(c[1] == 187)
    expect(c[2] == 120)
}

test "dwarf_caminho_igual_trata_barra_invertida" {
    expect(dwarf_caminho_igual("C:/a/b.fj", "C:\\a\\b.fj"))
    expect(not dwarf_caminho_igual("C:/a/b.fj", "C:/a/c.fj"))
}
