import "common"

const DWARF_CIE_ID: u32 = 4294967295
const DWARF_VERSAO_CFI: i32 = 1
const DWARF_CFA_NOP: i32 = 0
const DWARF_CFA_ADVANCE: i32 = 64
const DWARF_CFA_OFFSET: i32 = 128
const DWARF_CFA_DEF_CFA: i32 = 12
const DWARF_CFA_DEF_CFA_OFFSET: i32 = 14
const DWARF_CFA_DEF_CFA_REG: i32 = 13
const DWARF_REG_RBP: i32 = 6
const DWARF_REG_RSP: i32 = 7
const DWARF_REG_RA: i32 = 16
const DWARF_FATOR_DADOS: i32 = -8
const DWARF_ALINHA_ENTRADA: i32 = 8
const DWARF_TAM_PUSH_RBP: i32 = 1
const DWARF_TAM_MOV_RBP_RSP: i32 = 3
const DWARF_TAM_CFA_INICIAL: i32 = 8

// C: nativo/dbg/dwarf_frame.c:27
proc dwarf_alinhar_entrada(b: ^[dynamic]u8, inicio: u64) {
    while (((len(b^) as u64) - inicio) % (DWARF_ALINHA_ENTRADA as u64)) != 0 {
        dwarf_bytes_u8(b, DWARF_CFA_NOP as u8)
    }
}

// C: nativo/dbg/dwarf_frame.c:33
proc dwarf_escrever_cie(x: ^DwarfCtx) {
    let b: ^[dynamic]u8 = dwarf_buf_secao(x, x.sec_frame)
    let inicio: u64 = len(b^) as u64
    dwarf_bytes_u32(b, 0)
    dwarf_bytes_u32(b, DWARF_CIE_ID)
    dwarf_bytes_u8(b, DWARF_VERSAO_CFI as u8)
    dwarf_bytes_u8(b, 0)
    dwarf_bytes_uleb(b, 1)
    dwarf_bytes_sleb(b, DWARF_FATOR_DADOS as i64)
    dwarf_bytes_u8(b, DWARF_REG_RA as u8)
    dwarf_bytes_u8(b, DWARF_CFA_DEF_CFA as u8)
    dwarf_bytes_uleb(b, DWARF_REG_RSP as u64)
    dwarf_bytes_uleb(b, DWARF_TAM_CFA_INICIAL as u64)
    dwarf_bytes_u8(b, common.c2f_trunc_u8(common.c2f_s2u_64(common.c2f_ou_i32(DWARF_CFA_OFFSET, DWARF_REG_RA) as i64)))
    dwarf_bytes_uleb(b, 1)
    dwarf_alinhar_entrada(b, inicio)
    dwarf_patch_u32(b, inicio, (((len(b^) as u64) - inicio) - 4) as u32)
}

// C: nativo/dbg/dwarf_frame.c:54
proc dwarf_escrever_fde(x: ^DwarfCtx, p: ^DbgProc) {
    let b: ^[dynamic]u8 = dwarf_buf_secao(x, x.sec_frame)
    let inicio: u64 = len(b^) as u64
    dwarf_bytes_u32(b, 0)
    dwarf_bytes_u32(b, 0)
    dwarf_relocar(x, x.sec_frame, len(b^) as u64, (p.simbolo or_else ""))
    dwarf_bytes_u64(b, 0)
    dwarf_bytes_u64(b, (p.fim - p.inicio) as u64)
    dwarf_bytes_u8(b, common.c2f_trunc_u8(common.c2f_s2u_64(common.c2f_ou_i32(DWARF_CFA_ADVANCE, DWARF_TAM_PUSH_RBP) as i64)))
    dwarf_bytes_u8(b, DWARF_CFA_DEF_CFA_OFFSET as u8)
    dwarf_bytes_uleb(b, common.c2f_s2u_64((2 * DWARF_TAM_CFA_INICIAL) as i64))
    dwarf_bytes_u8(b, common.c2f_trunc_u8(common.c2f_s2u_64(common.c2f_ou_i32(DWARF_CFA_OFFSET, DWARF_REG_RBP) as i64)))
    dwarf_bytes_uleb(b, 2)
    dwarf_bytes_u8(b, common.c2f_trunc_u8(common.c2f_s2u_64(common.c2f_ou_i32(DWARF_CFA_ADVANCE, DWARF_TAM_MOV_RBP_RSP) as i64)))
    dwarf_bytes_u8(b, DWARF_CFA_DEF_CFA_REG as u8)
    dwarf_bytes_uleb(b, DWARF_REG_RBP as u64)
    dwarf_alinhar_entrada(b, inicio)
    dwarf_patch_u32(b, inicio, (((len(b^) as u64) - inicio) - 4) as u32)
}

// C: nativo/dbg/dwarf_frame.c:76
proc dwarf_escrever_frames(x: ^DwarfCtx) {
    dwarf_escrever_cie(x)
    for i in (0 as u64)..<(len((x.d as ^DbgPrograma).procs) as u64) {
        dwarf_escrever_fde(x, &(x.d as ^DbgPrograma).procs[i])
    }
}
