pub struct DbgLoc {
    tipo: u8
    rbp_off: i32
    indireto: bool
}

pub struct DbgVar {
    nome: ?str
    tipo_nome: ?str
    tipo: u32 // TipoId
    local_id: u32
    parametro: bool
    loc: DbgLoc
}

pub struct DbgLinha {
    off: u32
    pos: u32
}

pub struct DbgChamada {
    ra: u32
    pos: u32
}

pub struct DbgProc {
    nome: ?str
    simbolo: ?str
    pos: u32
    inicio: u32
    fim: u32
    linha_ini: u32
    nlinhas: u32
    var_ini: u32
    nvars: u32
    nparams: u32
    rbp_quadro: u32
}

pub struct DbgPrograma {
    procs: [dynamic]DbgProc
    linhas: [dynamic]DbgLinha
    vars: [dynamic]DbgVar
    chamadas: [dynamic]DbgChamada
    main_pos: u32
    ultima_pos: u32
    aberto: bool
}

pub struct DbgAbertura {
    simbolo: ?str
    inicio: u32
    quadro: u32
}

pub const DBG_LOC_RBP: i32 = 0
