import "common"
import "ir"
import "semantic"

struct PdbMsf {
    fluxos: [16][dynamic]u8
    qtd: u32
}

struct PdbTipos {
    tipos: ?^semantic.Tipos
    ir: ?^ir.IrPrograma
    nomes: ?^common.Interner
    reg: [dynamic]u8
    arena: common.Arena
    indice: ?[]u32
    ntipos: u32
    proximo: u32
    lay: ir.Layouts
    lay_pronto: bool
}

pub struct PdbParametros {
    guid: ?[16]u8
    idade: u32
    dbg: ?^DbgPrograma
    tipos: ?^semantic.Tipos
    ir: ?^ir.IrPrograma
    nomes: ?^common.Interner
    tpi: ?^PdbTipos
    fonte: ?^common.Fonte
    exe: ?^[dynamic]u8
    modulo: ?str
    codigo_tam: u32
}

struct PdbArquivo {
    caminho: ?str
    nome_off: u32
}

struct PdbPosLinha {
    arquivo: u32
    linha: u32
}

struct PdbArquivos {
    lista: [dynamic]PdbArquivo
    nomes: [dynamic]u8
    ultimo: u64
    linhas: [dynamic]PdbPosLinha
}

struct PdbSecoes {
    cabecalhos: ?[]u8
    qtd: u32
    texto: u32
}

struct PdbTamanhosModulo {
    simbolos: u32
    c13: u32
    arquivos: ?^PdbArquivos
}

const PDB_TAM_BLOCO: u32 = 4096
const PDB_MAX_FLUXOS: u32 = 16
const PDB_PRIMEIRO_TIPO: u32 = 4096
const PDB_TAM_CABECALHO_SECAO: u32 = 40
