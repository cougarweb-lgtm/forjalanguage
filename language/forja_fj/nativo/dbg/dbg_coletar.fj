import "common"
import "nativo/bir"

const DBG_PREFIXO_FUNCAO: str = "fj_"
const CAMINHO_VAZIO: [1]u8 = {0}

// C: nativo/dbg/dbg_coletar.c:14
// C2F: memset(d, 0) zera os campos do programa; VecIniciar vira make(alloc = heap); main_pos = BIR_SEM_POS
pub proc dbg_iniciar(d: ^DbgPrograma) {
    d.procs = make([dynamic]DbgProc, alloc = heap)
    d.linhas = make([dynamic]DbgLinha, alloc = heap)
    d.vars = make([dynamic]DbgVar, alloc = heap)
    d.chamadas = make([dynamic]DbgChamada, alloc = heap)
    d.main_pos = bir.BIR_SEM_POS
    d.ultima_pos = 0
    d.aberto = false
}

// C: nativo/dbg/dbg_coletar.c:24
pub proc dbg_liberar(d: ^DbgPrograma) {
    delete(d.procs)
    delete(d.linhas)
    delete(d.vars)
    delete(d.chamadas)
}

// C: nativo/dbg/dbg_coletar.c:33
// C2F: strncmp(simbolo, "fj_", 3) vira teste de prefixo por fatia; sem o prefixo vale o simbolo inteiro
proc nome_forja(simbolo: str) -> str {
    var nome: str = simbolo
    if (len(simbolo) >= len(DBG_PREFIXO_FUNCAO)) and (simbolo[0..<len(DBG_PREFIXO_FUNCAO)] == DBG_PREFIXO_FUNCAO) {
        nome = simbolo[len(DBG_PREFIXO_FUNCAO)..<len(simbolo)]
    }
    return common.nome_modulo_exibicao(nome)
}

// C: nativo/dbg/dbg_coletar.c:41
proc proc_em_curso(d: ?^DbgPrograma) -> ^DbgProc {
    return &(d as ^DbgPrograma).procs[(len((d as ^DbgPrograma).procs) as u64) - 1]
}

// C: nativo/dbg/dbg_coletar.c:46
pub proc dbg_proc_abrir(d: ^DbgPrograma, f: ^bir.BirFuncao, a: ^DbgAbertura) {
    let simbolo: ?str = a.simbolo
    var p: ?^DbgProc = none
    d.aberto = not f.sintetica
    if not d.aberto {
        return
    }
    if (simbolo or_else "") == "fj_main" {
        d.main_pos = f.pos
    }
    append(&d.procs, item = DbgProc{})
    p = &d.procs[len(d.procs) - 1]
    let ptr_1: ^DbgProc = p as ^DbgProc
    ptr_1.nome = nome_forja((simbolo or_else ""))
    let ptr_2: ^DbgProc = p as ^DbgProc
    ptr_2.simbolo = simbolo
    let ptr_3: ^DbgProc = p as ^DbgProc
    ptr_3.pos = f.pos
    let ptr_4: ^DbgProc = p as ^DbgProc
    ptr_4.inicio = a.inicio
    let ptr_5: ^DbgProc = p as ^DbgProc
    ptr_5.fim = a.inicio
    let ptr_6: ^DbgProc = p as ^DbgProc
    ptr_6.linha_ini = (len(d.linhas) as u64) as u32
    let ptr_7: ^DbgProc = p as ^DbgProc
    ptr_7.var_ini = (len(d.vars) as u64) as u32
    let ptr_8: ^DbgProc = p as ^DbgProc
    ptr_8.rbp_quadro = a.quadro
    d.ultima_pos = bir.BIR_SEM_POS
}

// C: nativo/dbg/dbg_coletar.c:68
pub proc dbg_variavel(d: ?^DbgPrograma, v: ^DbgVar) {
    var p: ?^DbgProc = none
    if not (d as ^DbgPrograma).aberto {
        return
    }
    let ptr_1: ^DbgPrograma = d as ^DbgPrograma
    append(&ptr_1.vars, item = DbgVar{})
    ptr_1.vars[len(ptr_1.vars) - 1] = v^
    p = proc_em_curso(d)
    let ptr_2: ^DbgProc = p as ^DbgProc
    ptr_2.nvars += 1
    if v.parametro {
        let ptr_3: ^DbgProc = p as ^DbgProc
        ptr_3.nparams += 1
    }
}

// C: nativo/dbg/dbg_coletar.c:81
pub proc dbg_linha_vista(d: ?^DbgPrograma, off: u32, pos: u32) {
    var l: ?^DbgLinha = none
    if ((not (d as ^DbgPrograma).aberto) or (pos == bir.BIR_SEM_POS)) or (pos == (d as ^DbgPrograma).ultima_pos) {
        return
    }
    append(&(d as ^DbgPrograma).linhas, item = DbgLinha{})
    l = &(d as ^DbgPrograma).linhas[len((d as ^DbgPrograma).linhas) - 1]
    let ptr_1: ^DbgLinha = l as ^DbgLinha
    ptr_1.off = off
    let ptr_2: ^DbgLinha = l as ^DbgLinha
    ptr_2.pos = pos
    let ptr_3: ^DbgPrograma = d as ^DbgPrograma
    ptr_3.ultima_pos = pos
    let p_1 = proc_em_curso(d)
    p_1.nlinhas += 1
}

// C: nativo/dbg/dbg_coletar.c:94
pub proc dbg_proc_fechar(d: ?^DbgPrograma, fim: u32) {
    if not (d as ^DbgPrograma).aberto {
        return
    }
    let p_1 = proc_em_curso(d)
    p_1.fim = fim
    let ptr_1: ^DbgPrograma = d as ^DbgPrograma
    ptr_1.aberto = false
}

// C: nativo/dbg/dbg_coletar.c:103
proc linha_da_dica(f: ?^common.Fonte, pos: u32, dica: ^u32) -> bool {
    let base: u32 = dica^
    var k: u32 = base
    while (k <= (base + 1)) and (k < (f as ^common.Fonte).ninicios) {
        let na_linha: bool = (((f as ^common.Fonte).inicio_linha or_else {})[k] <= pos) and (((k + 1) >= (f as ^common.Fonte).ninicios) or (pos < ((f as ^common.Fonte).inicio_linha or_else {})[k + 1]))
        if na_linha {
            dica^ = k
            return true
        }
        k += 1
    }
    return false
}

// C: nativo/dbg/dbg_coletar.c:118
// C2F: caminho NULL vira "" (CAMINHO_VAZIO); *dica = linha - 1 em u32 com volta, como o C
pub proc dbg_posicao_com_dica(f: ?^common.Fonte, pos: u32, dica: ^u32) -> common.FontePosicao {
    let fonte: ^common.Fonte = f as ^common.Fonte
    if (fonte.inicio_linha != none) and (fonte.ntrechos <= 1) and ((pos as u64) < fonte.tam) and linha_da_dica(f, pos, dica) {
        return common.FontePosicao{caminho = fonte.caminho or_else "", linha = dica^ + 1, coluna = 0}
    }
    var fp: common.FontePosicao = common.fonte_localizar_no_arquivo(f, pos)
    if fp.caminho == none {
        fp.caminho = ""
    }
    if fonte.inicio_linha != none {
        dica^ = wrapping_sub(fp.linha, 1)
    }
    return fp
}

// C: nativo/dbg/dbg_coletar.c:137
pub proc dbg_chamada_vista(d: ?^DbgPrograma, ra: u32, pos: u32) {
    append(&(d as ^DbgPrograma).chamadas, item = DbgChamada{})
    let c: ^DbgChamada = &(d as ^DbgPrograma).chamadas[len((d as ^DbgPrograma).chamadas) - 1]
    c.ra = ra
    c.pos = pos
}

test "dbg_nome_forja_tira_prefixo" {
    expect(nome_forja("fj_main") == "main")
    expect(nome_forja("sem_prefixo") == "sem_prefixo")
}

test "dbg_iniciar_zera_programa" {
    var d = DbgPrograma{}
    dbg_iniciar(&d)
    defer dbg_liberar(&d)
    expect(d.main_pos == bir.BIR_SEM_POS)
    expect(not d.aberto)
    expect(len(d.procs) == 0)
}
