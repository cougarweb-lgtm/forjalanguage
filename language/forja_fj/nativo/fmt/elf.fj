// Changelog: 0.2.0 - A4.2: ElfPlano com ate 10 segmentos (PT_INTERP e PT_GNU_RELRO do ELF dinamico), dinamico, sem_entrada e din.

pub struct ElfSegmento {
    tipo: u32
    flags: u32
    offset: u64
    vaddr: u64
    filesz: u64
    memsz: u64
    alinhamento: u64
}

pub struct ElfPlano {
    seg: [10]ElfSegmento
    qtd: u32
    off_secao: [13]u64
    fim_secoes: u64
    pie: bool
    tls: bool
    off_dyn: u64
    va_dyn: u64
    tam_rela: u64
    tam_dyn: u64
    pagina: u64
    maquina: u64
    dinamico: bool // A4.2: ELF dinamico (alvo android): o bloco .dynamic/.rela/.hash/.dynsym/.dynstr[/.interp] vem de `din`
    sem_entrada: bool // A4.2: .so (e_entry = 0)
    din: ElfDinamicoPlano
}

const ELF_SEGMENTOS_EXE: i32 = 4
const ELF_SEGMENTOS_PIE: i32 = 7
const ELF_MAX_SEGMENTOS: i32 = 10
pub const ELF_PT_LOAD: u32 = 1
const ELF_PT_TLS: u32 = 7
const ELF_PT_GNU_STACK: u32 = 1685382481
const ELF_PF_X: u32 = 1
const ELF_PF_W: u32 = 2
const ELF_PF_R: u32 = 4
