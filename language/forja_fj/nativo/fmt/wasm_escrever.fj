    expect(bytes_iguais(saida[..], esperado[..]))
}

test "wasm_global_e_dados" {
    var m = wasm_modulo_iniciar()
    defer wasm_modulo_liberar(&m)
    var saida = make([dynamic]u8, alloc = heap)
    defer delete(saida)
    var sem_valor: [1]u8 = {0x00}
    let t = wasm_tipo(&m, sem_valor[0..<0], sem_valor[0..<0])
    var corpo: [2]u8 = {0x00, 0x0B}
    let f = wasm_funcao(&m, t, "", corpo[..])
    let g = wasm_global_i64(&m, true, 1048576)
    wasm_memoria(&m, 1)
    var bytes_dados: [3]u8 = {0x61, 0x62, 0x63}
    wasm_dados(&m, 4096, bytes_dados[..])
    wasm_serializar(&m, &saida)
    expect(f == 0)
    expect(g == 0)
    var esperado: [55]u8 = {
        0x00, 0x61, 0x73, 0x6D, 0x01, 0x00, 0x00, 0x00,
        0x01, 0x04, 0x01, 0x60, 0x00, 0x00,
        0x03, 0x02, 0x01, 0x00,
        0x05, 0x03, 0x01, 0x00, 0x01,
        0x06, 0x09, 0x01, 0x7E, 0x01, 0x42, 0x80, 0x80, 0xC0, 0x00, 0x0B,
        0x0C, 0x01, 0x01,
        0x0A, 0x04, 0x01, 0x02, 0x00, 0x0B,
        0x0B, 0x0A, 0x01, 0x00, 0x41, 0x80, 0x20, 0x0B, 0x03, 0x61, 0x62, 0x63
    }
    expect(bytes_iguais(saida[..], esperado[..]))
}
