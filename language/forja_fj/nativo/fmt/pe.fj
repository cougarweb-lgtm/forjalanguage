pub const IMAGEM_ELF: i32 = 1
pub const IMAGEM_WASM: i32 = 2
pub const IMAGEM_MACHO: i32 = 3 // I1: Mach-O dos alvos iOS (o escritor chega na I2; ate la o driver recusa com X0003)
const IMAGEM_MAX_SECOES: i32 = 13
pub const IMAGEM_MAX_IMPORTS: i32 = 320
pub const IMAGEM_MAX_DLLS: i32 = 17
const PE_IMAGE_BASE: u64 = 5368709120
const PE_IMAGE_BASE_DLL: u64 = 6442450944
const IMAGEM_BASE_ELF: u64 = 4194304
const PE_ALINHAMENTO_SECAO: u32 = 4096
const PE_TAM_NOME: u32 = 8
const PE_SECAO_CODIGO: u32 = 32
const PE_SECAO_DADOS_INIT: u32 = 64
const PE_SECAO_NAO_INIT: u32 = 128
pub const PE_SECAO_TEXTO: u32 = 1610612768
pub const PE_SECAO_LEITURA: u32 = 1073741888
pub const PE_SECAO_DADOS: u32 = 3221225536
pub const PE_SECAO_BSS: u32 = 3221225600
const PE_SECAO_IDATA: u32 = 3221225536
const PE_SECAO_RELOC: u32 = 1107296320
