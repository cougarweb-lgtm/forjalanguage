import "common"

pub struct PeExporta {
    nome: ?str
    rva: u32
}

pub struct PeSecao {
    nome: ?str
    caracteristicas: u32
    rva: u32
    tam_virtual: u32
    bytes: [dynamic]u8
}

pub struct PeSecaoPedido {
    nome: ?str
    caracteristicas: u32
    bytes: ?^[dynamic]u8
    tam_virtual: u32
}

pub struct ImagemDll {
    nome: ?str
    primeiro: u32
    qtd: u32
}

pub struct ImagemImportacao {
    dir_import_rva: u32
    dir_import_tam: u32
    dir_iat_rva: u32
    dir_iat_tam: u32
    iat_rva: [320]u32
    nomes: ?[320]str
    qtd: u32
    dlls: [17]ImagemDll
    qtd_dlls: u32
}

pub struct ImagemSimbolo {
    nome: ?str
    rva: u32
    secao: u32
}

pub struct ImagemRelativa {
    rva: u32
    valor: u64
}

// A4.2: celula da GOT que o carregador preenche (R_AARCH64_GLOB_DAT) com o endereco do simbolo `nome` importado
pub struct ImagemImportDin {
    nome: ?str
    rva: u32
}

pub struct Imagem {
    secoes: [13]PeSecao
    dbg: [4][dynamic]u8
    qtd_secoes: u32
    entrada_rva: u32
    runtime_texto_rva: u32
    linker_maior: u8
    linker_menor: u8
    importacao: ImagemImportacao
    dir64: [dynamic]u32
    dll: bool
    exportacoes: [dynamic]PeExporta
    formato: i32
    simbolos: [dynamic]ImagemSimbolo
    pie: bool
    relativos: [dynamic]ImagemRelativa
    tls: bool
    tls_secao: u32
    tls_alinhamento: u32
    pdb_caminho: ?str
    cv_guid: ?^u8
    // A64 (A1.2): 0 = padrao (x86-64: e_machine 62, pagina 4096); AArch64 = 183 e pagina 16384
    maquina: u32
    pagina: u32
    // A4.2: ELF dinamico (alvo android): DT_NEEDED por `necessarias` ("c" -> libc.so), DT_SONAME so no .so, DT_RUNPATH opcional,
    // GLOB_DAT por `imports_din`; os exports do .so vao em `exportacoes` (rva) e entram no .dynsym
    dinamico: bool
    imports_din: [dynamic]ImagemImportDin
    necessarias: [dynamic]str
    soname: ?str
    runpath: ?str
}

pub struct PeImportDll {
    dll: ?str
    nomes: ?[]str
    n: u32
}

