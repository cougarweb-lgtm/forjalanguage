const PE_CV_TAM_DIRETORIO: u32 = 28
pub const PE_CV_IDADE: u32 = 1

// C: nativo/fmt/pe.h:144
pub proc pe_base_da_imagem(im: ?^Imagem) -> u64 {
    if common.c2f_s2u_32((im as ^Imagem).formato) == (IMAGEM_ELF as u32) {
        var tern_1: u64 = IMAGEM_BASE_ELF
        if common.c2f_b2i32((im as ^Imagem).pie) != 0 {
            tern_1 = 0
        }
        return tern_1
    }
    var tern_2: u64 = PE_IMAGE_BASE
    if common.c2f_b2i32((im as ^Imagem).dll) != 0 {
        tern_2 = PE_IMAGE_BASE_DLL
    }
    return tern_2
}

// C: nativo/fmt/pe.h:165
proc pe_alinhar(v: u32, alinhamento: u32) -> u32 {
    return (((v + alinhamento) - 1) / alinhamento) * alinhamento
}
