import "common"

struct RsNoPedido {
    chave: ?str
    tipo: u32
    tam_valor: u32
    valor: ?^[dynamic]u8
    filhos: ?^[dynamic]u8
}

const RS_SECAO: u32 = 1073741888
const RS_TIPO_VERSAO: u32 = 16
const RS_TIPO_MANIFESTO: u32 = 24
const RS_ID_UNICO: u32 = 1
const RS_LINGUA: u32 = 1033
const RS_SUBDIR: u32 = 2147483648
const RS_TAM_DIR: u32 = 16
const RS_TAM_ENTRADA: u32 = 8
const RS_TAM_DIR_1: u32 = 24
const RS_TAM_DADOS: u32 = 16
const RS_QTD: u32 = 2
const RS_OFF_NOMES: u32 = 32
const RS_PASSO_RECURSO: u32 = 48
const RS_OFF_DADOS: u32 = 128
const RS_OFF_BLOBS: u32 = 160
const RS_TIPO_TEXTO: u32 = 1
const RS_TIPO_BINARIO: u32 = 0
const RS_TAM_FIXO: u32 = 52
const RS_ASSINATURA_FIXA: u32 = 4277077181
const RS_ESTRUTURA_FIXA: u32 = 65536
const RS_MASCARA_FLAGS: u32 = 63
const RS_SO_NT_WIN32: u32 = 262148
const RS_TIPO_APP: u32 = 1
const RS_TRADUCAO: u32 = 78644233
const RS_MANIFESTO: str = "<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>\r\n<assembly xmlns=\"urn:schemas-microsoft-com:asm.v1\" manifestVersion=\"1.0\"><trustInfo xmlns=\"urn:schemas-microsoft-com:asm.v3\"><security><requestedPrivileges><requestedExecutionLevel level=\"asInvoker\" uiAccess=\"false\"/></requestedPrivileges></security></trustInfo><compatibility xmlns=\"urn:schemas-microsoft-com:compatibility.v1\"><application><supportedOS Id=\"{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}\"/></application></compatibility></assembly>\r\n"
const TIPOS: [2]u32 = {16, 24}

// C: nativo/fmt/pe_recursos.c:49
proc rs_u16(b: ^[dynamic]u8, v: u32) {
    append(b, item = common.c2f_trunc_u8(v as u64))
    append(b, item = common.c2f_trunc_u8((v >> 8) as u64))
}

// C: nativo/fmt/pe_recursos.c:55
proc rs_u32(b: ^[dynamic]u8, v: u32) {
    rs_u16(b, v & 65535)
    rs_u16(b, v >> 16)
}

// C: nativo/fmt/pe_recursos.c:61
proc rs_pad4(b: ^[dynamic]u8) {
    while (len(b^) as u64) % 4 != 0 {
        append(b, item = 0 as u8)
    }
}

// C: nativo/fmt/pe_recursos.c:70
proc rs_wide(b: ^[dynamic]u8, texto: str) -> u32 {
    var n: u32 = 0
    while (n as u64) < (len(texto) as u64) and texto[n] != 0 {
        rs_u16(b, texto[n] as u32)
        n += 1 // '\0'
    }
    rs_u16(b, 0)
    return n + 1
}

// C: nativo/fmt/pe_recursos.c:90
proc rs_no(dst: ^[dynamic]u8, no: ^RsNoPedido) {
    let inicio: u64 = len(dst^) as u64
    rs_u16(dst, 0)
    rs_u16(dst, no.tam_valor)
    rs_u16(dst, no.tipo)
    _ = rs_wide(dst, no.chave or_else "")
    rs_pad4(dst)
    if no.valor != none {
        append(dst, items = (no.valor as ^[dynamic]u8)^[..])
    }
    if no.filhos != none {
        let filhos: ^[dynamic]u8 = no.filhos as ^[dynamic]u8
        if len(filhos^) != 0 {
            rs_pad4(dst)
            append(dst, items = filhos^[..])
        }
    }
    let tam_no: u64 = (len(dst^) as u64) - inicio
    dst^[inicio] = common.c2f_trunc_u8(tam_no)
    dst^[inicio + 1] = common.c2f_trunc_u8(tam_no >> 8)
}

// C: nativo/fmt/pe_recursos.c:110
// C2F-INDECIDIVEL: sscanf "%u.%u.%u" com saida por parametro -> aqui devolve [3]u32 (zero no que faltar);
// so digitos e '.' (sem espaco nem sinal, que a versao do compilador nunca tem); estouro de u32 da a volta
proc rs_partes_versao(versao: str) -> [3]u32 {
    var partes: [3]u32 = {0, 0, 0}
    let bytes: []u8 = as_bytes(versao)
    let total: u64 = len(bytes) as u64
    var pos: u64 = 0
    for idx in (0 as u32)..<3 {
        if idx > 0 {
            if (pos >= total) or (bytes[pos] != 46) {
                break
            }
            pos += 1
        }
        if (pos >= total) or (bytes[pos] < 48) or (bytes[pos] > 57) {
            break
        }
        var valor: u32 = 0
        while (pos < total) and (bytes[pos] >= 48) and (bytes[pos] <= 57) {
            valor = wrapping_add(wrapping_mul(valor, 10), (bytes[pos] - 48) as u32)
            pos += 1
        }
        partes[idx] = valor
    }
    return partes
}

// C: nativo/fmt/pe_recursos.c:116
proc rs_fixo(b: ^[dynamic]u8, versao: str) {
    let p: [3]u32 = rs_partes_versao(versao)
    let ms: u32 = (p[0] << 16) | p[1]
    let ls: u32 = p[2] << 16
    rs_u32(b, RS_ASSINATURA_FIXA)
    rs_u32(b, RS_ESTRUTURA_FIXA)
    rs_u32(b, ms)
    rs_u32(b, ls)
    rs_u32(b, ms)
    rs_u32(b, ls)
    rs_u32(b, RS_MASCARA_FLAGS)
    rs_u32(b, 0)
    rs_u32(b, RS_SO_NT_WIN32)
    rs_u32(b, RS_TIPO_APP)
    rs_u32(b, 0)
    rs_u32(b, 0)
    rs_u32(b, 0)
}

// C: nativo/fmt/pe_recursos.c:137
proc rs_string(tabela: ^[dynamic]u8, chave: str, valor: str) {
    var v: [dynamic]u8 = make([dynamic]u8, alloc = heap)
    let n: u32 = rs_wide(&v, valor)
    var lit_1 = RsNoPedido{chave = chave, tipo = RS_TIPO_TEXTO, tam_valor = n, valor = &v, filhos = none}
    rs_no(tabela, &lit_1)
    rs_pad4(tabela)
    delete(v)
}

// C: nativo/fmt/pe_recursos.c:147
proc rs_string_file_info(dst: ^[dynamic]u8, versao: str) {
    var tabela: [dynamic]u8 = make([dynamic]u8, alloc = heap)
    var st: [dynamic]u8 = make([dynamic]u8, alloc = heap)
    rs_string(&tabela, "ProductName", "Forja Native")
    rs_string(&tabela, "ProductVersion", versao)
    rs_string(&tabela, "FileVersion", versao)
    rs_string(&tabela, "FileDescription", "Executavel gerado pelo backend nativo da Forja")
    var lit_1 = RsNoPedido{chave = "040904B0", tipo = RS_TIPO_TEXTO, tam_valor = 0, valor = none, filhos = &tabela}
    rs_no(&st, &lit_1)
    var lit_2 = RsNoPedido{chave = "StringFileInfo", tipo = RS_TIPO_TEXTO, tam_valor = 0, valor = none, filhos = &st}
    rs_no(dst, &lit_2)
    delete(tabela)
    delete(st)
}

// C: nativo/fmt/pe_recursos.c:161
proc rs_var_file_info(dst: ^[dynamic]u8) {
    var traducao: [dynamic]u8 = make([dynamic]u8, alloc = heap)
    var var_c: [dynamic]u8 = make([dynamic]u8, alloc = heap)
    rs_u32(&traducao, RS_TRADUCAO)
    var lit_1 = RsNoPedido{chave = "Translation", tipo = RS_TIPO_BINARIO, tam_valor = 4, valor = &traducao, filhos = none}
    rs_no(&var_c, &lit_1) // C2F: sizeof ( uint32_t )
    var lit_2 = RsNoPedido{chave = "VarFileInfo", tipo = RS_TIPO_TEXTO, tam_valor = 0, valor = none, filhos = &var_c}
    rs_no(dst, &lit_2)
    delete(traducao)
    delete(var_c)
}

// C: nativo/fmt/pe_recursos.c:173
proc rs_montar_versao(blob: ^[dynamic]u8, versao: str) {
    var fixo: [dynamic]u8 = make([dynamic]u8, alloc = heap)
    var filhos: [dynamic]u8 = make([dynamic]u8, alloc = heap)
    rs_fixo(&fixo, versao)
    rs_string_file_info(&filhos, versao)
    rs_pad4(&filhos)
    rs_var_file_info(&filhos)
    var lit_1 = RsNoPedido{chave = "VS_VERSION_INFO", tipo = RS_TIPO_BINARIO, tam_valor = RS_TAM_FIXO, valor = &fixo, filhos = &filhos}
    rs_no(blob, &lit_1)
    delete(fixo)
    delete(filhos)
}

// C: nativo/fmt/pe_recursos.c:186
proc rs_dir(b: ^[dynamic]u8, qtd_ids: u32) {
    rs_u32(b, 0)
    rs_u32(b, 0)
    rs_u16(b, 0)
    rs_u16(b, 0)
    rs_u16(b, 0)
    rs_u16(b, qtd_ids)
}

// C: nativo/fmt/pe_recursos.c:196
proc rs_entrada(b: ^[dynamic]u8, id: u32, destino: u32) {
    rs_u32(b, id)
    rs_u32(b, destino)
}

// C: nativo/fmt/pe_recursos.c:203
proc rs_arvore(b: ^[dynamic]u8, rva_blob: [2]u32, tam_blob: [2]u32) {
    rs_dir(b, RS_QTD)
    for k in (0 as u32)..<RS_QTD {
        rs_entrada(b, TIPOS[k], (RS_OFF_NOMES + (k * RS_PASSO_RECURSO)) | RS_SUBDIR)
    }
    for k in (0 as u32)..<RS_QTD {
        let nomes: u32 = RS_OFF_NOMES + (k * RS_PASSO_RECURSO)
        rs_dir(b, 1)
        rs_entrada(b, RS_ID_UNICO, (nomes + RS_TAM_DIR_1) | RS_SUBDIR)
        rs_dir(b, 1)
        rs_entrada(b, RS_LINGUA, RS_OFF_DADOS + (k * RS_TAM_DADOS))
    }
    for k in (0 as u32)..<RS_QTD {
        rs_u32(b, rva_blob[k])
        rs_u32(b, tam_blob[k])
        rs_u32(b, 0)
        rs_u32(b, 0)
    }
}

// C: nativo/fmt/pe_recursos.c:225
// C2F-INDECIDIVEL: blobs[RS_QTD] (versao e manifesto) viram dois buffers nomeados (sem array de [dynamic])
pub proc pe_acrescentar_recursos(im: ^Imagem, versao: str, erro: ^common.Diag) -> bool {
    let rva: u32 = imagem_proximo_rva(im)
    var blob_versao: [dynamic]u8 = make([dynamic]u8, alloc = heap)
    var blob_manifesto: [dynamic]u8 = make([dynamic]u8, alloc = heap)
    var secao: [dynamic]u8 = make([dynamic]u8, alloc = heap)
    rs_montar_versao(&blob_versao, versao)
    append(&blob_manifesto, items = as_bytes(RS_MANIFESTO))
    var rva_blob: [2]u32 = {0, 0}
    var tam_blob: [2]u32 = {0, 0}
    tam_blob[0] = (len(blob_versao) as u64) as u32
    rva_blob[0] = wrapping_add(rva, RS_OFF_BLOBS)
    rva_blob[1] = wrapping_add(rva_blob[0], (wrapping_add(tam_blob[0], 3) & ~3))
    tam_blob[1] = (len(blob_manifesto) as u64) as u32
    rs_arvore(&secao, rva_blob, tam_blob)
    append(&secao, items = blob_versao[..])
    rs_pad4(&secao)
    append(&secao, items = blob_manifesto[..])
    rs_pad4(&secao)
    delete(blob_versao)
    delete(blob_manifesto)
    var pedido: PeSecaoPedido = PeSecaoPedido{nome = ".rsrc", caracteristicas = RS_SECAO, bytes = &secao, tam_virtual = (len(secao) as u64) as u32}
    let rva_rsrc: u32 = imagem_secao(im, &pedido, erro)
    delete(secao)
    return rva_rsrc != 0
}
