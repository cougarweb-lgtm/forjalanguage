        pe_u8(b, 0)
    }
}

// C: nativo/fmt/pe_escrever.c:126
proc pe_alinhar_buf(b: ^[dynamic]u8, alinhamento: u32) {
    let resto: u32 = ((len(b^) as u64) % (alinhamento as u64)) as u32
    if resto != 0 {
        pe_zeros(b, alinhamento - resto)
    }
}

// C: nativo/fmt/pe_escrever.c:135
proc pe_tam_thunks(n: u32) -> u32 {
    return PE_TAM_THUNK * (n + 1)
}

