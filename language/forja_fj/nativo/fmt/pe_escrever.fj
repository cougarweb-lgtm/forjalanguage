}

// C: nativo/fmt/pe_escrever.c:210
proc pe_montar_tabela_nomes(p: ^PeIdataPedido, tab: ^[dynamic]u8, offs: []u32) {
    let dlls: []PeImportDll = (p.dlls or_else {})[0..<p.n_dlls]
    var primeiro: u32 = 0
    for i in (0 as u32)..<p.n_dlls {
        let qtd: u32 = dlls[i].n
        pe_montar_hint_names(dlls[i].nomes or_else {}, tab, offs[primeiro..<(primeiro + qtd)])
        primeiro += qtd
    }
}

// C: nativo/fmt/pe_escrever.c:220
// C2F-INDECIDIVEL: rvas
proc pe_rvas_nomes_dll(p: ^PeIdataPedido, rva: u32, rvas: []u32) {
    var rva_v: u32 = rva
    var i: u32 = 0
    while i < p.n_dlls {
        rvas[i] = rva_v
        rva_v += ((len(((p.dlls or_else {})[i].dll or_else "")) as u64) as u32) + 1
        i += 1
    }
}

// C: nativo/fmt/pe_escrever.c:229
// C2F-INDECIDIVEL: nomes_dll
proc pe_montar_descritores(p: ^PeIdataPedido, pl: ^PeIdataPlano, nomes_dll: []u32, idata: ^[dynamic]u8) {
    var ilt: u32 = pl.ilt
    var iat: u32 = pl.iat
    var i: u32 = 0
    while i < p.n_dlls {
        pe_montar_descritor(idata, ilt, nomes_dll[i], iat)
        ilt += pe_tam_thunks((p.dlls or_else {})[i].n)
        iat += pe_tam_thunks((p.dlls or_else {})[i].n)
        i += 1
    }
    pe_zeros(idata, PE_TAM_DESCRITOR)
}

// C: nativo/fmt/pe_escrever.c:240
proc pe_montar_thunks_dlls(p: ^PeIdataPedido, rvas: []u32, idata: ^[dynamic]u8) {
    let dlls: []PeImportDll = (p.dlls or_else {})[0..<p.n_dlls]
    var primeiro: u32 = 0
    for i in (0 as u32)..<p.n_dlls {
        let qtd: u32 = dlls[i].n
        pe_montar_thunks(idata, rvas[primeiro..<(primeiro + qtd)])
        primeiro += qtd
    }
}

// C: nativo/fmt/pe_escrever.c:250
// C2F-INDECIDIVEL: offs/rvas/nomes_dll = arrays de tamanho maximo (IMAGEM_MAX_IMPORTS 320, IMAGEM_MAX_DLLS 17) na pilha
proc pe_montar_idata(p: ^PeIdataPedido, idata: ^[dynamic]u8) {
    let dlls: []PeImportDll = (p.dlls or_else {})[0..<p.n_dlls]
    var pl: PeIdataPlano = pe_planejar_idata(p.base, dlls)
    var offs: [320]u32 = {}
    var rvas: [320]u32 = {}
    var nomes_dll: [17]u32 = {}
    let total: u32 = pe_total_nomes(dlls)
    var tab: [dynamic]u8 = make([dynamic]u8, alloc = heap)
    pe_montar_tabela_nomes(p, &tab, offs[..])
    var k: u32 = 0
    while k < total {
        rvas[k] = wrapping_add(pl.hint, offs[k])
        k += 1
    }
    pe_rvas_nomes_dll(p, wrapping_add(pl.hint, (len(tab) as u64) as u32), nomes_dll[..])
    pe_montar_descritores(p, &pl, nomes_dll[..], idata)
    pe_montar_thunks_dlls(p, rvas[..], idata)
    pe_montar_thunks_dlls(p, rvas[..], idata)
    append(idata, items = tab[..])
    var i: u32 = 0
    while i < p.n_dlls {
        append(idata, items = as_bytes(dlls[i].dll or_else ""))
        pe_u8(idata, 0)
        i += 1
    }
    delete(tab)
}

// C: nativo/fmt/pe_escrever.c:272
// C2F-INDECIDIVEL: ImagemImportacao.nomes e ?[320]str; o array monta-se local e grava de uma vez (C deixa o resto zerado)
proc pe_guardar_dlls(imp: ^ImagemImportacao, p: ^PeIdataPedido, iat: u32) {
    var nomes: [320]str = {}
    let dlls: []PeImportDll = (p.dlls or_else {})[0..<p.n_dlls]
    var iat_atual: u32 = iat
    imp.qtd = 0
    imp.qtd_dlls = p.n_dlls
    for i in (0 as u32)..<p.n_dlls {
        let d: PeImportDll = dlls[i]
        imp.dlls[i] = ImagemDll{nome = d.dll, primeiro = imp.qtd, qtd = d.n}
        for k in (0 as u32)..<d.n {
            imp.iat_rva[imp.qtd] = wrapping_add(iat_atual, k * PE_TAM_THUNK)
            nomes[imp.qtd] = (d.nomes or_else {})[k]
            imp.qtd += 1
        }
        iat_atual = wrapping_add(iat_atual, pe_tam_thunks(d.n))
    }
    imp.nomes = nomes
}

// C: nativo/fmt/pe_escrever.c:287
proc pe_guardar_importacoes(im: ^Imagem, p: ^PeIdataPedido) {
    let imp: ^ImagemImportacao = &im.importacao
    let pl: PeIdataPlano = pe_planejar_idata(p.base, (p.dlls or_else {})[0..<p.n_dlls])
    imp.dir_import_rva = p.base
    imp.dir_import_tam = (p.n_dlls + PE_DESCRITORES_FIM) * PE_TAM_DESCRITOR
    imp.dir_iat_rva = pl.iat
    imp.dir_iat_tam = pl.tam_thunks
    pe_guardar_dlls(imp, p, pl.iat)
}

// C: nativo/fmt/pe_escrever.c:299
// C2F-13: dlls fundido em n_dlls (len)
proc pe_importacoes_validas(dlls: []PeImportDll) -> bool {
    if ((len(dlls) as u32) == 0) or ((len(dlls) as u32) > (IMAGEM_MAX_DLLS as u32)) {
        return false
    }
    for i in (0 as u32)..<(len(dlls) as u32) {
        if dlls[i].n == 0 {
            return false
        }
    }
    return pe_total_nomes(dlls) <= (IMAGEM_MAX_IMPORTS as u32)
}

// C: nativo/fmt/pe_escrever.c:310
// C2F-13: dlls fundido em n_dlls (len)
pub proc pe_reservar_importacoes_dlls(im: ^Imagem, dlls: []PeImportDll) -> bool {
    if not pe_importacoes_validas(dlls) {
        return false
    }
    let base: u32 = imagem_proximo_rva(im)
    var idata: [dynamic]u8 = make([dynamic]u8, alloc = heap)
    var erro: common.Diag = common.Diag{tem = false}
    var pedido: PeIdataPedido = PeIdataPedido{base = base, dlls = dlls, n_dlls = len(dlls) as u32}
    pe_montar_idata(&pedido, &idata)
    var secao: PeSecaoPedido = PeSecaoPedido{nome = ".idata", caracteristicas = PE_SECAO_IDATA, bytes = &idata, tam_virtual = (len(idata) as u64) as u32}
    let rva: u32 = imagem_secao(im, &secao, &erro)
    delete(idata)
    if rva == 0 {
        let txt_1 = erro.causa or_else "(null)"
        let msg_1 = format(f"pe: .idata recusado: {txt_1}", alloc = heap)
        defer delete(msg_1)
        common.falha_interna(msg_1)
    }
    if rva != base {
        let msg_2 = format(f"pe: .idata em 0x{rva:x}, previsto 0x{base:x}", alloc = heap)
        defer delete(msg_2)
        common.falha_interna(msg_2)
    }
    pe_guardar_importacoes(im, &pedido)
    return true
}

// C: nativo/fmt/pe_escrever.c:330
// C2F-13: nomes + n fundidos em nomes: []str (n = len); a assinatura gerada (^?^u8) nao representa o array de str
proc pe_reservar_importacoes(im: ^Imagem, dll: str, nomes: []str) -> bool {
    var unica: [1]PeImportDll = {PeImportDll{dll = dll, nomes = nomes, n = (len(nomes) as u64) as u32}}
    return pe_reservar_importacoes_dlls(im, unica[..])
}

// C: nativo/fmt/pe_escrever.c:338
proc pe_rva_dir64(im: ^Imagem, i: u32) -> u32 {
    return im.dir64[i as u64]
}

// C: nativo/fmt/pe_escrever.c:344
proc pe_anexar_bloco_reloc(im: ^Imagem, i: ^u32, b: ^[dynamic]u8) {
    let ini: u32 = i^
    let mascara: u32 = ~(PE_ALINHAMENTO_SECAO - 1)
    let pagina: u32 = pe_rva_dir64(im, ini) & mascara
    while ((i^ as u64) < (len(im.dir64) as u64)) and ((pe_rva_dir64(im, i^) & mascara) == pagina) {
        i^ += 1
    }
    let qtd: u32 = i^ - ini
    pe_u32(b, pagina as u64)
    pe_u32(b, pe_alinhar(PE_TAM_BLOCO_RELOC + (qtd * PE_TAM_ENTRADA_RELOC), PE_ALINHAMENTO_BLOCO_RELOC) as u64)
    for k in ini..<i^ {
        pe_u16(b, ((PE_RELOC_DIR64 as u64) << 12) | ((pe_rva_dir64(im, k) & (PE_ALINHAMENTO_SECAO - 1)) as u64))
    }
    if (qtd % 2) != 0 {
        pe_u16(b, 0)
    }
}

// C: nativo/fmt/pe_escrever.c:360
proc pe_montar_reloc(im: ^Imagem, b: ^[dynamic]u8) {
    var i: u32 = 0
    while (i as u64) < (len(im.dir64) as u64) {
        pe_anexar_bloco_reloc(im, &i, b)
    }
}

// C: nativo/fmt/pe_escrever.c:369
// C2F-INDECIDIVEL: o C copia o struct (bytes compartilhados); aqui cada secao recebe copia dos bytes (dono unico, E0311)
proc pe_copiar_secoes(im: ^Imagem, l: ^PeLayout) {
    for i in (0 as u32)..<im.qtd_secoes {
        let orig: ^PeSecao = &im.secoes[i]
        l.secs[i].nome = orig.nome
        l.secs[i].caracteristicas = orig.caracteristicas
        l.secs[i].rva = orig.rva
        l.secs[i].tam_virtual = orig.tam_virtual
        append(&l.secs[i].bytes, items = orig.bytes[..])
    }
    l.qtd = im.qtd_secoes
}

// C: nativo/fmt/pe_escrever.c:375
proc pe_base_codigo(l: ^PeLayout) -> u32 {
    for i in (0 as u32)..<l.qtd {
        if (l.secs[i].caracteristicas & PE_SECAO_CODIGO) != 0 {
            return l.secs[i].rva
        }
    }
    return 0
}

// C: nativo/fmt/pe_escrever.c:385
proc pe_montar_reloc_vazio(pagina: u32, b: ^[dynamic]u8) {
    pe_u32(b, pagina as u64)
    pe_u32(b, pe_alinhar(PE_TAM_BLOCO_RELOC + PE_TAM_ENTRADA_RELOC, PE_ALINHAMENTO_BLOCO_RELOC) as u64)
    pe_u16(b, 0)
    pe_u16(b, 0)
}

// C: nativo/fmt/pe_escrever.c:393
proc pe_acrescentar_reloc(im: ^Imagem, reloc: ^[dynamic]u8, l: ^PeLayout) {
    if len(im.dir64) == 0 {
        pe_montar_reloc_vazio(pe_base_codigo(l), reloc)
    } else {
        pe_montar_reloc(im, reloc)
    }
    let indice: u32 = l.qtd
    l.qtd += 1
    let s: ^PeSecao = &l.secs[indice]
    s.nome = pe_nome_secao(".reloc")
    s.caracteristicas = PE_SECAO_RELOC
    s.rva = imagem_proximo_rva(im)
    s.tam_virtual = (len(reloc^) as u64) as u32
    append(&s.bytes, items = reloc^[..])
}

// C: nativo/fmt/pe_escrever.c:409
proc pe_proximo_rva_layout(l: ^PeLayout) -> u32 {
    let ult: ^PeSecao = &l.secs[l.qtd - 1]
    return pe_alinhar(ult.rva + ult.tam_virtual, PE_ALINHAMENTO_SECAO)
}

// C: nativo/fmt/pe_escrever.c:416
proc pe_acrescentar_code_view(im: ^Imagem, l: ^PeLayout) {
    if im.pdb_caminho == none {
        return
    }
    let rva: u32 = pe_proximo_rva_layout(l)
    l.cv = l.qtd
    l.qtd += 1
    let s: ^PeSecao = &l.secs[l.cv]
    pe_code_view_secao(s, rva, im.pdb_caminho)
}

// C: nativo/fmt/pe_escrever.c:429
proc pe_acrescentar_debug(im: ^Imagem, l: ^PeLayout) {
    for k in (0 as u32)..<(IMAGEM_QTD_DEBUG as u32) {
        if len(im.dbg[k]) == 0 {
            continue
        }
        let rva: u32 = pe_proximo_rva_layout(l)
        let indice: u32 = l.qtd
        l.qtd += 1
        let s: ^PeSecao = &l.secs[indice]
        s.caracteristicas = PE_SECAO_RELOC
        s.rva = rva
        s.tam_virtual = (len(im.dbg[k]) as u64) as u32
        append(&s.bytes, items = im.dbg[k][..])
        pe_nome_secao_longo(&l.tab_nomes, pe_nome_secao_debug(k), &s.nome)
    }
    pe_tabela_fechar(&l.tab_nomes)
}

// C: nativo/fmt/pe_escrever.c:446
proc pe_calcular_arquivo(l: ^PeLayout) {
    var ptr: u32 = pe_alinhar(PE_OFF_SECOES + (l.qtd * PE_TAM_SECAO_TAB), PE_ALINHAMENTO_ARQUIVO)
    l.tam_cabecalhos = ptr
    var i: u32 = 0
    while i < l.qtd {
        let s: ^PeSecao = &l.secs[i]
        let tam: u32 = (len(s.bytes) as u64) as u32
        l.bruto[i] = pe_alinhar(tam, PE_ALINHAMENTO_ARQUIVO)
        var tern_1: u32 = 0
        if tam != 0 {
            tern_1 = ptr
        }
        l.ptr[i] = tern_1
        ptr += l.bruto[i]
        l.tam_imagem = pe_alinhar(s.rva + s.tam_virtual, PE_ALINHAMENTO_SECAO)
        i += 1
    }
    var tern_2: u32 = 0
    if (len(l.tab_nomes) as u64) > 0 {
        tern_2 = ptr
    }
    l.ptr_tab_nomes = tern_2
    if l.cv != 0 {
        pe_code_view_ponteiro(&l.secs[l.cv].bytes, l.ptr[l.cv])
    }
}

// C: nativo/fmt/pe_escrever.c:463
proc pe_montar(im: ^Imagem, reloc: ^[dynamic]u8, l: ^PeLayout) {
    l^ = PeLayout{}
    // o C anexa em buffer zerado (BufAnexar aloca); aqui cada lista nasce com alocador
    for i in (0 as u32)..<18 {
        l.secs[i].bytes = make([dynamic]u8, alloc = heap)
    }
    l.tab_nomes = make([dynamic]u8, alloc = heap)
    pe_copiar_secoes(im, l)
    pe_acrescentar_reloc(im, reloc, l)
    pe_acrescentar_code_view(im, l)
    pe_acrescentar_debug(im, l)
    pe_calcular_arquivo(l)
}

// C: nativo/fmt/pe_escrever.c:474
proc pe_somar(l: ^PeLayout, mascara: u32, bruto: bool) -> u32 {
    var soma: u32 = 0
    for i in (0 as u32)..<l.qtd {
        if (l.secs[i].caracteristicas & mascara) != 0 {
            var tern_1: u32 = l.secs[i].tam_virtual
            if common.c2f_b2i32(bruto) != 0 {
                tern_1 = l.bruto[i]
            }
            soma += tern_1
        }
    }
    return soma
}

// C: nativo/fmt/pe_escrever.c:486
proc pe_escrever_dos(b: ^[dynamic]u8) {
    for k in (0 as u32)..<PE_LFANEW {
        pe_u8(b, PE_DOS_PADRAO[k] as u64)
    }
}

// C: nativo/fmt/pe_escrever.c:491
// C2F-INDECIDIVEL: o C devolve ponteiro para a secao; aqui ^PeSecao dentro do layout (sem append depois)
proc pe_achar_secao(l: ^PeLayout, nome: str) -> ?^PeSecao {
    let alvo: str = pe_nome_secao(nome)
    for i in (0 as u32)..<l.qtd {
        if (l.secs[i].nome or_else "") == alvo {
            return &l.secs[i]
        }
    }
    return none
}

// C: nativo/fmt/pe_escrever.c:502
// C2F-INDECIDIVEL: dir era parametro de saida (uint32_t[16][2]); aqui e o retorno (array por valor)
proc pe_definir_diretorios(l: ^PeLayout, im: ^Imagem) -> [16][2]u32 {
    var dir: [16][2]u32 = {}
    let pdata: ?^PeSecao = pe_achar_secao(l, ".pdata")
    let reloc: ?^PeSecao = pe_achar_secao(l, ".reloc")
    let rsrc: ?^PeSecao = pe_achar_secao(l, ".rsrc")
    let edata: ?^PeSecao = pe_achar_secao(l, ".edata")
    let imp: ^ImagemImportacao = &im.importacao
    if l.cv != 0 {
        dir[PE_DIR_DEBUG][0] = l.secs[l.cv].rva
        dir[PE_DIR_DEBUG][1] = PE_CV_TAM_DIRETORIO
    }
    if edata != none {
        let secao_edata: ^PeSecao = edata as ^PeSecao
        dir[PE_DIR_EXPORT][0] = secao_edata.rva
        dir[PE_DIR_EXPORT][1] = secao_edata.tam_virtual
    }
    dir[PE_DIR_IMPORT][0] = imp.dir_import_rva
    dir[PE_DIR_IMPORT][1] = imp.dir_import_tam
    if rsrc != none {
        let secao_rsrc: ^PeSecao = rsrc as ^PeSecao
        dir[PE_DIR_RECURSOS][0] = secao_rsrc.rva
        dir[PE_DIR_RECURSOS][1] = secao_rsrc.tam_virtual
    }
    dir[PE_DIR_IAT][0] = imp.dir_iat_rva
    dir[PE_DIR_IAT][1] = imp.dir_iat_tam
    if pdata != none {
        let secao_pdata: ^PeSecao = pdata as ^PeSecao
        dir[PE_DIR_EXCECAO][0] = secao_pdata.rva
        dir[PE_DIR_EXCECAO][1] = secao_pdata.tam_virtual
    }
    if reloc != none {
        let secao_reloc: ^PeSecao = reloc as ^PeSecao
        dir[PE_DIR_BASERELOC][0] = secao_reloc.rva
        dir[PE_DIR_BASERELOC][1] = secao_reloc.tam_virtual
    }
    return dir
}

// C: nativo/fmt/pe_escrever.c:535
proc pe_escrever_diretorios(l: ^PeLayout, im: ^Imagem, b: ^[dynamic]u8) {
    let dir: [16][2]u32 = pe_definir_diretorios(l, im)
    for i in (0 as u32)..<PE_DIRETORIOS {
        pe_u32(b, dir[i][0] as u64)
        pe_u32(b, dir[i][1] as u64)
    }
}

// C: nativo/fmt/pe_escrever.c:547
proc pe_escrever_opcional_campos(l: ^PeLayout, im: ^Imagem, b: ^[dynamic]u8) {
    pe_u16(b, PE_MAGIC_PE32_MAIS as u64)
    pe_u8(b, im.linker_maior as u64)
    pe_u8(b, im.linker_menor as u64)
    pe_u32(b, pe_somar(l, PE_SECAO_CODIGO, true) as u64)
    pe_u32(b, pe_somar(l, PE_SECAO_DADOS_INIT, true) as u64)
    pe_u32(b, pe_somar(l, PE_SECAO_NAO_INIT, false) as u64)
    pe_u32(b, im.entrada_rva as u64)
    pe_u32(b, pe_base_codigo(l) as u64)
    pe_u64(b, pe_base_da_imagem(im))
    pe_u32(b, PE_ALINHAMENTO_SECAO as u64)
    pe_u32(b, PE_ALINHAMENTO_ARQUIVO as u64)
}

// C: nativo/fmt/pe_escrever.c:563
proc pe_escrever_opcional_versoes(l: ^PeLayout, b: ^[dynamic]u8) {
    pe_u16(b, PE_VERSAO_SO_MAIOR as u64)
    pe_u16(b, 0)
    pe_u16(b, 0)
    pe_u16(b, 0)
    pe_u16(b, PE_VERSAO_SUBSISTEMA_MAIOR as u64)
    pe_u16(b, PE_VERSAO_SUBSISTEMA_MENOR as u64)
    pe_u32(b, 0)
    pe_u32(b, l.tam_imagem as u64)
    pe_u32(b, l.tam_cabecalhos as u64)
    pe_u32(b, 0)
    pe_u16(b, PE_SUBSISTEMA_CUI as u64)
    pe_u16(b, PE_DLL_CARAC as u64)
    pe_u64(b, PE_PILHA_RESERVA)
    pe_u64(b, PE_PILHA_COMMIT)
    pe_u64(b, PE_HEAP_RESERVA)
    pe_u64(b, PE_HEAP_COMMIT)
    pe_u32(b, 0)
    pe_u32(b, PE_DIRETORIOS as u64)
}

// C: nativo/fmt/pe_escrever.c:585
proc pe_escrever_opcional(l: ^PeLayout, im: ^Imagem, b: ^[dynamic]u8) {
    pe_escrever_opcional_campos(l, im, b)
    pe_escrever_opcional_versoes(l, b)
    pe_escrever_diretorios(l, im, b)
}

// C: nativo/fmt/pe_escrever.c:592
proc pe_escrever_cabecalho(l: ^PeLayout, im: ^Imagem, b: ^[dynamic]u8) {
    pe_u8(b, 80) // 'P'
    pe_u8(b, 69) // 'E'
    pe_u8(b, 0)
    pe_u8(b, 0)
    pe_u16(b, PE_MAQUINA_AMD64 as u64)
    pe_u16(b, l.qtd as u64)
    pe_u32(b, 0)
    pe_u32(b, l.ptr_tab_nomes as u64)
    pe_u32(b, 0)
    pe_u16(b, PE_TAM_OPCIONAL as u64)
    var caracteristicas: u32 = PE_CARAC_EXE
    if im.dll {
        caracteristicas = PE_CARAC_DLL
    }
    pe_u16(b, caracteristicas as u64)
    pe_escrever_opcional(l, im, b)
}

// C: nativo/fmt/pe_escrever.c:605
proc pe_escrever_secao_tab(s: ^PeSecao, ptr: u32, bruto: u32, b: ^[dynamic]u8) {
    let nome: str = s.nome or_else ""
    append(b, items = as_bytes(nome))
    pe_zeros(b, PE_TAM_NOME - ((len(nome) as u64) as u32))
    pe_u32(b, s.tam_virtual as u64)
    pe_u32(b, s.rva as u64)
    pe_u32(b, bruto as u64)
    pe_u32(b, ptr as u64)
    pe_u32(b, 0)
    pe_u32(b, 0)
    pe_u32(b, 0)
    pe_u32(b, s.caracteristicas as u64)
}

// C: nativo/fmt/pe_escrever.c:618
proc pe_escrever_dados(s: ^PeSecao, bruto: u32, b: ^[dynamic]u8) {
    if bruto == 0 {
        return
    }
    append(b, items = s.bytes[..])
    pe_alinhar_buf(b, PE_ALINHAMENTO_ARQUIVO)
}

// C: nativo/fmt/pe_escrever.c:626
proc pe_escrever_secoes(l: ^PeLayout, b: ^[dynamic]u8) {
    for i in (0 as u32)..<l.qtd {
        pe_escrever_secao_tab(&l.secs[i], l.ptr[i], l.bruto[i], b)
    }
    pe_alinhar_buf(b, PE_ALINHAMENTO_ARQUIVO)
    for i in (0 as u32)..<l.qtd {
        pe_escrever_dados(&l.secs[i], l.bruto[i], b)
    }
}

// C: nativo/fmt/pe_escrever.c:637
proc pe_cabe(v: ^PeVisao, off: u32, tam: u32) -> bool {
    return (off <= v.n) and (tam <= (v.n - off))
}

// C: nativo/fmt/pe_escrever.c:643
proc pe_ler_le(v: ^PeVisao, off: u32, n: u32) -> u32 {
    var r: u32 = 0
    for k in (0 as u32)..<n {
        r = r | (((v.d or_else {})[off + k] as u32) << ((k * PE_BITS_BYTE) & 31))
    }
    return r
}

// C: nativo/fmt/pe_escrever.c:651
proc pe_ler16(v: ^PeVisao, off: u32) -> u32 {
    return pe_ler_le(v, off, 2) // C2F: sizeof ( uint16_t )
}

// C: nativo/fmt/pe_escrever.c:656
proc pe_ler32(v: ^PeVisao, off: u32) -> u32 {
    return pe_ler_le(v, off, 4) // C2F: sizeof ( uint32_t )
}

// C: nativo/fmt/pe_escrever.c:661
proc pe_dentro_de(valor: u32, ini: u32, tam: u32) -> bool {
    return (valor >= ini) and ((valor - ini) < tam)
}

// C: nativo/fmt/pe_escrever.c:666
proc pe_checar_dos(v: ^PeVisao) -> ?str {
    if not pe_cabe(v, 0, PE_LFANEW) {
        return "arquivo menor que o cabecalho DOS"
    }
    if ((v.d or_else {})[0] != 77) or ((v.d or_else {})[1] != 90) { // 'M' 'Z'
        return "assinatura MZ ausente"
    }
    if pe_ler32(v, PE_OFF_LFANEW) != PE_LFANEW {
        return "e_lfanew diferente de 0x80"
    }
    return none
}

// C: nativo/fmt/pe_escrever.c:677
proc pe_checar_coff(v: ^PeVisao) -> ?str {
    if not pe_cabe(v, PE_LFANEW, PE_OFF_SECOES - PE_LFANEW) {
        return "cabecalho PE truncado"
    }
    let d: []u8 = v.d or_else {}
    // assinatura "PE\0\0": 'P' = 80, 'E' = 69
    if (d[PE_LFANEW] != 80) or (d[PE_LFANEW + 1] != 69) or (d[PE_LFANEW + 2] != 0) or (d[PE_LFANEW + 3] != 0) {
        return "assinatura PE ausente"
    }
    if pe_ler16(v, PE_OFF_COFF) != PE_MAQUINA_AMD64 {
        return "maquina diferente de AMD64"
    }
    if pe_ler16(v, PE_OFF_COFF + PE_COFF_TAM_OPCIONAL) != PE_TAM_OPCIONAL {
        return "SizeOfOptionalHeader diferente de 240"
    }
    if pe_ler16(v, PE_OFF_OPCIONAL) != PE_MAGIC_PE32_MAIS {
        return "magic diferente de PE32+"
    }
    return none
}

// C: nativo/fmt/pe_escrever.c:692
proc pe_checar_secao(v: ^PeVisao, off: u32) -> ?str {
    let bruto: u32 = pe_ler32(v, off + 16)
    let ptr: u32 = pe_ler32(v, off + 20)
    if (pe_ler32(v, off + 12) % PE_ALINHAMENTO_SECAO) != 0 {
        return "secao com RVA fora do alinhamento de 0x1000"
    }
    if not pe_cabe(v, ptr, bruto) {
        return "dados de secao fora do arquivo"
    }
    if (bruto != 0) and ((ptr % PE_ALINHAMENTO_ARQUIVO) != 0) {
        return "dados de secao fora do alinhamento de 0x200"
    }
    return none
}

// C: nativo/fmt/pe_escrever.c:704
proc pe_checar_secoes(v: ^PeVisao, qtd: u32) -> ?str {
    if pe_ler16(v, PE_OFF_COFF + PE_COFF_NSECOES) != qtd {
        return "numero de secoes diferente do montado"
    }
    if not pe_cabe(v, PE_OFF_SECOES, qtd * PE_TAM_SECAO_TAB) {
        return "tabela de secoes truncada"
    }
    for i in (0 as u32)..<qtd {
        let motivo: ?str = pe_checar_secao(v, PE_OFF_SECOES + (i * PE_TAM_SECAO_TAB))
        if motivo != none {
            return motivo
        }
    }
    return none
}

// C: nativo/fmt/pe_escrever.c:718
// bytes do nome ".text\0\0\0" (PE_NOME_TEXTO do C, 8 bytes)
const PE_NOME_TEXTO_BYTES: [8]u8 = {46, 116, 101, 120, 116, 0, 0, 0}

proc pe_checar_entrada(v: ^PeVisao, qtd: u32) -> ?str {
    let entrada: u32 = pe_ler32(v, PE_OFF_OPCIONAL + PE_OPC_ENTRADA)
    let d: []u8 = v.d or_else {}
    for i in (0 as u32)..<qtd {
        let off: u32 = PE_OFF_SECOES + (i * PE_TAM_SECAO_TAB)
        var igual: bool = true
        for k in (0 as u32)..<PE_TAM_NOME {
            if d[off + k] != PE_NOME_TEXTO_BYTES[k] {
                igual = false
            }
        }
        if not igual {
            continue
        }
        if pe_dentro_de(entrada, pe_ler32(v, off + 12), pe_ler32(v, off + 8)) {
            return none
        }
        return "entrada fora de .text"
    }
    return "secao .text ausente"
}

// C: nativo/fmt/pe_escrever.c:731
proc pe_em_secao(v: ^PeVisao, qtd: u32, rva: u32, tam: u32) -> bool {
    for i in (0 as u32)..<qtd {
        let off: u32 = PE_OFF_SECOES + (i * PE_TAM_SECAO_TAB)
        let sec_rva: u32 = pe_ler32(v, off + 12)
        let sec_tam: u32 = pe_ler32(v, off + 8)
        if ((rva >= sec_rva) and ((rva - sec_rva) < sec_tam)) and (tam <= (sec_tam - (rva - sec_rva))) {
            return true
        }
    }
    return false
}

// C: nativo/fmt/pe_escrever.c:742
proc pe_checar_diretorios(v: ^PeVisao, qtd: u32) -> ?str {
    for i in (0 as u32)..<PE_DIRETORIOS {
        let off: u32 = PE_OFF_DIRETORIOS + (i * PE_TAM_DIRETORIO)
        let rva: u32 = pe_ler32(v, off)
        let tam: u32 = pe_ler32(v, ((off as u64) + 4) as u32) // C2F: sizeof ( uint32_t )
        if (tam != 0) and (not pe_em_secao(v, qtd, rva, tam)) {
            return "diretorio fora de qualquer secao"
        }
    }
    return none
}

// C: nativo/fmt/pe_escrever.c:753
proc pe_conferir(v: ^PeVisao, qtd: u32) -> ?str {
    var motivo: ?str = pe_checar_dos(v)
    if motivo == none {
        motivo = pe_checar_coff(v)
    }
    if motivo == none {
        motivo = pe_checar_secoes(v, qtd)
    }
    if motivo == none {
        motivo = pe_checar_entrada(v, qtd)
    }
    if motivo == none {
        motivo = pe_checar_diretorios(v, qtd)
    }
    return motivo
}

// C: nativo/fmt/pe_escrever.c:767
proc pe_autoconferir(saida: ^[dynamic]u8, qtd: u32, erro: ^common.Diag) -> bool {
    var v: PeVisao = PeVisao{d = saida^[..], n = (len(saida^) as u64) as u32}
    let motivo: ?str = pe_conferir(&v, qtd)
    if motivo == none {
        return true
    }
    let texto: str = motivo or_else ""
    let msg: str = format(f"autoconferencia do PE: {texto}", alloc = frame)
    return common.diag_relatar(erro, common.X0905, 0, msg)
}

// C: nativo/fmt/pe_escrever.c:778
pub proc pe_escrever(im: ^Imagem, saida: ^[dynamic]u8, erro: ^common.Diag) -> bool {
    if len(saida^) != 0 {
        common.falha_interna("pe: PeEscrever recebeu uma saida que nao esta vazia")
    }
    if im.qtd_secoes == 0 {
        return common.diag_relatar(erro, common.X0905, 0, "autoconferencia do PE: imagem sem secoes")
    }
    var reloc: [dynamic]u8 = make([dynamic]u8, alloc = heap)
    var l: PeLayout = PeLayout{}
    pe_montar(im, &reloc, &l)
    pe_escrever_dos(saida)
    pe_escrever_cabecalho(&l, im, saida)
    pe_escrever_secoes(&l, saida)
    if len(l.tab_nomes) > 0 {
        append(saida, items = l.tab_nomes[..])
    }
    if l.cv != 0 {
        pe_code_view_guid(saida, l.ptr[l.cv], im.cv_guid)
    }
    delete(reloc)
    for i in (0 as u32)..<l.qtd {
        delete(l.secs[i].bytes)
    }
    delete(l.tab_nomes)
    return pe_autoconferir(saida, l.qtd, erro)
}
