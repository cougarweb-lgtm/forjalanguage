// C2F-13: dlls fundido em n_dlls (len)
proc pe_total_nomes(dlls: []PeImportDll) -> u32 {
    var total: u32 = 0
    for i in (0 as u32)..<(len(dlls) as u32) {
        total += dlls[i].n
    }
    return total
}

// C: nativo/fmt/pe_escrever.c:149
// C2F-13: dlls fundido em n_dlls (len)
proc pe_tam_thunks_dlls(dlls: []PeImportDll) -> u32 {
    var tam: u32 = 0
    for i in (0 as u32)..<(len(dlls) as u32) {
        tam += pe_tam_thunks(dlls[i].n)
    }
    return tam
}

// C: nativo/fmt/pe_escrever.c:163
// C2F-13: dlls fundido em n_dlls (len)
proc pe_planejar_idata(base: u32, dlls: []PeImportDll) -> PeIdataPlano {
    var pl: PeIdataPlano = PeIdataPlano{}
    pl.tam_thunks = pe_tam_thunks_dlls(dlls)
    pl.ilt = base + (((len(dlls) as u32) + PE_DESCRITORES_FIM) * PE_TAM_DESCRITOR)
    pl.iat = pl.ilt + pl.tam_thunks
    pl.hint = pl.iat + pl.tam_thunks
    return pl
}

