// C2F-INDECIDIVEL: offs
// C2F-13: nomes fundido em n (len)
proc pe_montar_hint_names(nomes: []str, tab: ^[dynamic]u8, offs: []u32) {
    for k in (0 as u32)..<(len(nomes) as u32) {
        offs[k] = (len(tab^) as u64) as u32
        pe_u16(tab, 0)
        append(tab, item = nomes[k])
        pe_u8(tab, 0)
        if ((len(tab^) as u64) % (PE_ALINHAMENTO_HINT as u64)) != 0 {
            pe_u8(tab, 0)
        }
    }
}

