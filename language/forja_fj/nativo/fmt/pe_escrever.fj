proc pe_anexar_le(b: ^[dynamic]u8, v: u64, n: u32) {
    for k in (0 as u32)..<n {
        append(b, item = common.c2f_trunc_u8(v >> (((k * PE_BITS_BYTE) & 63) as u64)))
    }
}

// C: nativo/fmt/pe_escrever.c:115
proc pe_u8(b: ^[dynamic]u8, v: u64) {
