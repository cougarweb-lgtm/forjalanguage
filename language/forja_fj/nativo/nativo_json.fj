// sha256 de nativo/nativo_json.c: d36eb8e5c4989f36e67608a2e330c05f63aa3368b47eb8f91f63b55d59ceccfa
// sha256 de nativo/nativo_json.h: 195757e796fa3436b7ece296284e4d8aacb3d4494e6d5a5d30c46017b3e30d14
// gerado por c2forja esqueleto 0.3.2
// Versao: 0.1.0

const FNV32_PRIMO: u32 = 16777619
const FNV32_INICIO: u32 = 2166136261

// C: nativo/nativo_json.c:12
// texto escapado entre aspas: aspa e barra viram \" e \\, controle abaixo de 0x20 vira \u00XX
pub proc json_texto(saida: ^[dynamic]u8, texto: ?str, n: u64) {
    let s: str = texto or_else ""
    append(saida, item = "\"")
    var k: u64 = 0
    while k < n {
        let ch: u8 = s[k]
        if ch == 34 or ch == 92 {
            append(saida, item = "\\")
            append(saida, item = ch)
        } else if ch < 32 {
            format(f"\\u{ch as u32:04x}", into = saida)
        } else {
            append(saida, item = ch)
        }
        k += 1
    }
    append(saida, item = "\"")
}

// C: nativo/nativo_json.c:28
// caminho com barra invertida trocada por '/' e depois escapado como texto
pub proc json_caminho(saida: ^[dynamic]u8, caminho: ?str) {
    let s: str = caminho or_else ""
    let total: u64 = len(s) as u64
    var normal: [dynamic]u8 = make([dynamic]u8, alloc = heap)
    defer delete(normal)
    var k: u64 = 0
    while k < total {
        let ch: u8 = s[k]
        if ch == 92 {
            append(&normal, item = "/")
        } else {
            append(&normal, item = ch)
        }
        k += 1
    }
    let texto: str = from_bytes(normal[..], alloc = heap)
    defer delete(texto)
    json_texto(saida, texto, len(texto) as u64)
}

// C: nativo/nativo_json.c:38
// C2F-VOID: dados -> []u8 (porte V4: a Forja nao indexa rawptr; o C le os n bytes apontados)
proc fnv32(h: u32, dados: []u8, n: u64) -> u32 {
    var hash: u32 = h
    var k: u64 = 0
    while k < n {
        hash = wrapping_mul(hash ~ (dados[k] as u32), FNV32_PRIMO)
        k += 1
    }
    return hash
}

// testes: valores conferidos a mao contra nativo_json.c (FNV-1a 32: vazio = 0x811c9dc5, "a" = 0xe40c292c)
test "json_texto escapa aspa, barra e controle" {
    var b: [dynamic]u8 = make([dynamic]u8, alloc = heap)
    defer delete(b)
    json_texto(&b, "a\"\n", 3)
    let s: str = from_bytes(b[..], alloc = heap)
    defer delete(s)
    expect(s == "\"a\\\"\\u000a\"")
}

test "json_caminho troca barra invertida por barra" {
    var b: [dynamic]u8 = make([dynamic]u8, alloc = heap)
    defer delete(b)
    json_caminho(&b, "C:\\x\\y")
    let s: str = from_bytes(b[..], alloc = heap)
    defer delete(s)
    expect(s == "\"C:/x/y\"")
}

test "fnv32 FNV-1a de 32 bits" {
    var b: [dynamic]u8 = make([dynamic]u8, alloc = heap)
    defer delete(b)
    append(&b, item = "a")
    expect(fnv32(FNV32_INICIO, b[..], 0) == 2166136261)
    expect(fnv32(FNV32_INICIO, b[..], 1) == 3826002220)
}
