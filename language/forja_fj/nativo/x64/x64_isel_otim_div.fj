// C: nativo/x64/x64_isel_otim_div.c:275
proc and_constante(c: ^X64Ctx, r: i32, w: u8, imm: i64) -> bool {
    if (imm >= -2147483648) and (imm <= 2147483647) {
        var forma_and: i32 = FX_AND32_RI
        if w == 64 {
            forma_and = FX_AND64_RI
        }
