    }
    let arg_1: MOperando = m_reg(RDX, w)
    let arg_2: MOperando = m_reg(r, w)
    let arg_3: u16 = tern_1 as u16
    return x64_emitir(c as ^X64Ctx, mi2(arg_3, arg_2, arg_1))
}

// C: nativo/x64/x64_isel_otim_div.c:343
proc resto_pot2_sem_sinal(k: ^DivCtx) -> bool {
    let mascara_pot2: i64 = transmute(((1 as u64) << ((k.plano.shift as u64) & 63)) - 1, to = i64)
    k.res = k.trab
    if not mover(k.c as ^X64Ctx, k.trab, k.src, 32) {
        return false
    }
    return x64_emitir(k.c as ^X64Ctx, mi2(FX_AND32_RI as u16, m_reg(k.trab, 32), m_imed(mascara_pot2)))
}

// C: nativo/x64/x64_isel_otim_div.c:352
proc finalizar(k: ^DivCtx, alvo: i32) -> bool {
    let c: ?^X64Ctx = k.c
    let r: i32 = k.res
    if (common.c2f_s2u_32(r) == common.c2f_s2u_32(alvo)) and ((common.c2f_s2u_32(r) == common.c2f_s2u_32(k.src)) or (k.plano.bits >= 32)) {
        return true
    }
    let sw_1 = k.plano.bits
    if sw_1 == 64 {
        return mover(c as ^X64Ctx, alvo, r, 64)
    } else if sw_1 == 32 {
        let arg_1: MOperando = m_reg(r, 32)
        let arg_2: MOperando = m_reg(alvo, 32)
        return x64_emitir(c as ^X64Ctx, mi2(FX_MOV32_RR as u16, arg_2, arg_1))
    } else if sw_1 == 16 {
        let arg_3: MOperando = m_reg(r, 16)
        let arg_4: MOperando = m_reg(alvo, 32)
        return x64_emitir(c as ^X64Ctx, mi2(FX_MOVZX32_RR16 as u16, arg_4, arg_3))
    } else {
        let arg_5: MOperando = m_reg(r, 8)
        let arg_6: MOperando = m_reg(alvo, 32)
        return x64_emitir(c as ^X64Ctx, mi2(FX_MOVZX32_RR8 as u16, arg_6, arg_5))
    }
    return false
}

// C: nativo/x64/x64_isel_otim_div.c:368
proc emitir_resto(k: ^DivCtx) -> bool {
    let e: i32 = k.plano.estrategia
    if (not k.plano.com_sinal) and (common.c2f_s2u_32(e) == (DIV_MAGICA_POT2 as u32)) {
        return resto_pot2_sem_sinal(k)
    }
    if common.c2f_s2u_32(e) == (DIV_MAGICA_SINAL_64 as u32) {
        return resto_sinal64(k)
    }
    if common.c2f_s2u_32(e) == (DIV_MAGICA_SINAL_MUL as u32) {
        return resto_sinal_mul(k)
    }
    if common.c2f_s2u_32(e) == (DIV_MAGICA_POT2_SINAL as u32) {
        return resto_pot2_com_sinal(k)
    }
    return ((common.c2f_b2i32(quociente(k)) != 0) and (common.c2f_b2i32(negar_quociente(k)) != 0)) and (common.c2f_b2i32(resto_do_quociente(k)) != 0)
}

// C: nativo/x64/x64_isel_otim_div.c:383
proc emitir_conta(k: ^DivCtx, alvo: i32) -> bool {
    if k.resto {
        return (common.c2f_b2i32(emitir_resto(k)) != 0) and (common.c2f_b2i32(finalizar(k, alvo)) != 0)
    }
    return ((common.c2f_b2i32(quociente(k)) != 0) and (common.c2f_b2i32(negar_quociente(k)) != 0)) and (common.c2f_b2i32(finalizar(k, alvo)) != 0)
}

// C: nativo/x64/x64_isel_otim_div.c:391
proc planejar_conta(k: ^DivCtx, i: ^bir.BirInstr) -> bool {
    var e: i32 = 0
    if (((((i.classe as i32) < bir.BC_I8) or ((i.classe as i32) > bir.BC_I64)) or ((i.a.classe as i32) != (i.classe as i32))) or ((i.b.classe as i32) != (i.classe as i32))) or (i.a.tipo != (bir.BO_VREG as u8)) {
        return false
    }
    var tern_1: i32 = 32
    if i.classe == (bir.BC_I64 as u8) {
        tern_1 = 64
    }
    k.w = tern_1 as u8
    if not div_magica_planejar(BITS_DA_CLASSE[i.classe] as u32, i.aux == (bir.BIR_SINAL as u8), common.c2f_s2u_64(i.b.imed), &k.plano) {
        return false
    }
    e = k.plano.estrategia
    return not (((not k.plano.com_sinal) and ((common.c2f_s2u_32(e) == (DIV_MAGICA_POT2 as u32)) or (common.c2f_s2u_32(e) == (DIV_MAGICA_UM as u32)))) and (k.plano.bits >= 32))
}

// C: nativo/x64/x64_isel_otim_div.c:405
proc isel_otim_div_const(c: ^X64Ctx, i: ^bir.BirInstr) -> i32 {
    var k: DivCtx = DivCtx{c = c, resto = i.op == (bir.BIR_REM as u8)}
    let destino: i32 = isel_otim_reg_destino(c, i.dst)
    var tern_1: u32 = RAX as u32
    if destino >= 0 {
        tern_1 = common.c2f_s2u_32(destino)
    }
    let alvo: i32 = transmute(tern_1, to = i32)
    if not planejar_conta(&k, i) {
        return 0
    }
    if not carregar_dividendo(&k, i) {
        return -1
    }
    var tern_2: u32 = RAX as u32
    if common.c2f_s2u_32(alvo) != common.c2f_s2u_32(k.src) {
        tern_2 = common.c2f_s2u_32(alvo)
    }
    k.trab = transmute(tern_2, to = i32)
    if not emitir_conta(&k, alvo) {
        return -1
    }
    if (destino < 0) and (not isel_guardar(c, i.dst, RAX)) {
        return -1
    }
    return 1
}

// C: nativo/x64/x64_isel_otim_div.c:424
pub proc x64_div_const_marcar(programa: ^bir.BirPrograma, funcao: ^bir.BirFuncao) {
    funcao.div_const = true
}

// as contas do isel (emissor x64_emitir) ainda sao stub nesta copia: so as funcoes puras ganham teste aqui
test "x64_isel_otim_div: valor_do_divisor e modulo_do_divisor_2 seguem o sinal e a largura da conta" {
    var p = DivMagicaPlano{bits = 8, com_sinal = true, divisor = 254}
    expect(valor_do_divisor(&p, 32) == -2)
    expect(valor_do_divisor(&p, 64) == -2)
    expect(modulo_do_divisor_2(&p) == 2)
    p.com_sinal = false
    expect(valor_do_divisor(&p, 32) == 254)
    p = DivMagicaPlano{bits = 16, com_sinal = true, divisor = 65535}
    expect(valor_do_divisor(&p, 64) == -1)
    expect(modulo_do_divisor_2(&p) == 1)
}
