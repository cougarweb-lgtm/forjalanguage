        return quociente_lemire(k)
    } else if sw_1 == (DIV_MAGICA_SEM_SINAL_64 as u32) {
        return quociente_sem_sinal64(k)
    } else if sw_1 == (DIV_MAGICA_MAIOR_SEM_SINAL as u32) {
        return quociente_comparacao(k, X64_CC_AE)
