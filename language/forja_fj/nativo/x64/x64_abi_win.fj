import "common"
import "nativo/bir"

const REGS_ARGUMENTO: [4]i32 = {1, 2, 8, 9}

// C: nativo/x64/x64_abi_win.c:19
proc classe_inteira(classe: i32) -> bool {
    return (((common.c2f_s2u_32(classe) == (bir.BC_I8 as u32)) or (common.c2f_s2u_32(classe) == (bir.BC_I16 as u32))) or (common.c2f_s2u_32(classe) == (bir.BC_I32 as u32))) or (common.c2f_s2u_32(classe) == (bir.BC_I64 as u32))
}

// C: nativo/x64/x64_abi_win.c:24
proc classe_real(classe: i32) -> bool {
    return bir.bir_classe_eh_real(classe)
}

// C: nativo/x64/x64_abi_win.c:30
proc abi_win_tam_em_registro(tam: u32) -> bool {
    return (((tam == 1) or (tam == 2)) or (tam == 4)) or (tam == 8)
}

// C: nativo/x64/x64_abi_win.c:35
proc argumento_classificavel(a: ^AbiArg) -> bool {
    if a.tam > 0 {
        return common.c2f_s2u_32(a.classe) == (bir.BC_I64 as u32)
    }
    return (common.c2f_b2i32(classe_inteira(a.classe)) != 0) or (common.c2f_b2i32(classe_real(a.classe)) != 0)
}

// C: nativo/x64/x64_abi_win.c:43
proc abi_win_local_do_argumento(a: ^AbiArg, k: u32) -> AbiLocal {
    let real: bool = (a.tam == 0) and (common.c2f_b2i32(classe_real(a.classe)) != 0)
    var local: AbiLocal = AbiLocal{}
    if k < ABI_WIN_REGS_ARG {
        var tern_1: u32 = common.c2f_s2u_32(REGS_ARGUMENTO[k])
        if common.c2f_b2i32(real) != 0 {
            tern_1 = common.c2f_s2u_32(transmute(k, to = i32))
        }
        local = AbiLocal{na_pilha = false, reg = transmute(tern_1, to = i32), desloc = 0}
    } else {
        local = AbiLocal{na_pilha = true, reg = X64_RAX, desloc = transmute(ABI_WIN_SOMBRA + (ABI_WIN_BYTES_ARG * (k - ABI_WIN_REGS_ARG)), to = i32)}
    }
    var tern_2: i32 = 0
    if common.c2f_b2i32(abi_win_tam_em_registro(a.tam)) != 0 {
        tern_2 = (a.tam as u8) as i32
    }
    local.bytes = tern_2 as u8
    return local
}

// C: nativo/x64/x64_abi_win.c:57
// C2F-INDECIDIVEL: saida
// C2F-13: args fundido em n (len)
proc abi_win_classificar(args: []AbiArg, saida: []AbiLocal) -> bool {
    for k in (0 as u32)..<(len(args) as u32) {
        if not argumento_classificavel(&args[k]) {
            return false
        }
        saida[k] = abi_win_local_do_argumento(&args[k], k)
    }
    return true
}

// C: nativo/x64/x64_abi_win.c:67
proc abi_win_retorno(classe: i32, tam: u32) -> i32 {
    if common.c2f_s2u_32(classe) == (bir.BC_NADA as u32) {
        return ABI_RET_VAZIO
    }
    if tam > 0 {
        var tern_1: i32 = ABI_RET_OCULTO
        if common.c2f_b2i32(abi_win_tam_em_registro(tam)) != 0 {
            tern_1 = ABI_RET_RAX
        }
        return tern_1
    }
    var tern_2: i32 = ABI_RET_RAX
    if common.c2f_b2i32(classe_real(classe)) != 0 {
        tern_2 = ABI_RET_XMM0
    }
    return tern_2
}

// C: nativo/x64/x64_abi_win.c:77
proc abi_win_param_rbp(k: u32) -> i32 {
    return transmute(16 + (ABI_WIN_BYTES_ARG * k), to = i32)
}

// C: nativo/x64/x64_abi_win.c:83
proc abi_win_oculto_da_chamada(i: ^bir.BirInstr) -> u32 {
    let agregado: bool = (((i.op == (bir.BIR_CHAMA as u8)) or (i.op == (bir.BIR_CHAMA_IND as u8))) and (i.a.tipo == (bir.BO_VREG as u8))) and (i.a.tam != 0)
    var tern_1: u32 = 0
    if (common.c2f_b2i32(agregado) != 0) and (common.c2f_s2u_32(abi_win_retorno(bir.BC_I64, i.a.tam)) == (ABI_RET_OCULTO as u32)) {
        tern_1 = 1
    }
    return tern_1
}

// C: nativo/x64/x64_abi_win.c:92
proc abi_win_oculto(f: ?^bir.BirFuncao) -> u32 {
    var tern_1: u32 = 0
    if common.c2f_s2u_32(abi_win_retorno((f as ^bir.BirFuncao).retorno as i32, (f as ^bir.BirFuncao).retorno_tam)) == (ABI_RET_OCULTO as u32) {
        tern_1 = 1
    }
    return tern_1
}

// C: nativo/x64/x64_abi_win.c:97
proc abi_win_param_em_bytes(f: ?^bir.BirFuncao, k: u32) -> bool {
    return ((f as ^bir.BirFuncao).param_tam != none) and (common.c2f_b2i32(abi_win_tam_em_registro(((f as ^bir.BirFuncao).param_tam or_else {})[k])) != 0)
}

// C: nativo/x64/x64_abi_win.c:102
proc abi_win_ordem_em_bytes(f: ?^bir.BirFuncao, k: u32) -> u32 {
