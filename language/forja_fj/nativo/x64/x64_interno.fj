pub proc arena_fatia_abi_arg(a: ^common.Arena, n: int) -> []AbiArg {
    var l = make([dynamic]AbiArg, alloc = common.arena_mem(a), cap = n)
    for i in 0..<n {
        append(&l, item = AbiArg{})
    }
    return l[..]
}

pub proc arena_fatia_abi_local(a: ^common.Arena, n: int) -> []AbiLocal {
    var l = make([dynamic]AbiLocal, alloc = common.arena_mem(a), cap = n)
    for i in 0..<n {
        append(&l, item = AbiLocal{})
    }
    return l[..]
}

pub const ISEL_FN_ISEL_ARITMETICA: u16 = 1
pub const ISEL_FN_ISEL_OV: u16 = 2
pub const ISEL_FN_ISEL_CMP: u16 = 3
pub const ISEL_FN_ISEL_NEG: u16 = 4
pub const ISEL_FN_ISEL_MOVER: u16 = 5
pub const ISEL_FN_ISEL_EXTENSAO_SINAL: u16 = 6
pub const ISEL_FN_ISEL_EXTENSAO_ZERO: u16 = 7
pub const ISEL_FN_ISEL_END_SIMBOLO: u16 = 8
pub const ISEL_FN_ISEL_DIVISAO: u16 = 9
pub const ISEL_FN_ISEL_DESLOCAMENTO: u16 = 10
pub const ISEL_FN_ISEL_NOT: u16 = 11
pub const ISEL_FN_ISEL_CHAMA: u16 = 12
pub const ISEL_FN_ISEL_ARMADILHA: u16 = 13
pub const ISEL_FN_ISEL_SALTA: u16 = 14
pub const ISEL_FN_ISEL_DESVIA: u16 = 15
pub const ISEL_FN_ISEL_RETORNA: u16 = 16
pub const ISEL_FN_ISEL_END_SLOT: u16 = 17
pub const ISEL_FN_ISEL_CARREGA: u16 = 18
pub const ISEL_FN_ISEL_GRAVA: u16 = 19
pub const ISEL_FN_ISEL_COPIA_MEM: u16 = 20
pub const ISEL_FN_ISEL_ZERA_MEM: u16 = 21
pub const ISEL_FN_ISEL_SELECIONA: u16 = 22
pub const ISEL_FN_ISEL_I_PARA_F: u16 = 23
pub const ISEL_FN_ISEL_RAIZ: u16 = 24
pub const ISEL_FN_ISEL_SPLAT: u16 = 25
pub const ISEL_FN_ISEL_F_PARA_F: u16 = 26
pub proc chamar_isel_fn(tag: u16, c: ^X64Ctx, i: ^bir.BirInstr) -> bool {
    if tag == 1 {
        return isel_aritmetica(c, i)
    }
    if tag == 2 {
        return isel_ov(c, i)
    }
    if tag == 3 {
        return isel_cmp(c, i)
    }
    if tag == 4 {
        return isel_neg(c, i)
    }
    if tag == 5 {
        return isel_mover(c, i)
    }
    if tag == 6 {
        return isel_extensao_sinal(c, i)
    }
    if tag == 7 {
        return isel_extensao_zero(c, i)
    }
    if tag == 8 {
        return isel_end_simbolo(c, i)
    }
    if tag == 9 {
        return isel_divisao(c, i)
    }
    if tag == 10 {
        return isel_deslocamento(c, i)
    }
    if tag == 11 {
        return isel_not(c, i)
    }
    if tag == 12 {
        return isel_chama(c, i)
    }
    if tag == 13 {
        return isel_armadilha(c, i)
    }
    if tag == 14 {
        return isel_salta(c, i)
    }
    if tag == 15 {
        return isel_desvia(c, i)
    }
    if tag == 16 {
        return isel_retorna(c, i)
    }
    if tag == 17 {
        return isel_end_slot(c, i)
    }
    if tag == 18 {
        return isel_carrega(c, i)
    }
    if tag == 19 {
        return isel_grava(c, i)
    }
    if tag == 20 {
        return isel_copia_mem(c, i)
    }
    if tag == 21 {
        return isel_zera_mem(c, i)
    }
    if tag == 22 {
        return isel_seleciona(c, i)
    }
    if tag == 23 {
        return isel_i_para_f(c, i)
    }
    if tag == 24 {
        return isel_raiz(c, i)
    }
    if tag == 25 {
        return isel_splat(c, i)
    }
    if tag == 26 {
        return isel_f_para_f(c, i)
    }
    // C2F: o C nao chama fn NULL (X64Selecionar checa antes); tag fora de 1..26 vira o mesmo X64SemRegra, sem o numero do op
    return x64_sem_regra(c, "fn", "tag de isel fora da tabela REGRAS_ISEL")
}

// C: nativo/x64/x64_interno.h:122
proc m_reg(reg: i32, largura: u8) -> MOperando {
    var o: MOperando = MOperando{tipo = 0}
    o.tipo = MO_REG
    o.base = reg
    o.largura = largura
    return o
}

// C: nativo/x64/x64_interno.h:131
proc m_mem(base: i32, desloc: i32, largura: u8) -> MOperando {
    var o: MOperando = m_reg(base, largura)
    o.tipo = MO_MEM
    o.desloc = desloc
    return o
}

// C: nativo/x64/x64_interno.h:139
proc m_xmm(numero: u8) -> MOperando {
    var o: MOperando = MOperando{tipo = 0}
    o.tipo = MO_XMM
    o.base = numero as i32
    o.largura = 128
    return o
}

// C: nativo/x64/x64_interno.h:148
proc m_imed(valor: i64) -> MOperando {
    var o: MOperando = MOperando{tipo = 0}
