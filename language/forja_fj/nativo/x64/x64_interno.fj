}

// C: nativo/x64/x64_interno.h:172
proc mi0(forma: u16) -> MInstr {
    var mi: MInstr = MInstr{forma = 0}
    mi.forma = forma
    return mi
}

// C: nativo/x64/x64_interno.h:179
proc mi1(forma: u16, a: MOperando) -> MInstr {
    var mi: MInstr = mi0(forma)
    mi.nops = 1
    mi.op[0] = a
    return mi
}

// C: nativo/x64/x64_interno.h:187
proc mi2(forma: u16, a: MOperando, b: MOperando) -> MInstr {
    var mi: MInstr = mi1(forma, a)
    mi.nops = 2
    mi.op[1] = b
    return mi
}

// C: nativo/x64/x64_interno.h:195
proc mi3(forma: u16, a: MOperando, b: MOperando, c: MOperando) -> MInstr {
    var mi: MInstr = mi2(forma, a, b)
    mi.nops = 3
    mi.op[2] = c
    return mi
}

// C: nativo/x64/x64_interno.h:203
proc mi_cc(forma: u16, cond: i32, a: MOperando) -> MInstr {
    var mi: MInstr = mi1(forma, a)
    mi.cond = cond
    return mi
}
