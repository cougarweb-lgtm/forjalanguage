import "common"

struct IntervaloVreg {
    inicio: u32
    fim: u32
    peso: u64
    elegivel: bool
    real: bool
    cruza_chamada: bool
    def_em_laco: bool
    carregada: bool
    regra_antiga: bool
}

struct Intervalos {
    arena: ?^common.Arena
    nvregs: u32
    npos: u32
    iv: ?[]IntervaloVreg
    chamadas_ate: ?[]u32
    tem_sysv: bool
}

const REGALLOC_SEM_POS: u32 = 4294967295

pub proc arena_fatia_intervalo_vreg(a: ^common.Arena, n: int) -> []IntervaloVreg {
    var l = make([dynamic]IntervaloVreg, alloc = common.arena_mem(a), cap = n)
    for i in 0..<n {
        append(&l, item = IntervaloVreg{})
    }
    return l[..]
}
