import "common"
import "nativo/bir"

struct Cadeia {
    base: i32
    indice: i32
    escala: u8
    desloc: i64
    instrucoes: u32
}

const SEM_INDICE: i32 = -1

// C: nativo/x64/x64_isel_otim_mem.c:25
proc adiante(bloco: ^bir.BirBloco, k: u32, d: u32) -> ?^bir.BirInstr {
    var tern_1: ?^bir.BirInstr = none
    if (k + d) < bloco.n {
        tern_1 = &bloco.instrs[k + d]
    }
    return tern_1
}

// C: nativo/x64/x64_isel_otim_mem.c:30
proc temp_i64(c: ^X64Ctx, vreg: u32) -> bool {
    return ((vreg < (c.f as ^bir.BirFuncao).nvregs) and (((c.f as ^bir.BirFuncao).classe_vreg or_else {})[vreg] == (bir.BC_I64 as u8))) and (common.c2f_b2i32(isel_otim_temp_unico(c, vreg)) != 0)
}

// C: nativo/x64/x64_isel_otim_mem.c:35
proc eh_op64(i: ?^bir.BirInstr, op: u8) -> bool {
    return ((((i != none) and (((i as ^bir.BirInstr).op as i32) == (op as i32))) and ((i as ^bir.BirInstr).classe == (bir.BC_I64 as u8))) and ((i as ^bir.BirInstr).a.classe == (bir.BC_I64 as u8))) and ((i as ^bir.BirInstr).b.classe == (bir.BC_I64 as u8))
}

// C: nativo/x64/x64_isel_otim_mem.c:40
proc usa_temp(o: ?^bir.BirOperando, t: u32) -> bool {
    return ((o as ^bir.BirOperando).tipo == (bir.BO_VREG as u8)) and ((o as ^bir.BirOperando).id == t)
}

// C: nativo/x64/x64_isel_otim_mem.c:46
proc casar_mul_escala(c: ^X64Ctx, i: ?^bir.BirInstr, indice: ^i32, escala: ^u8) -> bool {
    if not eh_op64(i, bir.BIR_MUL as u8) {
        return false
    }
    let ins: ^bir.BirInstr = i as ^bir.BirInstr
    // C: o imediato e b quando b e imediato; senao a. O outro lado e o operando vivo.
    var imediato: ^bir.BirOperando = &ins.a
    var outro: ^bir.BirOperando = &ins.b
    if ins.b.tipo == (bir.BO_IMED as u8) {
        imediato = &ins.b
        outro = &ins.a
    }
    let s: i64 = imediato.imed
    if (not temp_i64(c, ins.dst)) or (imediato.tipo != (bir.BO_IMED as u8)) or (outro.tipo != (bir.BO_VREG as u8)) {
        return false
    }
    if (s != 1) and (s != 2) and (s != 4) and (s != 8) {
        return false
    }
    indice^ = isel_otim_reg_int(c, outro)
    escala^ = s as u8
    return indice^ >= 0
}

// C: nativo/x64/x64_isel_otim_mem.c:62
proc outro_da_soma(soma: ?^bir.BirInstr, t: u32) -> ?^bir.BirOperando {
    if (common.c2f_b2i32(usa_temp(&(soma as ^bir.BirInstr).a, t)) != 0) and (not usa_temp(&(soma as ^bir.BirInstr).b, t)) {
        return &(soma as ^bir.BirInstr).b
    }
    var tern_1: ?^bir.BirOperando = none
    if (common.c2f_b2i32(usa_temp(&(soma as ^bir.BirInstr).b, t)) != 0) and (not usa_temp(&(soma as ^bir.BirInstr).a, t)) {
        tern_1 = &(soma as ^bir.BirInstr).a
    }
    return tern_1
}

// C: nativo/x64/x64_isel_otim_mem.c:70
proc base_eh_temp(mem_c: ?^bir.BirInstr, t: u32) -> bool {
    return (((mem_c != none) and (((mem_c as ^bir.BirInstr).op == (bir.BIR_CARREGA as u8)) or ((mem_c as ^bir.BirInstr).op == (bir.BIR_GRAVA as u8)))) and (common.c2f_b2i32(usa_temp(&(mem_c as ^bir.BirInstr).a, t)) != 0)) and (not (((mem_c as ^bir.BirInstr).op == (bir.BIR_GRAVA as u8)) and (common.c2f_b2i32(usa_temp(&(mem_c as ^bir.BirInstr).b, t)) != 0)))
}

// C: nativo/x64/x64_isel_otim_mem.c:76
proc casar_soma_imediata(c: ^X64Ctx, i: ?^bir.BirInstr, base: ^i32, desloc: ^i64) -> bool {
    if not eh_op64(i, bir.BIR_ADD as u8) {
        return false
    }
    let ins: ^bir.BirInstr = i as ^bir.BirInstr
    var imediato: ^bir.BirOperando = &ins.a
    var outro: ^bir.BirOperando = &ins.b
    if ins.b.tipo == (bir.BO_IMED as u8) {
        imediato = &ins.b
        outro = &ins.a
    }
    if (not temp_i64(c, ins.dst)) or (imediato.tipo != (bir.BO_IMED as u8)) or (outro.tipo != (bir.BO_VREG as u8)) {
        return false
    }
    if (imediato.imed < (((-2147483647) - 1) as i64)) or (imediato.imed > 2147483647) {
        return false
    }
    base^ = isel_otim_reg_int(c, outro)
    desloc^ = imediato.imed
    return base^ >= 0
}

// C: nativo/x64/x64_isel_otim_mem.c:91
proc casar_forma_a(c: ^X64Ctx, bloco: ^bir.BirBloco, k: u32, r: ^Cadeia) -> bool {
    let mul: ?^bir.BirInstr = adiante(bloco, k, 0)
    let soma: ?^bir.BirInstr = adiante(bloco, k + 1, 0)
    let mem_c: ?^bir.BirInstr = adiante(bloco, k + 2, 0)
    var x: ?^bir.BirOperando = none
    var base: i32 = 0
    if ((((soma == none) or (mem_c == none)) or (not casar_mul_escala(c, mul, &r.indice, &r.escala))) or (not eh_op64(soma, bir.BIR_ADD as u8))) or (not temp_i64(c, (soma as ^bir.BirInstr).dst)) {
        return false
    }
    x = outro_da_soma(soma, (mul as ^bir.BirInstr).dst)
    var tern_1: i32 = -1
    if (x != none) and ((x as ^bir.BirOperando).tipo == (bir.BO_VREG as u8)) {
        tern_1 = isel_otim_reg_int(c, x)
    }
    base = tern_1
    if (base < 0) or (not base_eh_temp(mem_c, (soma as ^bir.BirInstr).dst)) {
        return false
    }
    r.base = base
    r.desloc = 0
    r.instrucoes = 3
    return true
}

// C: nativo/x64/x64_isel_otim_mem.c:110
proc casar_forma_b(c: ^X64Ctx, bloco: ^bir.BirBloco, k: u32, r: ^Cadeia) -> bool {
    let s0: ?^bir.BirInstr = adiante(bloco, k, 0)
    let mul: ?^bir.BirInstr = adiante(bloco, k + 1, 0)
    let soma: ?^bir.BirInstr = adiante(bloco, k + 2, 0)
    let mem_c: ?^bir.BirInstr = adiante(bloco, k + 3, 0)
    var outro: ?^bir.BirOperando = none
    var base: i32 = 0
    if ((((mul == none) or (soma == none)) or (mem_c == none)) or (not casar_soma_imediata(c, s0, &base, &r.desloc))) or (not casar_mul_escala(c, mul, &r.indice, &r.escala)) {
        return false
    }
    if ((not eh_op64(soma, bir.BIR_ADD as u8)) or (not temp_i64(c, (soma as ^bir.BirInstr).dst))) or (not base_eh_temp(mem_c, (soma as ^bir.BirInstr).dst)) {
        return false
    }
    outro = outro_da_soma(soma, (s0 as ^bir.BirInstr).dst)
    if (outro == none) or (not usa_temp(outro, (mul as ^bir.BirInstr).dst)) {
        return false
    }
    r.base = base
    r.instrucoes = 4
    return true
}

// C: nativo/x64/x64_isel_otim_mem.c:129
proc casar_forma_cd(c: ^X64Ctx, bloco: ^bir.BirBloco, k: u32, r: ^Cadeia) -> bool {
    let soma: ?^bir.BirInstr = adiante(bloco, k, 0)
    let mem_c: ?^bir.BirInstr = adiante(bloco, k + 1, 0)
    var base: i32 = 0
    var y: i32 = 0
    if (((mem_c == none) or (not eh_op64(soma, bir.BIR_ADD as u8))) or (not temp_i64(c, (soma as ^bir.BirInstr).dst))) or (not base_eh_temp(mem_c, (soma as ^bir.BirInstr).dst)) {
        return false
    }
    r.instrucoes = 2
    r.indice = SEM_INDICE
    r.escala = 0
    if casar_soma_imediata(c, soma, &base, &r.desloc) {
        r.base = base
        return true
    }
    var tern_1: i32 = -1
    if (soma as ^bir.BirInstr).a.tipo == (bir.BO_VREG as u8) {
        tern_1 = isel_otim_reg_int(c, &(soma as ^bir.BirInstr).a)
    }
    base = tern_1
    var tern_2: i32 = -1
    if (soma as ^bir.BirInstr).b.tipo == (bir.BO_VREG as u8) {
        tern_2 = isel_otim_reg_int(c, &(soma as ^bir.BirInstr).b)
    }
    y = tern_2
    if (base < 0) or (y < 0) {
        return false
    }
    r.base = base
    r.indice = y
    r.escala = 1
    r.desloc = 0
    return true
}

// C: nativo/x64/x64_isel_otim_mem.c:154
proc casar_cadeia(c: ^X64Ctx, bloco: ^bir.BirBloco, k: u32, r: ^Cadeia) -> bool {
    let i: ^bir.BirInstr = &bloco.instrs[k]
    if i.op == (bir.BIR_MUL as u8) {
        return casar_forma_a(c, bloco, k, r)
    }
    if i.op != (bir.BIR_ADD as u8) {
        return false
    }
    return (common.c2f_b2i32(casar_forma_b(c, bloco, k, r)) != 0) or (common.c2f_b2i32(casar_forma_cd(c, bloco, k, r)) != 0)
}

// C: nativo/x64/x64_isel_otim_mem.c:168
proc bits_do_acesso(mem_c: ^bir.BirInstr) -> u8 {
    var tern_1: i32 = 0
    if mem_c.op == (bir.BIR_CARREGA as u8) {
        tern_1 = aloc_bits(mem_c.classe) as i32
    } else {
        tern_1 = aloc_bits(mem_c.b.classe) as i32
    }
    return tern_1 as u8
}

// C: nativo/x64/x64_isel_otim_mem.c:174
proc montar_memoria(c: ^X64Ctx, mem_c: ^bir.BirInstr, cadeia: ?^Cadeia, saida: ^MOperando) -> bool {
    let bits: u8 = bits_do_acesso(mem_c)
    var base: i32 = 0
    var ok: bool = false
    if cadeia != none {
        let total: i64 = (cadeia as ^Cadeia).desloc + (mem_c.desloc as i64)
        if (total < (((-2147483647) - 1) as i64)) or (total > 2147483647) {
            return false
        }
        saida^ = m_mem((cadeia as ^Cadeia).base, total as i32, bits)
        if (cadeia as ^Cadeia).indice != SEM_INDICE {
            saida.indice = (cadeia as ^Cadeia).indice
            saida.escala = (cadeia as ^Cadeia).escala
        }
        return isel_otim_encodavel(saida)
    }
    base = isel_otim_fonte(c, &mem_c.a, X64_RCX, &ok)
    saida^ = m_mem(base, mem_c.desloc, bits)
    return ok
}

// C: nativo/x64/x64_isel_otim_mem.c:198
proc forma_de_carga(bits: u8, largura_reg: ^u8) -> u16 {
    var tern_1: i32 = 32
    if bits == 64 {
        tern_1 = 64
    }
    largura_reg^ = tern_1 as u8
    let sw_1 = bits as i32
    if sw_1 == 64 {
        return FX_MOV64_RM as u16
    } else if sw_1 == 32 {
        return FX_MOV32_RM as u16
    } else if sw_1 == 16 {
        return FX_MOVZX32_RM16 as u16
    } else {
        return FX_MOVZX32_RM8 as u16
    }
    return 0
}

// C: nativo/x64/x64_isel_otim_mem.c:209
proc forma_de_gravacao(bits: u8) -> u16 {
    let sw_1 = bits as i32
    if sw_1 == 64 {
        return FX_MOV64_MR as u16
    } else if sw_1 == 32 {
        return FX_MOV32_MR as u16
    } else if sw_1 == 16 {
        return FX_MOV16_MR as u16
    } else {
        return FX_MOV8_MR as u16
    }
    return 0
}

// C: nativo/x64/x64_isel_otim_mem.c:219
proc emitir_carga(c: ^X64Ctx, i: ^bir.BirInstr, origem: MOperando) -> bool {
    let bits: u8 = aloc_bits(i.classe)
    var largura: u8 = 0
    let xmm: i32 = isel_otim_reg_xmm_destino(c, i.dst)
    let reg: i32 = isel_otim_reg_destino(c, i.dst)
    var tern_1: u32 = X64_RAX as u32
    if reg >= 0 {
        tern_1 = common.c2f_s2u_32(reg)
    }
    let alvo: i32 = transmute(tern_1, to = i32)
    var forma: u16 = 0
    if bir.bir_classe_eh_real(i.classe as i32) {
        var tern_2: i32 = 0
        if xmm >= 0 {
            tern_2 = (xmm as u8) as i32
        }
        let destino: u8 = tern_2 as u8
        var tern_3: i32 = FX_MOVSS_XM
        if i.classe == (bir.BC_F64 as u8) {
            tern_3 = FX_MOVSD_XM
        }
        let arg_1: MOperando = origem
        let arg_2: MOperando = m_xmm(destino)
        let arg_3: u16 = tern_3 as u16
        if not x64_emitir(c, mi2(arg_3, arg_2, arg_1)) {
            return false
        }
        return (xmm >= 0) or (common.c2f_b2i32(isel_guardar_real(c, i.dst, 0)) != 0)
    }
    forma = forma_de_carga(bits, &largura)
    if not x64_emitir(c, mi2(forma, m_reg(alvo, largura), origem)) {
        return false
    }
    return (reg >= 0) or (common.c2f_b2i32(isel_guardar(c, i.dst, X64_RAX)) != 0)
}

// C: nativo/x64/x64_isel_otim_mem.c:240
proc emitir_gravacao(c: ^X64Ctx, i: ^bir.BirInstr, destino: MOperando) -> bool {
    let bits: u8 = aloc_bits(i.b.classe)
    if bir.bir_classe_eh_real(i.b.classe as i32) {
        let xmm: i32 = isel_otim_reg_xmm(c, &i.b)
        if (xmm < 0) and (not isel_carregar_real(c, 0, &i.b)) {
            return false
        }
        var xmm_fonte: u8 = 0
        if xmm >= 0 {
            xmm_fonte = xmm as u8
        }
        return isel_guardar_xmm(c, i.b.classe, destino, xmm_fonte)
    }
    var ok: bool = false
    let fonte: i32 = isel_otim_fonte(c, &i.b, X64_RAX, &ok)
    if not ok {
        return false
    }
    return x64_emitir(c, mi2(forma_de_gravacao(bits), destino, m_reg(fonte, bits)))
}

// C: nativo/x64/x64_isel_otim_mem.c:258
proc emitir_carga_vetor(c: ^X64Ctx, i: ^bir.BirInstr, origem: MOperando) -> bool {
    let xmm: i32 = isel_otim_reg_xmm_destino(c, i.dst)
    var tern_1: i32 = 0
    if xmm >= 0 {
        tern_1 = (xmm as u8) as i32
    }
    if not x64_emitir(c, mi2(FX_MOVUPS_XM as u16, m_xmm(tern_1 as u8), origem)) {
        return false
    }
    return (xmm >= 0) or (common.c2f_b2i32(isel_guardar_vetor(c, i.dst, 0)) != 0)
}

// C: nativo/x64/x64_isel_otim_mem.c:268
proc emitir_gravacao_vetor(c: ^X64Ctx, i: ^bir.BirInstr, destino: MOperando) -> bool {
    let xmm: i32 = isel_otim_reg_xmm(c, &i.b)
    if (xmm < 0) and (not isel_carregar_vetor(c, 0, i.b.id)) {
        return false
    }
    var tern_1: i32 = 0
    if xmm >= 0 {
        tern_1 = (xmm as u8) as i32
    }
    return x64_emitir(c, mi2(FX_MOVUPS_MX as u16, destino, m_xmm(tern_1 as u8)))
}

// C: nativo/x64/x64_isel_otim_mem.c:278
// C: emitir_memoria(c, mem, cadeia, n). Aqui o n sai do cadeia (1 sem cadeia). Com cadeia, c->instr = mem e
// feito como fatia do bloco (bloco + mem_idx): guardar o ponteiro do proprio mem aqui faz o E0706 cair no caller
// de despachar_uma (local de tentar_destino_fundido). LIMITE: 5 parametros (bloco e mem_idx so existem para c->instr).
proc emitir_memoria(c: ^X64Ctx, mem_c: ^bir.BirInstr, cadeia: ?^Cadeia, bloco: ?^bir.BirBloco, mem_idx: int) -> i32 {
    var saida: MOperando = MOperando{tipo = 0}
    var n: u32 = 1
    if cadeia != none {
        n = (cadeia as ^Cadeia).instrucoes
    }
    if (bits_do_acesso(mem_c) == 0) or (not montar_memoria(c, mem_c, cadeia, &saida)) {
        if cadeia == none {
            return -1
        }
        return 0
    }
    if cadeia != none {
        let do_bloco: ^bir.BirBloco = bloco as ^bir.BirBloco
        c.instr = do_bloco.instrs[mem_idx..<(mem_idx + 1)]
        c.instr_idx = mem_idx
    }
    if mem_c.op == (bir.BIR_CARREGA as u8) {
        var ok_carga: bool = false
        if mem_c.classe == (bir.BC_V128 as u8) {
            ok_carga = emitir_carga_vetor(c, mem_c, saida)
        } else {
            ok_carga = emitir_carga(c, mem_c, saida)
        }
        if ok_carga {
            return n as i32
        }
        return -1
    }
    var ok_grava: bool = false
    if mem_c.b.classe == (bir.BC_V128 as u8) {
        ok_grava = emitir_gravacao_vetor(c, mem_c, saida)
    } else {
        ok_grava = emitir_gravacao(c, mem_c, saida)
    }
    if ok_grava {
        return n as i32
    }
    return -1
}

// C: nativo/x64/x64_isel_otim_mem.c:291
proc isel_otim_carrega_simples(c: ^X64Ctx, i: ^bir.BirInstr) -> i32 {
    return emitir_memoria(c, i, none, none, 0)
}

// C: nativo/x64/x64_isel_otim_mem.c:297
proc isel_otim_memoria(c: ^X64Ctx, bloco: ^bir.BirBloco, k: u32) -> i32 {
    let i: ^bir.BirInstr = &bloco.instrs[k]
    var cadeia: Cadeia = Cadeia{base = 0}
    if (i.op == (bir.BIR_CARREGA as u8)) or (i.op == (bir.BIR_GRAVA as u8)) {
        return emitir_memoria(c, i, none, none, 0)
    }
    if not casar_cadeia(c, bloco, k, &cadeia) {
        return 0
    }
    let fim: u32 = (k + cadeia.instrucoes) - 1
    return emitir_memoria(c, &bloco.instrs[fim], &cadeia, bloco, fim as int)
}

// C: nativo/x64/x64_isel_otim_mem.c:311
proc isel_otim_end_simbolo(c: ^X64Ctx, i: ^bir.BirInstr) -> i32 {
    let destino: i32 = isel_otim_reg_destino(c, i.dst)
    if (destino < 0) or (((c.f as ^bir.BirFuncao).classe_vreg or_else {})[i.dst] != (bir.BC_I64 as u8)) {
        return 0
    }
    var alvo: MOperando = m_mem(X64_RIP, 0, 64)
    alvo.simbolo = c.obj_sim[i.a.id]
    if x64_emitir(c, mi2(FX_LEA64_RM as u16, m_reg(destino, 64), alvo)) {
        return 1
    }
    return -1
}

// C: nativo/x64/x64_isel_otim_mem.c:322
proc isel_otim_end_slot(c: ^X64Ctx, i: ^bir.BirInstr) -> i32 {
    let destino: i32 = isel_otim_reg_destino(c, i.dst)
    if (destino < 0) or (((c.f as ^bir.BirFuncao).classe_vreg or_else {})[i.dst] != (bir.BC_I64 as u8)) {
        return 0
    }
    // slot_off[imed]: o indice do slot e nao negativo (vem do alocador), entao o cast nao muda o valor
    let desloc: i32 = -((c.slot_off[i.a.imed as u32]) as i32)
    if x64_emitir(c, mi2(FX_LEA64_RM as u16, m_reg(destino, 64), m_mem(X64_RBP, desloc, 64))) {
        return 1
    }
    return -1
}
