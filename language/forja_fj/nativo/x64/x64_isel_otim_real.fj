import "common"
import "nativo/bir"

const XMM_A: u32 = 0
const XMM_B: u32 = 1

// C: nativo/x64/x64_isel_otim_real.c:17
proc xmm_fonte(c: ^X64Ctx, o: ^bir.BirOperando, rascunho: u8, ok: ^bool) -> u8 {
    let x: i32 = isel_otim_reg_xmm(c, o)
    if x >= 0 {
        ok^ = true
        return x as u8
    }
    ok^ = isel_carregar_real(c, rascunho, o)
    return rascunho
}

// C: nativo/x64/x64_isel_otim_real.c:30
proc xmm_carregar_em(c: ^X64Ctx, xmm: u8, o: ^bir.BirOperando) -> bool {
    if isel_otim_reg_xmm(c, o) == (xmm as i32) {
        return true
    }
    return isel_carregar_real(c, xmm, o)
}

// C: nativo/x64/x64_isel_otim_real.c:37
proc xmm_do_resultado(c: ^X64Ctx, dst: u32) -> u8 {
    let x: i32 = isel_otim_reg_xmm_destino(c, dst)
    var tern_1: i32 = 0
    if x >= 0 {
        tern_1 = (x as u8) as i32
    }
    return tern_1 as u8
}

// C: nativo/x64/x64_isel_otim_real.c:45
proc fechar_real(c: ^X64Ctx, dst: u32, xmm: u8, ok: bool) -> i32 {
    if not ok {
        return -1
    }
    if xmm != (XMM_A as u8) {
        return 1
    }
    var tern_1: i32 = -1
    if common.c2f_b2i32(isel_guardar_real(c, dst, XMM_A as u8)) != 0 {
        tern_1 = 1
    }
    return tern_1
}

// C: nativo/x64/x64_isel_otim_real.c:56
proc forma_da_conta(op: u8, dupla: bool) -> u16 {
    let sw_1 = op as i32
    if sw_1 == bir.BIR_ADD {
        var tern_1: i32 = FX_ADDSS_XX
        if common.c2f_b2i32(dupla) != 0 {
            tern_1 = FX_ADDSD_XX
        }
        return tern_1 as u16
    } else if sw_1 == bir.BIR_SUB {
        var tern_2: i32 = FX_SUBSS_XX
        if common.c2f_b2i32(dupla) != 0 {
            tern_2 = FX_SUBSD_XX
        }
        return tern_2 as u16
    } else if sw_1 == bir.BIR_MUL {
        var tern_3: i32 = FX_MULSS_XX
        if common.c2f_b2i32(dupla) != 0 {
            tern_3 = FX_MULSD_XX
        }
        return tern_3 as u16
    } else {
        var tern_4: i32 = FX_DIVSS_XX
        if common.c2f_b2i32(dupla) != 0 {
            tern_4 = FX_DIVSD_XX
        }
        return tern_4 as u16
    }
    return 0
}

// C: nativo/x64/x64_isel_otim_real.c:66
proc conta_real(c: ^X64Ctx, i: ^bir.BirInstr) -> i32 {
    var a: ?^bir.BirOperando = &i.a
    var b: ?^bir.BirOperando = &i.b
    var d: u8 = xmm_do_resultado(c, i.dst)
    var xb: u8 = 0
    let comutativa: bool = (i.op == (bir.BIR_ADD as u8)) or (i.op == (bir.BIR_MUL as u8))
    var ok: bool = false
    if ((d != (XMM_A as u8)) and (isel_otim_reg_xmm(c, b as ^bir.BirOperando) == (d as i32))) and (not ((((a as ^bir.BirOperando).tipo == (bir.BO_VREG as u8)) and ((b as ^bir.BirOperando).tipo == (bir.BO_VREG as u8))) and ((a as ^bir.BirOperando).id == (b as ^bir.BirOperando).id))) {
        if comutativa {
            a = &i.b
            b = &i.a
        } else {
            d = XMM_A as u8
        }
    }
    if not xmm_carregar_em(c, d, a as ^bir.BirOperando) {
        return -1
    }
    xb = xmm_fonte(c, b as ^bir.BirOperando, XMM_B as u8, &ok)
    if not ok {
        return -1
    }
    let arg_1: MOperando = m_xmm(xb)
    let arg_2: MOperando = m_xmm(d)
    let arg_3: u16 = forma_da_conta(i.op, i.classe == (bir.BC_F64 as u8))
    let arg_4: bool = x64_emitir(c, mi2(arg_3, arg_2, arg_1))
    let arg_5: u8 = d
    let arg_6: u32 = i.dst
    let arg_7: ^X64Ctx = c
    return fechar_real(arg_7, arg_6, arg_5, arg_4)
}

// C: nativo/x64/x64_isel_otim_real.c:89
proc neg_real(c: ^X64Ctx, i: ^bir.BirInstr) -> i32 {
    // -a = a xor mascara de sinal em .rdata; o endereco passa por rax ([rip+d] so existe no LEA)
    let d: u8 = xmm_do_resultado(c, i.dst)
    var mascara: MOperando = m_mem(X64_RIP, 0, 64)
    mascara.simbolo = c.obj_sim[i.b.id]
    if not xmm_carregar_em(c, d, &i.a) {
        return -1
    }
    if not x64_emitir(c, mi2(FX_LEA64_RM as u16, m_reg(X64_RAX, 64), mascara)) {
        return -1
    }
    let ok_xor: bool = x64_emitir(c, mi2(FX_XORPS_XM as u16, m_xmm(d), m_mem(X64_RAX, 0, 128)))
    return fechar_real(c, i.dst, d, ok_xor)
}

// C: nativo/x64/x64_isel_otim_real.c:100
proc raiz_real(c: ^X64Ctx, i: ^bir.BirInstr) -> i32 {
    let d: u8 = xmm_do_resultado(c, i.dst)
    var x: u8 = 0
    var ok: bool = false
    x = xmm_fonte(c, &i.a, d, &ok)
    if not ok {
        return -1
    }
    var tern_1: i32 = FX_SQRTSS_XX
    if i.classe == (bir.BC_F64 as u8) {
        tern_1 = FX_SQRTSD_XX
    }
    let arg_1: MOperando = m_xmm(x)
    let arg_2: MOperando = m_xmm(d)
    let arg_3: u16 = tern_1 as u16
    let arg_4: bool = x64_emitir(c, mi2(arg_3, arg_2, arg_1))
    let arg_5: u8 = d
    let arg_6: u32 = i.dst
    let arg_7: ^X64Ctx = c
    return fechar_real(arg_7, arg_6, arg_5, arg_4)
}

// C: nativo/x64/x64_isel_otim_real.c:112
proc mover_real(c: ^X64Ctx, i: ^bir.BirInstr) -> i32 {
    let x: i32 = isel_otim_reg_xmm_destino(c, i.dst)
    var zero: bool = false
    if i.a.tipo == (bir.BO_IMED as u8) {
        // C: F64 compara o imediato inteiro; F32 so os 32 bits baixos
        if i.classe == (bir.BC_F64 as u8) {
            zero = i.a.imed == 0
        } else {
            zero = common.c2f_trunc_i32(common.c2f_s2u_64(i.a.imed)) == 0
        }
    }
    if (x < 0) or ((i.op != (bir.BIR_CONST as u8)) and (i.op != (bir.BIR_COPIA as u8))) or (i.a.classe != i.classe) {
        return 0
    }
    if zero {
        if x64_emitir(c, mi2(FX_XORPS_XX as u16, m_xmm(x as u8), m_xmm(x as u8))) {
            return 1
        }
        return -1
    }
    if xmm_carregar_em(c, x as u8, &i.a) {
        return 1
    }
    return -1
}

// C: nativo/x64/x64_isel_otim_real.c:126
// SELECIONA real no padrao minss/maxss: d = primeiro; d = min/max d, segundo. Se o segundo mora no xmm do dst, calcula em xmm0 e guarda.
proc isel_otim_seleciona_real(c: ^X64Ctx, i: ^bir.BirInstr) -> bool {
    var maximo: bool = false
    var primeiro: ?^bir.BirOperando = none
    var segundo: ?^bir.BirOperando = none
    if not bir.bir_seleciona_min_max(i, &maximo, &primeiro, &segundo) {
        return x64_sem_regra(c, "seleciona", "real fora do padrao minss/maxss")
    }
    let dupla: bool = i.classe == (bir.BC_F64 as u8)
    let op_primeiro: ^bir.BirOperando = primeiro as ^bir.BirOperando
    let op_segundo: ^bir.BirOperando = segundo as ^bir.BirOperando
    var d: u8 = xmm_do_resultado(c, i.dst)
    if (d != (XMM_A as u8)) and (isel_otim_reg_xmm(c, op_segundo) == (d as i32)) and (not ((op_primeiro.tipo == (bir.BO_VREG as u8)) and (op_segundo.tipo == (bir.BO_VREG as u8)) and (op_primeiro.id == op_segundo.id))) {
        d = XMM_A as u8
    }
    if not xmm_carregar_em(c, d, op_primeiro) {
        return false
    }
    var ok: bool = false
    let xs: u8 = xmm_fonte(c, op_segundo, XMM_B as u8, &ok)
    if not ok {
        return false
    }
    var forma: i32 = FX_MINSS_XX
    if maximo {
        forma = FX_MAXSS_XX
        if dupla {
            forma = FX_MAXSD_XX
        }
    } else if dupla {
        forma = FX_MINSD_XX
    }
    return fechar_real(c, i.dst, d, x64_emitir(c, mi2(forma as u16, m_xmm(d), m_xmm(xs)))) > 0
}

// C: nativo/x64/x64_isel_otim_real.c:150
proc inteiro_para_real(c: ^X64Ctx, i: ^bir.BirInstr) -> i32 {
    // I32 sem sinal usa a forma de 64 bits (o registrador vive zero-extendido)
    let alarga: bool = (i.a.classe == (bir.BC_I32 as u8)) and (i.aux == (bir.BIR_SEM_SINAL as u8))
    let r64: bool = (i.a.classe == (bir.BC_I64 as u8)) or alarga
    let dupla: bool = i.classe == (bir.BC_F64 as u8)
    let d: u8 = xmm_do_resultado(c, i.dst)
    var forma: i32 = FX_CVTSI2SS_XR32
    if dupla {
        forma = FX_CVTSI2SD_XR32
        if r64 {
            forma = FX_CVTSI2SD_XR64
        }
    } else if r64 {
        forma = FX_CVTSI2SS_XR64
    }
    let ra: i32 = isel_otim_reg_int(c, &i.a)
    var fonte: i32 = X64_RAX
    if ra >= 0 {
        fonte = ra
    }
    if (i.a.classe != (bir.BC_I32 as u8)) and (i.a.classe != (bir.BC_I64 as u8)) {
        return 0
    }
    if ra < 0 {
        var ext: u8 = bir.BE_NENHUMA as u8
        if alarga {
            ext = bir.BE_ZERO as u8
        }
        if not isel_carregar(c, X64_RAX, &i.a, ext) {
            return -1
        }
    }
    var largura: u8 = 32
    if r64 {
        largura = 64
    }
    return fechar_real(c, i.dst, d, x64_emitir(c, mi2(forma as u16, m_xmm(d), m_reg(fonte, largura))))
}

// C: nativo/x64/x64_isel_otim_real.c:167
proc real_para_real(c: ^X64Ctx, i: ^bir.BirInstr) -> i32 {
    let d: u8 = xmm_do_resultado(c, i.dst)
    var x: u8 = 0
    var tern_1: i32 = FX_CVTSD2SS_XX
    if i.classe == (bir.BC_F64 as u8) {
        tern_1 = FX_CVTSS2SD_XX
    }
    let forma: u16 = tern_1 as u16
    var ok: bool = false
    x = xmm_fonte(c, &i.a, d, &ok)
    if not ok {
        return -1
    }
    let arg_1: MOperando = m_xmm(x)
    let arg_2: MOperando = m_xmm(d)
    let arg_3: u16 = forma
    let arg_4: bool = x64_emitir(c, mi2(arg_3, arg_2, arg_1))
    let arg_5: u8 = d
    let arg_6: u32 = i.dst
    let arg_7: ^X64Ctx = c
    return fechar_real(arg_7, arg_6, arg_5, arg_4)
}

// C: nativo/x64/x64_isel_otim_real.c:179
proc isel_otim_real(c: ^X64Ctx, i: ^bir.BirInstr) -> i32 {
    let sw_1 = i.op as i32
    if sw_1 == bir.BIR_ADD or sw_1 == bir.BIR_SUB or sw_1 == bir.BIR_MUL or sw_1 == bir.BIR_DIV {
        return conta_real(c, i)
    } else if sw_1 == bir.BIR_NEG {
        return neg_real(c, i)
    } else if sw_1 == bir.BIR_RAIZ {
        return raiz_real(c, i)
    } else if sw_1 == bir.BIR_CONST or sw_1 == bir.BIR_COPIA {
        return mover_real(c, i)
    } else if sw_1 == bir.BIR_I_PARA_F {
        return inteiro_para_real(c, i)
    } else if sw_1 == bir.BIR_F_PARA_F {
        return real_para_real(c, i)
    } else {
        return 0
    }
    return 0
}

// C: nativo/x64/x64_isel_otim_real.c:195
// So as condicoes sem paridade: FLT e FLE trocam os operandos; FLT/FGT saltam por A, FLE/FGE por AE.
proc isel_otim_cmp_real(c: ^X64Ctx, i: ^bir.BirInstr, cc: ^i32) -> i32 {
    let troca: bool = (i.aux == (bir.BCOND_FLT as u8)) or (i.aux == (bir.BCOND_FLE as u8))
    var esq: ^bir.BirOperando = &i.a
    var dir: ^bir.BirOperando = &i.b
    if troca {
        esq = &i.b
        dir = &i.a
    }
    if (i.aux < (bir.BCOND_FLT as u8)) or (i.aux > (bir.BCOND_FGE as u8)) {
        return 0
    }
    cc^ = X64_CC_AE
    if (i.aux == (bir.BCOND_FLT as u8)) or (i.aux == (bir.BCOND_FGT as u8)) {
        cc^ = X64_CC_A
    }
    var ok: bool = false
    let xe: u8 = xmm_fonte(c, esq, XMM_A as u8, &ok)
    if not ok {
        return -1
    }
    let xd: u8 = xmm_fonte(c, dir, XMM_B as u8, &ok)
    if not ok {
        return -1
    }
    var forma_ucomis: i32 = FX_UCOMISS_XX
    if i.a.classe == (bir.BC_F64 as u8) {
        forma_ucomis = FX_UCOMISD_XX
    }
    if x64_emitir(c, mi2(forma_ucomis as u16, m_xmm(xe), m_xmm(xd))) {
        return 1
    }
    return -1
}
