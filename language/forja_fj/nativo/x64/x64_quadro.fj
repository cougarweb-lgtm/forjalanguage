        if not x64_emitir(c, mi1(FX_PUSH64_R as u16, m_reg(transmute(reg, to = i32), 64))) {
            return false
        }
        let antes_1: u32 = k
        k += 1
        c.prologo.salvo[antes_1] = fim_da_instrucao(c)
    }
    return true
