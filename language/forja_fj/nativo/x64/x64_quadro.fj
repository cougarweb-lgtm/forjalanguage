proc quadro_posicionar_slots(f: ^bir.BirFuncao, saida: []u32) -> u32 {
    var fim: u32 = aloc_bytes_slots(f)
    var k: u32 = 0
    while k < f.nslots {
        let ali: u32 = f.slots[k].alinhamento
