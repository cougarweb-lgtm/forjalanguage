proc desempilhar_salvos(c: ^X64Ctx) -> bool {
    var reg: u32 = 16
    while reg > 0 {
        reg -= 1
        if ((c.quadro.regs_salvos >> reg) & 1) != 0 {
            if not x64_emitir(c, mi1(FX_POP64_R as u16, m_reg(reg as i32, 64))) {
                return false
            }
        }
    }
    return true
}

// C: nativo/x64/x64_quadro.c:394
proc carregar_parametro_em_registrador(c: ^X64Ctx, k: u32, reg: i32) -> bool {
    let f = c.f as ^bir.BirFuncao
    let classe: u8 = (f.classe_vreg or_else {})[k]
    if bir.bir_classe_eh_real(classe as i32) {
        var forma: i32 = FX_MOVSS_XM
        if (classe as i32) == bir.BC_F64 {
            forma = FX_MOVSD_XM
        }
        return x64_emitir(c, mi2(forma as u16, m_xmm(reg as u8), aloc_home_do_parametro(c.f, k, aloc_bits(classe))))
    }
    let bits: u8 = aloc_bits(classe)
    if bits == 64 {
        return x64_emitir(c, mi2(FX_MOV64_RM as u16, m_reg(reg, 64), aloc_home_do_parametro(c.f, k, 64)))
    }
    if bits == 32 {
        return x64_emitir(c, mi2(FX_MOV32_RM as u16, m_reg(reg, 32), aloc_home_do_parametro(c.f, k, 32)))
    }
    if bits == 16 {
        return x64_emitir(c, mi2(FX_MOVZX32_RM16 as u16, m_reg(reg, 32), aloc_home_do_parametro(c.f, k, 16)))
    }
    return x64_emitir(c, mi2(FX_MOVZX32_RM8 as u16, m_reg(reg, 32), aloc_home_do_parametro(c.f, k, 8)))
}

// C: nativo/x64/x64_quadro.c:413
proc carregar_parametros_em_registrador(c: ^X64Ctx) -> bool {
    var k: u32 = 0
    while k < (c.f as ^bir.BirFuncao).nparams {
        let vreg: AlocOperando = aloc_operando_de(c.f, k, 64)
        if ((common.c2f_b2i32(vreg.em_reg) != 0) and (not parametro_direto_em_registrador(c, k))) and (not carregar_parametro_em_registrador(c, k, vreg.reg)) {
            return false
        }
        k += 1
    }
    return true
}

// C: nativo/x64/x64_quadro.c:431
// C2F-INDECIDIVEL: mov
proc listar_movimentos_de_parametros(c: ^X64Ctx, mov: []MovParametro) -> u32 {
    let oculto: u32 = abi_win_oculto(c.f)
    var n: u32 = 0
    var k: u32 = 0
    while k < (c.f as ^bir.BirFuncao).nparams {
        if not parametro_direto_em_registrador(c, k) {
            k += 1
            continue
        }
        let antes_1: u32 = n
        n += 1
        mov[antes_1] = MovParametro{origem = REGS_HOME[k + oculto], destino = aloc_operando_de(c.f, k, 64).reg, classe = ((c.f as ^bir.BirFuncao).classe_vreg or_else {})[k]}
        k += 1
    }
    return n
}

// C: nativo/x64/x64_quadro.c:445
proc emitir_mov_parametro(c: ^X64Ctx, m: ^MovParametro) -> bool {
    let sw_1 = aloc_bits(m.classe) as i32
    if sw_1 == 64 {
        let arg_1: MOperando = m_reg(m.origem, 64)
        let arg_2: MOperando = m_reg(m.destino, 64)
