    c.prologo.push = fim_da_instrucao(c)
    let arg_1: MOperando = m_reg(X64_RSP, 64)
    let arg_2: MOperando = m_reg(X64_RBP, 64)
    if not x64_emitir(c, mi2(FX_MOV64_RR as u16, arg_2, arg_1)) {
        return false
