    } else if sw_1 == 32 {
        let arg_3: MOperando = m_reg(m.origem, 32)
        let arg_4: MOperando = m_reg(m.destino, 32)
        return x64_emitir(c, mi2(FX_MOV32_RR as u16, arg_4, arg_3))
    } else if sw_1 == 16 {
        let arg_5: MOperando = m_reg(m.origem, 16)
        let arg_6: MOperando = m_reg(m.destino, 32)
        return x64_emitir(c, mi2(FX_MOVZX32_RR16 as u16, arg_6, arg_5))
    } else {
        let arg_7: MOperando = m_reg(m.origem, 8)
        let arg_8: MOperando = m_reg(m.destino, 32)
        return x64_emitir(c, mi2(FX_MOVZX32_RR8 as u16, arg_8, arg_7))
    }
    return false
}

// C: nativo/x64/x64_quadro.c:460
// C2F-13: mov fundido em n (len)
proc destino_ainda_lido(mov: []MovParametro, j: u32) -> bool {
    for k in (0 as u32)..<(len(mov) as u32) {
        if ((k != j) and (not mov[k].feito)) and (common.c2f_s2u_32(mov[k].origem) == common.c2f_s2u_32(mov[j].destino)) {
            return true
        }
    }
    return false
}

// C: nativo/x64/x64_quadro.c:470
// C2F-13: mov fundido em n (len)
proc salvar_origem_em_r11(c: ^X64Ctx, mov: []MovParametro) -> bool {
    var presa: i32 = X64_R11
    for k in (0 as u32)..<(len(mov) as u32) {
        if not mov[k].feito {
            presa = mov[k].destino
            break
        }
    }
    let arg_1: MOperando = m_reg(presa, 64)
    let arg_2: MOperando = m_reg(X64_R11, 64)
    if not x64_emitir(c, mi2(FX_MOV64_RR as u16, arg_2, arg_1)) {
        return false
    }
    for k in (0 as u32)..<(len(mov) as u32) {
        if (not mov[k].feito) and (common.c2f_s2u_32(mov[k].origem) == common.c2f_s2u_32(presa)) {
            mov[k].origem = X64_R11
        }
    }
    return true
}

// C: nativo/x64/x64_quadro.c:490
// C2F-13: mov fundido em n (len)
proc emitir_movimentos_prontos(c: ^X64Ctx, mov: []MovParametro, emitidos: ^u32) -> bool {
    emitidos^ = 0
    for j in (0 as u32)..<(len(mov) as u32) {
        if (common.c2f_b2i32(mov[j].feito) != 0) or (common.c2f_b2i32(destino_ainda_lido(mov, j)) != 0) {
            continue
        }
        if not emitir_mov_parametro(c, &mov[j]) {
            return false
        }
        mov[j].feito = true
        emitidos^ += 1
    }
    return true
}

// C: nativo/x64/x64_quadro.c:505
proc mover_parametros_inteiros(c: ^X64Ctx) -> bool {
    var mov: [4]MovParametro = {}
    let n: u32 = listar_movimentos_de_parametros(c, mov[..])
    let movs = mov[0..<(n as int)]
    var pendentes: u32 = n
    var r11_usado: bool = false
    while pendentes > 0 {
        var emitidos: u32 = 0
        if not emitir_movimentos_prontos(c, movs, &emitidos) {
            return false
        }
        pendentes -= emitidos
        if emitidos > 0 {
            continue
        }
        if r11_usado {
            return x64_sem_regra(c, "prologo", "dois ciclos de parametros em registrador (fora do degrau do alocador)")
        }
        if not salvar_origem_em_r11(c, movs) {
            return false
        }
        r11_usado = true
    }
    return true
}

// C: nativo/x64/x64_quadro.c:529
proc quadro_prologo(c: ^X64Ctx) -> bool {
    if (not salvar_rbp(c)) or (not empurrar_salvos(c)) {
        return false
    }
    if (common.c2f_b2i32(c.quadro.sondar) != 0) and (not sondar(c)) {
        return false
    }
    let arg_1: MOperando = m_imed(quadro_alocacao(&c.quadro) as i64)
    let arg_2: MOperando = m_reg(X64_RSP, 64)
    if not x64_emitir(c, mi2(FX_SUB64_RI as u16, arg_2, arg_1)) {
        return false
    }
    c.prologo.alocacao = fim_da_instrucao(c)
    return (((((common.c2f_b2i32(guardar_home(c)) != 0) and (common.c2f_b2i32(ponteiros_dos_bytes(c)) != 0)) and (common.c2f_b2i32(mover_xmm_do_alocador(c, true)) != 0)) and (common.c2f_b2i32(mover_parametros_inteiros(c)) != 0)) and (common.c2f_b2i32(carregar_parametros_em_registrador(c)) != 0)) and ((not c.quadro.salva) or (common.c2f_b2i32(salvar_registradores_sysv(c)) != 0))
}

// C: nativo/x64/x64_quadro.c:541
proc quadro_epilogo(c: ^X64Ctx) -> bool {
    if (common.c2f_b2i32(c.quadro.salva) != 0) and (not restaurar_registradores_sysv(c)) {
        return false
    }
    if not mover_xmm_do_alocador(c, false) {
        return false
    }
    let arg_1: MOperando = m_mem(X64_RBP, -transmute(c.quadro.empurrados, to = i32), 64)
    let arg_2: MOperando = m_reg(X64_RSP, 64)
    if not x64_emitir(c, mi2(FX_LEA64_RM as u16, arg_2, arg_1)) {
        return false
    }
    if (not desempilhar_salvos(c)) or (not x64_emitir(c, mi1(FX_POP64_R as u16, m_reg(X64_RBP, 64)))) {
        return false
    }
    return x64_emitir(c, mi0(FX_RET as u16))
}

// Teste dirigido: alinhamento dos slots (cada um no seu alinhamento, o fim cresce na ordem); saida recebe o deslocamento de cada slot.
test "x64_quadro_posicionar_slots_alinha" {
    var f: bir.BirFuncao = bir.BirFuncao{}
    f.slots = make([dynamic]bir.BirSlot, alloc = heap, cap = 2)
    defer delete(f.slots)
    append(&f.slots, item = bir.BirSlot{tam = 4, alinhamento = 4})
    append(&f.slots, item = bir.BirSlot{tam = 8, alinhamento = 8})
    f.nslots = 2
    var saida: [2]u32 = {0, 0}
    let fim = quadro_posicionar_slots(&f, saida[..])
    expect(saida[0] == 4)
    expect(saida[1] == 16)
    expect(fim == 16)
}

// Teste dirigido: quadro de funcao vazia = so a area de sombra (32 B) arredondada a 16.
test "x64_quadro_calcular_vazio" {
    var p: bir.BirPrograma = bir.BirPrograma{}
    var f: bir.BirFuncao = bir.BirFuncao{}
    let q = quadro_calcular(&p, &f)
    expect(q.tam == 32)
    expect(q.salvos_xmm == 0)
    expect(q.sondar == false)
}

// Teste dirigido: popcount da mascara de xmm salvos (bits 6, 7 e 8 = 3 xmm = 48 B) entra no quadro (32 + 48 = 80).
test "x64_quadro_calcular_popcount_xmm" {
    var p: bir.BirPrograma = bir.BirPrograma{}
    var f: bir.BirFuncao = bir.BirFuncao{}
    f.regs_salvos_xmm = 448
    let q = quadro_calcular(&p, &f)
    expect(q.salvos_xmm == 48)
    expect(q.tam == 80)
}

// Teste dirigido: slot de 4 bytes sem vreg vira agregado de 4 B e o quadro arredonda para 48.
test "x64_quadro_calcular_agregado_de_slot" {
    var p: bir.BirPrograma = bir.BirPrograma{}
    var f: bir.BirFuncao = bir.BirFuncao{}
    f.slots = make([dynamic]bir.BirSlot, alloc = heap, cap = 1)
    defer delete(f.slots)
    append(&f.slots, item = bir.BirSlot{tam = 4, alinhamento = 4})
    f.nslots = 1
    let q = quadro_calcular(&p, &f)
    expect(q.agregados == 4)
    expect(q.tam == 48)
}
