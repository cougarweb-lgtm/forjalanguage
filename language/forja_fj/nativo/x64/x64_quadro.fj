proc pilha_de_saida(q: ^Quadro, sysv: ^VarreduraSysv) -> u32 {
    var tern_1: u32 = 0
    if q.maxargs > ABI_WIN_REGS_ARG {
        tern_1 = ABI_WIN_BYTES_ARG * (q.maxargs - ABI_WIN_REGS_ARG)
    }
    var pilha: u32 = tern_1
    if (sysv.pilha > ABI_WIN_SOMBRA) and ((sysv.pilha - ABI_WIN_SOMBRA) > pilha) {
        pilha = sysv.pilha - ABI_WIN_SOMBRA
    }
    return pilha
}

// C: nativo/x64/x64_quadro.c:137
proc quadro_calcular(p: ^bir.BirPrograma, f: ^bir.BirFuncao) -> Quadro {
    var q: Quadro = Quadro{slots = aloc_bytes_slots(f)}
    var sysv: VarreduraSysv = varrer_sysv(p, f)
    var sem_saida: [1]u32 = {0}
    q.agregados = quadro_posicionar_slots(f, sem_saida[0..<0]) - q.slots
    var b: u32 = 0
    while b < f.nblocos {
        let n: u32 = max_args_do_bloco(&f.blocos[b])
        if n > q.maxargs {
            q.maxargs = n
        }
        b += 1
    }
    let pilha: u32 = pilha_de_saida(&q, &sysv)
    q.salva = sysv.chama
    q.regs_salvos = aloc_regs_salvos(f)
    q.empurrados = aloc_bytes_empurrados(f)
    q.salvos = 0
    if q.salva {
        q.salvos = QUADRO_SALVOS_BYTES
    }
    q.regs_salvos_xmm = aloc_regs_salvos_xmm(f)
    var bits_xmm: u32 = 0
    var mascara_xmm: u32 = q.regs_salvos_xmm
    while mascara_xmm != 0 {
        bits_xmm += mascara_xmm & 1
        mascara_xmm = mascara_xmm >> 1
    }
    q.salvos_xmm = QUADRO_XMM_BYTES * bits_xmm
    q.tam = (q.slots + q.agregados + q.salvos + q.salvos_xmm + ABI_WIN_SOMBRA + pilha + QUADRO_ALINHAMENTO - 1) / QUADRO_ALINHAMENTO * QUADRO_ALINHAMENTO
    q.sondar = quadro_alocacao(&q) >= X64_PAGINA
    return q
}

// C: nativo/x64/x64_quadro.c:161
proc quadro_alocacao(q: ^Quadro) -> u32 {
    return q.tam - q.empurrados
}

