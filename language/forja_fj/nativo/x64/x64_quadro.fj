// C: nativo/x64/x64_quadro.c:50
proc max_args_do_bloco(b: ^bir.BirBloco) -> u32 {
    var maximo: u32 = 0
    var k: u32 = 0
    while k < b.n {
        let i: ^bir.BirInstr = &b.instrs[k]
        if (((i.op == (bir.BIR_CHAMA as u8)) or (i.op == (bir.BIR_CHAMA_IND as u8))) or (i.op == (bir.BIR_ARMADILHA as u8))) and ((i.nargs + abi_win_oculto_da_chamada(i)) > maximo) {
            maximo = i.nargs + abi_win_oculto_da_chamada(i)
        }
        k += 1
    }
    return maximo
}

