}

// C: nativo/x64/x64_quadro.c:103
proc varrer_bloco_sysv(p: ^bir.BirPrograma, b: ^bir.BirBloco, v: ^VarreduraSysv) {
    var k: u32 = 0
    while k < b.n {
        let i: ^bir.BirInstr = &b.instrs[k]
        var pilha: u32 = 0
        if not sysv_eh_chamada_do_programa(p, i) {
            k += 1
            continue
        }
        pilha = sysv_bytes_de_pilha(i)
        v.chama = true
        if pilha > v.pilha {
            v.pilha = pilha
        }
        k += 1
    }
}

// C: nativo/x64/x64_quadro.c:118
proc varrer_sysv(p: ^bir.BirPrograma, f: ^bir.BirFuncao) -> VarreduraSysv {
