// C: nativo/x64/x64_quadro.c:293
proc salvar_rbp(c: ^X64Ctx) -> bool {
    if not x64_emitir(c, mi1(FX_PUSH64_R as u16, m_reg(X64_RBP, 64))) {
        return false
