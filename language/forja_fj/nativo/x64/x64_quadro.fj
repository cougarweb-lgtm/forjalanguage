    if k.slot >= 0 {
        v.loc.rbp_off = -transmute(c.slot_off[k.slot as int], to = i32)
    } else {
        v.loc.rbp_off = aloc_operando_de(c.f, k.vreg as u32, 64).desloc
        v.loc.indireto = k.indireto
    }
