// C: nativo/x64/x64_quadro.c:366
proc mover_xmm_do_alocador(c: ^X64Ctx, salvar: bool) -> bool {
    var k: u32 = 0
    for reg in (QUADRO_XMM_PRIMEIRO as u32)..<QUADRO_XMM_QTD {
        let memoria: MOperando = m_mem(X64_RBP, desloc_salvo_xmm_alocador(&c.quadro, k), 128)
        var tern_1: MInstr = MInstr{}
        if common.c2f_b2i32(salvar) != 0 {
            tern_1 = mi2(FX_MOVUPS_MX as u16, memoria, m_xmm(reg as u8))
        } else {
            tern_1 = mi2(FX_MOVUPS_XM as u16, m_xmm(reg as u8), memoria)
        }
        let mover: MInstr = tern_1
        if ((c.quadro.regs_salvos_xmm >> (reg & 31)) & 1) == 0 {
            continue
