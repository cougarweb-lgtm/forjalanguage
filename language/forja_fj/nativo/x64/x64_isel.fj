// C2F:? tabela FORMAS_ARIT_2 (const FormasAritmeticas[39]): folha {'txt': '[ BIR_ADD ] = { { FX_ADD32_RR , FX_ADD64_RR } , { FX_ADD32_RI , FX_ADD64_RI } }'} para FormasAritmeticas
// C2F:? tabela BASE_DO_OV (const uint8_t[39]): folha nao escalar {'txt': '[ BIR_ADD_OV ] = BIR_ADD'}
const CC_DA_COND_2: [10]i32 = {4, 5, 12, 14, 15, 13, 2, 6, 7, 3}
// C2F-70 global mutavel qual (int) -> parametro/struct de estado (plano C2F-70)
// C2F:? tabela REGRAS_ISEL_2 (const RegraIsel[39]): folha {'txt': '[ BIR_CONST ] = { "const" , IselMover }'} para RegraIsel

// C: nativo/x64/x64_isel.c:57
proc imediato_i8(imed: i64, ext: u8) -> i64 {
    let bits: u64 = common.c2f_s2u_64(imed)
    if ext == (bir.BE_SINAL as u8) {
        return common.c2f_trunc_i8(bits) as i64
    }
    return common.c2f_trunc_u8(bits) as i64
}

// C: nativo/x64/x64_isel.c:62
proc imediato_i16(imed: i64, ext: u8) -> i64 {
    let bits: u64 = common.c2f_s2u_64(imed)
    if ext == (bir.BE_SINAL as u8) {
        return common.c2f_trunc_i16(bits) as i64
    }
    return common.c2f_trunc_u16(bits) as i64
}

// C: nativo/x64/x64_isel.c:67
proc imediato_i32(imed: i64, ext: u8) -> i64 {
    let bits: u64 = common.c2f_s2u_64(imed)
    if ext == (bir.BE_ZERO as u8) {
        return common.c2f_trunc_u32(bits) as i64
    }
    return common.c2f_trunc_i32(bits) as i64
}

// C: nativo/x64/x64_isel.c:72
proc imediato_normalizado(o: ^bir.BirOperando, ext: u8) -> i64 {
    let sw_1 = o.classe as i32
    if sw_1 == bir.BC_I8 {
        return imediato_i8(o.imed, ext)
    } else if sw_1 == bir.BC_I16 {
        return imediato_i16(o.imed, ext)
    } else if sw_1 == bir.BC_I32 {
        return imediato_i32(o.imed, ext)
    } else {
        return o.imed
    }
    return 0
}

// C: nativo/x64/x64_isel.c:82
proc carregar_imediato(c: ^X64Ctx, reg: i32, o: ^bir.BirOperando, ext: u8) -> bool {
    let valor: i64 = imediato_normalizado(o, ext)
    if (o.classe == (bir.BC_I64 as u8)) or (ext != (bir.BE_NENHUMA as u8)) {
        let arg_1: MOperando = m_imed(valor)
        let arg_2: MOperando = m_reg(reg, 64)
        return x64_emitir(c, mi2(FX_MOV64_RI as u16, arg_2, arg_1))
    }
    let arg_3: MOperando = m_imed(common.c2f_trunc_i32(common.c2f_s2u_64(valor)) as i64)
    let arg_4: MOperando = m_reg(reg, 32)
    return x64_emitir(c, mi2(FX_MOV32_RI as u16, arg_4, arg_3))
}

// C: nativo/x64/x64_isel.c:92
proc carregar_curto(c: ^X64Ctx, reg: i32, o: ^bir.BirOperando, ext: u8) -> bool {
    let byte: bool = o.classe == (bir.BC_I8 as u8)
    var tern_1: i32 = 16
    if common.c2f_b2i32(byte) != 0 {
        tern_1 = 8
    }
    var vreg: AlocOperando = aloc_operando_de(c.f, o.id, tern_1 as u8)
    if ext == (bir.BE_SINAL as u8) {
        var tern_2: i32 = FX_MOVSX64_RM16
        if common.c2f_b2i32(byte) != 0 {
            tern_2 = FX_MOVSX64_RM8
        }
        return aloc_carregar(c, tern_2 as u16, m_reg(reg, 64), &vreg)
    }
    var tern_3: i32 = FX_MOVZX32_RM16
    if common.c2f_b2i32(byte) != 0 {
        tern_3 = FX_MOVZX32_RM8
    }
    return aloc_carregar(c, tern_3 as u16, m_reg(reg, 32), &vreg)
}

// C: nativo/x64/x64_isel.c:103
proc carregar_vreg(c: ^X64Ctx, reg: i32, o: ^bir.BirOperando, ext: u8) -> bool {
    var vreg64: AlocOperando = aloc_operando_de(c.f, o.id, 64)
    var vreg32: AlocOperando = aloc_operando_de(c.f, o.id, 32)
    let sw_1 = o.classe as i32
    if sw_1 == bir.BC_I64 {
        return aloc_carregar(c, FX_MOV64_RM as u16, m_reg(reg, 64), &vreg64)
    } else if sw_1 == bir.BC_I32 {
        if not aloc_carregar(c, FX_MOV32_RM as u16, m_reg(reg, 32), &vreg32) {
            return false
        }
        if ext != (bir.BE_SINAL as u8) {
            return true
        }
        return x64_emitir(c, mi2(FX_MOVSXD64_RR32 as u16, m_reg(reg, 64), m_reg(reg, 32)))
    } else if sw_1 == bir.BC_I8 or sw_1 == bir.BC_I16 {
        return carregar_curto(c, reg, o, ext)
    }
    return x64_sem_regra(c, "vreg", "operando de classe fora do M2 (so i8, i16, i32 e i64)")
}

// C: nativo/x64/x64_isel.c:123
proc isel_carregar(c: ^X64Ctx, reg: i32, o: ^bir.BirOperando, ext: u8) -> bool {
    if (common.c2f_b2i32(bir.bir_classe_eh_real(o.classe as i32)) != 0) and (o.tipo != (bir.BO_NADA as u8)) {
        return isel_carregar_real(c, reg as u8, o)
    }
    if o.tipo == (bir.BO_IMED as u8) {
        return carregar_imediato(c, reg, o, ext)
    }
    if o.tipo == (bir.BO_VREG as u8) {
        return carregar_vreg(c, reg, o, ext)
    }
    return x64_sem_regra(c, "operando", "esperava vreg ou imediato")
}

// C: nativo/x64/x64_isel.c:134
proc isel_guardar(c: ^X64Ctx, vreg: u32, reg: i32) -> bool {
    let classe_do_vreg: u8 = ((c.f as ^bir.BirFuncao).classe_vreg or_else {})[vreg]
    let bits: u8 = aloc_bits(classe_do_vreg)
    var forma: i32 = FX_MOV8_MR
    if bits == 64 {
        forma = FX_MOV64_MR
    } else if bits == 32 {
        forma = FX_MOV32_MR
    } else if bits == 16 {
        forma = FX_MOV16_MR
    }
    if bir.bir_classe_eh_real(classe_do_vreg as i32) {
        return isel_guardar_real(c, vreg, reg as u8)
    }
    var destino: AlocOperando = aloc_operando_de(c.f, vreg, bits)
    return aloc_gravar(c, forma as u16, &destino, m_reg(reg, bits))
}

// C: nativo/x64/x64_isel.c:147
proc isel_extensao_da_conta(classe: u8, com_sinal: bool) -> u8 {
    var tern_1: i32 = bir.BE_NENHUMA
    if (common.c2f_b2i32(com_sinal) != 0) and ((classe == (bir.BC_I8 as u8)) or (classe == (bir.BC_I16 as u8))) {
        tern_1 = bir.BE_SINAL
    }
    return tern_1 as u8
}

// C: nativo/x64/x64_isel.c:155
proc imediato_pequeno(o: ^bir.BirOperando, ext: u8, valor: ^i64) -> bool {
    if o.tipo != (bir.BO_IMED as u8) {
        return false
    }
    valor^ = imediato_normalizado(o, ext)
    return (valor^ >= (((-2147483647) - 1) as i64)) and (valor^ <= 2147483647)
}

// C: nativo/x64/x64_isel.c:164
proc isel_indice_largura(classe: u8) -> u8 {
    return common.c2f_b2i32(classe == (bir.BC_I64 as u8)) as u8
}

// C: nativo/x64/x64_isel.c:170
// C: nativo/x64/x64_isel.c:34 - FORMAS_ARIT[base]; base sem linha na tabela fica zerada, como no C
proc formas_arit(base: u8) -> FormasAritmeticas {
    var f: FormasAritmeticas = FormasAritmeticas{rr = {0, 0}, ri = {0, 0}}
    let sw_1 = base as i32
    if sw_1 == bir.BIR_ADD {
        f = formas_par(FX_ADD32_RR, FX_ADD64_RR, FX_ADD32_RI, FX_ADD64_RI)
    } else if sw_1 == bir.BIR_SUB {
        f = formas_par(FX_SUB32_RR, FX_SUB64_RR, FX_SUB32_RI, FX_SUB64_RI)
    } else if sw_1 == bir.BIR_AND {
        f = formas_par(FX_AND32_RR, FX_AND64_RR, FX_AND32_RI, FX_AND64_RI)
    } else if sw_1 == bir.BIR_OR {
        f = formas_par(FX_OR32_RR, FX_OR64_RR, FX_OR32_RI, FX_OR64_RI)
    } else if sw_1 == bir.BIR_XOR {
        f = formas_par(FX_XOR32_RR, FX_XOR64_RR, FX_XOR32_RI, FX_XOR64_RI)
    } else if sw_1 == bir.BIR_CMP {
        f = formas_par(FX_CMP32_RR, FX_CMP64_RR, FX_CMP32_RI, FX_CMP64_RI)
    } else if sw_1 == bir.BIR_MUL {
        // imul nao tem forma com imediato: ri = FX_QTD
        f = formas_par(FX_IMUL32_RR, FX_IMUL64_RR, FX_QTD, FX_QTD)
    }
    return f
}

proc formas_par(rr32: i32, rr64: i32, ri32: i32, ri64: i32) -> FormasAritmeticas {
    return FormasAritmeticas{rr = {rr32 as u16, rr64 as u16}, ri = {ri32 as u16, ri64 as u16}}
}

proc isel_operacao(c: ^X64Ctx, i: ^bir.BirInstr, base: u8, ext: u8) -> bool {
    let formas: FormasAritmeticas = formas_arit(base)
    let larg: u8 = isel_indice_largura(i.a.classe)
    var bits: u8 = 32
    if larg != 0 {
        bits = 64
    }
    var imed: i64 = 0
    if not isel_carregar(c, X64_RAX, &i.a, ext) {
        return false
    }
    if ((formas.ri[larg] as i32) != FX_QTD) and imediato_pequeno(&i.b, ext, &imed) {
        return x64_emitir(c, mi2(formas.ri[larg], m_reg(X64_RAX, bits), m_imed(imed)))
    }
    if not isel_carregar(c, X64_RCX, &i.b, ext) {
        return false
    }
    return x64_emitir(c, mi2(formas.rr[larg], m_reg(X64_RAX, bits), m_reg(X64_RCX, bits)))
}

// C: nativo/x64/x64_isel.c:188
proc soma_de_i32_com_sete(i: ^bir.BirInstr) -> bool {
    let soma: bool = (i.op == (bir.BIR_ADD as u8)) or (i.op == (bir.BIR_ADD_OV as u8))
    return (((common.c2f_b2i32(soma) != 0) and (i.a.classe == (bir.BC_I32 as u8))) and (i.b.tipo == (bir.BO_IMED as u8))) and (i.b.imed == 7)
}

// C: nativo/x64/x64_isel.c:196
// C: nativo/x64/x64_isel.c:196 - so teste: FORJA_TESTE_PLANTAR de um digito 1..3; 0 = ausente ou fora disso
proc plantio_pedido() -> i32 {
    let env: str = os.env("FORJA_TESTE_PLANTAR") or_else ""
    let bytes = as_bytes(env)
    if len(bytes) != 1 {
        return 0
    }
    let digito = bytes[0] as i32
    // '1' = 49 e '3' = 51
    if digito >= 49 and digito <= 51 {
        return digito - 48
    }
    return 0
}

// C: nativo/x64/x64_isel.c:205
proc plantio_vale_aqui(qual: i32, c: ^X64Ctx, i: ^bir.BirInstr) -> bool {
    if qual == 1 {
        return soma_de_i32_com_sete(i)
    } else if qual == 2 {
        return (i.op == (bir.BIR_CMP as u8)) and (i.aux == (bir.BCOND_LT_S as u8))
    } else if qual == 3 {
        return (i.op == (bir.BIR_RETORNA as u8)) and (common.c2f_b2i32((c.f as ^bir.BirFuncao).sintetica) != 0)
    } else {
        return false
    }
    return false
}

// C: nativo/x64/x64_isel.c:215
// C: nativo/x64/x64_isel.c:215 - o C le a variavel uma vez (static qual) e avisa no 1o uso; aqui a leitura e 1x por X64Ctx (F2: os.env por instrucao custava 1-3%) e avisa quando o plantio vale
proc isel_plantio(c: ^X64Ctx, i: ^bir.BirInstr) -> u8 {
    if not c.plantio_lido {
        c.plantio = plantio_pedido()
        c.plantio_lido = true
    }
    let qual: i32 = c.plantio
    if qual == 0 or not plantio_vale_aqui(qual, c, i) {
        return 0
    }
    avisar_plantio(qual)
    return qual as u8
}

// C: nativo/x64/x64_isel.c:222 - fprintf(stderr): \n vira \r\n pelo shim em modo texto
proc avisar_plantio(qual: i32) {
    let msg = format(f"aviso: FORJA_TESTE_PLANTAR={qual} ativo: o codigo gerado esta errado de proposito (so para testar o diferencial)\n", alloc = heap)
    let e = common.c2f_saida_stderr()
    common.c2f_saida_formatar(e, msg)
    _ = common.c2f_saida_fechar(e)
    delete(msg)
}

// C: nativo/x64/x64_isel.c:227
proc isel_aritmetica(c: ^X64Ctx, i: ^bir.BirInstr) -> bool {
    var tern_1: i32 = i.op as i32
    if isel_plantio(c, i) == 1 {
        tern_1 = bir.BIR_SUB
    }
    let base: u8 = tern_1 as u8
    if i.classe == (bir.BC_V128 as u8) {
        return isel_conta_vetorial(c, i)
    }
    if bir.bir_classe_eh_real(i.classe as i32) {
        return isel_conta_real(c, i)
    }
    return (common.c2f_b2i32(isel_operacao(c, i, base, bir.BE_NENHUMA as u8)) != 0) and (common.c2f_b2i32(isel_guardar(c, i.dst, X64_RAX)) != 0)
}

// C: nativo/x64/x64_isel.c:239
proc multiplica_sem_sinal(c: ^X64Ctx, i: ^bir.BirInstr) -> bool {
    let larg: u8 = isel_indice_largura(i.a.classe)
    if (not isel_carregar(c, X64_RAX, &i.a, bir.BE_NENHUMA as u8)) or (not isel_carregar(c, X64_RCX, &i.b, bir.BE_NENHUMA as u8)) {
        return false
    }
    var tern_1: i32 = FX_MUL32_R
    if (larg as i32) != 0 {
        tern_1 = FX_MUL64_R
    }
    return x64_emitir(c, mi1(tern_1 as u16, m_reg(X64_RCX, common.c2f_trunc_u8((32 << (common.c2f_s2u_32((larg as i32)) & 31)) as u64))))
}

// C: nativo/x64/x64_isel.c:249
proc condicao_do_ov(i: ^bir.BirInstr, base: u8) -> i32 {
    var tern_1: i32 = X64_CC_B
    if (i.aux == (bir.BIR_SINAL as u8)) or (base == (bir.BIR_MUL as u8)) {
        tern_1 = X64_CC_O
    }
    return tern_1
}

// C: nativo/x64/x64_isel.c:254
proc corpo_do_ov(c: ^X64Ctx, i: ^bir.BirInstr, base: u8) -> bool {
    if (base == (bir.BIR_MUL as u8)) and (i.aux == (bir.BIR_SEM_SINAL as u8)) {
        return multiplica_sem_sinal(c, i)
    }
    return isel_operacao(c, i, base, bir.BE_NENHUMA as u8)
}

// C: nativo/x64/x64_isel.c:262
// C: nativo/x64/x64_isel.c:45 - BASE_DO_OV[op]; op sem linha na tabela fica 0, como no C
proc base_do_ov(op: u8) -> u8 {
    let sw_1 = op as i32
    if sw_1 == bir.BIR_ADD_OV {
        return bir.BIR_ADD as u8
    } else if sw_1 == bir.BIR_SUB_OV {
        return bir.BIR_SUB as u8
    } else if sw_1 == bir.BIR_MUL_OV {
        return bir.BIR_MUL as u8
    } else if sw_1 == bir.BIR_NEG_OV {
        // NEG_OV chega da BIR como 0 - x
        return bir.BIR_SUB as u8
    }
    return 0
}

proc isel_ov(c: ^X64Ctx, i: ^bir.BirInstr) -> bool {
    let plantio: u8 = isel_plantio(c, i)
    var base: u8 = base_do_ov(i.op)
    if plantio == 1 {
        base = bir.BIR_SUB as u8
    }
    if (i.classe == (bir.BC_I8 as u8)) or (i.classe == (bir.BC_I16 as u8)) {
        return isel_ov_curto(c, i, base)
    }
    if not corpo_do_ov(c, i, base) {
        return false
    }
    if not x64_emitir(c, mi_cc(FX_JCC_REL32 as u16, condicao_do_ov(i, base), m_bloco(i.alvo[0]))) {
        return false
    }
    return isel_guardar(c, i.dst, X64_RAX)
}

// C: nativo/x64/x64_isel.c:275
proc condicao_com_sinal(cond: u8) -> bool {
    return ((cond as i32) >= bir.BCOND_LT_S) and ((cond as i32) <= bir.BCOND_GE_S)
}

// C: nativo/x64/x64_isel.c:280
proc isel_cmp(c: ^X64Ctx, i: ^bir.BirInstr) -> bool {
    var tern_1: i32 = i.aux as i32
    if isel_plantio(c, i) == 2 {
        tern_1 = bir.BCOND_LE_S
    }
    let cond: u8 = tern_1 as u8
    if bir.bir_classe_eh_real(i.a.classe as i32) {
        return isel_cmp_real(c, i)
    }
    if (i.aux as u64) >= (40 / 4) { // C2F: sizeof CC_DA_COND C2F: sizeof CC_DA_COND [ 0 ]
        return x64_sem_regra(c, "cmp", "condicao fora das 10 do BirCond")
    }
    let arg_1: bool = condicao_com_sinal(i.aux)
    let arg_2: u8 = i.a.classe
    if not isel_operacao(c, i, bir.BIR_CMP as u8, isel_extensao_da_conta(arg_2, arg_1)) {
        return false
    }
    let arg_3: MOperando = m_reg(X64_RAX, 8)
    let arg_4: i32 = CC_DA_COND_2[cond]
    if not x64_emitir(c, mi_cc(FX_SETCC8_R as u16, arg_4, arg_3)) {
        return false
    }
    return isel_guardar(c, i.dst, X64_RAX)
}

// C: nativo/x64/x64_isel.c:297
proc isel_neg(c: ^X64Ctx, i: ^bir.BirInstr) -> bool {
    let larg: u8 = isel_indice_largura(i.classe)
    if bir.bir_classe_eh_real(i.classe as i32) {
        return isel_neg_real(c, i)
    }
    if not isel_carregar(c, X64_RAX, &i.a, bir.BE_NENHUMA as u8) {
        return false
    }
    var tern_1: i32 = FX_NEG32_R
    if (larg as i32) != 0 {
        tern_1 = FX_NEG64_R
    }
    if not x64_emitir(c, mi1(tern_1 as u16, m_reg(X64_RAX, common.c2f_trunc_u8((32 << (common.c2f_s2u_32((larg as i32)) & 31)) as u64)))) {
        return false
    }
    return isel_guardar(c, i.dst, X64_RAX)
}

// C: nativo/x64/x64_isel.c:311
proc isel_mover(c: ^X64Ctx, i: ^bir.BirInstr) -> bool {
    if i.classe == (bir.BC_V128 as u8) {
        return isel_copia_vetor(c, i)
    }
    return (common.c2f_b2i32(isel_carregar(c, X64_RAX, &i.a, bir.BE_NENHUMA as u8)) != 0) and (common.c2f_b2i32(isel_guardar(c, i.dst, X64_RAX)) != 0)
}

// C: nativo/x64/x64_isel.c:318
proc isel_extensao_sinal(c: ^X64Ctx, i: ^bir.BirInstr) -> bool {
    return (common.c2f_b2i32(isel_carregar(c, X64_RAX, &i.a, bir.BE_SINAL as u8)) != 0) and (common.c2f_b2i32(isel_guardar(c, i.dst, X64_RAX)) != 0)
}

// C: nativo/x64/x64_isel.c:323
proc isel_extensao_zero(c: ^X64Ctx, i: ^bir.BirInstr) -> bool {
    return (common.c2f_b2i32(isel_carregar(c, X64_RAX, &i.a, bir.BE_ZERO as u8)) != 0) and (common.c2f_b2i32(isel_guardar(c, i.dst, X64_RAX)) != 0)
}

// C: nativo/x64/x64_isel.c:328
proc isel_end_simbolo(c: ^X64Ctx, i: ^bir.BirInstr) -> bool {
    var alvo: MOperando = m_mem(X64_RIP, 0, 64)
    alvo.simbolo = c.obj_sim[i.a.id]
    if not x64_emitir(c, mi2(FX_LEA64_RM as u16, m_reg(X64_RAX, 64), alvo)) {
        return false
    }
    return isel_guardar(c, i.dst, X64_RAX)
}

// C: nativo/x64/x64_isel.c:358
// REGRAS_ISEL[op].fn do C como tag de chamar_isel_fn; 0 = entrada NULL (op fora da tabela). Ordem de op = enum BirOp.
proc tag_isel_do_op(op: u8) -> u16 {
    let sw_1 = op as i32
    if (sw_1 == bir.BIR_CONST) or (sw_1 == bir.BIR_COPIA) or (sw_1 == bir.BIR_TRUNC) {
        return ISEL_FN_ISEL_MOVER
    } else if (sw_1 == bir.BIR_ADD) or (sw_1 == bir.BIR_SUB) or (sw_1 == bir.BIR_MUL) or (sw_1 == bir.BIR_AND) or (sw_1 == bir.BIR_OR) or (sw_1 == bir.BIR_XOR) {
        return ISEL_FN_ISEL_ARITMETICA
    } else if sw_1 == bir.BIR_NEG {
        return ISEL_FN_ISEL_NEG
    } else if sw_1 == bir.BIR_CMP {
        return ISEL_FN_ISEL_CMP
    } else if sw_1 == bir.BIR_EXT_S {
        return ISEL_FN_ISEL_EXTENSAO_SINAL
    } else if sw_1 == bir.BIR_EXT_Z {
        return ISEL_FN_ISEL_EXTENSAO_ZERO
    } else if (sw_1 == bir.BIR_ADD_OV) or (sw_1 == bir.BIR_SUB_OV) or (sw_1 == bir.BIR_MUL_OV) or (sw_1 == bir.BIR_NEG_OV) {
        return ISEL_FN_ISEL_OV
    } else if sw_1 == bir.BIR_END_SIMBOLO {
        return ISEL_FN_ISEL_END_SIMBOLO
    } else if (sw_1 == bir.BIR_CHAMA) or (sw_1 == bir.BIR_CHAMA_IND) {
        return ISEL_FN_ISEL_CHAMA
    } else if sw_1 == bir.BIR_SALTA {
        return ISEL_FN_ISEL_SALTA
    } else if sw_1 == bir.BIR_DESVIA {
        return ISEL_FN_ISEL_DESVIA
    } else if sw_1 == bir.BIR_RETORNA {
        return ISEL_FN_ISEL_RETORNA
    } else if sw_1 == bir.BIR_ARMADILHA {
        return ISEL_FN_ISEL_ARMADILHA
    } else if (sw_1 == bir.BIR_DIV) or (sw_1 == bir.BIR_REM) {
        return ISEL_FN_ISEL_DIVISAO
    } else if (sw_1 == bir.BIR_SHL) or (sw_1 == bir.BIR_SHR) {
        return ISEL_FN_ISEL_DESLOCAMENTO
    } else if sw_1 == bir.BIR_NOT {
        return ISEL_FN_ISEL_NOT
    } else if sw_1 == bir.BIR_I_PARA_F {
        return ISEL_FN_ISEL_I_PARA_F
    } else if sw_1 == bir.BIR_F_PARA_F {
        return ISEL_FN_ISEL_F_PARA_F
    } else if sw_1 == bir.BIR_RAIZ {
        return ISEL_FN_ISEL_RAIZ
    } else if sw_1 == bir.BIR_SELECIONA {
        return ISEL_FN_ISEL_SELECIONA
    } else if sw_1 == bir.BIR_SPLAT {
        return ISEL_FN_ISEL_SPLAT
    } else if sw_1 == bir.BIR_END_SLOT {
        return ISEL_FN_ISEL_END_SLOT
    } else if sw_1 == bir.BIR_CARREGA {
        return ISEL_FN_ISEL_CARREGA
    } else if sw_1 == bir.BIR_GRAVA {
        return ISEL_FN_ISEL_GRAVA
    } else if sw_1 == bir.BIR_COPIA_MEM {
        return ISEL_FN_ISEL_COPIA_MEM
    } else if sw_1 == bir.BIR_ZERA_MEM {
        return ISEL_FN_ISEL_ZERA_MEM
    }
    return 0
}

// C: nativo/x64/x64_isel.c:358
// c.instr = fatia de 1 sobre a instrucao corrente (len 0 = NULL do C); c.instr_idx quem chama (gerar_corpo) fixa antes.
proc x64_selecionar(c: ^X64Ctx, i: ^bir.BirInstr) -> bool {
    c.instr = slice_from(i, len = 1)
    let tag: u16 = tag_isel_do_op(i.op)
    if (i.op as i32 < bir.BIR_QTD) and (tag != 0) {
        return chamar_isel_fn(tag, c, i)
    }
    let numero: str = format(f"#{i.op}", alloc = frame)
    return x64_sem_regra(c, numero, "operacao fora da tabela REGRAS_ISEL")
}

test "x64_isel_tag_do_op_cobre_os_39" {
    var n: int = 0
    for op in 0..<39 {
        let t: u16 = tag_isel_do_op(op as u8)
        expect((t >= 1) and (t <= 26))
        n += 1
    }
    expect(n == 39)
    expect(tag_isel_do_op(bir.BIR_CONST as u8) == ISEL_FN_ISEL_MOVER)
    expect(tag_isel_do_op(bir.BIR_CHAMA_IND as u8) == ISEL_FN_ISEL_CHAMA)
    expect(tag_isel_do_op(bir.BIR_REM as u8) == ISEL_FN_ISEL_DIVISAO)
    expect(tag_isel_do_op(bir.BIR_ZERA_MEM as u8) == ISEL_FN_ISEL_ZERA_MEM)
    expect(tag_isel_do_op(39) == 0)
}

test "x64_isel_formas_arit" {
    let soma: FormasAritmeticas = formas_arit(bir.BIR_ADD as u8)
    expect(soma.rr[0] == FX_ADD32_RR as u16)
    expect(soma.rr[1] == FX_ADD64_RR as u16)
    expect(soma.ri[0] == FX_ADD32_RI as u16)
    expect(soma.ri[1] == FX_ADD64_RI as u16)
    let sub: FormasAritmeticas = formas_arit(bir.BIR_SUB as u8)
    expect(sub.ri[0] == FX_SUB32_RI as u16)
    let mul: FormasAritmeticas = formas_arit(bir.BIR_MUL as u8)
    expect(mul.rr[0] == FX_IMUL32_RR as u16)
    expect(mul.ri[0] == FX_QTD as u16)
    let cmp: FormasAritmeticas = formas_arit(bir.BIR_CMP as u8)
    expect(cmp.ri[1] == FX_CMP64_RI as u16)
    let fora: FormasAritmeticas = formas_arit(bir.BIR_CONST as u8)
    expect(fora.rr[0] == 0)
    expect(fora.ri[1] == 0)
}

test "x64_isel_base_do_ov" {
    expect(base_do_ov(bir.BIR_ADD_OV as u8) == bir.BIR_ADD as u8)
    expect(base_do_ov(bir.BIR_SUB_OV as u8) == bir.BIR_SUB as u8)
    expect(base_do_ov(bir.BIR_MUL_OV as u8) == bir.BIR_MUL as u8)
    expect(base_do_ov(bir.BIR_NEG_OV as u8) == bir.BIR_SUB as u8)
    expect(base_do_ov(bir.BIR_CONST as u8) == 0)
}
