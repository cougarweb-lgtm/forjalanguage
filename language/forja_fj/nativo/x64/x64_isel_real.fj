import "common"
import "nativo/bir"

struct ContaReal {
    op: u8
    ss: u16
    sd: u16
}

struct ComparacaoReal {
    troca: bool
    cc: i32
    paridade: u8
}

struct ContaVetorial {
    op: u8
    ps: u16
    pd: u16
}

const XMM_A_2: u32 = 0
const XMM_B_2: u32 = 1
const XMM_SEM_REGISTRADOR: i32 = -1
const CONTAS_REAIS: [4]ContaReal = {ContaReal{op = 2, ss = 87, sd = 91}, ContaReal{op = 3, ss = 88, sd = 92}, ContaReal{op = 4, ss = 89, sd = 93}, ContaReal{op = 23, ss = 90, sd = 94}}
const COMPARACOES_REAIS: [6]ComparacaoReal = {ComparacaoReal{troca = false, cc = 4, paridade = 1}, ComparacaoReal{troca = false, cc = 5, paridade = 2}, ComparacaoReal{troca = true, cc = 7, paridade = 0}, ComparacaoReal{troca = true, cc = 3, paridade = 0}, ComparacaoReal{troca = false, cc = 7, paridade = 0}, ComparacaoReal{troca = false, cc = 3, paridade = 0}}
const CONTAS_VETORIAIS: [4]ContaVetorial = {ContaVetorial{op = 2, ps = 127, pd = 131}, ContaVetorial{op = 3, ps = 128, pd = 132}, ContaVetorial{op = 4, ps = 129, pd = 133}, ContaVetorial{op = 23, ps = 130, pd = 134}}

// C: nativo/x64/x64_isel_real.c:24
proc carregar_imediato_real(c: ^X64Ctx, xmm: u8, o: ^bir.BirOperando) -> bool {
    if o.classe == (bir.BC_F64 as u8) {
        if not x64_emitir(c, mi2(FX_MOV64_RI as u16, m_reg(X64_R11, 64), m_imed(o.imed))) {
            return false
        }
        return x64_emitir(c, mi2(FX_MOVQ_XR as u16, m_xmm(xmm), m_reg(X64_R11, 64)))
    }
    if not x64_emitir(c, mi2(FX_MOV32_RI as u16, m_reg(X64_R11, 32), m_imed(common.c2f_trunc_i32(common.c2f_s2u_64(o.imed)) as i64))) {
        return false
    }
    return x64_emitir(c, mi2(FX_MOVD_XR as u16, m_xmm(xmm), m_reg(X64_R11, 32)))
}

// C: nativo/x64/x64_isel_real.c:33
proc isel_carregar_real(c: ^X64Ctx, xmm: u8, o: ^bir.BirOperando) -> bool {
    let dupla: bool = o.classe == (bir.BC_F64 as u8)
    let arg_1: u8 = aloc_bits(o.classe)
    let arg_2: u32 = o.id
    let arg_3: ?^bir.BirFuncao = c.f
    var vreg: AlocOperando = aloc_operando_de(arg_3, arg_2, arg_1)
    if o.tipo == (bir.BO_IMED as u8) {
        return carregar_imediato_real(c, xmm, o)
    }
    if o.tipo != (bir.BO_VREG as u8) {
        return x64_sem_regra(c, "operando", "esperava vreg ou imediato real")
    }
    var tern_1: i32 = FX_MOVSS_XM
    if common.c2f_b2i32(dupla) != 0 {
        tern_1 = FX_MOVSD_XM
    }
    return aloc_carregar(c, tern_1 as u16, m_xmm(xmm), &vreg)
}

// C: nativo/x64/x64_isel_real.c:45
proc isel_guardar_xmm(c: ^X64Ctx, classe: u8, memoria: MOperando, xmm: u8) -> bool {
    var tern_1: i32 = FX_MOVSS_MX
    if classe == (bir.BC_F64 as u8) {
        tern_1 = FX_MOVSD_MX
    }
    return x64_emitir(c, mi2(tern_1 as u16, memoria, m_xmm(xmm)))
}

// C: nativo/x64/x64_isel_real.c:50
proc isel_guardar_real(c: ^X64Ctx, vreg: u32, xmm: u8) -> bool {
    let classe: u8 = ((c.f as ^bir.BirFuncao).classe_vreg or_else {})[vreg]
    let arg_1: u8 = aloc_bits(classe)
    let arg_2: u32 = vreg
    let arg_3: ?^bir.BirFuncao = c.f
    var destino: AlocOperando = aloc_operando_de(arg_3, arg_2, arg_1)
    var tern_1: i32 = FX_MOVSS_MX
    if classe == (bir.BC_F64 as u8) {
        tern_1 = FX_MOVSD_MX
    }
    return aloc_gravar(c, tern_1 as u16, &destino, m_xmm(xmm))
}

// C: nativo/x64/x64_isel_real.c:68
proc emitir_conta_real(c: ^X64Ctx, i: ^bir.BirInstr, conta: ^ContaReal) -> bool {
    if (not isel_carregar_real(c, XMM_A_2 as u8, &i.a)) or (not isel_carregar_real(c, XMM_B_2 as u8, &i.b)) {
        return false
    }
    var tern_1: i32 = conta.ss as i32
    if i.classe == (bir.BC_F64 as u8) {
        tern_1 = conta.sd as i32
    }
    let arg_1: MOperando = m_xmm(XMM_B_2 as u8)
    let arg_2: MOperando = m_xmm(XMM_A_2 as u8)
    let arg_3: u16 = tern_1 as u16
    if not x64_emitir(c, mi2(arg_3, arg_2, arg_1)) {
        return false
    }
    return isel_guardar_real(c, i.dst, XMM_A_2 as u8)
}

// C: nativo/x64/x64_isel_real.c:78
proc isel_conta_real(c: ^X64Ctx, i: ^bir.BirInstr) -> bool {
    for k in (0 as u32)..<(len(CONTAS_REAIS) as u32) {
        if CONTAS_REAIS[k].op == i.op {
            var conta: ContaReal = CONTAS_REAIS[k]
            return emitir_conta_real(c, i, &conta)
        }
    }
    return x64_sem_regra(c, "conta real", "operacao sem forma SSE")
}

// C: nativo/x64/x64_isel_real.c:88
proc isel_neg_real(c: ^X64Ctx, i: ^bir.BirInstr) -> bool {
    var mascara: MOperando = m_mem(X64_RIP, 0, 64)
    mascara.simbolo = c.obj_sim[i.b.id]
    if not isel_carregar_real(c, XMM_A_2 as u8, &i.a) {
        return false
    }
    if not x64_emitir(c, mi2(FX_LEA64_RM as u16, m_reg(X64_RAX, 64), mascara)) {
        return false
    }
    if not x64_emitir(c, mi2(FX_XORPS_XM as u16, m_xmm(XMM_A_2 as u8), m_mem(X64_RAX, 0, 128))) {
        return false
    }
    return isel_guardar_real(c, i.dst, XMM_A_2 as u8)
}

// C: nativo/x64/x64_isel_real.c:111
proc juntar_paridade(c: ^X64Ctx, paridade: u8) -> bool {
    var tern_1: i32 = X64_CC_P
    if paridade == 1 {
        tern_1 = X64_CC_NP
    }
    let cc: i32 = tern_1
    if not x64_emitir(c, mi_cc(FX_SETCC8_R as u16, cc, m_reg(X64_RCX, 8))) {
        return false
    }
    var tern_2: i32 = FX_OR32_RR
    if paridade == 1 {
        tern_2 = FX_AND32_RR
    }
    let arg_1: MOperando = m_reg(X64_RCX, 32)
    let arg_2: MOperando = m_reg(X64_RAX, 32)
    let arg_3: u16 = tern_2 as u16
    return x64_emitir(c, mi2(arg_3, arg_2, arg_1))
}

// C: nativo/x64/x64_isel_real.c:121
proc carregar_operandos_da_comparacao(c: ^X64Ctx, i: ^bir.BirInstr, k: ^ComparacaoReal) -> bool {
    var tern_1: ^bir.BirOperando = &i.a
    if common.c2f_b2i32(k.troca) != 0 {
        tern_1 = &i.b
    }
    let esq: ^bir.BirOperando = tern_1
    var tern_2: ^bir.BirOperando = &i.b
    if common.c2f_b2i32(k.troca) != 0 {
        tern_2 = &i.a
    }
    let dir: ^bir.BirOperando = tern_2
    return (common.c2f_b2i32(isel_carregar_real(c, XMM_A_2 as u8, esq)) != 0) and (common.c2f_b2i32(isel_carregar_real(c, XMM_B_2 as u8, dir)) != 0)
}

// C: nativo/x64/x64_isel_real.c:130
proc emitir_teste_da_comparacao(c: ^X64Ctx, i: ^bir.BirInstr, k: ^ComparacaoReal) -> bool {
    var tern_1: i32 = FX_UCOMISS_XX
    if i.a.classe == (bir.BC_F64 as u8) {
        tern_1 = FX_UCOMISD_XX
    }
    let arg_1: MOperando = m_xmm(XMM_B_2 as u8)
    let arg_2: MOperando = m_xmm(XMM_A_2 as u8)
    let arg_3: u16 = tern_1 as u16
    if not x64_emitir(c, mi2(arg_3, arg_2, arg_1)) {
        return false
    }
    let arg_4: MOperando = m_reg(X64_RAX, 8)
    let arg_5: i32 = k.cc
    if not x64_emitir(c, mi_cc(FX_SETCC8_R as u16, arg_5, arg_4)) {
        return false
    }
    return (k.paridade == 0) or (common.c2f_b2i32(juntar_paridade(c, k.paridade)) != 0)
}

// C: nativo/x64/x64_isel_real.c:139
proc isel_cmp_real(c: ^X64Ctx, i: ^bir.BirInstr) -> bool {
    if (i.aux < (bir.BCOND_FEQ as u8)) or (i.aux > (bir.BCOND_FGE as u8)) {
        return x64_sem_regra(c, "cmp", "condicao inteira em operando real")
    }
    let idx: u32 = (i.aux - (bir.BCOND_FEQ as u8)) as u32
    var k: ComparacaoReal = COMPARACOES_REAIS[idx]
    if not carregar_operandos_da_comparacao(c, i, &k) {
        return false
    }
    if not emitir_teste_da_comparacao(c, i, &k) {
        return false
    }
    return isel_guardar(c, i.dst, X64_RAX)
}

// C: nativo/x64/x64_isel_real.c:156
proc forma_da_conversao_i_para_f(dupla: bool, r64: bool) -> u16 {
    if dupla {
        var tern_1: i32 = FX_CVTSI2SD_XR32
        if common.c2f_b2i32(r64) != 0 {
            tern_1 = FX_CVTSI2SD_XR64
        }
        return tern_1 as u16
    }
    var tern_2: i32 = FX_CVTSI2SS_XR32
    if common.c2f_b2i32(r64) != 0 {
        tern_2 = FX_CVTSI2SS_XR64
    }
    return tern_2 as u16
}

// C: nativo/x64/x64_isel_real.c:164
proc emitir_conversao_i_para_f(c: ^X64Ctx, forma: u16, r64: bool) -> bool {
    var largura: u8 = 32
    if r64 {
        largura = 64
    }
    return x64_emitir(c, mi2(forma, m_xmm(XMM_A_2 as u8), m_reg(X64_RAX, largura)))
}

// C: nativo/x64/x64_isel_real.c:170
proc isel_i_para_f(c: ^X64Ctx, i: ^bir.BirInstr) -> bool {
    let alarga: bool = (i.a.classe == (bir.BC_I32 as u8)) and (i.aux == (bir.BIR_SEM_SINAL as u8))
    let r64: bool = (i.a.classe == (bir.BC_I64 as u8)) or (common.c2f_b2i32(alarga) != 0)
    let forma: u16 = forma_da_conversao_i_para_f(i.classe == (bir.BC_F64 as u8), r64)
    var tern_1: i32 = bir.BE_NENHUMA
    if common.c2f_b2i32(alarga) != 0 {
        tern_1 = bir.BE_ZERO
    }
    if not isel_carregar(c, X64_RAX, &i.a, tern_1 as u8) {
        return false
    }
    if not emitir_conversao_i_para_f(c, forma, r64) {
        return false
    }
    return isel_guardar_real(c, i.dst, XMM_A_2 as u8)
}

// C: nativo/x64/x64_isel_real.c:184
proc isel_raiz(c: ^X64Ctx, i: ^bir.BirInstr) -> bool {
    var forma: u16 = FX_SQRTSS_XX as u16
    if i.classe == (bir.BC_F64 as u8) {
        forma = FX_SQRTSD_XX as u16
    }
    if not isel_carregar_real(c, XMM_A_2 as u8, &i.a) {
        return false
    }
    if not x64_emitir(c, mi2(forma, m_xmm(XMM_A_2 as u8), m_xmm(XMM_A_2 as u8))) {
        return false
    }
    return isel_guardar_real(c, i.dst, XMM_A_2 as u8)
}

// C: nativo/x64/x64_isel_real.c:198
proc vetor_em_xmm(c: ^X64Ctx, vreg: u32) -> i32 {
    let arg_1: u8 = aloc_bits(bir.BC_V128 as u8)
    let arg_2: u32 = vreg
    let arg_3: ?^bir.BirFuncao = c.f
    let o: AlocOperando = aloc_operando_de(arg_3, arg_2, arg_1)
    var tern_1: i32 = XMM_SEM_REGISTRADOR
    if common.c2f_b2i32(o.em_reg) != 0 {
        tern_1 = o.reg
    }
    return tern_1
}

// C: nativo/x64/x64_isel_real.c:205
proc isel_carregar_vetor(c: ^X64Ctx, xmm: u8, vreg: u32) -> bool {
    let arg_1: u8 = aloc_bits(bir.BC_V128 as u8)
    let arg_2: u32 = vreg
    let arg_3: ?^bir.BirFuncao = c.f
    var origem: AlocOperando = aloc_operando_de(arg_3, arg_2, arg_1)
    return aloc_carregar(c, FX_MOVUPS_XM as u16, m_xmm(xmm), &origem)
}

// C: nativo/x64/x64_isel_real.c:212
proc isel_guardar_vetor(c: ^X64Ctx, vreg: u32, xmm: u8) -> bool {
    let arg_1: u8 = aloc_bits(bir.BC_V128 as u8)
    let arg_2: u32 = vreg
    let arg_3: ?^bir.BirFuncao = c.f
    var destino: AlocOperando = aloc_operando_de(arg_3, arg_2, arg_1)
    if (common.c2f_b2i32(destino.em_reg) != 0) and (((destino.reg as u8) as i32) == (xmm as i32)) {
        return true
    }
    return aloc_gravar(c, FX_MOVUPS_MX as u16, &destino, m_xmm(xmm))
}

// C: nativo/x64/x64_isel_real.c:222
proc vetor_para_xmm(c: ^X64Ctx, o: ^bir.BirOperando, rascunho: u8, xmm: ^u8) -> bool {
    let registrador: i32 = vetor_em_xmm(c, o.id)
    if registrador != XMM_SEM_REGISTRADOR {
        xmm^ = registrador as u8
        return true
    }
    xmm^ = rascunho
    return isel_carregar_vetor(c, rascunho, o.id)
}

// C: nativo/x64/x64_isel_real.c:243
proc xmm_do_resultado_vetorial(c: ^X64Ctx, i: ^bir.BirInstr) -> u8 {
    let destino: i32 = vetor_em_xmm(c, i.dst)
    let primeiro: i32 = vetor_em_xmm(c, i.a.id)
    let segundo: i32 = vetor_em_xmm(c, i.b.id)
    if (destino == XMM_SEM_REGISTRADOR) or ((destino == segundo) and (destino != primeiro)) {
        return XMM_A_2 as u8
    }
    return destino as u8
}

// C: nativo/x64/x64_isel_real.c:254
proc isel_conta_vetorial(c: ^X64Ctx, i: ^bir.BirInstr) -> bool {
    let alvo: u8 = xmm_do_resultado_vetorial(c, i)
    var achada: i32 = -1
    for k in (0 as u32)..<(len(CONTAS_VETORIAIS) as u32) {
        if CONTAS_VETORIAIS[k].op == i.op {
            achada = k as i32
        }
    }
    if achada < 0 {
        return x64_sem_regra(c, "conta vetorial", "operacao sem forma SSE empacotada")
    }
    let conta: ContaVetorial = CONTAS_VETORIAIS[achada as u32]
    if vetor_em_xmm(c, i.a.id) != (alvo as i32) {
        if not isel_carregar_vetor(c, alvo, i.a.id) {
            return false
        }
    }
    var segundo: u8 = 0
    if not vetor_para_xmm(c, &i.b, XMM_B_2 as u8, &segundo) {
        return false
    }
    var forma: u16 = conta.ps
    if i.aux == (bir.BVEC_2XF64 as u8) {
        forma = conta.pd
    }
    if not x64_emitir(c, mi2(forma, m_xmm(alvo), m_xmm(segundo))) {
        return false
    }
    return isel_guardar_vetor(c, i.dst, alvo)
}

// C: nativo/x64/x64_isel_real.c:275
proc isel_splat(c: ^X64Ctx, i: ^bir.BirInstr) -> bool {
    let destino: i32 = vetor_em_xmm(c, i.dst)
    var alvo: u8 = XMM_A_2 as u8
    if destino != XMM_SEM_REGISTRADOR {
        alvo = destino as u8
    }
    var difundir: MInstr = mi3(FX_SHUFPS_XXI as u16, m_xmm(alvo), m_xmm(alvo), m_imed(0))
    if i.aux == (bir.BVEC_2XF64 as u8) {
        difundir = mi2(FX_UNPCKLPD_XX as u16, m_xmm(alvo), m_xmm(alvo))
    }
    if not isel_carregar_real(c, alvo, &i.a) {
        return false
    }
    if not x64_emitir(c, difundir) {
        return false
    }
    return isel_guardar_vetor(c, i.dst, alvo)
}

// C: nativo/x64/x64_isel_real.c:286
proc isel_copia_vetor(c: ^X64Ctx, i: ^bir.BirInstr) -> bool {
    let destino: i32 = vetor_em_xmm(c, i.dst)
    var origem: u8 = 0
    var rascunho: u8 = XMM_A_2 as u8
    if destino != XMM_SEM_REGISTRADOR {
        rascunho = destino as u8
    }
    if not vetor_para_xmm(c, &i.a, rascunho, &origem) {
        return false
    }
    return isel_guardar_vetor(c, i.dst, origem)
}

// C: nativo/x64/x64_isel_real.c:296
proc isel_carrega_vetor(c: ^X64Ctx, i: ^bir.BirInstr) -> bool {
    let destino: i32 = vetor_em_xmm(c, i.dst)
    var alvo: u8 = XMM_A_2 as u8
    if destino != XMM_SEM_REGISTRADOR {
        alvo = destino as u8
    }
    if not isel_carregar(c, X64_RCX, &i.a, bir.BE_NENHUMA as u8) {
        return false
    }
    let arg_1: u8 = aloc_bits(bir.BC_V128 as u8)
    let arg_2: i32 = i.desloc
    let arg_3: MOperando = m_mem(X64_RCX, arg_2, arg_1)
    if not x64_emitir(c, mi2(FX_MOVUPS_XM as u16, m_xmm(alvo), arg_3)) {
        return false
    }
    return isel_guardar_vetor(c, i.dst, alvo)
}

// C: nativo/x64/x64_isel_real.c:308
proc isel_grava_vetor(c: ^X64Ctx, i: ^bir.BirInstr) -> bool {
    var valor: u8 = 0
    if (not isel_carregar(c, X64_RCX, &i.a, bir.BE_NENHUMA as u8)) or (not vetor_para_xmm(c, &i.b, XMM_A_2 as u8, &valor)) {
        return false
    }
    let arg_1: u8 = aloc_bits(bir.BC_V128 as u8)
    let arg_2: i32 = i.desloc
    let arg_3: MOperando = m_xmm(valor)
    let arg_4: MOperando = m_mem(X64_RCX, arg_2, arg_1)
    return x64_emitir(c, mi2(FX_MOVUPS_MX as u16, arg_4, arg_3))
}

// C: nativo/x64/x64_isel_real.c:318
proc isel_f_para_f(c: ^X64Ctx, i: ^bir.BirInstr) -> bool {
    var forma: u16 = FX_CVTSD2SS_XX as u16
    if i.classe == (bir.BC_F64 as u8) {
        forma = FX_CVTSS2SD_XX as u16
    }
    if not isel_carregar_real(c, XMM_A_2 as u8, &i.a) {
        return false
    }
    if not x64_emitir(c, mi2(forma, m_xmm(XMM_A_2 as u8), m_xmm(XMM_A_2 as u8))) {
        return false
    }
    return isel_guardar_real(c, i.dst, XMM_A_2 as u8)
}

test "x64_isel_real: forma do cvtsi2s por tipo e largura" {
    expect(forma_da_conversao_i_para_f(false, false) == FX_CVTSI2SS_XR32 as u16)
    expect(forma_da_conversao_i_para_f(false, true) == FX_CVTSI2SS_XR64 as u16)
    expect(forma_da_conversao_i_para_f(true, false) == FX_CVTSI2SD_XR32 as u16)
    expect(forma_da_conversao_i_para_f(true, true) == FX_CVTSI2SD_XR64 as u16)
}

test "x64_isel_real: tabela CONTAS_REAIS na ordem ADD SUB MUL DIV" {
    expect(len(CONTAS_REAIS) == 4)
    expect(CONTAS_REAIS[0].op == bir.BIR_ADD as u8)
    expect(CONTAS_REAIS[0].ss == FX_ADDSS_XX as u16)
    expect(CONTAS_REAIS[0].sd == FX_ADDSD_XX as u16)
    expect(CONTAS_REAIS[1].op == bir.BIR_SUB as u8)
    expect(CONTAS_REAIS[1].ss == FX_SUBSS_XX as u16)
    expect(CONTAS_REAIS[1].sd == FX_SUBSD_XX as u16)
    expect(CONTAS_REAIS[2].op == bir.BIR_MUL as u8)
    expect(CONTAS_REAIS[2].ss == FX_MULSS_XX as u16)
    expect(CONTAS_REAIS[2].sd == FX_MULSD_XX as u16)
    expect(CONTAS_REAIS[3].op == bir.BIR_DIV as u8)
    expect(CONTAS_REAIS[3].ss == FX_DIVSS_XX as u16)
    expect(CONTAS_REAIS[3].sd == FX_DIVSD_XX as u16)
}

test "x64_isel_real: tabela CONTAS_VETORIAIS ps e pd na ordem ADD SUB MUL DIV" {
    expect(len(CONTAS_VETORIAIS) == 4)
    expect(CONTAS_VETORIAIS[0].op == bir.BIR_ADD as u8)
    expect(CONTAS_VETORIAIS[0].ps == FX_ADDPS_XX as u16)
    expect(CONTAS_VETORIAIS[0].pd == FX_ADDPD_XX as u16)
    expect(CONTAS_VETORIAIS[1].op == bir.BIR_SUB as u8)
    expect(CONTAS_VETORIAIS[1].ps == FX_SUBPS_XX as u16)
    expect(CONTAS_VETORIAIS[1].pd == FX_SUBPD_XX as u16)
    expect(CONTAS_VETORIAIS[2].op == bir.BIR_MUL as u8)
    expect(CONTAS_VETORIAIS[2].ps == FX_MULPS_XX as u16)
    expect(CONTAS_VETORIAIS[2].pd == FX_MULPD_XX as u16)
    expect(CONTAS_VETORIAIS[3].op == bir.BIR_DIV as u8)
    expect(CONTAS_VETORIAIS[3].ps == FX_DIVPS_XX as u16)
    expect(CONTAS_VETORIAIS[3].pd == FX_DIVPD_XX as u16)
}

test "x64_isel_real: tabela COMPARACOES_REAIS na ordem BCOND_FEQ..BCOND_FGE" {
    expect(len(COMPARACOES_REAIS) == 6)
    expect((bir.BCOND_FGE - bir.BCOND_FEQ) == 5)
    expect(COMPARACOES_REAIS[0].troca == false)
    expect(COMPARACOES_REAIS[0].cc == X64_CC_E)
    expect(COMPARACOES_REAIS[0].paridade == 1)
    expect(COMPARACOES_REAIS[1].troca == false)
    expect(COMPARACOES_REAIS[1].cc == X64_CC_NE)
    expect(COMPARACOES_REAIS[1].paridade == 2)
    expect(COMPARACOES_REAIS[2].troca)
    expect(COMPARACOES_REAIS[2].cc == X64_CC_A)
    expect(COMPARACOES_REAIS[2].paridade == 0)
    expect(COMPARACOES_REAIS[3].troca)
    expect(COMPARACOES_REAIS[3].cc == X64_CC_AE)
    expect(COMPARACOES_REAIS[4].troca == false)
    expect(COMPARACOES_REAIS[4].cc == X64_CC_A)
    expect(COMPARACOES_REAIS[5].troca == false)
    expect(COMPARACOES_REAIS[5].cc == X64_CC_AE)
}
