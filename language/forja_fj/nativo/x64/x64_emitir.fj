import "common"
import "nativo/bir"
import "nativo/obj"

const EMITIR_CAMPO_REL: u32 = 4

// C: nativo/x64/x64_emitir.c:14
proc secao_texto(c: ^X64Ctx) -> ^obj.ObjSecao {
    return &(c.o as ^obj.Objeto).secoes[c.texto as u64]
}

// C: nativo/x64/x64_emitir.c:19
proc x64_offset(c: ^X64Ctx) -> u32 {
    return (len(secao_texto(c).bytes) as u64) as u32
}

// C: nativo/x64/x64_emitir.c:25
proc registrar_operando(c: ^X64Ctx, op: ^MOperando, fim: u32) {
    let onde: obj.ObjAlvoReloc = obj.ObjAlvoReloc{secao = c.texto, off = wrapping_sub(fim, EMITIR_CAMPO_REL)}
    if common.c2f_s2u_32(op.tipo) == (MO_BLOCO as u32) {
        append(&c.saltos, item = SaltoLocal{})
        let s: ^SaltoLocal = &c.saltos[len(c.saltos) - 1]
        s.fim = fim
        s.bloco = op.imed as u32
    } else if (common.c2f_s2u_32(op.tipo) == (MO_SIMBOLO as u32)) or ((common.c2f_s2u_32(op.tipo) == (MO_MEM as u32)) and (common.c2f_s2u_32(op.base) == (X64_RIP as u32))) {
        obj.obj_relocar(c.o as ^obj.Objeto, onde, obj.ObjCorrecao{tipo = obj.OR_REL32, simbolo = op.simbolo, adendo = 0})
    }
}

// C: nativo/x64/x64_emitir.c:39
proc recusada_com_texto(c: ^X64Ctx, mi: ^MInstr) -> bool {
    var texto = make([dynamic]u8, alloc = heap, cap = 64)
    defer delete(texto)
    x64_formatar(mi, &texto)
    var dados: str = "?"
    if len(texto) > 0 {
        dados = from_bytes(texto[..], alloc = frame)
    }
    let msg_1 = format(f"codificador x64 recusou a instrucao '{dados}'", alloc = heap)
    defer delete(msg_1)
    return common.diag_relatar(c.erro as ^common.Diag, common.X0902, mi.pos, msg_1)
}

// C: nativo/x64/x64_emitir.c:51
proc pos_do_erro(c: ^X64Ctx) -> u32 {
    var pos: u32 = bir.BIR_SEM_POS
    if len(c.instr) > 0 {
        pos = c.instr[0].pos
    } else if c.f != none {
        pos = (c.f as ^bir.BirFuncao).pos
    }
    if pos != bir.BIR_SEM_POS {
        return pos
    }
    return 0
}

// C: nativo/x64/x64_emitir.c:58
proc x64_emitir(c: ^X64Ctx, mi: MInstr) -> bool {
    var bytes: [15]u8 = {}
    var tam: u32 = 0
    var m = mi
    m.pos = pos_do_erro(c)
    if not x64_codificar_instr(c.formas, &m, bytes[..], &tam, c.erro as ^common.Diag) {
        return recusada_com_texto(c, &m)
    }
    let texto = secao_texto(c)
    for k in 0..<(tam as int) {
        append(&texto.bytes, item = bytes[k])
    }
    for k in 0..<(m.nops as int) {
        registrar_operando(c, &m.op[k], x64_offset(c))
    }
    if c.lista != none {
        x64_listar_instr(c, &m, tam)
    }
    if c.rastreio {
        x64_rastro_chamada(c, &m)
    }
    return true
}

// C: nativo/x64/x64_emitir.c:77
proc x64_corrigir_saltos(c: ^X64Ctx) {
    let texto = secao_texto(c)
    for k in 0..<len(c.saltos) {
        let s: ^SaltoLocal = &c.saltos[k]
        let alvo = (c.bloco_off or_else {})[s.bloco]
        let rel = common.c2f_trunc_i32(wrapping_sub(alvo, s.fim) as u64)
        common.c2f_gravar_u32_le(texto.bytes[..], (s.fim - EMITIR_CAMPO_REL) as int, common.c2f_s2u_32(rel))
    }
    clear(&c.saltos)
}

// C: nativo/x64/x64_emitir.c:90
proc x64_padding(c: ^X64Ctx) {
    let texto = secao_texto(c)
    while (len(texto.bytes) as u64) % (X64_ALINHAMENTO_FUNCAO as u64) != 0 {
        append(&texto.bytes, item = (X64_BYTE_PADDING as u8))
    }
}

// C: nativo/x64/x64_emitir.c:99
proc x64_sem_regra(c: ^X64Ctx, nome: str, motivo: str) -> bool {
    let msg_1 = format(f"selecao de instrucoes sem regra para a BirOp {nome}: {motivo}", alloc = heap)
    defer delete(msg_1)
    return common.diag_relatar(c.erro as ^common.Diag, common.X0901, pos_do_erro(c), msg_1)
}

// Teste dirigido: o padding da funcao completa o .text ate multiplo de 16 com 0xCC (X64_BYTE_PADDING).
test "x64_emitir_padding_alinha_16" {
    var o: obj.Objeto = obj.Objeto{}
    o.secoes = make([dynamic]obj.ObjSecao, alloc = heap, cap = 1)
    defer delete(o.secoes)
    append(&o.secoes, item = obj.ObjSecao{bytes = make([dynamic]u8, alloc = frame, cap = 32)})
    var c: X64Ctx = X64Ctx{o = &o, texto = 0}
    for k in 0..<5 {
        append(&o.secoes[0].bytes, item = (1 as u8))
    }
    x64_padding(&c)
    expect(len(o.secoes[0].bytes) == 16)
    expect(o.secoes[0].bytes[5] == 204)
    expect(o.secoes[0].bytes[4] == 1)
}
