import "common"
import "nativo/bir"

struct EntradaSysv {
    arg: [16]bir.AbiSysvArg
    campos: [16][16]bir.AbiSysvCampo
    ret: bir.AbiSysvArg
    campos_ret: [16]bir.AbiSysvCampo
}

const SYSV_MAX_FOLHAS: u32 = 16
const SYSV_BYTES_OITO: u32 = 8
const REGS: [7]i32 = {0, 2, 7, 6, 1, 8, 9}

// C: nativo/x64/x64_chamada_sysv.c:29
proc registrador_do_sysv(reg: i32) -> i32 {
    return REGS[common.c2f_s2u_32(reg)]
}

// C: nativo/x64/x64_chamada_sysv.c:36
proc tam_do_escalar_sysv(classe: u8) -> u32 {
    let sw_1 = classe as i32
    if sw_1 == bir.BC_I8 {
        return 1
    } else if sw_1 == bir.BC_I16 {
        return 2
    } else if sw_1 == bir.BC_I32 or sw_1 == bir.BC_F32 {
        return 4
    } else {
        return 8
    }
    return 0
}

// C: nativo/x64/x64_chamada_sysv.c:46
proc preencher_escalar(e: ^EntradaSysv, k: u32, classe: u8) {
    let tam: u32 = tam_do_escalar_sysv(classe)
    var classe_campo: i32 = bir.ABI_SYSV_INTEIRO
    if bir.bir_classe_eh_real(classe as i32) {
        classe_campo = bir.ABI_SYSV_SSE
    }
    e.campos[k][0] = bir.AbiSysvCampo{classe = classe_campo, deslocamento = 0, alinhamento = tam}
    e.arg[k] = bir.AbiSysvArg{tam = tam, campos = e.campos[k][..], n_campos = 1}
}

// C: nativo/x64/x64_chamada_sysv.c:55
// C2F-INDECIDIVEL: campos
proc preencher_agregado(arg: ^bir.AbiSysvArg, campos: []bir.AbiSysvCampo, o: ^bir.BirOperando) {
    var f: u32 = 0
    while f < (o.sysv as ^bir.BirSysv).n {
        let folha: ^bir.BirFolhaSysv = &((o.sysv as ^bir.BirSysv).folhas or_else {})[f]
        var tern_1: i32 = bir.ABI_SYSV_INTEIRO
        if (folha.sse as i32) != 0 {
            tern_1 = bir.ABI_SYSV_SSE
        }
        campos[f] = bir.AbiSysvCampo{classe = tern_1, deslocamento = folha.deslocamento, alinhamento = folha.alinhamento}
        f += 1
    }
    arg^ = bir.AbiSysvArg{tam = (o.sysv as ^bir.BirSysv).tam, campos = campos, n_campos = (o.sysv as ^bir.BirSysv).n}
}

// C: nativo/x64/x64_chamada_sysv.c:66
proc preparar_argumentos(i: ^bir.BirInstr, e: ^EntradaSysv) -> bool {
    var k: u32 = 0
    while k < i.nargs {
        let o: ^bir.BirOperando = &(i.args or_else {})[k]
        if o.tam == 0 {
            preencher_escalar(e, k, o.classe)
            k += 1
            continue
        }
        if ((o.sysv == none) or ((o.sysv as ^bir.BirSysv).n == 0)) or ((o.sysv as ^bir.BirSysv).n > SYSV_MAX_FOLHAS) {
            return false
        }
        preencher_agregado(&e.arg[k], e.campos[k][..], o)
        k += 1
    }
    return true
}

// C: nativo/x64/x64_chamada_sysv.c:83
proc preparar_retorno(i: ^bir.BirInstr, e: ^EntradaSysv) -> bool {
    if i.a.tam == 0 {
        e.ret = bir.AbiSysvArg{}
        return true
    }
    if ((i.a.sysv == none) or ((i.a.sysv as ^bir.BirSysv).n == 0)) or ((i.a.sysv as ^bir.BirSysv).n > SYSV_MAX_FOLHAS) {
        return false
    }
    preencher_agregado(&e.ret, e.campos_ret[..], &i.a)
    return true
}

// C: nativo/x64/x64_chamada_sysv.c:96
proc planejar_sysv(i: ^bir.BirInstr, e: ^EntradaSysv, p: ^bir.AbiSysvPlano) -> bool {
    if i.nargs > bir.ABI_SYSV_MAX_ARGS {
        return false
    }
    if not preparar_argumentos(i, e) {
        return false
    }
    if not preparar_retorno(i, e) {
        return false
    }
    let args: []bir.AbiSysvArg = e.arg[0..<(i.nargs as int)]
    return bir.abi_sysv_planejar(args, &e.ret, p)
}

// C: nativo/x64/x64_chamada_sysv.c:105
proc chamada_ind_sysv(i: ^bir.BirInstr) -> bool {
    if i.nargs > bir.ABI_SYSV_MAX_ARGS {
        return false
    }
    for k in (0 as u32)..<i.nargs {
        if ((i.args or_else {})[k].tam != 0) and ((i.args or_else {})[k].sysv == none) {
            return false
        }
    }
    return (i.a.tipo == (bir.BO_NADA as u8)) or (i.a.sysv != none)
}

// C: nativo/x64/x64_chamada_sysv.c:116
proc sysv_eh_chamada_do_programa(p: ^bir.BirPrograma, i: ^bir.BirInstr) -> bool {
    if not p.sysv {
        return false
    }
    if i.op == (bir.BIR_CHAMA_IND as u8) {
        return chamada_ind_sysv(i)
    }
    return (i.op == (bir.BIR_CHAMA as u8)) and (p.simbolos[i.simbolo].tipo == (bir.BS_IMPORT as u8))
}

// C: nativo/x64/x64_chamada_sysv.c:126
proc sysv_bytes_de_pilha(i: ^bir.BirInstr) -> u32 {
    var entrada: EntradaSysv = EntradaSysv{}
    var plano: bir.AbiSysvPlano = bir.AbiSysvPlano{}
    var tern_1: u32 = 0
    if common.c2f_b2i32(planejar_sysv(i, &entrada, &plano)) != 0 {
        tern_1 = plano.bytes_pilha
    }
    return tern_1
}

// C: nativo/x64/x64_chamada_sysv.c:137
proc empilhar_escalar(c: ^X64Ctx, o: ^bir.BirOperando, off: u32) -> bool {
    if bir.bir_classe_eh_real(o.classe as i32) {
        return isel_carregar_real(c, 0, o) and isel_guardar_xmm(c, o.classe, m_mem(X64_RSP, (off as i32), 64), 0)
    }
    return isel_carregar(c, X64_RAX, o, o.extensao) and x64_emitir(c, mi2(FX_MOV64_MR as u16, m_mem(X64_RSP, (off as i32), 64), m_reg(X64_RAX, 64)))
}

// C: nativo/x64/x64_chamada_sysv.c:145
proc copiar_agregado_para_pilha(c: ^X64Ctx, o: ^bir.BirOperando, off: u32, tam: u32) -> bool {
    if not isel_carregar(c, X64_R11, o, bir.BE_NENHUMA as u8) {
        return false
    }
    var j: u32 = 0
    while j < tam {
        let arg_1: MOperando = m_mem(X64_R11, transmute(j, to = i32), 64)
        let arg_2: MOperando = m_reg(X64_RAX, 64)
        if not x64_emitir(c, mi2(FX_MOV64_RM as u16, arg_2, arg_1)) {
            return false
        }
        let arg_3: MOperando = m_reg(X64_RAX, 64)
        let arg_4: MOperando = m_mem(X64_RSP, transmute(off + j, to = i32), 64)
        if not x64_emitir(c, mi2(FX_MOV64_MR as u16, arg_4, arg_3)) {
            return false
        }
        j += SYSV_BYTES_OITO
    }
    return true
}

// C: nativo/x64/x64_chamada_sysv.c:158
proc passar_na_pilha(c: ^X64Ctx, i: ^bir.BirInstr, p: ^bir.AbiSysvPlano) -> bool {
    var k: u32 = 0
    while k < i.nargs {
        let o: ^bir.BirOperando = &(i.args or_else {})[k]
        if not p.arg[k].na_memoria {
            k += 1
            continue
        }
        if (o.tam == 0) and (not empilhar_escalar(c, o, p.off[k])) {
            return false
        }
        if (o.tam != 0) and (not copiar_agregado_para_pilha(c, o, p.off[k], o.tam)) {
            return false
        }
        k += 1
    }
    return true
}

// C: nativo/x64/x64_chamada_sysv.c:173
proc carregar_eightbyte(c: ^X64Ctx, reg: i32, desloc: u32) -> bool {
    if common.c2f_s2u_32(reg) >= (bir.ABI_SYSV_XMM0 as u32) {
        let arg_1: MOperando = m_mem(X64_R11, transmute(desloc, to = i32), 64)
        let arg_2: MOperando = m_xmm((common.c2f_s2u_32(reg) - (bir.ABI_SYSV_XMM0 as u32)) as u8)
        return x64_emitir(c, mi2(FX_MOVSD_XM as u16, arg_2, arg_1))
    }
    let arg_3: MOperando = m_mem(X64_R11, transmute(desloc, to = i32), 64)
    let arg_4: MOperando = m_reg(registrador_do_sysv(reg), 64)
    return x64_emitir(c, mi2(FX_MOV64_RM as u16, arg_4, arg_3))
}

// C: nativo/x64/x64_chamada_sysv.c:180
proc carregar_agregado_nos_registradores(c: ^X64Ctx, o: ^bir.BirOperando, loc: ^bir.AbiSysvLocal) -> bool {
    if not isel_carregar(c, X64_R11, o, bir.BE_NENHUMA as u8) {
        return false
    }
    var e: u32 = 0
    while e < loc.n_eightbytes {
        if not carregar_eightbyte(c, loc.reg[e], SYSV_BYTES_OITO * e) {
            return false
        }
        e += 1
    }
    return true
}

// C: nativo/x64/x64_chamada_sysv.c:191
proc carregar_escalar_no_registrador(c: ^X64Ctx, o: ^bir.BirOperando, reg: i32) -> bool {
    if common.c2f_s2u_32(reg) >= (bir.ABI_SYSV_XMM0 as u32) {
        return isel_carregar_real(c, (common.c2f_s2u_32(reg) - (bir.ABI_SYSV_XMM0 as u32)) as u8, o)
    }
    let arg_1: u8 = o.extensao
    let arg_2: ^bir.BirOperando = o
    let arg_3: i32 = registrador_do_sysv(reg)
    let arg_4: ^X64Ctx = c
    return isel_carregar(arg_4, arg_3, arg_2, arg_1)
}

// C: nativo/x64/x64_chamada_sysv.c:199
proc passar_nos_registradores(c: ^X64Ctx, i: ^bir.BirInstr, p: ^bir.AbiSysvPlano) -> bool {
    if (common.c2f_b2i32(p.oculto) != 0) and (not isel_carregar(c, X64_RDI, &i.a, bir.BE_NENHUMA as u8)) {
        return false
    }
    var k: u32 = 0
    while k < i.nargs {
        let o: ^bir.BirOperando = &(i.args or_else {})[k]
        if p.arg[k].na_memoria {
            k += 1
            continue
        }
        if (o.tam == 0) and (not carregar_escalar_no_registrador(c, o, p.arg[k].reg[0])) {
            return false
        }
        if (o.tam != 0) and (not carregar_agregado_nos_registradores(c, o, &p.arg[k])) {
            return false
        }
        k += 1
    }
    return true
}

// C: nativo/x64/x64_chamada_sysv.c:218
proc chamar_sysv_pelo_slot(c: ^X64Ctx, i: ^bir.BirInstr) -> bool {
    // valor de proc (stub fjt_ ou ponteiro C): r11 nao leva argumento
    if i.op == (bir.BIR_CHAMA_IND as u8) {
        return isel_carregar(c, X64_R11, &i.b, bir.BE_NENHUMA as u8) and x64_emitir(c, mi1(FX_CALL_R64 as u16, m_reg(X64_R11, 64)))
    }
    var slot: MOperando = m_mem(X64_RIP, 0, 64)
    slot.simbolo = c.obj_sim[i.simbolo]
    return x64_emitir(c, mi2(FX_LEA64_RM as u16, m_reg(X64_R11, 64), slot)) and x64_emitir(c, mi1(FX_CALL_M64 as u16, m_mem(X64_R11, 0, 64)))
}

// C: nativo/x64/x64_chamada_sysv.c:229
proc emitir_gravacao_retorno(c: ^X64Ctx, origem: i32, desloc: u32, parte: u32) -> bool {
    if parte == 8 {
        let arg_1: MOperando = m_reg(origem, 64)
        let arg_2: MOperando = m_mem(X64_R11, transmute(desloc, to = i32), 64)
        return x64_emitir(c, mi2(FX_MOV64_MR as u16, arg_2, arg_1))
    } else if parte == 4 {
        let arg_3: MOperando = m_reg(origem, 32)
        let arg_4: MOperando = m_mem(X64_R11, transmute(desloc, to = i32), 32)
        return x64_emitir(c, mi2(FX_MOV32_MR as u16, arg_4, arg_3))
    } else if parte == 2 {
        let arg_5: MOperando = m_reg(origem, 16)
        let arg_6: MOperando = m_mem(X64_R11, transmute(desloc, to = i32), 16)
        return x64_emitir(c, mi2(FX_MOV16_MR as u16, arg_6, arg_5))
    } else {
        let arg_7: MOperando = m_reg(origem, 8)
        let arg_8: MOperando = m_mem(X64_R11, transmute(desloc, to = i32), 8)
        return x64_emitir(c, mi2(FX_MOV8_MR as u16, arg_8, arg_7))
    }
    return false
}

// C: nativo/x64/x64_chamada_sysv.c:239
proc parte_do_retorno(resto: u32) -> u32 {
    if resto >= 8 {
        return 8
    }
    if resto >= 4 {
        return 4
    }
    if resto >= 2 {
        return 2
    }
    return 1
}

// C: nativo/x64/x64_chamada_sysv.c:246
proc gravar_parte_do_retorno(c: ^X64Ctx, origem: i32, desloc: u32, bytes: u32) -> bool {
    var pos: u32 = 0
    while pos < bytes {
        let parte: u32 = parte_do_retorno(bytes - pos)
        if not emitir_gravacao_retorno(c, origem, desloc + pos, parte) {
            return false
        }
        pos += parte
        if (pos < bytes) and (not x64_emitir(c, mi2(FX_SHR64_RI as u16, m_reg(origem, 64), m_imed((parte as i64) * 8)))) {
            return false
        }
    }
    return true
}

// C: nativo/x64/x64_chamada_sysv.c:263
proc origem_do_retorno(c: ^X64Ctx, reg: i32, origem: ^i32) -> bool {
    if common.c2f_s2u_32(reg) < (bir.ABI_SYSV_XMM0 as u32) {
        origem^ = registrador_do_sysv(reg)
        return true
    }
    origem^ = X64_R10
    let arg_1: MOperando = m_xmm((common.c2f_s2u_32(reg) - (bir.ABI_SYSV_XMM0 as u32)) as u8)
    let arg_2: MOperando = m_reg(X64_R10, 64)
    return x64_emitir(c, mi2(FX_MOVQ_RX as u16, arg_2, arg_1))
}

// C: nativo/x64/x64_chamada_sysv.c:274
proc gravar_retorno_agregado_sysv(c: ^X64Ctx, i: ^bir.BirInstr, p: ^bir.AbiSysvPlano) -> bool {
    if not isel_carregar(c, X64_R11, &i.a, bir.BE_NENHUMA as u8) {
        return false
    }
    var e: u32 = 0
    while e < p.ret.n_eightbytes {
        let resto: u32 = i.a.tam - (SYSV_BYTES_OITO * e)
        var origem: i32 = 0
        if not origem_do_retorno(c, p.ret.reg[e], &origem) {
            return false
        }
        if not gravar_parte_do_retorno(c, origem, SYSV_BYTES_OITO * e, min(resto, SYSV_BYTES_OITO)) {
            return false
        }
        e += 1
    }
    return true
}

// C: nativo/x64/x64_chamada_sysv.c:290
proc resultado_sysv(c: ^X64Ctx, i: ^bir.BirInstr, p: ^bir.AbiSysvPlano) -> bool {
    if i.a.tam != 0 {
        return (common.c2f_b2i32(p.oculto) != 0) or (common.c2f_b2i32(gravar_retorno_agregado_sysv(c, i, p)) != 0)
    }
    if i.dst == bir.BIR_SEM_VREG {
        return true
    }
    if bir.bir_classe_eh_real(((c.f as ^bir.BirFuncao).classe_vreg or_else {})[i.dst] as i32) {
        return isel_guardar_real(c, i.dst, 0)
    }
    return isel_guardar(c, i.dst, X64_RAX)
}

// C: nativo/x64/x64_chamada_sysv.c:302
proc isel_chama_sysv(c: ^X64Ctx, i: ^bir.BirInstr) -> bool {
    var entrada: EntradaSysv = EntradaSysv{}
    var plano: bir.AbiSysvPlano = bir.AbiSysvPlano{}
    if not planejar_sysv(i, &entrada, &plano) {
        return x64_sem_regra(c, "chama", "foreign SysV: argumento ou retorno agregado sem descritor (ou mais de 16 argumentos)")
    }
    if (not passar_na_pilha(c, i, &plano)) or (not passar_nos_registradores(c, i, &plano)) {
        return false
    }
    let arg_1: MOperando = m_imed(plano.al as i64)
    let arg_2: MOperando = m_reg(X64_RAX, 32)
    if not x64_emitir(c, mi2(FX_MOV32_RI as u16, arg_2, arg_1)) {
        return false
    }
    if not chamar_sysv_pelo_slot(c, i) {
        return false
    }
    return resultado_sysv(c, i, &plano)
}

test "x64_chamada_sysv_registrador_por_reg_abi" {
    // ordem RAX, RDX, RDI, RSI, RCX, R8, R9 (enum AbiSysvReg do C)
    expect(registrador_do_sysv(0) == 0)
    expect(registrador_do_sysv(1) == 2)
    expect(registrador_do_sysv(2) == 7)
    expect(registrador_do_sysv(3) == 6)
    expect(registrador_do_sysv(4) == 1)
    expect(registrador_do_sysv(5) == 8)
    expect(registrador_do_sysv(6) == 9)
}

test "x64_chamada_sysv_tam_escalar" {
    expect(tam_do_escalar_sysv(bir.BC_I8 as u8) == 1)
    expect(tam_do_escalar_sysv(bir.BC_I16 as u8) == 2)
    expect(tam_do_escalar_sysv(bir.BC_I32 as u8) == 4)
    expect(tam_do_escalar_sysv(bir.BC_F32 as u8) == 4)
    expect(tam_do_escalar_sysv(bir.BC_I64 as u8) == 8)
    expect(tam_do_escalar_sysv(bir.BC_F64 as u8) == 8)
}

test "x64_chamada_sysv_parte_do_retorno_8_4_2_1" {
    expect(parte_do_retorno(16) == 8)
    expect(parte_do_retorno(8) == 8)
    expect(parte_do_retorno(7) == 4)
    expect(parte_do_retorno(4) == 4)
    expect(parte_do_retorno(3) == 2)
    expect(parte_do_retorno(2) == 2)
    expect(parte_do_retorno(1) == 1)
}

test "x64_chamada_sysv_preencher_escalar_inteiro_e_real" {
    var e: EntradaSysv = EntradaSysv{}
    preencher_escalar(&e, 0, bir.BC_I8 as u8)
    expect(e.arg[0].tam == 1)
    expect(e.arg[0].n_campos == 1)
    expect(e.campos[0][0].classe == bir.ABI_SYSV_INTEIRO)
    preencher_escalar(&e, 1, bir.BC_F64 as u8)
    expect(e.arg[1].tam == 8)
    expect(e.campos[1][0].classe == bir.ABI_SYSV_SSE)
}

test "x64_chamada_sysv_planejar_inteiro_vai_no_rdi" {
    var e: EntradaSysv = EntradaSysv{}
    var p: bir.AbiSysvPlano = bir.AbiSysvPlano{}
    var arg: [1]bir.BirOperando = {bir.BirOperando{classe = (bir.BC_I32 as u8)}}
    var i: bir.BirInstr = bir.BirInstr{}
    i.nargs = 1
    i.args = arg[..]
    expect(planejar_sysv(&i, &e, &p))
    expect(p.arg[0].reg[0] == bir.ABI_SYSV_RDI)
    expect(p.bytes_pilha == 0)
}
