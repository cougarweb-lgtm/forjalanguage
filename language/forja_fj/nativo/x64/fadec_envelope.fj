import "common"

// C: fe_enc64_impl(uint8_t **buf, uint64_t opc, FeOp op0..op3) (third/fadec/fadec-enc.h). buf e o endereco de
// um rawptr que guarda o cursor de escrita: o fadec o avanca. Retorno 0 = ok.
foreign {
    link "fadec_envelope"
    proc fe_enc64_impl(buf: rawptr, mnem: u64, op0: i64, op1: i64, op2: i64, op3: i64) -> i32
}

// C: FE_MEM(base, sc, idx, off) (fadec-enc.h): bit 63 marca memoria, base nos bits 32..43, idx 44..55,
// escala 56..59 e o deslocamento nos 32 bits baixos (sem extensao de sinal, como o C).
proc fe_mem(base: i64, sc: i64, idx: i64, off: i64) -> i64 {
    let base_bits: u64 = common.c2f_s2u_64(base) & 4095
    let idx_bits: u64 = common.c2f_s2u_64(idx) & 4095
    let sc_bits: u64 = common.c2f_s2u_64(sc) & 15
    let off_bits: u64 = common.c2f_s2u_64(off) & 4294967295
    let bits: u64 = 9223372036854775808 | (base_bits << 32) | (idx_bits << 44) | (sc_bits << 56) | off_bits
    return transmute(bits, to = i64)
}
