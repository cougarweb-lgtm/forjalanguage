// sha256 de nativo/x64/alvo.h: 5900837282916236fc18bc9ad6f842c17d632b87e2284b49615bbacfa055accc
// gerado por c2forja esqueleto 0.3.2
// Versao: 0.4.0
// Changelog: 0.4.0 - I2: AlvoColheita.macho (alvos iOS) vai ao gerador A64 junto com `dinamico`.
//            0.3.0 - A4.3: AlvoColheita.dinamico leva o alvo android ao gerador A64.
//            0.2.0 - A4.1: campo `dinamico` (PIE dinamico do aarch64-linux-android; false nos demais alvos, A4.2 le)

import "common"
import "nativo/a64"
import "nativo/bir"
import "nativo/dbg"
import "nativo/obj"

pub struct ListaInstr {
    funcao: u32
    off: u32
    tam: u32
    pos: u32
    bloco: u32
    indice: u32
    texto: u32
    simbolo: u32
    origem: u8
}

pub struct ListaSlot {
    tam: u32
    alinhamento: u32
    offset: u32
}

pub struct ListaFuncao {
    nome: u32
    inicio: u32
    fim: u32
    pos: u32
    quadro: u32
    slots: u32
    maxargs: u32
    push: u32
    fpreg: u32
    alocacao: u32
    sondagem: u8
    tam_unwind: u8
    unwind: ?[32]u8
    slots_agregado: [dynamic]ListaSlot
    nslots_agregado: u32
}

pub struct AlvoListagem {
    funcoes: [dynamic]ListaFuncao
    instrs: [dynamic]ListaInstr
    textos: [dynamic]u8
}

pub struct AlvoTempos {
    isel_ns: u64
    regs_ns: u64
    codificar_ns: u64
}

pub struct AlvoColheita {
    lista: ?^AlvoListagem
    tempos: ?^AlvoTempos
    rastreio: bool
    dbg: ?^dbg.DbgPrograma
    guarda: bool
    dinamico: bool // A4.3: alvo android (o gerador A64 emite foreign pela GOT)
    macho: bool // I2: alvos iOS (entrada chamada pelo dyld)
}

pub struct Alvo {
    nome: ?str
    gerar: u16
    formato: i32
    dll: bool
    sem_escritor: ?str
    mem: bir.BirNomesMem
    arq: u8 = 0 // A1.2: 0 = x86-64; 1 = AArch64 (e_machine 183 no ELF)
    pagina: u32 = 0 // A1.2: 0 = 4096; 16384 no AArch64 (p_align do ELF)
    dinamico: bool = false // A4.1: alvo Android (PIE dinamico, DT_NEEDED); o escritor dinamico chega no A4.2
}

const ORIGEM_PROLOGO: i32 = 0
const ORIGEM_SONDAGEM: i32 = 1
const ORIGEM_CODIGO: i32 = 2
const ORIGEM_FRIO: i32 = 3
const ORIGEM_EPILOGO: i32 = 4
pub const LISTA_SEM_INDICE: u32 = 4294967295
const LISTA_TAM_UNWIND: u32 = 32

pub const ALVO_GERAR_X64_GERAR: u16 = 1
pub const ALVO_GERAR_WASM: u16 = 2 // gerador wasm vive em nativo\wasm (despacho em nativo.fj montar), nao em chamar_alvo_gerar
pub const ALVO_GERAR_A64: u16 = 3 // A1.2: gerador AArch64 (nativo\a64); passa pelo ligador ELF como o x64
pub proc chamar_alvo_gerar(tag: u16, programa: ^bir.BirPrograma, o: ^obj.Objeto, erro: ^common.Diag, colheita: ^AlvoColheita) -> bool {
    if tag == 1 {
        return x64_gerar(programa, o, erro, colheita)
    }
    if tag == 3 {
        return a64.a64_gerar(programa, o, erro, a64.A64Alvo{dinamico = colheita.dinamico, macho = colheita.macho})
    }
    // C2F: o C chama alvo->gerar sem checar (ponteiro de funcao sempre preenchido); so existe a tag 1 (x64_gerar)
    panic("chamar_alvo_gerar: tag de alvo desconhecida")
    return false
}
