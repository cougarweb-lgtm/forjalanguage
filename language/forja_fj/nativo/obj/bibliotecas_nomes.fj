// sha256 de nativo/obj/bibliotecas_nomes.h: 8741bdc9ad76362470eb991404dd9ff21b160703ca8c524bc91f0555778f2aea
// gerado por c2forja esqueleto 0.3.2
// Versao: 0.2.0

const BIBS_TAM_NOME_NORMAL: u32 = 64
const BIBS_COBERTAS: [11]str = {"c", "m", "msvcrt", "ucrt", "ucrtbase", "kernel32", "mingw32", "mingwex", "gcc", "moldname", "moldname-msvcrt"}
const BIBS_EXTENSOES: [3]str = {".lib", ".a", ".dll"}

// Minusculas (so ASCII, como o tolower do C na locale C), truncadas em 63 bytes (o C guarda 63 + NUL).
// C: nativo/obj/bibliotecas_nomes.c:20
// Assinatura: o C devolvia por parametro de saida (char[64]); a Forja devolve o texto novo (frame).
proc bibs_minusculas(nome: ?str) -> str {
    let origem = as_bytes(nome or_else "")
    let tam: int = min(len(origem), (BIBS_TAM_NOME_NORMAL as int) - 1)
    var saida: [64]u8 = {}
    for i in 0..<tam {
        var c: u8 = origem[i]
        if (c >= 65) and (c <= 90) { // 'A' a 'Z'
            c += 32
        }
        saida[i] = c
    }
    return from_bytes(saida[0..<tam], alloc = frame)
}

// Corta a extensao (.lib, .a, .dll) se o nome termina nela; o corte e do ultimo '.' (strrchr).
// C: nativo/obj/bibliotecas_nomes.c:29
proc bibs_sem_extensao(nome: str) -> str {
    let bytes = as_bytes(nome)
    var i: int = len(bytes) - 1
    while (i >= 0) and (bytes[i] != 46) { // '.'
        i -= 1
    }
    if i < 0 {
        return nome
    }
    let sufixo: str = from_bytes(bytes[i..<len(bytes)], alloc = frame)
    for k in 0..<len(BIBS_EXTENSOES) {
        if sufixo == BIBS_EXTENSOES[k] {
            return from_bytes(bytes[0..<i], alloc = frame)
        }
    }
    return nome
}

// Minusculas, sem extensao e sem o "lib" da frente (so se sobra algo depois dele).
// C: nativo/obj/bibliotecas_nomes.c:39
proc bibs_normalizar(nome: ?str) -> str {
    let minusculo: str = bibs_minusculas(nome)
    let semext: str = bibs_sem_extensao(minusculo)
    let bytes = as_bytes(semext)
    // "lib" e o strncmp do C; len > 3 e o saida[3] != '\0'
    if (len(bytes) > 3) and (bytes[0] == 108) and (bytes[1] == 105) and (bytes[2] == 98) {
        return from_bytes(bytes[3..<len(bytes)], alloc = frame)
    }
    return semext
}

// C: nativo/obj/bibliotecas_nomes.c:47
proc bibs_coberta(nome: ?str) -> bool {
    let normal: str = bibs_normalizar(nome)
    for k in 0..<len(BIBS_COBERTAS) {
        if normal == BIBS_COBERTAS[k] {
            return true
        }
    }
    return false
}
