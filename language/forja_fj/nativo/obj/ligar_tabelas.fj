import "common"

const LIGAR_QTD_IMPORTS: i32 = 85
const LIGAR_NOME_DLL: str = "KERNEL32.dll"
const LIGAR_QTD_IMPORTS_ADVAPI32: i32 = 1
const LIGAR_NOME_DLL_ADVAPI32: str = "ADVAPI32.dll"
const LIGAR_QTD_TABELAS_BASE: i32 = 2
const LIGAR_QTD_IMPORTS_WS2_32: i32 = 18
const LIGAR_NOME_DLL_WS2_32: str = "WS2_32.dll"
const LIGAR_QTD_TABELAS: i32 = 3
const LIGAR_KERNEL32_M1: [85]str = {"GetStdHandle", "WriteFile", "GetFileType", "ExitProcess", "GetProcessHeap", "HeapAlloc", "HeapReAlloc", "HeapFree", "VirtualAlloc", "VirtualFree", "QueryPerformanceCounter", "QueryPerformanceFrequency", "GetConsoleMode", "GetConsoleOutputCP", "SetConsoleOutputCP", "GetEnvironmentVariableA", "AddVectoredExceptionHandler", "GetCommandLineW", "WideCharToMultiByte", "MultiByteToWideChar", "GetEnvironmentVariableW", "CreateFileW", "ReadFile", "GetFileSizeEx", "CloseHandle", "GetLastError", "Sleep", "GetSystemTimePreciseAsFileTime", "SetFilePointerEx", "FlushFileBuffers", "GetFileAttributesExW", "DeleteFileW", "MoveFileExW", "CopyFileW", "CreateDirectoryW", "RemoveDirectoryW", "FindFirstFileW", "FindNextFileW", "FindClose", "ReadConsoleW", "CreatePipe", "SetHandleInformation", "CreateProcessW", "InitializeProcThreadAttributeList", "UpdateProcThreadAttribute", "DeleteProcThreadAttributeList", "CreateJobObjectW", "SetInformationJobObject", "AssignProcessToJobObject", "ResumeThread", "TerminateJobObject", "TerminateProcess", "WaitForSingleObject", "GetExitCodeProcess", "PeekNamedPipe", "GetCurrentDirectoryW", "GetFullPathNameW", "GetModuleFileNameW", "GetTempPathW", "SetEnvironmentVariableW", "K32GetProcessMemoryInfo", "TlsAlloc", "TlsGetValue", "TlsSetValue", "AcquireSRWLockExclusive", "ReleaseSRWLockExclusive", "CreateThread", "TryAcquireSRWLockExclusive", "SleepConditionVariableSRW", "WakeConditionVariable", "WakeAllConditionVariable", "SystemTimeToTzSpecificLocalTime", "GetCurrentProcessId", "GetActiveProcessorCount", "LoadLibraryExW", "GetProcAddress", "FreeLibrary", "GlobalMemoryStatusEx", "OpenProcess", "FormatMessageW", "WaitForMultipleObjects", "QueryInformationJobObject", "GetProcessTimes", "DuplicateHandle", "SetLastError"}
const LIGAR_ADVAPI32_M1: [1]str = {"SystemFunction036"}
const LIGAR_WS2_32_M1: [18]str = {"WSAStartup", "WSAGetLastError", "socket", "bind", "sendto", "recvfrom", "select", "getsockname", "closesocket", "WSAIoctl", "setsockopt", "connect", "listen", "accept", "send", "recv", "ioctlsocket", "getsockopt"}

// C: nativo/obj/ligar_tabelas.c:62 (LIGAR_TABELAS)
// C2F-B2: LIGAR_TABELAS (const ImportTabela[3], ordem KERNEL32, ADVAPI32, WS2_32) nao se fatia na Forja (const nao da slice):
// as 3 procs abaixo dizem a DLL, a quantidade e o nome t,i; ligar_copiar_fixas copia para l.fixos e monta l.tabelas (o memcpy do C)
proc ligar_dll_fixa(t: u32) -> str {
    if t == 0 {
        return LIGAR_NOME_DLL
    }
    if t == 1 {
        return LIGAR_NOME_DLL_ADVAPI32
    }
    return LIGAR_NOME_DLL_WS2_32
}

proc ligar_qtd_fixa(t: u32) -> u32 {
    if t == 0 {
        return LIGAR_QTD_IMPORTS as u32
    }
    if t == 1 {
        return LIGAR_QTD_IMPORTS_ADVAPI32 as u32
    }
    return LIGAR_QTD_IMPORTS_WS2_32 as u32
}

proc ligar_nome_fixo(t: u32, i: u32) -> str {
    if t == 0 {
        return LIGAR_KERNEL32_M1[i]
    }
    if t == 1 {
        return LIGAR_ADVAPI32_M1[i]
    }
    return LIGAR_WS2_32_M1[i]
}

// memcpy(L->tabelas, LIGAR_TABELAS, fixas * sizeof) do C; qtd_tabelas = fixas fica com quem chama
proc ligar_copiar_fixas(l: ^LigacaoEstado, fixas: u32) {
    for t in (0 as u32)..<fixas {
        let qtd: u32 = ligar_qtd_fixa(t)
        for i in (0 as u32)..<qtd {
            l.fixos[t][i] = ligar_nome_fixo(t, i)
        }
        l.tabelas[t] = ImportTabela{dll = ligar_dll_fixa(t), simbolos = l.fixos[t][(0 as u64)..<(qtd as u64)], qtd = qtd}
    }
}

// C: nativo/obj/ligar_tabelas.c:70
proc ligar_minuscula(c: u8) -> u8 {
    var tern_1: i32 = common.c2f_char_i32(c)
    if (common.c2f_char_i32(c) >= 65) and (common.c2f_char_i32(c) <= 90) {
        tern_1 = (((common.c2f_char_i32(c) + 97) - 65) as u8) as i32
    }
    return tern_1 as u8 // 'A' 'Z' 'a' 'A'
}

// C: nativo/obj/ligar_tabelas.c:75
proc ligar_mesma_dll(a: str, b: str) -> bool {
    let na: u64 = len(a) as u64
    let nb: u64 = len(b) as u64
    var i: u64 = 0
    while (i < na) and (i < nb) {
        if ligar_minuscula(a[i]) != ligar_minuscula(b[i]) {
            return false
        }
        i += 1
    }
    // C: so e igual se as duas acabam juntas (o *a == *b do fim do laco)
    return (i == na) and (i == nb)
}

// C: nativo/obj/ligar_tabelas.c:86
proc ligar_fundir_ws2(fixa: ^ImportTabela, extra: ^ImportTabela, fundidos: []str) {
    var qtd: u32 = 0
    for s in (0 as u32)..<fixa.qtd {
        let antes_1: u32 = qtd
        qtd += 1
        fundidos[antes_1] = (fixa.simbolos or_else {})[s]
    }
    var s: u32 = 0
    while s < extra.qtd {
        var ja: bool = false
        var u: u32 = 0
        while (u < qtd) and (not ja) {
            ja = fundidos[u] == (extra.simbolos or_else {})[s]
            u += 1
        }
        if not ja {
            let antes_2: u32 = qtd
            qtd += 1
            fundidos[antes_2] = (extra.simbolos or_else {})[s]
        }
        s += 1
    }
    fixa.simbolos = fundidos
    fixa.qtd = qtd
}

test "ligar_tabelas: contagens, nomes e ordem das 3 fixas" {
    expect(LIGAR_QTD_IMPORTS == 85)
    expect(len(LIGAR_KERNEL32_M1) == 85)
    expect((len(LIGAR_ADVAPI32_M1) as i32) == LIGAR_QTD_IMPORTS_ADVAPI32)
    expect((len(LIGAR_WS2_32_M1) as i32) == LIGAR_QTD_IMPORTS_WS2_32)
    expect(ligar_qtd_fixa(0) == 85)
    expect(ligar_qtd_fixa(1) == 1)
    expect(ligar_qtd_fixa(2) == 18)
    expect(ligar_dll_fixa(0) == "KERNEL32.dll")
    expect(ligar_dll_fixa(1) == "ADVAPI32.dll")
    expect(ligar_dll_fixa(2) == "WS2_32.dll")
    expect(ligar_nome_fixo(0, 0) == "GetStdHandle")
    expect(ligar_nome_fixo(0, 15) == "GetEnvironmentVariableA")
    expect(ligar_nome_fixo(0, 16) == "AddVectoredExceptionHandler")
    expect(ligar_nome_fixo(0, 60) == "K32GetProcessMemoryInfo")
    expect(ligar_nome_fixo(0, 63) == "TlsSetValue")
    expect(ligar_nome_fixo(0, 71) == "SystemTimeToTzSpecificLocalTime")
    expect(ligar_nome_fixo(0, 76) == "FreeLibrary")
    expect(ligar_nome_fixo(0, 82) == "GetProcessTimes")
    expect(ligar_nome_fixo(0, 83) == "DuplicateHandle")
    expect(ligar_nome_fixo(0, 84) == "SetLastError")
    expect(ligar_nome_fixo(1, 0) == "SystemFunction036")
    expect(ligar_nome_fixo(2, 0) == "WSAStartup")
    expect(ligar_nome_fixo(2, 9) == "WSAIoctl")
    expect(ligar_nome_fixo(2, 17) == "getsockopt")
}

test "ligar_tabelas: ligar_copiar_fixas monta l.tabelas como o memcpy do C" {
    var l: LigacaoEstado = LigacaoEstado{}
    ligar_copiar_fixas(&l, 2)
    expect(l.tabelas[0].qtd == 85)
    expect((l.tabelas[0].dll or_else "") == "KERNEL32.dll")
    expect(len(l.tabelas[0].simbolos or_else {}) == 85)
    expect((l.tabelas[0].simbolos or_else {})[84] == "SetLastError")
    expect(l.tabelas[1].qtd == 1)
    expect((l.tabelas[1].dll or_else "") == "ADVAPI32.dll")
    expect(len(l.tabelas[1].simbolos or_else {}) == 1)
    expect((l.tabelas[1].simbolos or_else {})[0] == "SystemFunction036")
    expect(l.tabelas[2].qtd == 0) // so as fixas pedidas
}

test "ligar_tabelas: ligar_minuscula e ligar_mesma_dll" {
    expect(ligar_minuscula(65) == 97)
    expect(ligar_minuscula(90) == 122)
    expect(ligar_minuscula(97) == 97)
    expect(ligar_minuscula(64) == 64)
    expect(ligar_minuscula(91) == 91)
    expect(ligar_mesma_dll("ws2_32.dll", "WS2_32.dll"))
    expect(ligar_mesma_dll("", ""))
    expect(not ligar_mesma_dll("ws2_32.dl", "WS2_32.dll"))
    expect(not ligar_mesma_dll("ws2_32.dll", "WS2_32.dl"))
    expect(not ligar_mesma_dll("ws2_32.dll", "WS2_31.dll"))
}

test "ligar_tabelas: ligar_fundir_ws2 junta sem repetir e preserva a ordem" {
    let a: [3]str = {"x", "y", "z"}
    let e: [4]str = {"y", "w", "x", "v"}
    var arr_a: [3]str = a
    var arr_e: [4]str = e
    var fixa: ImportTabela = ImportTabela{dll = "d", simbolos = arr_a[..], qtd = 3}
    var extra: ImportTabela = ImportTabela{dll = "d", simbolos = arr_e[..], qtd = 4}
    var fund: [320]str = {}
    ligar_fundir_ws2(&fixa, &extra, fund[..])
    expect(fixa.qtd == 5)
    expect(fund[0] == "x")
    expect(fund[1] == "y")
    expect(fund[2] == "z")
    expect(fund[3] == "w")
    expect(fund[4] == "v")
    expect((fixa.simbolos or_else {})[4] == "v")
}
