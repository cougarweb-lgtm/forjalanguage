import "common"
import "nativo/fmt" as pefmt

struct LigarContrib {
    saida: i32
    off: u32
}

struct LigarCelula {
    objeto: i32
    simbolo: u32
}

struct LigacaoEstado {
    obj: ?[16]?^Objeto
    im: ?^pefmt.Imagem
    erro: ?^common.Diag
    pedido: ?^LigarPedido
    tam: [9]u32
    rva: [9]u32
    idx_im: [9]u32
    contrib: [16][dynamic]LigarContrib // C2F: Vec de LigarContrib (uma por secao de cada objeto)
    rva_sim: [16][dynamic]u32 // C2F: Vec de uint32_t (RVA de cada simbolo de cada objeto)
    celulas: [dynamic]LigarCelula
    tls_alinhamento: u32
    tls_bloco: u32
    entrada: AlcanceEntrada
    alcance: Alcance
    tabelas: [17]ImportTabela
    qtd_tabelas: u32
    fixos: [3][85]str // C2F-B2: copia dos nomes das tabelas fixas (LIGAR_TABELAS do C aponta para const; na Forja const nao se fatia), indexada como LIGAR_TABELAS
    fundidos: [320]str // C2F: era ?[320]str; sem o opcional para fatiar (fundidos[..n]) e gravar
    plano: [320]str // C2F: idem; as primeiras qtd_plano posicoes valem
    qtd_plano: u32
    slot_import: [320]i32
    texto_runtime_off: u32
    raizes: [2]AlcanceRaiz
    objeto_entrada: i32
    nome_entrada: ?str
}

