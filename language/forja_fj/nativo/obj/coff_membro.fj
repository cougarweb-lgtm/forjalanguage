import "common"

struct CoffDiretiva {
    tipo: i32
    nome: ?str
    valor: u32
}

struct CoffComdat {
    simbolo: u32
    secao: u32
    tam: u32
    selecao: u8
}

struct CoffAssociada {
    pai: u32
