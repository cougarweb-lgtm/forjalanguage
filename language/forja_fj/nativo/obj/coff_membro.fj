}

struct CoffComum {
    simbolo: u32
    tam: u32
}

struct CoffFraco {
    simbolo: u32
    padrao: u32
}

struct CoffUniao {
    o: ?^Objeto
    comdats: [dynamic]CoffComdat
    comuns: [dynamic]CoffComum
    fracos: [dynamic]CoffFraco
    alinhamentos: [dynamic]CoffDiretiva
    bibliotecas: [dynamic]str
    exportados: [dynamic]str
    anuladas: [dynamic]u32
    associadas: [dynamic]CoffAssociada
    membros: u32
    ignoradas: u32
    primeira_ignorada: ?str
}

struct CoffMembroEntrada {
    dados: ?^u8
    tam: u64
    nome: ?str
}

struct CmSecao {
    idx: i32
    carac: u32
