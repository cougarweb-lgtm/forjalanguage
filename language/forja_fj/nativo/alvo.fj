// Changelog: 0.4.0 - I5: os dois alvos iOS passam a aceitar dll (dylib MH_DYLIB) | 0.3.0 - I1: 6o e 7o alvos aarch64-apple-ios e aarch64-apple-ios-sim (MACHO, arq=1, pagina=16384, dinamico, sem dll); alvo_qtd 7 | 0.2.0 - A4.1: 5o alvo aarch64-linux-android (ELF, arq=1, pagina=16384, dll, dinamico); alvo_qtd 5

import "nativo/bir"
import "nativo/fmt" as pefmt
import "nativo/x64"

// C: nativo/alvo.c:19
// C2F: o ponteiro de funcao gerar vira a tag ALVO_GERAR_X64_GERAR; escritor NULL = none
const ALVOS: [7]x64.Alvo = {x64.Alvo{nome = "x86_64-windows", gerar = x64.ALVO_GERAR_X64_GERAR, formato = pefmt.IMAGEM_PE, dll = true, sem_escritor = none, mem = bir.BirNomesMem{copia = "memcpy", zera = "memset"}}, x64.Alvo{nome = "x86_64-linux", gerar = x64.ALVO_GERAR_X64_GERAR, formato = pefmt.IMAGEM_ELF, dll = false, sem_escritor = none, mem = bir.BirNomesMem{copia = "forja_memcpy", zera = "forja_memset"}}, x64.Alvo{nome = "wasm32-wasip1", gerar = x64.ALVO_GERAR_WASM, formato = pefmt.IMAGEM_WASM, dll = true, sem_escritor = none, mem = bir.BirNomesMem{copia = "memory.copy", zera = "memory.fill"}}, x64.Alvo{nome = "aarch64-linux", gerar = x64.ALVO_GERAR_A64, formato = pefmt.IMAGEM_ELF, dll = false, sem_escritor = none, mem = bir.BirNomesMem{copia = "forja_memcpy", zera = "forja_memset"}, arq = 1, pagina = 16384}, x64.Alvo{nome = "aarch64-linux-android", gerar = x64.ALVO_GERAR_A64, formato = pefmt.IMAGEM_ELF, dll = true, sem_escritor = none, mem = bir.BirNomesMem{copia = "forja_memcpy", zera = "forja_memset"}, arq = 1, pagina = 16384, dinamico = true}, x64.Alvo{nome = "aarch64-apple-ios", gerar = x64.ALVO_GERAR_A64, formato = pefmt.IMAGEM_MACHO, dll = true, sem_escritor = none, mem = bir.BirNomesMem{copia = "forja_memcpy", zera = "forja_memset"}, arq = 1, pagina = 16384, dinamico = true}, x64.Alvo{nome = "aarch64-apple-ios-sim", gerar = x64.ALVO_GERAR_A64, formato = pefmt.IMAGEM_MACHO, dll = true, sem_escritor = none, mem = bir.BirNomesMem{copia = "forja_memcpy", zera = "forja_memset"}, arq = 1, pagina = 16384, dinamico = true}}

// C: nativo/alvo.c:24
// C2F: *lista = {0} vira refazer as 3 listas (cada uma com make, como VecIniciar); o Buf de textos vira make (R0007)
proc alvo_listagem_iniciar(lista: ^x64.AlvoListagem) {
    lista.funcoes = make([dynamic]x64.ListaFuncao, alloc = heap)
    lista.instrs = make([dynamic]x64.ListaInstr, alloc = heap)
    lista.textos = make([dynamic]u8, alloc = heap)
}

// C: nativo/alvo.c:31
// C2F: free(slots_agregado) de cada funcao vira delete do dynamic dela; VecLiberar e BufLiberar viram delete
proc alvo_listagem_liberar(lista: ^x64.AlvoListagem) {
    for k in (0 as u64)..<(len(lista.funcoes) as u64) {
        delete(lista.funcoes[k].slots_agregado)
    }
    delete(lista.funcoes)
    delete(lista.instrs)
    delete(lista.textos)
}

// C: nativo/alvo.c:40
proc alvo_qtd() -> u32 {
    return 7 as u32 // C2F: sizeof ALVOS / sizeof ALVOS [0] (7 alvos desde o I1: x86-64 x2, wasm, aarch64-linux, aarch64-linux-android, aarch64-apple-ios, aarch64-apple-ios-sim)
}

// C2F: &ALVOS[k] nao tem endereco na Forja (E0301) e o C devolve um static; a copia vai no frame (o Alvo nao tem dono a liberar)
// (new(x64.Alvo) e E1003 fora do modulo: a lista de 1 elemento no frame da o mesmo ponteiro)
proc alvo_copia(k: u32) -> ?^x64.Alvo {
    var lista = make([dynamic]x64.Alvo, alloc = frame)
    append(&lista, item = ALVOS[k])
    return &lista[0]
}

// C: nativo/alvo.c:45
proc alvo_por_indice(k: u32) -> ?^x64.Alvo {
    if k < alvo_qtd() {
        return alvo_copia(k)
    }
    return none
}

// C: nativo/alvo.c:50
proc alvo_por_nome(nome: ?str) -> ?^x64.Alvo {
    let buscado: str = nome or_else ""
    for k in (0 as u32)..<alvo_qtd() {
        if (ALVOS[k].nome or_else "") == buscado {
            return alvo_copia(k)
        }
    }
    return none
}

test "alvo_tabela_e_busca" {
    expect(alvo_qtd() == 7)
    let w = alvo_por_nome("x86_64-windows")
    expect(w != none)
    expect((w as ^x64.Alvo).formato == pefmt.IMAGEM_PE)
    expect((w as ^x64.Alvo).dll)
    let l = alvo_por_indice(1)
    expect(l != none)
    expect((l as ^x64.Alvo).formato == pefmt.IMAGEM_ELF)
    expect(not (l as ^x64.Alvo).dll)
    let alvo_wasm = alvo_por_nome("wasm32-wasip1")
    expect(alvo_wasm != none)
    expect((alvo_wasm as ^x64.Alvo).formato == pefmt.IMAGEM_WASM)
    expect((alvo_wasm as ^x64.Alvo).dll) // reactor: --modo dll no wasm exporta os procs `export` (W4)
    expect(alvo_por_nome("nenhum") == none)
    expect(alvo_por_indice(7) == none)
    let alvo_a64 = alvo_por_nome("aarch64-linux")
    expect(alvo_a64 != none)
    expect((alvo_a64 as ^x64.Alvo).formato == pefmt.IMAGEM_ELF)
    expect((alvo_a64 as ^x64.Alvo).arq == 1)
    expect((alvo_a64 as ^x64.Alvo).pagina == 16384)
    expect(not (alvo_a64 as ^x64.Alvo).dinamico)
    let alvo_android = alvo_por_nome("aarch64-linux-android")
    expect(alvo_android != none)
    expect((alvo_android as ^x64.Alvo).formato == pefmt.IMAGEM_ELF)
    expect((alvo_android as ^x64.Alvo).arq == 1)
    expect((alvo_android as ^x64.Alvo).pagina == 16384)
    expect((alvo_android as ^x64.Alvo).dinamico)
    expect(not (alvo_a64 as ^x64.Alvo).dll)
    expect((l as ^x64.Alvo).arq == 0)
    let alvo_ios = alvo_por_nome("aarch64-apple-ios")
    expect(alvo_ios != none)
    expect((alvo_ios as ^x64.Alvo).formato == pefmt.IMAGEM_MACHO)
    expect((alvo_ios as ^x64.Alvo).arq == 1)
    expect((alvo_ios as ^x64.Alvo).pagina == 16384)
    expect((alvo_ios as ^x64.Alvo).dinamico)
    expect((alvo_ios as ^x64.Alvo).dll)
    let alvo_ios_sim = alvo_por_nome("aarch64-apple-ios-sim")
    expect(alvo_ios_sim != none)
    expect((alvo_ios_sim as ^x64.Alvo).formato == pefmt.IMAGEM_MACHO)
    expect((alvo_ios_sim as ^x64.Alvo).arq == 1)
    expect((alvo_ios_sim as ^x64.Alvo).pagina == 16384)
    expect((alvo_ios_sim as ^x64.Alvo).dinamico)
    expect((alvo_ios_sim as ^x64.Alvo).dll)
}

test "alvo_listagem_iniciar_liberar" {
    var lista = x64.AlvoListagem{}
    alvo_listagem_iniciar(&lista)
    expect(len(lista.funcoes) == 0)
    alvo_listagem_liberar(&lista)
}
