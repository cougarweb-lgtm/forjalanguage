import "common"
import "nativo/bir"

// C: nativo/optimizer/costura_faixa.c:13
proc menor(a: i64, b: i64) -> i64 {
    return min(a, b)
}

// C: nativo/optimizer/costura_faixa.c:18
proc maior(a: i64, b: i64) -> i64 {
    return max(a, b)
}

// C: nativo/optimizer/costura_faixa.c:24
proc cos_umbral(k: i64, c: i64, u: ^i64) -> bool {
    if c >= 0 {
        if k < (((-9223372036854775807) - 1) + c) {
            return false
        }
        u^ = k - c
        return true
    }
    if k > (9223372036854775807 + c) {
        return false
    }
    u^ = k - c
    return true
}

// C: nativo/optimizer/costura_faixa.c:38
proc cos_sem_forma() -> CosForma {
    return CosForma{raiz = -1}
}

// C: nativo/optimizer/costura_faixa.c:43
proc cos_forma_da_raiz(raiz: i32) -> CosForma {
    return CosForma{raiz = raiz}
}

// C: nativo/optimizer/costura_faixa.c:49
// C2F-INDECIDIVEL: raiz_de, tab
proc cos_forma_de(raiz_de: []i32, tab: []CosForma, v: u32) -> CosForma {
    if raiz_de[v] >= 0 {
        return cos_forma_da_raiz(raiz_de[v])
    }
    return tab[v]
}

// C: nativo/optimizer/costura_faixa.c:57
proc cos_forma_soma(f: CosForma, d: i64, out: ^CosForma) -> bool {
    var novo: i64 = 0
    if f.raiz < 0 {
        return false
    }
    if ((d > 0) and (f.c > (9223372036854775807 - d))) or ((d < 0) and (f.c < (((-9223372036854775807) - 1) - d))) {
        return false
    }
    novo = f.c + d
    if (novo > COSTURA_C_MAX) or (novo < (-1152921504606846976)) {
        return false
    }
    out^ = CosForma{raiz = f.raiz, c = novo, pmin = menor(f.pmin, novo), pmax = maior(f.pmax, novo)}
    return true
}

// C: nativo/optimizer/costura_faixa.c:73
proc cos_mescla_forma(a: CosForma, b: CosForma) -> CosForma {
    if ((a.raiz < 0) or (a.raiz != b.raiz)) or (a.c != b.c) {
        return cos_sem_forma()
    }
    return CosForma{raiz = a.raiz, c = a.c, pmin = menor(a.pmin, b.pmin), pmax = maior(a.pmax, b.pmax)}
}

// C: nativo/optimizer/costura_faixa.c:81
proc cos_faixa_sem_volta(iv: CosFaixa, f: CosForma) -> bool {
    if f.raiz < 0 {
        return false
    }
    return (iv.lo >= (((-9223372036854775807) - 1) - f.pmin)) and (iv.hi <= (9223372036854775807 - f.pmax))
}

// C: nativo/optimizer/costura_faixa.c:89
proc conjunto_verdadeiro(cond: u8, u: i64, out: ^CosFaixa) -> bool {
    out^ = CosFaixa{lo = 1, hi = 0}
    let sw_1 = cond as i32
    if sw_1 == bir.BCOND_EQ {
        out^ = CosFaixa{lo = u, hi = u}
        return true
    } else if sw_1 == bir.BCOND_LT_S {
        if u != ((-9223372036854775807) - 1) {
            out^ = CosFaixa{lo = (-9223372036854775807) - 1, hi = u - 1}
        }
        return true
    } else if sw_1 == bir.BCOND_LE_S {
        out^ = CosFaixa{lo = (-9223372036854775807) - 1, hi = u}
        return true
    } else if sw_1 == bir.BCOND_GT_S {
        if u != 9223372036854775807 {
            out^ = CosFaixa{lo = u + 1, hi = 9223372036854775807}
        }
        return true
    } else if sw_1 == bir.BCOND_GE_S {
        out^ = CosFaixa{lo = u, hi = 9223372036854775807}
        return true
    } else {
        return false
    }
    return false
}

// C: nativo/optimizer/costura_faixa.c:103
proc conjunto_falso(cond: u8, u: i64, out: ^CosFaixa) -> bool {
    out^ = CosFaixa{lo = 1, hi = 0}
    let sw_1 = cond as i32
    if sw_1 == bir.BCOND_NE {
        out^ = CosFaixa{lo = u, hi = u}
        return true
    } else if sw_1 == bir.BCOND_LT_S {
        out^ = CosFaixa{lo = u, hi = 9223372036854775807}
        return true
    } else if sw_1 == bir.BCOND_LE_S {
        if u != 9223372036854775807 {
            out^ = CosFaixa{lo = u + 1, hi = 9223372036854775807}
        }
        return true
    } else if sw_1 == bir.BCOND_GT_S {
        out^ = CosFaixa{lo = (-9223372036854775807) - 1, hi = u}
        return true
    } else if sw_1 == bir.BCOND_GE_S {
        if u != ((-9223372036854775807) - 1) {
            out^ = CosFaixa{lo = (-9223372036854775807) - 1, hi = u - 1}
        }
        return true
    } else {
        return false
    }
    return false
}

// C: nativo/optimizer/costura_faixa.c:117
proc cos_conjunto(cond: u8, verdade: bool, u: i64, out: ^CosFaixa) -> bool {
    var tern_1: i32 = 0
    if common.c2f_b2i32(verdade) != 0 {
        tern_1 = common.c2f_b2i32(conjunto_verdadeiro(cond, u, out))
    } else {
        tern_1 = common.c2f_b2i32(conjunto_falso(cond, u, out))
    }
    return tern_1 != 0
}

// C: nativo/optimizer/costura_faixa.c:123
// C2F-INDECIDIVEL: faixas
proc cos_decide(r: ^CosCond, faixas: []CosFaixa) -> i32 {
    let iv: CosFaixa = faixas[r.forma.raiz]
    var t: CosFaixa = CosFaixa{}
    var u: i64 = 0
    if (not cos_faixa_sem_volta(iv, r.forma)) or (not cos_umbral(r.k, r.forma.c, &u)) {
        return -1
    }
    if r.cond == (bir.BCOND_NE as u8) {
        if (u < iv.lo) or (u > iv.hi) {
            return 1
        }
        var tern_1: i32 = -1
        if iv.lo == iv.hi {
            tern_1 = 0
        }
        return tern_1
    }
    if not cos_conjunto(r.cond, true, u, &t) {
        return -1
    }
    if (t.lo <= iv.lo) and (iv.hi <= t.hi) {
        return 1
    }
    if maior(t.lo, iv.lo) > menor(t.hi, iv.hi) {
        return 0
    }
    return -1
}

// C: nativo/optimizer/costura_faixa.c:145
// C2F-INDECIDIVEL: faixas
proc cos_refinar(r: ^CosCond, verdade: bool, faixas: []CosFaixa) {
    let iv: ^CosFaixa = &faixas[r.forma.raiz]
    var t: CosFaixa = CosFaixa{}
    var u: i64 = 0
    var nlo: i64 = 0
    var nhi: i64 = 0
    if ((not cos_faixa_sem_volta(iv^, r.forma)) or (not cos_umbral(r.k, r.forma.c, &u))) or (not cos_conjunto(r.cond, verdade, u, &t)) {
        return
    }
    nlo = maior(iv.lo, t.lo)
    nhi = menor(iv.hi, t.hi)
    if nlo <= nhi {
        iv.lo = nlo
        iv.hi = nhi
    }
}

// ---- testes dirigidos (valores conferidos a mao contra costura_faixa.c; i64 nos limites)
test "costura_faixa_umbral_sem_estouro" {
    var u: i64 = 0
    expect(cos_umbral(5, 0, &u))
    expect(u == 5)
    expect(cos_umbral(5, 3, &u))
    expect(u == 2)
    expect(cos_umbral(5, -3, &u))
    expect(u == 8)
    expect(cos_umbral(((-9223372036854775807) - 1), 0, &u))
    expect(u == ((-9223372036854775807) - 1))
    expect(not cos_umbral(((-9223372036854775807) - 1), 1, &u))
    expect(not cos_umbral(9223372036854775807, -1, &u))
    expect(cos_umbral(9223372036854775806, -1, &u))
    expect(u == 9223372036854775807)
}

test "costura_faixa_forma_soma_e_mescla" {
    let f = CosForma{raiz = 0, c = 0, pmin = 0, pmax = 0}
    var a = CosForma{}
    var g = CosForma{}
    expect(cos_forma_soma(f, 5, &a))
    expect(a.c == 5 and a.pmax == 5 and a.pmin == 0)
    expect(cos_forma_soma(a, -7, &g))
    expect(g.c == -2 and g.pmin == -2 and g.pmax == 5)
    expect(not cos_forma_soma(cos_sem_forma(), 1, &g))
    expect(not cos_forma_soma(f, 9223372036854775807, &g))
    let p = CosForma{raiz = 0, c = 3, pmin = -2, pmax = 1}
    let q = CosForma{raiz = 0, c = 3, pmin = 0, pmax = 4}
    let m = cos_mescla_forma(p, q)
    expect(m.raiz == 0 and m.c == 3 and m.pmin == -2 and m.pmax == 4)
    expect(cos_mescla_forma(p, CosForma{raiz = 0, c = 4}).raiz == -1)
    expect(cos_sem_forma().raiz == -1)
    expect(cos_forma_da_raiz(4).raiz == 4)
}

test "costura_faixa_forma_de_e_sem_volta" {
    var rd = make([dynamic]i32, alloc = heap, cap = 3)
    append(&rd, item = 0)
    append(&rd, item = -1)
    var tb = make([dynamic]CosForma, alloc = heap, cap = 3)
    append(&tb, item = CosForma{})
    append(&tb, item = CosForma{raiz = 3})
    expect(cos_forma_de(rd[..], tb[..], 0).raiz == 0)
    expect(cos_forma_de(rd[..], tb[..], 1).raiz == 3)
    expect(not cos_faixa_sem_volta(CosFaixa{lo = ((-9223372036854775807) - 1), hi = 10}, CosForma{raiz = 0, pmin = -1, pmax = 0}))
    expect(cos_faixa_sem_volta(CosFaixa{lo = 0, hi = 10}, CosForma{raiz = 0, pmin = -2, pmax = 3}))
    expect(not cos_faixa_sem_volta(CosFaixa{lo = 0, hi = 10}, cos_sem_forma()))
    delete(rd)
    delete(tb)
}

test "costura_faixa_conjuntos_verdade_e_falso" {
    var t = CosFaixa{}
    expect(cos_conjunto(bir.BCOND_EQ as u8, true, 7, &t))
    expect(t.lo == 7 and t.hi == 7)
    expect(cos_conjunto(bir.BCOND_LT_S as u8, false, 7, &t))
    expect(t.lo == 7 and t.hi == 9223372036854775807)
    expect(cos_conjunto(bir.BCOND_NE as u8, false, 7, &t))
    expect(t.lo == 7 and t.hi == 7)
    expect(not cos_conjunto(bir.BCOND_NE as u8, true, 7, &t))
    expect(not cos_conjunto(bir.BCOND_EQ as u8, false, 7, &t))
    expect(cos_conjunto(bir.BCOND_LT_S as u8, true, ((-9223372036854775807) - 1), &t))
    expect(t.lo == 1 and t.hi == 0)
    expect(cos_conjunto(bir.BCOND_GT_S as u8, false, 9223372036854775807, &t))
    expect(t.lo == ((-9223372036854775807) - 1) and t.hi == 9223372036854775807)
}

test "costura_faixa_decide_e_refina" {
    var faixas = make([dynamic]CosFaixa, alloc = heap, cap = 2)
    append(&faixas, item = CosFaixa{lo = 0, hi = 10})
    let fx: []CosFaixa = faixas[..]
    var r = CosCond{valida = true, vreg = 0, forma = CosForma{raiz = 0}, k = 20, cond = bir.BCOND_LT_S as u8}
    expect(cos_decide(&r, fx) == 1)
    r.k = 5
    expect(cos_decide(&r, fx) == -1)
    r.k = -1
    expect(cos_decide(&r, fx) == 0)
    r.k = 5
    cos_refinar(&r, true, fx)
    expect(fx[0].lo == 0 and fx[0].hi == 4)
    cos_refinar(&r, false, fx)
    expect(fx[0].lo == 0 and fx[0].hi == 4)
    delete(faixas)
}
