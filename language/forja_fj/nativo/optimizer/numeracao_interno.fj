import "nativo/bir"

struct NumChave {
    op: u8
    aux: u8
    classe: u8
    ta: u8
    tb: u8
    ca: u8
    cb: u8
    va: i64
    vb: i64
    desloc: i32
}

struct NumFato {
    chave: NumChave
    res: u32
    dep: [3]u32
    ver: [3]u32
    ebb: u32
    seq: u32
    prox: u32
    hash: u32
    global: u8
    morta: u8
    copia: u8
}

struct NumMarca {
    nfatos: u32
    ncargas: u32
    nverlog: u32
    nmortos: u32
}

struct NumPar {
    ebb: u32
    dom: u32
}

struct NumContagem {
    copia: NumPar
    expr: NumPar
    carga: NumPar
    mortos: u32
}

// O5: v e [dynamic] (len = entradas gravadas ate o topo; n = quantas valem). Crescimento por append, sem realloc.
struct NumVetor {
    v: [dynamic]u32
    n: u32
    cap: u32
}

struct NumSnap {
    dep: [3]u32
    ver: [3]u32
}

struct NumBase {
    slot: u8
    id: u32
}

struct NumCtx {
    f: ?^bir.BirFuncao
    a: bir.AnalisesBir // O5: valor (a funcao corrente mora aqui; o C guarda ponteiro para local, a Forja nao deixa)
    nvregs: u32
    ndefs: ?[]u32
    def_b: ?[]u32
    def_k: ?[]u32
    ultimo_uso: ?[]u32
    pos_bloco: ?[]u32
    ver: ?[]u32
    cp: ?[]u32
    fatos: [dynamic]NumFato // O5: append (C: realloc); nfatos e o topo da pilha
    nfatos: u32
    capfatos: u32
    balde: ?[]u32
    mascara: u32
    cargas: NumVetor
    verlog: NumVetor
    mortos: NumVetor
    seq: u32
    n: NumContagem
    temp: [dynamic]u32
    temp_cap: u64
    temp_usado: u64
}

const NUM_SEM: u32 = 4294967295
const NUM_JANELA_EXPR: u32 = 96
const NUM_JANELA_CARGA: u32 = 64
const NUM_CARGAS_EBB: u32 = 32
const NUM_CADEIA_MAX: u32 = 16
