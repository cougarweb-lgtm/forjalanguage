import "common"
import "nativo/bir"
import "nativo/x64"
import "std:os"

struct PasseOtim {
    nome: ?str
    aplicar: u16
    ligado_por_padrao: bool
    aplicar_programa: u16
}

pub struct OtimRelatos {
    contadores: ?^[dynamic]u8
    passes: ?^[dynamic]u8
}

// C2F:? tabela PASSES (const PasseOtim[16]): ponteiro nao nulo
// C2F:? tabela PASSE_PERFIL (const PasseOtim): ponteiro nao nulo
// C2F-70 global mutavel ligado (int) -> parametro/struct de estado (plano C2F-70)
const NENHUM: OtimRelatos = OtimRelatos{contadores = none, passes = none}

// Tabela de passes (C: PASSES). Ordem = ordem de execucao. aplicar / aplicar_programa sao tags (0 = NULL) do despacho acima.
// Ordem das linhas: checagem, copia_arg, inline, slp, sroa, selecao, cfg, costura, numeracao, licm, endereco, layout, alocador, isel, divconst.
const PASSES: [15]PasseOtim = {PasseOtim{nome = "checagem", aplicar = 2, ligado_por_padrao = true, aplicar_programa = 0}, PasseOtim{nome = "copia_arg", aplicar = 3, ligado_por_padrao = true, aplicar_programa = 0}, PasseOtim{nome = "inline", aplicar = 0, ligado_por_padrao = true, aplicar_programa = 2}, PasseOtim{nome = "slp", aplicar = 0, ligado_por_padrao = true, aplicar_programa = 7}, PasseOtim{nome = "sroa", aplicar = 0, ligado_por_padrao = true, aplicar_programa = 8}, PasseOtim{nome = "selecao", aplicar = 0, ligado_por_padrao = true, aplicar_programa = 6}, PasseOtim{nome = "cfg", aplicar = 1, ligado_por_padrao = true, aplicar_programa = 0}, PasseOtim{nome = "costura", aplicar = 4, ligado_por_padrao = true, aplicar_programa = 0}, PasseOtim{nome = "numeracao", aplicar = 0, ligado_por_padrao = true, aplicar_programa = 4}, PasseOtim{nome = "licm", aplicar = 0, ligado_por_padrao = true, aplicar_programa = 3}, PasseOtim{nome = "endereco", aplicar = 0, ligado_por_padrao = true, aplicar_programa = 1}, PasseOtim{nome = "layout", aplicar = 5, ligado_por_padrao = true, aplicar_programa = 0}, PasseOtim{nome = "alocador", aplicar = 8, ligado_por_padrao = true, aplicar_programa = 0}, PasseOtim{nome = "isel", aplicar = 6, ligado_por_padrao = true, aplicar_programa = 0}, PasseOtim{nome = "divconst", aplicar = 7, ligado_por_padrao = true, aplicar_programa = 0}}

// Fora da tabela: --perfil nao e otimizacao; roda antes do alocador (otim_executar).
const PASSE_PERFIL: PasseOtim = PasseOtim{nome = "perfil", aplicar = 0, ligado_por_padrao = false, aplicar_programa = 5}

pub const PASSE_OTIM_APLICAR_OTIM_CFG_APLICAR: u16 = 1
pub const PASSE_OTIM_APLICAR_OTIM_CHECAGEM_APLICAR: u16 = 2
pub const PASSE_OTIM_APLICAR_OTIM_COPIA_ARG_APLICAR: u16 = 3
pub const PASSE_OTIM_APLICAR_OTIM_COSTURA_APLICAR: u16 = 4
pub const PASSE_OTIM_APLICAR_OTIM_LAYOUT_APLICAR: u16 = 5
pub const PASSE_OTIM_APLICAR_X64_ISEL_MARCAR: u16 = 6
pub const PASSE_OTIM_APLICAR_X64_DIV_CONST_MARCAR: u16 = 7
pub const PASSE_OTIM_APLICAR_X64_ALOCADOR_APLICAR: u16 = 8
pub proc chamar_passe_otim_aplicar(tag: u16, programa: ^bir.BirPrograma, funcao: ^bir.BirFuncao) {
    if tag == 1 {
        otim_cfg_aplicar(programa, funcao)
        return
    }
    if tag == 2 {
        otim_checagem_aplicar(programa, funcao)
        return
    }
    if tag == 3 {
        otim_copia_arg_aplicar(programa, funcao)
        return
    }
    if tag == 4 {
        otim_costura_aplicar(programa, funcao)
        return
    }
    if tag == 5 {
        otim_layout_aplicar(programa, funcao)
        return
    }
    if tag == 6 {
        x64.x64_isel_marcar(programa, funcao)
        return
    }
    if tag == 7 {
        x64.x64_div_const_marcar(programa, funcao)
        return
    }
    if tag == 8 {
        x64.x64_alocador_aplicar(programa, funcao)
        return
    }
    common.falha_interna("otim: tag de passe desconhecida em chamar_passe_otim_aplicar")
}

pub const PASSE_OTIM_APLICAR_PROGRAMA_OTIM_ENDERECO_APLICAR: u16 = 1
pub const PASSE_OTIM_APLICAR_PROGRAMA_OTIM_INLINE_APLICAR: u16 = 2
pub const PASSE_OTIM_APLICAR_PROGRAMA_OTIM_LICM_APLICAR: u16 = 3
pub const PASSE_OTIM_APLICAR_PROGRAMA_OTIM_NUMERACAO_APLICAR: u16 = 4
pub const PASSE_OTIM_APLICAR_PROGRAMA_OTIM_PERFIL_APLICAR: u16 = 5
pub const PASSE_OTIM_APLICAR_PROGRAMA_OTIM_SELECAO_APLICAR: u16 = 6
pub const PASSE_OTIM_APLICAR_PROGRAMA_OTIM_SLP_APLICAR: u16 = 7
pub const PASSE_OTIM_APLICAR_PROGRAMA_OTIM_SROA_APLICAR: u16 = 8
pub proc chamar_passe_otim_aplicar_programa(tag: u16, programa: ^bir.BirPrograma, relato: ^[dynamic]u8) {
    if tag == 1 {
        otim_endereco_aplicar(programa, relato)
        return
    }
    if tag == 2 {
        otim_inline_aplicar(programa, relato)
        return
    }
    if tag == 3 {
        otim_licm_aplicar(programa, relato)
        return
    }
    if tag == 4 {
        otim_numeracao_aplicar(programa, relato)
        return
    }
    if tag == 5 {
        otim_perfil_aplicar(programa, relato)
        return
    }
    if tag == 6 {
        otim_selecao_aplicar(programa, relato)
        return
    }
    if tag == 7 {
        otim_slp_aplicar(programa, relato)
        return
    }
    if tag == 8 {
        otim_sroa_aplicar(programa, relato)
        return
    }
    common.falha_interna("otim: tag de passe desconhecida em chamar_passe_otim_aplicar_programa")
}

// C: nativo/optimizer/passes.c:68
proc otim_qtd_passes() -> u32 {
    return (len(PASSES) as u32)
}

// C: nativo/optimizer/passes.c:77
proc otim_nome_passe(k: u32) -> ?str {
    return PASSES[k as int].nome
}

// C: nativo/optimizer/passes.c:83
// O trecho p[0..<tam] e o nome de algum passe?
proc nome_eh_passe(p: ?str, tam: u64) -> bool {
    let texto: str = p or_else ""
    let t: int = tam as int
    var k: u32 = 0
    while k < otim_qtd_passes() {
        let nome: str = PASSES[k as int].nome or_else ""
        if (len(nome) == t) and (nome == texto[0..<t]) {
            return true
        }
        k += 1
    }
    return false
}

// Tamanho do trecho de s a partir de i ate a virgula ou o NUL (strlen/strchr do C).
proc passo_tam(s: str, i: int) -> int {
    var j: int = i
    while (j < len(s)) and (s[j] != 0) and (s[j] != 44) { // 44 = ','
        j += 1
    }
    return j - i
}

// C: nativo/optimizer/passes.c:93
// "nome1, nome2" (ou "nenhum passe registrado") em saida[0..n): cada pedaco corta como o snprintf do C, e o laco para quando nao cabe mais.
proc listar_passes(saida: []u8, n: u64) {
    let cap_saida: int = n as int
    saida[0] = 0
    let qtd: u32 = otim_qtd_passes()
    if qtd == 0 {
        _ = common.c2f_snprintf(saida[0..<cap_saida], "nenhum passe registrado")
        return
    }
    var usado: u64 = 0
    var k: u32 = 0
    while (k < qtd) and (usado + 1 < n) {
        let nome: str = PASSES[k as int].nome or_else ""
        var sep: str = ""
        if k > 0 {
            sep = ", "
        }
        let pedaco: str = format(f"{sep}{nome}", alloc = heap)
        usado += (common.c2f_snprintf(saida[(usado as int)..<cap_saida], pedaco) as u64)
        delete(pedaco)
        k += 1
    }
}

// Texto heap da lista de passes validos (o %s de listar_passes no buffer de 200 do C).
proc lista_de_passes_heap() -> str {
    var validos: [200]u8 = {}
    listar_passes(validos[..], 200)
    return from_bytes(validos[0..<common.c2f_strlen_b(validos[..])], alloc = heap)
}

// C: nativo/optimizer/passes.c:106
pub proc otim_conferir_lista(lista: ?str, causa: []u8, n: u64) -> bool {
    let s: str = lista or_else ""
    var i: int = 0
    while i < len(s) and (s[i] != 0) {
        let tam: int = passo_tam(s, i)
        let passo: str = s[i..<(i + tam)]
        let virgula: bool = ((i + tam) < len(s)) and (s[i + tam] == 44) // 44 = ','
        if not ((tam == 4) and (passo == "tudo")) and not nome_eh_passe(passo, tam as u64) {
            let validos: str = lista_de_passes_heap()
            let msg: str = format(f"--sem-otim: passo desconhecido '{passo}' (validos: tudo, {validos})", alloc = heap)
            _ = common.c2f_snprintf(causa[0..<(n as int)], msg)
            delete(msg)
            delete(validos)
            return false
        }
        i += tam
        if virgula {
            i += 1
        }
    }
    if (len(s) == 0) or (s[0] == 0) {
        let validos: str = lista_de_passes_heap()
        let msg: str = format(f"--sem-otim pede um passo (validos: tudo, {validos})", alloc = heap)
        _ = common.c2f_snprintf(causa[0..<(n as int)], msg)
        delete(msg)
        delete(validos)
        return false
    }
    return true
}

// C: nativo/optimizer/passes.c:131
// O passe esta em sem_otim ("tudo" desliga todos)?
proc desligado(sem_otim: str, nome: ?str) -> bool {
    let nome_txt: str = nome or_else ""
    var i: int = 0
    while i < len(sem_otim) and (sem_otim[i] != 0) {
        let tam: int = passo_tam(sem_otim, i)
        let passo: str = sem_otim[i..<(i + tam)]
        if ((tam == 4) and (passo == "tudo")) or ((len(nome_txt) == tam) and (nome_txt == passo)) {
            return true
        }
        let virgula: bool = ((i + tam) < len(sem_otim)) and (sem_otim[i + tam] == 44) // 44 = ','
        i += tam
        if virgula {
            i += 1
        }
    }
    return false
}

// C: nativo/optimizer/passes.c:146
proc contar_instrucoes_2(f: ^bir.BirFuncao) -> u32 {
    var n: u32 = 0
    for b in (0 as u32)..<f.nblocos {
        n += f.blocos[b].n
    }
    return n
}

// C: nativo/optimizer/passes.c:156
proc contar_ativos(p: ^bir.BirPrograma, sem_otim: str) -> u32 {
    if p.modo != (bir.BM_RELEASE as u8) {
        return 0
    }
    var n: u32 = 0
    var k: u32 = 0
    while k < otim_qtd_passes() {
        let passe: PasseOtim = PASSES[k as int]
        if passe.ligado_por_padrao and (not desligado(sem_otim, passe.nome)) {
            n += 1
        }
        k += 1
    }
    return n
}

// C: nativo/optimizer/passes.c:170
// Modo teste (FORJA_BIR_VALIDAR=1): a BIR continua valida depois do passe? Le o ambiente a cada chamada (a Forja nao tem static): ver decisao no relato.
proc validar_depois(p: ^bir.BirPrograma, passe: ^PasseOtim, f: ^bir.BirFuncao, erro: ^common.Diag) -> bool {
    let ligado: bool = (os.env("FORJA_BIR_VALIDAR") or_else "") == "1"
    if not ligado {
        return true
    }
    if bir.bir_validar(p, erro) {
        return true
    }
    let causa: str = common.c2f_cortar(erro.causa or_else "", 511)
    let nome_passe: str = passe.nome or_else ""
    let nome_funcao: str = p.simbolos[f.simbolo].nome or_else ""
    let msg: str = format(f"BIR invalida depois do passe '{nome_passe}' na funcao {nome_funcao}: {causa}", alloc = heap)
    let relatado: bool = common.diag_relatar(erro, common.X0904, 0, msg)
    delete(msg)
    return relatado
}

// C: nativo/optimizer/passes.c:187
// Modo teste (FORJA_BIR_ANALISES=1): calcula as analises de cada funcao e confere as invariantes; nao altera a BIR.
proc conferir_analises(p: ^bir.BirPrograma, erro: ^common.Diag) -> bool {
    if (os.env("FORJA_BIR_ANALISES") or_else "") != "1" {
        return true
    }
    let fatia: []bir.BirFuncao = p.funcoes or_else {}
    var i: u32 = 0
    while i < p.nfuncoes {
        let f: ^bir.BirFuncao = &fatia[i]
        if f.nblocos != 0 {
            var a = bir.AnalisesBir{}
            var causa: [200]u8 = {}
            bir.analises_calcular(f, &a)
            let ok: bool = bir.analises_conferir(f, &a, causa[..], 200)
            bir.analises_liberar(&a)
            if not ok {
                let texto: str = from_bytes(causa[0..<common.c2f_strlen_b(causa[..])], alloc = heap)
                let nome_funcao: str = p.simbolos[f.simbolo].nome or_else ""
                let msg: str = format(f"analises da BIR inconsistentes na funcao {nome_funcao}: {texto}", alloc = heap)
                let relatado: bool = common.diag_relatar(erro, common.X0904, 0, msg)
                delete(msg)
                delete(texto)
                return relatado
            }
        }
        i += 1
    }
    return true
}

// C: nativo/optimizer/passes.c:210
// Item passes (G0d): "== <rotulo>" e a BIR inteira.
proc relatar_bir(programa: ^bir.BirPrograma, passes: ^[dynamic]u8, rotulo: str) {
    format(f"== {rotulo}\n", into = passes)
    bir.bir_imprimir(programa, passes)
}

// C: nativo/optimizer/passes.c:219
// relato nulo = nenhum item pedido: o passe de programa ainda recebe um buffer descartavel (a Forja nao passa NULL).
proc aplicar_passe(programa: ^bir.BirPrograma, passe: ^PasseOtim, relato: ?^[dynamic]u8, erro: ^common.Diag) -> bool {
    let antes: []u32 = common.arena_fatia_u32(&programa.arena, (programa.nfuncoes as int) + 1)
    let fatia: []bir.BirFuncao = programa.funcoes or_else {}
    let de_programa: bool = passe.aplicar_programa != 0
    let nome_passe: str = passe.nome or_else ""
    var descarte = make([dynamic]u8, alloc = heap, cap = 64)
    defer delete(descarte)
    var rel: ^[dynamic]u8 = &descarte
    if relato != none {
        rel = relato as ^[dynamic]u8
    }
    var i: u32 = 0
    if de_programa {
        while i < programa.nfuncoes {
            antes[i] = contar_instrucoes_2(&fatia[i])
            i += 1
        }
        chamar_passe_otim_aplicar_programa(passe.aplicar_programa, programa, rel)
    }
    i = 0
    while i < programa.nfuncoes {
        let f: ^bir.BirFuncao = &fatia[i]
        if not de_programa {
            antes[i] = contar_instrucoes_2(f)
            chamar_passe_otim_aplicar(passe.aplicar, programa, f)
        }
        if relato != none {
            let nome_funcao: str = programa.simbolos[f.simbolo].nome or_else ""
            format(f"passe {nome_passe} funcao {nome_funcao} antes={antes[i]} depois={contar_instrucoes_2(f)}\n", into = (relato as ^[dynamic]u8))
        }
        if (not de_programa) and (not validar_depois(programa, passe, f, erro)) {
            return false
        }
        i += 1
    }
    if de_programa and (programa.nfuncoes > 0) {
        return validar_depois(programa, passe, &fatia[0], erro)
    }
    return true
}

// C: nativo/optimizer/passes.c:250
// Passe + o dump da BIR depois dele (item passes). relatos nulo = nada a relatar.
proc aplicar_e_relatar(programa: ^bir.BirPrograma, passe: ^PasseOtim, relatos: ?^OtimRelatos, erro: ^common.Diag) -> bool {
    var contadores: ?^[dynamic]u8 = none
    var passes: ?^[dynamic]u8 = none
    if relatos != none {
        let r: ^OtimRelatos = relatos as ^OtimRelatos
        contadores = r.contadores
        passes = r.passes
    }
    if not aplicar_passe(programa, passe, contadores, erro) {
        return false
    }
    if passes != none {
        let nome_passe: str = passe.nome or_else ""
        let rotulo: str = format(f"passe {nome_passe}", alloc = heap)
        relatar_bir(programa, (passes as ^[dynamic]u8), rotulo)
        delete(rotulo)
    }
    return true
}

// C: nativo/optimizer/passes.c:263
pub proc otim_executar(programa: ^bir.BirPrograma, sem_otim: str, relatos: ?^OtimRelatos, erro: ^common.Diag) -> bool {
    if not conferir_analises(programa, erro) {
        return false
    }
    var contadores: ?^[dynamic]u8 = none
    var passes: ?^[dynamic]u8 = none
    if relatos != none {
        let r: ^OtimRelatos = relatos as ^OtimRelatos
        contadores = r.contadores
        passes = r.passes
    }
    let ativos: u32 = contar_ativos(programa, sem_otim)
    if contadores != none {
        format(f"otim: {ativos} passes\n", into = (contadores as ^[dynamic]u8))
    }
    if passes != none {
        relatar_bir(programa, (passes as ^[dynamic]u8), "entrada")
    }
    var perfil: PasseOtim = PASSE_PERFIL
    if ativos == 0 {
        return (not programa.perfil) or aplicar_e_relatar(programa, &perfil, relatos, erro)
    }
    programa.endereco_ligado = not desligado(sem_otim, "endereco")
    var k: u32 = 0
    while k < otim_qtd_passes() {
        var passe: PasseOtim = PASSES[k as int]
        if programa.perfil and (passe.aplicar == 8) {
            if not aplicar_e_relatar(programa, &perfil, relatos, erro) {
                return false
            }
        }
        if passe.ligado_por_padrao and (not desligado(sem_otim, passe.nome)) {
            if not aplicar_e_relatar(programa, &passe, relatos, erro) {
                return false
            }
        }
        k += 1
    }
    return true
}

test "passes_tabela_e_nomes" {
    expect(otim_qtd_passes() == 15)
    expect((otim_nome_passe(0) or_else "") == "checagem")
    expect((otim_nome_passe(6) or_else "") == "cfg")
    expect((otim_nome_passe(14) or_else "") == "divconst")
    expect(nome_eh_passe("cfg", 3))
    expect(not nome_eh_passe("cf", 2))
    expect(not nome_eh_passe("tudo", 4))
}

test "passes_listar_e_conferir_lista" {
    var buf: [200]u8 = {}
    listar_passes(buf[..], 200)
    let texto: str = from_bytes(buf[0..<common.c2f_strlen_b(buf[..])], alloc = heap)
    expect(texto == "checagem, copia_arg, inline, slp, sroa, selecao, cfg, costura, numeracao, licm, endereco, layout, alocador, isel, divconst")
    delete(texto)
    var causa: [200]u8 = {}
    expect(otim_conferir_lista("tudo", causa[..], 200))
    expect(otim_conferir_lista("cfg,inline", causa[..], 200))
    expect(not otim_conferir_lista("cfg,zzz", causa[..], 200))
    let msg: str = from_bytes(causa[0..<common.c2f_strlen_b(causa[..])], alloc = heap)
    expect(msg == "--sem-otim: passo desconhecido 'zzz' (validos: tudo, checagem, copia_arg, inline, slp, sroa, selecao, cfg, costura, numeracao, licm, endereco, layout, alocador, isel, divconst)")
    delete(msg)
    expect(not otim_conferir_lista("", causa[..], 200))
}

test "passes_desligado_e_contar_ativos" {
    expect(desligado("tudo", "cfg"))
    expect(desligado("cfg,inline", "inline"))
    expect(not desligado("cfg,inline", "slp"))
    expect(not desligado("cfg", "cf"))
    var p = bir.BirPrograma{}
    p.modo = (bir.BM_RELEASE as u8)
    expect(contar_ativos(&p, "") == 15)
    expect(contar_ativos(&p, "cfg,inline") == 13)
    p.modo = 0
    expect(contar_ativos(&p, "") == 0)
}
