import "common"
import "nativo/bir"

// raiz e dono. memoria (u32: ndefs, usos, def_b, def_i, inicio) e vivo_memoria (u8: escapou, morto) sao os donos dos vetores
// que as ?[]T guardam como visoes (a Forja nao tem calloc sem dono).
struct Fatos2 {
    nvregs: u32
    nslots: u32
    ndefs: ?[]u32
    usos: ?[]u32
    raiz: [dynamic]u32
    def_b: ?[]u32
    def_i: ?[]u32
    escapou: ?[]u8
    inicio: ?[]u32
    morto: ?[]u8
    memoria: [dynamic]u32
    vivo_memoria: [dynamic]u8
}

struct Pos {
    b: u32
    c: u32
}

struct Rodada {
    p: ?^bir.BirPrograma
    f: ?^bir.BirFuncao
    t: ?^Fatos2
}

const SEM_RAIZ: u32 = 4294967295
const NAO_ACHOU: u32 = 4294967295
const VOLTAS_MAX: u32 = 8

// C: nativo/optimizer/copia_arg.c:24
proc define_vreg_2(i: ^bir.BirInstr) -> bool {
    if i.dst == bir.BIR_SEM_VREG {
        return false
    }
    return ((((((i.op != (bir.BIR_SALTA as u8)) and (i.op != (bir.BIR_DESVIA as u8))) and (i.op != (bir.BIR_RETORNA as u8))) and (i.op != (bir.BIR_ARMADILHA as u8))) and (i.op != (bir.BIR_GRAVA as u8))) and (i.op != (bir.BIR_COPIA_MEM as u8))) and (i.op != (bir.BIR_ZERA_MEM as u8))
}

// C: nativo/optimizer/copia_arg.c:32
proc eh_vreg(o: ^bir.BirOperando, id: u32) -> bool {
    return (o.tipo == (bir.BO_VREG as u8)) and (o.id == id)
}

// C: nativo/optimizer/copia_arg.c:40
proc achar_funcao(p: ^bir.BirPrograma, simbolo: u32) -> ?^bir.BirFuncao {
    if (simbolo >= p.nsimbolos) or (p.simbolos[simbolo].tipo != (bir.BS_FUNCAO as u8)) {
        return none
    }
    let funcoes = p.funcoes or_else {}
    for k in (0 as u32)..<p.nfuncoes {
        let f: ^bir.BirFuncao = &funcoes[k]
        if (f.simbolo == simbolo) and (f.nblocos > 0) {
            return f
        }
    }
    return none
}

// C: nativo/optimizer/copia_arg.c:52
proc usa_param_alem_de_ler(i: ^bir.BirInstr, k: u32) -> bool {
    if (common.c2f_b2i32(define_vreg_2(i)) != 0) and (i.dst == k) {
        return true
    }
    if (common.c2f_b2i32(eh_vreg(&i.a, k)) != 0) and (i.op != (bir.BIR_CARREGA as u8)) {
        return true
    }
    if (common.c2f_b2i32(eh_vreg(&i.b, k)) != 0) and (i.op != (bir.BIR_COPIA_MEM as u8)) {
        return true
    }
    var m: u32 = 0
    while m < i.nargs {
        if eh_vreg(&(i.args or_else {})[m], k) {
            return true
        }
        m += 1
    }
    return false
}

// C: nativo/optimizer/copia_arg.c:67
proc param_so_lido(g: ?^bir.BirFuncao, k: u32) -> bool {
    var b: u32 = 0
    while b < (g as ^bir.BirFuncao).nblocos {
        var m: u32 = 0
        while m < (g as ^bir.BirFuncao).blocos[b].n {
            if usa_param_alem_de_ler(&(g as ^bir.BirFuncao).blocos[b].instrs[m], k) {
                return false
            }
            m += 1
        }
        b += 1
    }
    return true
}

// C: nativo/optimizer/copia_arg.c:79
proc chamado_so_le(p: ^bir.BirPrograma, i: ^bir.BirInstr, k: u32) -> bool {
    let arg: ^bir.BirOperando = &(i.args or_else {})[k]
    var g: ?^bir.BirFuncao = none
    if ((i.op != (bir.BIR_CHAMA as u8)) or (arg.tam == 0)) or (arg.sysv != none) {
        return false
    }
    g = achar_funcao(p, i.simbolo)
    if ((((g == none) or ((g as ^bir.BirFuncao).param_tam == none)) or ((g as ^bir.BirFuncao).nparams != i.nargs)) or (k >= (g as ^bir.BirFuncao).nparams)) or (((g as ^bir.BirFuncao).param_tam or_else {})[k] != arg.tam) {
        return false
    }
    return param_so_lido(g, k)
}

// C: nativo/optimizer/copia_arg.c:94
proc contar_uso(t: ^Fatos2, o: ^bir.BirOperando) {
    if (o.tipo == (bir.BO_VREG as u8)) and (o.id < t.nvregs) {
        let p_1 = t.usos or_else {}
        p_1[o.id] += 1
    }
}

// C: nativo/optimizer/copia_arg.c:100
proc contar_2(t: ^Fatos2, f: ^bir.BirFuncao) {
    var k: u32 = 0
    while (k < f.nparams) and (k < t.nvregs) {
        let p_1 = t.ndefs or_else {}
        p_1[k] += 1
        k += 1
    }
    var b: u32 = 0
    while b < f.nblocos {
        var m: u32 = 0
        while m < f.blocos[b].n {
            let i: ^bir.BirInstr = &f.blocos[b].instrs[m]
            if (common.c2f_b2i32(define_vreg_2(i)) != 0) and (i.dst < t.nvregs) {
                let p_2 = t.ndefs or_else {}
                p_2[i.dst] += 1
                let p_3 = t.def_b or_else {}
                p_3[i.dst] = b
                let p_4 = t.def_i or_else {}
                p_4[i.dst] = m
            }
            contar_uso(t, &i.a)
            contar_uso(t, &i.b)
            for q in (0 as u32)..<i.nargs {
                contar_uso(t, &(i.args or_else {})[q])
            }
            m += 1
        }
        b += 1
    }
}

// C: nativo/optimizer/copia_arg.c:121
proc raiz_de(t: ^Fatos2, o: ^bir.BirOperando) -> u32 {
    var tern_1: u32 = SEM_RAIZ
    if (o.tipo == (bir.BO_VREG as u8)) and (o.id < t.nvregs) {
        tern_1 = t.raiz[o.id]
    }
    return tern_1
}

// C: nativo/optimizer/copia_arg.c:127
proc raiz_definida(t: ^Fatos2, i: ^bir.BirInstr) -> u32 {
    var ra: u32 = 0
    if ((not define_vreg_2(i)) or (i.dst >= t.nvregs)) or ((t.ndefs or_else {})[i.dst] != 1) {
        return SEM_RAIZ
    }
    if i.op == (bir.BIR_END_SLOT as u8) {
        var tern_1: u32 = SEM_RAIZ
        if ((i.a.tipo == (bir.BO_IMED as u8)) and (i.a.imed >= 0)) and (common.c2f_s2u_64(i.a.imed) < (t.nslots as u64)) {
            tern_1 = i.a.imed as u32
        }
        return tern_1
    }
    ra = raiz_de(t, &i.a)
    if (i.op == (bir.BIR_COPIA as u8)) or (i.op == (bir.BIR_SUB as u8)) {
        return ra
    }
    if i.op == (bir.BIR_ADD as u8) {
        var tern_2: u32 = 0
        if ra != SEM_RAIZ {
            tern_2 = ra
        } else {
            tern_2 = raiz_de(t, &i.b)
        }
        return tern_2
    }
    return SEM_RAIZ
}

// C: nativo/optimizer/copia_arg.c:144
proc propagar_raiz(t: ^Fatos2, i: ^bir.BirInstr) -> bool {
    let r: u32 = raiz_definida(t, i)
    if (r == SEM_RAIZ) or (t.raiz[i.dst] != SEM_RAIZ) {
        return false
    }
    t.raiz[i.dst] = r
    return true
}

// C: nativo/optimizer/copia_arg.c:155
proc calcular_raiz(t: ^Fatos2, f: ^bir.BirFuncao) {
    var mudou: bool = true
    while mudou {
        mudou = false
        var b: u32 = 0
        while b < f.nblocos {
            var m: u32 = 0
            while m < f.blocos[b].n {
                // C: `mudou |= PropagarRaiz(...)` chama sempre; nao curto-circuitar
                let propagou: bool = propagar_raiz(t, &f.blocos[b].instrs[m])
                if propagou {
                    mudou = true
                }
                m += 1
            }
            b += 1
        }
    }
}

// C: nativo/optimizer/copia_arg.c:170
proc marcar_escape(t: ^Fatos2, o: ^bir.BirOperando) {
    let r: u32 = raiz_de(t, o)
    if r != SEM_RAIZ {
        let p_1 = t.escapou or_else {}
        p_1[r] = 1
    }
}

// C: nativo/optimizer/copia_arg.c:179
proc eh_runtime_de_copia(p: ^bir.BirPrograma, simbolo: u32) -> bool {
    var s: ?^bir.BirSimbolo = none
    if simbolo >= p.nsimbolos {
        return false
    }
    s = &p.simbolos[simbolo]
    if ((s as ^bir.BirSimbolo).tipo != (bir.BS_RUNTIME as u8)) or ((s as ^bir.BirSimbolo).nome == none) {
        return false
    }
    return ((p.nomes_mem.copia != none) and (((s as ^bir.BirSimbolo).nome or_else "") == (p.nomes_mem.copia or_else ""))) or ((p.nomes_mem.zera != none) and (((s as ^bir.BirSimbolo).nome or_else "") == (p.nomes_mem.zera or_else "")))
}

// C: nativo/optimizer/copia_arg.c:191
proc escapa_chama(t: ^Fatos2, p: ^bir.BirPrograma, i: ^bir.BirInstr) {
    let runtime: bool = eh_runtime_de_copia(p, i.simbolo)
    marcar_escape(t, &i.a)
    var k: u32 = 0
    while k < i.nargs {
        if (not runtime) and (not chamado_so_le(p, i, k)) {
            marcar_escape(t, &(i.args or_else {})[k])
        }
        k += 1
    }
}

// C: nativo/optimizer/copia_arg.c:203
proc escapa_derivacao(t: ^Fatos2, i: ^bir.BirInstr) {
    let dst_unico: bool = ((common.c2f_b2i32(define_vreg_2(i)) != 0) and (i.dst < t.nvregs)) and ((t.ndefs or_else {})[i.dst] == 1)
    let a_raiz: bool = raiz_de(t, &i.a) != SEM_RAIZ
    let b_raiz: bool = raiz_de(t, &i.b) != SEM_RAIZ
    let ok: bool = ((common.c2f_b2i32(dst_unico) != 0) and (not ((common.c2f_b2i32(a_raiz) != 0) and (common.c2f_b2i32(b_raiz) != 0)))) and (not ((i.op == (bir.BIR_SUB as u8)) and (common.c2f_b2i32(b_raiz) != 0)))
    if ok {
        return
    }
    marcar_escape(t, &i.a)
    marcar_escape(t, &i.b)
}

// C: nativo/optimizer/copia_arg.c:215
proc escapa_instr(t: ^Fatos2, p: ^bir.BirPrograma, i: ^bir.BirInstr) {
    let sw_1 = i.op as i32
    if sw_1 == bir.BIR_CARREGA or sw_1 == bir.BIR_COPIA_MEM or sw_1 == bir.BIR_ZERA_MEM {
        return
    } else if sw_1 == bir.BIR_GRAVA {
        marcar_escape(t, &i.b)
        return
    } else if sw_1 == bir.BIR_END_SLOT {
        if ((((t.ndefs or_else {})[i.dst] != 1) and (i.a.tipo == (bir.BO_IMED as u8))) and (i.a.imed >= 0)) and (common.c2f_s2u_64(i.a.imed) < (t.nslots as u64)) {
            let p_1 = t.escapou or_else {}
            p_1[i.a.imed] = 1
        }
        return
    } else if sw_1 == bir.BIR_COPIA or sw_1 == bir.BIR_ADD or sw_1 == bir.BIR_SUB {
        escapa_derivacao(t, i)
        return
    } else if sw_1 == bir.BIR_CHAMA {
        escapa_chama(t, p, i)
        return
    } else {
        marcar_escape(t, &i.a)
        marcar_escape(t, &i.b)
        for k in (0 as u32)..<i.nargs {
            marcar_escape(t, &(i.args or_else {})[k])
        }
    }
}

// C: nativo/optimizer/copia_arg.c:247
// Forja nao devolve NULL de make (falta de memoria aborta): o retorno e sempre true; o calloc do C testava NULL.
proc reservar(t: ^Fatos2, f: ^bir.BirFuncao) -> bool {
    var total: u32 = 0
    var b: u32 = 0
    while b < f.nblocos {
        total += f.blocos[b].n
        b += 1
    }
    let nv: int = (f.nvregs as int) + 1
    let nb: int = (f.nblocos as int) + 1
    let ns: int = (f.nslots as int) + 1
    let nm: int = (total as int) + 1
    t.nvregs = f.nvregs
    t.nslots = f.nslots
    t.memoria = make([dynamic]u32, alloc = heap, cap = 4 * nv + nb)
    resize(&t.memoria, 4 * nv + nb)
    t.vivo_memoria = make([dynamic]u8, alloc = heap, cap = ns + nm)
    resize(&t.vivo_memoria, ns + nm)
    t.raiz = make([dynamic]u32, alloc = heap, cap = nv)
    resize(&t.raiz, nv)
    let w: []u32 = t.memoria[..]
    t.ndefs = w[0..<nv]
    t.usos = w[nv..<(2 * nv)]
    t.def_b = w[(2 * nv)..<(3 * nv)]
    t.def_i = w[(3 * nv)..<(4 * nv)]
    t.inicio = w[(4 * nv)..<(4 * nv + nb)]
    let vivo: []u8 = t.vivo_memoria[..]
    t.escapou = vivo[0..<ns]
    t.morto = vivo[ns..<(ns + nm)]
    // inicio[b] = indice global da 1a instrucao do bloco b; morto e indexado por ele
    let inicio: []u32 = t.inicio or_else {}
    var acumulado: u32 = 0
    b = 0
    while b < f.nblocos {
        inicio[b] = acumulado
        acumulado += f.blocos[b].n
        b += 1
    }
    var v: u32 = 0
    while v < f.nvregs {
        t.raiz[v] = SEM_RAIZ
        v += 1
    }
    return true
}

// C: nativo/optimizer/copia_arg.c:272
proc liberar(t: ^Fatos2) {
    delete(t.memoria)
    delete(t.vivo_memoria)
    delete(t.raiz)
}

// C: nativo/optimizer/copia_arg.c:284
proc preparar(t: ^Fatos2, p: ^bir.BirPrograma, f: ^bir.BirFuncao) -> bool {
    if not reservar(t, f) {
        return false
    }
    contar_2(t, f)
    calcular_raiz(t, f)
    var b: u32 = 0
    while b < f.nblocos {
        for m in (0 as u32)..<f.blocos[b].n {
            escapa_instr(t, p, &f.blocos[b].instrs[m])
        }
        b += 1
    }
    return true
}

// C: nativo/optimizer/copia_arg.c:299
proc morto(t: ^Fatos2, b: u32, m: u32) -> bool {
    return (t.morto or_else {})[(t.inicio or_else {})[b] + m] != 0
}

// C: nativo/optimizer/copia_arg.c:311
proc achar_copia(t: ^Fatos2, bl: ^bir.BirBloco, chama: Pos, d: u32) -> u32 {
    // C: `for (j = chama.c; j-- > 0;)`: anda de c-1 ate 0
    var j: u32 = chama.c
    while j > 0 {
        j -= 1
        let i: ^bir.BirInstr = &bl.instrs[j]
        if (not morto(t, chama.b, j)) and (i.op == (bir.BIR_COPIA_MEM as u8)) and eh_vreg(&i.a, d) {
            return j
        }
    }
    return NAO_ACHOU
}

// C: nativo/optimizer/copia_arg.c:323
proc grava_na_raiz(t: ^Fatos2, i: ^bir.BirInstr, raiz: u32) -> bool {
    if ((i.op == (bir.BIR_GRAVA as u8)) or (i.op == (bir.BIR_COPIA_MEM as u8))) or (i.op == (bir.BIR_ZERA_MEM as u8)) {
        return raiz_de(t, &i.a) == raiz
    }
    if (i.op != (bir.BIR_CHAMA as u8)) and (i.op != (bir.BIR_CHAMA_IND as u8)) {
        return false
    }
    if (raiz_de(t, &i.a) == raiz) or (raiz_de(t, &i.b) == raiz) {
        return true
    }
    var k: u32 = 0
    while k < i.nargs {
        if raiz_de(t, &(i.args or_else {})[k]) == raiz {
            return true
        }
        k += 1
    }
    return false
}

// C: nativo/optimizer/copia_arg.c:339
proc origem_intacta(t: ^Fatos2, bl: ^bir.BirBloco, chama: Pos, j: u32) -> bool {
    let origem: u32 = bl.instrs[j].b.id
    let raiz: u32 = t.raiz[origem]
    var m: u32 = j + 1
    while m < chama.c {
        let i: ^bir.BirInstr = &bl.instrs[m]
        if morto(t, chama.b, m) {
            m += 1
            continue
        }
        if ((common.c2f_b2i32(define_vreg_2(i)) != 0) and (i.dst == origem)) or (common.c2f_b2i32(grava_na_raiz(t, i, raiz)) != 0) {
            return false
        }
        m += 1
    }
    return true
}

// C: nativo/optimizer/copia_arg.c:356
proc temp_privado(t: ^Fatos2, f: ^bir.BirFuncao, d: u32) -> bool {
    var def: ?^bir.BirInstr = none
    if ((d >= t.nvregs) or ((t.ndefs or_else {})[d] != 1)) or ((t.usos or_else {})[d] != 2) {
        return false
    }
    def = &f.blocos[(t.def_b or_else {})[d]].instrs[(t.def_i or_else {})[d]]
    return (def as ^bir.BirInstr).op == (bir.BIR_END_SLOT as u8)
}

// C: nativo/optimizer/copia_arg.c:367
proc origem_local(t: ^Fatos2, copia: ^bir.BirInstr, d: u32) -> bool {
    var raiz: u32 = 0
    if (copia.b.tipo != (bir.BO_VREG as u8)) or (copia.desloc <= 0) {
        return false
    }
    raiz = raiz_de(t, &copia.b)
    return ((raiz != SEM_RAIZ) and (not ((t.escapou or_else {})[raiz] != 0))) and (raiz != t.raiz[d])
}

// C: nativo/optimizer/copia_arg.c:377
proc tentar_arg(v: ^Rodada, pos: Pos, k: u32) -> bool {
    let t: ?^Fatos2 = v.t
    let bl: ^bir.BirBloco = &(v.f as ^bir.BirFuncao).blocos[pos.b]
    let chama: ^bir.BirInstr = &bl.instrs[pos.c]
    let arg: ^bir.BirOperando = &(chama.args or_else {})[k]
    let d: u32 = arg.id
    var j: u32 = 0
    var copia: ?^bir.BirInstr = none
    if (((arg.tipo != (bir.BO_VREG as u8)) or (arg.tam == 0)) or (not temp_privado(t as ^Fatos2, v.f as ^bir.BirFuncao, d))) or (not chamado_so_le(v.p as ^bir.BirPrograma, chama, k)) {
        return false
    }
    j = achar_copia(t as ^Fatos2, bl, pos, d)
    if j == NAO_ACHOU {
        return false
    }
    copia = &bl.instrs[j]
    if (((copia as ^bir.BirInstr).desloc != transmute(arg.tam, to = i32)) or (not origem_local(t as ^Fatos2, copia as ^bir.BirInstr, d))) or (not origem_intacta(t as ^Fatos2, bl, pos, j)) {
        return false
    }
    let p_1 = chama.args or_else {}
    p_1[k].id = (copia as ^bir.BirInstr).b.id
    let ptr_1: ^Fatos2 = t as ^Fatos2
    let ptr_2: ^Fatos2 = t as ^Fatos2
    let p_2 = ptr_1.morto or_else {}
    p_2[(ptr_2.inicio or_else {})[pos.b] + j] = 1
    let ptr_3: ^Fatos2 = t as ^Fatos2
    let ptr_4: ^Fatos2 = t as ^Fatos2
    let ptr_5: ^Fatos2 = t as ^Fatos2
    let ptr_6: ^Fatos2 = t as ^Fatos2
    let p_3 = ptr_3.morto or_else {}
    p_3[(ptr_4.inicio or_else {})[(ptr_5.def_b or_else {})[d]] + (ptr_6.def_i or_else {})[d]] = 1
    return true
}

// C: nativo/optimizer/copia_arg.c:400
proc tentar_chama(v: ^Rodada, pos: Pos) -> bool {
    let chama: ^bir.BirInstr = &(v.f as ^bir.BirFuncao).blocos[pos.b].instrs[pos.c]
    var mudou: bool = false
    if chama.op != (bir.BIR_CHAMA as u8) {
        return false
    }
    var k: u32 = 0
    while k < chama.nargs {
        // C: `mudou |= TentarArg(...)` chama sempre; nao curto-circuitar
        let tentou: bool = tentar_arg(v, pos, k)
        if tentou {
            mudou = true
        }
        k += 1
    }
    return mudou
}

// C: nativo/optimizer/copia_arg.c:413
proc compactar_2(f: ^bir.BirFuncao, t: ^Fatos2) {
    var b: u32 = 0
    while b < f.nblocos {
        let bl: ^bir.BirBloco = &f.blocos[b]
        var w: u32 = 0
        var m: u32 = 0
        while m < bl.n {
            if not morto(t, b, m) {
                let antes_1: u32 = w
                w += 1
                bl.instrs[antes_1] = bl.instrs[m]
            }
            m += 1
        }
        bl.n = w
        b += 1
    }
}

// C: nativo/optimizer/copia_arg.c:428
proc volta(p: ^bir.BirPrograma, f: ^bir.BirFuncao) -> bool {
    var t = Fatos2{}
    var r = Rodada{p = p, f = f, t = &t}
    var mudou: bool = false
    if not preparar(&t, p, f) {
        liberar(&t)
        return false
    }
    var b: u32 = 0
    while b < f.nblocos {
        var c: u32 = 0
        while c < f.blocos[b].n {
            // C: `mudou |= TentarChama(...)` chama sempre; nao curto-circuitar
            let tentou: bool = tentar_chama(&r, Pos{b = b, c = c})
            if tentou {
                mudou = true
            }
            c += 1
        }
        b += 1
    }
    if mudou {
        compactar_2(f, &t)
    }
    liberar(&t)
    return mudou
}

// C: nativo/optimizer/copia_arg.c:449
proc tem_copia_mem(f: ^bir.BirFuncao) -> bool {
    for b in (0 as u32)..<f.nblocos {
        for m in (0 as u32)..<f.blocos[b].n {
            if f.blocos[b].instrs[m].op == (bir.BIR_COPIA_MEM as u8) {
                return true
            }
        }
    }
    return false
}

// C: nativo/optimizer/copia_arg.c:460
proc otim_copia_arg_aplicar(programa: ^bir.BirPrograma, funcao: ^bir.BirFuncao) {
    if (funcao.nblocos == 0) or (not tem_copia_mem(funcao)) {
        return
    }
    for _volta in (0 as u32)..<VOLTAS_MAX {
        if not volta(programa, funcao) {
            return
        }
    }
}

// ---- testes dirigidos (funcoes montadas a mao; helpers com prefixo cpat_ para nao colidir no pacote)

proc cpat_vreg(id: u32) -> bir.BirOperando {
    return bir.BirOperando{tipo = (bir.BO_VREG as u8), classe = (bir.BC_I64 as u8), id = id}
}

proc cpat_imed(valor: i64) -> bir.BirOperando {
    return bir.BirOperando{tipo = (bir.BO_IMED as u8), classe = (bir.BC_I64 as u8), imed = valor}
}

proc cpat_bloco(f: ^bir.BirFuncao) -> u32 {
    append(&f.blocos, item = bir.BirBloco{})
    f.blocos[f.nblocos].instrs = make([dynamic]bir.BirInstr, alloc = heap, cap = 8)
    f.nblocos += 1
    return f.nblocos - 1
}

proc cpat_emite(f: ^bir.BirFuncao, b: u32, ins: bir.BirInstr) {
    append(&f.blocos[b].instrs, item = ins)
    f.blocos[b].n += 1
}

proc cpat_libera(f: ^bir.BirFuncao) {
    var k: u32 = 0
    while k < f.nblocos {
        delete(f.blocos[k].instrs)
        k += 1
    }
    delete(f.blocos)
}

test "copia_arg_calcula_raiz_de_end_slot_e_copia" {
    var f = bir.BirFuncao{}
    f.blocos = make([dynamic]bir.BirBloco, alloc = heap, cap = 4)
    f.nvregs = 2
    f.nslots = 1
    let b: u32 = cpat_bloco(&f)
    cpat_emite(&f, b, bir.BirInstr{op = (bir.BIR_END_SLOT as u8), dst = 0, a = cpat_imed(0)})
    cpat_emite(&f, b, bir.BirInstr{op = (bir.BIR_COPIA as u8), dst = 1, a = cpat_vreg(0)})
    var t = Fatos2{}
    expect(reservar(&t, &f))
    contar_2(&t, &f)
    calcular_raiz(&t, &f)
    expect(t.raiz[0] == 0)
    expect(t.raiz[1] == 0)
    liberar(&t)
    cpat_libera(&f)
}

test "copia_arg_acha_copia_mais_proxima_antes_do_chama" {
    var f = bir.BirFuncao{}
    f.blocos = make([dynamic]bir.BirBloco, alloc = heap, cap = 4)
    f.nvregs = 6
    f.nslots = 0
    let b: u32 = cpat_bloco(&f)
    cpat_emite(&f, b, bir.BirInstr{op = (bir.BIR_ADD as u8), dst = 0, a = cpat_imed(1), b = cpat_imed(2)})
    cpat_emite(&f, b, bir.BirInstr{op = (bir.BIR_COPIA_MEM as u8), a = cpat_vreg(5)})
    cpat_emite(&f, b, bir.BirInstr{op = (bir.BIR_CHAMA as u8)})
    var t = Fatos2{}
    expect(reservar(&t, &f))
    expect(achar_copia(&t, &f.blocos[b], Pos{b = b, c = 2}, 5) == 1)
    expect(achar_copia(&t, &f.blocos[b], Pos{b = b, c = 2}, 4) == NAO_ACHOU)
    liberar(&t)
    cpat_libera(&f)
}

test "copia_arg_volta_sem_copia_nao_muda" {
    var prog = bir.BirPrograma{}
    var f = bir.BirFuncao{}
    f.blocos = make([dynamic]bir.BirBloco, alloc = heap, cap = 4)
    let b: u32 = cpat_bloco(&f)
    cpat_emite(&f, b, bir.BirInstr{op = (bir.BIR_RETORNA as u8)})
    expect(not volta(&prog, &f))
    cpat_libera(&f)
}
