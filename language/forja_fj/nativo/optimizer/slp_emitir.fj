import "common"
import "nativo/bir"

struct Sequencia {
    seq: [128]bir.BirInstr
    nseq: u32
    vet: [64]u32
    proximo: u32
    forma: u8
}

const SEQ_MAX: u32 = 128

// C: nativo/optimizer/slp_emitir.c:25
proc op_vreg(id: u32, classe: u8) -> bir.BirOperando {
    return bir.BirOperando{tipo = bir.BO_VREG as u8, classe = classe, id = id}
}

// C: nativo/optimizer/slp_emitir.c:30
proc nova_instr_2(op: u8, classe: u8, dst: u32, molde: ^bir.BirInstr) -> bir.BirInstr {
    var i: bir.BirInstr = bir.BirInstr{}
    i.op = op
    i.classe = classe
    i.dst = dst
    i.pos = molde.pos
    i.ir = molde.ir
    i.simbolo = bir.BIR_SEM_SIMBOLO
    i.alvo[0] = bir.BIR_SEM_BLOCO
    i.alvo[1] = bir.BIR_SEM_BLOCO
    return i
}

// C: nativo/optimizer/slp_emitir.c:46
proc acrescentar_2(s: ^Sequencia, i: bir.BirInstr) {
    let antes_1: u32 = s.nseq
    s.nseq += 1
    s.seq[antes_1] = i
}

// C: nativo/optimizer/slp_emitir.c:52
proc vregs_novos(pl: ^SlpPlano) -> u32 {
    var n: u32 = 0
    for k in (0 as u32)..<pl.nno {
        var tern_1: u32 = 1
        if (pl.no[k].tipo == (SN_CARGA_REPETIDA as u8)) or (pl.no[k].tipo == (SN_CONSTANTE as u8)) {
            tern_1 = 2
        }
        n += tern_1
    }
    return n
}

// C: nativo/optimizer/slp_emitir.c:62
proc crescer_vregs_2(programa: ^bir.BirPrograma, f: ^bir.BirFuncao, novos: u32) {
    let velha: []u8 = f.classe_vreg or_else {}
    let nova: []u8 = common.arena_fatia_u8(&programa.arena, (f.nvregs + novos + 1) as int)
    var k: u32 = 0
    while k < f.nvregs {
        nova[k] = velha[k]
        k += 1
    }
    f.classe_vreg = nova
}

// C: nativo/optimizer/slp_emitir.c:71
proc novo_vreg_3(f: ^bir.BirFuncao, s: ?^Sequencia, classe: u8) -> u32 {
    let seq: ^Sequencia = s as ^Sequencia
    let vregs: []u8 = f.classe_vreg or_else {}
    vregs[seq.proximo] = classe
    let antes_1: u32 = seq.proximo
    seq.proximo += 1
    return antes_1
}

// C: nativo/optimizer/slp_emitir.c:79
// C2F-INDECIDIVEL: instrs
proc escalar_do_no(f: ^bir.BirFuncao, s: ?^Sequencia, pl: ^SlpPlano, no: ^SlpNo, instrs: []bir.BirInstr, molde: ^bir.BirInstr) -> u32 {
    let v: u32 = novo_vreg_3(f, s, pl.classe)
    if no.tipo == (SN_CARGA_REPETIDA as u8) {
        var i: bir.BirInstr = instrs[no.modelo]
        i.dst = v
        acrescentar_2(s as ^Sequencia, i)
    } else {
        var i: bir.BirInstr = nova_instr_2(bir.BIR_CONST as u8, pl.classe, v, molde)
        i.a = no.valor
        acrescentar_2(s as ^Sequencia, i)
    }
    return v
}

// C: nativo/optimizer/slp_emitir.c:99
// C2F-INDECIDIVEL: instrs
proc emitir_no(f: ^bir.BirFuncao, s: ?^Sequencia, pl: ^SlpPlano, k: u32, instrs: []bir.BirInstr, molde: ^bir.BirInstr) {
    let no: ^SlpNo = &pl.no[k]
    var dst: u32 = 0
    var i: bir.BirInstr = bir.BirInstr{}
    if no.tipo == (SN_CARGA as u8) {
        dst = novo_vreg_3(f, s, bir.BC_V128 as u8)
        i = instrs[no.modelo]
        i.classe = bir.BC_V128 as u8
        i.dst = dst
        i.aux = (s as ^Sequencia).forma
    } else if no.tipo == (SN_OPERACAO as u8) {
        dst = novo_vreg_3(f, s, bir.BC_V128 as u8)
        i = nova_instr_2(no.op, bir.BC_V128 as u8, dst, molde)
        i.a = op_vreg((s as ^Sequencia).vet[no.filho[0]], bir.BC_V128 as u8)
        i.b = op_vreg((s as ^Sequencia).vet[no.filho[1]], bir.BC_V128 as u8)
        i.aux = (s as ^Sequencia).forma
    } else {
        var origem: bir.BirOperando = no.valor
        if no.tipo != (SN_VREG as u8) {
            let arg_1: u8 = pl.classe
            let arg_2: u32 = escalar_do_no(f, s, pl, no, instrs, molde)
            origem = op_vreg(arg_2, arg_1)
        }
        dst = novo_vreg_3(f, s, bir.BC_V128 as u8)
        i = nova_instr_2(bir.BIR_SPLAT as u8, bir.BC_V128 as u8, dst, molde)
        i.a = origem
        i.aux = (s as ^Sequencia).forma
    }
    acrescentar_2(s as ^Sequencia, i)
    let ptr_1: ^Sequencia = s as ^Sequencia
    ptr_1.vet[k] = dst
}

// C: nativo/optimizer/slp_emitir.c:132
// C2F-INDECIDIVEL: instrs
proc gravacao_vetorial(s: ?^Sequencia, pl: ^SlpPlano, instrs: []bir.BirInstr) -> bir.BirInstr {
    var g: bir.BirInstr = instrs[pl.loja[0]]
    g.classe = bir.BC_V128 as u8
    g.b = op_vreg((s as ^Sequencia).vet[pl.raiz], bir.BC_V128 as u8)
    g.aux = (s as ^Sequencia).forma
    return g
}

// C: nativo/optimizer/slp_emitir.c:144
proc reescrever_bloco(blk: ^bir.BirBloco, pl: ^SlpPlano, s: ?^Sequencia, pos_conta: u32, pos_loja: u32) {
    let seq: ^Sequencia = s as ^Sequencia
    var apaga = make([dynamic]u8, alloc = heap, cap = (blk.n as int) + 1)
    defer delete(apaga)
    var z: u32 = 0
    while z <= blk.n {
        append(&apaga, item = 0)
        z += 1
    }
    let marcas: []u8 = apaga[..]
    var k: u32 = 0
    while k < pl.nsomem {
        marcas[pl.somem[k]] = 1
        k += 1
    }
    var l: u32 = 0
    while l < pl.lanes {
        marcas[pl.loja[l]] = 1
        l += 1
    }
    let grava: bir.BirInstr = gravacao_vetorial(s, pl, blk.instrs[..])
    var novo = make([dynamic]bir.BirInstr, alloc = heap, cap = (blk.n as int) + (SEQ_MAX as int) + 1)
    defer delete(novo)
    var q: u32 = 0
    while q < blk.n {
        if q == pos_conta {
            var j: u32 = 0
            while j < seq.nseq {
                append(&novo, item = seq.seq[j])
                j += 1
            }
        } else if q == pos_loja {
            append(&novo, item = grava)
        } else if marcas[q] == 0 {
            append(&novo, item = blk.instrs[q])
        }
        q += 1
    }
    let total: u32 = len(novo) as u32
    delete(blk.instrs)
    blk.instrs = make([dynamic]bir.BirInstr, alloc = heap, cap = (total as int) + 1)
    var r: u32 = 0
    while r < total {
        append(&blk.instrs, item = novo[r])
        r += 1
    }
    blk.n = total
    blk.cap = (cap(blk.instrs) as u64) as u32
}

// C: nativo/optimizer/slp_emitir.c:182
proc slp_aplicar_plano(c: ^SlpCtx, pl: ^SlpPlano) {
    let f: ^bir.BirFuncao = c.f as ^bir.BirFuncao
    let blk: ^bir.BirBloco = &f.blocos[c.bloco]
    var seq = Sequencia{}
    var pos_conta: u32 = 0
    var pos_loja: u32 = 0
    var k: u32 = 0
    while k < pl.nsomem {
        if pl.somem[k] > pos_conta {
            pos_conta = pl.somem[k]
        }
        k += 1
    }
    var l: u32 = 0
    while l < pl.lanes {
        if pl.loja[l] > pos_loja {
            pos_loja = pl.loja[l]
        }
        l += 1
    }
    var molde: bir.BirInstr = blk.instrs[pos_loja]
    if pl.classe == (bir.BC_F32 as u8) {
        seq.forma = bir.BVEC_4XF32 as u8
    } else {
        seq.forma = bir.BVEC_2XF64 as u8
    }
    seq.proximo = f.nvregs
    crescer_vregs_2(c.p as ^bir.BirPrograma, f, vregs_novos(pl))
    var no_k: u32 = 0
    while no_k < pl.nno {
        emitir_no(f, &seq, pl, no_k, blk.instrs[..], &molde)
        no_k += 1
    }
    f.nvregs += vregs_novos(pl)
    reescrever_bloco(blk, pl, &seq, pos_conta, pos_loja)
}
