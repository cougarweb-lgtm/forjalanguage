// C: nativo/nativo.c:234
proc ler_entrada_libc(m: ^Montagem) -> bool {
    var n: u64 = 0
    let bytes: ^u8 = rt_nativo_linux_entrada_libc(&n)
    var pasta: [SEMENTE_TAM_PASTA]u8 = {}
    if not obj.coff_ler(bytes, n, &m.entrada, &m.erro) {
        return false
    }
    let pasta_achada: bool = semente_musl_pasta(pasta[..], SEMENTE_TAM_PASTA as u64)
    let pasta_txt: str = from_bytes(pasta[0..<common.c2f_strlen_b(pasta[..])], alloc = frame)
    if (not pasta_achada) or (not semente_musl_completa(pasta_txt)) {
        let causa: str = format(f"foreign no alvo x86_64-linux pede a semente musl (crt1.o e libc.a) em '{pasta_txt}', e ela nao esta la", alloc = heap)
        _ = common.diag_relatar(&m.erro, common.X0003, 0, causa)
        _ = common.diag_sugerir(&m.erro.sug, common.DIAG_CERTA, "restaure language\\third\\musl\\x86_64 (LEIAME.txt e construir_musl.sh no WSL alpine-build) ou compile sem foreign")
        return false
    }
    if not semente_musl_crt1(pasta_txt, (m.pedido as ^NativoPedido).pie, &m.semente) {
        let causa_crt1: str = format(f"crt1.o da semente musl em '{pasta_txt}' nao le como ELF x86-64", alloc = heap)
        _ = common.diag_relatar(&m.erro, common.X0003, 0, causa_crt1)
        return false
    }
    m.tem_semente = true
    return true
}

// C: nativo/nativo.c:256
proc ler_entrada(m: ^Montagem) -> bool {
    if not montagem_e_elf(m) {
        return true
    }
    let pedido: ^NativoPedido = m.pedido as ^NativoPedido
    if nativo_usa_runtime_crt(pedido, &m.bir) or nativo_usa_threads_no_elf(&m.bir) {
        return ler_entrada_libc(m)
    }
    var n: u64 = 0
    var bytes: ^u8 = rt_nativo_linux_entrada(&n)
    if pedido.pie {
        bytes = rt_nativo_linux_entrada_pie(&n)
    }
    return obj.coff_ler(bytes, n, &m.entrada, &m.erro)
}

