// C: nativo/nativo.c:149
proc relatar_erro(m: ^Montagem) -> i32 {
    var etapa_origem: ?str = m.etapa
    if m.erro.codigo == common.X0902 {
        etapa_origem = ETAPA_CODIFICAR
    }
    var bir_origem: ?^bir.BirPrograma = none
    if m.bir_viva {
        bir_origem = &m.bir
    }
    var campos_origem: ?str = none
    if len(m.falha_lib.campos) > 0 {
        campos_origem = from_bytes(m.falha_lib.campos[..], alloc = frame)
    }
    var origem = ErroOrigem{etapa = etapa_origem, bir = bir_origem, bir_funcoes = m.bir_funcoes, campos = campos_origem}
    return nativo_relatar_erro(m.pedido as ^NativoPedido, &m.erro, &origem)
}

// C: nativo/nativo.c:157
proc recusar_com_x0003(p: ^NativoPedido, causa: ?str) -> i32 {
    common.diag_imprimir_json_sem_fonte(common.X0003, causa, common.c2f_saida_stderr(), sd_do_pedido(p))
    return SAIDA_USO
}

// C: nativo/nativo.c:164
proc injetou(m: ^Montagem, etapa: str) -> bool {
    m.etapa = etapa
    return nativo_injetar_falha(m.pedido as ^NativoPedido, etapa, &m.erro)
}

// C: nativo/nativo.c:171
proc runtime_usa_ryu(runtime: ^obj.Objeto, ryu: ^obj.Objeto) -> bool {
    var k: u64 = 0
    while k < (len(ryu.simbolos) as u64) {
        let def: ^obj.ObjSimbolo = &ryu.simbolos[k]
        var tern_1: i64 = -1
        if (common.c2f_b2i32(def.global) != 0) and (def.secao >= 0) {
            tern_1 = obj.obj_achar_simbolo(runtime, def.nome)
        }
        let i: i64 = tern_1
        if (i >= 0) and (runtime.simbolos[common.c2f_s2u_64(i)].secao == obj.OBJ_SECAO_INDEFINIDA) {
            return true
        }
        k += 1
    }
    return false
}

// C: nativo/nativo.c:183
// Ponte: o alvo ELF e o formato do Alvo; comparacao com o mesmo idioma do ler_legado
proc montagem_e_elf(m: ^Montagem) -> bool {
    return common.c2f_s2u_32((m.alvo as ^x64.Alvo).formato) == (pefmt.IMAGEM_ELF as u32)
}

// C: nativo/nativo.c:183
// rt_objeto_de so devolve ponteiro para dado embutido (sem copia): o ramo nao escolhido e trocado sem custo
proc ler_ryu(m: ^Montagem) -> bool {
    var n: u64 = 0
    var bytes: ^u8 = rt_nativo_win_ryu(&n)
    if montagem_e_elf(m) {
        bytes = rt_nativo_linux_comum(&n)
    }
    if not obj.coff_ler(bytes, n, &m.ryu, &m.erro) {
        return false
    }
    m.usa_ryu = runtime_usa_ryu(&m.runtime, &m.ryu)
    return true
}

// C: nativo/nativo.c:195
proc ler_legado(m: ^Montagem) -> bool {
    var n: u64 = 0
    let bytes: ^u8 = rt_nativo_win_legado(&n)
    if common.c2f_s2u_32((m.alvo as ^x64.Alvo).formato) == (pefmt.IMAGEM_ELF as u32) {
        return true
    }
    return obj.coff_ler(bytes, n, &m.legado, &m.erro)
}

