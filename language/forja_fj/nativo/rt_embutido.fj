const RT_LINUX_ENTRADA_LIBC: str = #load("../compiler/rt_linux_entrada_libc.o")
const RT_LINUX_ENTRADA_PIE: str = #load("../compiler/rt_linux_entrada_pie.o")
const RT_LINUX_CURTO: str = #load("../compiler/rt_linux_curto.o")
const RT_LINUX_THREAD: str = #load("../compiler/rt_linux_thread.o")
