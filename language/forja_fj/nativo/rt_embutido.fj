// Dev e rel do Windows: o tamanho sai do const embutido e o cabecalho COFF (machine 0x8664, bytes 64 86) confere.
test "rt_embutido_win_dev_e_rel" {
    var n_dev: u64 = 0
    var n_rel: u64 = 0
    let dev = rt_nativo_win(bir.BM_DEV as u8, &n_dev)
    let rel = rt_nativo_win(1, &n_rel)
    expect(n_dev == (len(RT_WIN_DEV) as u64))
    expect(n_rel == (len(RT_WIN_REL) as u64))
    expect(n_dev != n_rel)
    expect(dev^ == 0x64)
    expect(rel^ == 0x64)
}

// Linux: o modo escolhe dev ou rel; o tamanho sai do const de cada um; o cabecalho e COFF (64 86) como no Windows.
test "rt_embutido_linux_dev_e_rel" {
    var n_dev: u64 = 0
    var n_rel: u64 = 0
    let dev = rt_nativo_linux(bir.BM_DEV as u8, &n_dev)
    let rel = rt_nativo_linux(1, &n_rel)
    expect(n_dev == (len(RT_LINUX_DEV) as u64))
    expect(n_rel == (len(RT_LINUX_REL) as u64))
    expect(dev^ == 0x64)
    expect(rel^ == 0x64)
}

// Os objetos de um so modo: cada accessor devolve o tamanho do seu const.
test "rt_embutido_objetos_de_um_modo" {
    var n: u64 = 0
    _ = rt_nativo_win_ryu(&n)
    expect(n == (len(RT_WIN_RYU) as u64))
    _ = rt_nativo_linux_comum(&n)
    expect(n == (len(RT_LINUX_COMUM) as u64))
    _ = rt_nativo_win_legado(&n)
    expect(n == (len(RT_WIN_LEGADO) as u64))
    _ = rt_nativo_math(&n)
    expect(n == (len(RT_MATH) as u64))
    _ = rt_nativo_win_curto(&n)
    expect(n == (len(RT_WIN_CURTO) as u64))
    _ = rt_nativo_linux_entrada_pie(&n)
    expect(n == (len(RT_LINUX_ENTRADA_PIE) as u64))
}
