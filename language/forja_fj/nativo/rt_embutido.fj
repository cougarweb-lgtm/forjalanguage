// Os objetos do runtime entram por #load (relativo a pasta raiz forja_fj, como o doc_embutida); o .o e o arquivo inteiro, sem NUL final.
const RT_WIN_DEV: str = #load("../compiler/rt_win_dev.o")
const RT_WIN_REL: str = #load("../compiler/rt_win_rel.o")
const RT_WIN_DEV_CRT: str = #load("../compiler/rt_win_dev_crt.o")
const RT_WIN_REL_CRT: str = #load("../compiler/rt_win_rel_crt.o")
const RT_WIN_RYU: str = #load("../compiler/rt_win_ryu.o")
