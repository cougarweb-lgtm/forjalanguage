const RT_WIN_CURTO: str = #load("../compiler/rt_win_curto.o")
const RT_MATH: str = #load("../compiler/rt_math.o")
const RT_WIN_ES: str = #load("../compiler/rt_win_es.o")
const RT_WIN_THREAD: str = #load("../compiler/rt_win_thread.o")
const RT_WIN_SYNC: str = #load("../compiler/rt_win_sync.o")
const RT_WIN_ATOMIC: str = #load("../compiler/rt_win_atomic.o")
const RT_WIN_VARENA: str = #load("../compiler/rt_win_varena.o")
const RT_WIN_NET: str = #load("../compiler/rt_win_net.o")
const RT_WIN_PERFIL: str = #load("../compiler/rt_win_perfil.o")
const RT_LINUX_PERFIL: str = #load("../compiler/rt_linux_perfil.o")
const RT_LINUX_DEV: str = #load("../compiler/rt_linux_dev.o")
const RT_LINUX_REL: str = #load("../compiler/rt_linux_rel.o")
const RT_LINUX_COMUM: str = #load("../compiler/rt_linux_comum.o")
const RT_LINUX_ES: str = #load("../compiler/rt_linux_es.o")
