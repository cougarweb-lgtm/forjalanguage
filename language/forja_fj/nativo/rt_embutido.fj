// Devolve o ponteiro para o primeiro byte do objeto e o tamanho em n^ (o tamanho do arquivo, sem NUL final).
proc rt_objeto_de(objeto: str, n: ^u64) -> ^u8 {
    let bytes = as_bytes(objeto)
    n^ = len(bytes) as u64
    return &bytes[0]
}

// C: nativo/rt_embutido.c:391
proc rt_nativo_win(modo: u8, n: ^u64) -> ^u8 {
    if modo == (bir.BM_DEV as u8) {
        return rt_objeto_de(RT_WIN_DEV, n)
    }
    return rt_objeto_de(RT_WIN_REL, n)
}

// C: nativo/rt_embutido.c:402
proc rt_nativo_win_crt(modo: u8, n: ^u64) -> ^u8 {
    if modo == (bir.BM_DEV as u8) {
        return rt_objeto_de(RT_WIN_DEV_CRT, n)
    }
    return rt_objeto_de(RT_WIN_REL_CRT, n)
}

