import "common"

// C2F-82 macro de funcao CAMPO_TEMPO ( membro ) { # membro , offsetof ( NativoTempos , membro ) }
// Decisao (porte V4): a tabela NATIVO_TEMPOS_CAMPOS do C vira dois laços de if por posicao (nome e campo),
// na mesma ordem do registro; a Forja nao tem offsetof, e ler o membro pelo nome da o mesmo valor do memcpy do C.

// C: nativo/nativo_tempos.c:20 (NATIVO_TEMPOS_CAMPOS, ordem 0..12; so os 10 primeiros entram em NativoTemposFechar)
pub proc nativo_tempos_nome(k: u64) -> str {
    if k == 0 {
        return "lex_ns"
    }
    if k == 1 {
        return "parse_ns"
    }
    if k == 2 {
        return "check_ns"
    }
    if k == 3 {
        return "ir_ns"
    }
    if k == 4 {
        return "bir_ns"
    }
    if k == 5 {
        return "isel_ns"
    }
    if k == 6 {
        return "regs_ns"
    }
    if k == 7 {
        return "codificar_ns"
    }
    if k == 8 {
        return "ligar_ns"
    }
    if k == 9 {
        return "escrever_ns"
    }
    if k == 10 {
        return "outros_ns"
    }
    if k == 11 {
        return "total_ns"
    }
    if k == 12 {
        return "linhas"
    }
    return ""
}

// C: nativo/nativo_tempos.c:26
proc nativo_tempos_valor(t: ^NativoTempos, k: u64) -> u64 {
    if k == 0 {
        return t.lex_ns
    }
    if k == 1 {
        return t.parse_ns
    }
    if k == 2 {
        return t.check_ns
    }
    if k == 3 {
        return t.ir_ns
    }
    if k == 4 {
        return t.bir_ns
    }
    if k == 5 {
        return t.isel_ns
    }
    if k == 6 {
        return t.regs_ns
    }
    if k == 7 {
        return t.codificar_ns
    }
    if k == 8 {
        return t.ligar_ns
    }
    if k == 9 {
        return t.escrever_ns
    }
    if k == 10 {
        return t.outros_ns
    }
    if k == 11 {
        return t.total_ns
    }
    if k == 12 {
        return t.linhas
    }
    // C: k fora de 0..12 le memoria alem da tabela (UB); aqui devolve 0 em vez de ler lixo
    return 0
}

// C: nativo/nativo_tempos.c:34
proc nativo_tempos_anexar_json(b: ^[dynamic]u8, t: ^NativoTempos) {
    var k: u64 = 0
    while k < NATIVO_TEMPOS_QTD as u64 {
        let nome: str = nativo_tempos_nome(k)
        let valor: u64 = nativo_tempos_valor(t, k)
        format(f", \"{nome}\": {valor}", into = b)
        k += 1
    }
}

// C: nativo/nativo_tempos.c:40
proc nativo_tempos_fechar(t: ^NativoTempos) {
    var soma: u64 = 0
    var k: u64 = 0
    while k < NATIVO_TEMPOS_ETAPAS as u64 {
        soma += nativo_tempos_valor(t, k)
        k += 1
    }
    t.total_ns = common.relogio_ns() - t.inicio_ns
    if soma > t.total_ns {
        let msg: str = format(f"tempos: a soma das etapas ({soma} ns) passa do total ({t.total_ns} ns); inicio_ns={t.inicio_ns}", alloc = heap)
        defer delete(msg)
        common.falha_interna(msg)
    }
    t.outros_ns = t.total_ns - soma
}

// C: nativo/nativo_tempos.c:53
pub proc nativo_tempos_gravar(caminho: ?str, emit_ns: u64, t: ^NativoTempos, fonte: ^common.Fonte) -> bool {
    var texto: [dynamic]u8 = make([dynamic]u8, alloc = heap)
    defer delete(texto)
    nativo_tempos_fechar(t)
    t.linhas = common.fonte_contar_linhas(fonte)
    format(f"{{\"emit_ns\": {emit_ns}", into = &texto)
    nativo_tempos_anexar_json(&texto, t)
    append(&texto, item = "}\n")
    let dados: str = from_bytes(texto[..], alloc = heap)
    defer delete(dados)
    return common.arquivo_gravar(caminho, dados, len(dados) as u64)
}

// testes: valores e texto conferidos a mao contra nativo_tempos.c (ordem do registro, formato ", \"%s\": %llu")
test "nativo_tempos_nome e valor seguem a ordem do registro" {
    var t = NativoTempos{lex_ns = 1, parse_ns = 2, check_ns = 3, ir_ns = 4, bir_ns = 5, isel_ns = 6, regs_ns = 7, codificar_ns = 8, ligar_ns = 9, escrever_ns = 10, outros_ns = 11, total_ns = 12, linhas = 13, inicio_ns = 99}
    expect(nativo_tempos_nome(0) == "lex_ns" and nativo_tempos_nome(9) == "escrever_ns" and nativo_tempos_nome(12) == "linhas")
    expect(nativo_tempos_valor(&t, 0) == 1 and nativo_tempos_valor(&t, 9) == 10 and nativo_tempos_valor(&t, 12) == 13)
}

test "nativo_tempos_anexar_json gera os 13 campos na ordem" {
    var t = NativoTempos{lex_ns = 1, parse_ns = 2, check_ns = 3, ir_ns = 4, bir_ns = 5, isel_ns = 6, regs_ns = 7, codificar_ns = 8, ligar_ns = 9, escrever_ns = 10, outros_ns = 11, total_ns = 12, linhas = 13, inicio_ns = 99}
    var b: [dynamic]u8 = make([dynamic]u8, alloc = heap)
    defer delete(b)
    nativo_tempos_anexar_json(&b, &t)
    let s: str = from_bytes(b[..], alloc = heap)
    defer delete(s)
    expect(s == ", \"lex_ns\": 1, \"parse_ns\": 2, \"check_ns\": 3, \"ir_ns\": 4, \"bir_ns\": 5, \"isel_ns\": 6, \"regs_ns\": 7, \"codificar_ns\": 8, \"ligar_ns\": 9, \"escrever_ns\": 10, \"outros_ns\": 11, \"total_ns\": 12, \"linhas\": 13")
}
