import "common"
import "frontend"
import "ir"
import "semantic"

struct ParteFormata {
    classe: i32
    funcao: ?str
    extensao: u8
}

struct PedidoParte {
    parte: ?^ParteFormata
    valor: ?^ir.Valor
}

const FORMATA_AUX_QTD: u32 = 4
// C2F-80: tabela FINAIS (FinalFn ponteiro de funcao) vira cadeia por op_aux em bir_regra_formata
const PARTES: [12]ParteFormata = {
    ParteFormata{classe = semantic.TC_CSTR, funcao = "forja_fmt_cstr", extensao = BE_NENHUMA as u8},
    ParteFormata{classe = semantic.TC_BOOL, funcao = "forja_fmt_bool", extensao = BE_ZERO as u8},
    ParteFormata{classe = semantic.TC_I8, funcao = "forja_fmt_i64", extensao = BE_SINAL as u8},
    ParteFormata{classe = semantic.TC_I16, funcao = "forja_fmt_i64", extensao = BE_SINAL as u8},
    ParteFormata{classe = semantic.TC_I32, funcao = "forja_fmt_i64", extensao = BE_SINAL as u8},
    ParteFormata{classe = semantic.TC_INT, funcao = "forja_fmt_i64", extensao = BE_NENHUMA as u8},
    ParteFormata{classe = semantic.TC_U8, funcao = "forja_fmt_u64", extensao = BE_ZERO as u8},
    ParteFormata{classe = semantic.TC_U16, funcao = "forja_fmt_u64", extensao = BE_ZERO as u8},
    ParteFormata{classe = semantic.TC_U32, funcao = "forja_fmt_u64", extensao = BE_ZERO as u8},
    ParteFormata{classe = semantic.TC_UINT, funcao = "forja_fmt_u64", extensao = BE_NENHUMA as u8},
    ParteFormata{classe = semantic.TC_REAL, funcao = "forja_fmt_f32", extensao = BE_NENHUMA as u8},
    ParteFormata{classe = semantic.TC_F64, funcao = "forja_fmt_f64", extensao = BE_NENHUMA as u8},
}
const PARTE_TEXTO: ParteFormata = ParteFormata{classe = semantic.TC_TEXTO, funcao = "forja_fmt_str", extensao = BE_NENHUMA as u8}

// C: nativo/bir/bir_construir_formata.c:28
// C2F-INDECIDIVEL: tabela const nao tem endereco na Forja (E0301): devolve a parte por valor
proc achar_parte(classe: i32) -> ?ParteFormata {
    if classe == semantic.TC_TEXTO {
        return PARTE_TEXTO
    }
    for k in 0..<len(PARTES) {
        if PARTES[k].classe == classe {
            return PARTES[k]
        }
    }
    return none
}

// C: nativo/bir/bir_construir_formata.c:42
proc parte_em_vreg(classe: i32) -> bool {
    let sw_1 = common.c2f_s2u_32(classe)
    if sw_1 == (semantic.TC_CSTR as u32) or sw_1 == (semantic.TC_REAL as u32) or sw_1 == (semantic.TC_F64 as u32) {
        return true
    } else {
        return false
    }
    return false
}

// C: nativo/bir/bir_construir_formata.c:53
proc alargar_real_para_double(c: ^BirCtx, classe: i32, saida: ^BirOperando) {
    if (common.c2f_s2u_32(classe) == (semantic.TC_REAL as u32)) and (saida.classe == (BC_F32 as u8)) {
        saida^ = op_vreg(bir_conta_nova(c, BC_F64 as u8, BirPedido{op = BIR_F_PARA_F as u8, a = saida^}), BC_F64 as u8)
    }
}

// C: nativo/bir/bir_construir_formata.c:60
proc argumento_da_parte(c: ^BirCtx, i: ^ir.IrInstr, pedido: ^PedidoParte, saida: ^BirOperando) -> bool {
    let parte: ?^ParteFormata = pedido.parte
    let valor: ?^ir.Valor = pedido.valor
    if common.c2f_s2u_32((parte as ^ParteFormata).classe) == (semantic.TC_TEXTO as u32) {
        return bir_argumento_agregado(c, i, valor as ^ir.Valor, saida)
    }
    if not bir_operando_de(c, i, valor as ^ir.Valor, saida) {
        return false
    }
    if (common.c2f_b2i32(parte_em_vreg((parte as ^ParteFormata).classe)) != 0) and (not bir_operando_vreg(c, saida^, saida)) {
        return false
    }
    alargar_real_para_double(c, (parte as ^ParteFormata).classe, saida)
    saida^ = op_com_extensao(saida^, (parte as ^ParteFormata).extensao)
    return true
}

// C: nativo/bir/bir_construir_formata.c:77
proc funcao_da_parte(parte: ?^ParteFormata, fmt_c: u32) -> str {
    if ((fmt_c & (frontend.FMT_CURTO as u32)) == 0) or ((common.c2f_s2u_32((parte as ^ParteFormata).classe) != (semantic.TC_REAL as u32)) and (common.c2f_s2u_32((parte as ^ParteFormata).classe) != (semantic.TC_F64 as u32))) {
        return ((parte as ^ParteFormata).funcao or_else "")
    }
    var tern_1: str = "forja_fmt_f64_curto"
    if common.c2f_s2u_32((parte as ^ParteFormata).classe) == (semantic.TC_REAL as u32) {
        tern_1 = "forja_fmt_f32_curto"
    }
    return tern_1
}

// C: nativo/bir/bir_construir_formata.c:85
// C: forja_fmt_<tipo>(valor, formato): o formato e o V_INT do par (largura, zeros, hexa, precisao, curto).
proc emitir_parte(c: ^BirCtx, i: ^ir.IrInstr, formato: ^ir.Valor, valor: ^ir.Valor) -> bool {
    var args: []BirOperando = arena_fatia_bir_operando(&(c.p as ^BirPrograma).arena, 2)
    let achado: ?ParteFormata = achar_parte(semantic.tipo_classe_de((c.e as ^BirEntrada).tipos as ^semantic.Tipos, valor.tipo))
    if achado == none {
        return bir_falha_tipo(c, i, "-", valor.tipo)
    }
    var parte: ParteFormata = achado or_else ParteFormata{}
    var pedido: PedidoParte = PedidoParte{parte = &parte, valor = valor}
    if not argumento_da_parte(c, i, &pedido, &args[0]) {
        return false
    }
    args[1] = op_imed((formato.inteiro as u32) as i64, BC_I32 as u8)
    var chamada: BirChamadaRt = BirChamadaRt{funcao = funcao_da_parte(pedido.parte, (formato.inteiro as u32)), retorno = BC_NADA as u8, nargs = 2}
    _ = bir_chamar_runtime(c, &chamada, args)
    return true
}

// C: nativo/bir/bir_construir_formata.c:101
proc final_imprime(c: ^BirCtx, i: ^ir.IrInstr) -> bool {
    var lit_1 = BirChamadaRt{funcao = "forja_fmt_imprimir", retorno = BC_NADA as u8, nargs = 0}
    _ = bir_chamar_runtime(c, &lit_1, none)
    return true
}

// C: nativo/bir/bir_construir_formata.c:109
proc final_imprime_erro(c: ^BirCtx, i: ^ir.IrInstr) -> bool {
    var lit_1 = BirChamadaRt{funcao = "forja_fmt_imprimir_erro", retorno = BC_NADA as u8, nargs = 0}
    _ = bir_chamar_runtime(c, &lit_1, none)
    return true
}

// C: nativo/bir/bir_construir_formata.c:117
// C2F-INDECIDIVEL: args
proc argumentos_final(c: ^BirCtx, i: ^ir.IrInstr, args: []BirOperando) -> bool {
    var linha: u32 = 0
    if not bir_alocador_de(c, i, &i.a, &args[0]) {
        return false
    }
    args[1] = bir_vreg_do_arquivo(c, i.pos, &linha)
    args[2] = op_imed(linha as i64, BC_I32 as u8)
    return true
}

// C: nativo/bir/bir_construir_formata.c:129
// C: temp(str) = forja_fmt_str_final(...): o str de 16 B sai no slot do temporario pelo CHAMA.a.
proc final_str(c: ^BirCtx, i: ^ir.IrInstr) -> bool {
    var pedido: BirPedidoSlot = BirPedidoSlot{temporario = true, id = i.destino}
    let args: []BirOperando = arena_fatia_bir_operando(&(c.p as ^BirPrograma).arena, 3)
    var destino: u32 = 0
    if (not argumentos_final(c, i, args)) or (not bir_forma(c, semantic.TIPO_STR as u32, &pedido.forma)) or (not bir_definir_slot(c, &pedido, &destino)) {
        return false
    }
    let chama: ^BirInstr = bir_emitir(c, BIR_CHAMA, BC_NADA as u8)
    chama.simbolo = bir_simbolo_runtime(c, "forja_fmt_str_final")
    chama.args = args
    chama.nargs = 3
    chama.a = op_vreg(destino, BC_I64 as u8)
    chama.a.tam = pedido.forma.tam
    return true
}

// C: nativo/bir/bir_construir_formata.c:148
// C: temp(cstr) = forja_fmt_cstr_final(...): o ponteiro num vreg I64.
proc final_cstr(c: ^BirCtx, i: ^ir.IrInstr) -> bool {
    let args: []BirOperando = arena_fatia_bir_operando(&(c.p as ^BirPrograma).arena, 3)
    var dst: u32 = 0
    if (not argumentos_final(c, i, args)) or (not bir_definir_destino(c, BC_I64 as u8, &dst)) {
        return false
    }
    var chamada: BirChamadaRt = BirChamadaRt{funcao = "forja_fmt_cstr_final", retorno = BC_I64 as u8, nargs = 3}
    bir_mover(c, dst, op_vreg(bir_chamar_runtime(c, &chamada, args), BC_I64 as u8))
    return true
}

// C: nativo/bir/bir_construir_formata.c:164
// C2F-80: FINAIS (ponteiro de funcao) virou cadeia por op_aux: 0 imprime, 1 str, 2 cstr, 3 imprime_erro
proc bir_regra_formata(c: ^BirCtx, i: ^ir.IrInstr) -> bool {
    if ((i.nargs & 1) != 0) or ((i.op_aux as u32) >= FORMATA_AUX_QTD) {
        return bir_falha_inconsistente(c, "IR_FORMATA com args que nao sao pares ou op_aux desconhecido")
    }
    var inicio: BirChamadaRt = BirChamadaRt{funcao = "forja_fmt_inicio", retorno = BC_NADA as u8, nargs = 0}
    _ = bir_chamar_runtime(c, &inicio, none)
    var argumentos: []ir.Valor = i.args or_else {}
    var k: u32 = 0
    while k < i.nargs {
        if not emitir_parte(c, i, &argumentos[k], &argumentos[k + 1]) {
            return false
        }
        k = k + 2
    }
    if i.op_aux == 0 {
        return final_imprime(c, i)
    }
    if i.op_aux == 1 {
        return final_str(c, i)
    }
    if i.op_aux == 2 {
        return final_cstr(c, i)
    }
    if i.op_aux == 3 {
        return final_imprime_erro(c, i)
    }
    common.falha_interna("bir_regra_formata: op_aux fora da tabela FINAIS")
    return false
}

test "formata_achar_parte" {
    let texto: ParteFormata = achar_parte(semantic.TC_TEXTO as i32) or_else ParteFormata{}
    expect((texto.funcao or_else "") == "forja_fmt_str")
    expect(texto.extensao == (BE_NENHUMA as u8))
    let real: ParteFormata = achar_parte(semantic.TC_REAL as i32) or_else ParteFormata{}
    expect((real.funcao or_else "") == "forja_fmt_f32")
    let cstr: ParteFormata = achar_parte(semantic.TC_CSTR as i32) or_else ParteFormata{}
    expect((cstr.funcao or_else "") == "forja_fmt_cstr")
    let u8p: ParteFormata = achar_parte(semantic.TC_U8 as i32) or_else ParteFormata{}
    expect((u8p.funcao or_else "") == "forja_fmt_u64")
    expect(u8p.extensao == (BE_ZERO as u8))
    let i8p: ParteFormata = achar_parte(semantic.TC_I8 as i32) or_else ParteFormata{}
    expect((i8p.funcao or_else "") == "forja_fmt_i64")
    expect(i8p.extensao == (BE_SINAL as u8))
    expect(achar_parte(semantic.TC_STRUCT as i32) == none)
}

test "formata_parte_em_vreg" {
    expect(parte_em_vreg(semantic.TC_CSTR as i32))
    expect(parte_em_vreg(semantic.TC_REAL as i32))
    expect(parte_em_vreg(semantic.TC_F64 as i32))
    expect(parte_em_vreg(semantic.TC_I32 as i32) == false)
    expect(parte_em_vreg(semantic.TC_TEXTO as i32) == false)
    expect(parte_em_vreg(semantic.TC_STRUCT as i32) == false)
}

test "formata_funcao_da_parte" {
    var real: ParteFormata = achar_parte(semantic.TC_REAL as i32) or_else ParteFormata{}
    var f64p: ParteFormata = achar_parte(semantic.TC_F64 as i32) or_else ParteFormata{}
    var u8p: ParteFormata = achar_parte(semantic.TC_U8 as i32) or_else ParteFormata{}
    expect(funcao_da_parte(&real, 0) == "forja_fmt_f32")
    expect(funcao_da_parte(&real, frontend.FMT_CURTO as u32) == "forja_fmt_f32_curto")
    expect(funcao_da_parte(&f64p, frontend.FMT_CURTO as u32) == "forja_fmt_f64_curto")
    expect(funcao_da_parte(&f64p, 0) == "forja_fmt_f64")
    expect(funcao_da_parte(&u8p, frontend.FMT_CURTO as u32) == "forja_fmt_u64")
}
