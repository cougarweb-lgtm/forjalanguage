import "common"

// C: nativo/bir/bir_selecao.c:12
proc mesmo_operando(p: ^BirOperando, q: ^BirOperando) -> bool {
    if ((p.tipo as i32) != (q.tipo as i32)) or ((p.classe as i32) != (q.classe as i32)) {
        return false
    }
    var tern_1: i32 = common.c2f_b2i32((p.tipo == (BO_IMED as u8)) and (p.imed == q.imed))
    if p.tipo == (BO_VREG as u8) {
        tern_1 = common.c2f_b2i32(p.id == q.id)
    }
    return tern_1 != 0
}

// C: nativo/bir/bir_selecao.c:19
pub proc bir_seleciona_min_max(i: ?^BirInstr, maximo: ^bool, primeiro: ^?^BirOperando, segundo: ^?^BirOperando) -> bool {
    var x: ?^BirOperando = none
    var y: ?^BirOperando = none
    var direta: bool = false
    if ((((i as ^BirInstr).op != (BIR_SELECIONA as u8)) or (not bir_classe_eh_real((i as ^BirInstr).classe as i32))) or ((i as ^BirInstr).nargs != 2)) or (((i as ^BirInstr).aux != (BCOND_FLT as u8)) and ((i as ^BirInstr).aux != (BCOND_FGT as u8))) {
        return false
    }
    x = &((i as ^BirInstr).args or_else {})[0]
    y = &((i as ^BirInstr).args or_else {})[1]
    if (common.c2f_b2i32(mesmo_operando(&(i as ^BirInstr).a, x as ^BirOperando)) != 0) and (common.c2f_b2i32(mesmo_operando(&(i as ^BirInstr).b, y as ^BirOperando)) != 0) {
        direta = true
    } else if (common.c2f_b2i32(mesmo_operando(&(i as ^BirInstr).a, y as ^BirOperando)) != 0) and (common.c2f_b2i32(mesmo_operando(&(i as ^BirInstr).b, x as ^BirOperando)) != 0) {
        direta = false
    } else {
        return false
    }
    maximo^ = common.c2f_b2i32((i as ^BirInstr).aux == (BCOND_FLT as u8)) != common.c2f_b2i32(direta)
    var tern_1: ?^BirOperando = y
    if common.c2f_b2i32(direta) != 0 {
        tern_1 = x
    }
    primeiro^ = tern_1
    var tern_2: ?^BirOperando = x
    if common.c2f_b2i32(direta) != 0 {
        tern_2 = y
    }
    segundo^ = tern_2
    return true
}

test "bir_selecao_min_max" {
    var args: [2]BirOperando = {op_vreg(1, BC_F32 as u8), op_vreg(2, BC_F32 as u8)}
    var ins: BirInstr = BirInstr{op = BIR_SELECIONA as u8, classe = BC_F32 as u8, nargs = 2, aux = BCOND_FLT as u8, a = op_vreg(1, BC_F32 as u8), b = op_vreg(2, BC_F32 as u8), args = args[..]}
    var maximo: bool = true
    var primeiro: ?^BirOperando = none
    var segundo: ?^BirOperando = none
    expect(bir_seleciona_min_max(&ins, &maximo, &primeiro, &segundo))
    expect(maximo == false)
    expect((primeiro as ^BirOperando).id == 1)
    expect((segundo as ^BirOperando).id == 2)
    ins.aux = BCOND_FGT as u8
    expect(bir_seleciona_min_max(&ins, &maximo, &primeiro, &segundo))
    expect(maximo)
    expect((primeiro as ^BirOperando).id == 1)
    expect((segundo as ^BirOperando).id == 2)
    ins.a = op_vreg(2, BC_F32 as u8)
    ins.b = op_vreg(1, BC_F32 as u8)
    expect(bir_seleciona_min_max(&ins, &maximo, &primeiro, &segundo))
    expect(maximo == false)
    expect((primeiro as ^BirOperando).id == 2)
    expect((segundo as ^BirOperando).id == 1)
    ins.aux = BCOND_FLT as u8
    expect(bir_seleciona_min_max(&ins, &maximo, &primeiro, &segundo))
    expect(maximo)
    expect((primeiro as ^BirOperando).id == 2)
    expect((segundo as ^BirOperando).id == 1)
    ins.a = op_vreg(3, BC_F32 as u8)
    ins.b = op_vreg(2, BC_F32 as u8)
    expect(bir_seleciona_min_max(&ins, &maximo, &primeiro, &segundo) == false)
    ins.a = op_vreg(1, BC_F32 as u8)
    ins.b = op_vreg(2, BC_F32 as u8)
    ins.aux = BCOND_EQ as u8
    expect(bir_seleciona_min_max(&ins, &maximo, &primeiro, &segundo) == false)
    ins.aux = BCOND_FLT as u8
    ins.classe = BC_I64 as u8
    expect(bir_seleciona_min_max(&ins, &maximo, &primeiro, &segundo) == false)
    ins.classe = BC_F32 as u8
    ins.nargs = 3
    expect(bir_seleciona_min_max(&ins, &maximo, &primeiro, &segundo) == false)
    ins.nargs = 2
    ins.op = BIR_COPIA as u8
    expect(bir_seleciona_min_max(&ins, &maximo, &primeiro, &segundo) == false)
}
