import "common"
import "ir"

struct BirRotulo {
    bloco: u32
}

struct BirLaco {
    continua: ?^BirRotulo
    pare: ?^BirRotulo
}

struct BirCtx {
    e: ?^BirEntrada
    p: ?^BirPrograma
    d: ?^common.Diag
    alcance: ?^BirAlcance
    atual: ?^ir.IrInstr
    f: ?^BirFuncao
    cur: u32
    cap_vregs: u32
    vreg_local: ?[]i32
    vreg_temp: ?[]i32
    cap_local: u32
    cap_temp: u32
    n_local: u32
    n_temp: u32
    regras: [dynamic]BirRegra // F2: copia unica de REGRAS_IR_2 (bir_regras_copiar); vazia = bir_achar_regra cai no caminho antigo
    regras_primeira: [256]i32 // F3: por op, indice+1 da 1a regra desse op na tabela; 0 = nenhuma
    regras_prox: [101]i32 // F3: por regra, indice+1 da proxima regra do mesmo op na tabela; 0 = fim
    lacos: [dynamic]BirLaco
    nlacos: u32
    cap_lacos: u32
    simbolo_do_nome: [dynamic]u32
    n_nomes: u32
    hash: [dynamic]u32
    cap_hash: u32
    n_hash: u32
    n_texto: u32
    n_dado: u32
    comparador_runtime: bool
    tem_main: bool
    main_simbolo: u32
    main_retorno: u8
    main_tipo: u32 // TipoId
    varredura: ?^[dynamic]BirOcorrencia
    lay: ir.Layouts
    lay_pronto: bool
    slot_local: ?[]i32
    slot_temp: ?[]i32
    tipo_local: ?[]u32
    em_memoria: ?[]u8
    funcao_ir: ?^ir.IrFuncao
    num: ir.IrNumeracao
    slot_traco: i32
    dado_simbolo: ?[]u32 // F4: por IrDado, simbolo BS_DADO + 1 (0 = ainda nao criado); alocado na 1a leitura de V_DADO
}

pub struct BirOcorrencia {
    pos: u32
    causa: ?str
}

struct BirPedido {
    op: u8
    aux: u8
    dst: u32
    a: BirOperando
    b: BirOperando
}

struct BirPedidoSlot {
    temporario: bool
    id: i32
    forma: BirSlot
}

struct BirCampoInfo {
    offset: u32
    tipo: u32 // TipoId
}

struct BirBaseCampo {
    endereco: u32
    tipo_struct: u32 // TipoId
}

struct BirAlvoMem {
    base: u32
    offset: u32
    tipo: u32 // TipoId
}

struct BirOrigemNulo {
    oque: ?str
    arquivo: ?str
    linha: u32
}

struct BirListaRef {
    endereco: u32
    tipo: u32 // TipoId
}

struct BirChamadaRt {
    funcao: ?str
    retorno: u8
    nargs: u32
}

struct MapaRef {
    endereco: u32
    tipo: u32 // TipoId
    chave: u32 // TipoId
    valor: u32 // TipoId
    forma_chave: BirSlot
    forma_valor: BirSlot
    texto: bool
}

struct ServicoMapa {
    funcao: ?str
    funcao_k4: ?str
    funcao_k8: ?str
    retorno: u8
    com_valor: bool
}

struct PedidoMapa {
    i: ?^ir.IrInstr
    mapa: ?^MapaRef
    servico: ?^ServicoMapa
}

const RES_PARTE_FLAG: i32 = 0
const RES_PARTE_VALOR: i32 = 1
const RES_PARTE_ERRO: i32 = 2
const BIR_SIMBOLO_EXTERNO: u32 = 4294967294
// C2F-82 macro de funcao BirConfereLimites ( c ) ( ( c ) -> p -> modo == BM_DEV || ( c ) -> p -> checagem )
const OPC_MEMBRO_TEM: u32 = 0
const OPC_MEMBRO_VALOR: u32 = 1
const UNIAO_MEMBRO_TAG: u32 = 0
const UNIAO_MEMBRO_VARIANTE: u32 = 1
const LISTA_MEMBRO_PTR: u32 = 0
const LISTA_MEMBRO_LEN: u32 = 1
const LISTA_MEMBRO_CAP: u32 = 2
const LISTA_MEMBRO_ALOCADOR: u32 = 3
const LISTA_MEMBRO_EPOCA: u32 = 4

// C: nativo/bir/bir_interno.h:139
proc op_vreg(id: u32, classe: u8) -> BirOperando {
    return BirOperando{tipo = BO_VREG as u8, classe = classe, id = id}
}

// C: nativo/bir/bir_interno.h:144
proc op_imed(valor: i64, classe: u8) -> BirOperando {
    return BirOperando{tipo = BO_IMED as u8, classe = classe, imed = valor}
}

// C: nativo/bir/bir_interno.h:150
proc bir_indice_no_limite(c: ^BirCtx, indice: BirOperando, limite: i64) -> bool {
    return ((((c.p as ^BirPrograma).modo != (BM_DEV as u8)) and (indice.tipo == (BO_IMED as u8))) and (indice.imed >= 0)) and (indice.imed < limite)
}

// C: nativo/bir/bir_interno.h:155
proc op_simbolo(simbolo: u32) -> BirOperando {
    return BirOperando{tipo = BO_SIMBOLO as u8, classe = BC_I64 as u8, id = simbolo}
}

// C: nativo/bir/bir_interno.h:160
proc op_com_extensao(o: BirOperando, extensao: u8) -> BirOperando {
    var o_v: BirOperando = o
    o_v.extensao = extensao
    return o_v
}
