import "common"
import "ir"
import "semantic"

const ARGS_AFIRMA: i32 = 4

// C: nativo/bir/bir_construir_afirma.c:15
// C2F: args era ponteiro + n do C; a fatia carrega o tamanho (n = len)
proc chamar_runtime(c: ^BirCtx, funcao: str, args: []BirOperando) {
    let n: u32 = (len(args) as u64) as u32
    let copia: []BirOperando = arena_fatia_bir_operando(&(c.p as ^BirPrograma).arena, n as int)
    for k in (0 as u32)..<n {
        copia[k] = args[k]
    }
    let chama: ^BirInstr = bir_emitir(c, BIR_CHAMA, BC_NADA as u8)
    chama.simbolo = bir_simbolo_runtime(c, funcao)
    chama.args = copia
    chama.nargs = n
}

// C: nativo/bir/bir_construir_afirma.c:27
proc endereco_do_texto(c: ^BirCtx, bytes: str, tam: u32) -> BirOperando {
    return op_vreg(bir_vreg_do_texto(c, bytes, tam), BC_I64 as u8)
}

// C: nativo/bir/bir_construir_afirma.c:33
proc mensagem_literal(c: ^BirCtx, i: ^ir.IrInstr, v: ^ir.Valor, saida: ^BirOperando) -> bool {
    if (v.tipo_no != (ir.V_TEXTO as u8)) and (v.tipo == (semantic.TIPO_CSTR as u32)) {
        return (common.c2f_b2i32(bir_operando_de(c, i, v, saida)) != 0) and (common.c2f_b2i32(bir_operando_vreg(c, saida^, saida)) != 0)
    }
    if v.tipo_no != (ir.V_TEXTO as u8) {
        return bir_falha_tipo(c, i, "-", v.tipo)
    }
    let arg_1: u32 = common.interner_tam((c.e as ^BirEntrada).nomes as ^common.Interner, v.id)
    let arg_2: str = common.interner_texto((c.e as ^BirEntrada).nomes as ^common.Interner, v.id)
    let arg_3: ^BirCtx = c
    saida^ = endereco_do_texto(arg_3, arg_2, arg_1)
    return true
}

// C: nativo/bir/bir_construir_afirma.c:44
proc arquivo_e_linha(c: ^BirCtx, i: ^ir.IrInstr, arquivo: ^BirOperando, linha: ^BirOperando) {
    var numero: u32 = 0
    arquivo^ = bir_vreg_do_arquivo(c, i.pos, &numero)
    linha^ = op_imed(numero as i64, BC_I32 as u8)
}

// C: nativo/bir/bir_construir_afirma.c:53
proc condicao(c: ^BirCtx, i: ^ir.IrInstr, saida: ^BirOperando) -> bool {
    if not bir_operando_de(c, i, &i.a, saida) {
        return false
    }
    saida^ = op_com_extensao(saida^, BE_ZERO as u8)
    return true
}

// C: nativo/bir/bir_construir_afirma.c:61
proc bir_regra_assert(c: ^BirCtx, i: ^ir.IrInstr) -> bool {
    var args: [4]BirOperando = {BirOperando{}, BirOperando{}, BirOperando{}, BirOperando{}}
    if (not condicao(c, i, &args[0])) or (not mensagem_literal(c, i, &i.b, &args[1])) {
        return false
    }
    arquivo_e_linha(c, i, &args[2], &args[3])
    chamar_runtime(c, "forja_assert", args[..])
    return true
}

// C: nativo/bir/bir_construir_afirma.c:72
proc bir_regra_expect(c: ^BirCtx, i: ^ir.IrInstr) -> bool {
    var args: [4]BirOperando = {BirOperando{}, BirOperando{}, BirOperando{}, BirOperando{}}
    if not condicao(c, i, &args[0]) {
        return false
    }
    let nome_txt: str = common.interner_texto((c.e as ^BirEntrada).nomes as ^common.Interner, i.nome)
    args[1] = endereco_do_texto(c, nome_txt, common.interner_tam((c.e as ^BirEntrada).nomes as ^common.Interner, i.nome))
    arquivo_e_linha(c, i, &args[2], &args[3])
    chamar_runtime(c, "forja_expect", args[..])
    return true
}

// C: nativo/bir/bir_construir_afirma.c:84
proc bir_regra_panic(c: ^BirCtx, i: ^ir.IrInstr) -> bool {
    var args: [3]BirOperando = {BirOperando{}, BirOperando{}, BirOperando{}}
    if not mensagem_literal(c, i, &i.a, &args[0]) {
        return false
    }
    arquivo_e_linha(c, i, &args[1], &args[2])
    bir_armadilha(c, bir_simbolo_runtime(c, "forja_panic"), args[..])
    return true
}
