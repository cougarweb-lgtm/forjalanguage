import "common"
import "ir"
import "semantic"

struct BirBaseIndexavel {
    dados: u32
    n: BirOperando
    elemento: u32 // TipoId
    lista: bool
    epoca: u32
}

const FATIA_CAMPO_PTR: u32 = 0
const FATIA_CAMPO_LEN: u32 = 1

// C: nativo/bir/bir_construir_array.c:29
proc offset_da_fatia(c: ^BirCtx, fatia: u32, campo: u32) -> u32 {
    return ir.layout_offset_campo(bir_layouts(c), fatia, campo)
}

// C: nativo/bir/bir_construir_array.c:35
proc bir_inteiro64(c: ^BirCtx, i: ^ir.IrInstr, v: ^ir.Valor, saida: ^BirOperando) -> bool {
    var o: BirOperando = BirOperando{}
    if not bir_operando_de(c, i, v, &o) {
        return false
    }
    if o.classe == (BC_I64 as u8) {
        saida^ = o
        return true
    }
    if o.tipo == (BO_IMED as u8) {
        saida^ = op_imed(o.imed, BC_I64 as u8)
        return true
    }
    var tern_1: i32 = BIR_EXT_S
    if common.c2f_b2i32(semantic.tipo_eh_sem_sinal(v.tipo)) != 0 {
        tern_1 = BIR_EXT_Z
    }
    saida^ = op_vreg(bir_conta_nova(c, BC_I64 as u8, BirPedido{op = tern_1 as u8, a = o}), BC_I64 as u8)
    return true
}

// C: nativo/bir/bir_construir_array.c:53
proc inteiro64_em_vreg(c: ^BirCtx, i: ^ir.IrInstr, v: ^ir.Valor, saida: ^BirOperando) -> bool {
    return (common.c2f_b2i32(bir_inteiro64(c, i, v, saida)) != 0) and (common.c2f_b2i32(bir_operando_vreg(c, saida^, saida)) != 0)
}

// C: nativo/bir/bir_construir_array.c:59
proc base_de_fatia(c: ^BirCtx, i: ^ir.IrInstr, v: ^ir.Valor, base: ^BirBaseIndexavel) -> bool {
    var endereco: u32 = 0
    var len_c: u32 = 0
    if not bir_endereco_de(c, i, v, &endereco) {
        return false
    }
    base.dados = bir_novo_vreg(c, BC_I64 as u8)
    len_c = bir_novo_vreg(c, BC_I64 as u8)
    let arg_1: i32 = transmute(offset_da_fatia(c, v.tipo, FATIA_CAMPO_PTR), to = i32)
    let arg_2: u32 = endereco
    let arg_3: u32 = base.dados
    let arg_4: ^BirCtx = c
    bir_emitir_carrega(arg_4, arg_3, arg_2, arg_1)
    bir_emitir_carrega(c, len_c, endereco, transmute(offset_da_fatia(c, v.tipo, FATIA_CAMPO_LEN), to = i32))
    base.n = op_vreg(len_c, BC_I64 as u8)
    base.elemento = semantic.tipo_de((c.e as ^BirEntrada).tipos as ^semantic.Tipos, v.tipo).a
    return true
}

// C: nativo/bir/bir_construir_array.c:75
proc base_de_ponteiro_de_array(c: ^BirCtx, i: ^ir.IrInstr, v: ^ir.Valor, base: ^BirBaseIndexavel) -> bool {
    let array: u32 = semantic.tipo_de((c.e as ^BirEntrada).tipos as ^semantic.Tipos, v.tipo).a
    var ponteiro: BirOperando = BirOperando{}
    if (not bir_operando_de(c, i, v, &ponteiro)) or (not bir_operando_vreg(c, ponteiro, &ponteiro)) {
        return false
    }
    base.dados = ponteiro.id
    base.n = op_imed(semantic.tipo_de((c.e as ^BirEntrada).tipos as ^semantic.Tipos, array).b as i64, BC_I64 as u8)
    base.elemento = semantic.tipo_de((c.e as ^BirEntrada).tipos as ^semantic.Tipos, array).a
    return true
}

// C: nativo/bir/bir_construir_array.c:89
proc base_de_array(c: ^BirCtx, i: ^ir.IrInstr, v: ^ir.Valor, base: ^BirBaseIndexavel) -> bool {
    if not bir_endereco_de(c, i, v, &base.dados) {
        return false
    }
    base.n = op_imed(semantic.tipo_de((c.e as ^BirEntrada).tipos as ^semantic.Tipos, v.tipo).b as i64, BC_I64 as u8)
    base.elemento = semantic.tipo_de((c.e as ^BirEntrada).tipos as ^semantic.Tipos, v.tipo).a
    return true
}

// C: nativo/bir/bir_construir_array.c:100
proc bir_offset_da_lista(c: ^BirCtx, lista: ^BirListaRef, membro: u32) -> u32 {
    let arg_1: u32 = membro
    let arg_2: u32 = lista.tipo
    let arg_3: ^ir.Layouts = bir_layouts(c)
    return ir.layout_offset_campo(arg_3, arg_2, arg_1)
}

// C: nativo/bir/bir_construir_array.c:106
proc bir_lista_de(c: ^BirCtx, i: ^ir.IrInstr, v: ^ir.Valor, lista: ^BirListaRef) -> bool {
    let tipos: ?^semantic.Tipos = (c.e as ^BirEntrada).tipos
    var ponteiro: BirOperando = BirOperando{}
    if common.c2f_s2u_32(semantic.tipo_classe_de(tipos as ^semantic.Tipos, v.tipo)) == (semantic.TC_DINAMICO as u32) {
        lista.tipo = v.tipo
        return bir_endereco_de(c, i, v, &lista.endereco)
    }
    if (common.c2f_s2u_32(semantic.tipo_classe_de(tipos as ^semantic.Tipos, v.tipo)) != (semantic.TC_PONTEIRO as u32)) or (common.c2f_s2u_32(semantic.tipo_classe_de(tipos as ^semantic.Tipos, semantic.tipo_de(tipos as ^semantic.Tipos, v.tipo).a)) != (semantic.TC_DINAMICO as u32)) {
        return bir_falha_tipo(c, i, "-", v.tipo)
    }
    lista.tipo = semantic.tipo_de(tipos as ^semantic.Tipos, v.tipo).a
    if (not bir_operando_de(c, i, v, &ponteiro)) or (not bir_operando_vreg(c, ponteiro, &ponteiro)) {
        return false
    }
    lista.endereco = ponteiro.id
    return true
}

// C: nativo/bir/bir_construir_array.c:125
proc bir_chamar_lista_viva(c: ^BirCtx, i: ^ir.IrInstr, epoca: u32) {
    var args: []BirOperando = arena_fatia_bir_operando(&(c.p as ^BirPrograma).arena, 3)
    args[0] = op_vreg(epoca, BC_I32 as u8)
    arquivo_e_linha_2(c, i, args, 1)
    var chamada: BirChamadaRt = BirChamadaRt{funcao = "forja_lista_viva", retorno = BC_NADA as u8, nargs = 3}
    _ = bir_chamar_runtime(c, &chamada, args)
}

// C: nativo/bir/bir_construir_array.c:137
proc bir_tamanho_de_lista(c: ^BirCtx, i: ^ir.IrInstr) -> bool {
    var lista: BirListaRef = BirListaRef{}
    var dst: u32 = 0
    if (not bir_lista_de(c, i, &i.a, &lista)) or (not bir_definir_destino(c, BC_I64 as u8, &dst)) {
        return false
    }
    let arg_1: i32 = transmute(bir_offset_da_lista(c, &lista, LISTA_MEMBRO_LEN), to = i32)
    let arg_2: u32 = lista.endereco
    let arg_3: u32 = dst
    let arg_4: ^BirCtx = c
    bir_emitir_carrega(arg_4, arg_3, arg_2, arg_1)
    return true
}

// C: nativo/bir/bir_construir_array.c:149
proc base_de_lista(c: ^BirCtx, i: ^ir.IrInstr, v: ^ir.Valor, base: ^BirBaseIndexavel) -> bool {
    var lista: BirListaRef = BirListaRef{}
    var len_c: u32 = 0
    if not bir_lista_de(c, i, v, &lista) {
        return false
    }
    base.dados = bir_novo_vreg(c, BC_I64 as u8)
    len_c = bir_novo_vreg(c, BC_I64 as u8)
    let arg_1: i32 = transmute(bir_offset_da_lista(c, &lista, 0), to = i32)
    let arg_2: u32 = lista.endereco
    let arg_3: u32 = base.dados
    let arg_4: ^BirCtx = c
    bir_emitir_carrega(arg_4, arg_3, arg_2, arg_1)
    let arg_5: i32 = transmute(bir_offset_da_lista(c, &lista, LISTA_MEMBRO_LEN), to = i32)
    let arg_6: u32 = lista.endereco
    let arg_7: u32 = len_c
    let arg_8: ^BirCtx = c
    bir_emitir_carrega(arg_8, arg_7, arg_6, arg_5)
    base.n = op_vreg(len_c, BC_I64 as u8)
    base.elemento = semantic.tipo_de((c.e as ^BirEntrada).tipos as ^semantic.Tipos, lista.tipo).a
    base.lista = true
    if (c.p as ^BirPrograma).modo == (BM_DEV as u8) {
        base.epoca = bir_novo_vreg(c, BC_I32 as u8)
        let arg_9: i32 = transmute(bir_offset_da_lista(c, &lista, LISTA_MEMBRO_EPOCA), to = i32)
        let arg_10: u32 = lista.endereco
        let arg_11: u32 = base.epoca
        let arg_12: ^BirCtx = c
        bir_emitir_carrega(arg_12, arg_11, arg_10, arg_9)
    }
    return true
}

// C: nativo/bir/bir_construir_array.c:170
proc eh_base_de_lista(tipos: ^semantic.Tipos, tipo: u32) -> bool {
    let classe: i32 = semantic.tipo_classe_de(tipos, tipo)
    return (common.c2f_s2u_32(classe) == (semantic.TC_DINAMICO as u32)) or ((common.c2f_s2u_32(classe) == (semantic.TC_PONTEIRO as u32)) and (common.c2f_s2u_32(semantic.tipo_classe_de(tipos, semantic.tipo_de(tipos, tipo).a)) == (semantic.TC_DINAMICO as u32)))
}

// C: nativo/bir/bir_construir_array.c:177
proc base_indexavel_de(c: ^BirCtx, i: ^ir.IrInstr, v: ^ir.Valor, base: ^BirBaseIndexavel) -> bool {
    let tipos: ?^semantic.Tipos = (c.e as ^BirEntrada).tipos
    let classe: i32 = semantic.tipo_classe_de(tipos as ^semantic.Tipos, v.tipo)
    base^ = BirBaseIndexavel{}
    if common.c2f_s2u_32(classe) == (semantic.TC_ARRAY as u32) {
        return base_de_array(c, i, v, base)
    }
    if common.c2f_s2u_32(classe) == (semantic.TC_FATIA as u32) {
        return base_de_fatia(c, i, v, base)
    }
    if (common.c2f_s2u_32(classe) == (semantic.TC_PONTEIRO as u32)) and (common.c2f_s2u_32(semantic.tipo_classe_de(tipos as ^semantic.Tipos, semantic.tipo_de(tipos as ^semantic.Tipos, v.tipo).a)) == (semantic.TC_ARRAY as u32)) {
        return base_de_ponteiro_de_array(c, i, v, base)
    }
    if eh_base_de_lista(tipos as ^semantic.Tipos, v.tipo) {
        return base_de_lista(c, i, v, base)
    }
    return bir_falha_tipo(c, i, "-", v.tipo)
}

// C: nativo/bir/bir_construir_array.c:197
proc frio_indice(c: ^BirCtx, i: ^ir.IrInstr, frio: u32, ab: [2]BirOperando) {
    var args: []BirOperando = arena_fatia_bir_operando(&(c.p as ^BirPrograma).arena, 4)
    let salvo: u32 = c.cur
    c.cur = frio
    args[0] = ab[0]
    args[1] = ab[1]
    arquivo_e_linha_2(c, i, args, 2)
    bir_armadilha(c, bir_simbolo_runtime(c, "forja_falha_indice"), args)
    c.cur = salvo
}

// C: nativo/bir/bir_construir_array.c:212
proc bir_conferir_indice(c: ^BirCtx, i: ^ir.IrInstr, indice: BirOperando, n: BirOperando) {
    let fora: u32 = bir_comparar(c, BCOND_GE_U as u8, indice, n)
    let frio: u32 = bir_novo_bloco(c, true)
    let segue: u32 = bir_novo_bloco(c, false)
    bir_desvia(c, op_vreg(fora, BC_I8 as u8), frio, segue)
    let lit_1: [2]BirOperando = {indice, n}
    frio_indice(c, i, frio, lit_1)
    c.cur = segue
}

// C: nativo/bir/bir_construir_array.c:224
proc conferir_indice_lista(c: ^BirCtx, i: ^ir.IrInstr, base: ^BirBaseIndexavel, indice: BirOperando) -> BirOperando {
    var args: []BirOperando = arena_fatia_bir_operando(&(c.p as ^BirPrograma).arena, 5)
    args[0] = indice
    args[1] = base.n
    args[2] = op_vreg(base.epoca, BC_I32 as u8)
    arquivo_e_linha_2(c, i, args, 3)
    var chamada: BirChamadaRt = BirChamadaRt{funcao = "forja_indice_lista", retorno = BC_I64 as u8, nargs = 5}
    return op_vreg(bir_chamar_runtime(c, &chamada, args), BC_I64 as u8)
}

// C: nativo/bir/bir_construir_array.c:238
proc somar_deslocamento(c: ^BirCtx, base: ^BirBaseIndexavel, indice: BirOperando, tam: u32) -> u32 {
    var deslocamento: BirOperando = BirOperando{}
    if indice.tipo == (BO_IMED as u8) {
        deslocamento = op_imed(indice.imed * (tam as i64), BC_I64 as u8)
    } else if tam == 1 {
        deslocamento = indice
    } else {
        deslocamento = op_vreg(bir_conta_nova(c, BC_I64 as u8, BirPedido{op = BIR_MUL as u8, a = indice, b = op_imed(tam as i64, BC_I64 as u8)}), BC_I64 as u8)
    }
    if (deslocamento.tipo == (BO_IMED as u8)) and (deslocamento.imed == 0) {
        return base.dados
    }
    return bir_conta_nova(c, BC_I64 as u8, BirPedido{op = BIR_ADD as u8, a = op_vreg(base.dados, BC_I64 as u8), b = deslocamento})
}

// C: nativo/bir/bir_construir_array.c:254
proc indice_do_elemento(c: ^BirCtx, i: ^ir.IrInstr, base: ^BirBaseIndexavel, indice: ^BirOperando) -> bool {
    let prog: ^BirPrograma = c.p as ^BirPrograma
    let confere: bool = (prog.modo == (BM_DEV as u8)) or prog.checagem
    if (not confere) or (i.op_aux == 1) {
        return bir_inteiro64(c, i, &i.b, indice)
    }
    if not bir_inteiro64(c, i, &i.b, indice) {
        return false
    }
    if not bir_operando_vreg(c, indice^, indice) {
        return false
    }
    // a epoca (R0008) so existe em dev; o release confere so o limite (bir_conferir_indice)
    if base.lista and (prog.modo == (BM_DEV as u8)) {
        indice^ = conferir_indice_lista(c, i, base, indice^)
    } else {
        bir_conferir_indice(c, i, indice^, base.n)
    }
    return true
}

// C: nativo/bir/bir_construir_array.c:270
proc endereco_do_elemento(c: ^BirCtx, i: ^ir.IrInstr, endereco: ^u32) -> bool {
    var base: BirBaseIndexavel = BirBaseIndexavel{}
    var indice: BirOperando = BirOperando{}
    var forma: BirSlot = BirSlot{}
    if (not base_indexavel_de(c, i, &i.a, &base)) or (not bir_forma(c, base.elemento, &forma)) {
        return false
    }
    if not indice_do_elemento(c, i, &base, &indice) {
        return false
    }
    endereco^ = somar_deslocamento(c, &base, indice, forma.tam)
    return true
}

// C: nativo/bir/bir_construir_array.c:284
proc elemento_agregado(c: ^BirCtx, i: ^ir.IrInstr, endereco: u32) -> bool {
    var pedido: BirPedidoSlot = BirPedidoSlot{temporario = true, id = i.destino}
    var dst: u32 = 0
    if (not bir_forma(c, i.tipo, &pedido.forma)) or (not bir_definir_slot(c, &pedido, &dst)) {
        return false
    }
    bir_copia_bloco(c, dst, endereco, pedido.forma.tam)
    return true
}

// C: nativo/bir/bir_construir_array.c:296
proc bir_regra_elemento(c: ^BirCtx, i: ^ir.IrInstr) -> bool {
    var classe: u8 = BC_NADA as u8
    var endereco: u32 = 0
    var dst: u32 = 0
    if not endereco_do_elemento(c, i, &endereco) {
        return false
    }
    if bir_eh_agregado((c.e as ^BirEntrada).tipos as ^semantic.Tipos, i.tipo) {
        return elemento_agregado(c, i, endereco)
    }
    if not bir_classe_do_tipo((c.e as ^BirEntrada).tipos as ^semantic.Tipos, i.tipo, &classe) {
        return bir_falha_tipo(c, i, "-", i.tipo)
    }
    if not bir_definir_destino(c, classe, &dst) {
        return false
    }
    bir_emitir_carrega(c, dst, endereco, 0)
    return true
}

// C: nativo/bir/bir_construir_array.c:313
proc bir_regra_endereco_elemento(c: ^BirCtx, i: ^ir.IrInstr) -> bool {
    var endereco: u32 = 0
    var dst: u32 = 0
    if (not endereco_do_elemento(c, i, &endereco)) or (not bir_definir_destino(c, BC_I64 as u8, &dst)) {
        return false
    }
    _ = bir_emitir_pedido(c, BirPedido{op = BIR_COPIA as u8, dst = dst, a = op_vreg(endereco, BC_I64 as u8)})
    return true
}

// C: nativo/bir/bir_construir_array.c:326
proc chamar_confere_fatia(c: ^BirCtx, i: ^ir.IrInstr, base: ^BirBaseIndexavel, limites: [2]BirOperando) {
    var args: []BirOperando = arena_fatia_bir_operando(&(c.p as ^BirPrograma).arena, 6)
    var excl: i64 = 0
    if i.faixa_excl {
        excl = 1
    }
    args[0] = limites[0]
    args[1] = limites[1]
    args[2] = op_imed(excl, BC_I8 as u8)
    args[3] = base.n
    arquivo_e_linha_2(c, i, args, 4)
    let chama: ^BirInstr = bir_emitir(c, BIR_CHAMA, BC_NADA as u8)
    chama.simbolo = bir_simbolo_runtime(c, "forja_fatia_confere")
    chama.args = args
    chama.nargs = 6
}

// C: nativo/bir/bir_construir_array.c:345
proc tamanho_da_fatia(c: ^BirCtx, i: ^ir.IrInstr, limites: [2]BirOperando) -> BirOperando {
    let len_c: u32 = bir_conta_nova(c, BC_I64 as u8, BirPedido{op = BIR_SUB as u8, a = limites[1], b = limites[0]})
    if i.faixa_excl {
        return op_vreg(len_c, BC_I64 as u8)
    }
    return op_vreg(bir_conta_nova(c, BC_I64 as u8, BirPedido{op = BIR_ADD as u8, a = op_vreg(len_c, BC_I64 as u8), b = op_imed(1, BC_I64 as u8)}), BC_I64 as u8)
}

// C: nativo/bir/bir_construir_array.c:355
proc gravar_fatia(c: ^BirCtx, i: ^ir.IrInstr, ptr: BirOperando, len_c: BirOperando) -> bool {
    var pedido: BirPedidoSlot = BirPedidoSlot{temporario = true, id = i.destino}
    var dst: u32 = 0
    if (not bir_forma(c, i.tipo, &pedido.forma)) or (not bir_definir_slot(c, &pedido, &dst)) {
        return false
    }
    bir_emitir_grava(c, dst, transmute(offset_da_fatia(c, i.tipo, FATIA_CAMPO_PTR), to = i32), ptr)
    bir_emitir_grava(c, dst, transmute(offset_da_fatia(c, i.tipo, FATIA_CAMPO_LEN), to = i32), len_c)
    return true
}

// C: nativo/bir/bir_construir_array.c:368
proc conferir_fatia_dev(c: ^BirCtx, i: ^ir.IrInstr, base: ^BirBaseIndexavel, limites: [2]BirOperando) {
    let prog: ^BirPrograma = c.p as ^BirPrograma
    if not ((prog.modo == (BM_DEV as u8)) or prog.checagem) {
        return
    }
    if base.lista and (prog.modo == (BM_DEV as u8)) {
        bir_chamar_lista_viva(c, i, base.epoca)
    }
    if i.op_aux != 1 {
        chamar_confere_fatia(c, i, base, limites)
    }
}

// C: nativo/bir/bir_construir_array.c:379
proc bir_regra_fatia(c: ^BirCtx, i: ^ir.IrInstr) -> bool {
    if i.nargs != 1 {
        return bir_falha_inconsistente(c, "IR_FATIA sem o limite final")
    }
    var base: BirBaseIndexavel = BirBaseIndexavel{}
    var forma: BirSlot = BirSlot{}
    var limites: [2]BirOperando = {BirOperando{}, BirOperando{}}
    var argumentos: []ir.Valor = i.args or_else {}
    if (not base_indexavel_de(c, i, &i.a, &base)) or (not bir_forma(c, base.elemento, &forma)) {
        return false
    }
    if (not inteiro64_em_vreg(c, i, &i.b, &limites[0])) or (not inteiro64_em_vreg(c, i, &argumentos[0], &limites[1])) {
        return false
    }
    conferir_fatia_dev(c, i, &base, limites)
    // C: GravarFatia(ptr, TamanhoDaFatia): o tamanho sai antes do ponteiro (ordem N5, direita antes da esquerda)
    let tamanho: BirOperando = tamanho_da_fatia(c, i, limites)
    let ponteiro: BirOperando = op_vreg(somar_deslocamento(c, &base, limites[0], forma.tam), BC_I64 as u8)
    return gravar_fatia(c, i, ponteiro, tamanho)
}

// C: nativo/bir/bir_construir_array.c:398
proc chamar_confere_vetor_c(c: ^BirCtx, i: ^ir.IrInstr, ponteiro: BirOperando, len_c: BirOperando) {
    var args: []BirOperando = arena_fatia_bir_operando(&(c.p as ^BirPrograma).arena, 4)
    args[0] = ponteiro
    args[1] = len_c
    arquivo_e_linha_2(c, i, args, 2)
    let chama: ^BirInstr = bir_emitir(c, BIR_CHAMA, BC_NADA as u8)
    chama.simbolo = bir_simbolo_runtime(c, "forja_vetor_c_confere")
    chama.args = args
    chama.nargs = 4
}

// C: nativo/bir/bir_construir_array.c:415
proc bir_regra_fatia_de_ponteiro(c: ^BirCtx, i: ^ir.IrInstr) -> bool {
    var ponteiro: BirOperando = BirOperando{}
    var len_c: BirOperando = BirOperando{}
    if (not bir_operando_de(c, i, &i.a, &ponteiro)) or (not bir_operando_vreg(c, ponteiro, &ponteiro)) or (not bir_inteiro64(c, i, &i.b, &len_c)) {
        return false
    }
    let prog: ^BirPrograma = c.p as ^BirPrograma
    if (prog.modo == (BM_DEV as u8)) or prog.checagem {
        chamar_confere_vetor_c(c, i, ponteiro, len_c)
    }
    return gravar_fatia(c, i, ponteiro, len_c)
}

// C: nativo/bir/bir_construir_array.c:429
proc gravar_elementos(c: ^BirCtx, i: ^ir.IrInstr, molde: BirAlvoMem, tam_elemento: u32) -> bool {
    var k: u32 = 0
    while k < i.nargs {
        var alvo: BirAlvoMem = BirAlvoMem{base = molde.base, offset = k * tam_elemento, tipo = molde.tipo}
        if not bir_gravar_em(c, i, &alvo, &(i.args or_else {})[k]) {
            return false
        }
        k += 1
    }
    return true
}

// C: nativo/bir/bir_construir_array.c:441
proc literal_de_array(c: ^BirCtx, i: ^ir.IrInstr) -> bool {
    var pedido: BirPedidoSlot = BirPedidoSlot{temporario = true, id = i.destino}
    let elemento: u32 = semantic.tipo_de((c.e as ^BirEntrada).tipos as ^semantic.Tipos, i.tipo).a
    var forma_elemento: BirSlot = BirSlot{}
    var dst: u32 = 0
    if ((not bir_forma(c, i.tipo, &pedido.forma)) or (not bir_forma(c, elemento, &forma_elemento))) or (not bir_definir_slot(c, &pedido, &dst)) {
        return false
    }
    if i.nargs < semantic.tipo_de((c.e as ^BirEntrada).tipos as ^semantic.Tipos, i.tipo).b {
        bir_zera_bloco(c, dst, pedido.forma.tam)
    }
    return gravar_elementos(c, i, BirAlvoMem{base = dst, tipo = elemento}, forma_elemento.tam)
}

// C: nativo/bir/bir_construir_array.c:456
proc fatia_vazia(c: ^BirCtx, i: ^ir.IrInstr) -> bool {
    let arg_1: BirOperando = op_imed(0, BC_I64 as u8)
    let arg_2: BirOperando = op_imed(0, BC_I64 as u8)
    let arg_3: ^ir.IrInstr = i
    let arg_4: ^BirCtx = c
    return gravar_fatia(arg_4, arg_3, arg_2, arg_1)
}

// C: nativo/bir/bir_construir_array.c:462
proc lista_zerada(c: ^BirCtx, i: ^ir.IrInstr) -> bool {
    var pedido: BirPedidoSlot = BirPedidoSlot{temporario = true, id = i.destino}
    var dst: u32 = 0
    if (not bir_forma(c, i.tipo, &pedido.forma)) or (not bir_definir_slot(c, &pedido, &dst)) {
        return false
    }
    bir_zera_bloco(c, dst, pedido.forma.tam)
    return true
}

// C: nativo/bir/bir_construir_array.c:473
proc bir_regra_array(c: ^BirCtx, i: ^ir.IrInstr) -> bool {
    let sw_1 = common.c2f_s2u_32(semantic.tipo_classe_de((c.e as ^BirEntrada).tipos as ^semantic.Tipos, i.tipo))
    if sw_1 == (semantic.TC_ARRAY as u32) {
        return literal_de_array(c, i)
    } else if sw_1 == (semantic.TC_FATIA as u32) {
        if i.nargs == 0 {
            return fatia_vazia(c, i)
        }
    } else if sw_1 == (semantic.TC_DINAMICO as u32) or sw_1 == (semantic.TC_MATRIZ as u32) or sw_1 == (semantic.TC_SOA as u32) or sw_1 == (semantic.TC_MAPA as u32) {
        if i.nargs == 0 {
            return lista_zerada(c, i)
        }
    } else {
    }
    return bir_falha_tipo(c, i, "-", i.tipo)
}
