import "common"
import "ir"
import "semantic"

struct BirChaveia {
    disc: BirOperando
    fim: BirRotulo
    endereco: u32
    ponteiro: BirOperando
}

// C: nativo/bir/bir_construir_chaveia.c:19
proc valor_do_membro(c: ^BirCtx, tipo: u32, indice: i64) -> i64 {
    let ir_c: ?^ir.IrPrograma = (c.e as ^BirEntrada).ir
    let nome: i32 = transmute(semantic.tipo_de((c.e as ^BirEntrada).tipos as ^semantic.Tipos, tipo).a, to = i32)
    for k in (0 as u32)..<(ir_c as ^ir.IrPrograma).nenums {
        let en: ^ir.IrEnum = &((ir_c as ^ir.IrPrograma).enums or_else {})[k]
        if en.nome != nome {
            continue
        }
        var tern_1: i64 = indice
        if ((en.valores != none) and (indice >= 0)) and (common.c2f_s2u_64(indice) < (en.nmembros as u64)) {
            tern_1 = (en.valores or_else {})[indice]
        }
        return tern_1
    }
    return indice
}

// C: nativo/bir/bir_construir_chaveia.c:34
proc bir_inteiro_do_valor(c: ^BirCtx, v: ^ir.Valor) -> i64 {
    if common.c2f_s2u_32(semantic.tipo_classe_de((c.e as ^BirEntrada).tipos as ^semantic.Tipos, v.tipo)) != (semantic.TC_ENUM as u32) {
        return v.inteiro
    }
    return (valor_do_membro(c, v.tipo, v.inteiro) as i32) as i64
}

// C: nativo/bir/bir_construir_chaveia.c:44
proc preparar_ponteiro(c: ^BirCtx, i: ^ir.IrInstr, s: ^BirChaveia) -> bool {
    var tem: u32 = 0
    if (not bir_operando_de(c, i, &i.a, &s.ponteiro)) or (not bir_operando_vreg(c, s.ponteiro, &s.ponteiro)) {
        return false
    }
    let arg_1: BirOperando = op_imed(0, BC_I64 as u8)
    let arg_2: BirOperando = s.ponteiro
    let arg_3: ^BirCtx = c
    tem = bir_comparar(arg_3, BCOND_NE as u8, arg_2, arg_1)
    s.disc = op_vreg(tem, BC_I8 as u8)
    return true
}

// C: nativo/bir/bir_construir_chaveia.c:56
proc preparar_agregado(c: ^BirCtx, i: ^ir.IrInstr, s: ^BirChaveia) -> bool {
    var tern_1: i32 = BC_I8
    if common.c2f_s2u_32(semantic.tipo_classe_de((c.e as ^BirEntrada).tipos as ^semantic.Tipos, i.a.tipo)) == (semantic.TC_UNIAO as u32) {
        tern_1 = BC_I32
    }
    let classe: u8 = tern_1 as u8
    var membro: u32 = 0
    if not bir_endereco_de(c, i, &i.a, &s.endereco) {
        return false
    }
    membro = bir_novo_vreg(c, classe)
    bir_emitir_carrega(c, membro, s.endereco, 0)
    s.disc = op_vreg(membro, classe)
    return true
}

// C: nativo/bir/bir_construir_chaveia.c:70
proc preparar_agregado_ou_falha(c: ^BirCtx, i: ^ir.IrInstr, s: ^BirChaveia) -> bool {
    let sw_1 = common.c2f_s2u_32(semantic.tipo_classe_de((c.e as ^BirEntrada).tipos as ^semantic.Tipos, i.a.tipo))
    if sw_1 == (semantic.TC_RESULTADO as u32) or sw_1 == (semantic.TC_OPCIONAL as u32) or sw_1 == (semantic.TC_UNIAO as u32) {
        return preparar_agregado(c, i, s)
    } else {
        return bir_falha_tipo(c, i, "-", i.a.tipo)
    }
    return false
}

// C: nativo/bir/bir_construir_chaveia.c:80
proc preparar_discriminante(c: ^BirCtx, i: ^ir.IrInstr, s: ^BirChaveia) -> bool {
    var valor: BirOperando = BirOperando{}
    if common.c2f_s2u_32(semantic.tipo_classe_de((c.e as ^BirEntrada).tipos as ^semantic.Tipos, i.a.tipo)) == (semantic.TC_ENUM as u32) {
        return (common.c2f_b2i32(bir_operando_de(c, i, &i.a, &valor)) != 0) and (common.c2f_b2i32(bir_operando_vreg(c, valor, &s.disc)) != 0)
    }
    if bir_eh_ponteiro_opcional((c.e as ^BirEntrada).tipos as ^semantic.Tipos, i.a.tipo) {
        return preparar_ponteiro(c, i, s)
    }
    return preparar_agregado_ou_falha(c, i, s)
}

// C: nativo/bir/bir_construir_chaveia.c:92
proc rotulo_do_caso(c: ^BirCtx, i: ^ir.IrInstr, k: ^ir.IrCaso, rotulo: ^i64) -> bool {
    let info: ^semantic.TipoInfo = semantic.tipo_de((c.e as ^BirEntrada).tipos as ^semantic.Tipos, i.a.tipo)
    if info.classe == (semantic.TC_ENUM as u8) {
        rotulo^ = (valor_do_membro(c, i.a.tipo, k.membro as i64) as i32) as i64
        return true
    }
    if info.classe != (semantic.TC_RESULTADO as u8) {
        rotulo^ = k.membro as i64
        return true
    }
    if k.membro == transmute(info.b, to = i32) {
        rotulo^ = 1
    } else if k.membro == transmute(info.a, to = i32) {
        rotulo^ = 0
    } else {
        return bir_falha_inconsistente(c, "caso de chaveia que nao e o valor nem o erro do resultado")
    }
    return true
}

// C: nativo/bir/bir_construir_chaveia.c:115
proc ligar_agregado(c: ^BirCtx, local: i32, endereco: u32, parte: ^BirCampoInfo) -> bool {
    var pedido: BirPedidoSlot = BirPedidoSlot{id = local}
    var dst: u32 = 0
    if (not bir_forma(c, parte.tipo, &pedido.forma)) or (not bir_definir_slot(c, &pedido, &dst)) {
        return false
    }
    let arg_1: u32 = pedido.forma.tam
    let arg_2: u32 = bir_endereco_mais(c, endereco, parte.offset)
    let arg_3: u32 = dst
    let arg_4: ^BirCtx = c
    bir_copia_bloco(arg_4, arg_3, arg_2, arg_1)
    return true
}

// C: nativo/bir/bir_construir_chaveia.c:127
proc ligar_escalar_em_memoria(c: ^BirCtx, local: i32, valor: u32, classe: u8) -> bool {
    var pedido: BirPedidoSlot = BirPedidoSlot{id = local}
    var endereco: u32 = 0
    if (not bir_forma(c, (c.tipo_local or_else {})[local], &pedido.forma)) or (not bir_definir_slot(c, &pedido, &endereco)) {
        return false
    }
    bir_emitir_grava(c, endereco, 0, op_vreg(valor, classe))
    return true
}

// C: nativo/bir/bir_construir_chaveia.c:138
proc ligar_escalar(c: ^BirCtx, local: i32, endereco: u32, parte: ^BirCampoInfo) -> bool {
    var classe: u8 = BC_NADA as u8
    var vreg: u32 = 0
    if not bir_classe_do_tipo((c.e as ^BirEntrada).tipos as ^semantic.Tipos, parte.tipo, &classe) {
        return bir_falha_inconsistente(c, "ligacao de chaveia com tipo sem classe na BIR")
    }
    if ((local >= 0) and (common.c2f_s2u_32(local) < c.n_local)) and (((c.em_memoria or_else {})[local] as i32) != 0) {
        vreg = bir_novo_vreg(c, classe)
        bir_emitir_carrega(c, vreg, endereco, transmute(parte.offset, to = i32))
        return ligar_escalar_em_memoria(c, local, vreg, classe)
    }
    if not bir_vreg_declarar(c, local, classe, &vreg) {
        return false
    }
    bir_emitir_carrega(c, vreg, endereco, transmute(parte.offset, to = i32))
    return true
}

// C: nativo/bir/bir_construir_chaveia.c:157
proc ligar_parte(c: ^BirCtx, local: i32, endereco: u32, parte: ^BirCampoInfo) -> bool {
    bir_registrar_tipo_local(c, local, parte.tipo)
    if bir_eh_agregado((c.e as ^BirEntrada).tipos as ^semantic.Tipos, parte.tipo) {
        return ligar_agregado(c, local, endereco, parte)
    }
    return ligar_escalar(c, local, endereco, parte)
}

// C: nativo/bir/bir_construir_chaveia.c:166
proc ligar_resultado(c: ^BirCtx, i: ^ir.IrInstr, k: ?^ir.IrCaso, s: ^BirChaveia) -> bool {
    let info: ^semantic.TipoInfo = semantic.tipo_de((c.e as ^BirEntrada).tipos as ^semantic.Tipos, i.a.tipo)
    var parte: BirCampoInfo = BirCampoInfo{}
    let erro: bool = (k as ^ir.IrCaso).membro == transmute(info.b, to = i32)
    var tern_1: i32 = RES_PARTE_VALOR
    if common.c2f_b2i32(erro) != 0 {
        tern_1 = RES_PARTE_ERRO
    }
    if not bir_parte_do_resultado(c, i.a.tipo, tern_1, &parte) {
        return false
    }
    return ligar_parte(c, (k as ^ir.IrCaso).ligacao, s.endereco, &parte)
}

// C: nativo/bir/bir_construir_chaveia.c:178
proc ligar_opcional(c: ^BirCtx, i: ^ir.IrInstr, k: ?^ir.IrCaso, s: ^BirChaveia) -> bool {
    let arg_1: u32 = i.a.tipo
    let arg_2: ^ir.Layouts = bir_layouts(c)
    var parte: BirCampoInfo = BirCampoInfo{offset = ir.layout_offset_campo(arg_2, arg_1, OPC_MEMBRO_VALOR), tipo = semantic.tipo_de((c.e as ^BirEntrada).tipos as ^semantic.Tipos, i.a.tipo).a}
    return ligar_parte(c, (k as ^ir.IrCaso).ligacao, s.endereco, &parte)
}

// C: nativo/bir/bir_construir_chaveia.c:186
proc ligar_uniao(c: ^BirCtx, i: ^ir.IrInstr, k: ?^ir.IrCaso, s: ^BirChaveia) -> bool {
    let u: ?^ir.IrUniao = ir.layout_uniao((c.e as ^BirEntrada).tipos as ^semantic.Tipos, (c.e as ^BirEntrada).ir as ^ir.IrPrograma, i.a.tipo)
    var parte: BirCampoInfo = BirCampoInfo{}
    if ((u == none) or ((k as ^ir.IrCaso).membro < 0)) or (common.c2f_s2u_32((k as ^ir.IrCaso).membro) >= (u as ^ir.IrUniao).nvariantes) {
        return bir_falha_inconsistente(c, "caso de union com tag fora das variantes")
    }
    let arg_1: u32 = i.a.tipo
    let arg_2: ^ir.Layouts = bir_layouts(c)
    parte = BirCampoInfo{offset = ir.layout_offset_campo(arg_2, arg_1, UNIAO_MEMBRO_VARIANTE), tipo = ((u as ^ir.IrUniao).variantes or_else {})[(k as ^ir.IrCaso).membro]}
    return ligar_parte(c, (k as ^ir.IrCaso).ligacao, s.endereco, &parte)
}

// C: nativo/bir/bir_construir_chaveia.c:198
proc ligar_ponteiro(c: ^BirCtx, k: ?^ir.IrCaso, s: ^BirChaveia) -> bool {
    var vreg: u32 = 0
    bir_registrar_tipo_local(c, (k as ^ir.IrCaso).ligacao, (k as ^ir.IrCaso).tipo)
    if (common.c2f_s2u_32((k as ^ir.IrCaso).ligacao) < c.n_local) and (((c.em_memoria or_else {})[(k as ^ir.IrCaso).ligacao] as i32) != 0) {
        return ligar_escalar_em_memoria(c, (k as ^ir.IrCaso).ligacao, s.ponteiro.id, BC_I64 as u8)
    }
    if not bir_vreg_declarar(c, (k as ^ir.IrCaso).ligacao, BC_I64 as u8, &vreg) {
        return false
    }
    bir_mover(c, vreg, s.ponteiro)
    return true
}

// C: nativo/bir/bir_construir_chaveia.c:212
proc ligar_de_opcional(c: ^BirCtx, i: ^ir.IrInstr, k: ?^ir.IrCaso, s: ^BirChaveia) -> bool {
    if ((k as ^ir.IrCaso).membro == 0) or (common.c2f_s2u_32(semantic.tipo_classe_de((c.e as ^BirEntrada).tipos as ^semantic.Tipos, i.a.tipo)) == (semantic.TC_ENUM as u32)) {
        return true
    }
    var tern_1: i32 = 0
    if common.c2f_b2i32(bir_eh_ponteiro_opcional((c.e as ^BirEntrada).tipos as ^semantic.Tipos, i.a.tipo)) != 0 {
        tern_1 = common.c2f_b2i32(ligar_ponteiro(c, k, s))
    } else {
        tern_1 = common.c2f_b2i32(ligar_opcional(c, i, k, s))
    }
    return tern_1 != 0
}

// C: nativo/bir/bir_construir_chaveia.c:220
proc ligar_caso(c: ^BirCtx, i: ^ir.IrInstr, k: ?^ir.IrCaso, s: ^BirChaveia) -> bool {
    let classe: i32 = semantic.tipo_classe_de((c.e as ^BirEntrada).tipos as ^semantic.Tipos, i.a.tipo)
    if (common.c2f_b2i32((k as ^ir.IrCaso).padrao) != 0) or ((k as ^ir.IrCaso).ligacao < 0) {
        return true
    }
    if common.c2f_s2u_32(classe) == (semantic.TC_RESULTADO as u32) {
        return ligar_resultado(c, i, k, s)
    }
    if common.c2f_s2u_32(classe) == (semantic.TC_UNIAO as u32) {
        return ligar_uniao(c, i, k, s)
    }
    return ligar_de_opcional(c, i, k, s)
}

// C: nativo/bir/bir_construir_chaveia.c:235
proc corpo_do_caso(c: ^BirCtx, i: ^ir.IrInstr, k: ?^ir.IrCaso, s: ^BirChaveia) -> bool {
    if (not ligar_caso(c, i, k, s)) or (not bir_construir_bloco(c, &(k as ^ir.IrCaso).corpo)) {
        return false
    }
    bir_rotulo_salta(c, &s.fim)
    return true
}

// C: nativo/bir/bir_construir_chaveia.c:244
proc testar_caso(c: ^BirCtx, i: ^ir.IrInstr, k: ^ir.IrCaso, s: ^BirChaveia) -> bool {
    var rotulo: i64 = 0
    var igual: u32 = 0
    var corpo: u32 = 0
    var proximo: u32 = 0
    if not rotulo_do_caso(c, i, k, &rotulo) {
        return false
    }
    let arg_1: BirOperando = op_imed(rotulo, s.disc.classe)
    let arg_2: BirOperando = s.disc
    let arg_3: ^BirCtx = c
    igual = bir_comparar(arg_3, BCOND_EQ as u8, arg_2, arg_1)
    corpo = bir_novo_bloco(c, false)
    proximo = bir_novo_bloco(c, false)
    bir_desvia(c, op_vreg(igual, BC_I8 as u8), corpo, proximo)
    c.cur = corpo
    if not corpo_do_caso(c, i, k, s) {
        return false
    }
    c.cur = proximo
    return true
}

// C: nativo/bir/bir_construir_chaveia.c:263
proc testar_casos(c: ^BirCtx, i: ^ir.IrInstr, s: ^BirChaveia, padrao: ^?^ir.IrCaso) -> bool {
    var k: u32 = 0
    while k < i.ncasos {
        if (i.casos or_else {})[k].padrao {
            padrao^ = &(i.casos or_else {})[k]
        } else if not testar_caso(c, i, &(i.casos or_else {})[k], s) {
            return false
        }
        k += 1
    }
    return true
}

// C: nativo/bir/bir_construir_chaveia.c:274
proc bir_regra_chaveia(c: ^BirCtx, i: ^ir.IrInstr) -> bool {
    var s: BirChaveia = BirChaveia{fim = BirRotulo{bloco = BIR_SEM_BLOCO}}
    var padrao: ?^ir.IrCaso = none
    if (not preparar_discriminante(c, i, &s)) or (not testar_casos(c, i, &s, &padrao)) {
        return false
    }
    if (padrao != none) and (not corpo_do_caso(c, i, padrao, &s)) {
        return false
    }
    bir_rotulo_salta(c, &s.fim)
    bir_rotulo_coloca(c, &s.fim)
    return true
}
