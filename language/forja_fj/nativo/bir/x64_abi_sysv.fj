import "common"

pub struct AbiSysvCampo {
    classe: i32
    deslocamento: u32
    alinhamento: u32
}

pub struct AbiSysvArg {
    tam: u32
    campos: ?[]AbiSysvCampo
    n_campos: u32
}

pub struct AbiSysvLocal {
    na_memoria: bool
    n_eightbytes: u32
    classe: [2]i32
    reg: [2]i32
}

pub struct AbiSysvPlano {
    arg: [16]AbiSysvLocal
    off: [16]u32
    ret: AbiSysvLocal
    oculto: bool
    bytes_pilha: u32
    al: u32
}

struct AbiSysvUso {
    ints: u32
    sses: u32
}

pub const ABI_SYSV_INTEIRO: i32 = 0
pub const ABI_SYSV_SSE: i32 = 1
const ABI_SYSV_MEMORIA: i32 = 2
pub const ABI_SYSV_RAX: i32 = 0
pub const ABI_SYSV_RDX: i32 = 1
pub const ABI_SYSV_RDI: i32 = 2
pub const ABI_SYSV_RSI: i32 = 3
pub const ABI_SYSV_RCX: i32 = 4
pub const ABI_SYSV_R8: i32 = 5
pub const ABI_SYSV_R9: i32 = 6
pub const ABI_SYSV_XMM0: i32 = 7
pub const ABI_SYSV_XMM1: i32 = 8
const ABI_SYSV_XMM2: i32 = 9
const ABI_SYSV_XMM3: i32 = 10
const ABI_SYSV_XMM4: i32 = 11
const ABI_SYSV_XMM5: i32 = 12
const ABI_SYSV_XMM6: i32 = 13
const ABI_SYSV_XMM7: i32 = 14
const ABI_SYSV_NENHUM: i32 = 15
pub const ABI_SYSV_REGS_INT: u32 = 6
const ABI_SYSV_REGS_SSE: u32 = 8
const ABI_SYSV_TAM_REG: u32 = 16
const ABI_SYSV_BYTES_EIGHTBYTE: u32 = 8
pub const ABI_SYSV_MAX_ARGS: u32 = 16
const ABI_SYSV_BLOCO_XMM: u32 = 48
const ABI_SYSV_BLOCO_RET_INT: u32 = 112
const ABI_SYSV_BLOCO_RET_SSE: u32 = 128
const ABI_SYSV_BLOCO_BYTES: u32 = 144
const ABI_SYSV_ENTRADA_WIN64_ANTES: u32 = 16
const REGS_INT_ARG: [6]i32 = {2, 3, 1, 4, 5, 6}
const REGS_SSE_ARG: [8]i32 = {7, 8, 9, 10, 11, 12, 13, 14}
const REGS_INT_RET: [2]i32 = {0, 1}
const REGS_SSE_RET: [2]i32 = {7, 8}
const NOMES_REG: [16]str = {"rax", "rdx", "rdi", "rsi", "rcx", "r8", "r9", "xmm0", "xmm1", "xmm2", "xmm3", "xmm4", "xmm5", "xmm6", "xmm7", "-"}

// C: nativo/bir/x64_abi_sysv.c:26
proc local_vazio() -> AbiSysvLocal {
    return AbiSysvLocal{na_memoria = false, n_eightbytes = 0, classe = {ABI_SYSV_MEMORIA, ABI_SYSV_MEMORIA}, reg = {ABI_SYSV_NENHUM, ABI_SYSV_NENHUM}}
}

// C: nativo/bir/x64_abi_sysv.c:33
proc campo_alinhado(campo: ^AbiSysvCampo) -> bool {
    return (campo.alinhamento != 0) and ((campo.deslocamento % campo.alinhamento) == 0)
}

// C: nativo/bir/x64_abi_sysv.c:39
proc eh_memoria(arg: ^AbiSysvArg) -> bool {
    var i: u32 = 0
    while i < arg.n_campos {
        if not campo_alinhado(&(arg.campos or_else {})[i]) {
            return true
        }
        i += 1
    }
    return arg.tam > ABI_SYSV_TAM_REG
}

// C: nativo/bir/x64_abi_sysv.c:48
proc arg_valido(arg: ^AbiSysvArg) -> bool {
    return (arg.tam > 0) and (arg.n_campos > 0)
}

// C: nativo/bir/x64_abi_sysv.c:53
proc numero_de_eightbytes(tam: u32) -> u32 {
    return ((tam + ABI_SYSV_BYTES_EIGHTBYTE) - 1) / ABI_SYSV_BYTES_EIGHTBYTE
}

// C: nativo/bir/x64_abi_sysv.c:59
proc classe_do_eightbyte(arg: ^AbiSysvArg, eightbyte: u32) -> i32 {
    for i in (0 as u32)..<arg.n_campos {
        let campo: ^AbiSysvCampo = &(arg.campos or_else {})[i]
        if ((campo.deslocamento / ABI_SYSV_BYTES_EIGHTBYTE) == eightbyte) and (common.c2f_s2u_32(campo.classe) == (ABI_SYSV_INTEIRO as u32)) {
            return ABI_SYSV_INTEIRO
        }
    }
    return ABI_SYSV_SSE
}

// C: nativo/bir/x64_abi_sysv.c:70
proc classificar_eightbytes(arg: ^AbiSysvArg, saida: ^AbiSysvLocal) {
    saida.n_eightbytes = numero_de_eightbytes(arg.tam)
    var e: u32 = 0
    while e < saida.n_eightbytes {
        saida.classe[e] = classe_do_eightbyte(arg, e)
        e += 1
    }
}

// C: nativo/bir/x64_abi_sysv.c:78
proc contar_pedidos(saida: ^AbiSysvLocal, pedido_int: ^u32, pedido_sse: ^u32) {
    pedido_int^ = 0
    pedido_sse^ = 0
    var e: u32 = 0
    while e < saida.n_eightbytes {
        if common.c2f_s2u_32(saida.classe[e]) == (ABI_SYSV_INTEIRO as u32) {
            pedido_int^ += 1
        } else {
            pedido_sse^ += 1
        }
        e += 1
    }
}

// C: nativo/bir/x64_abi_sysv.c:91
proc atribuir_argumento(arg: ^AbiSysvArg, uso: ^AbiSysvUso, saida: ^AbiSysvLocal) {
    var pedido_int: u32 = 0
    var pedido_sse: u32 = 0
    if eh_memoria(arg) {
        saida.na_memoria = true
        return
    }
    classificar_eightbytes(arg, saida)
    contar_pedidos(saida, &pedido_int, &pedido_sse)
    if ((uso.ints + pedido_int) > ABI_SYSV_REGS_INT) or ((uso.sses + pedido_sse) > ABI_SYSV_REGS_SSE) {
        saida.na_memoria = true
        saida.n_eightbytes = 0
        return
    }
    var e: u32 = 0
    while e < saida.n_eightbytes {
        if common.c2f_s2u_32(saida.classe[e]) == (ABI_SYSV_INTEIRO as u32) {
            let antes_1: u32 = uso.ints
            uso.ints += 1
            saida.reg[e] = REGS_INT_ARG[antes_1]
        } else {
            let antes_2: u32 = uso.sses
            uso.sses += 1
            saida.reg[e] = REGS_SSE_ARG[antes_2]
        }
        e += 1
    }
}

// C: nativo/bir/x64_abi_sysv.c:114
// C2F-INDECIDIVEL: saida
// C2F-13: args fundido em n (len)
proc abi_sysv_classificar(args: []AbiSysvArg, oculto: u32, saida: []AbiSysvLocal) -> bool {
    var tern_1: u32 = 0
    if oculto != 0 {
        tern_1 = 1
    }
    var uso: AbiSysvUso = AbiSysvUso{ints = tern_1, sses = 0}
    for k in (0 as u32)..<(len(args) as u32) {
        if not arg_valido(&args[k]) {
            return false
        }
        saida[k] = local_vazio()
        atribuir_argumento(&args[k], &uso, &saida[k])
    }
    return true
}

// C: nativo/bir/x64_abi_sysv.c:128
proc atribuir_retorno_registrado(ret: ^AbiSysvArg, saida: ^AbiSysvLocal) {
    var uso: AbiSysvUso = AbiSysvUso{ints = 0, sses = 0}
    classificar_eightbytes(ret, saida)
    var e: u32 = 0
    while e < saida.n_eightbytes {
        if common.c2f_s2u_32(saida.classe[e]) == (ABI_SYSV_INTEIRO as u32) {
            let antes_1: u32 = uso.ints
            uso.ints += 1
            saida.reg[e] = REGS_INT_RET[antes_1]
        } else {
            let antes_2: u32 = uso.sses
            uso.sses += 1
            saida.reg[e] = REGS_SSE_RET[antes_2]
        }
        e += 1
    }
}

// C: nativo/bir/x64_abi_sysv.c:141
proc abi_sysv_retorno(ret: ^AbiSysvArg, saida: ^AbiSysvLocal) -> bool {
    saida^ = local_vazio()
    if (ret.tam == 0) and (ret.n_campos == 0) {
        return true
    }
    if not arg_valido(ret) {
        return false
    }
    if eh_memoria(ret) {
        saida.na_memoria = true
        saida.reg[0] = ABI_SYSV_RAX
        return true
    }
    atribuir_retorno_registrado(ret, saida)
    return true
}

// C: nativo/bir/x64_abi_sysv.c:157
// C2F-13: saida fundido em n (len)
proc abi_sysv_al_variadica(saida: []AbiSysvLocal) -> u32 {
    var al: u32 = 0
    for k in (0 as u32)..<(len(saida) as u32) {
        for e in (0 as u32)..<saida[k].n_eightbytes {
            if (common.c2f_s2u_32(saida[k].reg[e]) >= (ABI_SYSV_XMM0 as u32)) and (common.c2f_s2u_32(saida[k].reg[e]) <= (ABI_SYSV_XMM7 as u32)) {
                al += 1
            }
        }
    }
    return al
}

// C: nativo/bir/x64_abi_sysv.c:171
proc bytes_na_pilha(tam: u32) -> u32 {
    return (((tam + ABI_SYSV_BYTES_EIGHTBYTE) - 1) / ABI_SYSV_BYTES_EIGHTBYTE) * ABI_SYSV_BYTES_EIGHTBYTE
}

// C: nativo/bir/x64_abi_sysv.c:177
// C2F-13: args fundido em n (len)
proc posicionar_na_pilha(args: []AbiSysvArg, saida: ^AbiSysvPlano) -> u32 {
    var pilha: u32 = 0
    for k in (0 as u32)..<(len(args) as u32) {
        if not saida.arg[k].na_memoria {
            continue
        }
        saida.off[k] = pilha
        pilha += bytes_na_pilha(args[k].tam)
    }
    return pilha
}

// C: nativo/bir/x64_abi_sysv.c:191
// C2F-13: args fundido em n (len); ^AbiSysvArg nao indexa, por isso a fatia (como classificar)
pub proc abi_sysv_planejar(args: []AbiSysvArg, ret: ^AbiSysvArg, saida: ^AbiSysvPlano) -> bool {
    let n: u32 = len(args) as u32
    if (n > ABI_SYSV_MAX_ARGS) or (not abi_sysv_retorno(ret, &saida.ret)) {
        return false
    }
    var oculto: u32 = 0
    saida.oculto = saida.ret.na_memoria
    if saida.oculto {
        oculto = 1
    }
    if not abi_sysv_classificar(args, oculto, saida.arg[0..<(n as int)]) {
        return false
    }
    saida.bytes_pilha = posicionar_na_pilha(args, saida)
    saida.al = abi_sysv_al_variadica(saida.arg[0..<(n as int)])
    return true
}

// C: nativo/bir/x64_abi_sysv.c:204
pub proc abi_sysv_bloco_arg(reg: i32) -> u32 {
    for k in (0 as u32)..<ABI_SYSV_REGS_INT {
        if common.c2f_s2u_32(REGS_INT_ARG[k]) == common.c2f_s2u_32(reg) {
            return k * ABI_SYSV_BYTES_EIGHTBYTE
        }
    }
    for k in (0 as u32)..<ABI_SYSV_REGS_SSE {
        if common.c2f_s2u_32(REGS_SSE_ARG[k]) == common.c2f_s2u_32(reg) {
            return ABI_SYSV_BLOCO_XMM + (k * ABI_SYSV_BYTES_EIGHTBYTE)
        }
    }
    return 0
}

// C: nativo/bir/x64_abi_sysv.c:218
pub proc abi_sysv_bloco_ret(reg: i32) -> u32 {
    for k in (0 as u32)..<2 {
        if common.c2f_s2u_32(REGS_INT_RET[k]) == common.c2f_s2u_32(reg) {
            return ABI_SYSV_BLOCO_RET_INT + (k * ABI_SYSV_BYTES_EIGHTBYTE)
        }
        if common.c2f_s2u_32(REGS_SSE_RET[k]) == common.c2f_s2u_32(reg) {
            return ABI_SYSV_BLOCO_RET_SSE + (k * ABI_SYSV_BYTES_EIGHTBYTE)
        }
    }
    return 0
}

// C: nativo/bir/x64_abi_sysv.c:229
proc abi_sysv_nome_reg(reg: i32) -> str {
    var tern_1: str = "?"
    if common.c2f_s2u_32(reg) <= (ABI_SYSV_NENHUM as u32) {
        tern_1 = NOMES_REG[reg]
    }
    return tern_1
}

// ---------------------------------------------------------------- testes (blocos da ABI e nomes de registrador)

test "x64_abi_sysv_bloco_arg" {
    expect(abi_sysv_bloco_arg(2) == 0)
    expect(abi_sysv_bloco_arg(3) == 8)
    expect(abi_sysv_bloco_arg(6) == 40)
    expect(abi_sysv_bloco_arg(7) == 48)
    expect(abi_sysv_bloco_arg(14) == 104)
    expect(abi_sysv_bloco_arg(0) == 0)
}

test "x64_abi_sysv_bloco_ret" {
    expect(abi_sysv_bloco_ret(0) == 112)
    expect(abi_sysv_bloco_ret(1) == 120)
    expect(abi_sysv_bloco_ret(7) == 128)
    expect(abi_sysv_bloco_ret(8) == 136)
    expect(abi_sysv_bloco_ret(2) == 0)
}

test "x64_abi_sysv_nome_reg" {
    expect(abi_sysv_nome_reg(2) == "rdi")
    expect(abi_sysv_nome_reg(ABI_SYSV_NENHUM) == "-")
    expect(abi_sysv_nome_reg(16) == "?")
}
