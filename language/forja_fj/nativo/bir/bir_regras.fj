// C: nativo/bir/bir_regras.c:148
pub proc bir_nome_do_op(op: u8) -> str {
    if (op as u32) >= (len(NOMES_IR_OP) as u32) {
        return "IR_?"
    }
    return NOMES_IR_OP[op]
}

// C: nativo/bir/bir_regras.c:156
proc proc_eh_externo(c: ^BirCtx, nome: i32) -> bool {
    if ((nome < 0) or (common.c2f_s2u_32(nome) >= c.n_nomes)) or (c.simbolo_do_nome[nome] != BIR_SIMBOLO_EXTERNO) {
        return false
    }
    return not (bir_externo_de(c, nome) as ^ir.IrExterno).interno
}

// C: nativo/bir/bir_regras.c:164
proc tem_argumento_proc(i: ?^ir.IrInstr) -> bool {
    for k in (0 as u32)..<(i as ^ir.IrInstr).nargs {
        if ((i as ^ir.IrInstr).args or_else {})[k].tipo_no == (ir.V_PROC as u8) {
            return true
        }
    }
    return false
}

// C: nativo/bir/bir_regras.c:174
proc variante_da_chamada(c: ^BirCtx, i: ?^ir.IrInstr) -> str {
    if tem_argumento_proc(i) {
        return "callback"
    }
    var tern_1: str = "proc"
    if common.c2f_b2i32(proc_eh_externo(c, (i as ^ir.IrInstr).nome)) != 0 {
        tern_1 = "foreign"
    }
    return tern_1
}

// C: nativo/bir/bir_regras.c:182
proc variante_do_operador(i: ?^ir.IrInstr) -> str {
    var tern_1: str = "?"
    if ((i as ^ir.IrInstr).op_aux as u64) < (len(NOMES_OPERADOR) as u64) {
        tern_1 = NOMES_OPERADOR[(i as ^ir.IrInstr).op_aux]
    }
    return tern_1 // C2F: sizeof NOMES_OPERADOR C2F: sizeof NOMES_OPERADOR [ 0 ]
}

// C: nativo/bir/bir_regras.c:188
proc bir_variante_de(c: ^BirCtx, i: ?^ir.IrInstr) -> str {
    if ((i as ^ir.IrInstr).op == (ir.IR_UNARIO as u8)) or ((i as ^ir.IrInstr).op == (ir.IR_BINARIO as u8)) {
        return variante_do_operador(i)
    }
    if (i as ^ir.IrInstr).op == (ir.IR_ATRIBUICAO as u8) {
        var tern_1: str = "local"
        if (i as ^ir.IrInstr).nome >= 0 {
            tern_1 = "campo"
        }
        return tern_1
    }
    if (i as ^ir.IrInstr).op == (ir.IR_CHAMADA as u8) {
        return variante_da_chamada(c, i)
    }
    return "-"
}

// V4/W7b (decisao do main): acesso por indice a tabela, na ordem do C, para nativo_suporte_tabela
// (REGRAS_IR_2 e privada). Devolve por valor; k >= REGRAS_IR_QTD_2 e erro do chamador (R0006 em dev).
pub proc bir_regra_por_indice(k: u32) -> BirRegra {
    return REGRAS_IR_2[k]
}

// C: nativo/bir/bir_regras.c:199
// Devolve a regra POR VALOR (decisao do main: REGRAS_IR_2 e const e a Forja nao toma &CONST[k], E0301).
// Variante "-" na tabela casa qualquer variante (o C testa so o 1o byte '-', 45).
// F2: a copia da tabela (101 entradas) e feita 1x por construcao (BirCtx.regras, `bir_regras_copiar`); montar a const por chamada custava 14-15% do tempo
// (250 mil chamadas). Sem a copia (BirCtx de teste) cai no caminho antigo, 1 copia por chamada.
proc bir_achar_regra(c: ^BirCtx, op: u8, variante: str) -> ?BirRegra {
    if len(c.regras) > 0 {
        return bir_achar_regra_indice(c, op, variante)
    }
    var tabela = REGRAS_IR_2
    return bir_achar_regra_em(tabela[..], op, variante)
}

// F3: percorre so as regras do `op` (encadeadas na ordem da tabela); a 1a que casa e a mesma da busca linear.
proc bir_achar_regra_indice(c: ^BirCtx, op: u8, variante: str) -> ?BirRegra {
    var k: i32 = c.regras_primeira[op as int] - 1
    while k >= 0 {
        if bir_variante_casa(c.regras[k as int].variante, variante) {
            return c.regras[k as int]
        }
        k = c.regras_prox[k as int] - 1
    }
    return none
}

// F3: mesma regra de casamento de bir_achar_regra_em: "-" na tabela casa qualquer variante.
proc bir_variante_casa(variante_tabela: ?str, variante: str) -> bool {
    let texto: str = variante_tabela or_else ""
    if len(texto) > 0 {
        if texto[0] == 45 {
            return true
        }
    }
    return texto == variante
}

// F2/F3: copia unica de REGRAS_IR_2 em c.regras (dono: quem chama, `delete(c.regras)`) e indexa por op.
proc bir_regras_copiar(c: ^BirCtx) {
    let tabela = REGRAS_IR_2
    c.regras = make([dynamic]BirRegra, alloc = heap, cap = 101)
    for k in 0..<101 {
        append(&c.regras, item = tabela[k])
    }
    bir_regras_indexar(c)
}

// F3: encadeia as regras de cada op na ordem da tabela. Percorre de tras para frente e poe cada regra na frente
// da lista do seu op, assim a cabeca (regras_primeira) e a 1a regra da tabela daquele op.
proc bir_regras_indexar(c: ^BirCtx) {
    for op in 0..<256 {
        c.regras_primeira[op] = 0
    }
    var j: int = 0
    while j < 101 {
        let k: int = 100 - j
        let op: int = c.regras[k].op as int
        c.regras_prox[k] = c.regras_primeira[op]
        c.regras_primeira[op] = (k + 1) as i32
        j += 1
    }
}

proc bir_achar_regra_em(tabela: []BirRegra, op: u8, variante: str) -> ?BirRegra {
    var k: int = 0
    while k < len(tabela) {
        let regra: BirRegra = tabela[k]
        let variante_tabela: str = regra.variante or_else ""
        var coringa: bool = false
        if len(variante_tabela) > 0 {
            coringa = variante_tabela[0] == 45
        }
        if regra.op == op and (coringa or variante_tabela == variante) {
            return regra
        }
        k += 1
    }
    return none
}

test "bir_regras_achar_regra" {
    var c: BirCtx = BirCtx{}
    let coringa: ?BirRegra = bir_achar_regra(&c, ir.IR_LOCAL as u8, "qualquer")
    expect(coringa != none)
    expect((coringa or_else BirRegra{}).fn == (BIR_REGRA_FN_BIR_REGRA_LOCAL as u16))
    let regra_local: ?BirRegra = bir_achar_regra(&c, ir.IR_ATRIBUICAO as u8, "local")
    expect((regra_local or_else BirRegra{}).fn == (BIR_REGRA_FN_BIR_REGRA_ATRIBUICAO as u16))
    expect(((regra_local or_else BirRegra{}).marco or_else "") == "M1")
    let campo: ?BirRegra = bir_achar_regra(&c, ir.IR_ATRIBUICAO as u8, "campo")
    expect(((campo or_else BirRegra{}).marco or_else "") == "M2")
    expect(bir_achar_regra(&c, 200, "x") == none)
}

test "bir_regras_achar_regra_com_copia_igual_ao_caminho_antigo" {
    var c: BirCtx = BirCtx{}
    var copiada: BirCtx = BirCtx{}
    bir_regras_copiar(&copiada)
    defer delete(copiada.regras)
    expect(len(copiada.regras) == 101)
    let variantes: [4]str = {"local", "campo", "qualquer", ""}
    var diferentes = 0
    for op in 0..<256 {
        for variante in variantes {
            let a = bir_achar_regra(&c, op as u8, variante)
            let b = bir_achar_regra(&copiada, op as u8, variante)
            if (a == none) != (b == none) or (a or_else BirRegra{}).fn != (b or_else BirRegra{}).fn {
                diferentes += 1
            }
            if ((a or_else BirRegra{}).marco or_else "") != ((b or_else BirRegra{}).marco or_else "") {
                diferentes += 1
            }
        }
    }
    expect(diferentes == 0)
}
