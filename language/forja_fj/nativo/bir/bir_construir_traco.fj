import "common"
import "ir"
import "semantic"

const TRACO_SLOT_BYTES: u32 = 8
const TRACO_NOME_MAX: i32 = 512
const TRACO_NARGS: u32 = 5

// C: nativo/bir/bir_construir_traco.c:19
proc bits_do_real_2(c: ^BirCtx, real: BirOperando) -> BirOperando {
    var tern_1: i32 = BC_I32
    if real.classe == (BC_F64 as u8) {
        tern_1 = BC_I64
    }
    let classe: u8 = tern_1 as u8
    var endereco: u32 = 0
    var dst: u32 = 0
    if c.slot_traco < 0 {
        c.slot_traco = transmute(bir_novo_slot(c, TRACO_SLOT_BYTES, TRACO_SLOT_BYTES), to = i32)
    }
    let arg_1: u32 = bir_novo_vreg(c, BC_I64 as u8)
    let arg_2: u32 = common.c2f_s2u_32(c.slot_traco)
    let arg_3: ^BirCtx = c
    endereco = bir_emitir_end_slot(arg_3, arg_2, arg_1)
    bir_emitir_grava(c, endereco, 0, real)
    dst = bir_novo_vreg(c, classe)
    bir_emitir_carrega(c, dst, endereco, 0)
    return op_vreg(dst, classe)
}

// C: nativo/bir/bir_construir_traco.c:34
proc com_extensao_zero(o: BirOperando) -> BirOperando {
    var tern_1: BirOperando = BirOperando{}
    if o.classe == (BC_I64 as u8) {
        tern_1 = o
    } else {
        tern_1 = op_com_extensao(o, BE_ZERO as u8)
    }
    return tern_1
}

// C: nativo/bir/bir_construir_traco.c:40
proc local_pronto(c: ^BirCtx, i: ?^ir.IrInstr, classe: u8) -> bool {
    var vreg: i32 = 0
    if (((i as ^ir.IrInstr).destino < 0) or (common.c2f_s2u_32((i as ^ir.IrInstr).destino) >= c.n_local)) or ((c.tipo_local or_else {})[(i as ^ir.IrInstr).destino] != (i as ^ir.IrInstr).tipo) {
        return false
    }
    vreg = (c.vreg_local or_else {})[(i as ^ir.IrInstr).destino]
    return (((c.em_memoria or_else {})[(i as ^ir.IrInstr).destino] as i32) != 0) or ((vreg >= 0) and ((((c.f as ^BirFuncao).classe_vreg or_else {})[vreg] as i32) == (classe as i32)))
}

// C: nativo/bir/bir_construir_traco.c:50
proc temporario_pronto(c: ^BirCtx, i: ?^ir.IrInstr, classe: u8) -> bool {
    var vreg: i32 = 0
    if ((i as ^ir.IrInstr).destino < 0) or (common.c2f_s2u_32((i as ^ir.IrInstr).destino) >= c.n_temp) {
        return false
    }
    vreg = (c.vreg_temp or_else {})[(i as ^ir.IrInstr).destino]
    return ((vreg >= 0) and ((((c.f as ^BirFuncao).classe_vreg or_else {})[vreg] as i32) == (classe as i32))) and ((c.slot_temp == none) or ((c.slot_temp or_else {})[(i as ^ir.IrInstr).destino] < 0))
}

// C: nativo/bir/bir_construir_traco.c:60
proc destino_pronto(c: ^BirCtx, i: ?^ir.IrInstr, e_local: bool) -> bool {
    var classe: u8 = BC_NADA as u8
    if not bir_classe_do_tipo((c.e as ^BirEntrada).tipos as ^semantic.Tipos, (i as ^ir.IrInstr).tipo, &classe) {
        return false
    }
    var tern_1: i32 = 0
    if common.c2f_b2i32(e_local) != 0 {
        tern_1 = common.c2f_b2i32(local_pronto(c, i, classe))
    } else {
        tern_1 = common.c2f_b2i32(temporario_pronto(c, i, classe))
    }
    return tern_1 != 0
}

// C: nativo/bir/bir_construir_traco.c:70
proc chamar_traco(c: ^BirCtx, i: ?^ir.IrInstr, indice: u32, bits: BirOperando) {
    let instr: ^ir.IrInstr = i as ^ir.IrInstr
    let posicao: common.FontePosicao = common.fonte_localizar_no_arquivo((c.e as ^BirEntrada).fonte, instr.pos)
    let nome_fn: str = common.interner_texto((c.e as ^BirEntrada).nomes as ^common.Interner, (c.funcao_ir as ^ir.IrFuncao).nome)
    let completo = format(f"fj_{nome_fn}", alloc = heap)
    defer delete(completo)
    // C: snprintf num buffer de TRACO_NOME_MAX (512): o nome guarda so 511 bytes
    var tam: u32 = (len(completo) as u64) as u32
    if tam > 511 {
        tam = 511
    }
    var args: [5]BirOperando = {BirOperando{}, BirOperando{}, BirOperando{}, BirOperando{}, BirOperando{}}
    args[0] = op_vreg(bir_vreg_do_texto(c, completo, tam), BC_I64 as u8)
    args[1] = op_imed(indice as i64, BC_I32 as u8)
    args[2] = op_imed(posicao.linha as i64, BC_I32 as u8)
    args[3] = op_imed(posicao.coluna as i64, BC_I32 as u8)
    args[4] = bits
    chamar_runtime(c, "forja_traco", args[..])
}

// C: nativo/bir/bir_construir_traco.c:88
proc valor_do_destino(c: ^BirCtx, i: ?^ir.IrInstr, e_local: bool, valor: ^BirOperando) -> bool {
    var tern_1: i32 = ir.V_TEMP
    if common.c2f_b2i32(e_local) != 0 {
        tern_1 = ir.V_LOCAL
    }
    var destino: ir.Valor = ir.Valor{tipo_no = tern_1 as u8, tipo = (i as ^ir.IrInstr).tipo, id = (i as ^ir.IrInstr).destino}
    return bir_operando_de(c, i, &destino, valor)
}

// C: nativo/bir/bir_construir_traco.c:96
proc bits_do_traco(c: ^BirCtx, valor: BirOperando, real: bool) -> BirOperando {
    var tern_1: BirOperando = valor
    if common.c2f_b2i32(real) != 0 {
        tern_1 = bits_do_real_2(c, valor)
    }
    return com_extensao_zero(tern_1)
}

// C: nativo/bir/bir_construir_traco.c:101
proc bir_tracar(c: ^BirCtx, i: ?^ir.IrInstr) -> bool {
    let instr: ^ir.IrInstr = i as ^ir.IrInstr
    let forma: ir.IrTracoForma = ir.ir_traco_forma_de((c.e as ^BirEntrada).tipos as ^semantic.Tipos, instr.tipo)
    var valor: BirOperando = BirOperando{}
    var e_local: bool = false
    if (forma.bits == 0) or (not ir.ir_traco_destino(i, &e_local)) or (not destino_pronto(c, i, e_local)) {
        return true
    }
    let indice: u32 = ir.ir_indice_de(&c.num, i)
    if indice == ir.IR_SEM_INDICE {
        return bir_falha_inconsistente(c, "instrucao fora da numeracao do traco")
    }
    if not valor_do_destino(c, i, e_local, &valor) {
        return false
    }
    chamar_traco(c, i, indice, bits_do_traco(c, valor, forma.real))
    return true
}
