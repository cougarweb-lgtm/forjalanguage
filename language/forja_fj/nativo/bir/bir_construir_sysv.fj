import "common"
import "ir"
import "semantic"

struct FolhasSysv {
    folhas: ?[]BirFolhaSysv
    n: u32
}

const BIR_SYSV_FOLHAS_MAX: u32 = 16
const BIR_SYSV_TAM_REG: u32 = 16

// C: nativo/bir/bir_construir_sysv.c:16
proc tam_da_classe_sysv(classe: u8) -> u32 {
    let sw_1 = classe as i32
    if sw_1 == BC_I8 {
        return 1
    } else if sw_1 == BC_I16 {
        return 2
    } else if sw_1 == BC_I32 or sw_1 == BC_F32 {
        return 4
    } else if sw_1 == BC_I64 or sw_1 == BC_F64 {
        return 8
    } else {
        return 0
    }
    return 0
}

// C: nativo/bir/bir_construir_sysv.c:27
proc acrescentar_folha(f: ^FolhasSysv, classe: u8, deslocamento: u32) -> bool {
    let ali: u32 = tam_da_classe_sysv(classe)
    if (ali == 0) or (f.n >= BIR_SYSV_FOLHAS_MAX) {
        return false
    }
    let antes_1: u32 = f.n
    f.n += 1
    let p_1 = f.folhas or_else {}
    p_1[antes_1] = BirFolhaSysv{sse = common.c2f_b2i32(bir_classe_eh_real(classe as i32)) as u8, deslocamento = deslocamento, alinhamento = ali}
    return true
}

// C: nativo/bir/bir_construir_sysv.c:40
proc folhas_da_struct(c: ^BirCtx, tipo: u32, base: u32, f: ^FolhasSysv) -> bool {
    let s: ?^ir.IrStruct = ir.layout_estrutura((c.e as ^BirEntrada).tipos as ^semantic.Tipos, (c.e as ^BirEntrada).ir as ^ir.IrPrograma, tipo)
    let l: ^ir.Layouts = bir_layouts(c)
    if s == none {
        return false
    }
    var k: u32 = 0
    while k < (s as ^ir.IrStruct).ncampos {
        let arg_1: ^FolhasSysv = f
        let arg_2: u32 = base + ir.layout_offset_campo(l, tipo, k)
        let arg_3: u32 = ((s as ^ir.IrStruct).campos or_else {})[k].tipo
        let arg_4: ^BirCtx = c
        if not folhas_do_tipo(arg_4, arg_3, arg_2, arg_1) {
            return false
        }
        k += 1
    }
    return true
}

// C: nativo/bir/bir_construir_sysv.c:54
proc folhas_do_tipo(c: ^BirCtx, tipo: u32, base: u32, f: ^FolhasSysv) -> bool {
    var classe: u8 = 0
    if bir_classe_do_tipo((c.e as ^BirEntrada).tipos as ^semantic.Tipos, tipo, &classe) {
        return acrescentar_folha(f, classe, base)
    }
    if common.c2f_s2u_32(semantic.tipo_classe_de((c.e as ^BirEntrada).tipos as ^semantic.Tipos, tipo)) != (semantic.TC_STRUCT as u32) {
        return false
    }
    return folhas_da_struct(c, tipo, base, f)
}

// C: nativo/bir/bir_construir_sysv.c:66
proc preencher_descritor(c: ^BirCtx, tipo: u32, tam: u32, f: ^FolhasSysv) -> bool {
    if tam > BIR_SYSV_TAM_REG {
        let p_1 = f.folhas or_else {}
        p_1[0] = BirFolhaSysv{sse = 0, deslocamento = 0, alinhamento = 8}
        f.n = 1
        return true
    }
    return folhas_do_tipo(c, tipo, 0, f)
}

// C: nativo/bir/bir_construir_sysv.c:76
proc bir_descritor_sysv(c: ^BirCtx, tipo: u32) -> ?^BirSysv {
    let p: ^BirPrograma = c.p as ^BirPrograma
    var forma: BirSlot = BirSlot{}
    if not bir_forma(c, tipo, &forma) {
        return none
    }
    let descritor: ^BirSysv = new(BirSysv, alloc = common.arena_mem(&p.arena))
    var f: FolhasSysv = FolhasSysv{folhas = arena_fatia_bir_folha_sysv(&p.arena, BIR_SYSV_FOLHAS_MAX as int), n = 0}
    if not preencher_descritor(c, tipo, forma.tam, &f) {
        return none
    }
    descritor.tam = forma.tam
    descritor.n = f.n
    descritor.folhas = f.folhas
    return descritor
}

// Valores conferidos com a TamDaClasseSysv do C (bir_construir_sysv.c:16)
test "tam_da_classe_sysv" {
    expect(tam_da_classe_sysv(BC_I8 as u8) == 1)
    expect(tam_da_classe_sysv(BC_I16 as u8) == 2)
    expect(tam_da_classe_sysv(BC_I32 as u8) == 4)
    expect(tam_da_classe_sysv(BC_F32 as u8) == 4)
    expect(tam_da_classe_sysv(BC_I64 as u8) == 8)
    expect(tam_da_classe_sysv(BC_F64 as u8) == 8)
    expect(tam_da_classe_sysv(BC_NADA as u8) == 0)
}
