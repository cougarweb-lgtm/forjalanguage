// 0.40.0 (so wasm): nomes de runtime que o backend wasm emite como opcode, sem CHAMA: floor/ceil/trunc/round (f64 e f32) sempre e, em release,
// real -> i32/int. E a fonte unica da lista: o gerador wasm (wasm_eh_as_real_direto) e o inliner (CHAMA que vira opcode nao e chamada) leem daqui.
proc bir_nome_arredonda(nome: str, eh_f64: bool) -> bool {
    if eh_f64 {
        return (nome == "forja_math_floor") or (nome == "forja_math_ceil") or (nome == "forja_math_trunc") or (nome == "forja_math_round")
    }
    return (nome == "forja_math_floorf") or (nome == "forja_math_ceilf") or (nome == "forja_math_truncf") or (nome == "forja_math_roundf")
}

pub proc bir_chamada_opcode_wasm(prog: ^BirPrograma, ins: ^BirInstr, nome: str) -> bool {
    let classe: i32 = ins.classe as i32
    if (ins.nargs == 1) and ((classe == BC_F64) or (classe == BC_F32)) {
        if bir_nome_arredonda(nome, classe == BC_F64) {
            return true
        }
    }
    if (prog.modo as i32) != BM_RELEASE {
        return false
    }
    if ins.nargs != 3 {
        return false
    }
    if nome == "forja_as_i32_de_f64" {
        return classe == BC_I32
    }
    if nome == "forja_as_i64_de_f64" {
        return classe == BC_I64
    }
    return false
}

// A CHAMA `ins` (BIR_CHAMA) vira opcode no wasm: no inliner ela nao conta como chamada do corpo
pub proc bir_chamada_vira_opcode(prog: ^BirPrograma, ins: ^BirInstr) -> bool {
    if (not prog.wasm) or (ins.op != (BIR_CHAMA as u8)) or (ins.simbolo >= prog.nsimbolos) {
        return false
    }
    if (prog.simbolos[ins.simbolo].tipo as i32) != BS_RUNTIME {
        return false
    }
    return bir_chamada_opcode_wasm(prog, ins, prog.simbolos[ins.simbolo].nome or_else "")
}

