// C: nativo/bir/bir.h:107
pub proc bir_classe_eh_real(c: i32) -> bool {
    return (common.c2f_s2u_32(c) == (BC_F32 as u32)) or (common.c2f_s2u_32(c) == (BC_F64 as u32))
}

// C: nativo/bir/bir.h:113
pub proc bir_classe_eh_xmm(c: i32) -> bool {
    return ((common.c2f_s2u_32(c) == (BC_F32 as u32)) or (common.c2f_s2u_32(c) == (BC_F64 as u32))) or (common.c2f_s2u_32(c) == (BC_V128 as u32))
}
