pub proc arena_fatia_bir_entrada_sysv(a: ^common.Arena, n: int) -> []BirEntradaSysv {
    var l = make([dynamic]BirEntradaSysv, alloc = common.arena_mem(a), cap = n)
    for i in 0..<n {
        append(&l, item = BirEntradaSysv{})
    }
    return l[..]
}

pub proc arena_fatia_bir_folha_sysv(a: ^common.Arena, n: int) -> []BirFolhaSysv {
    var l = make([dynamic]BirFolhaSysv, alloc = common.arena_mem(a), cap = n)
    for i in 0..<n {
        append(&l, item = BirFolhaSysv{})
    }
    return l[..]
}

