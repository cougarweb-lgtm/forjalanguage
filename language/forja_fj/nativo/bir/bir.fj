pub proc chamar_bir_regra_fn(tag: u16, c: ^BirCtx, i: ^ir.IrInstr) -> bool {
    if tag == 1 {
        return bir_regra_local(c, i)
    }
    if tag == 2 {
        return bir_regra_atribuicao(c, i)
    }
    if tag == 3 {
        return bir_regra_imprime(c, i)
    }
    if tag == 4 {
        return bir_regra_assert(c, i)
    }
    if tag == 5 {
        return bir_regra_expect(c, i)
    }
    if tag == 6 {
        return bir_regra_panic(c, i)
    }
    if tag == 7 {
        return bir_regra_aloca(c, i)
    }
    if tag == 8 {
        return bir_regra_lista_cria(c, i)
    }
    if tag == 9 {
        return bir_regra_anexa(c, i)
    }
    if tag == 10 {
        return libera_bloco(c, i)
    }
    if tag == 11 {
        return libera_lista(c, i)
    }
    if tag == 12 {
        return libera_texto(c, i)
    }
    if tag == 13 {
        return libera_pool(c, i)
    }
    if tag == 14 {
        return bir_regra_libera(c, i)
    }
    if tag == 15 {
        return bir_regra_frame_reset(c, i)
    }
    if tag == 16 {
        return bir_regra_redimensiona(c, i)
    }
    if tag == 17 {
        return bir_regra_anexa_fatia(c, i)
    }
    if tag == 18 {
