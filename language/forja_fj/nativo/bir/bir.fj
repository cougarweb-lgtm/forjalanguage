    }
    if tag == 19 {
        return bir_regra_busca_binaria(c, i)
    }
    if tag == 20 {
        return bir_regra_ordena_geral(c, i)
    }
    if tag == 21 {
        return bir_regra_heap(c, i)
    }
    if tag == 22 {
        return bir_regra_elemento(c, i)
    }
    if tag == 23 {
        return bir_regra_endereco_elemento(c, i)
    }
    if tag == 24 {
        return bir_regra_fatia(c, i)
    }
    if tag == 25 {
        return bir_regra_fatia_de_ponteiro(c, i)
    }
    if tag == 26 {
