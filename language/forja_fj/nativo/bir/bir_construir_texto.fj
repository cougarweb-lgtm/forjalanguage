import "common"
import "frontend"
import "ir"
import "semantic"

const STR_CAMPO_PTR: u32 = 0
const STR_CAMPO_LEN: u32 = 1

// C: nativo/bir/bir_construir_texto.c:22
proc offset_do_campo_str(c: ^BirCtx, campo: u32) -> u32 {
    return ir.layout_offset_campo(bir_layouts(c), semantic.TIPO_STR as u32, campo)
}

// C: nativo/bir/bir_construir_texto.c:28
// C2F-13: args fundido em nargs (len)
proc chamar_runtime_2(c: ^BirCtx, funcao: str, args: ?[]BirOperando) -> ^BirInstr {
    let chama: ^BirInstr = bir_emitir(c, BIR_CHAMA, BC_NADA as u8)
    chama.simbolo = bir_simbolo_runtime(c, funcao)
    chama.args = args
    chama.nargs = len((args or_else {})) as u32
    return chama
}

// C: nativo/bir/bir_construir_texto.c:38
proc bir_texto_literal(c: ^BirCtx, v: ^ir.Valor, endereco: ^u32) -> bool {
    let texto: str = common.interner_texto((c.e as ^BirEntrada).nomes as ^common.Interner, v.id)
    let tam: u32 = common.interner_tam((c.e as ^BirEntrada).nomes as ^common.Interner, v.id)
    var forma: BirSlot = BirSlot{}
    var base: u32 = 0
    var ptr: u32 = 0
    if not bir_forma(c, semantic.TIPO_STR as u32, &forma) {
        return false
    }
    let arg_1: u32 = bir_novo_vreg(c, BC_I64 as u8)
    let arg_2: u32 = bir_novo_slot(c, forma.tam, forma.alinhamento)
    let arg_3: ^BirCtx = c
    base = bir_emitir_end_slot(arg_3, arg_2, arg_1)
    ptr = bir_vreg_do_texto(c, texto, tam)
    let arg_4: BirOperando = op_vreg(ptr, BC_I64 as u8)
    let arg_5: i32 = transmute(offset_do_campo_str(c, STR_CAMPO_PTR), to = i32)
    let arg_6: u32 = base
    let arg_7: ^BirCtx = c
    bir_emitir_grava(arg_7, arg_6, arg_5, arg_4)
    let arg_8: BirOperando = op_imed(tam as i64, BC_I64 as u8)
    let arg_9: i32 = transmute(offset_do_campo_str(c, STR_CAMPO_LEN), to = i32)
    let arg_10: u32 = base
    let arg_11: ^BirCtx = c
    bir_emitir_grava(arg_11, arg_10, arg_9, arg_8)
    endereco^ = base
    return true
}

// C: nativo/bir/bir_construir_texto.c:55
proc bir_texto_cstr(c: ^BirCtx, v: ^ir.Valor, saida: ^BirOperando) -> bool {
    let arg_1: u32 = common.interner_tam((c.e as ^BirEntrada).nomes as ^common.Interner, v.id)
    let arg_2: str = common.interner_texto((c.e as ^BirEntrada).nomes as ^common.Interner, v.id)
    let arg_3: ^BirCtx = c
    let vreg: u32 = bir_vreg_do_texto(arg_3, arg_2, arg_1)
    saida^ = op_vreg(vreg, BC_I64 as u8)
    return true
}

// C: nativo/bir/bir_construir_texto.c:63
proc bir_imprime_str(c: ^BirCtx, i: ^ir.IrInstr) -> bool {
    var args: []BirOperando = arena_fatia_bir_operando(&(c.p as ^BirPrograma).arena, 1)
    if not bir_argumento_agregado(c, i, &i.a, &args[0]) {
        return false
    }
    _ = chamar_runtime_2(c, "forja_print_str", args)
    return true
}

// C: nativo/bir/bir_construir_texto.c:74
// C2F-INDECIDIVEL: args (BirOperando* -> []BirOperando, sempre presente)
proc chamar_str_igual(c: ^BirCtx, i: ^ir.IrInstr, args: []BirOperando, dst: u32) {
    var igual: u32 = dst
    if i.op_aux != (frontend.OP_IGUAL as u8) {
        igual = bir_novo_vreg(c, BC_I8 as u8)
    }
    let chama: ^BirInstr = chamar_runtime_2(c, "forja_str_igual", args)
    chama.classe = BC_I8 as u8
    chama.dst = igual
    if igual != dst {
        _ = bir_emitir_pedido(c, BirPedido{op = BIR_XOR as u8, dst = dst, a = op_vreg(igual, BC_I8 as u8), b = op_imed(1 as i64, BC_I8 as u8)})
    }
}

// C: nativo/bir/bir_construir_texto.c:86
proc bir_regra_str_igual(c: ^BirCtx, i: ^ir.IrInstr) -> bool {
    var args: []BirOperando = arena_fatia_bir_operando(&(c.p as ^BirPrograma).arena, 2)
    var dst: u32 = 0
    if (i.op_aux != (frontend.OP_IGUAL as u8)) and (i.op_aux != (frontend.OP_DIFERENTE as u8)) {
        return bir_falha_tipo(c, i, bir_variante_de(c, i), i.a.tipo)
    }
    if (not bir_argumento_agregado(c, i, &i.a, &args[0])) or (not bir_argumento_agregado(c, i, &i.b, &args[1])) {
        return false
    }
    if not bir_definir_destino(c, BC_I8 as u8, &dst) {
        return false
    }
    chamar_str_igual(c, i, args, dst)
    return true
}

// C: nativo/bir/bir_construir_texto.c:102
proc bir_cstr_para_str(c: ^BirCtx, i: ^ir.IrInstr) -> bool {
    var pedido: BirPedidoSlot = BirPedidoSlot{temporario = true, id = i.destino}
    var args: []BirOperando = arena_fatia_bir_operando(&(c.p as ^BirPrograma).arena, 3)
    var destino: u32 = 0
    var linha: u32 = 0
    if semantic.tipo_classe_de((c.e as ^BirEntrada).tipos as ^semantic.Tipos, i.a.tipo) != semantic.TC_CSTR {
        return bir_falha_tipo(c, i, "-", i.a.tipo)
    }
    if (not bir_operando_de(c, i, &i.a, &args[0])) or (not bir_operando_vreg(c, args[0], &args[0])) {
        return false
    }
    if (not bir_forma(c, semantic.TIPO_STR as u32, &pedido.forma)) or (not bir_definir_slot(c, &pedido, &destino)) {
        return false
    }
    let prog: ^BirPrograma = c.p as ^BirPrograma
    // C2F-82: BirConfereLimites com modo != BM_DEV reduz a checagem --checagem sim
    if (prog.modo != (BM_DEV as u8)) and prog.checagem {
        let posicao: common.FontePosicao = common.fonte_localizar_no_arquivo((c.e as ^BirEntrada).fonte, i.pos)
        var origem: BirOrigemNulo = BirOrigemNulo{oque = "conversao 'as' de cstr para str", arquivo = posicao.caminho, linha = posicao.linha}
        bir_falha_se_nulo(c, args[0].id, &origem)
    }
    args[1] = bir_vreg_do_arquivo(c, i.pos, &linha)
    args[2] = op_imed(linha as i64, BC_I32 as u8)
    let chama: ^BirInstr = chamar_runtime_2(c, "forja_str_de_cstr", args)
    chama.a = op_vreg(destino, BC_I64 as u8)
    chama.a.tam = pedido.forma.tam
    return true
}

// C: nativo/bir/bir_construir_texto.c:129
proc bir_regra_tamanho_texto(c: ^BirCtx, i: ^ir.IrInstr) -> bool {
    var endereco: u32 = 0
    var dst: u32 = 0
    if (i.a.tipo != (semantic.TIPO_STR as u32)) and (common.c2f_s2u_32(semantic.tipo_classe_de((c.e as ^BirEntrada).tipos as ^semantic.Tipos, i.a.tipo)) != (semantic.TC_FATIA as u32)) {
        return bir_tamanho_de_colecao(c, i)
    }
    if (not bir_endereco_de(c, i, &i.a, &endereco)) or (not bir_definir_destino(c, BC_I64 as u8, &dst)) {
        return false
    }
    let arg_1: u32 = i.a.tipo
    let arg_2: ^ir.Layouts = bir_layouts(c)
    bir_emitir_carrega(c, dst, endereco, transmute(ir.layout_offset_campo(arg_2, arg_1, STR_CAMPO_LEN), to = i32))
    return true
}
