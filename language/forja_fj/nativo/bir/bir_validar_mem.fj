import "common"

// C: nativo/bir/bir_validar_mem.c:12
proc base_valida(f: ^BirFuncao, base: ^BirOperando) -> bool {
    return (((base.tipo == (BO_VREG as u8)) and (base.classe == (BC_I64 as u8))) and (base.id < f.nvregs)) and ((f.classe_vreg or_else {})[base.id] == (BC_I64 as u8))
}

// C: nativo/bir/bir_validar_mem.c:17
proc potencia_de_dois(n: u32) -> bool {
    return (n != 0) and ((n & (n - 1)) == 0)
}

// C: nativo/bir/bir_validar_mem.c:22
proc bir_slots_validos(f: ^BirFuncao) -> bool {
    var k: u32 = 0
    while k < f.nslots {
        let s: ^BirSlot = &f.slots[k]
        if ((s.tam == 0) or (not potencia_de_dois(s.alinhamento))) or (s.alinhamento > BIR_SLOT_ALINHAMENTO_MAX) {
            return false
        }
        k += 1
    }
    return true
}

// C: nativo/bir/bir_validar_mem.c:34
proc param_agregado_valido(f: ^BirFuncao, k: u32) -> bool {
    return ((f.param_tam or_else {})[k] == 0) or ((f.classe_vreg or_else {})[k] == (BC_I64 as u8))
}

// C: nativo/bir/bir_validar_mem.c:39
proc bir_agregados_validos(f: ^BirFuncao) -> bool {
    if (f.retorno_tam != 0) and (f.retorno != (BC_I64 as u8)) {
        return false
    }
    if f.param_tam == none {
        return true
    }
    var k: u32 = 0
    while k < f.nparams {
        if not param_agregado_valido(f, k) {
            return false
        }
        k += 1
    }
    return true
}

// C: nativo/bir/bir_validar_mem.c:52
proc end_slot_valido(f: ^BirFuncao, i: ?^BirInstr) -> bool {
    let dst_ok: bool = (((i as ^BirInstr).dst < f.nvregs) and ((f.classe_vreg or_else {})[(i as ^BirInstr).dst] == (BC_I64 as u8))) and ((i as ^BirInstr).classe == (BC_I64 as u8))
    return (((common.c2f_b2i32(dst_ok) != 0) and ((i as ^BirInstr).a.tipo == (BO_IMED as u8))) and ((i as ^BirInstr).a.imed >= 0)) and (common.c2f_s2u_64((i as ^BirInstr).a.imed) < (f.nslots as u64))
}

// C: nativo/bir/bir_validar_mem.c:59
proc classe_de_dado(classe: u8) -> bool {
    return ((classe as i32) >= BC_I8) and ((classe as i32) <= BC_V128)
}

// C: nativo/bir/bir_validar_mem.c:64
proc carrega_valido(f: ^BirFuncao, i: ?^BirInstr) -> bool {
    let dst_ok: bool = ((i as ^BirInstr).dst < f.nvregs) and (((f.classe_vreg or_else {})[(i as ^BirInstr).dst] as i32) == ((i as ^BirInstr).classe as i32))
    return (((common.c2f_b2i32(dst_ok) != 0) and (common.c2f_b2i32(classe_de_dado((i as ^BirInstr).classe)) != 0)) and (common.c2f_b2i32(base_valida(f, &(i as ^BirInstr).a)) != 0)) and ((i as ^BirInstr).desloc >= 0)
}

// C: nativo/bir/bir_validar_mem.c:71
proc valor_gravado_valido(i: ?^BirInstr) -> bool {
    return ((((i as ^BirInstr).b.tipo == (BO_VREG as u8)) or ((i as ^BirInstr).b.tipo == (BO_IMED as u8))) and (common.c2f_b2i32(classe_de_dado((i as ^BirInstr).b.classe)) != 0)) and (((i as ^BirInstr).classe as i32) == ((i as ^BirInstr).b.classe as i32))
}

// C: nativo/bir/bir_validar_mem.c:76
proc grava_valido(f: ^BirFuncao, i: ?^BirInstr) -> bool {
    return ((((i as ^BirInstr).dst == BIR_SEM_VREG) and (common.c2f_b2i32(valor_gravado_valido(i)) != 0)) and (common.c2f_b2i32(base_valida(f, &(i as ^BirInstr).a)) != 0)) and ((i as ^BirInstr).desloc >= 0)
}

// C: nativo/bir/bir_validar_mem.c:81
proc bytes_validos(n: i32) -> bool {
    return (n >= 1) and (common.c2f_s2u_32(n) <= BIR_COPIA_MEM_MAX)
}

// C: nativo/bir/bir_validar_mem.c:86
proc copia_mem_valida(f: ^BirFuncao, i: ?^BirInstr) -> bool {
    return ((((i as ^BirInstr).dst == BIR_SEM_VREG) and (common.c2f_b2i32(base_valida(f, &(i as ^BirInstr).a)) != 0)) and (common.c2f_b2i32(base_valida(f, &(i as ^BirInstr).b)) != 0)) and (common.c2f_b2i32(bytes_validos((i as ^BirInstr).desloc)) != 0)
}

// C: nativo/bir/bir_validar_mem.c:91
proc zera_mem_valida(f: ^BirFuncao, i: ?^BirInstr) -> bool {
    return ((((i as ^BirInstr).dst == BIR_SEM_VREG) and (common.c2f_b2i32(base_valida(f, &(i as ^BirInstr).a)) != 0)) and ((i as ^BirInstr).b.tipo == (BO_NADA as u8))) and (common.c2f_b2i32(bytes_validos((i as ^BirInstr).desloc)) != 0)
}

// C: nativo/bir/bir_validar_mem.c:96
proc bir_memoria_valida(f: ^BirFuncao, i: ?^BirInstr) -> bool {
    let sw_1 = (i as ^BirInstr).op as i32
    if sw_1 == BIR_END_SLOT {
        return end_slot_valido(f, i)
    } else if sw_1 == BIR_CARREGA {
        return carrega_valido(f, i)
    } else if sw_1 == BIR_GRAVA {
        return grava_valido(f, i)
    } else if sw_1 == BIR_COPIA_MEM {
        return copia_mem_valida(f, i)
    } else if sw_1 == BIR_ZERA_MEM {
        return zera_mem_valida(f, i)
    } else {
        return false
    }
    return false
}

// ---------------------------------------------------------------- testes (funcoes puras de validacao de memoria)

test "bir_validar_mem_potencia_de_dois" {
    expect(not potencia_de_dois(0))
    expect(potencia_de_dois(1))
    expect(potencia_de_dois(64))
    expect(not potencia_de_dois(3))
    expect(not potencia_de_dois(65))
}

test "bir_validar_mem_bytes_validos" {
    expect(not bytes_validos(0))
    expect(bytes_validos(1))
    expect(bytes_validos(64))
    expect(not bytes_validos(65))
}

test "bir_validar_mem_classe_de_dado" {
    expect(classe_de_dado(BC_I8 as u8))
    expect(classe_de_dado(BC_V128 as u8))
    expect(not classe_de_dado(BC_NADA as u8))
}
