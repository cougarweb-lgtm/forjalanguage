import "common"
import "ir"

const ARGS_REGISTRO: i32 = 2

// C: nativo/bir/bir_construir_teste.c:13
proc registrar_teste(c: ^BirCtx, irf: ^ir.IrFuncao) {
    var rotulo: i32 = irf.nome
    if irf.titulo >= 0 {
        rotulo = irf.titulo
    }
    let args: []BirOperando = arena_fatia_bir_operando(&(c.p as ^BirPrograma).arena, ARGS_REGISTRO as int)
    let funcao: u32 = bir_novo_vreg(c, BC_I64 as u8)
    let nomes: ^common.Interner = (c.e as ^BirEntrada).nomes as ^common.Interner
    let texto: str = common.interner_texto(nomes, rotulo)
    args[0] = op_vreg(bir_vreg_do_texto(c, texto, common.interner_tam(nomes, rotulo)), BC_I64 as u8)
    _ = bir_emitir_pedido(c, BirPedido{op = BIR_END_SIMBOLO as u8, dst = funcao, a = op_simbolo(c.simbolo_do_nome[irf.nome])})
    args[1] = op_vreg(funcao, BC_I64 as u8)
    chamar_runtime(c, "forja_teste_registrar", args)
}

// C: nativo/bir/bir_construir_teste.c:29
proc bir_programa_teste(c: ^BirCtx) -> bool {
    let ir_c: ?^ir.IrPrograma = (c.e as ^BirEntrada).ir
    var resultado: u32 = BIR_SEM_VREG
    var valor: BirOperando = BirOperando{}
    var chama: ?^BirInstr = none
    var k: u32 = 0
    while k < (ir_c as ^ir.IrPrograma).nfuncoes {
        if ((ir_c as ^ir.IrPrograma).funcoes or_else {})[k].e_teste {
            registrar_teste(c, &((ir_c as ^ir.IrPrograma).funcoes or_else {})[k])
        }
        k += 1
    }
    resultado = bir_novo_vreg(c, BC_I32 as u8)
    chama = bir_emitir(c, BIR_CHAMA, BC_I32 as u8)
    let ptr_1: ^BirInstr = chama as ^BirInstr
    ptr_1.simbolo = bir_simbolo_runtime(c, "forja_testes_rodar")
    let ptr_2: ^BirInstr = chama as ^BirInstr
    ptr_2.dst = resultado
    valor = op_vreg(resultado, BC_I32 as u8)
    bir_retorna(c, &valor)
    return true
}
