import "common"
import "frontend"
import "ir"
import "semantic"

struct Conta {
    c: ?^BirCtx
    i: ?^ir.IrInstr
    a: BirOperando
    b: BirOperando
    dst: u32
    fim: u32
    classe: u8
    sem_sinal: bool
    resto: bool
}

// C: nativo/bir/bir_construir_divisao.c:25
proc largura_em_bits(classe: u8) -> u32 {
    if (classe as i32) == BC_I8 {
        return 8
    }
    if (classe as i32) == BC_I16 {
        return 16
    }
    if (classe as i32) == BC_I32 {
        return 32
    }
    return 64
}

// C: nativo/bir/bir_construir_divisao.c:30
proc emitir_op(k: ^Conta, op: i32) {
    var tern_1: i32 = BIR_SINAL
    if common.c2f_b2i32(k.sem_sinal) != 0 {
        tern_1 = BIR_SEM_SINAL
    }
    _ = bir_emitir_pedido(k.c as ^BirCtx, BirPedido{op = op as u8, aux = tern_1 as u8, dst = k.dst, a = k.a, b = k.b})
}

// C: nativo/bir/bir_construir_divisao.c:35
proc zerar(k: ^Conta) {
    let arg_1: BirOperando = op_imed(0, k.classe)
    let arg_2: u32 = k.dst
    let arg_3: ^BirCtx = k.c as ^BirCtx
    bir_mover(arg_3, arg_2, arg_1)
}

// C: nativo/bir/bir_construir_divisao.c:41
proc bloco_de_zero(k: ^Conta, bloco: u32) {
    let ptr_1: ^BirCtx = k.c as ^BirCtx
    ptr_1.cur = bloco
    zerar(k)
    bir_salta(k.c as ^BirCtx, k.fim)
}

// C: nativo/bir/bir_construir_divisao.c:49
proc bloco_da_conta(k: ^Conta, bloco: u32, op: i32) {
    let ptr_1: ^BirCtx = k.c as ^BirCtx
    ptr_1.cur = bloco
    emitir_op(k, op)
    bir_salta(k.c as ^BirCtx, k.fim)
}

// C: nativo/bir/bir_construir_divisao.c:58
proc deslocamento(k: ^Conta) {
    let c: ?^BirCtx = k.c
    var tern_1: i32 = BIR_SHR
    if (k.i as ^ir.IrInstr).op_aux == (frontend.OP_DESLOCA_ESQ as u8) {
        tern_1 = BIR_SHL
    }
    let op: i32 = tern_1
    let bits: u32 = largura_em_bits(k.classe)
    var zero: u32 = 0
    var calcula: u32 = 0
    var fora: u32 = 0
    if k.b.tipo == (BO_IMED as u8) {
        if common.c2f_s2u_64(k.b.imed) >= (bits as u64) {
            zerar(k)
        } else {
            emitir_op(k, op)
        }
        return
    }
    k.fim = bir_novo_bloco(c as ^BirCtx, false)
    zero = bir_novo_bloco(c as ^BirCtx, false)
    calcula = bir_novo_bloco(c as ^BirCtx, false)
    let arg_1: BirOperando = op_imed(bits as i64, k.classe)
    let arg_2: BirOperando = k.b
    let arg_3: ^BirCtx = c as ^BirCtx
    fora = bir_comparar(arg_3, BCOND_GE_U as u8, arg_2, arg_1)
    bir_desvia(c as ^BirCtx, op_vreg(fora, BC_I8 as u8), zero, calcula)
    bloco_de_zero(k, zero)
    bloco_da_conta(k, calcula, op)
    let ptr_1: ^BirCtx = c as ^BirCtx
    ptr_1.cur = k.fim
}

// C: nativo/bir/bir_construir_divisao.c:85
proc testar_minimo(k: ^Conta) {
    let c: ?^BirCtx = k.c
    let frio: u32 = bir_novo_bloco(c as ^BirCtx, true)
    let segue: u32 = bir_novo_bloco(c as ^BirCtx, false)
    let arg_1: u8 = k.classe
    let arg_2: i64 = semantic.tipo_inteiro_min((k.i as ^ir.IrInstr).a.tipo)
    let arg_3: BirOperando = op_imed(arg_2, arg_1)
    let arg_4: BirOperando = k.a
    let arg_5: ^BirCtx = c as ^BirCtx
    let eh_minimo: u32 = bir_comparar(arg_5, BCOND_EQ as u8, arg_4, arg_3)
    bir_desvia(c as ^BirCtx, op_vreg(eh_minimo, BC_I8 as u8), frio, segue)
    var tern_1: str = "divisao"
    if common.c2f_b2i32(k.resto) != 0 {
        tern_1 = "resto"
    }
    let lit_1: [2]BirOperando = {k.a, k.b}
    bir_frio_estouro(c as ^BirCtx, frio, tern_1, lit_1)
    let ptr_1: ^BirCtx = c as ^BirCtx
    ptr_1.cur = segue
}

// C: nativo/bir/bir_construir_divisao.c:97
proc caminho_menos_um(k: ^Conta) {
    let falha_em_dev: bool = (((k.c as ^BirCtx).p as ^BirPrograma).modo == (BM_DEV as u8)) and ((not k.resto) or ((k.classe as i32) >= BC_I32))
    if falha_em_dev {
        testar_minimo(k)
    }
    if k.resto {
        zerar(k)
    } else {
        let arg_1: BirPedido = BirPedido{op = BIR_SUB as u8, dst = k.dst, a = op_imed(0, k.classe), b = k.a}
        let arg_2: ^BirCtx = k.c as ^BirCtx
        _ = bir_emitir_pedido(arg_2, arg_1)
    }
}

// C: nativo/bir/bir_construir_divisao.c:109
proc divisao_sem_sinal(k: ^Conta, op: i32) {
    let c: ?^BirCtx = k.c
    let zero: u32 = bir_novo_bloco(c as ^BirCtx, false)
    let calcula: u32 = bir_novo_bloco(c as ^BirCtx, false)
    let arg_1: BirOperando = op_imed(0, k.classe)
    let arg_2: BirOperando = k.b
    let arg_3: ^BirCtx = c as ^BirCtx
    let nao_zero: u32 = bir_comparar(arg_3, BCOND_NE as u8, arg_2, arg_1)
    bir_desvia(c as ^BirCtx, op_vreg(nao_zero, BC_I8 as u8), calcula, zero)
    bloco_de_zero(k, zero)
    bloco_da_conta(k, calcula, op)
    let ptr_1: ^BirCtx = c as ^BirCtx
    ptr_1.cur = k.fim
}

// C: nativo/bir/bir_construir_divisao.c:122
proc divisao_com_sinal(k: ^Conta, op: i32) {
    let c: ?^BirCtx = k.c
    let zero: u32 = bir_novo_bloco(c as ^BirCtx, false)
    let testa: u32 = bir_novo_bloco(c as ^BirCtx, false)
    let menos_um: u32 = bir_novo_bloco(c as ^BirCtx, false)
    let calcula: u32 = bir_novo_bloco(c as ^BirCtx, false)
    let arg_1: BirOperando = op_imed(0, k.classe)
    let arg_2: BirOperando = k.b
    let arg_3: ^BirCtx = c as ^BirCtx
    let eh_zero: u32 = bir_comparar(arg_3, BCOND_EQ as u8, arg_2, arg_1)
    var eh_menos_um: u32 = 0
    bir_desvia(c as ^BirCtx, op_vreg(eh_zero, BC_I8 as u8), zero, testa)
    bloco_de_zero(k, zero)
    let ptr_1: ^BirCtx = c as ^BirCtx
    ptr_1.cur = testa
    let arg_4: BirOperando = op_imed(-1, k.classe)
    let arg_5: BirOperando = k.b
    let arg_6: ^BirCtx = c as ^BirCtx
    eh_menos_um = bir_comparar(arg_6, BCOND_EQ as u8, arg_5, arg_4)
    bir_desvia(c as ^BirCtx, op_vreg(eh_menos_um, BC_I8 as u8), menos_um, calcula)
    let ptr_2: ^BirCtx = c as ^BirCtx
    ptr_2.cur = menos_um
    caminho_menos_um(k)
    bir_salta(c as ^BirCtx, k.fim)
    bloco_da_conta(k, calcula, op)
    let ptr_3: ^BirCtx = c as ^BirCtx
    ptr_3.cur = k.fim
}

// C: nativo/bir/bir_construir_divisao.c:142
proc divisor_imediato(k: ^Conta, op: i32) {
    if k.b.imed == 0 {
        zerar(k)
    } else if (not k.sem_sinal) and (k.b.imed == -1) {
        caminho_menos_um(k)
    } else {
        emitir_op(k, op)
    }
}

// C: nativo/bir/bir_construir_divisao.c:152
proc divisao(k: ^Conta) {
    var tern_1: i32 = BIR_DIV
    if common.c2f_b2i32(k.resto) != 0 {
        tern_1 = BIR_REM
    }
    let op: i32 = tern_1
    if k.b.tipo == (BO_IMED as u8) {
        divisor_imediato(k, op)
        return
    }
    k.fim = bir_novo_bloco(k.c as ^BirCtx, false)
    if k.sem_sinal {
        divisao_sem_sinal(k, op)
    } else {
        divisao_com_sinal(k, op)
    }
}

// C: nativo/bir/bir_construir_divisao.c:167
proc eh_deslocamento(op: u8) -> bool {
    return (op == (frontend.OP_DESLOCA_ESQ as u8)) or (op == (frontend.OP_DESLOCA_DIR as u8))
}

// C: nativo/bir/bir_construir_divisao.c:173
proc bir_regra_divisao(c: ^BirCtx, i: ^ir.IrInstr) -> bool {
    var ab: [2]BirOperando = {BirOperando{}, BirOperando{}}
    var k: Conta = Conta{c = c, i = i, sem_sinal = semantic.tipo_eh_sem_sinal(i.a.tipo), resto = (i.op_aux as i32) == frontend.OP_RESTO}
    if (not bir_operando_de(c, i, &i.a, &ab[0])) or (not bir_operando_de(c, i, &i.b, &ab[1])) {
        return false
    }
    // a / b de real e a conta direta, sem a guarda do divisor
    if bir_classe_eh_real(ab[0].classe as i32) {
        return bir_conta_real(c, i, ab)
    }
    if not bir_definir_destino(c, ab[0].classe, &k.dst) {
        return false
    }
    k.a = ab[0]
    k.b = ab[1]
    k.classe = ab[0].classe
    if eh_deslocamento(i.op_aux) {
        deslocamento(&k)
    } else {
        divisao(&k)
    }
    return true
}

// Valores conferidos com a LarguraEmBits do C (bir_construir_divisao.c:25)
test "largura_em_bits" {
    expect(largura_em_bits(BC_I8 as u8) == 8)
    expect(largura_em_bits(BC_I16 as u8) == 16)
    expect(largura_em_bits(BC_I32 as u8) == 32)
    expect(largura_em_bits(BC_I64 as u8) == 64)
    expect(largura_em_bits(BC_F64 as u8) == 64)
}
