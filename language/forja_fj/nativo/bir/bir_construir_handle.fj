import "common"
import "ir"

// C: nativo/bir/bir_construir_handle.c:11
proc handle_em_vreg(c: ^BirCtx, i: ^ir.IrInstr, saida: ^BirOperando) -> bool {
    return (common.c2f_b2i32(bir_inteiro64(c, i, &i.a, saida)) != 0) and (common.c2f_b2i32(bir_operando_vreg(c, saida^, saida)) != 0)
}

// C: nativo/bir/bir_construir_handle.c:17
proc texto_do_nome(c: ^BirCtx, nome: i32) -> BirOperando {
    if nome < 0 {
        return op_imed(0, BC_I64 as u8)
    }
    let arg_1: u32 = common.interner_tam((c.e as ^BirEntrada).nomes as ^common.Interner, nome)
    let arg_2: str = common.interner_texto((c.e as ^BirEntrada).nomes as ^common.Interner, nome)
    let arg_3: ^BirCtx = c
    return op_vreg(bir_vreg_do_texto(arg_3, arg_2, arg_1), BC_I64 as u8)
}

// C: nativo/bir/bir_construir_handle.c:25
proc bir_regra_handle_nasce(c: ^BirCtx, i: ^ir.IrInstr) -> bool {
    if (c.p as ^BirPrograma).modo != (BM_DEV as u8) {
        return true
    }
    var handle: BirOperando = BirOperando{}
    if not handle_em_vreg(c, i, &handle) {
        return false
    }
    let args: []BirOperando = arena_fatia_bir_operando(&(c.p as ^BirPrograma).arena, 4)
    args[0] = texto_do_nome(c, i.nome)
    args[1] = handle
    args[2] = op_imed(i.op_aux as i64, BC_I32 as u8)
    var nome_b: i32 = -1
    if i.b.tipo_no == (ir.V_TEXTO as u8) {
        nome_b = i.b.id
    }
    args[3] = texto_do_nome(c, nome_b)
    chamar_runtime(c, "forja_handle_nasce", args)
    return true
}

// C: nativo/bir/bir_construir_handle.c:44
proc bir_regra_lib_encerra(c: ^BirCtx, i: ^ir.IrInstr) -> bool {
    if (c.p as ^BirPrograma).modo != (BM_DEV as u8) {
        return true
    }
    let args: []BirOperando = arena_fatia_bir_operando(&(c.p as ^BirPrograma).arena, 1)
    args[0] = texto_do_nome(c, i.nome)
    chamar_runtime(c, "forja_libmem_encerrou", args)
    return true
}

// C: nativo/bir/bir_construir_handle.c:57
proc bir_regra_handle_solta(c: ^BirCtx, i: ^ir.IrInstr) -> bool {
    if (c.p as ^BirPrograma).modo != (BM_DEV as u8) {
        return true
    }
    var handle: BirOperando = BirOperando{}
    if not handle_em_vreg(c, i, &handle) {
        return false
    }
    let args: []BirOperando = arena_fatia_bir_operando(&(c.p as ^BirPrograma).arena, 1)
    args[0] = handle
    chamar_runtime(c, "forja_handle_solta", args)
    return true
}
