import "common"
import "ir"
import "semantic"

// C: nativo/bir/bir_construir_soa_mapa_valor.c:9
// C2F: o C grava em saida[2] por ponteiro; a Forja passa os dois campos por ^ (a copia por valor perdia a escrita)
proc arquivo_e_linha_4(c: ^BirCtx, i: ^ir.IrInstr, arquivo: ^BirOperando, linha: ^BirOperando) {
    var numero: u32 = 0
    arquivo^ = bir_vreg_do_arquivo(c, i.pos, &numero)
    linha^ = op_imed(numero as i64, BC_I32 as u8)
}

// C: nativo/bir/bir_construir_soa_mapa_valor.c:18
proc chave_eh_por_valor(c: ^BirCtx, r: ^MapaRef) -> bool {
    let inteira: bool = ((((r.chave == (semantic.TIPO_I32 as u32)) or (r.chave == (semantic.TIPO_U32 as u32))) or (r.chave == (semantic.TIPO_INT as u32))) or (r.chave == (semantic.TIPO_UINT as u32))) or (common.c2f_s2u_32(semantic.tipo_classe_de((c.e as ^BirEntrada).tipos as ^semantic.Tipos, r.chave)) == (semantic.TC_ENUM as u32))
    return ((not r.texto) and (common.c2f_b2i32(inteira) != 0)) and ((r.forma_chave.tam == 4) or (r.forma_chave.tam == 8))
}

// C: nativo/bir/bir_construir_soa_mapa_valor.c:27
proc chamar_mapa_por_valor(c: ^BirCtx, p: ^PedidoMapa, resultado: ^u32) -> bool {
    let instr: ^ir.IrInstr = p.i as ^ir.IrInstr
    let mapa: ^MapaRef = p.mapa as ^MapaRef
    let servico: ^ServicoMapa = p.servico as ^ServicoMapa
    var nargs: u32 = 4
    var k: u32 = 2
    if servico.com_valor {
        nargs = 5
    }
    let args: []BirOperando = arena_fatia_bir_operando(&(c.p as ^BirPrograma).arena, nargs as int)
    var funcao: ?str = servico.funcao_k4
    if mapa.forma_chave.tam == 8 {
        funcao = servico.funcao_k8
    }
    var chave: BirOperando = BirOperando{}
    if (not bir_operando_de(c, p.i, &instr.b, &chave)) or (not bir_operando_vreg(c, chave, &chave)) {
        return false
    }
    args[0] = op_vreg(mapa.endereco, BC_I64 as u8)
    args[1] = chave
    if servico.com_valor {
        args[2] = op_imed(mapa.forma_valor.tam as i64, BC_I64 as u8)
        k = 3
    }
    arquivo_e_linha_4(c, instr, &args[k], &args[k + 1])
    var dst: u32 = BIR_SEM_VREG
    if (servico.retorno as i32) != BC_NADA {
        dst = bir_novo_vreg(c, servico.retorno)
    }
    let chama: ^BirInstr = bir_emitir(c, BIR_CHAMA, servico.retorno)
    chama.simbolo = bir_simbolo_runtime(c, funcao)
    chama.dst = dst
    chama.args = args
    chama.nargs = nargs
    resultado^ = dst
    return true
}
