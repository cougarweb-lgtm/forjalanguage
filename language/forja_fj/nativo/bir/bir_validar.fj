// C: nativo/bir/bir_validar.c:48
proc reprova(v: ^Validador, causa: str) -> bool {
    var tern_1: u32 = 0
    if (v.i != none) and ((v.i as ^BirInstr).pos != BIR_SEM_POS) {
        tern_1 = (v.i as ^BirInstr).pos
    }
    let txt_1 = (v.p as ^BirPrograma).simbolos[(v.f as ^BirFuncao).simbolo].nome or_else "(null)"
    let msg_1 = format(f"BIR invalida na funcao {txt_1}: {causa}", alloc = heap)
    defer delete(msg_1)
    return common.diag_relatar(v.erro as ^common.Diag, common.X0904, tern_1, msg_1)
}

