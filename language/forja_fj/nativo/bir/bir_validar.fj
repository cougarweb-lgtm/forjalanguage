// C: nativo/bir/bir_validar.c:70
proc operando_valido(v: ^Validador, o: ^BirOperando) -> bool {
    if agregado_invalido(o) {
        return false
    }
    if o.tipo == (BO_VREG as u8) {
        return (o.id < (v.f as ^BirFuncao).nvregs) and ((((v.f as ^BirFuncao).classe_vreg or_else {})[o.id] as i32) == (o.classe as i32))
