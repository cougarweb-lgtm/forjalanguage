import "common"
import "ir"
import "semantic"

const SAIDA_COM_ERRO: i32 = 1
const SAIDA_SEM_ERRO: i32 = 0

// C: nativo/bir/bir_construir_resultado.c:22
proc indice_da_parte(parte: i32, tem_valor: bool) -> u32 {
    var tern_1: u32 = common.c2f_s2u_32(parte)
    if (common.c2f_s2u_32(parte) == (RES_PARTE_ERRO as u32)) and (not tem_valor) {
        tern_1 = 1
    }
    return tern_1
}

// C: nativo/bir/bir_construir_resultado.c:27
proc tipo_da_parte(t: ^semantic.TipoInfo, parte: i32) -> u32 {
    let sw_1 = common.c2f_s2u_32(parte)
    if sw_1 == (RES_PARTE_FLAG as u32) {
        return semantic.TIPO_BOOL as u32
    } else if sw_1 == (RES_PARTE_VALOR as u32) {
        return t.a
    } else {
        return t.b
    }
    return 0
}

// C: nativo/bir/bir_construir_resultado.c:36
proc bir_parte_do_resultado(c: ^BirCtx, resultado: u32, parte: i32, info: ^BirCampoInfo) -> bool {
    let tipos: ?^semantic.Tipos = (c.e as ^BirEntrada).tipos
    let t: ^semantic.TipoInfo = semantic.tipo_de(tipos as ^semantic.Tipos, resultado)
    let tem_valor: bool = common.c2f_s2u_32(semantic.tipo_classe_de(tipos as ^semantic.Tipos, t.a)) != (semantic.TC_VAZIO as u32)
    let indice: u32 = indice_da_parte(parte, tem_valor)
    let tipo: u32 = tipo_da_parte(t, parte)
    if common.c2f_s2u_32(semantic.tipo_classe_de(tipos as ^semantic.Tipos, resultado)) != (semantic.TC_RESULTADO as u32) {
        return bir_falha_inconsistente(c, "parte de resultado pedida a um tipo que nao e T ! E")
    }
    if (common.c2f_s2u_32(parte) == (RES_PARTE_VALOR as u32)) and (not tem_valor) {
        return bir_falha_inconsistente(c, "valor de um resultado sem T")
    }
    info^ = BirCampoInfo{offset = ir.layout_offset_campo(bir_layouts(c), resultado, indice), tipo = tipo}
    return true
}

// C: nativo/bir/bir_construir_resultado.c:53
proc bir_slot_do_destino(c: ^BirCtx, i: ^ir.IrInstr, base: ^u32) -> bool {
    var pedido: BirPedidoSlot = BirPedidoSlot{temporario = true, id = i.destino}
    return (common.c2f_b2i32(bir_forma(c, i.tipo, &pedido.forma)) != 0) and (common.c2f_b2i32(bir_definir_slot(c, &pedido, base)) != 0)
}

// C: nativo/bir/bir_construir_resultado.c:62
proc bir_regra_res_ok(c: ^BirCtx, i: ^ir.IrInstr) -> bool {
    var valor: BirCampoInfo = BirCampoInfo{}
    var base: u32 = 0
    if not bir_slot_do_destino(c, i, &base) {
        return false
    }
    bir_emitir_grava(c, base, 0, op_imed(0, BC_I8 as u8))
    if i.a.tipo_no == (ir.V_NENHUM as u8) {
        return true
    }
    if not bir_parte_do_resultado(c, i.tipo, RES_PARTE_VALOR, &valor) {
        return false
    }
    var lit_1 = BirAlvoMem{base = base, offset = valor.offset, tipo = valor.tipo}
    let arg_1: ^ir.Valor = &i.a
    let arg_2: ^BirAlvoMem = &lit_1
    let arg_3: ^ir.IrInstr = i
    let arg_4: ^BirCtx = c
    return bir_gravar_em(arg_4, arg_3, arg_2, arg_1)
}

// C: nativo/bir/bir_construir_resultado.c:77
proc bir_regra_res_erro(c: ^BirCtx, i: ^ir.IrInstr) -> bool {
    var erro: BirCampoInfo = BirCampoInfo{}
    var base: u32 = 0
    if (not bir_slot_do_destino(c, i, &base)) or (not bir_parte_do_resultado(c, i.tipo, RES_PARTE_ERRO, &erro)) {
        return false
    }
    bir_emitir_grava(c, base, 0, op_imed(1, BC_I8 as u8))
    var lit_1 = BirAlvoMem{base = base, offset = erro.offset, tipo = erro.tipo}
    let arg_1: ^ir.Valor = &i.a
    let arg_2: ^BirAlvoMem = &lit_1
    let arg_3: ^ir.IrInstr = i
    let arg_4: ^BirCtx = c
    return bir_gravar_em(arg_4, arg_3, arg_2, arg_1)
}

// C: nativo/bir/bir_construir_resultado.c:89
proc ler_parte_agregada(c: ^BirCtx, i: ^ir.IrInstr, base: u32, parte: ^BirCampoInfo) -> bool {
    var pedido: BirPedidoSlot = BirPedidoSlot{temporario = true, id = i.destino}
    var dst: u32 = 0
    if (not bir_forma(c, parte.tipo, &pedido.forma)) or (not bir_definir_slot(c, &pedido, &dst)) {
        return false
    }
    let arg_1: u32 = pedido.forma.tam
    let arg_2: u32 = bir_endereco_mais(c, base, parte.offset)
    let arg_3: u32 = dst
    let arg_4: ^BirCtx = c
    bir_copia_bloco(arg_4, arg_3, arg_2, arg_1)
    return true
}

// C: nativo/bir/bir_construir_resultado.c:101
proc bir_temp_do_campo(c: ^BirCtx, i: ^ir.IrInstr, agregado: u32, membro: ^BirCampoInfo) -> bool {
    var classe: u8 = BC_NADA as u8
    var dst: u32 = 0
    if bir_eh_agregado((c.e as ^BirEntrada).tipos as ^semantic.Tipos, membro.tipo) {
        return ler_parte_agregada(c, i, agregado, membro)
    }
    if not bir_classe_do_tipo((c.e as ^BirEntrada).tipos as ^semantic.Tipos, membro.tipo, &classe) {
        return bir_falha_tipo(c, i, "-", membro.tipo)
    }
    if not bir_definir_destino(c, classe, &dst) {
        return false
    }
    bir_emitir_carrega(c, dst, agregado, transmute(membro.offset, to = i32))
    return true
}

// C: nativo/bir/bir_construir_resultado.c:116
proc ler_parte(c: ^BirCtx, i: ^ir.IrInstr, parte: i32) -> bool {
    var info: BirCampoInfo = BirCampoInfo{}
    var base: u32 = 0
    if (not bir_endereco_de(c, i, &i.a, &base)) or (not bir_parte_do_resultado(c, i.a.tipo, parte, &info)) {
        return false
    }
    return bir_temp_do_campo(c, i, base, &info)
}

// C: nativo/bir/bir_construir_resultado.c:126
proc bir_regra_res_e_erro(c: ^BirCtx, i: ^ir.IrInstr) -> bool {
    return ler_parte(c, i, RES_PARTE_FLAG)
}

// C: nativo/bir/bir_construir_resultado.c:131
proc bir_regra_res_valor(c: ^BirCtx, i: ^ir.IrInstr) -> bool {
    return ler_parte(c, i, RES_PARTE_VALOR)
}

// C: nativo/bir/bir_construir_resultado.c:136
proc bir_regra_res_erro_de(c: ^BirCtx, i: ^ir.IrInstr) -> bool {
    return ler_parte(c, i, RES_PARTE_ERRO)
}

// C: nativo/bir/bir_construir_resultado.c:144
proc relatar_erro_de_main(c: ^BirCtx, base: u32, offset_erro: u32) {
    let fonte: ^common.Fonte = (c.e as ^BirEntrada).fonte as ^common.Fonte
    let arquivo: str = fonte.caminho or_else ""
    var um: BirOperando = op_imed(SAIDA_COM_ERRO as i64, BC_I32 as u8)
    let erro: u32 = bir_novo_vreg(c, BC_I32 as u8)
    bir_emitir_carrega(c, erro, base, offset_erro as i32)
    var args: [2]BirOperando = {BirOperando{}, BirOperando{}}
    args[0] = op_vreg(bir_vreg_do_texto(c, arquivo, (len(arquivo) as u64) as u32), BC_I64 as u8)
    args[1] = op_vreg(erro, BC_I32 as u8)
    chamar_runtime(c, "forja_main_erro", args[..])
    bir_retorna(c, &um)
}

// C: nativo/bir/bir_construir_resultado.c:162
proc bir_main_resultado(c: ^BirCtx) -> bool {
    var forma: BirSlot = BirSlot{}
    var erro: BirCampoInfo = BirCampoInfo{}
    var zero: BirOperando = op_imed(SAIDA_SEM_ERRO as i64, BC_I32 as u8)
    var base: u32 = 0
    var flag: u32 = 0
    var falha: u32 = 0
    var ok: u32 = 0
    var chama: ?^BirInstr = none
    if (not bir_forma(c, c.main_tipo, &forma)) or (not bir_parte_do_resultado(c, c.main_tipo, RES_PARTE_ERRO, &erro)) {
        return false
    }
    let arg_1: u32 = bir_novo_vreg(c, BC_I64 as u8)
    let arg_2: u32 = bir_novo_slot(c, forma.tam, forma.alinhamento)
    let arg_3: ^BirCtx = c
    base = bir_emitir_end_slot(arg_3, arg_2, arg_1)
    chama = bir_emitir(c, BIR_CHAMA, BC_NADA as u8)
    let ptr_1: ^BirInstr = chama as ^BirInstr
    ptr_1.simbolo = c.main_simbolo
    let ptr_2: ^BirInstr = chama as ^BirInstr
    ptr_2.a = op_vreg(base, BC_I64 as u8)
    let ptr_3: ^BirInstr = chama as ^BirInstr
    ptr_3.a.tam = forma.tam
    flag = bir_novo_vreg(c, BC_I8 as u8)
    bir_emitir_carrega(c, flag, base, 0)
    falha = bir_novo_bloco(c, true)
    ok = bir_novo_bloco(c, false)
    bir_desvia(c, op_vreg(flag, BC_I8 as u8), falha, ok)
    c.cur = falha
    relatar_erro_de_main(c, base, erro.offset)
    c.cur = ok
    bir_retorna(c, &zero)
    return true
}
