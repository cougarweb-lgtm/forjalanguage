struct DebugEntrada {
    mascara: u32
    versao: ?str
    modo: ?str
    alvo: ?str
    fonte: ?^common.Fonte
    bir: ?^[dynamic]u8
    otim: ?^[dynamic]u8
    passes: ?^[dynamic]u8
    locais: ?^[dynamic]u8
    dbg: ?^dbg.DbgPrograma
    lista: ?^x64.AlvoListagem
    codigo: ?^obj.Objeto
    runtime: ?^obj.Objeto
    imagem: ?^pefmt.Imagem
    tempos: ?^NativoTempos
    tam_exe: u64
    procs_total: u32
    procs_gerados: u32
    pedido: ?^NativoPedido
    programa: ?^bir.BirPrograma
}

struct RegLinhas {
    dbg: ?^dbg.DbgPrograma
    proc_c: ?^dbg.DbgProc
    fonte: ?^common.Fonte
}

struct RegCabecalho {
    forja: ?str
    alvo: ?str
    modo: ?str
}

struct RegFuncao {
    nome: ?str
    arquivo: ?str
    rva: u32
    inicio: u32
    tamanho: u32
    linha: u32
    quadro: ?^x64.ListaFuncao
}

struct RegInstr {
    funcao: ?str
    texto_asm: ?str
    simbolo: ?str
    arquivo: ?str
    bytes: ?^u8
    rva: u32
    deslocamento: u32
    tam: u32
    bloco: u32
    indice: u32
    linha: u32
    coluna: u32
    origem: u8
}

struct RegBir {
    funcao: ?str
    texto: ?str
    tam: u64
}

struct RegReloc {
    secao: ?str
    kind: ?str
    simbolo: ?str
    offset: u32
    rva: u32
    adendo: i64
}

struct RegSecao {
    nome: ?str
    rva: u32
    tam_virtual: u32
    tam_bruto: u32
    caracteristicas: u32
}

struct RegImport {
    dll: ?str
    nome: ?str
    iat_rva: u32
    descritor: u32
}

struct RegFormato {
    forja: ?str
    imagem_base: u64
    entrada_rva: u32
    tam_arquivo: u64
    linker_maior: u8
    linker_menor: u8
    elf: bool
}

struct RegSegmento {
    tipo: ?str
    flags: ?str
    offset: u64
    vaddr: u64
    filesz: u64
    memsz: u64
    alinhamento: u64
}

struct RegFaixa {
    rva: u32
    tamanho: u32
    origem: ?str
}

struct RegTempos {
    tempos: ?^NativoTempos
}

struct RegExport {
    nome: ?str
    rva: u32
    ordinal: u32
}

struct RegPoda {
    procs_total: u32
    procs_gerados: u32
}

struct DebugReg {
    tipo: u8
    cabecalho: RegCabecalho
    funcao: RegFuncao
    instr: RegInstr
    bir: RegBir
    reloc: RegReloc
    secao: RegSecao
    import_c: RegImport
    formato: RegFormato
    faixa: RegFaixa
    tempos: RegTempos
    exporta: RegExport
    poda: RegPoda
    segmento: RegSegmento
    linhas: RegLinhas
    otim: RegBir
    texto_interface: RegBir
    texto_perfil: RegBir
    texto_passes: RegBir
}

struct ItemDebug {
    nome: ?str
    bit: u32
}

struct Percurso {
    e: ?^DebugEntrada
    escrever: u16
    estado: rawptr // C2F-VOID
    texto: ?^pefmt.PeSecao
}

struct PosicaoFonte {
    arquivo: ?str
    linha: u32
    coluna: u32
}

const REG_CABECALHO: i32 = 0
const REG_FUNCAO: i32 = 1
const REG_INSTR: i32 = 2
const REG_BIR: i32 = 3
const REG_RELOC: i32 = 4
const REG_SECAO: i32 = 5
const REG_IMPORT: i32 = 6
const REG_FORMATO: i32 = 7
const REG_FAIXA: i32 = 8
const REG_TEMPOS: i32 = 9
const REG_EXPORT: i32 = 10
const REG_PODA: i32 = 11
const REG_SEGMENTO: i32 = 12
const REG_LOCAIS: i32 = 13
const REG_LINHAS: i32 = 14
const REG_OTIM: i32 = 15
const REG_INTERFACE: i32 = 16
const REG_PERFIL: i32 = 17
const REG_PASSES: i32 = 18
const DEBUG_BIR: u32 = 1
const DEBUG_ASM: u32 = 2
const DEBUG_QUADROS: u32 = 4
const DEBUG_RELOC: u32 = 8
const DEBUG_FORMATO: u32 = 16
const DEBUG_TEMPOS: u32 = 32
const DEBUG_JSON: u32 = 64
const DEBUG_LOCAIS: u32 = 128
const DEBUG_LINHAS: u32 = 256
const DEBUG_OTIM: u32 = 512
const DEBUG_INTERFACE: u32 = 1024
const DEBUG_PERFIL: u32 = 2048
const DEBUG_PASSES: u32 = 4096
const DEBUG_TODOS_ITENS: u32 = 63
const DEBUG_VERSAO: str = "0.7.0"
// C2F-82 macro DEBUG_QTD_ITENS = ( sizeof ITENS / sizeof ITENS [ 0 ] )  (expandida no uso)
const DEBUG_TAM_NOME_BIR: i32 = 256
// C2F:? tabela ITENS (const ItemDebug[13]): ponteiro nao nulo
// C2F:? tabela NOMES (const char *const[5]): folha {'s': 'prologo'} para ^u8
// C2F:? tabela TIPOS (const char *const[3]): folha {'s': 'REL32'} para ^u8
// C2F:? tabela FLAGS (const char *const[8]): folha {'s': ''} para ^u8

pub const DEBUG_ESCRITOR_ESCREVER_JSON: u16 = 1
pub const DEBUG_ESCRITOR_ESCREVER_TEXTO: u16 = 2
pub proc chamar_debug_escritor(tag: u16, estado: rawptr, reg: ^DebugReg) {
    if tag == 1 {
        escrever_json(estado, reg)
        return
    }
    if tag == 2 {
        escrever_texto(estado, reg)
        return
    }
    // C nao tem fallback: tag fora de JSON/TEXTO e defeito interno
    let msg_1 = format(f"debug: escritor de tag {tag} desconhecido", alloc = heap)
    defer delete(msg_1)
    common.falha_interna(msg_1)
}

// C: nativo/nativo_debug.c:40 (tabela ITENS: mesma ordem e mesmos bits; o item json tem o bit 64)
const NOMES_ITENS_DEBUG: [13]str = {"bir", "asm", "quadros", "reloc", "formato", "tempos", "json", "locais", "linhas", "otim", "interface", "perfil", "passes"}
const BITS_ITENS_DEBUG: [13]u32 = {1, 2, 4, 8, 16, 32, 64, 128, 256, 512, 1024, 2048, 4096}
const DEBUG_CARACTERE_VIRGULA: u8 = 44
const DEBUG_CARACTERE_PARENTESE: u8 = 40
const DEBUG_CARACTERE_QUEBRA: u8 = 10
const DEBUG_CARACTERE_NUL: u8 = 0

// C: nativo/nativo_debug.c:50 (o nome e o token inteiro, sem a virgula)
proc item_por_nome(nome: str, bit: ^u32) -> bool {
    for k in 0..<len(NOMES_ITENS_DEBUG) {
        if NOMES_ITENS_DEBUG[k] == nome {
            bit^ = BITS_ITENS_DEBUG[k]
            return true
        }
    }
    return false
}

// C: nativo/nativo_debug.c:61 (causa recebe a mensagem cortada em n bytes, como o snprintf do C)
proc debug_itens(lista: ?str, mascara: ^u32, causa: []u8, n: u64) -> bool {
    let bytes_lista: []u8 = as_bytes(lista or_else "")
    let total: int = len(bytes_lista)
    mascara^ = 0
    var p: int = 0
    while p < total {
        var fim: int = p
        while fim < total and bytes_lista[fim] != DEBUG_CARACTERE_VIRGULA {
            fim += 1
        }
        let token: str = from_bytes(bytes_lista[p..<fim], alloc = frame)
        var bit: u32 = 0
        if not item_por_nome(token, &bit) {
            let msg: str = format(f"item desconhecido em --debug-code: '{token}' (validos: bir,asm,quadros,reloc,formato,tempos,json,locais,linhas,otim,interface,perfil,passes)", alloc = frame)
            _ = common.c2f_snprintf(causa[0..<(n as int)], msg)
            return false
        }
        mascara^ = mascara^ | bit
        p = fim + 1
    }
    if mascara^ == DEBUG_JSON {
        mascara^ = mascara^ | DEBUG_TODOS_ITENS
    }
    return true
}

// C: nativo/nativo_debug.c:83
const NOMES_ORIGEM_DEBUG: [5]str = {"prologo", "sondagem", "codigo", "frio", "epilogo"}
proc debug_nome_origem(origem: u8) -> str {
    if (origem as u64) < (len(NOMES_ORIGEM_DEBUG) as u64) {
        return NOMES_ORIGEM_DEBUG[origem as u64]
    }
    return "?"
}

// C: nativo/nativo_debug.c:99
proc emitir(p: ^Percurso, reg: ^DebugReg) {
    chamar_debug_escritor(p.escrever, p.estado, reg)
}

// C: nativo/nativo_debug.c:104
proc achar_secao_da_imagem(im: ?^pefmt.Imagem, nome: str) -> ?^pefmt.PeSecao {
    for k in (0 as u32)..<(im as ^pefmt.Imagem).qtd_secoes {
        if common.c2f_prefixo_igual(((im as ^pefmt.Imagem).secoes[k].nome or_else ""), nome, 8) {
            return &(im as ^pefmt.Imagem).secoes[k]
        }
    }
    return none
}

// C: nativo/nativo_debug.c:113
proc tamanho_do_texto(o: ^obj.Objeto) -> u32 {
    for k in (0 as u64)..<(len(o.secoes) as u64) {
        let s: ^obj.ObjSecao = &o.secoes[k]
        if (s.nome or_else "") == ".text" {
            return (len(s.bytes) as u64) as u32
        }
    }
    return 0
}

// C: nativo/nativo_debug.c:130
proc posicao_de(fonte: ?^common.Fonte, pos: u32) -> PosicaoFonte {
    var r: PosicaoFonte = PosicaoFonte{arquivo = none, linha = 0, coluna = 0}
    var p: common.FontePosicao = common.FontePosicao{}
    if (pos == bir.BIR_SEM_POS) or (fonte == none) {
        return r
    }
    p = common.fonte_localizar_no_arquivo(fonte, pos)
    r.arquivo = p.caminho
    r.linha = p.linha
    r.coluna = p.coluna
    return r
}

// C: nativo/nativo_debug.c:144
proc percorrer_cabecalho(p: ^Percurso) {
    let e: ^DebugEntrada = p.e as ^DebugEntrada
    var reg: DebugReg = DebugReg{tipo = REG_CABECALHO as u8}
    reg.cabecalho = RegCabecalho{forja = e.versao, alvo = e.alvo, modo = e.modo}
    emitir(p, &reg)
}

// C: nativo/nativo_debug.c:151
proc percorrer_poda(p: ^Percurso) {
    let e: ^DebugEntrada = p.e as ^DebugEntrada
    var reg: DebugReg = DebugReg{tipo = REG_PODA as u8}
    reg.poda = RegPoda{procs_total = e.procs_total, procs_gerados = e.procs_gerados}
    emitir(p, &reg)
}

// C: nativo/nativo_debug.c:158 (o texto da tabela vai do offset ate o NUL)
proc nome_na_listagem(l: ^x64.AlvoListagem, offset: u32) -> str {
    let bytes: []u8 = l.textos[..]
    var fim: int = offset as int
    while fim < len(bytes) and bytes[fim] != DEBUG_CARACTERE_NUL {
        fim += 1
    }
    return from_bytes(bytes[(offset as int)..<fim], alloc = frame)
}

// C: nativo/nativo_debug.c:163
proc emitir_funcao(p: ^Percurso, f: ^x64.ListaFuncao) {
    let l: ?^x64.AlvoListagem = (p.e as ^DebugEntrada).lista
    var r: RegFuncao = RegFuncao{nome = nome_na_listagem(l as ^x64.AlvoListagem, f.nome), rva = (p.texto as ^pefmt.PeSecao).rva + f.inicio, inicio = f.inicio, tamanho = f.fim - f.inicio, quadro = f}
    var reg: DebugReg = DebugReg{tipo = REG_FUNCAO as u8}
    let pos: PosicaoFonte = posicao_de((p.e as ^DebugEntrada).fonte, f.pos)
    r.arquivo = pos.arquivo
    r.linha = pos.linha
    reg.funcao = r
    emitir(p, &reg)
}

// C: nativo/nativo_debug.c:178
proc emitir_instr(p: ^Percurso, f: ^x64.ListaFuncao, i: ^x64.ListaInstr) {
    let e: ^DebugEntrada = p.e as ^DebugEntrada
    let l: ^x64.AlvoListagem = e.lista as ^x64.AlvoListagem
    let secao: ^pefmt.PeSecao = p.texto as ^pefmt.PeSecao
    let pos: PosicaoFonte = posicao_de(e.fonte, i.pos)
    var simbolo: ?str = none
    if i.simbolo != 0 {
        simbolo = nome_na_listagem(l, i.simbolo - 1)
    }
    // os bytes da instrucao so existem se o offset cabe na secao; sem eles o registro sai sem bytes
    var bytes: ?^u8 = none
    if (i.tam > 0) and ((i.off as u64) < (len(secao.bytes) as u64)) {
        bytes = &secao.bytes[i.off as u64]
    }
    var reg: DebugReg = DebugReg{tipo = REG_INSTR as u8}
    reg.instr = RegInstr{funcao = nome_na_listagem(l, f.nome), texto_asm = nome_na_listagem(l, i.texto), simbolo = simbolo, arquivo = pos.arquivo, bytes = bytes, rva = secao.rva + i.off, deslocamento = i.off - f.inicio, tam = i.tam, bloco = i.bloco, indice = i.indice, linha = pos.linha, coluna = pos.coluna, origem = i.origem}
    emitir(p, &reg)
}

// C: nativo/nativo_debug.c:196 (faixa vazia nao emite)
proc emitir_faixa(p: ^Percurso, off: u32, tamanho: u32, origem: str) {
    if tamanho == 0 {
        return
    }
    let secao: ^pefmt.PeSecao = p.texto as ^pefmt.PeSecao
    var reg: DebugReg = DebugReg{tipo = REG_FAIXA as u8}
    reg.faixa = RegFaixa{rva = secao.rva + off, tamanho = tamanho, origem = origem}
    emitir(p, &reg)
}

// C: nativo/nativo_debug.c:205
proc percorrer_instrs(p: ^Percurso, k: u64, f: ^x64.ListaFuncao, proxima_instr: u64) -> u64 {
    var proxima_instr_v: u64 = proxima_instr
    let l: ?^x64.AlvoListagem = (p.e as ^DebugEntrada).lista
    while proxima_instr_v < (len((l as ^x64.AlvoListagem).instrs) as u64) {
        let i: ^x64.ListaInstr = &(l as ^x64.AlvoListagem).instrs[proxima_instr_v]
        if (i.funcao as u64) != k {
            break
        }
        if ((p.e as ^DebugEntrada).mascara & DEBUG_ASM) != 0 {
            emitir_instr(p, f, i)
        }
        proxima_instr_v += 1
    }
    return proxima_instr_v
}

// C: nativo/nativo_debug.c:221
proc percorrer_funcao(p: ^Percurso, k: u64, proxima_instr: u64, fim_programa: u32) -> u64 {
    var proxima_instr_v: u64 = proxima_instr
    let l: ?^x64.AlvoListagem = (p.e as ^DebugEntrada).lista
    let f: ^x64.ListaFuncao = &(l as ^x64.AlvoListagem).funcoes[k]
    var tern_1: ?^x64.ListaFuncao = none
    if (k + 1) < (len((l as ^x64.AlvoListagem).funcoes) as u64) {
        tern_1 = &(l as ^x64.AlvoListagem).funcoes[k + 1]
    }
    let seguinte: ?^x64.ListaFuncao = tern_1
    var tern_2: u32 = fim_programa
    if seguinte != none {
        tern_2 = (seguinte as ^x64.ListaFuncao).inicio
    }
    let limite: u32 = tern_2
    emitir_funcao(p, f)
    proxima_instr_v = percorrer_instrs(p, k, f, proxima_instr_v)
    if ((p.e as ^DebugEntrada).mascara & DEBUG_ASM) != 0 {
        emitir_faixa(p, f.fim, limite - f.fim, "preenchimento")
    }
    return proxima_instr_v
}

// C: nativo/nativo_debug.c:236
proc percorrer_faixas_do_runtime(p: ^Percurso, fim_programa: u32) {
    let inicio_runtime: u32 = ((p.e as ^DebugEntrada).imagem as ^pefmt.Imagem).runtime_texto_rva - (p.texto as ^pefmt.PeSecao).rva
    let tam_runtime: u32 = (p.texto as ^pefmt.PeSecao).tam_virtual - inicio_runtime
    emitir_faixa(p, fim_programa, inicio_runtime - fim_programa, "preenchimento")
    emitir_faixa(p, inicio_runtime, tam_runtime, "runtime")
}

// C: nativo/nativo_debug.c:245
proc percorrer_funcoes(p: ^Percurso) {
    let fim_programa: u32 = tamanho_do_texto((p.e as ^DebugEntrada).codigo as ^obj.Objeto)
    var proxima_instr: u64 = 0
    var k: u64 = 0
    while k < (len(((p.e as ^DebugEntrada).lista as ^x64.AlvoListagem).funcoes) as u64) {
        proxima_instr = percorrer_funcao(p, k, proxima_instr, fim_programa)
        k += 1
    }
    if ((p.e as ^DebugEntrada).mascara & DEBUG_ASM) != 0 {
        percorrer_faixas_do_runtime(p, fim_programa)
    }
}

// strncmp(s + pos, lit, len(lit)) == 0: texto que acaba antes do literal nao casa
proc comeca_com(s: str, pos: u64, lit: str) -> bool {
    let tam_lit: u64 = len(lit) as u64
    if pos + tam_lit > (len(s) as u64) {
        return false
    }
    var k: u64 = 0
    while k < tam_lit {
        if s[pos + k] != lit[k] {
            return false
        }
        k += 1
    }
    return true
}

// memchr(s + n, '\n', resto - n): tamanho ate depois da quebra; sem quebra, o resto (n e relativo ao trecho)
proc proximo_fim_de_linha(s: str, inicio: u64, n: u64, resto: u64) -> u64 {
    let bytes: []u8 = as_bytes(s)
    var k: u64 = n
    while k < resto {
        if bytes[inicio + k] == DEBUG_CARACTERE_QUEBRA {
            return k + 1
        }
        k += 1
    }
    return resto
}

// C: nativo/nativo_debug.c:257 (inicio e a posicao do trecho dentro do texto inteiro)
proc tamanho_do_trecho(s: str, inicio: u64) -> u64 {
    let resto: u64 = (len(s) as u64) - inicio
    var n: u64 = 0
    var seguir: bool = true
    while seguir {
        n = proximo_fim_de_linha(s, inicio, n, resto)
        seguir = (n < resto) and (not comeca_com(s, inicio + n, "funcao ")) and (not comeca_com(s, inicio + n, "simbolos:"))
    }
    return n
}

// C: nativo/nativo_debug.c:270 ("funcao fj_main(v0:i64) -> vazio" -> "fj_main"; sem "funcao " o nome sai vazio)
proc nome_do_trecho(s: str, inicio: u64) -> str {
    if not comeca_com(s, inicio, "funcao ") {
        return ""
    }
    let ini: u64 = inicio + 7
    let total: u64 = len(s) as u64
    var fim: u64 = ini
    while fim < total and ((fim - ini) + 1) < (DEBUG_TAM_NOME_BIR as u64) and s[fim] != DEBUG_CARACTERE_PARENTESE and s[fim] != DEBUG_CARACTERE_QUEBRA and s[fim] != DEBUG_CARACTERE_NUL {
        fim += 1
    }
    return from_bytes(as_bytes(s)[(ini as int)..<(fim as int)], alloc = frame)
}

// o texto do buffer de debug como str (copia no quadro do chamador)
proc debug_texto_do_buffer(b: ^[dynamic]u8) -> str {
    return from_bytes(b[..], alloc = frame)
}

// C: nativo/nativo_debug.c:284 (um registro por trecho "funcao ..." ou bloco; o texto vira str uma vez)
proc percorrer_trechos(p: ^Percurso, texto: ^[dynamic]u8, tipo: u8) {
    let todo: str = debug_texto_do_buffer(texto)
    let total: u64 = len(todo) as u64
    var pos: u64 = 0
    while pos < total {
        let n: u64 = tamanho_do_trecho(todo, pos)
        let nome: str = nome_do_trecho(todo, pos)
        let corpo: str = from_bytes(as_bytes(todo)[(pos as int)..<((pos + n) as int)], alloc = frame)
        var reg: DebugReg = DebugReg{tipo = tipo}
        reg.bir = RegBir{funcao = nome, texto = corpo, tam = n}
        emitir(p, &reg)
        pos += n
    }
}

// C: nativo/nativo_debug.c:302
proc percorrer_bir(p: ^Percurso) {
    percorrer_trechos(p, (p.e as ^DebugEntrada).bir as ^[dynamic]u8, REG_BIR as u8)
}

// C: nativo/nativo_debug.c:308
proc percorrer_linhas(p: ^Percurso) {
    let d: ?^dbg.DbgPrograma = (p.e as ^DebugEntrada).dbg
    var k: u64 = 0
    while (d != none) and (k < (len((d as ^dbg.DbgPrograma).procs) as u64)) {
        var reg: DebugReg = DebugReg{tipo = REG_LINHAS as u8}
        reg.linhas = RegLinhas{dbg = d, proc_c = &(d as ^dbg.DbgPrograma).procs[k], fonte = (p.e as ^DebugEntrada).fonte}
        emitir(p, &reg)
        k += 1
    }
}

// C: nativo/nativo_debug.c:320
const TIPOS_RELOC_DEBUG: [3]str = {"REL32", "ADDR64", "ADDR32NB"}
proc percorrer_reloc(p: ^Percurso) {
    let e: ^DebugEntrada = p.e as ^DebugEntrada
    let o: ^obj.Objeto = e.codigo as ^obj.Objeto
    var k: u64 = 0
    while k < (len(o.relocs) as u64) {
        let r: ^obj.ObjReloc = &o.relocs[k]
        let s: ^obj.ObjSecao = &o.secoes[r.alvo.secao as u64]
        let na_imagem: ?^pefmt.PeSecao = achar_secao_da_imagem(e.imagem, s.nome or_else "")
        var base_rva: u32 = 0
        if na_imagem != none {
            base_rva = (na_imagem as ^pefmt.PeSecao).rva
        }
        var reg: DebugReg = DebugReg{tipo = REG_RELOC as u8}
        reg.reloc = RegReloc{secao = s.nome, kind = TIPOS_RELOC_DEBUG[r.correcao.tipo as u64], simbolo = o.simbolos[r.correcao.simbolo as u64].nome, offset = r.alvo.off, rva = base_rva + r.alvo.off, adendo = r.correcao.adendo}
        emitir(p, &reg)
        k += 1
    }
}

// C: nativo/nativo_debug.c:337 (o nome da secao cabe em 8 bytes, como no C)
proc percorrer_secoes(p: ^Percurso) {
    let im: ^pefmt.Imagem = (p.e as ^DebugEntrada).imagem as ^pefmt.Imagem
    var k: u32 = 0
    while k < im.qtd_secoes {
        let s: ^pefmt.PeSecao = &im.secoes[k as u64]
        let nome_inteiro: str = s.nome or_else ""
        let corte: int = min(len(nome_inteiro), 8)
        var reg: DebugReg = DebugReg{tipo = REG_SECAO as u8}
        reg.secao = RegSecao{nome = from_bytes(as_bytes(nome_inteiro)[0..<corte], alloc = frame), rva = s.rva, tam_virtual = s.tam_virtual, tam_bruto = len(s.bytes) as u32, caracteristicas = s.caracteristicas}
        emitir(p, &reg)
        k += 1
    }
}

// C: nativo/nativo_debug.c:355
proc emitir_import(p: ^Percurso, imp: ^pefmt.ImagemImportacao, d: u32, k: u32) {
    var reg: DebugReg = DebugReg{tipo = REG_IMPORT as u8}
    reg.import_c = RegImport{dll = imp.dlls[d as u64].nome, nome = (imp.nomes or_else {})[k as u64], iat_rva = imp.iat_rva[k as u64], descritor = d}
    emitir(p, &reg)
}

// C: nativo/nativo_debug.c:362
proc percorrer_imports(p: ^Percurso) {
    let imp: ^pefmt.ImagemImportacao = &((p.e as ^DebugEntrada).imagem as ^pefmt.Imagem).importacao
    var d: u32 = 0
    while d < imp.qtd_dlls {
        let dll: ^pefmt.ImagemDll = &imp.dlls[d]
        for k in dll.primeiro..<(dll.primeiro + dll.qtd) {
            emitir_import(p, imp, d, k)
        }
        d += 1
    }
}

// C: nativo/nativo_debug.c:374 (ordinal = posicao na tabela + 1, base 1)
proc percorrer_exports(p: ^Percurso) {
    let im: ^pefmt.Imagem = (p.e as ^DebugEntrada).imagem as ^pefmt.Imagem
    var k: u64 = 0
    while k < (len(im.exportacoes) as u64) {
        let x: ^pefmt.PeExporta = &im.exportacoes[k]
        var reg: DebugReg = DebugReg{tipo = REG_EXPORT as u8}
        reg.exporta = RegExport{nome = x.nome, rva = x.rva, ordinal = (k as u32) + 1}
        emitir(p, &reg)
        k += 1
    }
}

// C: nativo/nativo_debug.c:387 (ELF: um registro por cabecalho de programa do plano que o escritor usou; PE: nada)
const FLAGS_SEGMENTO_DEBUG: [8]str = {"", "X", "W", "WX", "R", "RX", "RW", "RWX"}
proc percorrer_segmentos(p: ^Percurso) {
    let im: ^pefmt.Imagem = (p.e as ^DebugEntrada).imagem as ^pefmt.Imagem
    if im.formato != pefmt.IMAGEM_ELF {
        return
    }
    var plano: pefmt.ElfPlano = pefmt.ElfPlano{}
    let erro: ?str = pefmt.elf_planejar((p.e as ^DebugEntrada).imagem, &plano)
    if erro != none {
        return
    }
    var k: u32 = 0
    while k < plano.qtd {
        let s: ^pefmt.ElfSegmento = &plano.seg[k as u64]
        var tipo_seg: str = "GNU_STACK"
        if s.tipo == pefmt.ELF_PT_LOAD {
            tipo_seg = "LOAD"
        }
        var reg: DebugReg = DebugReg{tipo = REG_SEGMENTO as u8}
        reg.segmento = RegSegmento{tipo = tipo_seg, flags = FLAGS_SEGMENTO_DEBUG[(s.flags & 7) as u64], offset = s.offset, vaddr = s.vaddr, filesz = s.filesz, memsz = s.memsz, alinhamento = s.alinhamento}
        emitir(p, &reg)
        k += 1
    }
}

// C: nativo/nativo_debug.c:403
proc percorrer_formato(p: ^Percurso) {
    let e: ^DebugEntrada = p.e as ^DebugEntrada
    let im: ^pefmt.Imagem = e.imagem as ^pefmt.Imagem
    var reg: DebugReg = DebugReg{tipo = REG_FORMATO as u8}
    reg.formato = RegFormato{forja = e.versao, imagem_base = pefmt.pe_base_da_imagem(e.imagem), entrada_rva = im.entrada_rva, tam_arquivo = e.tam_exe, linker_maior = im.linker_maior, linker_menor = im.linker_menor, elf = im.formato == pefmt.IMAGEM_ELF}
    emitir(p, &reg)
    percorrer_secoes(p)
    percorrer_segmentos(p)
    percorrer_imports(p)
    percorrer_exports(p)
}

// C: nativo/nativo_debug.c:418 (o texto canonico da interface, o mesmo que o hash do forja_dll_info cobre)
proc percorrer_interface(p: ^Percurso) {
    let pedido: ^NativoPedido = (p.e as ^DebugEntrada).pedido as ^NativoPedido
    var saida: [dynamic]u8 = make([dynamic]u8, alloc = heap)
    defer delete(saida)
    backend.emitir_interface_dll(pedido.ir as ^ir.IrPrograma, pedido.tipos as ^semantic.Tipos, pedido.nomes as ^common.Interner, &saida)
    let conteudo: str = debug_texto_do_buffer(&saida)
    var reg: DebugReg = DebugReg{tipo = REG_INTERFACE as u8}
    reg.texto_interface = RegBir{funcao = "", texto = conteudo, tam = len(conteudo) as u64}
    emitir(p, &reg)
}

// C: nativo/nativo_debug.c:430 ("perfil: N procs instrumentadas" e "id nome" por proc de usuario; sem --perfil, so "desligado")
proc percorrer_perfil(p: ^Percurso) {
    let e: ^DebugEntrada = p.e as ^DebugEntrada
    let programa: ^bir.BirPrograma = e.programa as ^bir.BirPrograma
    var texto: [dynamic]u8 = make([dynamic]u8, alloc = heap)
    defer delete(texto)
    var nome: [512]u8 = {}
    var id: u32 = 0
    var i: u32 = 0
    while i < programa.nfuncoes and programa.perfil {
        let funcao: ^bir.BirFuncao = &(programa.funcoes or_else {})[i as u64]
        if optimizer.otim_perfil_proc(e.programa, funcao) {
            optimizer.otim_perfil_nome(e.programa, funcao, nome[..], 512)
            let nome_proc: str = from_bytes(nome[0..<(common.c2f_strlen_b(nome[..]) as int)], alloc = frame)
            format(f"{id} {nome_proc}\n", into = &texto)
            id += 1
        }
        i += 1
    }
    if programa.perfil {
        format(f"perfil: {id} procs instrumentadas\n", into = &texto)
    } else {
        append(&texto, items = as_bytes("perfil: desligado (use --perfil)\n"))
    }
    let conteudo: str = debug_texto_do_buffer(&texto)
    var reg: DebugReg = DebugReg{tipo = REG_PERFIL as u8}
    reg.texto_perfil = RegBir{funcao = "", texto = conteudo, tam = len(conteudo) as u64}
    emitir(p, &reg)
}

// C: nativo/nativo_debug.c:454
proc percorrer_funcoes_pedidas(p: ^Percurso) {
    if (((p.e as ^DebugEntrada).mascara & (DEBUG_ASM | DEBUG_QUADROS)) != 0) and (p.texto != none) {
        percorrer_funcoes(p)
    }
}

// C: nativo/nativo_debug.c:460
// C2F-VOID: estado
proc debug_percorrer(e: ^DebugEntrada, escrever: u16, estado: rawptr) {
    var p: Percurso = Percurso{e = e, escrever = escrever, estado = estado, texto = none}
    if e.imagem != none {
        p.texto = achar_secao_da_imagem(e.imagem, ".text")
    }
    percorrer_cabecalho(&p)
    percorrer_poda(&p)
    percorrer_funcoes_pedidas(&p)
    if (e.mascara & DEBUG_BIR) != 0 {
        percorrer_bir(&p)
    }
    if (e.mascara & DEBUG_LOCAIS) != 0 {
        percorrer_trechos(&p, e.locais as ^[dynamic]u8, REG_LOCAIS as u8)
    }
    if (e.mascara & DEBUG_LINHAS) != 0 {
        percorrer_linhas(&p)
    }
    if ((e.mascara & DEBUG_OTIM) != 0) and (e.otim != none) {
        var reg: DebugReg = DebugReg{tipo = REG_OTIM as u8}
        let conteudo: str = debug_texto_do_buffer(e.otim as ^[dynamic]u8)
        reg.otim = RegBir{funcao = "", texto = conteudo, tam = len(conteudo) as u64}
        emitir(&p, &reg)
    }
    if ((e.mascara & DEBUG_PASSES) != 0) and (e.passes != none) {
        var reg: DebugReg = DebugReg{tipo = REG_PASSES as u8}
        let conteudo: str = debug_texto_do_buffer(e.passes as ^[dynamic]u8)
        reg.texto_passes = RegBir{funcao = "", texto = conteudo, tam = len(conteudo) as u64}
        emitir(&p, &reg)
    }
    if ((e.mascara & DEBUG_INTERFACE) != 0) and (e.pedido != none) {
        percorrer_interface(&p)
    }
    if ((e.mascara & DEBUG_PERFIL) != 0) and (e.programa != none) {
        percorrer_perfil(&p)
    }
    if (e.mascara & DEBUG_RELOC) != 0 {
        percorrer_reloc(&p)
    }
    if (e.mascara & DEBUG_FORMATO) != 0 {
        percorrer_formato(&p)
    }
    if (e.mascara & DEBUG_TEMPOS) != 0 {
        var reg: DebugReg = DebugReg{tipo = REG_TEMPOS as u8}
        reg.tempos = RegTempos{tempos = e.tempos}
        emitir(&p, &reg)
    }
}

// testes: valores conferidos a mao contra nativo_debug.c (json sozinho ganha todos os itens = 127)
test "debug_itens monta a mascara e json completa os itens" {
    var mascara: u32 = 0
    var causa: [96]u8 = {}
    expect(debug_itens("bir,asm", &mascara, causa[..], 96))
    expect(mascara == 3)
    expect(debug_itens("json", &mascara, causa[..], 96))
    expect(mascara == 127)
}

test "debug_itens recusa item desconhecido com a causa" {
    var mascara: u32 = 0
    var causa: [96]u8 = {}
    expect(not debug_itens("bir,xyz", &mascara, causa[..], 96))
    expect(causa[0] == 105)
}

test "debug_nome_origem usa a tabela e cai em ? fora dela" {
    expect(debug_nome_origem(0) == "prologo" and debug_nome_origem(4) == "epilogo")
    expect(debug_nome_origem(9) == "?")
}

test "tamanho_do_trecho e nome_do_trecho seguem o bloco funcao" {
    let s: str = "funcao a\nx\nfuncao b\n"
    expect(tamanho_do_trecho(s, 0) == 11)
    expect(nome_do_trecho(s, 0) == "a")
    expect(nome_do_trecho(s, 11) == "b")
}
