    s.nome_resize = common.internar(nomes, "resize", 6)
    s.nome_sort = common.internar(nomes, "sort", 4)
    s.nome_sort_by = common.internar(nomes, "sort_by", 7)
    s.nome_less = common.internar(nomes, "less", 4)
    s.nome_sort_by_key = common.internar(nomes, "sort_by_key", 11)
    s.nome_binary_search = common.internar(nomes, "binary_search", 13)
    s.nome_dedup = common.internar(nomes, "dedup", 5)
    sem_aritmetica_internar(s) // IA1-L9: os 19 nomes de aritmetica com volta, bits e mul_hi_u64 (antes de qtd_nomes)
    sem_lista_internar(s) // IA1-L9c/L9d: os 19 nomes dos embutidos de lista e os dos parametros novos (antes de qtd_nomes)
    sem_estat_internar(s) // IA1-L9e: os 8 nomes de estatistica, vistas de map e bytes de texto (antes de qtd_nomes)
    sem_listas_fixas_iniciar(s) // v1.11 L15a: antes de qtd_nomes (as tabelas por id de nome cobrem os nomes das structs ocultas)
    sem_chaves_preencher(s) // IA1-L8: idem para as chaves por modulo (internadas aqui, uma vez)
    s.qtd_nomes = len(nomes.nomes) as u32
    s.rastreados = make([dynamic]LocalRastreado, alloc = heap)
    s.nomes_locais = make([dynamic]frontend.LocalNome, alloc = heap)
    s.mapas_em_for = make([dynamic]i32, alloc = heap)
    s.higienes = make([dynamic]SemHigiene, alloc = heap)
    s.nomes_relatados = make([dynamic]i32, alloc = heap)
    if s.qtd_modulos > 1 { // v1.13: uma linha por trecho da Fonte (arquivo), nao por modulo
        var arquivos: u32 = s.qtd_modulos
        if (s.fonte as ^common.Fonte).ntrechos > s.qtd_modulos {
            arquivos = (s.fonte as ^common.Fonte).ntrechos
        }
        s.import_usado = common.arena_fatia_u8(s.arena as ^common.Arena, ((arquivos as u64) * (s.qtd_modulos as u64)) as int)
    }
    dim_iniciar(&s.dims)
    tipos_iniciar(&s.tipos, nomes, &s.dims)
    escopo_iniciar(&s.escopo, s.arena as ^common.Arena, s.qtd_nomes)
    s.globais = arena_fatia_simbolo(s.arena as ^common.Arena, s.qtd_nomes as int)
    s.titulo_visto = common.arena_fatia_u8(s.arena as ^common.Arena, s.qtd_nomes as int)
    sem_homonimos_iniciar(s)
    registrar_embutidos(s)
    montar_assinaturas_embutidas(s)
}

// C: semantic/semantic.c:259
// Posicao do modulo na ordem do driver (m->ordem: dependencias primeiro, raiz por ultimo); sem modulos importados vale o proprio indice.
proc posicao_do_modulo(s: ^Semantica, modulo: u8) -> u32 {
    if (s.modulos == none) or (s.qtd_modulos <= 1) {
        return modulo as u32
    }
    let ordem = modulos_da_sem(s).ordem or_else {}
    for i in (0 as u32)..<s.qtd_modulos {
        if ordem[i] == modulo {
            return i
        }
    }
    return modulo as u32
}

// C: semantic/semantic.c:269
proc sem_guardar_erro(s: ^Semantica, modulo: u8) -> bool {
    if (common.c2f_b2i32(s.tocou_veneno) != 0) and (common.c2f_b2i32((s.diag as ^common.Diag).tem) != 0) {
        let ptr_1: ^common.Diag = s.diag as ^common.Diag
        ptr_1.calado = true
    }
    let arg_1: u32 = posicao_do_modulo(s, modulo)
    let arg_2: ^common.Diag = s.diag as ^common.Diag
    let arg_3: ^common.DiagLista = &s.lista
    return common.diag_lista_guardar(arg_3, arg_2, arg_1)
}

// C: semantic/semantic.c:281
pub proc semantica_analisar(s: ^Semantica) -> bool {
    var ok: bool = sem_passe_a(s)
    if (not s.pula_passe_b) and (not s.lista.cortado) {
        ok = (common.c2f_b2i32(sem_passe_b(s)) != 0) and (common.c2f_b2i32(ok) != 0)
    }
    if ok {
        ok = sem_verificar_main(s)
    }
    if ok {
        ok = sem_higiene_imports(s)
    }
    s.tocou_veneno = false
    if (s.diag as ^common.Diag).tem {
        _ = sem_guardar_erro(s, 0)
    }
    common.diag_lista_ordenar(&s.lista)
    return ok
}

// C: semantic/semantic.c:293
pub proc semantica_liberar(s: ^Semantica) {
    delete(s.rastreados)
    delete(s.nomes_locais)
    delete(s.mapas_em_for)
    delete(s.higienes)
    delete(s.nomes_relatados)
    escopo_liberar(&s.escopo)
    tipos_liberar(&s.tipos)
    dim_liberar(&s.dims)
}
