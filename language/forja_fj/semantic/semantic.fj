pub proc arena_fatia_simbolo(a: ^common.Arena, n: int) -> []Simbolo {
    var l = make([dynamic]Simbolo, alloc = common.arena_mem(a), cap = n)
    for i in 0..<n {
        append(&l, item = Simbolo{})
    }
    return l[..]
}

// C: semantic/semantic.c:43
// C2F-37: `fmt, ...` virou `msg: str` (mensagem ja pronta)
proc sem_erro(s: ^Semantica, codigo: i32, pos: u32, msg: str) -> bool {
    // o corte em 511 bytes (char causa[512]) acontece dentro de diag_relatar (R-S8)
    _ = common.diag_relatar(s.diag as ^common.Diag, codigo, pos, msg)
    if codigo == common.E0301 {
        sem_forma_da_regra(s) // b07: forma da ocorrencia; quem tem forma melhor a sobrescreve logo depois
    }
    sem_relacionar(s) // b14: relacionados do pacote (so nos codigos que o tem)
    return false
}

// C: semantic/semantic.c:57
// IA1-L8: a chave de simbolo de modulo ("<L><tag>_<nome>") aparece em mensagem so como o nome puro; os demais ids saem como estao.
proc sem_nome_texto(s: ^Semantica, nome: i32) -> str {
    let texto: str = common.interner_texto(nomes_da_sem(s), nome)
    let id: u32 = common.c2f_s2u_32(nome)
    if (id >= s.chave_ini) and (id < s.chave_fim) {
        return common.nome_modulo_exibicao(texto)
    }
    return texto
}

// C: semantic/semantic.c:63
proc registrar_embutido(s: ^Semantica, nome: i32, categoria: i32, indice: i32, tipo: u32) {
    let y: ^Simbolo = &(s.globais or_else {})[nome]
    y.categoria = categoria as u8
    y.indice = indice
    y.tipo = tipo
}

// C: semantic/semantic.c:71
proc registrar_embutidos(s: ^Semantica) {
    registrar_embutido(s, frontend.SYM_PRINT, SIM_PROC_EMBUTIDO, frontend.EMB_PRINT, TIPO_VAZIO as u32)
    registrar_embutido(s, s.nome_assert, SIM_PROC_EMBUTIDO, frontend.EMB_ASSERT, TIPO_VAZIO as u32)
    registrar_embutido(s, s.nome_panic, SIM_PROC_EMBUTIDO, frontend.EMB_PANIC, TIPO_VAZIO as u32)
    registrar_embutido(s, s.nome_transmute, SIM_PROC_EMBUTIDO, frontend.EMB_TRANSMUTE, TIPO_VAZIO as u32)
    registrar_embutido(s, s.nome_len, SIM_PROC_EMBUTIDO, frontend.EMB_LEN, TIPO_INT as u32)
    registrar_embutido(s, frontend.SYM_EXPECT, SIM_PROC_EMBUTIDO, -1, TIPO_VAZIO as u32)
    registrar_embutido(s, frontend.SYM_NEW, SIM_PROC_EMBUTIDO, frontend.EMB_NEW, TIPO_VAZIO as u32)
    registrar_embutido(s, frontend.SYM_MAKE, SIM_PROC_EMBUTIDO, frontend.EMB_MAKE, TIPO_VAZIO as u32)
    registrar_embutido(s, s.nome_append, SIM_PROC_EMBUTIDO, frontend.EMB_APPEND, TIPO_VAZIO as u32)
    registrar_embutido(s, s.nome_delete, SIM_PROC_EMBUTIDO, frontend.EMB_DELETE, TIPO_VAZIO as u32)
    registrar_embutido(s, s.nome_frame_reset, SIM_PROC_EMBUTIDO, frontend.EMB_FRAME_RESET, TIPO_VAZIO as u32)
    registrar_embutido(s, s.nome_format, SIM_PROC_EMBUTIDO, frontend.EMB_FORMAT, TIPO_STR as u32)
    registrar_embutido(s, s.nome_format_c, SIM_PROC_EMBUTIDO, frontend.EMB_FORMAT_C, TIPO_CSTR as u32)
    registrar_embutido(s, s.nome_insert, SIM_PROC_EMBUTIDO, frontend.EMB_INSERT, TIPO_VAZIO as u32)
    registrar_embutido(s, s.nome_get, SIM_PROC_EMBUTIDO, frontend.EMB_GET, TIPO_VAZIO as u32)
    registrar_embutido(s, s.nome_get_ptr, SIM_PROC_EMBUTIDO, frontend.EMB_GET_PTR, TIPO_VAZIO as u32)
    registrar_embutido(s, s.nome_has, SIM_PROC_EMBUTIDO, frontend.EMB_HAS, TIPO_VAZIO as u32)
    registrar_embutido(s, s.nome_remove, SIM_PROC_EMBUTIDO, frontend.EMB_REMOVE, TIPO_VAZIO as u32)
    registrar_embutido(s, s.nome_transpose, SIM_PROC_EMBUTIDO, frontend.EMB_TRANSPOSE, TIPO_VAZIO as u32)
    registrar_embutido(s, s.nome_slice_from, SIM_PROC_EMBUTIDO, frontend.EMB_SLICE_FROM, TIPO_VAZIO as u32)
    registrar_embutido(s, frontend.SYM_SIZE_OF, SIM_PROC_EMBUTIDO, frontend.EMB_SIZE_OF, TIPO_INT as u32)
    registrar_embutido(s, frontend.SYM_ALIGN_OF, SIM_PROC_EMBUTIDO, frontend.EMB_ALIGN_OF, TIPO_INT as u32)
    registrar_embutido(s, frontend.SYM_OFFSET_OF, SIM_PROC_EMBUTIDO, frontend.EMB_OFFSET_OF, TIPO_INT as u32)
    registrar_embutido(s, frontend.SYM_STATIC_ASSERT, SIM_PROC_EMBUTIDO, frontend.EMB_STATIC_ASSERT, TIPO_VAZIO as u32)
    registrar_embutido(s, s.nome_min, SIM_PROC_EMBUTIDO, frontend.EMB_MIN, TIPO_VAZIO as u32)
    registrar_embutido(s, s.nome_max, SIM_PROC_EMBUTIDO, frontend.EMB_MAX, TIPO_VAZIO as u32)
    registrar_embutido(s, s.nome_abs, SIM_PROC_EMBUTIDO, frontend.EMB_ABS, TIPO_VAZIO as u32)
    registrar_embutido(s, s.nome_clamp, SIM_PROC_EMBUTIDO, frontend.EMB_CLAMP, TIPO_VAZIO as u32)
    registrar_embutido(s, s.nome_sqrt, SIM_PROC_EMBUTIDO, frontend.EMB_SQRT, TIPO_VAZIO as u32)
    registrar_embutido(s, s.nome_conj, SIM_PROC_EMBUTIDO, frontend.EMB_CONJ, TIPO_VAZIO as u32)
    registrar_embutido(s, s.nome_eprint, SIM_PROC_EMBUTIDO, frontend.EMB_EPRINT, TIPO_VAZIO as u32)
    registrar_embutido(s, s.nome_resize, SIM_PROC_EMBUTIDO, frontend.EMB_RESIZE, TIPO_VAZIO as u32)
    registrar_embutido(s, s.nome_sort, SIM_PROC_EMBUTIDO, frontend.EMB_SORT, TIPO_VAZIO as u32)
    registrar_embutido(s, s.nome_sort_by, SIM_PROC_EMBUTIDO, frontend.EMB_SORT_BY, TIPO_VAZIO as u32)
    registrar_embutido(s, s.nome_sort_by_key, SIM_PROC_EMBUTIDO, frontend.EMB_SORT_BY_KEY, TIPO_VAZIO as u32)
    registrar_embutido(s, s.nome_binary_search, SIM_PROC_EMBUTIDO, frontend.EMB_BINARY_SEARCH, TIPO_VAZIO as u32)
    registrar_embutido(s, s.nome_dedup, SIM_PROC_EMBUTIDO, frontend.EMB_DEDUP, TIPO_VAZIO as u32)
    sem_aritmetica_registrar(s)
    sem_lista_registrar(s)
    sem_estat_registrar(s)
}

// C: semantic/semantic.c:116
proc montar_assinaturas_embutidas(s: ^Semantica) {
    s.params_assert[0] = frontend.Param{nome = s.nome_cond}
    s.params_assert[0].tipo.tipo = TIPO_BOOL as u32
    s.params_assert[1] = frontend.Param{nome = s.nome_msg, padrao = &s.padrao_msg}
    s.params_assert[1].tipo.tipo = TIPO_CSTR as u32
    s.params_panic[0] = frontend.Param{nome = s.nome_msg}
    s.params_panic[0].tipo.tipo = TIPO_CSTR as u32
    s.padrao_cap.tipo_no = frontend.EX_INT as u8
    s.padrao_cap.tipo = TIPO_INT as u32
    s.params_new[0] = frontend.Param{nome = s.nome_tipo}
    s.params_new[1] = frontend.Param{nome = s.nome_em}
    s.params_make[0] = frontend.Param{nome = s.nome_tipo}
    s.params_make[1] = frontend.Param{nome = s.nome_em}
    s.params_make[2] = frontend.Param{nome = s.nome_cap, padrao = &s.padrao_cap}
    s.params_make[3] = frontend.Param{nome = s.nome_len, padrao = &s.padrao_cap}
    s.params_append[0] = frontend.Param{nome = s.nome_lista}
    s.params_append[1] = frontend.Param{nome = s.nome_item, padrao = &s.padrao_cap}
    s.params_append[2] = frontend.Param{nome = s.nome_items, padrao = &s.padrao_cap}
    s.params_resize[0] = frontend.Param{nome = s.nome_lista}
    s.params_resize[1] = frontend.Param{nome = s.nome_len}
    s.params_sort_by[0] = frontend.Param{nome = s.nome_x}
    s.params_sort_by[1] = frontend.Param{nome = s.nome_less}
    s.params_sort_by_key[0] = frontend.Param{nome = s.nome_x}
    s.params_sort_by_key[1] = frontend.Param{nome = s.nome_key}
    s.params_binary_search[0] = frontend.Param{nome = s.nome_x}
    s.params_binary_search[1] = frontend.Param{nome = s.nome_value}
    s.params_delete[0] = frontend.Param{nome = s.nome_valor}
    s.params_delete[1] = frontend.Param{nome = s.nome_em, padrao = &s.padrao_em}
    s.params_format[0] = frontend.Param{nome = s.nome_texto}
    s.params_format[1] = frontend.Param{nome = s.nome_em}
    s.padrao_value.tipo_no = frontend.EX_INT as u8
    s.padrao_value.tipo = TIPO_INT as u32
    s.params_insert[0] = frontend.Param{nome = s.nome_colecao}
    s.params_insert[1] = frontend.Param{nome = s.nome_key}
    s.params_insert[2] = frontend.Param{nome = s.nome_value, padrao = &s.padrao_value}
    s.params_chave[0] = frontend.Param{nome = s.nome_colecao}
    s.params_chave[1] = frontend.Param{nome = s.nome_key}
    s.params_transpose[0] = frontend.Param{nome = s.nome_matriz}
    s.params_slice_from[0] = frontend.Param{nome = s.nome_valor}
    s.params_slice_from[1] = frontend.Param{nome = s.nome_len}
    s.params_minmax[0] = frontend.Param{nome = s.nome_a}
    s.params_minmax[1] = frontend.Param{nome = s.nome_b}
    s.params_clamp[0] = frontend.Param{nome = s.nome_x}
    s.params_clamp[1] = frontend.Param{nome = s.nome_lo}
    s.params_clamp[2] = frontend.Param{nome = s.nome_hi}
    s.params_um[0] = frontend.Param{nome = s.nome_x}
    s.params_rotacao[0] = frontend.Param{nome = s.nome_x}
    s.params_rotacao[1] = frontend.Param{nome = s.nome_n}
    sem_lista_montar(s)
}

