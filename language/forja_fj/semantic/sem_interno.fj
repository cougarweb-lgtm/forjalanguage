// C: semantic/sem_interno.h:481
proc sem_achar_simbolo(s: ^Semantica, nome: i32, qualificador: u8) -> ^Simbolo {
    let y: ^Simbolo = &(s.globais or_else {})[nome]
    if (s.qtd_modulos <= 1) or (((qualificador == 0) and (s.modulo_atual == 0)) and (y.categoria != (SIM_NENHUM as u8))) {
        return y
    }
    return sem_achar_simbolo_lento(s, nome, qualificador)
}
