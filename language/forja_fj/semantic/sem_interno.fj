proc sem_origem_restritiva(origem: u8) -> bool {
    return (((((origem == (frontend.ALOC_PARAM as u8)) or (origem == (frontend.ALOC_ARENA as u8))) or (origem == (frontend.ALOC_FRAME as u8))) or (origem == (frontend.ALOC_POOL as u8))) or (origem == (ORIGEM_LITERAL as u8))) or (origem == (ORIGEM_C as u8))
}

// C: semantic/sem_interno.h:133
proc sem_origem_mais_restritiva(a: u8, b: u8) -> u8 {
    if (a == (frontend.ALOC_PARAM as u8)) or (b == (frontend.ALOC_PARAM as u8)) {
        return frontend.ALOC_PARAM as u8
    }
    if sem_origem_restritiva(a) {
        return a
    }
    if sem_origem_restritiva(b) {
        return b
    }
    var tern_1: i32 = frontend.ALOC_NENHUM
    if (a == (frontend.ALOC_HEAP as u8)) and (b == (frontend.ALOC_HEAP as u8)) {
        tern_1 = frontend.ALOC_HEAP
    }
    return tern_1 as u8
}

// C: semantic/sem_interno.h:143
proc sem_origem_do_valor(e: ?^frontend.Expr) -> u8 {
    if ((e as ^frontend.Expr).tipo_no == (frontend.EX_EMBRULHA as u8)) or ((e as ^frontend.Expr).tipo_no == (frontend.EX_TRY as u8)) {
        return sem_origem_do_valor((e as ^frontend.Expr).a)
    }
    if (e as ^frontend.Expr).tipo_no == (frontend.EX_OR_ELSE as u8) {
        let arg_1: u8 = sem_origem_do_valor((e as ^frontend.Expr).b)
        let arg_2: u8 = sem_origem_do_valor((e as ^frontend.Expr).a)
        return sem_origem_mais_restritiva(arg_2, arg_1)
    }
    if (e as ^frontend.Expr).tipo_no == (frontend.EX_CHAMADA as u8) {
        return (e as ^frontend.Expr).alocacao
    }
    var tern_1: i32 = 0
    if (e as ^frontend.Expr).tipo_no == (frontend.EX_TEXTO as u8) {
        tern_1 = ORIGEM_LITERAL
    }
    return tern_1 as u8
}

// C: semantic/sem_interno.h:157
proc sem_visivel(s: ^Semantica, y: ?^Simbolo, u: ^NomeUsado) -> bool {
    if s.qtd_modulos <= 1 {
        return true
    }
    if (u.modulo == 0) and (((y as ^Simbolo).decl == none) or ((((y as ^Simbolo).decl as ^frontend.Decl).modulo as i32) == (s.modulo_atual as i32))) {
        return true
    }
    return sem_visivel_lento(s, y, u)
}

// C: semantic/sem_interno.h:165
proc sem_entrar_na_decl(s: ^Semantica, d: ?^frontend.Decl) {
    s.modulo_atual = (d as ^frontend.Decl).modulo
    s.arquivo_atual = common.fonte_trecho_do_offset(s.fonte, (d as ^frontend.Decl).pos)
}

// C: semantic/sem_interno.h:180
proc tipo_ref_so_erro(t: ^frontend.TipoRef) -> bool {
    return (t.forma == (frontend.TR_NOME as u8)) and (t.nome < 0)
}

// C: semantic/sem_interno.h:185
proc sem_marcar_ponteiro_do_corpo(s: ^Semantica, t: u32) {
    if (not s.corpo_tem_ponteiro) and ((t >= (TIPO_FIXOS_QTD as u32)) or (t == (TIPO_RAWPTR as u32))) {
        s.corpo_tem_ponteiro = sem_fuga_tipo_tem_ponteiro(s, t)
