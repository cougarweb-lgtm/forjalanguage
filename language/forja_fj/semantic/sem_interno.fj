// C: semantic/sem_interno.h:106
proc sem_simbolo_veneno(y: ?^Simbolo) -> bool {
    return ((y as ^Simbolo).tipo == (TIPO_VENENO as u32)) or ((((y as ^Simbolo).envenenado as i32) != 0) and ((y as ^Simbolo).categoria != (SIM_PROC as u8)))
}

// C: semantic/sem_interno.h:108
proc sem_uso_de_veneno(s: ^Semantica) -> u32 {
    s.tocou_veneno = true
    return TIPO_VENENO as u32
}

