import "common"
import "frontend"

struct ElementoCadeia {
    nome: ?str
    pos: u32
}

struct Cadeia {
    el: [8]ElementoCadeia
    n: u32
}

const CADEIA_PORTADORES_MAX: i32 = 6
const CADEIA_ELEMENTOS_MAX: i32 = 8
const CADEIA_JSON_MAX: i32 = 360
const CAUSA_GERAL: i32 = 0
const CAUSA_ENDERECO: i32 = 1
const CAUSA_FATIA: i32 = 2
const FLAGS_POR_PRIORIDADE: [4]i32 = {1, 0, 2, 3}
// C2F:? tabela SUM_DO_FLAG (const FugaSumTipo[4]): folha nao escalar {'txt': '[ FUGA_HEAP ] = SUM_HEAP'}

// C: semantic/sem_fuga_cadeia.c:21
proc portador_em_args(f: ^Fuga, e: ?^frontend.Expr, bit: u32, excluir: i32) -> i32 {
    var i: u32 = 0
    while i < (e as ^frontend.Expr).nargs {
        let c: i32 = fuga_portador(f, ((e as ^frontend.Expr).args or_else {})[i].valor, bit, excluir)
        if c >= 0 {
            return c
        }
        i += 1
    }
    return -1
}

// C: semantic/sem_fuga_cadeia.c:30
proc portador_do_nome(f: ^Fuga, e: ?^frontend.Expr, bit: u32, excluir: i32) -> i32 {
    let nome: ^frontend.Expr = e as ^frontend.Expr
    let local: bool = ((nome.ref == (frontend.REF_LOCAL as u8)) or (nome.ref == (frontend.REF_PARAM as u8))) and (common.c2f_s2u_32(nome.ref_id) < f.nl)
    if (local and (nome.ref_id != excluir)) and fuga_tem(fuga_conj_de(f, common.c2f_s2u_32(nome.ref_id)), bit) {
        return nome.ref_id
    }
    return -1
}

// C: semantic/sem_fuga_cadeia.c:38
proc fuga_portador(f: ^Fuga, e: ?^frontend.Expr, bit: u32, excluir: i32) -> i32 {
    if e == none {
        return -1
    }
    if (e as ^frontend.Expr).tipo_no == (frontend.EX_NOME as u8) {
        return portador_do_nome(f, e, bit, excluir)
    }
    if (e as ^frontend.Expr).tipo_no == (frontend.EX_CHAMADA as u8) {
        var tern_1: i32 = 0
        if ((e as ^frontend.Expr).ref == (frontend.REF_EMBUTIDO as u8)) and ((e as ^frontend.Expr).ref_id != frontend.EMB_SLICE_FROM) {
            tern_1 = -1
        } else {
            tern_1 = portador_em_args(f, e, bit, excluir)
        }
        return tern_1
    }
    var c: i32 = fuga_portador(f, (e as ^frontend.Expr).a, bit, excluir)
    if c < 0 {
        c = fuga_portador(f, (e as ^frontend.Expr).b, bit, excluir)
    }
    var tern_2: i32 = 0
    if c >= 0 {
        tern_2 = c
    } else {
        tern_2 = portador_em_args(f, e, bit, excluir)
    }
    return tern_2
}

// C: semantic/sem_fuga_cadeia.c:48
proc fuga_prov_registrar(f: ^Fuga, var_c: u32, bit: u32, origem: ?^frontend.Expr) {
    if f.silencioso {
        return
    }
    let de: i32 = fuga_portador(f, origem, bit, transmute(var_c, to = i32))
    append(&f.prov, item = FugaProv{})
    let p: ^FugaProv = &f.prov[len(f.prov) - 1]
    p.var_c = transmute(var_c, to = i32)
    p.bit = transmute(bit, to = i32)
    p.de = de
}

// C: semantic/sem_fuga_cadeia.c:58
proc prov_de(f: ^Fuga, var_c: i32, bit: u32) -> i32 {
    for i in (0 as u64)..<(len(f.prov) as u64) {
        let p: ^FugaProv = &f.prov[i]
        if (p.var_c == var_c) and (common.c2f_s2u_32(p.bit) == bit) {
            return p.de
        }
    }
    return -1
}

// C: semantic/sem_fuga_cadeia.c:73
// C2F-INDECIDIVEL: p
proc fuga_sumidouro_de(f: ^Fuga, p: []u64, pos: u32, saida: ^FugaSumidouro) -> bool {
    saida^ = FugaSumidouro{tipo = SUM_PARAM as u8, nome = -1, pos = pos, callee = -1}
    for n in (0 as u32)..<f.np {
        if not fuga_tem(p, fuga_bit_param(f, n)) {
            continue
        }
        saida.nome = ((f.proc_c as ^frontend.Decl).params or_else {})[n].nome
        return true
    }
    for i in 0..<4 {
        let g: i32 = FLAGS_POR_PRIORIDADE[i]
        if not fuga_tem(p, fuga_bit_flag(f, g)) {
            continue
        }
        saida.tipo = sum_do_flag(g) as u8
        return true
    }
    return false
}

// C: SUM_DO_FLAG[g] (sem_fuga_cadeia.c:70): FUGA_HEAP/GLOBAL/FOREIGN/DESC -> SUM_*; FUGA_FLAGS nao tem entrada (0 = SUM_RETURN, nunca consultada)
proc sum_do_flag(g: i32) -> i32 {
    if g == FUGA_HEAP {
        return SUM_HEAP
    }
    if g == FUGA_GLOBAL {
        return SUM_GLOBAL
    }
    if g == FUGA_FOREIGN {
        return SUM_FOREIGN
    }
    if g == FUGA_DESC {
        return SUM_DESC
    }
    return 0
}

// C: semantic/sem_fuga_cadeia.c:89
// C2F-33: o buffer char[160] do C e o []u8 do chamador (corte em cap - 1, como o snprintf)
proc rotulo_do_sumidouro(f: ^Fuga, sum: ^FugaSumidouro, saida: []u8, cap: u64) {
    let destino: []u8 = saida[0..<(cap as int)]
    let s: ^Semantica = f.s as ^Semantica
    let t: i32 = sum.tipo as i32
    if t == SUM_RETURN {
        _ = common.c2f_snprintf(destino, "return")
    } else if t == SUM_PARAM {
        let msg_1 = format(f"memoria do parametro {sem_nome_texto(s, sum.nome)}", alloc = heap)
        defer delete(msg_1)
        _ = common.c2f_snprintf(destino, msg_1)
    } else if t == SUM_HEAP {
        _ = common.c2f_snprintf(destino, "heap")
    } else if t == SUM_GLOBAL {
        _ = common.c2f_snprintf(destino, "global")
    } else if t == SUM_FOREIGN {
        _ = common.c2f_snprintf(destino, "memoria de foreign")
    } else if t == SUM_CALLEE {
        let msg_2 = format(f"o proc '{sem_nome_texto(s, sum.callee)}' guarda o parametro '{sem_nome_texto(s, sum.nome)}' em memoria que sobrevive a chamada", alloc = heap)
        defer delete(msg_2)
        _ = common.c2f_snprintf(destino, msg_2)
    } else {
        _ = common.c2f_snprintf(destino, "memoria apontada por ponteiro de origem desconhecida")
    }
}

// C: semantic/sem_fuga_cadeia.c:107
proc acrescentar_elemento(c: ^Cadeia, nome: str, pos: u32) {
    let antes_1: u32 = c.n
    c.n += 1
    c.el[antes_1] = ElementoCadeia{nome = nome, pos = pos}
}

// C: semantic/sem_fuga_cadeia.c:113
proc montar_cadeia(f: ^Fuga, valor: ?^frontend.Expr, bit: u32, rotulo_sum: str, pos_sum: u32, c: ^Cadeia) {
    var pilha: [6]i32 = {}
    var n: u32 = 0
    var v: i32 = fuga_portador(f, valor, bit, -1)
    while (v >= 0) and (n < (CADEIA_PORTADORES_MAX as u32)) {
        pilha[n] = v
        n += 1
        v = prov_de(f, v, bit)
    }
    c.n = 0
    acrescentar_elemento(c, sem_nome_texto(f.s as ^Semantica, f.locais[bit].nome), f.locais[bit].pos)
    while n > 0 {
        n -= 1
        let l: FugaLocal = f.locais[pilha[n]]
        acrescentar_elemento(c, sem_nome_texto(f.s as ^Semantica, l.nome), l.pos)
    }
    acrescentar_elemento(c, rotulo_sum, pos_sum)
}

// C: semantic/sem_fuga_cadeia.c:128
// C2F-33: json char[CADEIA_JSON_MAX] do C = []u8 do chamador. O item[128] do C trunca em 127 mas o memcpy copia n bytes (leitura alem do buffer com nome > ~100 bytes): aqui o item sai inteiro.
proc cadeia_em_json(f: ^Fuga, c: ^Cadeia, json_c: []u8, cap: u64) {
    var usado: u64 = 0
    json_c[usado] = 91 // '['
    usado += 1
    let aspas: str = "\""
    for i in (0 as u32)..<c.n {
        let p: common.FontePosicao = common.fonte_localizar_no_arquivo((f.s as ^Semantica).fonte, c.el[i].pos)
        let nome = c.el[i].nome or_else "(null)"
        var sep: str = ", "
        var local: str = ""
        if i == 0 {
            sep = ""
            local = "local, "
        }
        let item = format(f"{sep}{aspas}{nome} ({local}{p.linha}:{p.coluna}){aspas}", alloc = heap)
        defer delete(item)
        if (usado + (len(item) as u64)) + 2 > cap {
            break
        }
        for k in 0..<len(item) {
            json_c[usado + (k as u64)] = item[k]
        }
        usado += len(item) as u64
    }
    json_c[usado] = 93 // ']'
    usado += 1
    json_c[usado] = 0
}

// C: semantic/sem_fuga_cadeia.c:144
proc cadeia_em_texto(c: ^Cadeia, texto: []u8, cap: u64) {
    var usado: u64 = 0
    texto[0] = 0
    var i: u32 = 0
    while (i < c.n) and (usado < cap) {
        var sep: str = " -> "
        if i == 0 {
            sep = ""
        }
        let nome = c.el[i].nome or_else "(null)"
        let item = format(f"{sep}{nome}", alloc = heap)
        defer delete(item)
        usado += common.c2f_snprintf(texto[usado..<cap], item) as u64
        i += 1
    }
}

// C: semantic/sem_fuga_cadeia.c:154
proc causa_direta(valor: ?^frontend.Expr, sum: ^FugaSumidouro, c: ^Cadeia) -> i32 {
    if (sum.tipo != (SUM_RETURN as u8)) or (c.n != 2) {
        return CAUSA_GERAL
    }
    if ((valor as ^frontend.Expr).tipo_no == (frontend.EX_UNARIO as u8)) and ((valor as ^frontend.Expr).op == (frontend.OP_ENDERECO as u8)) {
        return CAUSA_ENDERECO
    }
    var tern_1: i32 = CAUSA_GERAL
    if (valor as ^frontend.Expr).tipo_no == (frontend.EX_FATIA as u8) {
        tern_1 = CAUSA_FATIA
    }
    return tern_1
}

// C: semantic/sem_fuga_cadeia.c:162
proc fim_da_cadeia(f: ^Fuga, sum: ^FugaSumidouro, rotulo: str, fim: []u8, cap: u64) {
    let destino: []u8 = fim[0..<(cap as int)]
    if sum.tipo == (SUM_CALLEE as u8) {
        let msg_1 = format(f"chamada a {sem_nome_texto(f.s as ^Semantica, sum.callee)}", alloc = heap)
        defer delete(msg_1)
        _ = common.c2f_snprintf(destino, msg_1)
    } else {
        _ = common.c2f_snprintf(destino, rotulo)
    }
}

// C: semantic/sem_fuga_cadeia.c:168
proc relatar_fuga(f: ^Fuga, valor: ?^frontend.Expr, sum: ^FugaSumidouro, c: ^Cadeia, rotulo: str, texto: str) {
    let direta: i32 = causa_direta(valor, sum, c)
    let nome: ?str = c.el[0].nome
    let proc_c: str = sem_nome_texto(f.s as ^Semantica, (f.proc_c as ^frontend.Decl).nome)
    if direta == CAUSA_ENDERECO {
        let txt_1 = nome or_else "(null)"
        let msg_1 = format(f"'return &{txt_1}' devolve o endereco de uma variavel que deixa de existir quando o proc retorna", alloc = heap)
        defer delete(msg_1)
        _ = sem_erro(f.s as ^Semantica, common.E0706, (valor as ^frontend.Expr).pos, msg_1)
    } else if direta == CAUSA_FATIA {
        let txt_2 = nome or_else "(null)"
        let msg_2 = format(f"'return {txt_2}[...]' devolve uma fatia de um array que deixa de existir quando o proc retorna", alloc = heap)
        defer delete(msg_2)
        _ = sem_erro(f.s as ^Semantica, common.E0706, (valor as ^frontend.Expr).pos, msg_2)
    } else if sum.tipo == (SUM_CALLEE as u8) {
        let txt_3 = nome or_else "(null)"
        let msg_3 = format(f"'{txt_3}' e local de '{proc_c}' e {rotulo}: {texto}", alloc = heap)
        defer delete(msg_3)
        _ = sem_erro(f.s as ^Semantica, common.E0706, (valor as ^frontend.Expr).pos, msg_3)
    } else {
        let txt_4 = nome or_else "(null)"
        let msg_4 = format(f"'{txt_4}' e local de '{proc_c}' e o endereco sai por {rotulo}: {texto}", alloc = heap)
        defer delete(msg_4)
        _ = sem_erro(f.s as ^Semantica, common.E0706, (valor as ^frontend.Expr).pos, msg_4)
    }
}

// C: semantic/sem_fuga_cadeia.c:184
proc fuga_reportar(f: ^Fuga, valor: ?^frontend.Expr, bit: u32, sum: ^FugaSumidouro) -> bool {
    var buf_rotulo: [160]u8 = {}
    var buf_fim: [160]u8 = {}
    var buf_texto: [256]u8 = {}
    var buf_json: [360]u8 = {}
    var c: Cadeia = Cadeia{}
    rotulo_do_sumidouro(f, sum, buf_rotulo[..], 160)
    let rotulo: str = from_bytes(buf_rotulo[0..<common.c2f_strlen_b(buf_rotulo[..])], alloc = heap)
    defer delete(rotulo)
    fim_da_cadeia(f, sum, rotulo, buf_fim[..], 160)
    let fim: str = from_bytes(buf_fim[0..<common.c2f_strlen_b(buf_fim[..])], alloc = heap)
    defer delete(fim)
    montar_cadeia(f, valor, bit, fim, sum.pos, &c)
    cadeia_em_texto(&c, buf_texto[..], 256)
    cadeia_em_json(f, &c, buf_json[..], 360)
    let texto: str = from_bytes(buf_texto[0..<common.c2f_strlen_b(buf_texto[..])], alloc = heap)
    defer delete(texto)
    let json: str = from_bytes(buf_json[0..<common.c2f_strlen_b(buf_json[..])], alloc = heap)
    defer delete(json)
    relatar_fuga(f, valor, sum, &c, rotulo, texto)
    common.diag_acrescentar_extra((f.s as ^Semantica).diag as ^common.Diag, "cadeia", json)
    return false
}

// ---------------------------------------------------------------- G3 S6: testes da cadeia e do sumidouro

// bytes de um buffer de C (ate o NUL) como str de frame
proc s6_c_texto(b: []u8) -> str {
    return from_bytes(b[0..<common.c2f_strlen_b(b)], alloc = frame)
}

test "sem_fuga_cadeia: sumidouro_de (param antes de flags; HEAP, GLOBAL, FOREIGN, DESC) e rotulos/fim dos 7 tipos" {
    let c = s6_cen_novo("proc g(a: ^int, b: ^int) {}\n")
    defer s6_cen_liberar(c)
    let s: ^Semantica = &c.s
    let d = s6_decl_g(c)
    var tab: FugaTabela = FugaTabela{}
    tab.rascunho = make([dynamic]u64, alloc = heap)
    defer delete(tab.rascunho)
    var f: Fuga = Fuga{}
    fuga_iniciar(&f, s, d, &tab)
    defer delete(f.prov)
    var p: [1]u64 = {0}
    var sum: FugaSumidouro = FugaSumidouro{}
    expect(not fuga_sumidouro_de(&f, p[..], 77, &sum)) // conjunto vazio: nao e sumidouro
    fuga_ligar_flag(&f, p[..], FUGA_DESC)
    expect(fuga_sumidouro_de(&f, p[..], 77, &sum) and sum.tipo == (SUM_DESC as u8) and sum.pos == 77 and sum.callee == -1)
    fuga_ligar_flag(&f, p[..], FUGA_FOREIGN)
    expect(fuga_sumidouro_de(&f, p[..], 77, &sum) and sum.tipo == (SUM_FOREIGN as u8))
    fuga_ligar_flag(&f, p[..], FUGA_GLOBAL)
    expect(fuga_sumidouro_de(&f, p[..], 77, &sum) and sum.tipo == (SUM_GLOBAL as u8))
    fuga_ligar_flag(&f, p[..], FUGA_HEAP)
    expect(fuga_sumidouro_de(&f, p[..], 77, &sum) and sum.tipo == (SUM_HEAP as u8))
    fuga_ligar(p[..], fuga_bit_param(&f, 1))
    expect(fuga_sumidouro_de(&f, p[..], 77, &sum) and sum.tipo == (SUM_PARAM as u8) and sum.nome == s6_nome(c, "b"))
    fuga_ligar(p[..], fuga_bit_param(&f, 0))
    expect(fuga_sumidouro_de(&f, p[..], 77, &sum) and sum.nome == s6_nome(c, "a")) // o menor parametro vence
    // rotulos e fim da cadeia
    var buf: [160]u8 = {}
    sum = FugaSumidouro{tipo = SUM_RETURN as u8, nome = -1, pos = 0, callee = -1}
    rotulo_do_sumidouro(&f, &sum, buf[..], 160)
    expect(s6_c_texto(buf[..]) == "return")
    sum.tipo = SUM_PARAM as u8
    sum.nome = s6_nome(c, "b")
    rotulo_do_sumidouro(&f, &sum, buf[..], 160)
    expect(s6_c_texto(buf[..]) == "memoria do parametro b")
    var fim: [160]u8 = {}
    fim_da_cadeia(&f, &sum, "memoria do parametro b", fim[..], 160)
    expect(s6_c_texto(fim[..]) == "memoria do parametro b")
    var curto: [8]u8 = {}
    rotulo_do_sumidouro(&f, &sum, curto[..], 8) // corte em cap - 1 (snprintf)
    expect(s6_c_texto(curto[..]) == "memoria")
    sum.tipo = SUM_HEAP as u8
    rotulo_do_sumidouro(&f, &sum, buf[..], 160)
    expect(s6_c_texto(buf[..]) == "heap")
    sum.tipo = SUM_GLOBAL as u8
    rotulo_do_sumidouro(&f, &sum, buf[..], 160)
    expect(s6_c_texto(buf[..]) == "global")
    sum.tipo = SUM_FOREIGN as u8
    rotulo_do_sumidouro(&f, &sum, buf[..], 160)
    expect(s6_c_texto(buf[..]) == "memoria de foreign")
    sum.tipo = SUM_CALLEE as u8
    sum.nome = s6_nome(c, "a")
    sum.callee = s6_nome(c, "g")
    rotulo_do_sumidouro(&f, &sum, buf[..], 160)
    expect(s6_c_texto(buf[..]) == "o proc 'g' guarda o parametro 'a' em memoria que sobrevive a chamada")
    fim_da_cadeia(&f, &sum, "qualquer", fim[..], 160)
    expect(s6_c_texto(fim[..]) == "chamada a g") // callee: o fim e a chamada, nao o rotulo
    sum.tipo = SUM_DESC as u8
    rotulo_do_sumidouro(&f, &sum, buf[..], 160)
    expect(s6_c_texto(buf[..]) == "memoria apontada por ponteiro de origem desconhecida")
}

test "sem_fuga_cadeia: portador, montar_cadeia (x -> a -> b -> fim), texto e json com corte" {
    let c = s6_cen_novo("proc g(a: ^int, b: ^int) {}\n")
    defer s6_cen_liberar(c)
    let s: ^Semantica = &c.s
    let d = s6_decl_g(c)
    var tab: FugaTabela = FugaTabela{}
    tab.rascunho = make([dynamic]u64, alloc = heap)
    defer delete(tab.rascunho)
    var f: Fuga = Fuga{}
    fuga_iniciar(&f, s, d, &tab)
    defer delete(f.prov)
    let t_p: u32 = tipo_ponteiro(&s.tipos, TIPO_INT as u32)
    declarar(&f, 2, s6_nome(c, "x"), 9, TIPO_INT as u32)
    let end_x = s6_ex_unario(s, frontend.OP_ENDERECO, s6_ex_nome(s, s6_nome(c, "x"), 2, TIPO_INT as u32, 21), t_p, 20)
    let nome_a = s6_ex_nome(s, s6_nome(c, "a"), 0, t_p, 30)
    let nome_b = s6_ex_nome(s, s6_nome(c, "b"), 1, t_p, 40)
    // a = &x ; b = a
    fuga_zerar(&f, f.v)
    fuga_ligar(f.v, 2)
    fuga_unir_em(&f, 0, f.v, end_x)
    fuga_unir_em(&f, 1, fuga_conj_de(&f, 0), nome_a)
    expect(fuga_portador(&f, nome_b, 2, -1) == 1 and fuga_portador(&f, nome_b, 2, 1) == -1) // excluir tira o proprio
    expect(fuga_portador(&f, nome_a, 2, -1) == 0 and fuga_portador(&f, end_x, 2, -1) == -1) // x nao carrega o proprio bit
    expect(fuga_portador(&f, none, 2, -1) == -1)
    let chm = s6_ex_embutido2(s, frontend.EMB_APPEND, s6_nome(c, "append"), 0, nome_b, nome_a)
    expect(fuga_portador(&f, chm, 2, -1) == -1) // embutido (exceto slice_from) nao propaga portador
    chm.ref = frontend.REF_PROC as u8
    expect(fuga_portador(&f, chm, 2, -1) == 1) // chamada de proc: o 1o argumento que carrega o bit
    expect(prov_de(&f, 1, 2) == 0 and prov_de(&f, 0, 2) == -1 and prov_de(&f, 3, 2) == -1)
    var cad: Cadeia = Cadeia{}
    montar_cadeia(&f, nome_b, 2, "chamada a h", 20, &cad)
    expect(cad.n == 4)
    expect((cad.el[0].nome or_else "") == "x" and cad.el[0].pos == 9)
    expect((cad.el[1].nome or_else "") == "a" and cad.el[1].pos == 7)
    expect((cad.el[2].nome or_else "") == "b" and cad.el[2].pos == 16)
    expect((cad.el[3].nome or_else "") == "chamada a h" and cad.el[3].pos == 20)
    var texto: [256]u8 = {}
    cadeia_em_texto(&cad, texto[..], 256)
    expect(s6_c_texto(texto[..]) == "x -> a -> b -> chamada a h")
    var curto: [64]u8 = {}
    cadeia_em_texto(&cad, curto[..], 6) // corte do snprintf em cap - usado
    expect(s6_c_texto(curto[..]) == "x -> ")
    var json: [360]u8 = {}
    cadeia_em_json(&f, &cad, json[..], 360)
    expect(s6_c_texto(json[..]) == "[\"x (local, 1:10)\", \"a (1:8)\", \"b (1:17)\", \"chamada a h (1:21)\"]")
    cadeia_em_json(&f, &cad, json[..], 20) // o item que nao cabe corta a lista
    expect(s6_c_texto(json[..]) == "[\"x (local, 1:10)\"]")
    // causa_direta: so return com cadeia de 2 elementos distingue &x e fatia
    var dois: Cadeia = Cadeia{n = 2}
    var sr: FugaSumidouro = FugaSumidouro{tipo = SUM_RETURN as u8, nome = -1, pos = 0, callee = -1}
    expect(causa_direta(end_x, &sr, &dois) == CAUSA_ENDERECO)
    expect(causa_direta(nome_a, &sr, &dois) == CAUSA_GERAL)
    expect(causa_direta(end_x, &sr, &cad) == CAUSA_GERAL) // 4 elementos: nao e direta
    sr.tipo = SUM_HEAP as u8
    expect(causa_direta(end_x, &sr, &dois) == CAUSA_GERAL)
}
