import "common"
import "frontend"

// C: semantic/sem_mapa.c:13
proc chave_de_mapa_valida(s: ^Semantica, k: u32) -> bool {
    return (((common.c2f_b2i32(tipo_eh_inteiro(k)) != 0) or (common.c2f_s2u_32(tipo_classe_de(&s.tipos, k)) == (TC_ENUM as u32))) or (k == (TIPO_BOOL as u32))) or (k == (TIPO_STR as u32))
}

// C: semantic/sem_mapa.c:19
proc valor_de_mapa_valido(s: ^Semantica, v: u32) -> bool {
    let c: i32 = tipo_classe_de(&s.tipos, v)
    if (((((common.c2f_s2u_32(c) == (TC_OPCIONAL as u32)) or (common.c2f_s2u_32(c) == (TC_ANULAVEL as u32))) or (common.c2f_s2u_32(c) == (TC_RAWPTR as u32))) or (common.c2f_s2u_32(c) == (TC_RESULTADO as u32))) or (common.c2f_s2u_32(c) == (TC_TUPLA as u32))) or (common.c2f_s2u_32(c) == (TC_VAZIO as u32)) {
        return false
    }
    return not sem_tipo_eh_dono(s, v)
}

// C: semantic/sem_mapa.c:27
proc resolver_mapa(s: ^Semantica, t: ?^frontend.TipoRef, base: ^u32) -> bool {
    // TipoRef.alvo (TipoRef * no C) chega como fatia: alvo[0] = K e alvo[1] = V
    let alvo = (t as ^frontend.TipoRef).alvo or_else {}
    if (not sem_resolver_tipo_ref(s, &alvo[0])) or (not sem_resolver_tipo_ref(s, &alvo[1])) {
        return false
    }
    let k: u32 = alvo[0].tipo
    let v: u32 = alvo[1].tipo
    if not chave_de_mapa_valida(s, k) {
        let tipo_1 = sem_descrever_str(s, k)
        defer delete(tipo_1)
        let msg_1 = format(f"chave de map e inteiro, enum, bool ou str (recebeu {tipo_1})", alloc = heap)
        defer delete(msg_1)
        return sem_erro(s, common.E0318, alvo[0].pos, msg_1)
    }
    if not valor_de_mapa_valido(s, v) {
        let tipo_2 = sem_descrever_str(s, v)
        defer delete(tipo_2)
        let msg_2 = format(f"o valor de map nao pode ser {tipo_2} (?T, ?^T, rawptr, resultado com erro, tupla e dono ficam fora): get ja devolve ?V", alloc = heap)
        defer delete(msg_2)
        return sem_erro(s, common.E0318, alvo[1].pos, msg_2)
    }
    if not sem_exige_copiavel(s, v, alvo[1].pos, "valor de map por valor: o get devolve copia") {
        return false
    }
    base^ = tipo_mapa(&s.tipos, k, v)
    return true
}

// C: semantic/sem_mapa.c:47
proc nome_do_mapa_alterado(primeiro: ?^frontend.Expr) -> i32 {
    if ((primeiro as ^frontend.Expr).tipo_no == (frontend.EX_UNARIO as u8)) and ((primeiro as ^frontend.Expr).op == (frontend.OP_ENDERECO as u8)) {
        var tern_1: i32 = -1
        if ((primeiro as ^frontend.Expr).a as ^frontend.Expr).tipo_no == (frontend.EX_NOME as u8) {
            tern_1 = ((primeiro as ^frontend.Expr).a as ^frontend.Expr).nome
        }
        return tern_1
    }
    var tern_2: i32 = -1
    if (primeiro as ^frontend.Expr).tipo_no == (frontend.EX_NOME as u8) {
        tern_2 = (primeiro as ^frontend.Expr).nome
    }
    return tern_2
}

// C: semantic/sem_mapa.c:56
proc sem_conferir_mapa_no_for(s: ^Semantica, onde: ?^frontend.Expr, nome: i32) -> bool {
    if nome < 0 {
        return true
    }
    var i: u64 = 0
    while i < (len(s.mapas_em_for) as u64) {
        if s.mapas_em_for[i] != nome {
            i += 1
            continue
        }
        let msg_1 = format(f"o map '{sem_nome_texto(s, nome)}' esta sendo percorrido por este for: insert, remove e delete mudam a ordem; guarde as chaves numa lista e altere depois do for", alloc = heap)
        defer delete(msg_1)
        return sem_erro(s, common.E0318, (onde as ^frontend.Expr).pos, msg_1)
    }
    return true
}

// C: semantic/sem_mapa.c:69
proc conferir_alteracao_2(s: ^Semantica, colecao: ?^frontend.Expr, nome: str, insere: bool) -> bool {
    let c: ^frontend.Expr = colecao as ^frontend.Expr
    if tipo_classe_de(&s.tipos, c.tipo) != TC_PONTEIRO {
        var forma: str = "remove(&m, key = k)"
        if insere {
            forma = "insert(&m, key = k, value = v)"
        }
        let msg_1 = format(f"{nome} recebe o endereco do map: {forma}", alloc = heap)
        defer delete(msg_1)
        return sem_erro(s, common.E0318, c.pos, msg_1)
    }
    if (c.tipo_no == (frontend.EX_UNARIO as u8)) and (c.op == (frontend.OP_ENDERECO as u8)) {
        // char motivo[64]: o nome e insert ou remove, o texto cabe
        let motivo = format(f"{nome} altera o map: declare com var", alloc = heap)
        defer delete(motivo)
        if not sem_lvalor_mutavel_de(s, c.a, motivo) {
            return false
        }
    }
    return sem_conferir_mapa_no_for(s, colecao, nome_do_mapa_alterado(colecao))
}

// C: semantic/sem_mapa.c:84
proc sem_conferir_clear_mapa(s: ^Semantica, colecao: ?^frontend.Expr) -> bool {
    if (((colecao as ^frontend.Expr).tipo_no == (frontend.EX_UNARIO as u8)) and ((colecao as ^frontend.Expr).op == (frontend.OP_ENDERECO as u8))) and (not sem_lvalor_mutavel_de(s, (colecao as ^frontend.Expr).a, "clear altera o map: declare com var")) {
        return false
    }
    return sem_conferir_mapa_no_for(s, colecao, nome_do_mapa_alterado(colecao))
}

// C: semantic/sem_mapa.c:94
proc conferir_get_ptr(s: ^Semantica, colecao: ?^frontend.Expr) -> bool {
    if common.c2f_s2u_32(tipo_classe_de(&s.tipos, (colecao as ^frontend.Expr).tipo)) != (TC_PONTEIRO as u32) {
        let msg_1 = format(f"get_ptr recebe o endereco do map: get_ptr(&m, key = k)", alloc = heap)
        defer delete(msg_1)
        return sem_erro(s, common.E0318, (colecao as ^frontend.Expr).pos, msg_1)
    }
    if ((colecao as ^frontend.Expr).tipo_no == (frontend.EX_UNARIO as u8)) and ((colecao as ^frontend.Expr).op == (frontend.OP_ENDERECO as u8)) {
        return sem_lvalor_mutavel_de(s, (colecao as ^frontend.Expr).a, "get_ptr permite alterar o valor: declare o map com var")
    }
    return true
}

// C: semantic/sem_mapa.c:106
proc conferir_valor_do_insert(s: ^Semantica, e: ^frontend.Expr, v: u32) -> bool {
    let valor: ?^frontend.Arg = argumento_do_parametro(e, 2)
    if valor == none {
        let msg_1 = format(f"insert em map pede value: insert(&m, key = k, value = v)", alloc = heap)
        defer delete(msg_1)
        return sem_erro(s, common.E0318, e.pos, msg_1)
    }
    let x: ?^frontend.Expr = (valor as ^frontend.Arg).valor
    if (not sem_checar(s, x, v)) or (not sem_coagir(s, x, v, (x as ^frontend.Expr).pos)) {
        return false
    }
    return (common.c2f_b2i32(sem_conferir_movimento(s, x)) != 0) and (common.c2f_b2i32(sem_conferir_posse(s, x, PONTO_GUARDA)) != 0)
}

// C: semantic/sem_mapa.c:116
proc tipo_do_resultado(s: ^Semantica, embutido: i32, v: u32) -> u32 {
    if (embutido == frontend.EMB_INSERT) or (embutido == frontend.EMB_REMOVE) {
        return TIPO_VAZIO as u32
    }
    if embutido == frontend.EMB_HAS {
        return TIPO_BOOL as u32
    }
    if embutido == frontend.EMB_GET_PTR {
        return tipo_anulavel(&s.tipos, v)
    }
    if common.c2f_s2u_32(tipo_classe_de(&s.tipos, v)) == (TC_PONTEIRO as u32) {
        let arg_1: u32 = tipo_de(&s.tipos, v).a
        let arg_2: ^Tipos = &s.tipos
        return tipo_anulavel(arg_2, arg_1)
    }
    return tipo_opcional(&s.tipos, v)
}

// C: semantic/sem_mapa.c:126
proc sem_chamar_mapa(s: ^Semantica, e: ^frontend.Expr, embutido: i32, colecao: ?^frontend.Expr) -> bool {
    let nome: str = sem_nome_texto(s, e.nome)
    let por_ponteiro: bool = common.c2f_s2u_32(tipo_classe_de(&s.tipos, (colecao as ^frontend.Expr).tipo)) == (TC_PONTEIRO as u32)
    if embutido == frontend.EMB_GET_PTR {
        if not conferir_get_ptr(s, colecao) {
            return false
        }
    } else if (embutido == frontend.EMB_INSERT) or (embutido == frontend.EMB_REMOVE) {
        if not conferir_alteracao_2(s, colecao, nome, embutido == frontend.EMB_INSERT) {
            return false
        }
    }
    var tern_1: u32 = (colecao as ^frontend.Expr).tipo
    if common.c2f_b2i32(por_ponteiro) != 0 {
        tern_1 = tipo_de(&s.tipos, (colecao as ^frontend.Expr).tipo).a
    }
    let mapa: u32 = tern_1
    let k: u32 = tipo_de(&s.tipos, mapa).a
    let v: u32 = tipo_de(&s.tipos, mapa).b
    if (embutido == frontend.EMB_INSERT) and (not conferir_valor_do_insert(s, e, v)) {
        return false
    }
    let chave: ?^frontend.Expr = (argumento_do_parametro(e, 1) as ^frontend.Arg).valor
    if (not sem_checar(s, chave, k)) or (not sem_coagir(s, chave, k, (chave as ^frontend.Expr).pos)) {
        return false
    }
    e.tipo = tipo_do_resultado(s, embutido, v)
    return true
}

// C: semantic/sem_mapa.c:145
proc nome_da_raiz_do_for(alvo: ?^frontend.Expr) -> i32 {
    if (alvo as ^frontend.Expr).tipo_no == (frontend.EX_NOME as u8) {
        return (alvo as ^frontend.Expr).nome
    }
    if (((alvo as ^frontend.Expr).tipo_no == (frontend.EX_UNARIO as u8)) and ((alvo as ^frontend.Expr).op == (frontend.OP_DEREF as u8))) and (((alvo as ^frontend.Expr).a as ^frontend.Expr).tipo_no == (frontend.EX_NOME as u8)) {
        return ((alvo as ^frontend.Expr).a as ^frontend.Expr).nome
    }
    return -1
}

// C: semantic/sem_mapa.c:153
proc corpo_do_for_de_mapa(s: ^Semantica, st: ^frontend.Stmt) -> bool {
    append(&s.mapas_em_for, item = nome_da_raiz_do_for(st.expr))
    let ok: bool = corpo_de_laco(s, st.corpo)
    truncate(&s.mapas_em_for, len(s.mapas_em_for) - 1)
    return ok
}

// C: semantic/sem_mapa.c:162
proc sem_for_mapa(s: ^Semantica, st: ^frontend.Stmt) -> bool {
    let pos: u32 = sem_pos_depois_da_palavra(s, st.pos)
    if st.nome_indice < 0 {
        let msg_1 = format(f"for de map pede chave e valor: for k, v in m (ou for k, &v in m)", alloc = heap)
        defer delete(msg_1)
        return sem_erro(s, common.E0318, pos, msg_1)
    }
    let por_ponteiro: bool = common.c2f_s2u_32(tipo_classe_de(&s.tipos, (st.expr as ^frontend.Expr).tipo)) == (TC_PONTEIRO as u32)
    let deref: bool = ((st.expr as ^frontend.Expr).tipo_no == (frontend.EX_UNARIO as u8)) and ((st.expr as ^frontend.Expr).op == (frontend.OP_DEREF as u8))
    if (((common.c2f_b2i32(st.item_ref) != 0) and (not por_ponteiro)) and (not deref)) and (not sem_lvalor_mutavel_de(s, st.expr, "'for k, &v' altera os valores: declare o map com var")) {
        return false
    }
    var tern_1: u32 = (st.expr as ^frontend.Expr).tipo
    if common.c2f_b2i32(por_ponteiro) != 0 {
        tern_1 = tipo_de(&s.tipos, (st.expr as ^frontend.Expr).tipo).a
    }
    let mapa: u32 = tern_1
    let k: u32 = tipo_de(&s.tipos, mapa).a
    let v: u32 = tipo_de(&s.tipos, mapa).b
    let altura: u32 = escopo_altura(&s.escopo)
    var chave: NovoLocal = NovoLocal{nome = st.nome_indice, pos = pos, tipo = k, natureza = LOC_FOR as u8, origem = 0}
    var tern_2: u32 = v
    if common.c2f_b2i32(st.item_ref) != 0 {
        tern_2 = tipo_ponteiro(&s.tipos, v)
    }
    st.tipo_local = tern_2
    var item: NovoLocal = NovoLocal{nome = st.nome, pos = pos, tipo = st.tipo_local, natureza = LOC_FOR as u8, origem = 0}
    let ok: bool = ((common.c2f_b2i32(sem_declarar_local(s, &chave, &st.local_indice)) != 0) and (common.c2f_b2i32(sem_declarar_local(s, &item, &st.local_id)) != 0)) and (common.c2f_b2i32(corpo_do_for_de_mapa(s, st)) != 0)
    escopo_recuar(&s.escopo, altura)
    return ok
}

// G3 S5: testes dirigidos (so existem em `forja test`)
test "sem_mapa: chave e valor validos, nome_do_mapa_alterado e nome_da_raiz_do_for" {
    var c = S5Cena{}
    s5_cena_montar(&c, {})
    let i32t: u32 = TIPO_I32 as u32
    expect(chave_de_mapa_valida(&c.sv, i32t) and chave_de_mapa_valida(&c.sv, TIPO_UINT as u32) and chave_de_mapa_valida(&c.sv, TIPO_BOOL as u32) and chave_de_mapa_valida(&c.sv, TIPO_STR as u32))
    expect(chave_de_mapa_valida(&c.sv, tipo_enum(&c.sv.tipos, 0)))
    expect(not chave_de_mapa_valida(&c.sv, TIPO_F32 as u32) and not chave_de_mapa_valida(&c.sv, tipo_array(&c.sv.tipos, i32t, 2)))
    expect(valor_de_mapa_valido(&c.sv, i32t) and valor_de_mapa_valido(&c.sv, TIPO_STR as u32))
    expect(not valor_de_mapa_valido(&c.sv, tipo_opcional(&c.sv.tipos, i32t)) and not valor_de_mapa_valido(&c.sv, tipo_anulavel(&c.sv.tipos, i32t)))
    expect(not valor_de_mapa_valido(&c.sv, TIPO_VAZIO as u32))
    expect(not valor_de_mapa_valido(&c.sv, tipo_dinamico(&c.sv.tipos, i32t)))
    // nome do map alterado: &m e m (so EX_NOME), o resto -1
    var nm = frontend.Expr{tipo_no = frontend.EX_NOME as u8, nome = 7}
    var ender = frontend.Expr{tipo_no = frontend.EX_UNARIO as u8, op = frontend.OP_ENDERECO as u8, a = &nm}
    expect(nome_do_mapa_alterado(&ender) == 7 and nome_do_mapa_alterado(&nm) == 7)
    var fl = s5_folha(i32t, false)
    ender.a = &fl
    expect(nome_do_mapa_alterado(&ender) == -1 and nome_do_mapa_alterado(&fl) == -1)
    // raiz do for: nome, *nome, o resto -1
    var deref = frontend.Expr{tipo_no = frontend.EX_UNARIO as u8, op = frontend.OP_DEREF as u8, a = &nm}
    expect(nome_da_raiz_do_for(&nm) == 7 and nome_da_raiz_do_for(&deref) == 7 and nome_da_raiz_do_for(&ender) == -1 and nome_da_raiz_do_for(&fl) == -1)
    deref.a = &fl
    expect(nome_da_raiz_do_for(&deref) == -1)
    s5_cena_liberar(&c)
}

// Os nomes de tipo embutidos (int, i32, f32, str) resolvem por tipo_embutido (o interner leva os nomes iniciais do lexer); um nome fora deles chega em sem_idioma_de_tipo, stub do S8
test "sem_mapa: resolver_mapa (chave, valor e o map resolvido)" {
    var c = S5Cena{}
    s5_cena_montar(&c, {})
    var alvo: [2]frontend.TipoRef = {frontend.TipoRef{nome = s5_nome(&c, "int"), erro = -1, pos = 11}, frontend.TipoRef{nome = s5_nome(&c, "i32"), erro = -1, pos = 22}}
    var t = frontend.TipoRef{forma = frontend.TR_MAPA as u8, alvo = alvo[..], erro = -1}
    var base: u32 = 0
    expect(resolver_mapa(&c.sv, &t, &base) and base == tipo_mapa(&c.sv.tipos, TIPO_INT as u32, TIPO_I32 as u32))
    // chave f32
    alvo[0].nome = s5_nome(&c, "f32")
    expect(not resolver_mapa(&c.sv, &t, &base))
    expect(c.diag.codigo == common.E0318 and c.diag.off == 11 and (c.diag.causa or_else "") == "chave de map e inteiro, enum, bool ou str (recebeu f32)")
    // chave str, valor ?i32 (alvo[1] e um opcional de 1 elemento)
    alvo[0].nome = s5_nome(&c, "str")
    var interno: [1]frontend.TipoRef = {frontend.TipoRef{nome = s5_nome(&c, "i32"), erro = -1, pos = 30}}
    alvo[1] = frontend.TipoRef{forma = frontend.TR_OPCIONAL as u8, alvo = interno[..], erro = -1, pos = 22}
    expect(not resolver_mapa(&c.sv, &t, &base))
    expect(c.diag.codigo == common.E0318 and c.diag.off == 22 and (c.diag.causa or_else "") == "o valor de map nao pode ser ?i32 (?T, ?^T, rawptr, resultado com erro, tupla e dono ficam fora): get ja devolve ?V")
    // chave str, valor str: resolve
    alvo[1] = frontend.TipoRef{nome = s5_nome(&c, "str"), erro = -1, pos = 22}
    expect(resolver_mapa(&c.sv, &t, &base) and base == tipo_mapa(&c.sv.tipos, TIPO_STR as u32, TIPO_STR as u32))
    // chave sem nome (resolve para o tipo vazio): o texto do tipo vem de sem_descrever_str
    alvo[0] = frontend.TipoRef{nome = -1, erro = -1, pos = 11}
    expect(not resolver_mapa(&c.sv, &t, &base))
    let vazio = sem_descrever_str(&c.sv, TIPO_VAZIO as u32)
    defer delete(vazio)
    let esperado = format(f"chave de map e inteiro, enum, bool ou str (recebeu {vazio})", alloc = heap)
    defer delete(esperado)
    expect(c.diag.codigo == common.E0318 and c.diag.off == 11 and (c.diag.causa or_else "") == esperado)
    s5_cena_liberar(&c)
}

test "sem_mapa: conferir_alteracao_2, sem_conferir_mapa_no_for, corpo_do_for_de_mapa e sem_chamar_mapa" {
    var pre: [5]str = {"insert", "remove", "get", "has", "get_ptr"}
    var c = S5Cena{}
    s5_cena_montar(&c, pre[..])
    let i32t: u32 = TIPO_I32 as u32
    let mapa: u32 = tipo_mapa(&c.sv.tipos, TIPO_INT as u32, i32t)
    var col = s5_folha(mapa, false)
    col.pos = 33
    // sem o endereco do map (tipo nao ponteiro): E0318 com a forma do insert ou do remove
    expect(not conferir_alteracao_2(&c.sv, &col, "insert", true))
    expect(c.diag.codigo == common.E0318 and c.diag.off == 33 and (c.diag.causa or_else "") == "insert recebe o endereco do map: insert(&m, key = k, value = v)")
    expect(not conferir_alteracao_2(&c.sv, &col, "remove", false))
    expect((c.diag.causa or_else "") == "remove recebe o endereco do map: remove(&m, key = k)")
    // ponteiro que nao e &m: so confere o for
    var pcol = s5_folha(tipo_ponteiro(&c.sv.tipos, mapa), false)
    pcol.pos = 44
    expect(conferir_alteracao_2(&c.sv, &pcol, "insert", true))
    // map percorrido pelo for: E0318 com o nome
    var nm = frontend.Expr{tipo_no = frontend.EX_NOME as u8, nome = s5_nome(&c, "get"), tipo = tipo_ponteiro(&c.sv.tipos, mapa), pos = 55}
    expect(conferir_alteracao_2(&c.sv, &nm, "insert", true))
    append(&c.sv.mapas_em_for, item = nm.nome)
    expect(not conferir_alteracao_2(&c.sv, &nm, "insert", true))
    expect(c.diag.codigo == common.E0318 and c.diag.off == 55 and (c.diag.causa or_else "") == "o map 'get' esta sendo percorrido por este for: insert, remove e delete mudam a ordem; guarde as chaves numa lista e altere depois do for")
    expect(sem_conferir_mapa_no_for(&c.sv, &nm, -1))
    expect(not sem_conferir_clear_mapa(&c.sv, &nm))
    truncate(&c.sv.mapas_em_for, 0)
    expect(sem_conferir_clear_mapa(&c.sv, &nm))
    // corpo_do_for_de_mapa: empilha o nome da raiz durante o corpo e desempilha ao fim
    var st = frontend.Stmt{expr = &nm}
    expect(corpo_do_for_de_mapa(&c.sv, &st) and len(c.sv.mapas_em_for) == 0)
    append(&c.sv.mapas_em_for, item = 99)
    expect(corpo_do_for_de_mapa(&c.sv, &st) and len(c.sv.mapas_em_for) == 1 and c.sv.mapas_em_for[0] == 99)
    truncate(&c.sv.mapas_em_for, 0)
    // tipo_do_resultado por embutido
    expect(tipo_do_resultado(&c.sv, frontend.EMB_INSERT, i32t) == (TIPO_VAZIO as u32) and tipo_do_resultado(&c.sv, frontend.EMB_REMOVE, i32t) == (TIPO_VAZIO as u32))
    expect(tipo_do_resultado(&c.sv, frontend.EMB_HAS, i32t) == (TIPO_BOOL as u32))
    expect(tipo_do_resultado(&c.sv, frontend.EMB_GET_PTR, i32t) == tipo_anulavel(&c.sv.tipos, i32t))
    expect(tipo_do_resultado(&c.sv, frontend.EMB_GET, i32t) == tipo_opcional(&c.sv.tipos, i32t))
    let pv: u32 = tipo_ponteiro(&c.sv.tipos, i32t)
    expect(tipo_do_resultado(&c.sv, frontend.EMB_GET, pv) == tipo_anulavel(&c.sv.tipos, i32t))
    // sem_chamar_v19 -> sem_chamar_mapa: has/get sobre o map por valor, get_ptr e insert pelo endereco
    var dois: [2]u32 = {mapa, TIPO_INT as u32}
    var ch = S5Chamada{}
    s5_chamada_montar(&ch, s5_nome(&c, "has"), dois[..])
    expect(sem_chamar_v19(&c.sv, &ch.e, frontend.EMB_HAS) and ch.e.tipo == (TIPO_BOOL as u32))
    expect(sem_chamar_v19(&c.sv, &ch.e, frontend.EMB_GET) and ch.e.tipo == tipo_opcional(&c.sv.tipos, i32t))
    ch.e.nome = s5_nome(&c, "get_ptr")
    expect(not sem_chamar_v19(&c.sv, &ch.e, frontend.EMB_GET_PTR))
    expect(c.diag.codigo == common.E0318 and c.diag.off == 100 and (c.diag.causa or_else "") == "get_ptr recebe o endereco do map: get_ptr(&m, key = k)")
    ch.folhas[0].tipo = tipo_ponteiro(&c.sv.tipos, mapa)
    expect(sem_chamar_v19(&c.sv, &ch.e, frontend.EMB_GET_PTR) and ch.e.tipo == tipo_anulavel(&c.sv.tipos, i32t))
    // (chave de tipo errado: sem_coagir -> E0301 -> sem_forma_da_regra, stub do S7: sem execucao)
    s5_chamada_liberar(&ch)
    // insert com valor
    var tres: [3]u32 = {tipo_ponteiro(&c.sv.tipos, mapa), TIPO_INT as u32, i32t}
    s5_chamada_montar(&ch, s5_nome(&c, "insert"), tres[..])
    expect(sem_chamar_v19(&c.sv, &ch.e, frontend.EMB_INSERT) and ch.e.tipo == (TIPO_VAZIO as u32))
    s5_chamada_liberar(&ch)
    // insert sem o value: E0318
    s5_chamada_montar(&ch, s5_nome(&c, "insert"), dois[..])
    ch.folhas[0].tipo = tipo_ponteiro(&c.sv.tipos, mapa)
    expect(not sem_chamar_v19(&c.sv, &ch.e, frontend.EMB_INSERT))
    expect(c.diag.codigo == common.E0318 and c.diag.off == 50 and (c.diag.causa or_else "") == "insert em map pede value: insert(&m, key = k, value = v)")
    s5_chamada_liberar(&ch)
    s5_cena_liberar(&c)
}
