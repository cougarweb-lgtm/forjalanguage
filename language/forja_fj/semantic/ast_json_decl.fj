import "common"
import "frontend"

const AST_VERSAO: str = "1.0.0"
const NOMES_DECL: [11]str = {"unit", "unit_derivada", "const", "struct", "enum", "proc", "test", "link", "union", "import", "static_assert"}
const CLAUSULAS_POSSE: [6]str = {"", "creates", "creates", "destroys", "takes", "ends"}
// C2F-80: DECLARACOES[tipo_no] vira a tag do despachante chamar_imprime_decl (a tag e por funcao, nao por tipo_no).
const DECLARACOES: [11]u16 = {1, 2, 3, 4, 5, 6, 8, 7, 9, 10, 11}

pub const IMPRIME_DECL_DC_UNIT: u16 = 1
pub const IMPRIME_DECL_DC_UNIT_DERIVADA: u16 = 2
pub const IMPRIME_DECL_DC_CONST: u16 = 3
pub const IMPRIME_DECL_DC_STRUCT: u16 = 4
pub const IMPRIME_DECL_DC_ENUM: u16 = 5
pub const IMPRIME_DECL_DC_PROC: u16 = 6
pub const IMPRIME_DECL_DC_LINK: u16 = 7
pub const IMPRIME_DECL_DC_TEST: u16 = 8
pub const IMPRIME_DECL_DC_UNIAO: u16 = 9
pub const IMPRIME_DECL_DC_IMPORT: u16 = 10
pub const IMPRIME_DECL_DC_ASSERT: u16 = 11
pub proc chamar_imprime_decl(tag: u16, j: ^Json, d: ^frontend.Decl) {
    if tag == 1 {
        dc_unit(j, d)
        return
    }
    if tag == 2 {
        dc_unit_derivada(j, d)
        return
    }
    if tag == 3 {
        dc_const(j, d)
        return
    }
    if tag == 4 {
        dc_struct(j, d)
        return
    }
    if tag == 5 {
        dc_enum(j, d)
        return
    }
    if tag == 6 {
        dc_proc(j, d)
        return
    }
    if tag == 7 {
        dc_link(j, d)
        return
    }
    if tag == 8 {
        dc_test(j, d)
        return
    }
    if tag == 9 {
        dc_uniao(j, d)
        return
    }
    if tag == 10 {
        dc_import(j, d)
        return
    }
    if tag == 11 {
        dc_assert(j, d)
        return
    }
    panic("semantic.chamar_imprime_decl: tag de despacho invalida") // o C indexava a tabela sem conferir
}

// C: semantic/ast_json_decl.c:21
proc tipo_do_id(j: ^Json, segmento: str, indice: i32, t: ^frontend.TipoRef) {
    let antes: u64 = id_empurrar(j, segmento, indice)
    tipo_ref_json(j, t)
    id_restaurar(j, antes)
}

// C: semantic/ast_json_decl.c:28
proc dc_unit(j: ^Json, d: ^frontend.Decl) {
    chave_nome(j, "nome", d.nome)
}

// C: semantic/ast_json_decl.c:33
proc dc_unit_derivada(j: ^Json, d: ^frontend.Decl) {
    chave_nome(j, "nome", d.nome)
    chave_nome(j, "a", d.nome_a)
    chave(j, "op")
    if d.op == (frontend.OP_MUL as u8) {
        append(j.b as ^[dynamic]u8, item = "\"*\"")
    } else {
        append(j.b as ^[dynamic]u8, item = "\"/\"")
    }
    chave_nome(j, "b", d.nome_b)
}

// C: semantic/ast_json_decl.c:42
proc dc_const(j: ^Json, d: ^frontend.Decl) {
    chave_nome(j, "nome", d.nome)
    chave_tipo_texto(j, "tipo", d.tipo.tipo)
    chave_tipo(j, &d.tipo)
    chave_expr(j, "valor", d.init)
}

// C: semantic/ast_json_decl.c:50
proc campo_json(j: ^Json, c: ^frontend.Campo) {
    abre_objeto(j, c.pos, frontend.ast_fim_campo(&j.fim, c))
    chave_nome(j, "nome", c.nome)
    chave_tipo_texto(j, "tipo", c.tipo.tipo)
    chave_tipo(j, &c.tipo)
    if c.tem_faixa {
        var exclusiva: str = "false"
        if c.faixa_excl {
            exclusiva = "true"
        }
        format(f", \"faixa\": {{\"min\": {c.faixa_min}, \"max\": {c.faixa_max}, \"exclusiva\": {exclusiva}}}", into = j.b as ^[dynamic]u8)
    }
    if c.padrao != none {
        chave_expr(j, "padrao", c.padrao)
    }
    append(j.b as ^[dynamic]u8, item = "}")
}

// C: semantic/ast_json_decl.c:64
proc dc_struct(j: ^Json, d: ^frontend.Decl) {
    chave_nome(j, "nome", d.nome)
    chave(j, "campos")
    append(j.b as ^[dynamic]u8, item = "[")
    for i in (0 as u32)..<d.ncampos {
        let antes: u64 = id_empurrar(j, "campos", i as i32)
        if i != 0 {
            append(j.b as ^[dynamic]u8, item = ", ")
        }
        campo_json(j, &(d.campos or_else {})[i])
        id_restaurar(j, antes)
    }
    append(j.b as ^[dynamic]u8, item = "]")
    if d.externo {
        chave_bool(j, "externo", true)
    }
}

// C: semantic/ast_json_decl.c:79
proc dc_enum(j: ^Json, d: ^frontend.Decl) {
    chave_nome(j, "nome", d.nome)
    chave(j, "membros")
    append(j.b as ^[dynamic]u8, item = "[")
    for i in (0 as u32)..<d.nmembros {
        let m: ^frontend.Membro = &(d.membros or_else {})[i]
        let antes: u64 = id_empurrar(j, "membros", i as i32)
        if i != 0 {
            append(j.b as ^[dynamic]u8, item = ", ")
        }
        abre_objeto(j, m.pos, frontend.ast_fim_membro(&j.fim, m))
        chave_nome(j, "nome", m.nome)
        if d.op == 1 {
            format(f", \"valor\": {m.valor}", into = j.b as ^[dynamic]u8)
        }
        append(j.b as ^[dynamic]u8, item = "}")
        id_restaurar(j, antes)
    }
    append(j.b as ^[dynamic]u8, item = "]")
}

// C: semantic/ast_json_decl.c:96
proc param_json(j: ^Json, p: ^frontend.Param) {
    abre_objeto(j, p.pos, frontend.ast_fim_param(&j.fim, p))
    local_registrar(j, p.pos)
    chave_nome(j, "nome", p.nome)
    chave_tipo_texto(j, "tipo", p.tipo.tipo)
    chave_tipo(j, &p.tipo)
    if p.padrao != none {
        chave_expr(j, "padrao", p.padrao)
    }
    append(j.b as ^[dynamic]u8, item = "}")
}

// Retorno multiplo: "retornos": [{"nome": "q", "tipo": {...}}, ...] e "erro" (se houver '! E').
// C: semantic/ast_json_decl.c:108
proc retornos_json(j: ^Json, d: ^frontend.Decl) {
    chave(j, "retornos")
    append(j.b as ^[dynamic]u8, item = "[")
    for i in (0 as u32)..<d.nretornos {
        let antes: u64 = id_empurrar(j, "retornos", i as i32)
        if i != 0 {
            append(j.b as ^[dynamic]u8, item = ", ")
        }
        append(j.b as ^[dynamic]u8, item = "{")
        append(j.b as ^[dynamic]u8, item = "\"nome\": ")
        nome_json(j, (d.retornos or_else {})[i].nome)
        chave(j, "tipo")
        tipo_do_id(j, "tipo", -1, &(d.retornos or_else {})[i].tipo)
        append(j.b as ^[dynamic]u8, item = "}")
        id_restaurar(j, antes)
    }
    append(j.b as ^[dynamic]u8, item = "]")
    if d.retorno.erro >= 0 {
        chave_nome(j, "erro", d.retorno.erro)
    }
}

// C: semantic/ast_json_decl.c:127
proc dc_proc(j: ^Json, d: ^frontend.Decl) {
    chave_nome(j, "nome", d.nome)
    chave(j, "params")
    append(j.b as ^[dynamic]u8, item = "[")
    for i in (0 as u32)..<d.nparams {
        let antes: u64 = id_empurrar(j, "params", i as i32)
        if i != 0 {
            append(j.b as ^[dynamic]u8, item = ", ")
        }
        param_json(j, &(d.params or_else {})[i])
        id_restaurar(j, antes)
    }
    append(j.b as ^[dynamic]u8, item = "]")
    if d.tem_retorno and (d.retorno.forma == (frontend.TR_TUPLA as u8)) {
        retornos_json(j, d)
    } else if d.tem_retorno {
        chave(j, "retorno")
        tipo_do_id(j, "retorno", -1, &d.retorno)
        chave_tipo_texto(j, "tipo_retorno", d.retorno.tipo)
    }
    if d.externo {
        chave_bool(j, "externo", true)
    } else {
        chave_corpo(j, "corpo", d.corpo)
    }
    if d.externo and (d.simbolo >= 0) {
        chave_nome(j, "simbolo", d.simbolo) // v1.10 (A6)
    }
    if d.posse_c == (frontend.POSSE_C_NENHUMA as u8) {
        return
    }
    chave(j, "posse")
    format(f"{{\"clausula\": \"{CLAUSULAS_POSSE[d.posse_c]}\", \"param\": ", into = j.b as ^[dynamic]u8)
    if d.posse_param < 0 {
        append(j.b as ^[dynamic]u8, item = "null")
    } else {
        nome_json(j, (d.params or_else {})[d.posse_param].nome)
    }
    append(j.b as ^[dynamic]u8, item = "}")
}

