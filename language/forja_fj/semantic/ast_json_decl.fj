// C: semantic/ast_json_decl.c:200
proc decl_json(j: ^Json, d: ^frontend.Decl) {
    let inicio: u32 = frontend.ast_inicio_decl(&j.fim, d)
    abre_no(j, NOMES_DECL[d.tipo_no], inicio, frontend.ast_fim_decl(&j.fim, d))
    if d.pos != inicio {
        chave_pos(j, "pos_nome", d.pos) // Decl.pos e o nome; "pos" e onde a declaracao comeca
    }
    if (j.arquivo_decl != none) and (not j.sem_pos) { // modulo de pasta: as linhas sao do arquivo da declaracao
        chave(j, "arquivo")
        texto_json(j, as_bytes(j.arquivo_decl or_else ""), true)
    }
    if d.publico {
        chave_bool(j, "publico", true)
    }
    if d.exportado {
        chave_bool(j, "exportado", true)
    }
    chamar_imprime_decl(DECLARACOES[d.tipo_no], j, d)
    append(j.b as ^[dynamic]u8, item = "}")
}

// Ids de topo das declaracoes do modulo: o id base e, se o mesmo id ja saiu antes no modulo, "#2", "#3"... (so programa invalido repete nome).
// C2F-14: posicoes guardava pares (inicio, tamanho) em Vec de 2 x uint32_t; aqui e lista plana u32 com 2 entradas por declaracao.
// C: semantic/ast_json_decl.c:218
proc ids_de_topo(j: ^Json, decls: ^[dynamic]?^frontend.Decl, pool: ^[dynamic]u8, posicoes: ^[dynamic]u32) {
    var base: [dynamic]u8 = make([dynamic]u8, alloc = heap)
    defer delete(base)
    for i in 0..<len(decls^) {
        var repetidos: u32 = 0
        let ini: u32 = len(pool^) as u32
        clear(&base)
        ast_id_base_da_decl(&base, j.modulos, j.nomes as ^common.Interner, decls[i])
        let tam_base: u64 = len(base) as u64
        for k in 0..<i {
            let ant_ini: u64 = posicoes[2 * k] as u64
            let ant_tam: u64 = posicoes[(2 * k) + 1] as u64
            if ant_tam >= tam_base {
                let mesma_base: bool = common.c2f_memcmp(pool[ant_ini..<(ant_ini + tam_base)], base[..]) == 0
                // o id guardado ja leva o "#n"
                if mesma_base and ((ant_tam == tam_base) or (pool[ant_ini + tam_base] == 35)) { // '#'
                    repetidos += 1
                }
            }
        }
        append(pool, items = base[..])
        if repetidos > 0 {
            let numero: u32 = repetidos + 1
            format(f"#{numero}", into = pool)
        }
        append(posicoes, item = ini)
        append(posicoes, item = (len(pool^) as u32) - ini)
    }
}

// C: semantic/ast_json_decl.c:241
proc coletar_decls_do_modulo(programa: ^frontend.Programa, modulo: u8, decls: ^[dynamic]?^frontend.Decl) {
    decls^ = make([dynamic]?^frontend.Decl, alloc = heap)
    var d: ?^frontend.Decl = programa.primeira
    while d != none {
        if ((d as ^frontend.Decl).modulo as i32) == (modulo as i32) {
            append(decls, item = none)
            decls[len(decls^) - 1] = d
        }
        d = (d as ^frontend.Decl).prox
    }
}

// C: semantic/ast_json_decl.c:250
proc primeiro_trecho_do_modulo(j: ^Json, modulo: u8, n: ^u32) -> u32 {
    var primeiro: u32 = 0
    n^ = frontend.modulos_trechos_do_pacote(j.modulos as ^frontend.Modulos, (j.fonte as ^common.Fonte).ntrechos, modulo, &primeiro)
    return primeiro
}

// C: semantic/ast_json_decl.c:259
proc arquivo_do_modulo(j: ^Json, modulo: u8) -> ?str {
    var n: u32 = 0
    let primeiro: u32 = primeiro_trecho_do_modulo(j, modulo, &n)
    if ((j.fonte as ^common.Fonte).ntrechos == 0) or (n == 0) {
        return (j.fonte as ^common.Fonte).caminho
    }
    return ((j.fonte as ^common.Fonte).trechos or_else {})[primeiro].caminho
}

// C: semantic/ast_json_decl.c:267
proc chave_caminho_do_modulo(j: ^Json) {
    let caminho: i32 = (j.modulos as ^frontend.Modulos).itens[j.modulo].caminho
    chave(j, "modulo")
    texto_json(j, interner_bytes(j.nomes as ^common.Interner, caminho), false)
}

// v1.13: as linhas locais da declaracao contam do 1o byte do ARQUIVO dela (o modulo de pasta tem varios); j->arquivo_decl = esse arquivo, so num modulo de 2+ arquivos.
// C: semantic/ast_json_decl.c:275
proc entrar_no_arquivo_da_decl(j: ^Json, d: ^frontend.Decl) {
    let f: ^common.Fonte = j.fonte as ^common.Fonte
    var n: u32 = 0
    if f.ntrechos == 0 {
        return
    }
    let trecho: u32 = common.fonte_trecho_do_offset(j.fonte, d.pos)
    _ = primeiro_trecho_do_modulo(j, j.modulo, &n)
    j.linha_base = (f.trechos or_else {})[trecho].linha_base
    if n > 1 {
        j.arquivo_decl = (f.trechos or_else {})[trecho].caminho
    } else {
        j.arquivo_decl = none
    }
}

// ", "declaracoes": [...]" do modulo j->modulo.
// C: semantic/ast_json_decl.c:288
proc declaracoes_do_modulo(j: ^Json, programa: ^frontend.Programa) {
    var decls: [dynamic]?^frontend.Decl = make([dynamic]?^frontend.Decl, alloc = heap)
    var posicoes: [dynamic]u32 = make([dynamic]u32, alloc = heap)
    var pool: [dynamic]u8 = make([dynamic]u8, alloc = heap)
    defer delete(decls)
    defer delete(posicoes)
    defer delete(pool)
    coletar_decls_do_modulo(programa, j.modulo, &decls)
    ids_de_topo(j, &decls, &pool, &posicoes)
    clear(&j.imports)
    chave(j, "declaracoes")
    append(j.b as ^[dynamic]u8, item = "[")
    for i in 0..<len(decls) {
        let p_ini: u64 = posicoes[2 * i] as u64
        let p_tam: u64 = posicoes[(2 * i) + 1] as u64
        if i != 0 {
            append(j.b as ^[dynamic]u8, item = ", ")
        }
        clear(&j.id)
        append(&j.id, items = pool[p_ini..<(p_ini + p_tam)])
        entrar_no_arquivo_da_decl(j, decls[i] as ^frontend.Decl)
        decl_json(j, decls[i] as ^frontend.Decl)
    }
    append(j.b as ^[dynamic]u8, item = "]")
}

// C: semantic/ast_json_decl.c:312
proc entrar_no_modulo(j: ^Json, modulo: u8) {
    var n: u32 = 0
    let primeiro: u32 = primeiro_trecho_do_modulo(j, modulo, &n)
    j.modulo = modulo
    j.arquivo_decl = none
    var tern_1: u32 = 0
    if not (((j.fonte as ^common.Fonte).ntrechos == 0) or (n == 0)) {
        tern_1 = ((j.fonte as ^common.Fonte).trechos or_else {})[primeiro].linha_base
    }
    j.linha_base = tern_1
}

// C: semantic/ast_json_decl.c:322
proc modulo_do_projeto(j: ^Json, programa: ^frontend.Programa, modulo: u8) {
    entrar_no_modulo(j, modulo)
    append(j.b as ^[dynamic]u8, item = "{")
    append(j.b as ^[dynamic]u8, item = "\"modulo\": ")
    let caminho: i32 = (j.modulos as ^frontend.Modulos).itens[modulo].caminho
    texto_json(j, interner_bytes(j.nomes as ^common.Interner, caminho), false)
    if not j.sem_pos {
        chave(j, "arquivo")
        texto_json(j, as_bytes(arquivo_do_modulo(j, modulo) or_else ""), true)
    }
    declaracoes_do_modulo(j, programa)
    append(j.b as ^[dynamic]u8, item = "}")
}

// C: semantic/ast_json_decl.c:336
proc modulos_do_projeto(j: ^Json, programa: ^frontend.Programa) {
    let n: u32 = (j.modulos as ^frontend.Modulos).n
    chave(j, "modulos")
    append(j.b as ^[dynamic]u8, item = "[")
    for i in (0 as u32)..<n {
        if i != 0 {
            append(j.b as ^[dynamic]u8, item = ", ")
        }
        var modulo: u8 = 0
        if n > 1 {
            modulo = ((j.modulos as ^frontend.Modulos).ordem or_else {})[i] // pos-ordem das dependencias: folhas primeiro, raiz por ultimo
        }
        modulo_do_projeto(j, programa, modulo)
    }
    append(j.b as ^[dynamic]u8, item = "]")
}

// C: semantic/ast_json_decl.c:348
proc imprimir_documento(j: ^Json, p: ^AstPedido) {
    let f: ^common.Fonte = j.fonte as ^common.Fonte
    append(j.b as ^[dynamic]u8, item = "{\"arquivo\": ")
    if j.sem_pos {
        append(j.b as ^[dynamic]u8, item = "null")
    } else {
        texto_json(j, as_bytes(f.caminho or_else ""), true)
    }
    format(f", \"ast_versao\": \"{AST_VERSAO}\"", into = j.b as ^[dynamic]u8)
    if p.projeto {
        append(j.b as ^[dynamic]u8, item = ", \"projeto\": true")
        modulos_do_projeto(j, p.programa as ^frontend.Programa)
    } else {
        entrar_no_modulo(j, 0)
        chave_caminho_do_modulo(j)
        declaracoes_do_modulo(j, p.programa as ^frontend.Programa)
    }
    append(j.b as ^[dynamic]u8, item = "}\n")
}

// --no <id>: o documento so com o objeto daquele no. false = id inexistente.
// C: semantic/ast_json_decl.c:366
proc escrever_subarvore(cheio: ^[dynamic]u8, p: ^AstPedido, saida: ^[dynamic]u8) -> bool {
    var ini: u64 = 0
    var fim: u64 = 0
    let no: str = p.no or_else ""
    if not ast_no_extrair(cheio[..], no, &ini, &fim) {
        return false
    }
    format(f"{{\"ast_versao\": \"{AST_VERSAO}\", \"no_id\": ", into = saida)
    var t: Json = Json{b = saida}
    texto_json(&t, as_bytes(no), false)
    append(saida, item = ", \"subarvore\": ")
    append(saida, items = cheio[ini..<fim])
    append(saida, item = "}\n")
    return true
}

// C: semantic/ast_json_decl.c:381
proc liberar_json(j: ^Json) {
    frontend.ast_fim_liberar(&j.fim)
    delete(j.linhas)
    delete(j.locais)
    delete(j.imports)
    delete(j.guardados)
    delete(j.id)
}

// C: semantic/ast_json_decl.c:391
// C2F-19: `const char **erro` (texto fixo) vira ^str.
pub proc ast_imprimir(p: ^AstPedido, saida: ^[dynamic]u8, erro: ^str) -> bool {
    var cheio: [dynamic]u8 = make([dynamic]u8, alloc = heap)
    defer delete(cheio)
    var destino: ^[dynamic]u8 = saida
    if p.no != none {
        destino = &cheio
    }
    var j: Json = Json{b = destino, fonte = p.fonte, nomes = p.nomes, sem = p.sem, modulos = p.modulos, refs = p.refs, tipos = p.sem != none, sem_pos = p.sem_pos}
    var ok: bool = true
    if not frontend.ast_fim_iniciar(&j.fim, p.fonte as ^common.Fonte, p.nomes as ^common.Interner, p.diag as ^common.Diag) {
        erro^ = "erro lexico ao reler o fonte para as posicoes finais"
        return false
    }
    j.locais = make([dynamic]AstGuardado, alloc = heap)
    j.imports = make([dynamic]AstGuardado, alloc = heap)
    j.id = make([dynamic]u8, alloc = heap)
    j.guardados = make([dynamic]u8, alloc = heap)
    mapear_linhas(&j)
    imprimir_documento(&j, p)
    if (p.no != none) and (not escrever_subarvore(&cheio, p, saida)) {
        erro^ = "no inexistente: o id vem de 'forja ast' (campo \"id\")"
        ok = false
    }
    liberar_json(&j)
    return ok
}
