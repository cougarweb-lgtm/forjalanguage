import "common"
import "frontend"

pub struct AstPedido {
    programa: ?^frontend.Programa
    fonte: ?^common.Fonte
    nomes: ?^common.Interner
    modulos: ?^frontend.Modulos
    diag: ?^common.Diag
    sem: ?^Semantica
    refs: ?^AstRefs
    no: ?str
    projeto: bool
    sem_pos: bool
}

const NOMES_EXPR: [23]str = {"int", "real", "bool", "texto", "nome", "campo", "chamada", "literal_struct", "unario", "binario", "conversao", "try", "or_else", "none", "indice", "fatia", "literal_array", "tipo", "embrulha", "opc_teste", "tupla", "ftexto", "chamada_ind"}
const NOMES_OP: [23]str = {"ou", "e", "igual", "diferente", "menor", "menor_igual", "maior", "maior_igual", "soma", "sub", "mul", "div", "resto", "negar", "nao", "endereco", "bit_e", "bit_ou", "bit_xou", "desloca_esq", "desloca_dir", "bit_nao", "deref"}
const NOMES_STMT: [14]str = {"let", "var", "atribuicao", "if", "while", "for", "return", "chamada", "break", "continue", "defer", "switch", "expect", "let_multiplo"}
const NOMES_FORMA: [14]str = {"nome", "ponteiro", "anulavel", "array", "fatia", "dinamico", "opcional", "tupla", "proc", "mapa", "bit_set", "soa", "matriz", "lista_fixa"}
const LIMITES: [3]str = {"exclusivo", "inclusivo", "inteira"}
const OPS_ATRIBUICAO: [3]str = {"=", "+=", "-="}

// C2F-80: EXPRESSOES[tipo_no] e COMANDOS[tipo_no] viram a tag do despachante chamar_imprime_*
// (a tag e por funcao, nao por tipo_no: EX_INT e EX_REAL dividem a tag 1, ST_LET e ST_VAR a 1, ST_BREAK e ST_CONTINUE a 8).
const EXPRESSOES: [23]u16 = {1, 1, 2, 3, 4, 5, 6, 8, 9, 10, 11, 13, 14, 12, 15, 16, 17, 18, 19, 20, 21, 22, 7}
const COMANDOS: [14]u16 = {1, 1, 2, 3, 4, 5, 6, 7, 8, 8, 9, 10, 11, 12}

pub const IMPRIME_EXPR_EX_NUMERO: u16 = 1
pub const IMPRIME_EXPR_EX_BOOL: u16 = 2
pub const IMPRIME_EXPR_EX_TEXTO: u16 = 3
pub const IMPRIME_EXPR_EX_NOME: u16 = 4
pub const IMPRIME_EXPR_EX_CAMPO: u16 = 5
pub const IMPRIME_EXPR_EX_CHAMADA: u16 = 6
pub const IMPRIME_EXPR_EX_CHAMADA_IND: u16 = 7
pub const IMPRIME_EXPR_EX_LITERAL_STRUCT: u16 = 8
pub const IMPRIME_EXPR_EX_UNARIO: u16 = 9
pub const IMPRIME_EXPR_EX_BINARIO: u16 = 10
pub const IMPRIME_EXPR_EX_CONVERSAO: u16 = 11
pub const IMPRIME_EXPR_EX_NONE: u16 = 12
pub const IMPRIME_EXPR_EX_TRY: u16 = 13
pub const IMPRIME_EXPR_EX_OR_ELSE: u16 = 14
pub const IMPRIME_EXPR_EX_INDICE: u16 = 15
pub const IMPRIME_EXPR_EX_FATIA: u16 = 16
pub const IMPRIME_EXPR_EX_LITERAL_ARRAY: u16 = 17
pub const IMPRIME_EXPR_EX_TIPO: u16 = 18
pub const IMPRIME_EXPR_EX_EMBRULHA: u16 = 19
pub const IMPRIME_EXPR_EX_OPC_TESTE: u16 = 20
pub const IMPRIME_EXPR_EX_TUPLA: u16 = 21
pub const IMPRIME_EXPR_EX_F_TEXTO: u16 = 22
pub proc chamar_imprime_expr(tag: u16, j: ^Json, e: ^frontend.Expr) {
    if tag == 1 {
        ex_numero(j, e)
        return
    }
    if tag == 2 {
        ex_bool(j, e)
        return
    }
    if tag == 3 {
        ex_texto(j, e)
        return
    }
    if tag == 4 {
        ex_nome(j, e)
        return
    }
    if tag == 5 {
        ex_campo(j, e)
        return
    }
    if tag == 6 {
        ex_chamada(j, e)
        return
    }
    if tag == 7 {
        ex_chamada_ind(j, e)
        return
    }
    if tag == 8 {
        ex_literal_struct(j, e)
        return
    }
    if tag == 9 {
        ex_unario(j, e)
        return
    }
    if tag == 10 {
        ex_binario(j, e)
        return
    }
    if tag == 11 {
        ex_conversao(j, e)
        return
    }
    if tag == 12 {
        ex_none(j, e)
        return
    }
    if tag == 13 {
        ex_try(j, e)
        return
    }
    if tag == 14 {
        ex_or_else(j, e)
        return
    }
    if tag == 15 {
        ex_indice(j, e)
        return
    }
    if tag == 16 {
        ex_fatia(j, e)
        return
    }
    if tag == 17 {
        ex_literal_array(j, e)
        return
    }
    if tag == 18 {
        ex_tipo(j, e)
        return
    }
    if tag == 19 {
        ex_embrulha(j, e)
        return
    }
    if tag == 20 {
        ex_opc_teste(j, e)
        return
    }
    if tag == 21 {
        ex_tupla(j, e)
        return
    }
    if tag == 22 {
        ex_f_texto(j, e)
        return
    }
    panic("semantic.chamar_imprime_expr: tag de despacho invalida") // o C indexava a tabela sem conferir
}

pub const IMPRIME_STMT_ST_LET_VAR: u16 = 1
pub const IMPRIME_STMT_ST_ATRIBUICAO: u16 = 2
pub const IMPRIME_STMT_ST_IF: u16 = 3
pub const IMPRIME_STMT_ST_WHILE: u16 = 4
pub const IMPRIME_STMT_ST_FOR: u16 = 5
pub const IMPRIME_STMT_ST_RETURN: u16 = 6
pub const IMPRIME_STMT_ST_CHAMADA: u16 = 7
pub const IMPRIME_STMT_ST_SEM_CAMPOS: u16 = 8
pub const IMPRIME_STMT_ST_DEFER: u16 = 9
pub const IMPRIME_STMT_ST_SWITCH: u16 = 10
pub const IMPRIME_STMT_ST_EXPECT: u16 = 11
pub const IMPRIME_STMT_ST_LET_MULTIPLO: u16 = 12
pub proc chamar_imprime_stmt(tag: u16, j: ^Json, s: ^frontend.Stmt) {
    if tag == 1 {
        st_let_var(j, s)
        return
    }
    if tag == 2 {
        st_atribuicao(j, s)
        return
    }
    if tag == 3 {
        st_if(j, s)
        return
    }
    if tag == 4 {
        st_while(j, s)
        return
    }
    if tag == 5 {
        st_for(j, s)
        return
    }
    if tag == 6 {
        st_return(j, s)
        return
    }
    if tag == 7 {
        st_chamada(j, s)
        return
    }
    if tag == 8 {
        st_sem_campos(j, s)
        return
    }
    if tag == 9 {
        st_defer(j, s)
        return
    }
    if tag == 10 {
        st_switch(j, s)
        return
    }
    if tag == 11 {
        st_expect(j, s)
        return
    }
    if tag == 12 {
        st_let_multiplo(j, s)
        return
    }
    panic("semantic.chamar_imprime_stmt: tag de despacho invalida") // o C indexava a tabela sem conferir
}

// C: semantic/ast_json.c:39
pub proc ast_nome_da_expr(tipo_no: u8) -> str {
    return NOMES_EXPR[tipo_no]
}

// C2F-33: o C passava `const char *` + tamanho para o texto da fonte e para o Interner; aqui os dois viram bytes.
// Texto do Interner com o tamanho do Nome (o que o C passa a TextoJson).
proc interner_bytes(nomes: ^common.Interner, id: i32) -> []u8 {
    let t: str = common.interner_texto(nomes, id)
    return as_bytes(t)[0..<(common.interner_tam(nomes, id) as u64)]
}

// isalnum do locale "C" (o C chama isalnum((unsigned char)c)).
proc eh_alnum_ascii(c: u8) -> bool {
    return ((c >= 48) and (c <= 57)) or ((c >= 65) and (c <= 90)) or ((c >= 97) and (c <= 122))
}

// C: semantic/ast_json.c:58
proc mapear_linhas(j: ^Json) {
    let f: ^common.Fonte = j.fonte as ^common.Fonte
    j.linhas = make([dynamic]u32, alloc = heap)
    append(&j.linhas, item = 0)
    for i in (0 as u64)..<f.tam {
        if f.texto[i] == 10 { // '\n'
            append(&j.linhas, item = (i as u32) + 1)
        }
    }
}

// C: semantic/ast_json.c:68
proc pos_json(j: ^Json, off: u32) {
    var lo: u64 = 0
    var hi: u64 = len(j.linhas) as u64
    while (hi - lo) > 1 {
        let meio: u64 = (lo + hi) / 2
        if j.linhas[meio] <= off {
            lo = meio
        } else {
            hi = meio
        }
    }
    let linha: u64 = (lo + 1) - (j.linha_base as u64)
    let coluna: u32 = (off - j.linhas[lo]) + 1
    format(f"[{linha}, {coluna}]", into = j.b as ^[dynamic]u8) // linha local ao arquivo do modulo
}

// Texto entre aspas, com escape; '\' vira '/' quando e caminho de arquivo.
// C: semantic/ast_json.c:80
proc texto_json(j: ^Json, s: []u8, caminho: bool) {
    let b: ^[dynamic]u8 = j.b as ^[dynamic]u8
    append(b, item = "\"")
    for i in 0..<len(s) {
        let ch: u8 = s[i]
        if caminho and (ch == 92) { // '\\'
            append(b, item = "/")
        } else if (ch == 34) or (ch == 92) { // '"' '\\'
            append(b, item = "\\")
            append(b, item = ch)
        } else if ch < 32 {
            append(b, item = "\\u")
            format(f"{ch:04x}", into = b)
        } else {
            append(b, item = ch)
        }
    }
    append(b, item = "\"")
}

// C: semantic/ast_json.c:93
proc chave(j: ^Json, chave: str) {
    format(f", \"{chave}\": ", into = j.b as ^[dynamic]u8)
}

// C: semantic/ast_json.c:98
proc nome_json(j: ^Json, id: i32) {
    if id < 0 {
        append(j.b as ^[dynamic]u8, item = "null")
    } else {
        texto_json(j, interner_bytes(j.nomes as ^common.Interner, id), false)
    }
}

// C: semantic/ast_json.c:104
proc chave_nome(j: ^Json, chave: str, id: i32) {
    chave(j, chave)
    nome_json(j, id)
}

// C: semantic/ast_json.c:110
proc chave_bool(j: ^Json, chave: str, valor: bool) {
    chave(j, chave)
    if valor {
        append(j.b as ^[dynamic]u8, item = "true")
    } else {
        append(j.b as ^[dynamic]u8, item = "false")
    }
}

// ", "<chave>": [l, c]"; em --sem-pos nenhuma posicao sai.
// C: semantic/ast_json.c:117
proc chave_pos(j: ^Json, chave: str, off: u32) {
    if j.sem_pos {
        return
    }
    chave(j, chave)
    pos_json(j, off)
}

// "id" do no em escrita (caminho estrutural, D-IA1-20), "pos" e "fim" [l, c] (fim exclusivo, D-IA1-21).
// C: semantic/ast_json.c:125
proc id_pos_fim(j: ^Json, off: u32, fim: u32) {
    append(j.b as ^[dynamic]u8, item = "\"id\": ")
    texto_json(j, j.id[..], false)
    chave_pos(j, "pos", off)
    chave_pos(j, "fim", fim)
}

// Abre um no: {"no": "<tipo>", "id": "...", "pos": [l, c], "fim": [l, c] ; quem chama fecha com '}'.
// C: semantic/ast_json.c:134
proc abre_no(j: ^Json, tipo: str, off: u32, fim: u32) {
    format(f"{{\"no\": \"{tipo}\", ", into = j.b as ^[dynamic]u8)
    id_pos_fim(j, off, fim)
}

// C: semantic/ast_json.c:140
proc abre_objeto(j: ^Json, off: u32, fim: u32) {
    append(j.b as ^[dynamic]u8, item = "{")
    id_pos_fim(j, off, fim)
}

// C: semantic/ast_json.c:146
proc chave_expr(j: ^Json, chave: str, e: ?^frontend.Expr) {
    let antes: u64 = id_empurrar(j, chave, -1)
    chave(j, chave)
    expr_json(j, e)
    id_restaurar(j, antes)
}

// "modulo": texto do apelido (v1.8), lido cru da fonte em 'off' (so [a-z0-9_]).
// C: semantic/ast_json.c:155
proc chave_modulo_em(j: ^Json, off: u32) {
    let f: ^common.Fonte = j.fonte as ^common.Fonte
    let ini: u64 = off as u64
    var n: u64 = 0
    while true {
        let c: u8 = f.texto[ini + n]
        if not (((c >= 97) and (c <= 122)) or ((c >= 48) and (c <= 57)) or (c == 95)) { // a-z 0-9 '_'
            break
        }
        n += 1
    }
    chave(j, "modulo")
    texto_json(j, f.texto[ini..<(ini + n)], false)
}

// Cada comando leva o indice no id: "corpo[2]".
// C: semantic/ast_json.c:165
proc lista_stmt_json(j: ^Json, chave: str, s: ?^frontend.Stmt) {
    var indice: i32 = 0
    append(j.b as ^[dynamic]u8, item = "[")
    var x: ?^frontend.Stmt = s
    while x != none {
        let antes: u64 = id_empurrar(j, chave, indice)
        if indice > 0 { // C: x != s (so o 1o da lista e igual a s)
            append(j.b as ^[dynamic]u8, item = ", ")
        }
        stmt_json(j, x)
        id_restaurar(j, antes)
        x = (x as ^frontend.Stmt).prox
        indice += 1
    }
    append(j.b as ^[dynamic]u8, item = "]")
}

// C: semantic/ast_json.c:178
proc chave_corpo(j: ^Json, chave: str, s: ?^frontend.Stmt) {
    chave(j, chave)
    lista_stmt_json(j, chave, s)
}

// "tamanho": texto escrito do N do array (digitos ou nome de const), recortado da fonte em pos_tamanho.
// C: semantic/ast_json.c:187
proc tamanho_do_array_json(j: ^Json, t: ?^frontend.TipoRef) {
    let f: ^common.Fonte = j.fonte as ^common.Fonte
    let ini: u64 = (t as ^frontend.TipoRef).pos_tamanho as u64
    var n: u64 = 0
    while eh_alnum_ascii(f.texto[ini + n]) or (f.texto[ini + n] == 95) { // '_'
        n += 1
    }
    chave(j, "tamanho")
    texto_json(j, f.texto[ini..<(ini + n)], false)
}

// Tipo dentro de outro tipo: o segmento entra no id (".../alvo").
// C: semantic/ast_json.c:197
proc filho_tipo(j: ^Json, segmento: str, t: ?^frontend.TipoRef) {
    let antes: u64 = id_empurrar(j, segmento, -1)
    tipo_ref_json(j, t)
    id_restaurar(j, antes)
}

// v1.8b: TR_PROC: "params": [TipoRef de alvo[1..nome]], "retorno": TipoRef de alvo[0] ou null.
// C: semantic/ast_json.c:205
proc proc_do_tipo_json(j: ^Json, t: ?^frontend.TipoRef) {
    let tt: ^frontend.TipoRef = t as ^frontend.TipoRef
    chave(j, "params")
    append(j.b as ^[dynamic]u8, item = "[")
    for i in (1 as i32)..=tt.nome {
        let antes: u64 = id_empurrar(j, "params", i - 1)
        if i > 1 {
            append(j.b as ^[dynamic]u8, item = ", ")
        }
        tipo_ref_json(j, &(tt.alvo or_else {})[i])
        id_restaurar(j, antes)
    }
    append(j.b as ^[dynamic]u8, item = "]")
    chave(j, "retorno")
    if tt.pos_tamanho == 1 {
        filho_tipo(j, "retorno", &(tt.alvo or_else {})[0])
    } else {
        append(j.b as ^[dynamic]u8, item = "null")
    }
    chave(j, "nomes_params") // v1.12: alvo[nome + k]
    append(j.b as ^[dynamic]u8, item = "[")
    for i in (1 as i32)..=tt.nome {
        if i > 1 {
            append(j.b as ^[dynamic]u8, item = ", ")
        }
        nome_json(j, (tt.alvo or_else {})[tt.nome + i].nome)
    }
    append(j.b as ^[dynamic]u8, item = "]")
}

// v1.9: TR_MATRIZ: "linhas": R, "colunas": C (numeros JSON, de t->nome = (R << 4) | C).
// C: semantic/ast_json.c:228
proc dimensoes_da_matriz_json(j: ^Json, t: ?^frontend.TipoRef) {
    let nome: i32 = (t as ^frontend.TipoRef).nome
    let linhas: i32 = common.c2f_sar_i32(nome, 4) // t->nome >> 4
    let colunas: i32 = common.c2f_e_i32(nome, 15) // t->nome & 15
    format(f", \"linhas\": {linhas}, \"colunas\": {colunas}", into = j.b as ^[dynamic]u8)
}

// {"id", "pos", "fim", "forma"?: "ponteiro"|"anulavel"|"array"|"fatia"|"dinamico", "tamanho"?, "alvo"?: {...}, "nome"?, "erro"?} (recursivo em "alvo")
// C: semantic/ast_json.c:234
proc tipo_ref_json(j: ^Json, t: ?^frontend.TipoRef) {
    let tt: ^frontend.TipoRef = t as ^frontend.TipoRef
    abre_objeto(j, tt.pos, frontend.ast_fim_tipo(&j.fim, t))
    if tt.modulo != 0 {
        chave_modulo_em(j, tt.pos)
    }
    ref_do_tipo(j, t)
    if tt.forma != (frontend.TR_NOME as u8) {
        chave(j, "forma")
        format(f"\"{NOMES_FORMA[tt.forma]}\"", into = j.b as ^[dynamic]u8)
        if tt.forma == (frontend.TR_PROC as u8) {
            proc_do_tipo_json(j, t)
        } else if tt.forma == (frontend.TR_MAPA as u8) {
            chave(j, "chave")
            filho_tipo(j, "chave", &(tt.alvo or_else {})[0])
            chave(j, "valor")
            filho_tipo(j, "valor", &(tt.alvo or_else {})[1])
        } else {
            if tt.forma == (frontend.TR_MATRIZ as u8) {
                dimensoes_da_matriz_json(j, t)
            }
            if (tt.forma == (frontend.TR_ARRAY as u8)) or (tt.forma == (frontend.TR_LISTA_FIXA as u8)) {
                tamanho_do_array_json(j, t)
            }
            chave(j, "alvo")
            filho_tipo(j, "alvo", &(tt.alvo or_else {})[0])
        }
    }
    if (tt.forma == (frontend.TR_NOME as u8)) and (tt.nome >= 0) {
        chave_nome(j, "nome", tt.nome)
    }
    if tt.erro >= 0 {
        chave_nome(j, "erro", tt.erro)
    }
    append(j.b as ^[dynamic]u8, item = "}")
}

// No modo --tipos, "tipo" e o tipo resolvido (texto); o tipo escrito passa a "tipo_escrito".
// C: semantic/ast_json.c:262
proc chave_do_tipo_escrito(j: ^Json) -> str {
    if j.tipos {
        return "tipo_escrito"
    }
    return "tipo"
}

// O segmento do id e sempre "tipo": o id do tipo escrito nao muda entre o modo comum e o --tipos.
// C: semantic/ast_json.c:268
proc chave_tipo(j: ^Json, t: ^frontend.TipoRef) {
    chave(j, chave_do_tipo_escrito(j))
    filho_tipo(j, "tipo", t)
}

// "<chave>": "<texto do tipo>" so no modo --tipos e se a semantica resolveu o tipo.
// C: semantic/ast_json.c:275
proc chave_tipo_texto(j: ^Json, chave: str, tipo: u32) {
    if (not j.tipos) or (tipo == (frontend.TIPO_NAO_RESOLVIDO as u32)) {
        return
    }
    chave(j, chave)
    append(j.b as ^[dynamic]u8, item = "\"")
    tipo_anexar_texto(&(j.sem as ^Semantica).tipos, tipo, j.b as ^[dynamic]u8)
    append(j.b as ^[dynamic]u8, item = "\"")
}

// C: semantic/ast_json.c:286
proc ex_numero(j: ^Json, e: ^frontend.Expr) {
    let f: ^common.Fonte = j.fonte as ^common.Fonte
    let ini: u64 = e.pos_op as u64
    var n: u64 = 0
    // v1.10: o texto do literal vai como foi escrito
    if (e.tipo_no == (frontend.EX_INT as u8)) and (f.texto[ini] == 48) and ((f.texto[ini + 1] == 120) or (f.texto[ini + 1] == 98)) { // '0' 'x' 'b'
        n = 2
        while eh_alnum_ascii(f.texto[ini + n]) {
            n += 1
        }
    }
    while (f.texto[ini + n] >= 48) and (f.texto[ini + n] <= 57) {
        n += 1
    }
    if (f.texto[ini + n] == 46) and (f.texto[ini + n + 1] >= 48) and (f.texto[ini + n + 1] <= 57) { // '.'
        n += 1
        while (f.texto[ini + n] >= 48) and (f.texto[ini + n] <= 57) {
            n += 1
        }
    }
    chave(j, "texto")
    texto_json(j, f.texto[ini..<(ini + n)], false)
}

// C: semantic/ast_json.c:303
proc ex_bool(j: ^Json, e: ^frontend.Expr) {
    chave_bool(j, "valor", e.op != 0)
}

// B12: o #load traz "load": true; "texto" e o caminho antes de ResolverLoads e o conteudo depois (forja ast --tipos).
// C: semantic/ast_json.c:309
proc ex_texto(j: ^Json, e: ^frontend.Expr) {
    chave_nome(j, "texto", e.nome)
    if e.carregar {
        chave_bool(j, "load", true)
    }
}

// C: semantic/ast_json.c:315
proc ex_nome(j: ^Json, e: ^frontend.Expr) {
    chave_nome(j, "nome", e.nome)
}

// C: semantic/ast_json.c:320
proc ex_campo(j: ^Json, e: ^frontend.Expr) {
    chave_nome(j, "nome", e.nome)
    chave_expr(j, "base", e.a)
}

// Expressao que e o elemento 'indice' de uma lista: o id leva ".../chave[i]".
// C: semantic/ast_json.c:327
proc elemento_expr(j: ^Json, chave: str, indice: i32, e: ?^frontend.Expr) {
    let antes: u64 = id_empurrar(j, chave, indice)
    expr_json(j, e)
    id_restaurar(j, antes)
}

// C: semantic/ast_json.c:334
proc args_lista_json(j: ^Json, e: ^frontend.Expr, chave: str) {
    chave(j, chave)
    append(j.b as ^[dynamic]u8, item = "[")
    for i in (0 as u32)..<e.nargs {
        let a: ^frontend.Arg = &(e.args or_else {})[i]
        let antes: u64 = id_empurrar(j, chave, i as i32)
        if i != 0 {
            append(j.b as ^[dynamic]u8, item = ", {")
        } else {
            append(j.b as ^[dynamic]u8, item = "{")
        }
        if a.nome >= 0 {
            append(j.b as ^[dynamic]u8, item = "\"nome\": ")
            nome_json(j, a.nome)
            append(j.b as ^[dynamic]u8, item = ", ")
        }
        append(j.b as ^[dynamic]u8, item = "\"valor\": ")
        elemento_expr(j, "valor", -1, a.valor)
        append(j.b as ^[dynamic]u8, item = "}")
        id_restaurar(j, antes)
    }
    append(j.b as ^[dynamic]u8, item = "]")
}

// C: semantic/ast_json.c:355
proc args_json(j: ^Json, e: ^frontend.Expr, chave: str) {
    chave_nome(j, "nome", e.nome)
    args_lista_json(j, e, chave)
}

// C: semantic/ast_json.c:361
proc ex_chamada(j: ^Json, e: ^frontend.Expr) {
    args_json(j, e, "args")
}

// v1.12: chamada sobre expressao de tipo proc: "chamado" e "args".
// C: semantic/ast_json.c:367
proc ex_chamada_ind(j: ^Json, e: ^frontend.Expr) {
    chave_expr(j, "chamado", e.a)
    args_lista_json(j, e, "args")
}

// C: semantic/ast_json.c:373
proc ex_literal_struct(j: ^Json, e: ^frontend.Expr) {
    args_json(j, e, "campos")
}

// C: semantic/ast_json.c:378
proc ex_unario(j: ^Json, e: ^frontend.Expr) {
    chave_expr(j, "operando", e.a)
}

// C: semantic/ast_json.c:383
proc ex_binario(j: ^Json, e: ^frontend.Expr) {
    chave_pos(j, "op_pos", e.pos_op)
    chave_expr(j, "a", e.a)
    chave_expr(j, "b", e.b)
}

// C: semantic/ast_json.c:390
proc ex_conversao(j: ^Json, e: ^frontend.Expr) {
    chave(j, "alvo")
    filho_tipo(j, "alvo", e.alvo)
    chave_expr(j, "valor", e.a)
}

// C: semantic/ast_json.c:397
proc ex_none(j: ^Json, e: ^frontend.Expr) {
}

// C: semantic/ast_json.c:403
proc ex_try(j: ^Json, e: ^frontend.Expr) {
    chave_expr(j, "valor", e.a)
}

// C: semantic/ast_json.c:408
proc ex_or_else(j: ^Json, e: ^frontend.Expr) {
    chave_expr(j, "a", e.a)
    chave_expr(j, "b", e.b)
}

// C: semantic/ast_json.c:414
proc ex_indice(j: ^Json, e: ^frontend.Expr) {
    chave_expr(j, "base", e.a)
    chave_expr(j, "indice", e.b)
    if e.nargs == 1 {
        chave_expr(j, "indice2", (e.args or_else {})[0].valor)
    }
}

// C: semantic/ast_json.c:421
proc ex_fatia(j: ^Json, e: ^frontend.Expr) {
    chave_expr(j, "base", e.a)
    if e.nargs == 2 {
        chave_expr(j, "inicio", (e.args or_else {})[0].valor)
        chave_expr(j, "ate", (e.args or_else {})[1].valor) // AST 1.0: era "fim", que agora e a posicao final de todo no
    }
    chave(j, "limite")
    format(f"\"{LIMITES[e.op]}\"", into = j.b as ^[dynamic]u8)
}

// C: semantic/ast_json.c:433
proc ex_literal_array(j: ^Json, e: ^frontend.Expr) {
    chave(j, "elementos")
    append(j.b as ^[dynamic]u8, item = "[")
    for i in (0 as u32)..<e.nargs {
        if i != 0 {
            append(j.b as ^[dynamic]u8, item = ", ")
        }
        elemento_expr(j, "elementos", i as i32, (e.args or_else {})[i].valor)
    }
    append(j.b as ^[dynamic]u8, item = "]")
}

// C: semantic/ast_json.c:444
proc ex_tipo(j: ^Json, e: ^frontend.Expr) {
    chave(j, "tipo_escrito")
    filho_tipo(j, "tipo", e.alvo)
}

// C: semantic/ast_json.c:450
proc ex_embrulha(j: ^Json, e: ^frontend.Expr) {
    chave_expr(j, "valor", e.a)
}

// C: semantic/ast_json.c:455
proc ex_opc_teste(j: ^Json, e: ^frontend.Expr) {
    chave_bool(j, "e_none", e.op != 0)
    chave_expr(j, "valor", e.a)
}

// C: semantic/ast_json.c:461
proc ex_tupla(j: ^Json, e: ^frontend.Expr) {
    chave(j, "valores")
    append(j.b as ^[dynamic]u8, item = "[")
    for i in (0 as u32)..<e.nargs {
        if i != 0 {
            append(j.b as ^[dynamic]u8, item = ", ")
        }
        elemento_expr(j, "valores", i as i32, (e.args or_else {})[i].valor)
    }
    append(j.b as ^[dynamic]u8, item = "]")
}

// "partes": [{"texto": "..."} | {"valor": {...}, "formato"?: "08.3"}]
// C: semantic/ast_json.c:473
proc ex_f_texto(j: ^Json, e: ^frontend.Expr) {
    chave(j, "partes")
    append(j.b as ^[dynamic]u8, item = "[")
    for i in (0 as u32)..<e.nargs {
        let a: ^frontend.Arg = &(e.args or_else {})[i]
        let antes: u64 = id_empurrar(j, "partes", i as i32)
        if i != 0 {
            append(j.b as ^[dynamic]u8, item = ", ")
        }
        if ((a.valor as ^frontend.Expr).tipo_no == (frontend.EX_TEXTO as u8)) and (a.nome < 0) and (a.indice < 0) {
            append(j.b as ^[dynamic]u8, item = "{\"texto\": ")
            nome_json(j, (a.valor as ^frontend.Expr).nome)
        } else {
            append(j.b as ^[dynamic]u8, item = "{\"valor\": ")
            elemento_expr(j, "valor", -1, a.valor)
            if a.nome >= 0 {
                chave_nome(j, "formato", a.nome)
            }
        }
        append(j.b as ^[dynamic]u8, item = "}")
        id_restaurar(j, antes)
    }
    append(j.b as ^[dynamic]u8, item = "]")
}

// Operador por nome: unario e binario escrevem "op" antes dos filhos.
// C: semantic/ast_json.c:507
proc operador_json(j: ^Json, e: ?^frontend.Expr) {
    chave(j, "op")
    format(f"\"{NOMES_OP[(e as ^frontend.Expr).op]}\"", into = j.b as ^[dynamic]u8)
}

// C: semantic/ast_json.c:513
proc expr_json(j: ^Json, e: ?^frontend.Expr) {
    let ee: ^frontend.Expr = e as ^frontend.Expr
    abre_no(j, NOMES_EXPR[ee.tipo_no], ee.pos, frontend.ast_fim_expr(&j.fim, e))
    chave_tipo_texto(j, "tipo", ee.tipo)
    if ee.modulo != 0 {
        chave_modulo_em(j, ee.pos)
    }
    ref_da_expr(j, e)
    if (ee.tipo_no == (frontend.EX_UNARIO as u8)) or (ee.tipo_no == (frontend.EX_BINARIO as u8)) {
        operador_json(j, e)
    }
    chamar_imprime_expr(EXPRESSOES[ee.tipo_no], j, ee)
    append(j.b as ^[dynamic]u8, item = "}")
}

// C: semantic/ast_json.c:528
proc st_let_var(j: ^Json, s: ^frontend.Stmt) {
    local_registrar(j, s.pos)
    chave_nome(j, "nome", s.nome)
    chave_tipo_texto(j, "tipo", s.tipo_local)
    if s.tem_tipo {
        chave_tipo(j, &s.tipo)
    }
    chave_expr(j, "valor", s.expr)
}

// C: semantic/ast_json.c:537
proc st_atribuicao(j: ^Json, s: ^frontend.Stmt) {
    chave(j, "op")
    format(f"\"{OPS_ATRIBUICAO[s.op]}\"", into = j.b as ^[dynamic]u8)
    chave_expr(j, "alvo", s.alvo)
    chave_expr(j, "valor", s.expr)
}

// C: semantic/ast_json.c:546
proc st_if(j: ^Json, s: ^frontend.Stmt) {
    chave_expr(j, "cond", s.expr)
    chave_corpo(j, "entao", s.corpo)
    if s.senao != none {
        chave_corpo(j, "senao", s.senao)
    }
}

// C: semantic/ast_json.c:553
proc st_while(j: ^Json, s: ^frontend.Stmt) {
    chave_expr(j, "cond", s.expr)
    chave_corpo(j, "corpo", s.corpo)
}

// for de colecao: {"item", "por_ref", "indice"?, "colecao", "tipo"?, "corpo"}
// C: semantic/ast_json.c:560
proc st_for_colecao(j: ^Json, s: ^frontend.Stmt) {
    chave_nome(j, "item", s.nome)
    chave_bool(j, "por_ref", s.item_ref)
    if s.nome_indice >= 0 {
        chave_nome(j, "indice", s.nome_indice)
    }
    chave_expr(j, "colecao", s.expr)
    chave_tipo_texto(j, "tipo", s.tipo_local)
    chave_corpo(j, "corpo", s.corpo)
}

// C: semantic/ast_json.c:570
proc st_for(j: ^Json, s: ^frontend.Stmt) {
    local_registrar(j, s.pos)
    if s.expr2 == none {
        st_for_colecao(j, s)
        return
    }
    chave_nome(j, "var", s.nome)
    chave_tipo_texto(j, "tipo", s.tipo_local)
    chave_expr(j, "de", s.expr)
    chave_expr(j, "ate", s.expr2)
    chave_bool(j, "inclusivo", not s.faixa_excl)
    chave_corpo(j, "corpo", s.corpo)
}

// C: semantic/ast_json.c:585
proc st_return(j: ^Json, s: ^frontend.Stmt) {
    if s.expr != none {
        chave_expr(j, "valor", s.expr)
    }
}

// C: semantic/ast_json.c:590
proc st_chamada(j: ^Json, s: ^frontend.Stmt) {
    chave_expr(j, "expr", s.expr)
}

// C: semantic/ast_json.c:595
proc st_sem_campos(j: ^Json, s: ^frontend.Stmt) {
}

// C: semantic/ast_json.c:601
proc st_defer(j: ^Json, s: ^frontend.Stmt) {
    let antes: u64 = id_empurrar(j, "comando", -1)
    chave(j, "comando")
    stmt_json(j, s.corpo)
    id_restaurar(j, antes)
}

// C: semantic/ast_json.c:609
proc caso_json(j: ^Json, c: ^frontend.Caso) {
    abre_objeto(j, c.pos, frontend.ast_fim_caso(&j.fim, c))
    local_registrar(j, c.pos)
    ref_do_caso(j, c)
    chave_bool(j, "padrao", c.padrao)
    chave_tipo_texto(j, "tipo", c.tipo)
    if c.modulo != 0 { // o apelido vem logo depois do 'case'
        let f: ^common.Fonte = j.fonte as ^common.Fonte
        var k: u64 = (c.pos as u64) + 4
        while (f.texto[k] == 32) or (f.texto[k] == 9) { // ' ' '\t'
            k += 1
        }
        chave_modulo_em(j, k as u32)
    }
    if c.tipo_escrito != none {
        chave(j, "tipo_escrito")
        filho_tipo(j, "tipo", c.tipo_escrito)
    } else if not c.padrao {
        chave_nome(j, chave_do_tipo_escrito(j), c.tipo_nome)
    }
    if c.membro >= 0 {
        chave_nome(j, "membro", c.membro)
    }
    chave_corpo(j, "corpo", c.corpo)
    append(j.b as ^[dynamic]u8, item = "}")
}

// C: semantic/ast_json.c:632
proc st_switch(j: ^Json, s: ^frontend.Stmt) {
    chave_expr(j, "valor", s.expr)
    if s.nome >= 0 {
        chave_nome(j, "liga", s.nome)
    }
    chave(j, "casos")
    append(j.b as ^[dynamic]u8, item = "[")
    for i in (0 as u32)..<s.ncasos {
        let antes: u64 = id_empurrar(j, "casos", i as i32)
        if i != 0 {
            append(j.b as ^[dynamic]u8, item = ", ")
        }
        caso_json(j, &(s.casos or_else {})[i])
        id_restaurar(j, antes)
    }
    append(j.b as ^[dynamic]u8, item = "]")
}

// C: semantic/ast_json.c:647
proc st_expect(j: ^Json, s: ^frontend.Stmt) {
    chave_expr(j, "cond", s.expr)
}

// {"mutavel": bool, "nomes": ["q", "_"], "valor": {...}}
// C: semantic/ast_json.c:653
proc st_let_multiplo(j: ^Json, s: ^frontend.Stmt) {
    local_registrar(j, s.pos)
    chave_bool(j, "mutavel", s.op != 0)
    chave(j, "nomes")
    append(j.b as ^[dynamic]u8, item = "[")
    for i in (0 as u32)..<s.ncasos { // C2F-06: Stmt.nnomes e o mesmo campo que ncasos
        if i != 0 {
            append(j.b as ^[dynamic]u8, item = ", ")
        }
        nome_json(j, (s.nomes or_else {})[i].nome)
    }
    append(j.b as ^[dynamic]u8, item = "]")
    chave_expr(j, "valor", s.expr)
}

// C: semantic/ast_json.c:675
proc stmt_json(j: ^Json, s: ?^frontend.Stmt) {
    let ss: ^frontend.Stmt = s as ^frontend.Stmt
    abre_no(j, NOMES_STMT[ss.tipo_no], ss.pos, frontend.ast_fim_stmt(&j.fim, s))
    chamar_imprime_stmt(COMANDOS[ss.tipo_no], j, ss)
    append(j.b as ^[dynamic]u8, item = "}")
}
