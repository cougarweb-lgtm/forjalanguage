import "common"
import "frontend"

pub struct IndUso {
    pos: u32
    pos_nome: u32
    decl_pos: u32
    ordem: u32
    alvo: ?^frontend.Decl
    dono: ?^frontend.Decl
    nome: i32
    indice: i32
    alvo_tipo: u8
    chamada: bool
}

pub struct Indice {
    sem: ?^Semantica
    refs: AstRefs
    usos: [dynamic]IndUso
}

pub const IND_PROC: i32 = 0
pub const IND_STRUCT: i32 = 1
pub const IND_ENUM: i32 = 2
pub const IND_UNIAO: i32 = 3
pub const IND_CONST: i32 = 4
pub const IND_UNIDADE: i32 = 5
pub const IND_MEMBRO: i32 = 6
pub const IND_CAMPO: i32 = 7
pub const IND_PARAM: i32 = 8
pub const IND_LOCAL: i32 = 9
pub const IND_EMBUTIDO: i32 = 10
// C2F-71: o `static const char *const NOMES[]` local de IndiceNomeDoAlvo vira const de topo
const NOMES_DO_ALVO: [11]str = {"proc", "struct", "enum", "union", "const", "unit", "membro", "campo", "param", "local", "embutido"}

// C: semantic/indice.c:14
pub proc indice_alvo_da_decl(d: ?^frontend.Decl) -> i32 {
    let sw_1 = common.c2f_s2u_32(((d as ^frontend.Decl).tipo_no as i32))
    if sw_1 == (frontend.D_CONST as u32) {
        return IND_CONST
    } else if sw_1 == (frontend.D_STRUCT as u32) {
        return IND_STRUCT
    } else if sw_1 == (frontend.D_ENUM as u32) {
        return IND_ENUM
    } else if sw_1 == (frontend.D_UNIAO as u32) {
        return IND_UNIAO
    } else if sw_1 == (frontend.D_PROC as u32) {
        return IND_PROC
    } else {
        return IND_UNIDADE
    }
    return 0
}

// C: semantic/indice.c:26
proc eh_decl_de_tipo(d: ?^frontend.Decl) -> bool {
    return (((((d as ^frontend.Decl).tipo_no == (frontend.D_STRUCT as u8)) or ((d as ^frontend.Decl).tipo_no == (frontend.D_ENUM as u8))) or ((d as ^frontend.Decl).tipo_no == (frontend.D_UNIAO as u8))) or ((d as ^frontend.Decl).tipo_no == (frontend.D_UNIDADE_BASE as u8))) or ((d as ^frontend.Decl).tipo_no == (frontend.D_UNIDADE_DERIV as u8))
}

// C: semantic/indice.c:31
proc indice_indice_do_membro(d: ?^frontend.Decl, membro: i32) -> i32 {
    for k in (0 as u32)..<(d as ^frontend.Decl).nmembros {
        if ((d as ^frontend.Decl).membros or_else {})[k].nome == membro {
            return transmute(k, to = i32)
        }
    }
    return -1
}

// C: semantic/indice.c:39
pub proc indice_decl_do_nome(ind: ^Indice, nome: i32, modulo: u8) -> ?^frontend.Decl {
    return ast_refs_decl_do_nome(&ind.refs, nome, 0, modulo)
}

// C: semantic/indice.c:44
pub proc indice_categoria(d: ?^frontend.Decl) -> str {
    let sw_1 = common.c2f_s2u_32(((d as ^frontend.Decl).tipo_no as i32))
    if sw_1 == (frontend.D_UNIDADE_BASE as u32) or sw_1 == (frontend.D_UNIDADE_DERIV as u32) {
        return "unit"
    } else if sw_1 == (frontend.D_CONST as u32) {
        return "const"
    } else if sw_1 == (frontend.D_STRUCT as u32) {
        return "struct"
    } else if sw_1 == (frontend.D_ENUM as u32) {
        return "enum"
    } else if sw_1 == (frontend.D_PROC as u32) {
        var tern_1: str = "proc"
        if common.c2f_b2i32((d as ^frontend.Decl).externo) != 0 {
            tern_1 = "foreign"
        }
        return tern_1
    } else if sw_1 == (frontend.D_TEST as u32) {
        return "teste"
    } else if sw_1 == (frontend.D_LINK as u32) {
        return "link"
    } else if sw_1 == (frontend.D_UNIAO as u32) {
        return "union"
    } else if sw_1 == (frontend.D_IMPORT as u32) {
        return "import"
    } else if sw_1 == (frontend.D_ASSERT as u32) {
        return "static_assert"
    }
    return "?"
}

// C: semantic/indice.c:62
pub proc indice_nome_do_alvo(alvo: i32) -> str {
    return NOMES_DO_ALVO[alvo as int]
}

// C: semantic/indice.c:68
proc uso_base(pos: u32, pos_nome: u32, nome: i32, dono: ?^frontend.Decl) -> IndUso {
    return IndUso{pos = pos, pos_nome = pos_nome, decl_pos = AST_REF_SEM_POS as u32, dono = dono, nome = nome, indice = -1}
}

// C: semantic/indice.c:74
proc uso_de_local(r: ^AstRefEntrada, u: ^IndUso) -> bool {
    let param: bool = (r.e as ^frontend.Expr).ref == (frontend.REF_PARAM as u8)
    if (r.decl_pos == (AST_REF_SEM_POS as u32)) or ((r.e as ^frontend.Expr).pos_op == r.decl_pos) {
        return false
    }
    var tern_1: i32 = IND_LOCAL
    if common.c2f_b2i32(param) != 0 {
        tern_1 = IND_PARAM
    }
    u.alvo_tipo = tern_1 as u8
    u.alvo = r.dono
    u.decl_pos = r.decl_pos
    var tern_2: i32 = -1
    if common.c2f_b2i32(param) != 0 {
        tern_2 = (r.e as ^frontend.Expr).ref_id
    }
    u.indice = tern_2
    return true
}

// C: semantic/indice.c:87
proc uso_de_membro(ind: ^Indice, e: ?^frontend.Expr, u: ^IndUso) -> bool {
    let membro: bool = (e as ^frontend.Expr).ref == (frontend.REF_MEMBRO as u8)
    var tern_1: u32 = ((e as ^frontend.Expr).a as ^frontend.Expr).tipo
    if common.c2f_b2i32(membro) != 0 {
        tern_1 = (e as ^frontend.Expr).tipo
    }
    let d: ?^frontend.Decl = ast_refs_decl_do_tipo(&ind.refs, tern_1)
    if d == none {
        return false
    }
    if (not membro) and (((e as ^frontend.Expr).a as ^frontend.Expr).pos_op == (e as ^frontend.Expr).pos_op) {
        return false
    }
    u.alvo = d
    var tern_2: i32 = IND_CAMPO
    if common.c2f_b2i32(membro) != 0 {
        tern_2 = IND_MEMBRO
    }
    u.alvo_tipo = tern_2 as u8
    u.indice = (e as ^frontend.Expr).ref_id
    return true
}

// C: semantic/indice.c:101
// O nome do embutido esta mesmo escrito em pos_op? O delete que 'em = escopo' cria nasce na posicao do let, sem o texto 'delete'.
// Semantica.nomes e ?[]Interner no esqueleto (C: Interner *): o ponteiro e o elemento 0 do slice.
proc escrito_na_posicao(sem: ^Semantica, e: ?^frontend.Expr) -> bool {
    let nomes_view: []common.Interner = sem.nomes or_else {}
    let nomes: ^common.Interner = &nomes_view[0]
    let ee = e as ^frontend.Expr
    let n: u32 = common.interner_tam(nomes, ee.nome)
    let fonte = sem.fonte as ^common.Fonte
    if ((ee.pos_op as u64) + (n as u64)) > (fonte.tam as u64) {
        return false
    }
    let texto: str = common.interner_texto(nomes, ee.nome)
    for k in 0..<(n as int) {
        if fonte.texto[(ee.pos_op as int) + k] != texto[k] {
            return false
        }
    }
    return true
}

// C: semantic/indice.c:109
proc uso_de_expr(ind: ^Indice, r: ^AstRefEntrada, u: ^IndUso) -> bool {
    let e: ?^frontend.Expr = r.e
    var d: ?^frontend.Decl = none
    u^ = uso_base((e as ^frontend.Expr).pos, (e as ^frontend.Expr).pos_op, (e as ^frontend.Expr).nome, r.dono)
    u.chamada = (e as ^frontend.Expr).tipo_no == (frontend.EX_CHAMADA as u8)
    let sw_1 = common.c2f_s2u_32(((e as ^frontend.Expr).ref as i32))
    if sw_1 == (frontend.REF_LOCAL as u32) or sw_1 == (frontend.REF_PARAM as u32) {
        return uso_de_local(r, u)
    } else if sw_1 == (frontend.REF_MEMBRO as u32) or sw_1 == (frontend.REF_CAMPO as u32) {
        return uso_de_membro(ind, e, u)
    } else if sw_1 == (frontend.REF_EMBUTIDO as u32) {
        u.alvo_tipo = IND_EMBUTIDO as u8
        return escrito_na_posicao(ind.sem as ^Semantica, e)
    } else if sw_1 == (frontend.REF_CONST as u32) or sw_1 == (frontend.REF_ENUM as u32) or sw_1 == (frontend.REF_PROC as u32) or sw_1 == (frontend.REF_STRUCT as u32) {
        var tern_1: i32 = 0
        if r.dono != none {
            tern_1 = (r.dono as ^frontend.Decl).modulo as i32
        }
        d = ast_refs_decl_do_nome(&ind.refs, (e as ^frontend.Expr).nome, (e as ^frontend.Expr).modulo, tern_1 as u8)
        if d == none {
            return false
        }
        u.alvo = d
        u.alvo_tipo = indice_alvo_da_decl(d) as u8
        return true
    } else {
        return false
    }
    return false
}

// C: semantic/indice.c:136
proc uso_de_tipo(ind: ^Indice, t: ^AstRefTipo, u: ^IndUso) -> bool {
    var tern_1: i32 = 0
    if t.dono != none {
        tern_1 = (t.dono as ^frontend.Decl).modulo as i32
    }
    let d: ?^frontend.Decl = ast_refs_decl_do_nome(&ind.refs, t.nome, t.modulo, tern_1 as u8)
    var membro: i32 = 0
    if (d == none) or ((t.classe == (AST_USO_NOME_DE_TIPO as u8)) and (not eh_decl_de_tipo(d))) {
        return false
    }
    u^ = uso_base(t.pos, t.pos, t.nome, t.dono)
    u.alvo = d
    u.alvo_tipo = indice_alvo_da_decl(d) as u8
    var tern_2: i32 = -1
    if ((t.classe == (AST_USO_CASO as u8)) and (t.membro >= 0)) and ((d as ^frontend.Decl).tipo_no == (frontend.D_ENUM as u8)) {
        tern_2 = indice_indice_do_membro(d, t.membro)
    }
    membro = tern_2
    if membro >= 0 {
        u.alvo_tipo = IND_MEMBRO as u8
        u.indice = membro
    }
    return true
}

// C: semantic/indice.c:153
proc comparar_numeros(a: i64, b: i64) -> i32 {
    return common.c2f_b2i32(a > b) - common.c2f_b2i32(a < b)
}

// C: semantic/indice.c:158
// C2F-B0: comparador de qsort (const void * -> ^IndUso, os casts somem)
proc comparar_usos(a: ^IndUso, b: ^IndUso) -> i32 {
    var r: i32 = comparar_numeros(a.pos as i64, b.pos as i64)
    if r == 0 {
        r = comparar_numeros(a.pos_nome as i64, b.pos_nome as i64)
    }
    if r == 0 {
        r = comparar_numeros(a.alvo_tipo as i64, b.alvo_tipo as i64)
    }
    if r == 0 {
        r = comparar_numeros(a.indice as i64, b.indice as i64)
    }
    if r == 0 {
        r = comparar_numeros(a.decl_pos as i64, b.decl_pos as i64)
    }
    if r == 0 {
        var pos_a: u32 = 0
        var pos_b: u32 = 0
        if a.alvo != none {
            pos_a = (a.alvo as ^frontend.Decl).pos
        }
        if b.alvo != none {
            pos_b = (b.alvo as ^frontend.Decl).pos
        }
        r = comparar_numeros(pos_a as i64, pos_b as i64)
    }
    return r
}

// C: semantic/indice.c:172
// Ordem total: a chave de comparar_usos e, nos empates, a ordem de coleta (quem vem primeiro e o que remover_repetidos guarda).
proc ordenar_usos(a: ^IndUso, b: ^IndUso) -> i32 {
    let r: i32 = comparar_usos(a, b)
    if r != 0 {
        return r
    }
    return comparar_numeros(a.ordem as i64, b.ordem as i64)
}

// C2F-B0: o par `_menor` do sort_by
proc ordenar_usos_menor(a: ^IndUso, b: ^IndUso) -> bool {
    return ordenar_usos(a, b) < 0
}

// C: semantic/indice.c:180
// A semantica gera comandos sinteticos (defer do 'em = escopo') que repetem a posicao do uso original: ficam so os distintos.
proc remover_repetidos(usos: ^[dynamic]IndUso) {
    var saida: int = 0
    for i in 0..<len(usos^) {
        if (saida > 0) and (comparar_usos(&usos[saida - 1], &usos[i]) == 0) {
            continue
        }
        usos[saida] = usos[i]
        saida += 1
    }
    truncate(usos, saida)
}

// C: semantic/indice.c:191
pub proc indice_montar(ind: ^Indice, sem: ^Semantica) {
    ind.sem = sem
    ast_refs_montar(&ind.refs, sem)
    ind.usos = make([dynamic]IndUso, alloc = heap)
    for i in 0..<len(ind.refs.entradas) {
        var u: IndUso = IndUso{}
        if uso_de_expr(ind, &ind.refs.entradas[i], &u) {
            append(&ind.usos, item = u)
        }
    }
    for i in 0..<len(ind.refs.tipos) {
        var u: IndUso = IndUso{}
        if uso_de_tipo(ind, &ind.refs.tipos[i], &u) {
            append(&ind.usos, item = u)
        }
    }
    for i in 0..<len(ind.usos) {
        ind.usos[i].ordem = i as u32
    }
    sort_by(ind.usos[0..<len(ind.usos)], less = ordenar_usos_menor)
    remover_repetidos(&ind.usos)
}

// C: semantic/indice.c:209
pub proc indice_liberar(ind: ^Indice) {
    delete(ind.usos)
    ast_refs_liberar(&ind.refs)
}

// G3 P-front A: nomes dos alvos, categoria de declaracao e ordem total dos usos (pos, pos_nome, ..., ordem); remover_repetidos guarda o primeiro coletado
test "indice: alvo, categoria, ordem e repetidos" {
    expect(indice_nome_do_alvo(IND_PROC) == "proc" and indice_nome_do_alvo(IND_LOCAL) == "local" and indice_nome_do_alvo(IND_EMBUTIDO) == "embutido")
    var proc_externo: frontend.Decl = frontend.Decl{tipo_no = frontend.D_PROC as u8, externo = true}
    var struct_d: frontend.Decl = frontend.Decl{tipo_no = frontend.D_STRUCT as u8}
    expect(indice_categoria(&proc_externo) == "foreign" and indice_categoria(&struct_d) == "struct")
    expect(indice_alvo_da_decl(&proc_externo) == IND_PROC and indice_alvo_da_decl(&struct_d) == IND_STRUCT)
    var usos = make([dynamic]IndUso, alloc = heap)
    defer delete(usos)
    append(&usos, item = IndUso{pos = 9, pos_nome = 9, decl_pos = 0, ordem = 0, nome = 1, indice = -1})
    append(&usos, item = IndUso{pos = 3, pos_nome = 3, decl_pos = 0, ordem = 1, nome = 2, indice = -1})
    append(&usos, item = IndUso{pos = 3, pos_nome = 3, decl_pos = 0, ordem = 2, nome = 3, indice = -1})
    sort_by(usos[0..<len(usos)], less = ordenar_usos_menor)
    remover_repetidos(&usos)
    expect(len(usos) == 2 and usos[0].pos == 3 and usos[0].nome == 2 and usos[1].pos == 9)
}
