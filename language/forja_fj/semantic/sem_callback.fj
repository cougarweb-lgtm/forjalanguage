import "common"
import "frontend"

const PARAMS_MAX_CALLBACK: i32 = 16
const MOTIVO_MAX: i32 = 256

// C: semantic/sem_callback.c:22
proc sem_marcar_proc_valor(s: ^Semantica, pos: u32) {
    if s.usa_proc_valor {
        return
    }
    s.usa_proc_valor = true
    s.pos_proc_valor = pos
}

// C: semantic/sem_callback.c:30
proc conferir_assinatura(s: ^Semantica, tipo: u32, pos: u32) -> bool {
    var motivo_buf: [256]u8 = {}
    var texto: [160]u8 = {}
    let motivo: ?str = sem_motivo_do_proc(s, tipo, motivo_buf[..], 256)
    if motivo == none {
        return true
    }
    sem_descrever(s, tipo, texto[..], 160)
    let nome_tipo = from_bytes(texto[0..<common.c2f_strlen_b(texto[..])], alloc = heap)
    defer delete(nome_tipo)
    let texto_motivo: str = motivo or_else ""
    let msg_1 = format(f"a assinatura '{nome_tipo}' nao atravessa a fronteira C: {texto_motivo}", alloc = heap)
    defer delete(msg_1)
    return sem_erro(s, common.E0909, pos, msg_1)
}

// C: semantic/sem_callback.c:41
proc resolver_assinatura(s: ^Semantica, t: ?^frontend.TipoRef, tipo: ^u32) -> bool {
    let ref: ^frontend.TipoRef = t as ^frontend.TipoRef
    let alvo: []frontend.TipoRef = ref.alvo or_else {}
    var params: [16]u32 = {} // PARAMS_MAX_CALLBACK
    var nomes: [16]i32 = {}
    var a: ProcAssinatura = ProcAssinatura{params = params[..], nomes = nomes[..], n = common.c2f_s2u_32(ref.nome), retorno = TIPO_VAZIO as u32}
    var k: u32 = 1
    while k <= a.n {
        if not sem_resolver_tipo_ref(s, &alvo[k]) {
            return false
        }
        params[k - 1] = alvo[k].tipo
        nomes[k - 1] = alvo[a.n + k].nome
        k += 1
    }
    if ref.pos_tamanho == 1 {
        if not sem_resolver_tipo_ref(s, &alvo[0]) {
            return false
        }
        a.retorno = alvo[0].tipo
    }
    tipo^ = tipo_proc(&s.tipos, &a)
    return true
}

// C: semantic/sem_callback.c:60
proc sem_resolver_tipo_proc(s: ^Semantica, t: ?^frontend.TipoRef) -> bool {
    let ref: ^frontend.TipoRef = t as ^frontend.TipoRef
    let callback_de_foreign: bool = t == s.tipo_proc_permitido
    var tipo: u32 = 0
    if s.prof_tipo > 0 {
        let msg_1 = format(f"tipo proc(...) so vale inteiro (campo, let/var, parametro, retorno): ?proc, proc dentro de [N], [], [dynamic], map, union, soa, ^ e na assinatura de outro proc nao existem", alloc = heap)
        defer delete(msg_1)
        return sem_erro(s, common.E0907, ref.pos, msg_1)
    }
    s.prof_tipo += 1
    let resolvido: bool = resolver_assinatura(s, t, &tipo)
    s.prof_tipo -= 1
    if not resolvido {
        return false
    }
    ref.tipo = tipo
    if callback_de_foreign {
        return true // a fronteira C do parametro e conferida com o proc foreign (E0904)
    }
    sem_marcar_proc_valor(s, ref.pos)
    return s.adia_assinatura_proc or conferir_assinatura(s, tipo, ref.pos)
}

// C: semantic/sem_callback.c:79
proc sem_conferir_procs_da_struct(s: ^Semantica, d: ^frontend.Decl) -> bool {
    var i: u32 = 0
    while i < d.ncampos {
        let tipo: ^frontend.TipoRef = &(d.campos or_else {})[i].tipo
        if ((tipo.tipo != (frontend.TIPO_NAO_RESOLVIDO as u32)) and (common.c2f_s2u_32(tipo_classe_de(&s.tipos, tipo.tipo)) == (TC_PROC as u32))) and (not conferir_assinatura(s, tipo.tipo, tipo.pos)) {
            return false
        }
        i += 1
    }
    return true
}

// C: semantic/sem_callback.c:89
proc tipo_do_proc_como_valor(s: ^Semantica, d: ?^frontend.Decl) -> u32 {
    let decl: ^frontend.Decl = d as ^frontend.Decl
    var params: [16]u32 = {} // PARAMS_MAX_CALLBACK
    var nomes: [16]i32 = {}
    var retorno: u32 = TIPO_VAZIO as u32
    if decl.tem_retorno {
        retorno = decl.retorno.tipo
    }
    var a: ProcAssinatura = ProcAssinatura{params = params[..], nomes = nomes[..], n = decl.nparams, retorno = retorno}
    if decl.nparams > 16 {
        return frontend.TIPO_NAO_RESOLVIDO as u32
    }
    let lista: []frontend.Param = decl.params or_else {}
    var k: u32 = 0
    while k < decl.nparams {
        params[k] = lista[k].tipo.tipo
        nomes[k] = lista[k].nome
        k += 1
    }
    return tipo_proc(&s.tipos, &a)
}

// C: semantic/sem_callback.c:103
proc assinatura_diferente(s: ^Semantica, e: ^frontend.Expr, d: ?^frontend.Decl, ctx: u32, tipo: u32) -> bool {
    var achado: [160]u8 = {}
    var pedido: [160]u8 = {}
    if tipo == (frontend.TIPO_NAO_RESOLVIDO as u32) {
        let texto_achado = format(f"proc({(d as ^frontend.Decl).nparams} parametros)", alloc = heap)
        defer delete(texto_achado)
        _ = common.c2f_snprintf(achado[..], texto_achado)
    } else {
        sem_descrever(s, tipo, achado[..], 160)
    }
    sem_descrever(s, ctx, pedido[..], 160)
    let nome_achado = from_bytes(achado[0..<common.c2f_strlen_b(achado[..])], alloc = heap)
    defer delete(nome_achado)
    let nome_pedido = from_bytes(pedido[0..<common.c2f_strlen_b(pedido[..])], alloc = heap)
    defer delete(nome_pedido)
    let msg_1 = format(f"o proc '{sem_nome_texto(s, e.nome)}' tem assinatura '{nome_achado}', mas o parametro pede '{nome_pedido}'", alloc = heap)
    defer delete(msg_1)
    return sem_erro(s, common.E0907, e.pos_op, msg_1)
}

// C: semantic/sem_callback.c:115
proc sem_proc_como_callback(s: ^Semantica, e: ^frontend.Expr, y: ^Simbolo, ctx: u32) -> bool {
    let de_foreign: bool = s.valor_para_foreign
    let de_sort_by: bool = s.comparador_sort_by
    s.valor_para_foreign = false
    s.comparador_sort_by = false
    if (y.decl as ^frontend.Decl).externo {
        let msg_1 = format(f"'{sem_nome_texto(s, e.nome)}' e proc foreign: como valor (ou callback) precisa ser um proc da Forja (o C chama o trampolim dele); escreva um proc Forja com a assinatura pedida", alloc = heap)
        defer delete(msg_1)
        return sem_erro(s, common.E0907, e.pos_op, msg_1)
    }
    let tipo: u32 = tipo_do_proc_como_valor(s, y.decl)
    let ctx_proc: bool = (ctx != (frontend.TIPO_NAO_RESOLVIDO as u32)) and (common.c2f_s2u_32(tipo_classe_de(&s.tipos, ctx)) == (TC_PROC as u32))
    if (tipo == (frontend.TIPO_NAO_RESOLVIDO as u32)) or ((common.c2f_b2i32(ctx_proc) != 0) and (not tipo_proc_compativel(&s.tipos, ctx, tipo))) {
        return assinatura_diferente(s, e, y.decl, ctx, tipo)
    }
    if not de_foreign {
        sem_marcar_proc_valor(s, e.pos_op)
        if (not de_sort_by) and (not conferir_assinatura(s, tipo, e.pos_op)) {
            return false
        }
    }
    e.ref = frontend.REF_PROC as u8
    e.ref_id = y.indice
    var tern_1: u32 = tipo
    if common.c2f_b2i32(ctx_proc) != 0 {
        tern_1 = ctx
    }
    e.tipo = tern_1
    return true
}

// C: semantic/sem_callback.c:139
proc sem_converter_em_chamada_ind(s: ^Semantica, e: ^frontend.Expr) -> bool {
    let local: ?^LocalInfo = escopo_buscar(&s.escopo, e.nome)
    if (local == none) or (tipo_classe_de(&s.tipos, (local as ^LocalInfo).tipo) != TC_PROC) {
        return false
    }
    // C2F-20: ArenaAlocar(Expr) = lista de 1 elemento na arena (new(Expr) e E1003 fora do pacote frontend); *chamado = *e
    var no_chamado = make([dynamic]frontend.Expr, alloc = common.arena_mem(s.arena as ^common.Arena), cap = 1)
    append(&no_chamado, item = e^)
    let chamado: ^frontend.Expr = &no_chamado[0]
    chamado.tipo_no = frontend.EX_NOME as u8
    chamado.a = none
    chamado.b = none
    chamado.args = none
    chamado.nargs = 0
    chamado.flexivel = false
    chamado.ref = frontend.REF_NENHUM as u8
    chamado.tipo = frontend.TIPO_NAO_RESOLVIDO as u32
    e.tipo_no = frontend.EX_CHAMADA_IND as u8
    e.a = chamado
    return true
}

// C: semantic/sem_callback.c:160
proc chamar_com_tipo_proc(s: ^Semantica, e: ^frontend.Expr, proc_c: u32) -> bool {
    var params: [16]frontend.Param = {} // PARAMS_MAX_CALLBACK
    let n: u32 = tipo_proc_qtd(&s.tipos, proc_c)
    var k: u32 = 0
    while k < n {
        params[k] = frontend.Param{}
        params[k].nome = tipo_proc_nome(&s.tipos, proc_c, k)
        params[k].tipo.tipo = tipo_proc_param(&s.tipos, proc_c, k)
        k += 1
    }
    return sem_chamar_com_params(s, e, params[0..<(n as int)])
}

// C: semantic/sem_callback.c:173
proc sem_chamada_ind(s: ^Semantica, e: ^frontend.Expr) -> bool {
    var texto: [160]u8 = {}
    if not sem_checar(s, e.a, TIPO_VAZIO as u32) {
        return false
    }
    let proc_c: u32 = (e.a as ^frontend.Expr).tipo
    if proc_c == (TIPO_VENENO as u32) {
        e.tipo = sem_uso_de_veneno(s)
        return true
    }
    if tipo_classe_de(&s.tipos, proc_c) != TC_PROC {
        sem_descrever(s, proc_c, texto[..], 160)
        let nome_tipo = from_bytes(texto[0..<common.c2f_strlen_b(texto[..])], alloc = heap)
        defer delete(nome_tipo)
        let msg_1 = format(f"so se chama proc ou valor de tipo proc: este valor e {nome_tipo}", alloc = heap)
        defer delete(msg_1)
        return sem_erro(s, common.E0301, e.pos_op, msg_1)
    }
    sem_marcar_proc_valor(s, e.pos_op)
    if not chamar_com_tipo_proc(s, e, proc_c) {
        return false
    }
    e.tipo = tipo_de(&s.tipos, proc_c).a
    return true
}

// L4a: o tipo e proc, ou array/struct (por valor) que carrega um campo proc em qualquer profundidade; so a const assim espera os procs serem declarados
proc sem_tipo_tem_proc(s: ^Semantica, t: u32) -> bool {
    let k: ^TipoInfo = tipo_de(&s.tipos, t)
    if k.classe == (TC_PROC as u8) {
        return true
    }
    if k.classe == (TC_ARRAY as u8) {
        return sem_tipo_tem_proc(s, k.a)
    }
    if (k.classe != (TC_STRUCT as u8)) or (k.b != 0) {
        return false
    }
    let d: ?^frontend.Decl = (s.globais or_else {})[k.a].decl
    var i: u32 = 0
    while i < (d as ^frontend.Decl).ncampos {
        if sem_tipo_tem_proc(s, ((d as ^frontend.Decl).campos or_else {})[i].tipo.tipo) {
            return true
        }
        i += 1
    }
    return false
}

// C: semantic/sem_callback.c:196
proc sem_proc_sem_zero(s: ^Semantica, t: u32) -> bool {
    let k: ^TipoInfo = tipo_de(&s.tipos, t)
    if k.classe == (TC_PROC as u8) {
        return true
    }
    if k.classe == (TC_ARRAY as u8) {
        return sem_proc_sem_zero(s, k.a)
    }
    if (k.classe != (TC_STRUCT as u8)) or (k.b != 0) {
        return false
    }
    let d: ?^frontend.Decl = (s.globais or_else {})[k.a].decl
    var i: u32 = 0
    while i < (d as ^frontend.Decl).ncampos {
        if (((d as ^frontend.Decl).campos or_else {})[i].padrao == none) and (common.c2f_b2i32(sem_proc_sem_zero(s, ((d as ^frontend.Decl).campos or_else {})[i].tipo.tipo)) != 0) {
            return true
        }
        i += 1
    }
    return false
}
