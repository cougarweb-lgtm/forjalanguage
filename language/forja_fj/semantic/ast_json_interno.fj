import "common"
import "frontend"

struct AstGuardado {
    chave: u32
    off: u32
    tam: u32
}

struct Json {
    b: ?^[dynamic]u8
    fonte: ?^common.Fonte
    nomes: ?^common.Interner
    linhas: [dynamic]u32
    sem: ?^Semantica
    modulos: ?^frontend.Modulos
    refs: ?^AstRefs
    fim: frontend.AstFim
    id: [dynamic]u8
    locais: [dynamic]AstGuardado
    imports: [dynamic]AstGuardado
    guardados: [dynamic]u8
    linha_base: u32
    arquivo_decl: ?str
    modulo: u8
    tipos: bool
    sem_pos: bool
}
