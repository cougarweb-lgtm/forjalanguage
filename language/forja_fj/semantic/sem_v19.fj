import "common"
import "frontend"

// C: semantic/sem_v19.c:13
proc sem_resolver_tipo_v19(s: ^Semantica, t: ?^frontend.TipoRef, base: ^u32) -> bool {
    if (t as ^frontend.TipoRef).forma == (frontend.TR_BIT_SET as u8) {
        return resolver_bit_set(s, t, base)
    }
    if (t as ^frontend.TipoRef).forma == (frontend.TR_MATRIZ as u8) {
        return resolver_matriz(s, t, base)
    }
    if (t as ^frontend.TipoRef).forma == (frontend.TR_SOA as u8) {
        return resolver_soa(s, t, base)
    }
    return resolver_mapa(s, t, base)
}

// C: semantic/sem_v19.c:22
proc sem_indice_duplo(s: ^Semantica, e: ^frontend.Expr) -> bool {
    return sem_indice_matriz(s, e)
}

// C: semantic/sem_v19.c:28
proc classe_do_alvo(s: ^Semantica, t: u32, por_ponteiro: ^bool) -> i32 {
    let c: i32 = tipo_classe_de(&s.tipos, t)
    por_ponteiro^ = c == TC_PONTEIRO
    if por_ponteiro^ {
        return tipo_classe_de(&s.tipos, tipo_de(&s.tipos, t).a)
    }
    return c
}

// C: semantic/sem_v19.c:36
proc sem_eh_tipo_v19(s: ^Semantica, t: u32) -> bool {
    var por_ponteiro: bool = false
    return common.c2f_s2u_32(classe_do_alvo(s, t, &por_ponteiro)) >= (TC_MAPA as u32)
}

// C: semantic/sem_v19.c:43
proc sem_tipo_tem_v19(s: ^Semantica, t: u32) -> bool {
    let k: ^TipoInfo = tipo_de(&s.tipos, t)
    if (k.classe as i32) >= TC_MAPA {
        return true
    }
    if k.classe == (TC_ARRAY as u8) {
        return sem_tipo_tem_v19(s, k.a)
    }
    if k.classe != (TC_STRUCT as u8) {
        return false
    }
    let d: ?^frontend.Decl = (s.globais or_else {})[k.a].decl
    var i: u32 = 0
    while i < (d as ^frontend.Decl).ncampos {
        if sem_tipo_tem_v19(s, ((d as ^frontend.Decl).campos or_else {})[i].tipo.tipo) {
            return true
        }
        i += 1
    }
    return false
}

// C: semantic/sem_v19.c:57
proc sem_indice_v19(s: ^Semantica, e: ^frontend.Expr) -> bool {
    var por_ponteiro: bool = false
    let c: i32 = classe_do_alvo(s, (e.a as ^frontend.Expr).tipo, &por_ponteiro)
    if common.c2f_s2u_32(c) == (TC_BIT_SET as u32) {
        let msg_1 = format(f"bit_set nao se indexa: has(s, key = m)", alloc = heap)
        defer delete(msg_1)
        return sem_erro(s, common.E0319, e.pos_op, msg_1)
    }
    if common.c2f_s2u_32(c) == (TC_MATRIZ as u32) {
        let msg_2 = format(f"matrix se indexa com m[linha, coluna]", alloc = heap)
        defer delete(msg_2)
        return sem_erro(s, common.E0321, e.pos_op, msg_2)
    }
    if common.c2f_s2u_32(c) == (TC_SOA as u32) {
        return sem_indice_soa(s, e)
    }
    let msg_3 = format(f"map nao se indexa com []: get(m, key = k) le e insert(&m, key = k, value = v) grava", alloc = heap)
    defer delete(msg_3)
    return sem_erro(s, common.E0318, e.pos_op, msg_3)
}

// C: semantic/sem_v19.c:68
proc sem_literal_v19(s: ^Semantica, e: ^frontend.Expr, ctx: u32) -> bool {
    let c: i32 = tipo_classe_de(&s.tipos, ctx)
    if common.c2f_s2u_32(c) == (TC_BIT_SET as u32) {
        return sem_literal_bit_set(s, e, ctx)
    }
    if common.c2f_s2u_32(c) == (TC_MATRIZ as u32) {
        return sem_literal_matriz(s, e, ctx)
    }
    if common.c2f_s2u_32(c) == (TC_SOA as u32) {
        return sem_literal_soa(s, e, ctx)
    }
    let msg_1 = format(f"map nasce de make: make(map[K]V, alloc = heap); {{}} nao cria map", alloc = heap)
    defer delete(msg_1)
    return sem_erro(s, common.E0318, e.pos, msg_1)
}

// C: semantic/sem_v19.c:78
proc sem_conta_v19(s: ^Semantica, e: ^frontend.Expr) -> bool {
    let ca: i32 = tipo_classe_de(&s.tipos, (e.a as ^frontend.Expr).tipo)
    let cb: i32 = tipo_classe_de(&s.tipos, (e.b as ^frontend.Expr).tipo)
    if (common.c2f_s2u_32(ca) == (TC_MATRIZ as u32)) or (common.c2f_s2u_32(cb) == (TC_MATRIZ as u32)) {
        return sem_conta_matriz(s, e)
    }
    if (common.c2f_s2u_32(ca) == (TC_BIT_SET as u32)) or (common.c2f_s2u_32(cb) == (TC_BIT_SET as u32)) {
        return sem_conta_bit_set(s, e)
    }
    if (common.c2f_s2u_32(ca) == (TC_SOA as u32)) or (common.c2f_s2u_32(cb) == (TC_SOA as u32)) {
        let msg_1 = format(f"soa nao faz conta nem comparacao", alloc = heap)
        defer delete(msg_1)
        return sem_erro(s, common.E0320, e.pos_op, msg_1)
    }
    let msg_2 = format(f"map nao faz conta nem comparacao", alloc = heap)
    defer delete(msg_2)
    return sem_erro(s, common.E0318, e.pos_op, msg_2)
}

// C: semantic/sem_v19.c:88
proc sem_comparacao_v19(s: ^Semantica, e: ^frontend.Expr) -> bool {
    let ca: i32 = tipo_classe_de(&s.tipos, (e.a as ^frontend.Expr).tipo)
    let cb: i32 = tipo_classe_de(&s.tipos, (e.b as ^frontend.Expr).tipo)
    if (common.c2f_s2u_32(ca) == (TC_MATRIZ as u32)) or (common.c2f_s2u_32(cb) == (TC_MATRIZ as u32)) {
        let msg_1 = format(f"matrix nao tem == nem ordem: compare elemento a elemento", alloc = heap)
        defer delete(msg_1)
        return sem_erro(s, common.E0321, e.pos_op, msg_1)
    }
    if (common.c2f_s2u_32(ca) == (TC_BIT_SET as u32)) or (common.c2f_s2u_32(cb) == (TC_BIT_SET as u32)) {
        return sem_comparacao_bit_set(s, e)
    }
    if (common.c2f_s2u_32(ca) == (TC_SOA as u32)) or (common.c2f_s2u_32(cb) == (TC_SOA as u32)) {
        let msg_2 = format(f"soa nao faz conta nem comparacao", alloc = heap)
        defer delete(msg_2)
        return sem_erro(s, common.E0320, e.pos_op, msg_2)
    }
    let msg_3 = format(f"map nao faz conta nem comparacao", alloc = heap)
    defer delete(msg_3)
    return sem_erro(s, common.E0318, e.pos_op, msg_3)
}

// C: semantic/sem_v19.c:100
proc argumento_do_parametro(e: ^frontend.Expr, k: i32) -> ?^frontend.Arg {
    for i in (0 as u32)..<e.nargs {
        if (e.args or_else {})[i].indice == k {
            return &(e.args or_else {})[i]
        }
    }
    return none
}

// C: semantic/sem_v19.c:109
proc sem_chamar_v19(s: ^Semantica, e: ^frontend.Expr, embutido: i32) -> bool {
    var por_ponteiro: bool = false
    if embutido == frontend.EMB_TRANSPOSE {
        return sem_chamar_transpose(s, e)
    }
    let insere: bool = embutido == frontend.EMB_INSERT
    var ligou: bool = false
    if insere {
        ligou = sem_ligar_embutido(s, e, s.params_insert[..])
    } else {
        ligou = sem_ligar_embutido(s, e, s.params_chave[..])
    }
    if not ligou {
        return false
    }
    let colecao: ?^frontend.Expr = (argumento_do_parametro(e, 0) as ^frontend.Arg).valor
    if not sem_checar(s, colecao, TIPO_VAZIO as u32) {
        return false
    }
    let c: i32 = classe_do_alvo(s, (colecao as ^frontend.Expr).tipo, &por_ponteiro)
    if c == TC_BIT_SET {
        return sem_chamar_bit_set(s, e, embutido, colecao)
    }
    if c == TC_MAPA {
        return sem_chamar_mapa(s, e, embutido, colecao)
    }
    let tipo = sem_descrever_str(s, (colecao as ^frontend.Expr).tipo)
    defer delete(tipo)
    let quem = sem_nome_texto(s, e.nome)
    if (embutido == frontend.EMB_GET) or (embutido == frontend.EMB_GET_PTR) {
        let msg_1 = format(f"{quem} pede map[K]V (tipo {tipo})", alloc = heap)
        defer delete(msg_1)
        return sem_erro(s, common.E0301, (colecao as ^frontend.Expr).pos, msg_1)
    }
    let msg_2 = format(f"{quem} pede map[K]V ou bit_set[E] (tipo {tipo})", alloc = heap)
    defer delete(msg_2)
    return sem_erro(s, common.E0301, (colecao as ^frontend.Expr).pos, msg_2)
}

// C: semantic/sem_v19.c:129
proc sem_for_v19(s: ^Semantica, st: ^frontend.Stmt) -> bool {
    var por_ponteiro: bool = false
    let c: i32 = classe_do_alvo(s, (st.expr as ^frontend.Expr).tipo, &por_ponteiro)
    if common.c2f_s2u_32(c) == (TC_BIT_SET as u32) {
        return sem_for_bit_set(s, st)
    }
    if common.c2f_s2u_32(c) == (TC_MATRIZ as u32) {
        let msg_1 = format(f"for nao percorre matrix: use for i in 0..<R e m[i, j]", alloc = heap)
        defer delete(msg_1)
        return sem_erro(s, common.E0321, (st.expr as ^frontend.Expr).pos, msg_1)
    }
    if common.c2f_s2u_32(c) == (TC_SOA as u32) {
        return sem_for_soa(s, st)
    }
    return sem_for_mapa(s, st)
}

// C: semantic/sem_v19.c:140
proc sem_campo_v19(s: ^Semantica, e: ^frontend.Expr) -> bool {
    var por_ponteiro: bool = false
    let c: i32 = classe_do_alvo(s, (e.a as ^frontend.Expr).tipo, &por_ponteiro)
    if (common.c2f_s2u_32(c) == (TC_MATRIZ as u32)) and (not por_ponteiro) {
        let msg_1 = format(f"matrix nao tem campo: use m[linha, coluna]", alloc = heap)
        defer delete(msg_1)
        return sem_erro(s, common.E0321, e.pos_op, msg_1)
    }
    if (common.c2f_s2u_32(c) == (TC_SOA as u32)) and (not por_ponteiro) {
        return sem_coluna_da_soa(s, e)
    }
    let msg_2 = format(f"campo '{sem_nome_texto(s, e.nome)}' pedido em valor que nao e struct", alloc = heap)
    defer delete(msg_2)
    return sem_erro(s, common.E0201, e.pos_op, msg_2)
}

// G3 S5: testes dirigidos (so existem em `forja test`)
test "sem_v19: classe_do_alvo, sem_eh_tipo_v19 e sem_tipo_tem_v19 (lista estatica)" {
    var pre: [2]str = {"Par", "Cena"}
    var c = S5Cena{}
    s5_cena_montar(&c, pre[..])
    let i32t: u32 = TIPO_I32 as u32
    let mapa: u32 = tipo_mapa(&c.sv.tipos, TIPO_INT as u32, i32t)
    let matriz: u32 = tipo_matriz(&c.sv.tipos, TIPO_F32 as u32, 2, 2)
    let soa: u32 = tipo_soa(&c.sv.tipos, tipo_array(&c.sv.tipos, i32t, 2))
    let a3: u32 = tipo_array(&c.sv.tipos, i32t, 3)
    var pp: bool = false
    expect(classe_do_alvo(&c.sv, mapa, &pp) == TC_MAPA and not pp)
    expect(classe_do_alvo(&c.sv, tipo_ponteiro(&c.sv.tipos, mapa), &pp) == TC_MAPA and pp)
    expect(classe_do_alvo(&c.sv, i32t, &pp) == TC_I32 and not pp)
    expect(classe_do_alvo(&c.sv, tipo_ponteiro(&c.sv.tipos, i32t), &pp) == TC_I32 and pp)
    expect(sem_eh_tipo_v19(&c.sv, mapa) and sem_eh_tipo_v19(&c.sv, matriz) and sem_eh_tipo_v19(&c.sv, soa) and sem_eh_tipo_v19(&c.sv, tipo_ponteiro(&c.sv.tipos, matriz)))
    expect(not sem_eh_tipo_v19(&c.sv, i32t) and not sem_eh_tipo_v19(&c.sv, a3) and not sem_eh_tipo_v19(&c.sv, tipo_fatia(&c.sv.tipos, i32t)))
    // sem_tipo_tem_v19: a classe >= TC_MAPA, array de tipo v19, struct com campo de tipo v19 (via a Decl), o resto nao
    expect(sem_tipo_tem_v19(&c.sv, mapa) and sem_tipo_tem_v19(&c.sv, matriz) and sem_tipo_tem_v19(&c.sv, soa))
    expect(sem_tipo_tem_v19(&c.sv, tipo_array(&c.sv.tipos, mapa, 2)))
    expect(not sem_tipo_tem_v19(&c.sv, a3) and not sem_tipo_tem_v19(&c.sv, TIPO_BOOL as u32) and not sem_tipo_tem_v19(&c.sv, tipo_ponteiro(&c.sv.tipos, mapa)))
    let id_par: i32 = s5_nome(&c, "Par")
    let id_cena: i32 = s5_nome(&c, "Cena")
    var campos_par = make([dynamic]frontend.Campo, alloc = heap)
    var campos_cena = make([dynamic]frontend.Campo, alloc = heap)
    var campo_i = frontend.Campo{}
    campo_i.tipo.tipo = i32t
    var campo_m = frontend.Campo{}
    campo_m.tipo.tipo = mapa
    append(&campos_par, item = campo_i)
    append(&campos_par, item = campo_i)
    append(&campos_cena, item = campo_i)
    append(&campos_cena, item = campo_m)
    var d_par = frontend.Decl{tipo_no = frontend.D_STRUCT as u8, nome = id_par, campos = campos_par[..], ncampos = 2}
    var d_cena = frontend.Decl{tipo_no = frontend.D_STRUCT as u8, nome = id_cena, campos = campos_cena[..], ncampos = 2}
    var globais = c.sv.globais or_else {}
    globais[id_par].decl = &d_par
    globais[id_cena].decl = &d_cena
    expect(not sem_tipo_tem_v19(&c.sv, tipo_struct(&c.sv.tipos, id_par)))
    expect(sem_tipo_tem_v19(&c.sv, tipo_struct(&c.sv.tipos, id_cena)))
    expect(sem_tipo_tem_v19(&c.sv, tipo_array(&c.sv.tipos, tipo_struct(&c.sv.tipos, id_cena), 2)))
    delete(campos_par)
    delete(campos_cena)
    s5_cena_liberar(&c)
}

test "sem_v19: argumento_do_parametro e os erros de despacho de indice, literal, conta, comparacao, campo e for" {
    var pre: [1]str = {"campo_x"}
    var c = S5Cena{}
    s5_cena_montar(&c, pre[..])
    let i32t: u32 = TIPO_I32 as u32
    let mapa: u32 = tipo_mapa(&c.sv.tipos, TIPO_INT as u32, i32t)
    let matriz: u32 = tipo_matriz(&c.sv.tipos, TIPO_F32 as u32, 2, 2)
    let soa: u32 = tipo_soa(&c.sv.tipos, tipo_array(&c.sv.tipos, i32t, 2))
    let bits: u32 = tipo_bit_set(&c.sv.tipos, tipo_enum(&c.sv.tipos, 0), 8)
    var ch = S5Chamada{}
    var tipos_ch: [3]u32 = {i32t, i32t, i32t}
    s5_chamada_montar(&ch, -1, tipos_ch[..])
    ch.args[0].indice = 2
    ch.args[1].indice = 0
    ch.args[2].indice = 1
    expect(argumento_do_parametro(&ch.e, 0) != none and (argumento_do_parametro(&ch.e, 0) as ^frontend.Arg).valor == &ch.folhas[1])
    expect((argumento_do_parametro(&ch.e, 2) as ^frontend.Arg).valor == &ch.folhas[0])
    expect(argumento_do_parametro(&ch.e, 3) == none and argumento_do_parametro(&ch.e, -1) == none)
    s5_chamada_liberar(&ch)
    var fa = s5_folha(mapa, false)
    var fb = s5_folha(i32t, false)
    var e = frontend.Expr{tipo_no = frontend.EX_INDICE as u8, a = &fa, b = &fb, pos = 4, pos_op = 6}
    // indice
    expect(not sem_indice_v19(&c.sv, &e))
    expect(c.diag.codigo == common.E0318 and c.diag.off == 6 and (c.diag.causa or_else "") == "map nao se indexa com []: get(m, key = k) le e insert(&m, key = k, value = v) grava")
    fa = s5_folha(bits, false)
    expect(not sem_indice_v19(&c.sv, &e))
    expect(c.diag.codigo == common.E0319 and (c.diag.causa or_else "") == "bit_set nao se indexa: has(s, key = m)")
    fa = s5_folha(tipo_ponteiro(&c.sv.tipos, matriz), false)
    expect(not sem_indice_v19(&c.sv, &e))
    expect(c.diag.codigo == common.E0321 and (c.diag.causa or_else "") == "matrix se indexa com m[linha, coluna]")
    // literal
    expect(not sem_literal_v19(&c.sv, &e, mapa))
    expect(c.diag.codigo == common.E0318 and c.diag.off == 4 and (c.diag.causa or_else "") == "map nasce de make: make(map[K]V, alloc = heap); {} nao cria map")
    // conta e comparacao
    fa = s5_folha(mapa, false)
    expect(not sem_conta_v19(&c.sv, &e))
    expect(c.diag.codigo == common.E0318 and c.diag.off == 6 and (c.diag.causa or_else "") == "map nao faz conta nem comparacao")
    expect(not sem_comparacao_v19(&c.sv, &e))
    expect(c.diag.codigo == common.E0318 and (c.diag.causa or_else "") == "map nao faz conta nem comparacao")
    fa = s5_folha(soa, false)
    expect(not sem_conta_v19(&c.sv, &e))
    expect(c.diag.codigo == common.E0320 and (c.diag.causa or_else "") == "soa nao faz conta nem comparacao")
    expect(not sem_comparacao_v19(&c.sv, &e))
    expect(c.diag.codigo == common.E0320 and (c.diag.causa or_else "") == "soa nao faz conta nem comparacao")
    fb = s5_folha(matriz, false)
    expect(not sem_comparacao_v19(&c.sv, &e))
    expect(c.diag.codigo == common.E0321 and (c.diag.causa or_else "") == "matrix nao tem == nem ordem: compare elemento a elemento")
    // campo: matriz por valor, struct inexistente (ponteiro), e o resto
    fa = s5_folha(matriz, false)
    e.nome = s5_nome(&c, "campo_x")
    expect(not sem_campo_v19(&c.sv, &e))
    expect(c.diag.codigo == common.E0321 and (c.diag.causa or_else "") == "matrix nao tem campo: use m[linha, coluna]")
    // (o E0201 "pedido em valor que nao e struct" chama sem_relacionar -> rel_e0201, stub do S8: sem execucao)
    // for em matriz
    var st = frontend.Stmt{expr = &fa}
    fa = s5_folha(matriz, false)
    fa.pos = 77
    expect(not sem_for_v19(&c.sv, &st))
    expect(c.diag.codigo == common.E0321 and c.diag.off == 77 and (c.diag.causa or_else "") == "for nao percorre matrix: use for i in 0..<R e m[i, j]")
    s5_cena_liberar(&c)
}

// sem_chamar_v19 com map e bit_set: ver os `test` de sem_mapa e sem_bitset; o E0301 (colecao que nao e map nem bit_set) cai em sem_forma_da_regra, stub do S7
