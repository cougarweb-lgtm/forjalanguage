import "common"
import "frontend"

// C: semantic/sem_veneno.c:15
proc categoria_da_decl_2(tipo: i32) -> i32 {
    let sw_1 = common.c2f_s2u_32(tipo)
    if sw_1 == (frontend.D_UNIDADE_BASE as u32) or sw_1 == (frontend.D_UNIDADE_DERIV as u32) {
        return SIM_UNIDADE
    } else if sw_1 == (frontend.D_CONST as u32) {
        return SIM_CONST
    } else if sw_1 == (frontend.D_STRUCT as u32) {
        return SIM_STRUCT
    } else if sw_1 == (frontend.D_ENUM as u32) {
        return SIM_ENUM
    } else if sw_1 == (frontend.D_PROC as u32) {
        return SIM_PROC
    } else if sw_1 == (frontend.D_UNIAO as u32) {
        return SIM_UNIAO
    } else {
        return SIM_NENHUM
    }
    return 0
}

// C: semantic/sem_veneno.c:32
proc sem_envenenar(s: ^Semantica, d: ?^frontend.Decl) {
    let decl: ^frontend.Decl = d as ^frontend.Decl
    let categoria: i32 = categoria_da_decl_2(decl.tipo_no as i32)
    if (categoria == SIM_NENHUM) or (decl.nome < 0) {
        return
    }
    let globais = s.globais or_else {}
    let y: ^Simbolo = &globais[decl.chave]
    if (decl.chave != decl.nome) and (globais[decl.nome].categoria == (SIM_PROC_EMBUTIDO as u8)) { // IA1-L8: nome reservado pela linguagem num modulo (E0202): o uso cairia no embutido
        s.pula_passe_b = true
        return
    }
    if y.categoria == (SIM_NENHUM as u8) {
        y^ = Simbolo{categoria = categoria as u8, indice = -1, decl = d, tipo = TIPO_VENENO as u32, envenenado = 1}
        return
    }
    if y.decl == d {
        y.envenenado = 1
    } else {
        s.pula_passe_b = true // o nome e de outro simbolo (E0202: embutido, outro modulo, outra declaracao): o uso cairia nele, nao no veneno
    }
}

// C: semantic/sem_veneno.c:51
proc sem_erro_calado(s: ^Semantica, pos: u32) -> bool {
    s.tocou_veneno = true
    let msg_1 = format(f"declaracao com erro (cascata calada)", alloc = heap)
    defer delete(msg_1)
    return sem_erro(s, common.E0201, pos, msg_1)
}

// C: semantic/sem_veneno.c:57
proc sem_nome_ja_relatado(s: ^Semantica, nome: i32) -> bool {
    if (s.proc_c == none) or (common.c2f_b2i32(s.tocou_veneno) != 0) {
        return false
    }
    for k in (0 as u64)..<(len(s.nomes_relatados) as u64) {
        if s.nomes_relatados[k] == nome {
            return true
        }
    }
    append(&s.nomes_relatados, item = 0)
    s.nomes_relatados[len(s.nomes_relatados) - 1] = nome
    return false
}

// C: semantic/sem_veneno.c:69
proc sem_venenar_campos(d: ^frontend.Decl, de: u32) {
    var k: u32 = de
    while k < d.ncampos {
        if (d.campos or_else {})[k].tipo.tipo == 0 {
            let p_1 = d.campos or_else {}
            p_1[k].tipo.tipo = TIPO_VENENO as u32
        }
        k += 1
    }
}
