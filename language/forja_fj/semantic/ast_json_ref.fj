import "common"
import "frontend"

struct AstRefEntrada {
    pos_op: u32
    decl_pos: u32
    e: ?^frontend.Expr
    dono: ?^frontend.Decl
    ordem: u32
}

struct AstRefTipo {
    pos: u32
    nome: i32
    membro: i32
    classe: u8
    modulo: u8
    dono: ?^frontend.Decl
}

pub struct AstRefs {
    sem: ?^Semantica
    entradas: [dynamic]AstRefEntrada
    tipos: [dynamic]AstRefTipo
}

struct Coletor {
    entradas: ?^[dynamic]AstRefEntrada
    tipos: ?^[dynamic]AstRefTipo
    locais: [dynamic]u32
    dono: ?^frontend.Decl
}

pub const AST_REF_SEM_POS: i64 = 4294967295
const AST_USO_TIPO_ESCRITO: i32 = 0
const AST_USO_CASO: i32 = 1
const AST_USO_NOME_DE_TIPO: i32 = 2
const ALOCADORES: [4]str = {"heap", "frame", "scope", "escopo"}

// C: semantic/ast_json_ref.c:19
proc id_empurrar(j: ^Json, chave: str, indice: i32) -> u64 {
    let antes: u64 = len(j.id) as u64
    format(f"/{chave}", into = &j.id)
    if indice >= 0 {
        format(f"[{indice}]", into = &j.id)
    }
    return antes
}

// C: semantic/ast_json_ref.c:27
proc id_restaurar(j: ^Json, tam: u64) {
    truncate(&j.id, tam as int) // C: j->id.tam = tam (+ NUL, que a lista nao guarda)
}

// C: semantic/ast_json_ref.c:33
pub proc ast_id_base_da_decl(saida: ^[dynamic]u8, modulos: ?^frontend.Modulos, nomes: ^common.Interner, d: ?^frontend.Decl) {
    let caminho: i32 = (modulos as ^frontend.Modulos).itens[(d as ^frontend.Decl).modulo].caminho
    append(saida, item = common.interner_texto(nomes, caminho)[0..<common.interner_tam(nomes, caminho) as u64])
    append(saida, item = ":"[0..<1])
    let sw_1 = common.c2f_s2u_32(((d as ^frontend.Decl).tipo_no as i32))
    if sw_1 == (frontend.D_TEST as u32) {
        append(saida, item = "test:")
    } else if sw_1 == (frontend.D_IMPORT as u32) {
        append(saida, item = "import:")
    } else if sw_1 == (frontend.D_LINK as u32) {
        append(saida, item = "link:")
    } else if sw_1 == (frontend.D_ASSERT as u32) {
        append(saida, item = "static_assert")
        return
    } else {
    }
    if (d as ^frontend.Decl).nome >= 0 {
        append(saida, item = common.interner_texto(nomes, (d as ^frontend.Decl).nome)[0..<common.interner_tam(nomes, (d as ^frontend.Decl).nome) as u64])
    }
}

// C: semantic/ast_json_ref.c:50
proc guardar(j: ^Json, tabela: ^[dynamic]AstGuardado, chave: u32) {
    append(tabela, item = AstGuardado{chave = chave, off = (len(j.guardados) as u32), tam = (len(j.id) as u32)})
    append(&j.guardados, items = j.id[..])
}

// C: semantic/ast_json_ref.c:59
proc achar(tabela: ^[dynamic]AstGuardado, chave: u32) -> ?^AstGuardado {
    var i: u64 = len(tabela^) as u64
    while i > 0 {
        let g: ^AstGuardado = &tabela[i - 1]
        if g.chave == chave {
            return g
        }
        i -= 1
    }
    return none
}

// C: semantic/ast_json_ref.c:68
proc local_registrar(j: ^Json, pos: u32) {
    if j.refs != none {
        guardar(j, &j.locais, pos)
    }
}

// C: semantic/ast_json_ref.c:73
proc import_registrar(j: ^Json, apelido: i32) {
    if j.refs != none {
        guardar(j, &j.imports, common.c2f_s2u_32(apelido))
    }
}

// C: semantic/ast_json_ref.c:82
proc eh_uso_de_nome(e: ?^frontend.Expr) -> bool {
    let nomeia: bool = ((((e as ^frontend.Expr).tipo_no == (frontend.EX_NOME as u8)) or ((e as ^frontend.Expr).tipo_no == (frontend.EX_CHAMADA as u8))) or ((e as ^frontend.Expr).tipo_no == (frontend.EX_CAMPO as u8))) or ((e as ^frontend.Expr).tipo_no == (frontend.EX_LITERAL_STRUCT as u8))
    return (common.c2f_b2i32(nomeia) != 0) and ((e as ^frontend.Expr).ref != (frontend.REF_NENHUM as u8))
}

// C: semantic/ast_json_ref.c:88
proc declaracao_do_local(c: ^Coletor, e: ?^frontend.Expr) -> u32 {
    let local: bool = ((e as ^frontend.Expr).ref == (frontend.REF_LOCAL as u8)) or ((e as ^frontend.Expr).ref == (frontend.REF_PARAM as u8))
    if ((not local) or ((e as ^frontend.Expr).ref_id < 0)) or (common.c2f_s2u_64((e as ^frontend.Expr).ref_id as i64) >= (len(c.locais) as u64)) {
        return AST_REF_SEM_POS as u32
    }
    return c.locais[common.c2f_s2u_64((e as ^frontend.Expr).ref_id as i64)]
}

// C: semantic/ast_json_ref.c:96
proc empurrar_uso_de_tipo(c: ^Coletor, uso: AstRefTipo) {
    var completo: AstRefTipo = uso
    completo.dono = c.dono
    append(c.tipos as ^[dynamic]AstRefTipo, item = completo)
}

// C: semantic/ast_json_ref.c:103
proc coletar_tipo(c: ^Coletor, t: ?^frontend.TipoRef) {
    if (t == none) or ((t as ^frontend.TipoRef).forma == (frontend.TR_TUPLA as u8)) {
        return
    }
    if (t as ^frontend.TipoRef).forma == (frontend.TR_NOME as u8) {
        if (t as ^frontend.TipoRef).nome >= 0 {
            empurrar_uso_de_tipo(c, AstRefTipo{pos = (t as ^frontend.TipoRef).pos, nome = (t as ^frontend.TipoRef).nome, membro = -1, classe = AST_USO_TIPO_ESCRITO as u8, modulo = (t as ^frontend.TipoRef).modulo})
        }
        return
    }
    if (t as ^frontend.TipoRef).forma == (frontend.TR_PROC as u8) {
        if (t as ^frontend.TipoRef).pos_tamanho == 1 {
            coletar_tipo(c, &((t as ^frontend.TipoRef).alvo or_else {})[0])
        }
        for i in (1 as i32)..=(t as ^frontend.TipoRef).nome {
            coletar_tipo(c, &((t as ^frontend.TipoRef).alvo or_else {})[i])
        }
        return
    }
    coletar_tipo(c, &((t as ^frontend.TipoRef).alvo or_else {})[0])
    if (t as ^frontend.TipoRef).forma == (frontend.TR_MAPA as u8) {
        coletar_tipo(c, &((t as ^frontend.TipoRef).alvo or_else {})[1])
    }
}

// C: semantic/ast_json_ref.c:119
proc coletar_expr(c: ^Coletor, e: ?^frontend.Expr) {
    if e == none {
        return
    }
    let ee: ^frontend.Expr = e as ^frontend.Expr
    if eh_uso_de_nome(e) {
        let entradas: ^[dynamic]AstRefEntrada = c.entradas as ^[dynamic]AstRefEntrada
        let ordem: u32 = len(entradas^) as u32 // C: n - 1 depois do empurrar
        append(entradas, item = AstRefEntrada{pos_op = ee.pos_op, e = e, decl_pos = declaracao_do_local(c, e), dono = c.dono, ordem = ordem})
    } else if ee.tipo_no == (frontend.EX_NOME as u8) {
        // talvez seja nome de tipo (transmute(x, para = T)); o indice decide
        empurrar_uso_de_tipo(c, AstRefTipo{pos = ee.pos, nome = ee.nome, membro = -1, classe = AST_USO_NOME_DE_TIPO as u8, modulo = ee.modulo})
    }
    coletar_expr(c, ee.a)
    coletar_expr(c, ee.b)
    if (ee.tipo_no == (frontend.EX_CONVERSAO as u8)) or (ee.tipo_no == (frontend.EX_TIPO as u8)) { // args e alvo dividem a uniao
        coletar_tipo(c, ee.alvo)
        return
    }
    for i in (0 as u32)..<ee.nargs {
        coletar_expr(c, (ee.args or_else {})[i].valor)
    }
}

// C: semantic/ast_json_ref.c:141
proc declarar_local(c: ^Coletor, id: i32, pos: u32) {
    if (id >= 0) and (common.c2f_s2u_64(id as i64) < (len(c.locais) as u64)) {
        c.locais[common.c2f_s2u_64(id as i64)] = pos
    }
}

// C: semantic/ast_json_ref.c:147
proc declarar_locais(c: ^Coletor, s: ?^frontend.Stmt) {
    var s_v: ?^frontend.Stmt = s
    while s_v != none {
        if (((s_v as ^frontend.Stmt).tipo_no == (frontend.ST_LET as u8)) or ((s_v as ^frontend.Stmt).tipo_no == (frontend.ST_VAR as u8))) or ((s_v as ^frontend.Stmt).tipo_no == (frontend.ST_FOR as u8)) {
            declarar_local(c, (s_v as ^frontend.Stmt).local_id, (s_v as ^frontend.Stmt).pos)
        }
        if (s_v as ^frontend.Stmt).tipo_no == (frontend.ST_FOR as u8) {
            declarar_local(c, (s_v as ^frontend.Stmt).local_indice, (s_v as ^frontend.Stmt).pos)
        }
        var i: u32 = 0
        while ((s_v as ^frontend.Stmt).tipo_no == (frontend.ST_LET_MULTIPLO as u8)) and (i < (s_v as ^frontend.Stmt).ncasos) {
            declarar_local(c, ((s_v as ^frontend.Stmt).nomes or_else {})[i].local_id, (s_v as ^frontend.Stmt).pos)
            i += 1
        }
        var i_2: u32 = 0
        while ((s_v as ^frontend.Stmt).tipo_no == (frontend.ST_SWITCH as u8)) and (i_2 < (s_v as ^frontend.Stmt).ncasos) {
            declarar_local(c, ((s_v as ^frontend.Stmt).casos or_else {})[i_2].local_id, ((s_v as ^frontend.Stmt).casos or_else {})[i_2].pos)
            declarar_locais(c, ((s_v as ^frontend.Stmt).casos or_else {})[i_2].corpo)
            i_2 += 1
        }
        declarar_locais(c, (s_v as ^frontend.Stmt).corpo)
        declarar_locais(c, (s_v as ^frontend.Stmt).senao)
        s_v = (s_v as ^frontend.Stmt).prox
    }
}

// C: semantic/ast_json_ref.c:165
proc coletar_caso(c: ^Coletor, k: ^frontend.Caso) {
    if k.tipo_escrito != none {
        coletar_tipo(c, k.tipo_escrito)
    } else if not k.padrao {
        empurrar_uso_de_tipo(c, AstRefTipo{pos = k.pos, nome = k.tipo_nome, membro = k.membro, classe = AST_USO_CASO as u8, modulo = k.modulo})
    }
    coletar_usos(c, k.corpo)
}

// C: semantic/ast_json_ref.c:172
proc coletar_usos(c: ^Coletor, s: ?^frontend.Stmt) {
    var s_v: ?^frontend.Stmt = s
    while s_v != none {
        if (((s_v as ^frontend.Stmt).tipo_no == (frontend.ST_LET as u8)) or ((s_v as ^frontend.Stmt).tipo_no == (frontend.ST_VAR as u8))) and (common.c2f_b2i32((s_v as ^frontend.Stmt).tem_tipo) != 0) {
            coletar_tipo(c, &(s_v as ^frontend.Stmt).tipo)
        }
        coletar_expr(c, (s_v as ^frontend.Stmt).expr)
        coletar_expr(c, (s_v as ^frontend.Stmt).expr2)
        coletar_expr(c, (s_v as ^frontend.Stmt).alvo)
        var i: u32 = 0
        while ((s_v as ^frontend.Stmt).tipo_no == (frontend.ST_SWITCH as u8)) and (i < (s_v as ^frontend.Stmt).ncasos) {
            coletar_caso(c, &((s_v as ^frontend.Stmt).casos or_else {})[i])
            i += 1
        }
        coletar_usos(c, (s_v as ^frontend.Stmt).corpo)
        coletar_usos(c, (s_v as ^frontend.Stmt).senao)
        s_v = (s_v as ^frontend.Stmt).prox
    }
}

// C: semantic/ast_json_ref.c:186
proc coletar_tipos_da_decl(c: ^Coletor, d: ?^frontend.Decl) {
    if (d as ^frontend.Decl).tipo_no == (frontend.D_CONST as u8) {
        coletar_tipo(c, &(d as ^frontend.Decl).tipo)
    }
    for i in (0 as u32)..<(d as ^frontend.Decl).nparams {
        coletar_tipo(c, &((d as ^frontend.Decl).params or_else {})[i].tipo)
    }
    if (common.c2f_b2i32((d as ^frontend.Decl).tem_retorno) != 0) and ((d as ^frontend.Decl).retorno.forma == (frontend.TR_TUPLA as u8)) {
        for i in (0 as u32)..<(d as ^frontend.Decl).nretornos {
            coletar_tipo(c, &((d as ^frontend.Decl).retornos or_else {})[i].tipo)
        }
    } else if (d as ^frontend.Decl).tem_retorno {
        coletar_tipo(c, &(d as ^frontend.Decl).retorno)
    }
    for i in (0 as u32)..<(d as ^frontend.Decl).ncampos {
        coletar_tipo(c, &((d as ^frontend.Decl).campos or_else {})[i].tipo)
    }
}

// C: semantic/ast_json_ref.c:198
proc coletar_decl(refs: ^AstRefs, d: ?^frontend.Decl) {
    var c: Coletor = Coletor{entradas = &refs.entradas, tipos = &refs.tipos, dono = d}
    let dd: ^frontend.Decl = d as ^frontend.Decl
    if dd.com_erro { // a analise parou nesta declaracao: os locais que sobraram nao foram numerados
        return
    }
    coletar_tipos_da_decl(&c, d)
    c.locais = make([dynamic]u32, alloc = heap)
    for i in (0 as u32)..<dd.nlocais {
        append(&c.locais, item = AST_REF_SEM_POS as u32)
    }
    for i in (0 as u32)..<dd.nparams {
        declarar_local(&c, i as i32, (dd.params or_else {})[i].pos)
    }
    declarar_locais(&c, dd.corpo)
    coletar_expr(&c, dd.init)
    for i in (0 as u32)..<dd.nparams {
        coletar_expr(&c, (dd.params or_else {})[i].padrao)
    }
    for i in (0 as u32)..<dd.ncampos {
        coletar_expr(&c, (dd.campos or_else {})[i].padrao)
    }
    coletar_usos(&c, dd.corpo)
    delete(c.locais)
}

// C: semantic/ast_json_ref.c:214
// C2F-B0: o qsort do C usa o comparador total (pos_op, ordem); aqui ele vira (a, b) -> i32 + o _menor do sort_by.
proc comparar_entradas(a: ^AstRefEntrada, b: ^AstRefEntrada) -> i32 {
    if a.pos_op != b.pos_op {
        if a.pos_op < b.pos_op {
            return -1
        }
        return 1
    }
    if a.ordem < b.ordem {
        return -1
    }
    if a.ordem > b.ordem {
        return 1
    }
    return 0
}

proc comparar_entradas_menor(a: ^AstRefEntrada, b: ^AstRefEntrada) -> bool {
    return comparar_entradas(a, b) < 0
}

// C: semantic/ast_json_ref.c:222
pub proc ast_refs_montar(refs: ^AstRefs, sem: ^Semantica) {
    refs.sem = sem
    refs.entradas = make([dynamic]AstRefEntrada, alloc = heap)
    refs.tipos = make([dynamic]AstRefTipo, alloc = heap)
    var d: ?^frontend.Decl = (sem.programa as ^frontend.Programa).primeira
    while d != none {
        coletar_decl(refs, d)
        d = (d as ^frontend.Decl).prox
    }
    sort_by(refs.entradas[..], less = comparar_entradas_menor)
}

// C: semantic/ast_json_ref.c:231
pub proc ast_refs_liberar(refs: ^AstRefs) {
    delete(refs.entradas)
    delete(refs.tipos)
}

// C: semantic/ast_json_ref.c:237
proc achar_entrada(refs: ?^AstRefs, pos_op: u32, tipo_no: u8) -> ?^AstRefEntrada {
    var lo: u64 = 0
    var hi: u64 = len((refs as ^AstRefs).entradas) as u64
    while lo < hi {
        let meio: u64 = lo + ((hi - lo) / 2)
        if (refs as ^AstRefs).entradas[meio].pos_op < pos_op {
            lo = meio + 1
        } else {
            hi = meio
        }
    }
    if lo >= (len((refs as ^AstRefs).entradas) as u64) {
        return none
    }
    let primeira: ^AstRefEntrada = &(refs as ^AstRefs).entradas[lo]
    if primeira.pos_op != pos_op {
        return none
    }
    for k in lo..<(len((refs as ^AstRefs).entradas) as u64) {
        let r: ^AstRefEntrada = &(refs as ^AstRefs).entradas[k]
        if r.pos_op != pos_op {
            break
        }
        if ((r.e as ^frontend.Expr).tipo_no as i32) == (tipo_no as i32) {
            return r
        }
    }
    return primeira
}

// C: semantic/ast_json_ref.c:258
proc eh_decl_oculta(sem: ^Semantica, d: ?^frontend.Decl) -> bool {
    if (d == sem.decl_quat) or (d == sem.decl_allocator) {
        return true
    }
    for i in (0 as u32)..<sem.qtd_listas_fixas {
        if sem.decls_listas_fixas[i] == d {
            return true
        }
    }
    return false
}

// Semantica.nomes e Semantica.modulos (Interner * e Modulos * no C) chegam como fatia de 1 elemento: o objeto e o [0].
proc nomes_da_sem(sem: ^Semantica) -> ^common.Interner {
    return &(sem.nomes or_else {})[0]
}

proc modulos_da_sem(sem: ^Semantica) -> ^frontend.Modulos {
    return &(sem.modulos or_else {})[0]
}

// C: semantic/ast_json_ref.c:267
proc decl_do_simbolo(sem: ^Semantica, y: ^Simbolo) -> ?^frontend.Decl {
    let d: ?^frontend.Decl = y.decl
    if ((d == none) or (y.categoria == (SIM_PROC_EMBUTIDO as u8))) or (common.c2f_b2i32(eh_decl_oculta(sem, d)) != 0) {
        return none
    }
    return d
}

// C: semantic/ast_json_ref.c:274
proc ast_refs_decl_do_nome(refs: ?^AstRefs, nome: i32, qualificador: u8, modulo_do_uso: u8) -> ?^frontend.Decl {
    let sem: ?^Semantica = (refs as ^AstRefs).sem
    if ((nome < 0) or (common.c2f_s2u_32(nome) >= (sem as ^Semantica).qtd_nomes)) or ((sem as ^Semantica).globais == none) {
        return none
    }
    return decl_do_simbolo(sem as ^Semantica, sem_achar_simbolo_em(sem as ^Semantica, nome, qualificador, modulo_do_uso))
}

// C: semantic/ast_json_ref.c:282
proc decl_da_chave(refs: ?^AstRefs, chave: i32) -> ?^frontend.Decl {
    let sem: ?^Semantica = (refs as ^AstRefs).sem
    if ((chave < 0) or (common.c2f_s2u_32(chave) >= (sem as ^Semantica).qtd_nomes)) or ((sem as ^Semantica).globais == none) {
        return none
    }
    return decl_do_simbolo(sem as ^Semantica, &((sem as ^Semantica).globais or_else {})[chave])
}

// C: semantic/ast_json_ref.c:290
proc ast_refs_decl_do_tipo(refs: ?^AstRefs, t: u32) -> ?^frontend.Decl {
    let tipos: ^Tipos = &((refs as ^AstRefs).sem as ^Semantica).tipos
    var k: ?^TipoInfo = none
    if t == (frontend.TIPO_NAO_RESOLVIDO as u32) {
        return none
    }
    k = tipo_de(tipos, t)
    if (k as ^TipoInfo).classe == (TC_PONTEIRO as u8) {
        k = tipo_de(tipos, (k as ^TipoInfo).a)
    }
    if (((k as ^TipoInfo).classe != (TC_STRUCT as u8)) and ((k as ^TipoInfo).classe != (TC_ENUM as u8))) and ((k as ^TipoInfo).classe != (TC_UNIAO as u8)) {
        return none
    }
    return decl_da_chave(refs, transmute((k as ^TipoInfo).a, to = i32))
}

// C: semantic/ast_json_ref.c:301
// C2F-33: devolve o texto do caminho ja cortado no tamanho (o C devolvia texto + *tam).
proc modulo_da_decl(refs: ?^AstRefs, d: ?^frontend.Decl) -> []u8 {
    let sem: ^Semantica = (refs as ^AstRefs).sem as ^Semantica
    let caminho: i32 = modulos_da_sem(sem).itens[(d as ^frontend.Decl).modulo].caminho
    return interner_bytes(nomes_da_sem(sem), caminho)
}

// C: semantic/ast_json_ref.c:308
proc categoria_da_decl(d: ?^frontend.Decl) -> str {
    let sw_1 = common.c2f_s2u_32(((d as ^frontend.Decl).tipo_no as i32))
    if sw_1 == (frontend.D_CONST as u32) {
        return "const"
    } else if sw_1 == (frontend.D_STRUCT as u32) {
        return "struct"
    } else if sw_1 == (frontend.D_ENUM as u32) {
        return "enum"
    } else if sw_1 == (frontend.D_UNIAO as u32) {
        return "union"
    } else if sw_1 == (frontend.D_PROC as u32) {
        return "proc"
    } else {
        return "unit"
    }
    return ""
}

// C: semantic/ast_json_ref.c:322
// C2F-33: id e modulo chegam como bytes (os (ponteiro, tamanho) do C).
proc emitir_ref(j: ^Json, tipo: str, id: []u8, modulo: []u8) {
    chave(j, "ref")
    texto_json(j, id, false)
    chave(j, "ref_modulo")
    texto_json(j, modulo, false)
    format(f", \"ref_tipo\": \"{tipo}\"", into = j.b as ^[dynamic]u8)
}

// 'apelido.nome': o id do import que trouxe o apelido (texto do apelido lido cru da fonte em 'off').
// C: semantic/ast_json_ref.c:332
proc ref_do_import(j: ^Json, modulo: u8, off: u32) {
    if modulo == 0 {
        return
    }
    let f: ^common.Fonte = j.fonte as ^common.Fonte
    let ini: u64 = off as u64
    var n: u64 = 0
    while true {
        let c: u8 = f.texto[ini + n]
        if not (((c >= 97) and (c <= 122)) or ((c >= 48) and (c <= 57)) or (c == 95)) { // a-z 0-9 '_'
            break
        }
        n += 1
    }
    let nome_texto: str = from_bytes(f.texto[ini..<(ini + n)], alloc = heap) // C2F-33: o Interner busca por str
    defer delete(nome_texto)
    let apelido: i32 = common.interner_achar(j.nomes as ^common.Interner, nome_texto, n as u32)
    if apelido < 0 {
        return
    }
    let g: ?^AstGuardado = achar(&j.imports, common.c2f_s2u_32(apelido))
    if g == none {
        return
    }
    chave(j, "ref_import")
    texto_json(j, j.guardados[(g as ^AstGuardado).off..<((g as ^AstGuardado).off + (g as ^AstGuardado).tam)], false)
}

// C: semantic/ast_json_ref.c:347
proc emitir_ref_da_decl(j: ^Json, d: ?^frontend.Decl, tipo: str, sufixo: ?str, indice: i32) {
    let sem: ^Semantica = (j.refs as ^AstRefs).sem as ^Semantica
    var id: [dynamic]u8 = make([dynamic]u8, alloc = heap)
    defer delete(id)
    let modulo: []u8 = modulo_da_decl(j.refs, d)
    ast_id_base_da_decl(&id, modulos_da_sem(sem), nomes_da_sem(sem), d)
    if sufixo != none {
        let suf: str = sufixo or_else ""
        format(f"/{suf}[{indice}]", into = &id)
    }
    emitir_ref(j, tipo, id[..], modulo)
}

// C: semantic/ast_json_ref.c:358
proc emitir_ref_do_local(j: ^Json, r: ?^AstRefEntrada) {
    let rr: ^AstRefEntrada = r as ^AstRefEntrada
    var g: ?^AstGuardado = none
    if rr.decl_pos != (AST_REF_SEM_POS as u32) {
        g = achar(&j.locais, rr.decl_pos)
    }
    if g == none {
        return
    }
    let caminho: i32 = (j.modulos as ^frontend.Modulos).itens[j.modulo].caminho
    let modulo: []u8 = interner_bytes(j.nomes as ^common.Interner, caminho)
    var tipo: str = "local"
    if (rr.e as ^frontend.Expr).ref == (frontend.REF_PARAM as u8) {
        tipo = "param"
    }
    emitir_ref(j, tipo, j.guardados[(g as ^AstGuardado).off..<((g as ^AstGuardado).off + (g as ^AstGuardado).tam)], modulo)
}

// C: semantic/ast_json_ref.c:368
proc emitir_ref_global(j: ^Json, e: ?^frontend.Expr) {
    let ee: ^frontend.Expr = e as ^frontend.Expr
    let refs: ?^AstRefs = j.refs
    var d: ?^frontend.Decl = none
    if (ee.ref == (frontend.REF_CONST as u8)) or (ee.ref == (frontend.REF_ENUM as u8)) or (ee.ref == (frontend.REF_PROC as u8)) or (ee.ref == (frontend.REF_STRUCT as u8)) {
        d = ast_refs_decl_do_nome(refs, ee.nome, ee.modulo, j.modulo)
        if d != none {
            emitir_ref_da_decl(j, d, categoria_da_decl(d), none, 0)
        }
    } else if ee.ref == (frontend.REF_MEMBRO as u8) {
        d = ast_refs_decl_do_tipo(refs, ee.tipo)
        if d != none {
            emitir_ref_da_decl(j, d, "membro", "membros", ee.ref_id)
        }
    } else if ee.ref == (frontend.REF_CAMPO as u8) {
        d = ast_refs_decl_do_tipo(refs, (ee.a as ^frontend.Expr).tipo)
        if d != none {
            emitir_ref_da_decl(j, d, "campo", "campos", ee.ref_id)
        }
    }
}

// Tipos da linguagem (i32, f64...) e as palavras de alocador ('alloc = heap | frame | scope'; escopo e a forma antiga, L3c).
// C: semantic/ast_json_ref.c:397
proc nome_eh_palavra_da_linguagem(texto: str, n: u64) -> bool {
    let procurado: str = texto[0..<n]
    for i in 0..<len(ALOCADORES) {
        if ALOCADORES[i] == procurado {
            return true
        }
    }
    for t in (1 as u32)..=(16 as u32) {
        let nome: ?str = tipo_nome_fixo(t)
        if nome != none {
            let nome_t: str = nome or_else ""
            if (common.c2f_nul_em(nome_t, 0) != 40) and (nome_t == procurado) { // '('
                return true
            }
        }
    }
    return false
}

// Nome usado como tipo ou palavra de alocador (transmute(x, para = T), make(..., em = heap)): a semantica nao o liga a nada. Struct, enum, union e unit declarados viram ref; i32, heap... sao embutidos.
// C: semantic/ast_json_ref.c:411
proc ref_do_nome_de_tipo(j: ^Json, e: ?^frontend.Expr) {
    let ee: ^frontend.Expr = e as ^frontend.Expr
    let d: ?^frontend.Decl = decl_do_nome_de_tipo(j, ee.nome, ee.modulo)
    if d != none {
        let dd: ^frontend.Decl = d as ^frontend.Decl
        if (dd.tipo_no == (frontend.D_STRUCT as u8)) or (dd.tipo_no == (frontend.D_ENUM as u8)) or (dd.tipo_no == (frontend.D_UNIAO as u8)) or (dd.tipo_no == (frontend.D_UNIDADE_BASE as u8)) or (dd.tipo_no == (frontend.D_UNIDADE_DERIV as u8)) {
            emitir_ref_da_decl(j, d, categoria_da_decl(d), none, 0)
            ref_do_import(j, ee.modulo, ee.pos)
            return
        }
    }
    if nome_eh_palavra_da_linguagem(common.interner_texto(j.nomes as ^common.Interner, ee.nome), common.interner_tam(j.nomes as ^common.Interner, ee.nome) as u64) {
        append(j.b as ^[dynamic]u8, item = ", \"ref_tipo\": \"embutido\"")
    }
}

// C: semantic/ast_json_ref.c:422
proc ref_da_expr(j: ^Json, e: ?^frontend.Expr) {
    let ee: ^frontend.Expr = e as ^frontend.Expr
    let nomeia: bool = (ee.tipo_no == (frontend.EX_NOME as u8)) or (ee.tipo_no == (frontend.EX_CHAMADA as u8)) or (ee.tipo_no == (frontend.EX_CAMPO as u8)) or (ee.tipo_no == (frontend.EX_LITERAL_STRUCT as u8))
    if (j.refs == none) or (not nomeia) {
        return
    }
    let r: ?^AstRefEntrada = achar_entrada(j.refs, ee.pos_op, ee.tipo_no)
    if r == none {
        if ee.tipo_no == (frontend.EX_NOME as u8) {
            ref_do_nome_de_tipo(j, e)
        }
        return
    }
    let re: ^frontend.Expr = (r as ^AstRefEntrada).e as ^frontend.Expr
    if re.ref == (frontend.REF_EMBUTIDO as u8) {
        append(j.b as ^[dynamic]u8, item = ", \"ref_tipo\": \"embutido\"")
        return
    }
    if (re.ref == (frontend.REF_LOCAL as u8)) or (re.ref == (frontend.REF_PARAM as u8)) {
        emitir_ref_do_local(j, r)
    } else {
        emitir_ref_global(j, (r as ^AstRefEntrada).e)
    }
    ref_do_import(j, ee.modulo, ee.pos)
}

// Nome de tipo (id do Interner de j): a declaracao global dele, procurada pelo texto na semantica que analisou.
// C: semantic/ast_json_ref.c:442
proc decl_do_nome_de_tipo(j: ^Json, nome: i32, qualificador: u8) -> ?^frontend.Decl {
    if (j.refs == none) or (nome < 0) {
        return none
    }
    let nomes_sem: ^common.Interner = nomes_da_sem((j.refs as ^AstRefs).sem as ^Semantica)
    let na_semantica: i32 = common.interner_achar(nomes_sem, common.interner_texto(j.nomes as ^common.Interner, nome), common.interner_tam(j.nomes as ^common.Interner, nome))
    return ast_refs_decl_do_nome(j.refs, na_semantica, qualificador, j.modulo)
}

// C: semantic/ast_json_ref.c:450
proc ref_do_tipo(j: ^Json, t: ?^frontend.TipoRef) {
    var d: ?^frontend.Decl = none
    if (t as ^frontend.TipoRef).forma != (frontend.TR_NOME as u8) {
        return
    }
    d = decl_do_nome_de_tipo(j, (t as ^frontend.TipoRef).nome, (t as ^frontend.TipoRef).modulo)
    if d == none {
        return
    }
    emitir_ref_da_decl(j, d, categoria_da_decl(d), none, 0)
    ref_do_import(j, (t as ^frontend.TipoRef).modulo, (t as ^frontend.TipoRef).pos)
}

// C: semantic/ast_json_ref.c:461
proc ref_do_caso(j: ^Json, c: ^frontend.Caso) {
    if c.padrao or (c.tipo_escrito != none) {
        return
    }
    let d: ?^frontend.Decl = decl_do_nome_de_tipo(j, c.tipo_nome, c.modulo)
    if d == none {
        return
    }
    let dd: ^frontend.Decl = d as ^frontend.Decl
    if (c.membro >= 0) and (dd.tipo_no == (frontend.D_ENUM as u8)) {
        let nomes_sem: ^common.Interner = nomes_da_sem((j.refs as ^AstRefs).sem as ^Semantica)
        let membro: i32 = common.interner_achar(nomes_sem, common.interner_texto(j.nomes as ^common.Interner, c.membro), common.interner_tam(j.nomes as ^common.Interner, c.membro))
        for k in (0 as u32)..<dd.nmembros {
            if (dd.membros or_else {})[k].nome == membro {
                emitir_ref_da_decl(j, d, "membro", "membros", k as i32)
                return
            }
        }
    }
    emitir_ref_da_decl(j, d, categoria_da_decl(d), none, 0)
}

// Texto do id como TextoJson o escreve (aspas, barra e controles com escape).
// C: semantic/ast_json_ref.c:482
proc escapar_id(saida: ^[dynamic]u8, id: str) {
    let bytes: []u8 = as_bytes(id)
    for i in 0..<len(bytes) {
        let ch: u8 = bytes[i]
        if (ch == 34) or (ch == 92) { // '"' '\\'
            append(saida, item = "\\")
            append(saida, item = ch)
        } else if ch < 32 {
            append(saida, item = "\\u")
            format(f"{ch:04x}", into = saida)
        } else {
            append(saida, item = ch)
        }
    }
}

// Abertura '{' do objeto cujo "id" comeca em 'achado': '{"id"' ou '{"no": "<tipo>", "id"'.
// C: semantic/ast_json_ref.c:497
proc abertura_do_objeto(json: []u8, achado: u64) -> u64 {
    var p: u64 = achado
    let abertura: []u8 = as_bytes("{\"no\": \"")
    if (p > 0) and (json[p - 1] == 123) { // '{'
        return p - 1
    }
    while p > 0 {
        p -= 1
        if (json[p] == 123) and ((p + 8) <= (len(json) as u64)) and (common.c2f_memcmp(json[p..<(p + 8)], abertura) == 0) {
            return p
        }
    }
    return 0
}

// Fim (exclusivo) do objeto que abre em 'ini': conta {} e [] fora de texto.
// C: semantic/ast_json_ref.c:509
proc fim_do_objeto(json: []u8, tam: u64, ini: u64) -> u64 {
    var profundidade: i32 = 0
    var em_texto: bool = false
    var k: u64 = ini
    while k < tam {
        let ch: u8 = json[k]
        if em_texto {
            if ch == 92 { // '\\'
                k += 1
            } else if ch == 34 { // '"'
                em_texto = false
            }
        } else if ch == 34 {
            em_texto = true
        } else if (ch == 123) or (ch == 91) { // '{' '['
            profundidade += 1
        } else if (ch == 125) or (ch == 93) { // '}' ']'
            profundidade -= 1
            if profundidade == 0 {
                return k + 1
            }
        }
        k += 1
    }
    return tam
}

// C2F-33: o json chega como bytes (o Buf do chamador); C2F-19: ini e fim ficam ^u64.
// C: semantic/ast_json_ref.c:529
proc ast_no_extrair(json: []u8, id: str, ini: ^u64, fim: ^u64) -> bool {
    var padrao: [dynamic]u8 = make([dynamic]u8, alloc = heap)
    defer delete(padrao)
    append(&padrao, item = "\"id\": \"")
    escapar_id(&padrao, id)
    append(&padrao, item = "\"")
    let np: u64 = len(padrao) as u64
    let nj: u64 = len(json) as u64
    if np > nj {
        return false
    }
    var achado: i64 = -1 // strstr: a 1a ocorrencia de padrao em json
    var a: u64 = 0
    while (a + np) <= nj {
        if (json[a] == padrao[0]) and (common.c2f_memcmp(json[a..<(a + np)], padrao[..]) == 0) {
            achado = a as i64
            break
        }
        a += 1
    }
    if achado < 0 {
        return false
    }
    ini^ = abertura_do_objeto(json, achado as u64)
    fim^ = fim_do_objeto(json, nj, ini^)
    return true
}
