import "common"
import "frontend"

struct AnonSemLista47 {
    nome: ?str
    id: i32
}

struct AnonSemLista50 {
    nome: ?str
    id: i32
}

struct AnonSemLista54 {
    nome: ?str
    id: i32
}

struct AnonSemLista58 {
    nome: ?str
    id: i32
}

// S4 (sem par no C): `char texto[96]` + SemDescrever(s, tipo, texto, sizeof texto) devolvidos como str de heap (o chamador faz delete).
proc s4_descrever(s: ^Semantica, tipo: u32) -> str {
    var buf: [96]u8 = {}
    sem_descrever(s, tipo, buf[..], 96)
    return from_bytes(buf[0..<common.c2f_strlen_b(buf[..])], alloc = heap)
}

// S4 (sem par no C): `ArenaAlocar(s->arena, sizeof(Expr))` zerado. new(frontend.Expr) e E1003 fora do pacote e ast.fj nao tem arena_fatia_expr (C2F-20).
proc s4_novo_expr(s: ^Semantica) -> ^frontend.Expr {
    var l = make([dynamic]frontend.Expr, alloc = common.arena_mem(s.arena as ^common.Arena), cap = 1)
    append(&l, item = frontend.Expr{})
    let fatia = l[..]
    return &fatia[0]
}

// S4 (sem par no C): `ArenaAlocar(s->arena, sizeof(Decl))` zerado (idem s4_novo_expr).
proc s4_novo_decl(s: ^Semantica) -> ^frontend.Decl {
    var l = make([dynamic]frontend.Decl, alloc = common.arena_mem(s.arena as ^common.Arena), cap = 1)
    append(&l, item = frontend.Decl{})
    let fatia = l[..]
    return &fatia[0]
}

// S4 (sem par no C): `ArenaAlocar(s->arena, n * sizeof(Campo))` zerado (ast.fj nao tem arena_fatia_campo).
proc s4_arena_fatia_campo(s: ^Semantica, n: int) -> []frontend.Campo {
    var l = make([dynamic]frontend.Campo, alloc = common.arena_mem(s.arena as ^common.Arena), cap = n)
    for i in 0..<n {
        append(&l, item = frontend.Campo{})
    }
    return l[..]
}

const NOMES_QTD_3: i32 = 19
const ASS_LISTA: i32 = 0
const ASS_RESERVE: i32 = 1
const ASS_INDICE: i32 = 3
const ASS_INSERT_AT: i32 = 5
const ASS_LISTA_VALOR: i32 = 8
const ASS_COLECAO: i32 = 10
const ASS_COLECAO_VALOR: i32 = 11
const ASS_COPY: i32 = 13
const ASS_CLONE: i32 = 15
const ASS_SWAP: i32 = 17
const ASS_REPLACE: i32 = 20
const ASS_MAPA: i32 = 24
const ASS_BYTES: i32 = 26
const ASS_TEXTO: i32 = 28
const ASS_COLECAO_ALLOC: i32 = 29
const ASS_SORTEIO: i32 = 31
const ASS_HEAP_PUSH: i32 = 33
const ASS_HEAP_PUSH_BY: i32 = 35
const ASS_HEAP_POP_BY: i32 = 38
const ASS_FIM: i32 = 40
const NOMES_4: [19]str = {"cap", "clear", "reserve", "truncate", "pop", "insert_at", "ordered_remove", "unordered_remove", "remove_value", "index_of", "last_index_of", "contains", "count", "copy", "fill", "clone", "swap", "reverse", "replace_value"}
const PARAMS_NOVOS: [13]str = {"i", "j", "dst", "src", "old", "new", "alloc", "m", "bytes", "s", "rng", "v", "pred"}
const SORTEIO_NOMES: [2]AnonSemLista47 = {AnonSemLista47{nome = "shuffle", id = frontend.EMB_SHUFFLE}, AnonSemLista47{nome = "choice", id = frontend.EMB_CHOICE}}
const HEAP_NOMES: [4]AnonSemLista50 = {AnonSemLista50{nome = "heap_push", id = frontend.EMB_HEAP_PUSH}, AnonSemLista50{nome = "heap_pop", id = frontend.EMB_HEAP_POP}, AnonSemLista50{nome = "heap_push_by", id = frontend.EMB_HEAP_PUSH_BY}, AnonSemLista50{nome = "heap_pop_by", id = frontend.EMB_HEAP_POP_BY}}
const PRED_NOMES: [5]AnonSemLista54 = {AnonSemLista54{nome = "index_by", id = frontend.EMB_INDEX_BY}, AnonSemLista54{nome = "find_by", id = frontend.EMB_FIND_BY}, AnonSemLista54{nome = "any_by", id = frontend.EMB_ANY_BY}, AnonSemLista54{nome = "all_by", id = frontend.EMB_ALL_BY}, AnonSemLista54{nome = "count_by", id = frontend.EMB_COUNT_BY}}
const SET_NOMES: [3]AnonSemLista58 = {AnonSemLista58{nome = "set_union", id = frontend.EMB_SET_UNION}, AnonSemLista58{nome = "set_intersect", id = frontend.EMB_SET_INTERSECT}, AnonSemLista58{nome = "set_diff", id = frontend.EMB_SET_DIFF}}

// C: semantic/sem_lista.c:61
proc nome_interno_2(s: ^Semantica, texto: str) -> i32 {
    return common.internar(nomes_da_sem(s), texto, len(texto) as u32)
}

// C: semantic/sem_lista.c:66
proc sem_lista_internar(s: ^Semantica) {
    for k in 0..<(NOMES_QTD_3 as int) {
        _ = nome_interno_2(s, NOMES_4[k])
    }
    for k in 0..<13 {
        _ = nome_interno_2(s, PARAMS_NOVOS[k])
    }
    for k in 0..<2 {
        _ = nome_interno_2(s, SORTEIO_NOMES[k].nome or_else "")
    }
    for k in 0..<4 {
        _ = nome_interno_2(s, HEAP_NOMES[k].nome or_else "")
    }
    for k in 0..<5 {
        _ = nome_interno_2(s, PRED_NOMES[k].nome or_else "")
    }
    for k in 0..<3 {
        _ = nome_interno_2(s, SET_NOMES[k].nome or_else "")
    }
}

// C: semantic/sem_lista.c:77
// O C grava y->categoria/indice/tipo direto; registrar_embutido (semantic.fj) faz exatamente isso (semantic.c:63).
proc sem_lista_registrar(s: ^Semantica) {
    for k in 0..<(NOMES_QTD_3 as int) {
        registrar_embutido(s, nome_interno_2(s, NOMES_4[k]), SIM_PROC_EMBUTIDO, frontend.EMB_CAP + (k as i32), TIPO_VAZIO as u32)
    }
    for k in 0..<2 {
        registrar_embutido(s, nome_interno_2(s, SORTEIO_NOMES[k].nome or_else ""), SIM_PROC_EMBUTIDO, SORTEIO_NOMES[k].id, TIPO_VAZIO as u32)
    }
    for k in 0..<4 {
        registrar_embutido(s, nome_interno_2(s, HEAP_NOMES[k].nome or_else ""), SIM_PROC_EMBUTIDO, HEAP_NOMES[k].id, TIPO_VAZIO as u32)
    }
    for k in 0..<5 {
        registrar_embutido(s, nome_interno_2(s, PRED_NOMES[k].nome or_else ""), SIM_PROC_EMBUTIDO, PRED_NOMES[k].id, TIPO_VAZIO as u32)
    }
    for k in 0..<3 {
        registrar_embutido(s, nome_interno_2(s, SET_NOMES[k].nome or_else ""), SIM_PROC_EMBUTIDO, SET_NOMES[k].id, TIPO_VAZIO as u32)
    }
}

// C: semantic/sem_lista.c:112
proc sem_lista_montar(s: ^Semantica) {
    let p = s.params_lista[..]
    let i: i32 = nome_interno_2(s, "i")
    let j: i32 = nome_interno_2(s, "j")
    let dst: i32 = nome_interno_2(s, "dst")
    let src: i32 = nome_interno_2(s, "src")
    let antigo: i32 = nome_interno_2(s, "old")
    let novo: i32 = nome_interno_2(s, "new")
    p[ASS_LISTA] = frontend.Param{nome = s.nome_lista}
    p[ASS_RESERVE] = frontend.Param{nome = s.nome_lista}
    p[ASS_RESERVE + 1] = frontend.Param{nome = s.nome_cap}
    p[ASS_INDICE] = frontend.Param{nome = s.nome_lista}
    p[ASS_INDICE + 1] = frontend.Param{nome = i}
    p[ASS_INSERT_AT] = frontend.Param{nome = s.nome_lista}
    p[ASS_INSERT_AT + 1] = frontend.Param{nome = i}
    p[ASS_INSERT_AT + 2] = frontend.Param{nome = s.nome_item}
    p[ASS_LISTA_VALOR] = frontend.Param{nome = s.nome_lista}
    p[ASS_LISTA_VALOR + 1] = frontend.Param{nome = s.nome_value}
    p[ASS_COLECAO] = frontend.Param{nome = s.nome_colecao}
    p[ASS_COLECAO_VALOR] = frontend.Param{nome = s.nome_colecao}
    p[ASS_COLECAO_VALOR + 1] = frontend.Param{nome = s.nome_value}
    p[ASS_COPY] = frontend.Param{nome = dst}
    p[ASS_COPY + 1] = frontend.Param{nome = src}
    p[ASS_CLONE] = frontend.Param{nome = s.nome_colecao}
    p[ASS_CLONE + 1] = frontend.Param{nome = nome_interno_2(s, "alloc")} // o rotulo ja na forma nova: o clone nunca teve `em`, entao nao entra na tabela de renomeados
    p[ASS_SWAP] = frontend.Param{nome = s.nome_colecao}
    p[ASS_SWAP + 1] = frontend.Param{nome = i}
    p[ASS_SWAP + 2] = frontend.Param{nome = j}
    p[ASS_REPLACE] = frontend.Param{nome = s.nome_colecao}
    p[ASS_REPLACE + 1] = frontend.Param{nome = antigo}
    p[ASS_REPLACE + 2] = frontend.Param{nome = novo}
    p[ASS_REPLACE + 3] = frontend.Param{nome = s.nome_n, padrao = &s.padrao_cap} // n e opcional: o padrao so diz "pode faltar" (o lowering le NULL)
    p[ASS_MAPA] = frontend.Param{nome = nome_interno_2(s, "m")}
    p[ASS_MAPA + 1] = frontend.Param{nome = nome_interno_2(s, "alloc")}
    p[ASS_BYTES] = frontend.Param{nome = nome_interno_2(s, "bytes")}
    p[ASS_BYTES + 1] = frontend.Param{nome = nome_interno_2(s, "alloc")}
    p[ASS_TEXTO] = frontend.Param{nome = nome_interno_2(s, "s")}
    p[ASS_COLECAO_ALLOC] = frontend.Param{nome = s.nome_colecao}
    p[ASS_COLECAO_ALLOC + 1] = frontend.Param{nome = nome_interno_2(s, "alloc"), padrao = &s.padrao_cap} // opcional na tabela: reverse de str exige (E0503 no tratador); lista nao aceita
    p[ASS_SORTEIO] = frontend.Param{nome = s.nome_colecao}
    p[ASS_SORTEIO + 1] = frontend.Param{nome = nome_interno_2(s, "rng"), padrao = &s.padrao_cap} // opcional na tabela: a falta vira E0338 no tratador (sem_sorteio.c), nao E0503
    p[ASS_HEAP_PUSH] = frontend.Param{nome = s.nome_lista}
    p[ASS_HEAP_PUSH + 1] = frontend.Param{nome = nome_interno_2(s, "v")}
    p[ASS_HEAP_PUSH_BY] = frontend.Param{nome = s.nome_lista}
    p[ASS_HEAP_PUSH_BY + 1] = frontend.Param{nome = nome_interno_2(s, "v")}
    p[ASS_HEAP_PUSH_BY + 2] = frontend.Param{nome = s.nome_less}
    p[ASS_HEAP_POP_BY] = frontend.Param{nome = s.nome_lista}
    p[ASS_HEAP_POP_BY + 1] = frontend.Param{nome = s.nome_less}
}

// C: semantic/sem_lista.c:162
proc sem_lista_inteiro(s: ^Semantica, v: ?^frontend.Expr, papel: str) -> bool {
    var negativo: bool = false
    var magnitude: u64 = 0
    if not sem_checar(s, v, TIPO_INT as u32) {
        return false
    }
    if not tipo_eh_inteiro((v as ^frontend.Expr).tipo) {
        return sem_erro_do_inteiro(s, v, papel)
    }
    if ((common.c2f_b2i32(sem_inteiro_constante(s, v, &negativo, &magnitude)) != 0) and (common.c2f_b2i32(negativo) != 0)) and (magnitude != 0) {
        let msg_1 = format(f"{papel} negativo (-{magnitude})", alloc = heap)
        defer delete(msg_1)
        return sem_erro(s, common.E0421, (v as ^frontend.Expr).pos, msg_1)
    }
    return true
}

// C: semantic/sem_lista.c:174
proc sem_lista_valor_do_elemento(s: ^Semantica, v: ?^frontend.Expr, elemento: u32) -> bool {
    return (common.c2f_b2i32(sem_checar(s, v, elemento)) != 0) and (common.c2f_b2i32(sem_coagir(s, v, elemento, (v as ^frontend.Expr).pos)) != 0)
}

// C: semantic/sem_lista.c:179
proc sem_lista_comparavel(s: ^Semantica, e: ^frontend.Expr, elemento: u32) -> bool {
    if (((tipo_eh_inteiro(elemento) or tipo_eh_real(&s.tipos, elemento)) or (elemento == (TIPO_BOOL as u32))) or (elemento == (TIPO_TEXTO as u32))) or (tipo_classe_de(&s.tipos, elemento) == TC_ENUM) {
        return true
    }
    let texto = s4_descrever(s, elemento)
    defer delete(texto)
    let quem = sem_nome_texto(s, e.nome)
    let msg_1 = format(f"{quem} pede elemento comparavel com == (inteiro, real, bool, str ou enum); {texto} nao tem ==: compare campo a campo num laco", alloc = heap)
    defer delete(msg_1)
    return sem_erro(s, common.E0301, e.pos_op, msg_1)
}

// C: semantic/sem_lista.c:191
proc sem_lista_sem_dono(s: ^Semantica, e: ^frontend.Expr, elemento: u32, efeito: str) -> bool {
    if not sem_tipo_eh_dono(s, elemento) {
        return true
    }
    let msg_1 = format(f"{sem_nome_texto(s, e.nome)} {efeito} elementos que sao donos de memoria (a memoria deles se perderia ou ficaria com dois donos); trate cada dono com delete antes", alloc = heap)
    defer delete(msg_1)
    return sem_erro(s, common.E0311, e.pos_op, msg_1)
}

// C: semantic/sem_lista.c:199
proc ponteiro_de_lista(s: ^Semantica, t: u32) -> bool {
    let k: ^TipoInfo = tipo_de(&s.tipos, t)
    return (k.classe == (TC_PONTEIRO as u8)) and (common.c2f_s2u_32(tipo_classe_de(&s.tipos, k.a)) == (TC_DINAMICO as u32))
}

// C: semantic/sem_lista.c:206
proc ponteiro_de_mapa(s: ^Semantica, t: u32) -> bool {
    let k: ^TipoInfo = tipo_de(&s.tipos, t)
    return (k.classe == (TC_PONTEIRO as u8)) and (common.c2f_s2u_32(tipo_classe_de(&s.tipos, k.a)) == (TC_MAPA as u32))
}

// C: semantic/sem_lista.c:213
proc lista_ja_checada_por_endereco(s: ^Semantica, e: ^frontend.Expr, elemento: ^u32) -> bool {
    let quem = sem_nome_texto(s, e.nome)
    let lista: ?^frontend.Expr = (argumento_do_parametro(e, 0) as ^frontend.Arg).valor
    let l: ^frontend.Expr = lista as ^frontend.Expr
    if not ponteiro_de_lista(s, l.tipo) {
        let texto = s4_descrever(s, l.tipo)
        defer delete(texto)
        if tipo_classe_de(&s.tipos, l.tipo) == TC_DINAMICO {
            let msg_1 = format(f"{quem} recebe o endereco da lista: {quem}(&lista, ...)", alloc = heap)
            defer delete(msg_1)
            return sem_erro(s, common.E0310, l.pos, msg_1)
        }
        let msg_2 = format(f"{quem} pede ^[dynamic]T (tipo {texto})", alloc = heap)
        defer delete(msg_2)
        return sem_erro(s, common.E0310, l.pos, msg_2)
    }
    // C2F-32: snprintf(motivo, 96, ...) corta em 95 bytes
    let motivo_inteiro = format(f"{quem} altera a lista: declare com var", alloc = heap)
    defer delete(motivo_inteiro)
    let motivo = motivo_inteiro[0..<min(len(motivo_inteiro), 95)]
    if ((l.tipo_no == (frontend.EX_UNARIO as u8)) and (l.op == (frontend.OP_ENDERECO as u8))) and (not sem_lvalor_mutavel_de(s, l.a, motivo)) {
        return false
    }
    elemento^ = tipo_de(&s.tipos, tipo_de(&s.tipos, l.tipo).a).a
    return true
}

// C: semantic/sem_lista.c:230
proc lista_por_endereco(s: ^Semantica, e: ^frontend.Expr, elemento: ^u32) -> bool {
    return (common.c2f_b2i32(sem_checar(s, (argumento_do_parametro(e, 0) as ^frontend.Arg).valor, TIPO_VAZIO as u32)) != 0) and (common.c2f_b2i32(lista_ja_checada_por_endereco(s, e, elemento)) != 0)
}

// C: semantic/sem_lista.c:237
proc chamar_cap(s: ^Semantica, e: ^frontend.Expr) -> bool {
    if not sem_ligar_embutido(s, e, s.params_lista[(ASS_LISTA as int)..<((ASS_LISTA as int) + 1)]) {
        return false
    }
    let lista: ?^frontend.Expr = (argumento_do_parametro(e, 0) as ^frontend.Arg).valor
    if not sem_checar(s, lista, TIPO_VAZIO as u32) {
        return false
    }
    let l: ^frontend.Expr = lista as ^frontend.Expr
    if (tipo_classe_de(&s.tipos, l.tipo) != TC_DINAMICO) and (not ponteiro_de_lista(s, l.tipo)) {
        let texto = s4_descrever(s, l.tipo)
        defer delete(texto)
        let msg_1 = format(f"cap pede [dynamic]T ou ^[dynamic]T (tipo {texto})", alloc = heap)
        defer delete(msg_1)
        return sem_erro(s, common.E0310, l.pos, msg_1)
    }
    e.tipo = TIPO_INT as u32
    return true
}

// C: semantic/sem_lista.c:252
proc chamar_clear_pop(s: ^Semantica, e: ^frontend.Expr, embutido: i32) -> bool {
    var elemento: u32 = 0
    if not sem_ligar_embutido(s, e, s.params_lista[(ASS_LISTA as int)..<((ASS_LISTA as int) + 1)]) {
        return false
    }
    let alvo: ?^frontend.Expr = (argumento_do_parametro(e, 0) as ^frontend.Arg).valor
    if not sem_checar(s, alvo, TIPO_VAZIO as u32) {
        return false
    }
    let a: ^frontend.Expr = alvo as ^frontend.Expr
    if (embutido == frontend.EMB_CLEAR) and (ponteiro_de_mapa(s, a.tipo) or (tipo_classe_de(&s.tipos, a.tipo) == TC_MAPA)) {
        return sem_chamar_clear_mapa(s, e, alvo)
    }
    if not lista_ja_checada_por_endereco(s, e, &elemento) {
        return false
    }
    var efeito: str = "tiraria"
    if embutido == frontend.EMB_CLEAR {
        efeito = "esvaziaria"
    }
    if not sem_lista_sem_dono(s, e, elemento, efeito) {
        return false
    }
    if embutido == frontend.EMB_CLEAR {
        e.tipo = TIPO_VAZIO as u32
        return true
    }
    let ponteiro: bool = tipo_classe_de(&s.tipos, elemento) == TC_PONTEIRO
    if ponteiro {
        e.tipo = tipo_anulavel(&s.tipos, tipo_de(&s.tipos, elemento).a)
    } else {
        e.tipo = tipo_opcional(&s.tipos, elemento)
    }
    return true
}

// C: semantic/sem_lista.c:271
proc chamar_reserve_truncate(s: ^Semantica, e: ^frontend.Expr, embutido: i32) -> bool {
    var elemento: u32 = 0
    let reserva: bool = embutido == frontend.EMB_RESERVE
    var assinatura: []frontend.Param = s.params_resize[..]
    if reserva {
        assinatura = s.params_lista[(ASS_RESERVE as int)..<((ASS_RESERVE as int) + 2)]
    }
    if (not sem_ligar_embutido(s, e, assinatura)) or (not lista_por_endereco(s, e, &elemento)) {
        return false
    }
    if (not reserva) and (not sem_lista_sem_dono(s, e, elemento, "soltaria")) {
        return false
    }
    var papel: str = "len"
    if reserva {
        papel = "cap"
    }
    if not sem_lista_inteiro(s, (argumento_do_parametro(e, 1) as ^frontend.Arg).valor, papel) {
        return false
    }
    e.tipo = TIPO_VAZIO as u32
    return true
}

// C: semantic/sem_lista.c:284
proc chamar_insert_at(s: ^Semantica, e: ^frontend.Expr) -> bool {
    var elemento: u32 = 0
    if (not sem_ligar_embutido(s, e, s.params_lista[(ASS_INSERT_AT as int)..<((ASS_INSERT_AT as int) + 3)])) or (not lista_por_endereco(s, e, &elemento)) {
        return false
    }
    if not sem_lista_inteiro(s, (argumento_do_parametro(e, 1) as ^frontend.Arg).valor, "o indice") {
        return false
    }
    let item: ?^frontend.Expr = (argumento_do_parametro(e, 2) as ^frontend.Arg).valor
    if not sem_lista_valor_do_elemento(s, item, elemento) {
        return false
    }
    if (not sem_conferir_movimento(s, item)) or (not sem_conferir_posse(s, item, PONTO_GUARDA)) {
        return false
    }
    e.tipo = TIPO_VAZIO as u32
    return true
}

// C: semantic/sem_lista.c:297
proc chamar_remove_em(s: ^Semantica, e: ^frontend.Expr) -> bool {
    var elemento: u32 = 0
    if (not sem_ligar_embutido(s, e, s.params_lista[(ASS_INDICE as int)..<((ASS_INDICE as int) + 2)])) or (not lista_por_endereco(s, e, &elemento)) {
        return false
    }
    if not sem_lista_sem_dono(s, e, elemento, "tiraria") {
        return false
    }
    if not sem_lista_inteiro(s, (argumento_do_parametro(e, 1) as ^frontend.Arg).valor, "o indice") {
        return false
    }
    e.tipo = TIPO_VAZIO as u32
    return true
}

// C: semantic/sem_lista.c:308
proc chamar_remove_value(s: ^Semantica, e: ^frontend.Expr) -> bool {
    var elemento: u32 = 0
    if (not sem_ligar_embutido(s, e, s.params_lista[(ASS_LISTA_VALOR as int)..<((ASS_LISTA_VALOR as int) + 2)])) or (not lista_por_endereco(s, e, &elemento)) {
        return false
    }
    if (not sem_lista_comparavel(s, e, elemento)) or (not sem_lista_sem_dono(s, e, elemento, "tiraria")) {
        return false
    }
    if not sem_lista_valor_do_elemento(s, (argumento_do_parametro(e, 1) as ^frontend.Arg).valor, elemento) {
        return false
    }
    e.tipo = TIPO_BOOL as u32
    return true
}

// C: semantic/sem_lista.c:320
proc sem_chamar_dedup(s: ^Semantica, e: ^frontend.Expr) -> bool {
    var elemento: u32 = 0
    if (not sem_ligar_embutido(s, e, s.params_lista[(ASS_LISTA as int)..<((ASS_LISTA as int) + 1)])) or (not lista_por_endereco(s, e, &elemento)) {
        return false
    }
    if not sem_lista_sem_dono(s, e, elemento, "removeria") {
        return false
    }
    if not sem_lista_comparavel(s, e, elemento) {
        return false
    }
    e.tipo = TIPO_VAZIO as u32
    return true
}

// C: semantic/sem_lista.c:331
proc heap_ordenavel_sem_less(s: ^Semantica, e: ^frontend.Expr, elemento: u32) -> bool {
    if sem_eh_ordenavel_do_runtime(elemento) {
        return true
    }
    let texto = s4_descrever(s, elemento)
    defer delete(texto)
    let quem = sem_nome_texto(s, e.nome)
    let msg_1 = format(f"{quem} sem less: o elemento nao tem ordem propria (tipo {texto}); so inteiro, f32, f64 e str. Use {quem}_by(&l, less = p)", alloc = heap)
    defer delete(msg_1)
    return sem_erro(s, common.E0337, e.pos_op, msg_1)
}

// C: semantic/sem_lista.c:341
proc conferir_less_do_heap(s: ^Semantica, p: ?^frontend.Expr, elemento: u32) -> bool {
    var params: [2]u32 = {0, 0}
    var assinatura: ProcAssinatura = ProcAssinatura{params = params[..], nomes = none, n = 2, retorno = TIPO_BOOL as u32}
    params[0] = tipo_ponteiro(&s.tipos, elemento)
    params[1] = params[0]
    let comparador: u32 = tipo_proc(&s.tipos, &assinatura)
    s.comparador_sort_by = true
    let ok_comparador: bool = sem_checar(s, p, comparador)
    s.comparador_sort_by = false
    return ok_comparador and sem_coagir(s, p, comparador, (p as ^frontend.Expr).pos)
}

// C: semantic/sem_lista.c:355
proc chamar_heap_push(s: ^Semantica, e: ^frontend.Expr, com_less: bool) -> bool {
    var elemento: u32 = 0
    var assinatura: []frontend.Param = s.params_lista[(ASS_HEAP_PUSH as int)..<((ASS_HEAP_PUSH as int) + 2)]
    if com_less {
        assinatura = s.params_lista[(ASS_HEAP_PUSH_BY as int)..<((ASS_HEAP_PUSH_BY as int) + 3)]
    }
    if (not sem_ligar_embutido(s, e, assinatura)) or (not lista_por_endereco(s, e, &elemento)) {
        return false
    }
    if com_less {
        if not conferir_less_do_heap(s, (argumento_do_parametro(e, 2) as ^frontend.Arg).valor, elemento) {
            return false
        }
    } else if not heap_ordenavel_sem_less(s, e, elemento) {
        return false
    }
    let item: ?^frontend.Expr = (argumento_do_parametro(e, 1) as ^frontend.Arg).valor
    if not sem_lista_valor_do_elemento(s, item, elemento) {
        return false
    }
    if (not sem_conferir_movimento(s, item)) or (not sem_conferir_posse(s, item, PONTO_GUARDA)) {
        return false
    }
    e.tipo = TIPO_VAZIO as u32
    return true
}

// C: semantic/sem_lista.c:373
proc chamar_heap_pop(s: ^Semantica, e: ^frontend.Expr, com_less: bool) -> bool {
    var elemento: u32 = 0
    var assinatura: []frontend.Param = s.params_lista[(ASS_LISTA as int)..<((ASS_LISTA as int) + 1)]
    if com_less {
        assinatura = s.params_lista[(ASS_HEAP_POP_BY as int)..<((ASS_HEAP_POP_BY as int) + 2)]
    }
    if (not sem_ligar_embutido(s, e, assinatura)) or (not lista_por_endereco(s, e, &elemento)) {
        return false
    }
    if not sem_lista_sem_dono(s, e, elemento, "tiraria") {
        return false
    }
    if com_less {
        if not conferir_less_do_heap(s, (argumento_do_parametro(e, 1) as ^frontend.Arg).valor, elemento) {
            return false
        }
    } else if not heap_ordenavel_sem_less(s, e, elemento) {
        return false
    }
    let ponteiro: bool = tipo_classe_de(&s.tipos, elemento) == TC_PONTEIRO
    if ponteiro {
        e.tipo = tipo_anulavel(&s.tipos, tipo_de(&s.tipos, elemento).a)
    } else {
        e.tipo = tipo_opcional(&s.tipos, elemento)
    }
    return true
}

// C: semantic/sem_lista.c:389
proc sem_chamar_heap_push(s: ^Semantica, e: ^frontend.Expr) -> bool {
    return chamar_heap_push(s, e, false)
}

// C: semantic/sem_lista.c:390
proc sem_chamar_heap_push_by(s: ^Semantica, e: ^frontend.Expr) -> bool {
    return chamar_heap_push(s, e, true)
}

// C: semantic/sem_lista.c:391
proc sem_chamar_heap_pop(s: ^Semantica, e: ^frontend.Expr) -> bool {
    return chamar_heap_pop(s, e, false)
}

// C: semantic/sem_lista.c:392
proc sem_chamar_heap_pop_by(s: ^Semantica, e: ^frontend.Expr) -> bool {
    return chamar_heap_pop(s, e, true)
}

// C: semantic/sem_lista.c:395
proc conferir_pred_da_busca(s: ^Semantica, p: ?^frontend.Expr, elemento: u32) -> bool {
    var params: [1]u32 = {0}
    var assinatura: ProcAssinatura = ProcAssinatura{params = params[..], nomes = none, n = 1, retorno = TIPO_BOOL as u32}
    params[0] = tipo_ponteiro(&s.tipos, elemento)
    let predicado: u32 = tipo_proc(&s.tipos, &assinatura)
    s.comparador_sort_by = true
    let ok_predicado: bool = sem_checar(s, p, predicado)
    s.comparador_sort_by = false
    return ok_predicado and sem_coagir(s, p, predicado, (p as ^frontend.Expr).pos)
}

// C: semantic/sem_lista.c:408
proc conferir_busca_por_pred(s: ^Semantica, e: ^frontend.Expr, elemento: ^u32) -> bool {
    var params: [2]frontend.Param = {frontend.Param{nome = nome_interno_2(s, "x")}, frontend.Param{nome = nome_interno_2(s, "pred")}}
    if not sem_ligar_embutido(s, e, params[..]) {
        return false
    }
    let v: ?^frontend.Expr = (argumento_do_parametro(e, 0) as ^frontend.Arg).valor
    let p: ?^frontend.Expr = (argumento_do_parametro(e, 1) as ^frontend.Arg).valor
    if not sem_checar(s, v, TIPO_VAZIO as u32) {
        return false
    }
    let vv: ^frontend.Expr = v as ^frontend.Expr
    elemento^ = 0
    if tipo_classe_de(&s.tipos, vv.tipo) == TC_FATIA {
        elemento^ = tipo_de(&s.tipos, vv.tipo).a
    }
    if elemento^ == 0 {
        let texto = s4_descrever(s, vv.tipo)
        defer delete(texto)
        let quem = sem_nome_texto(s, e.nome)
        let msg_1 = format(f"{quem} pede uma fatia: {quem}(l[..], pred = p); recebeu {texto}", alloc = heap)
        defer delete(msg_1)
        return sem_erro(s, common.E0310, vv.pos, msg_1)
    }
    return conferir_pred_da_busca(s, p, elemento^)
}

// C: semantic/sem_lista.c:424
proc chamar_busca_por_pred(s: ^Semantica, e: ^frontend.Expr, embutido: i32) -> bool {
    var elemento: u32 = 0
    var tipos: [2]u32 = {TIPO_INT as u32, TIPO_BOOL as u32}
    if not conferir_busca_por_pred(s, e, &elemento) {
        return false
    }
    if (embutido == frontend.EMB_FIND_BY) and (not sem_lista_sem_dono(s, e, elemento, "copiaria")) {
        return false
    }
    if embutido == frontend.EMB_INDEX_BY {
        e.tipo = tipo_tupla(&s.tipos, tipos[..])
    } else if embutido == frontend.EMB_FIND_BY {
        if tipo_classe_de(&s.tipos, elemento) == TC_PONTEIRO {
            e.tipo = tipo_anulavel(&s.tipos, tipo_de(&s.tipos, elemento).a)
        } else {
            e.tipo = tipo_opcional(&s.tipos, elemento)
        }
    } else if embutido == frontend.EMB_COUNT_BY {
        e.tipo = TIPO_INT as u32
    } else {
        e.tipo = TIPO_BOOL as u32
    }
    return true
}

// C: semantic/sem_lista.c:438
proc sem_chamar_index_by(s: ^Semantica, e: ^frontend.Expr) -> bool {
    return chamar_busca_por_pred(s, e, frontend.EMB_INDEX_BY)
}

// C: semantic/sem_lista.c:439
proc sem_chamar_find_by(s: ^Semantica, e: ^frontend.Expr) -> bool {
    return chamar_busca_por_pred(s, e, frontend.EMB_FIND_BY)
}

// C: semantic/sem_lista.c:440
proc sem_chamar_any_by(s: ^Semantica, e: ^frontend.Expr) -> bool {
    return chamar_busca_por_pred(s, e, frontend.EMB_ANY_BY)
}

// C: semantic/sem_lista.c:441
proc sem_chamar_all_by(s: ^Semantica, e: ^frontend.Expr) -> bool {
    return chamar_busca_por_pred(s, e, frontend.EMB_ALL_BY)
}

// C: semantic/sem_lista.c:442
proc sem_chamar_count_by(s: ^Semantica, e: ^frontend.Expr) -> bool {
    return chamar_busca_por_pred(s, e, frontend.EMB_COUNT_BY)
}

// C: semantic/sem_lista.c:445
proc mapa_bool_do_conjunto(s: ^Semantica, t: u32) -> u32 {
    var tern_1: u32 = t
    if common.c2f_s2u_32(tipo_classe_de(&s.tipos, t)) == (TC_PONTEIRO as u32) {
        tern_1 = tipo_de(&s.tipos, t).a
    }
    let m: u32 = tern_1
    if (common.c2f_s2u_32(tipo_classe_de(&s.tipos, m)) != (TC_MAPA as u32)) or (tipo_de(&s.tipos, m).b != (TIPO_BOOL as u32)) {
        return 0
    }
    return m
}

// C: semantic/sem_lista.c:454
proc chamar_conjunto_mapa(s: ^Semantica, e: ^frontend.Expr) -> bool {
    var params: [2]frontend.Param = {frontend.Param{nome = nome_interno_2(s, "dst")}, frontend.Param{nome = nome_interno_2(s, "src")}}
    if not sem_ligar_embutido(s, e, params[..]) {
        return false
    }
    let a: ?^frontend.Expr = (argumento_do_parametro(e, 0) as ^frontend.Arg).valor
    let b: ?^frontend.Expr = (argumento_do_parametro(e, 1) as ^frontend.Arg).valor
    if (not sem_checar(s, a, TIPO_VAZIO as u32)) or (not sem_checar(s, b, TIPO_VAZIO as u32)) {
        return false
    }
    let aa: ^frontend.Expr = a as ^frontend.Expr
    let bb: ^frontend.Expr = b as ^frontend.Expr
    let mapa: u32 = mapa_bool_do_conjunto(s, aa.tipo)
    let outro: u32 = mapa_bool_do_conjunto(s, bb.tipo)
    let quem = sem_nome_texto(s, e.nome)
    if mapa == 0 {
        let texto = s4_descrever(s, aa.tipo)
        defer delete(texto)
        let msg_1 = format(f"{quem} pede map[K]bool (presenca = membro): recebeu {texto}", alloc = heap)
        defer delete(msg_1)
        return sem_erro(s, common.E0310, aa.pos, msg_1)
    }
    if tipo_classe_de(&s.tipos, aa.tipo) != TC_PONTEIRO {
        let msg_2 = format(f"{quem} recebe o endereco do map: {quem}(&a, b)", alloc = heap)
        defer delete(msg_2)
        return sem_erro(s, common.E0318, aa.pos, msg_2)
    }
    if not sem_conferir_clear_mapa(s, a) {
        return false
    }
    if outro != mapa {
        let texto_2 = s4_descrever(s, bb.tipo)
        defer delete(texto_2)
        var codigo: i32 = common.E0301
        if outro == 0 {
            codigo = common.E0310
        }
        let msg_3 = format(f"{quem} pede o mesmo map[K]bool do 1o argumento (recebeu {texto_2})", alloc = heap)
        defer delete(msg_3)
        return sem_erro(s, codigo, bb.pos, msg_3)
    }
    e.tipo = TIPO_VAZIO as u32
    return true
}

// C: semantic/sem_lista.c:478
proc sem_chamar_set_union(s: ^Semantica, e: ^frontend.Expr) -> bool {
    return chamar_conjunto_mapa(s, e)
}

// C: semantic/sem_lista.c:479
proc sem_chamar_set_intersect(s: ^Semantica, e: ^frontend.Expr) -> bool {
    return chamar_conjunto_mapa(s, e)
}

// C: semantic/sem_lista.c:480
proc sem_chamar_set_diff(s: ^Semantica, e: ^frontend.Expr) -> bool {
    return chamar_conjunto_mapa(s, e)
}

// C: semantic/sem_lista.c:482
proc sem_chamar_lista(s: ^Semantica, e: ^frontend.Expr, embutido: i32) -> bool {
    if embutido == frontend.EMB_CAP {
        return chamar_cap(s, e)
    } else if embutido == frontend.EMB_CLEAR or embutido == frontend.EMB_POP {
        return chamar_clear_pop(s, e, embutido)
    } else if embutido == frontend.EMB_RESERVE or embutido == frontend.EMB_TRUNCATE {
        return chamar_reserve_truncate(s, e, embutido)
    } else if embutido == frontend.EMB_INSERT_AT {
        return chamar_insert_at(s, e)
    } else if embutido == frontend.EMB_ORDERED_REMOVE or embutido == frontend.EMB_UNORDERED_REMOVE {
        return chamar_remove_em(s, e)
    } else if embutido == frontend.EMB_REMOVE_VALUE {
        return chamar_remove_value(s, e)
    } else {
        return sem_chamar_busca(s, e, embutido)
    }
    return false
}

// G3 S4: internar todos os nomes da tabela e montar os parametros (nome de cada rotulo e o padrao so nos opcionais)
test "sem_lista: internar e montar os parametros" {
    var arenas = make([dynamic]common.Arena, alloc = heap)
    append(&arenas, item = common.Arena{})
    let arena: ^common.Arena = &arenas[0]
    var sv: Semantica = Semantica{}
    sv.arena = arena
    var ins = make([dynamic]common.Interner, alloc = heap)
    append(&ins, item = common.Interner{})
    common.interner_iniciar(&ins[0], arena)
    sv.nomes = ins[0..<1]
    sv.nome_lista = 100
    sv.nome_cap = 101
    sv.nome_item = 102
    sv.nome_value = 103
    sv.nome_colecao = 104
    sv.nome_less = 105
    sv.nome_n = 106
    sem_lista_internar(&sv)
    for k in 0..<(NOMES_QTD_3 as int) {
        expect(common.interner_achar(&ins[0], NOMES_4[k], len(NOMES_4[k]) as u32) >= 0)
    }
    for k in 0..<13 {
        expect(common.interner_achar(&ins[0], PARAMS_NOVOS[k], len(PARAMS_NOVOS[k]) as u32) >= 0)
    }
    expect(common.interner_achar(&ins[0], "foi_nao_internado", 17) < 0)
    sem_lista_montar(&sv)
    let dst: i32 = common.interner_achar(&ins[0], "dst", 3)
    let src: i32 = common.interner_achar(&ins[0], "src", 3)
    let alloc: i32 = common.interner_achar(&ins[0], "alloc", 5)
    expect(sv.params_lista[ASS_LISTA].nome == 100 and sv.params_lista[ASS_RESERVE + 1].nome == 101 and sv.params_lista[ASS_INSERT_AT + 2].nome == 102)
    expect(sv.params_lista[ASS_COPY].nome == dst and sv.params_lista[ASS_COPY + 1].nome == src and sv.params_lista[ASS_CLONE + 1].nome == alloc)
    expect(sv.params_lista[ASS_HEAP_PUSH_BY + 2].nome == 105 and sv.params_lista[ASS_REPLACE + 3].nome == 106)
    expect(sv.params_lista[ASS_REPLACE + 3].padrao != none and sv.params_lista[ASS_COLECAO_ALLOC + 1].padrao != none and sv.params_lista[ASS_SORTEIO + 1].padrao != none)
    expect(sv.params_lista[ASS_LISTA].padrao == none and sv.params_lista[ASS_MAPA + 1].padrao == none and sv.params_lista[ASS_REPLACE + 2].padrao == none)
    common.interner_liberar(&ins[0])
    delete(ins)
    common.arena_liberar(arena)
    delete(arenas)
}
