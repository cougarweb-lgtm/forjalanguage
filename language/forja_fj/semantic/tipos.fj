// C: semantic/tipos.c:165
// C2F-13: elementos fundido em n (len)
proc tipo_tupla(t: ^Tipos, elementos: []u32) -> u32 {
    var cauda: u32 = 0
    var k: u32 = (len(elementos) as u32) - 1
    while k >= 1 {
        cauda = obter(t, TC_TUPLA_CAUDA, elementos[k], cauda)
        k -= 1
    }
    return obter(t, TC_TUPLA, elementos[0], cauda)
}

// C: semantic/tipos.c:172
pub proc tipo_tupla_qtd(t: ^Tipos, tupla: u32) -> u32 {
    var n: u32 = 1
    var c: u32 = tipo_de(t, tupla).b
    while c != 0 {
        n += 1
        c = tipo_de(t, c).b
    }
    return n
}

// C: semantic/tipos.c:179
pub proc tipo_tupla_elemento(t: ^Tipos, tupla: u32, k: u32) -> u32 {
    var k_v: u32 = k
    let info: ^TipoInfo = tipo_de(t, tupla)
    if k_v == 0 {
        return info.a
    }
    var c: u32 = info.b
    while k_v > 1 {
        c = tipo_de(t, c).b
        k_v -= 1
    }
    return tipo_de(t, c).a
}

// C: semantic/tipos.c:189
proc tipo_proc(t: ^Tipos, a: ^ProcAssinatura) -> u32 {
    var cauda: u32 = 0
    var k: u32 = a.n
    while k >= 1 {
        var tern_1: u32 = 4294967295
        if a.nomes != none {
            tern_1 = common.c2f_s2u_32((a.nomes or_else {})[k - 1])
        }
        let nome: u32 = tern_1
        cauda = obter_nome(t, TC_TUPLA_CAUDA, (a.params or_else {})[k - 1], cauda, nome)
        k -= 1
    }
    return obter(t, TC_PROC, a.retorno, cauda)
}

// C: semantic/tipos.c:199
pub proc tipo_proc_qtd(t: ^Tipos, proc_c: u32) -> u32 {
    var n: u32 = 0
    var c: u32 = tipo_de(t, proc_c).b
    while c != 0 {
        n += 1
        c = tipo_de(t, c).b
    }
    return n
}

// C: semantic/tipos.c:207
proc param_do_proc_2(t: ^Tipos, proc_c: u32, k: u32) -> ^TipoInfo {
    var k_v: u32 = k
    var c: u32 = tipo_de(t, proc_c).b
    while k_v > 0 {
        c = tipo_de(t, c).b
        k_v -= 1
    }
    return tipo_de(t, c)
}

// C: semantic/tipos.c:214
proc tipo_proc_param(t: ^Tipos, proc_c: u32, k: u32) -> u32 {
    return param_do_proc_2(t, proc_c, k).a
}

// C: semantic/tipos.c:215
proc tipo_proc_nome(t: ^Tipos, proc_c: u32, k: u32) -> i32 {
    return transmute(param_do_proc_2(t, proc_c, k).c, to = i32)
}

// C: semantic/tipos.c:217
proc tipo_proc_compativel(t: ^Tipos, a: u32, b: u32) -> bool {
    if a == b {
        return true
    }
    if (tipo_classe_de(t, a) != TC_PROC) or (tipo_classe_de(t, b) != TC_PROC) {
        return false
    }
    let n: u32 = tipo_proc_qtd(t, a)
    if n != tipo_proc_qtd(t, b) {
        return false
    }
    if not tipo_proc_compativel(t, tipo_de(t, a).a, tipo_de(t, b).a) {
        return false
    }
    for k in (0 as u32)..<n {
        if not tipo_proc_compativel(t, tipo_proc_param(t, a, k), tipo_proc_param(t, b, k)) {
            return false
        }
    }
    return true
}

// C: semantic/tipos.c:248
pub proc tipo_largura_bits(t: ^Tipos, id: u32) -> u8 {
    if id < (TIPO_FIXOS_QTD as u32) {
        return LARGURA_FIXA[id]
    }
    var larg: u8 = 0
    if tipo_classe_de(t, id) == TC_REAL {
        larg = 32
    }
    return larg
}

// C: semantic/tipos.c:254
pub proc tipo_nome_fixo(id: u32) -> ?str {
    if id >= (TIPO_FIXOS_QTD as u32) {
        return none
    }
    let nome: str = NOME_DO_ID[id]
    if len(nome) == 0 {
        return none
    }
    return nome
}

// C: semantic/tipos.c:257
pub proc tipo_inteiro_max(id: u32) -> u64 {
    if id == (TIPO_I8 as u32) {
        return 127
    } else if id == (TIPO_I16 as u32) {
        return 32767
    } else if id == (TIPO_I32 as u32) {
        return 2147483647
    } else if id == (TIPO_INT as u32) {
        return 9223372036854775807
    } else if id == (TIPO_U8 as u32) {
        return 255
    } else if id == (TIPO_U16 as u32) {
        return 65535
    } else if id == (TIPO_U32 as u32) {
        return 4294967295
    } else {
        return 18446744073709551615
    }
    return 0
}

// C: semantic/tipos.c:271
pub proc tipo_inteiro_min(id: u32) -> i64 {
    if id == (TIPO_I8 as u32) {
        return -128
    } else if id == (TIPO_I16 as u32) {
        return -32768
    } else if id == (TIPO_I32 as u32) {
        return ((-2147483647) - 1) as i64
    } else if id == (TIPO_INT as u32) {
        return (-9223372036854775807) - 1
    } else {
        return 0
    }
    return 0
}

// C: semantic/tipos.c:282
// C2F-N1: `const char *digitos` vira []u8 (fatia do texto do fonte de off ate o fim; o lexer conta o fim como NUL)
pub proc tipo_ler_literal_u64(digitos: []u8, valor: ^u64) -> bool {
    return frontend.lexer_ler_inteiro_u64(digitos, valor) // v1.10: decimal, 0x... e 0b...
}

// C: semantic/tipos.c:287
pub proc tipo_inteiro_cabe(tipo: u32, negativo: bool, magnitude: u64) -> bool {
    if tipo_eh_sem_sinal(tipo) {
        var tern_1: i32 = 0
        if common.c2f_b2i32(negativo) != 0 {
            tern_1 = common.c2f_b2i32(magnitude == 0)
        } else {
            tern_1 = common.c2f_b2i32(magnitude <= tipo_inteiro_max(tipo))
        }
        return tern_1 != 0
    }
    var tern_2: i32 = 0
    if common.c2f_b2i32(negativo) != 0 {
        tern_2 = common.c2f_b2i32(magnitude <= (tipo_inteiro_max(tipo) + 1))
    } else {
        tern_2 = common.c2f_b2i32(magnitude <= tipo_inteiro_max(tipo))
    }
    return tern_2 != 0
}

// C: semantic/tipos.c:294
pub proc tipo_bits_cabem(tipo: u32, bits: i64) -> bool {
    if not tipo_eh_inteiro(tipo) {
        return true
    }
    if tipo_eh_sem_sinal(tipo) {
        return common.c2f_s2u_64(bits) <= tipo_inteiro_max(tipo)
    }
    return (bits >= tipo_inteiro_min(tipo)) and ((bits < 0) or (common.c2f_s2u_64(bits) <= tipo_inteiro_max(tipo)))
}

// C: semantic/tipos.c:301
proc texto_nome(t: ^Tipos, nome: i32, saida: ^[dynamic]u8) {
    let puro: str = common.nome_modulo_exibicao(common.interner_texto(t.nomes as ^common.Interner, nome))
    append(saida, item = puro[0..<len(puro)])
}

// C: semantic/tipos.c:307
proc texto_real(t: ^Tipos, dim: u32, saida: ^[dynamic]u8) {
    let nome: i32 = dim_nome(t.dims as ^DimTabela, dim)
    if dim == (DIM_ADIMENSIONAL as u32) {
        append(saida, item = "f32")
    } else if nome < 0 {
        append(saida, item = "(unidade sem nome)")
    } else {
        texto_nome(t, nome, saida)
    }
}

// C: semantic/tipos.c:316
proc texto_lista_fixa(t: ^Tipos, k: ^TipoInfo, saida: ^[dynamic]u8) {
    let itens: ^TipoInfo = tipo_de(t, k.b)
    append(saida, item = "[dynamic, ")
    format(f"{itens.b as u64}", into = saida)
    append(saida, item = "]")
    tipo_anexar_texto(t, itens.a, saida)
}

// C: semantic/tipos.c:325
proc texto_resultado(t: ^Tipos, k: ^TipoInfo, saida: ^[dynamic]u8) {
    if k.a != (TIPO_VAZIO as u32) {
        tipo_anexar_texto(t, k.a, saida)
        append(saida, item = " ")
    }
    append(saida, item = "! ")
    tipo_anexar_texto(t, k.b, saida)
}

// C: semantic/tipos.c:336
proc texto_da_v17(t: ^Tipos, k: ^TipoInfo, saida: ^[dynamic]u8) {
    if k.classe == (TC_OPCIONAL as u8) {
        append(saida, item = "?")
        tipo_anexar_texto(t, k.a, saida)
    } else if k.classe == (TC_UNIAO as u8) {
        texto_nome(t, transmute(k.a, to = i32), saida)
    } else if k.classe == (TC_TUPLA as u8) {
        append(saida, item = "(")
        tipo_anexar_texto(t, k.a, saida)
        var c: u32 = k.b
        while c != 0 {
            append(saida, item = ", ")
            tipo_anexar_texto(t, tipo_de(t, c).a, saida)
            c = tipo_de(t, c).b
        }
        append(saida, item = ")")
    } else if k.classe == (TC_PROC as u8) {
        append(saida, item = "proc(")
        var c: u32 = k.b
        while c != 0 {
            tipo_anexar_texto(t, tipo_de(t, c).a, saida)
            if tipo_de(t, c).b != 0 {
                append(saida, item = ", ")
            }
            c = tipo_de(t, c).b
        }
        append(saida, item = ")")
        if k.a != (TIPO_VAZIO as u32) {
            append(saida, item = " -> ")
            tipo_anexar_texto(t, k.a, saida)
        }
    } else {
        let msg_1 = format(f"tipos: TC_TUPLA_CAUDA nao tem texto proprio", alloc = heap)
        defer delete(msg_1)
        common.falha_interna(msg_1)
    }
}

// C: semantic/tipos.c:365
proc texto_da_v19(t: ^Tipos, k: ^TipoInfo, saida: ^[dynamic]u8) {
    if k.classe == (TC_MAPA as u8) {
        append(saida, item = "map[")
        tipo_anexar_texto(t, k.a, saida)
        append(saida, item = "]")
        tipo_anexar_texto(t, k.b, saida)
    } else if k.classe == (TC_BIT_SET as u8) {
        append(saida, item = "bit_set[")
        tipo_anexar_texto(t, k.a, saida)
        append(saida, item = "]")
    } else if k.classe == (TC_SOA as u8) {
        append(saida, item = "soa")
        tipo_anexar_texto(t, k.a, saida)
    } else if k.classe == (TC_MATRIZ as u8) {
        append(saida, item = "matrix[")
        format(f"{(k.b >> 8) as u64}", into = saida)
        append(saida, item = ", ")
        format(f"{(k.b & 255) as u64}", into = saida)
        append(saida, item = "]")
        tipo_anexar_texto(t, k.a, saida)
    } else {
        let msg_1 = format(f"tipos: classe sem texto", alloc = heap)
        defer delete(msg_1)
        common.falha_interna(msg_1)
    }
}

// C: semantic/tipos.c:389
pub proc tipo_anexar_texto(t: ^Tipos, id: u32, saida: ^[dynamic]u8) {
    let k: ^TipoInfo = tipo_de(t, id)
    let fixo: str = NOME_FIXO[k.classe]
    if len(fixo) != 0 {
        append(saida, item = fixo)
    } else if k.classe == (TC_REAL as u8) {
        texto_real(t, k.a, saida)
    } else if (k.classe == (TC_STRUCT as u8)) and (k.b != 0) {
        texto_lista_fixa(t, k, saida)
    } else if (k.classe == (TC_STRUCT as u8)) or (k.classe == (TC_ENUM as u8)) {
        texto_nome(t, transmute(k.a, to = i32), saida)
    } else if (k.classe == (TC_PONTEIRO as u8)) or (k.classe == (TC_ANULAVEL as u8)) {
        if k.classe == (TC_ANULAVEL as u8) {
            append(saida, item = "?^")
        } else {
            append(saida, item = "^")
        }
        tipo_anexar_texto(t, k.a, saida)
    } else if ((k.classe == (TC_ARRAY as u8)) or (k.classe == (TC_FATIA as u8))) or (k.classe == (TC_DINAMICO as u8)) {
        append(saida, item = "[")
        if k.classe == (TC_ARRAY as u8) {
            format(f"{k.b as u64}", into = saida)
        }
        if k.classe == (TC_DINAMICO as u8) {
            append(saida, item = "dynamic")
        }
        append(saida, item = "]")
        tipo_anexar_texto(t, k.a, saida)
    } else if k.classe >= (TC_MAPA as u8) {
        texto_da_v19(t, k, saida)
    } else if k.classe >= (TC_OPCIONAL as u8) {
        texto_da_v17(t, k, saida)
    } else {
        texto_resultado(t, k, saida)
    }
}

// Auxiliar dos test: texto do tipo como str de heap (o chamador faz delete)
proc tipo_texto_teste(t: ^Tipos, id: u32) -> str {
    var b = make([dynamic]u8, alloc = heap)
    tipo_anexar_texto(t, id, &b)
    let texto = to_str(&b)
    delete(b)
    return texto
}

// Do TestaTipos do teste_common.c
test "tipos" {
    var a: common.Arena = common.Arena{}
    var nomes: common.Interner = common.Interner{}
    var dims: DimTabela = DimTabela{}
    var t: Tipos = Tipos{}
    common.interner_iniciar(&nomes, &a)
    dim_iniciar(&dims)
    let grifo: i32 = common.internar(&nomes, "Grifo", 5)
    let erro: i32 = common.internar(&nomes, "ErroCarga", 9)
    tipos_iniciar(&t, &nomes, &dims)
    expect(tipo_real(&t, DIM_ADIMENSIONAL as u32) == (TIPO_F32 as u32) and tipo_classe_de(&t, TIPO_INT as u32) == TC_INT)
    let g: u32 = tipo_struct(&t, grifo)
    let e: u32 = tipo_enum(&t, erro)
    expect(g == tipo_struct(&t, grifo) and g != e and tipo_ponteiro(&t, g) == tipo_ponteiro(&t, g))
    let r: u32 = tipo_resultado(&t, g, e)
    expect(r == tipo_resultado(&t, g, e) and r != tipo_resultado(&t, TIPO_VAZIO as u32, e))
    let t1 = tipo_texto_teste(&t, r)
    let t2 = tipo_texto_teste(&t, tipo_ponteiro(&t, g))
    let t3 = tipo_texto_teste(&t, tipo_resultado(&t, TIPO_VAZIO as u32, e))
    expect(t1 == "Grifo ! ErroCarga" and t2 == "^Grifo" and t3 == "! ErroCarga")
    delete(t1)
    delete(t2)
    delete(t3)
    let t4 = tipo_texto_teste(&t, TIPO_VAZIO as u32)
    let t5 = tipo_texto_teste(&t, TIPO_VENENO as u32)
    expect(t4 == "(sem valor)" and t5 == "(erro)")
    delete(t4)
    delete(t5)
    tipos_liberar(&t)
    dim_liberar(&dims)
    common.interner_liberar(&nomes)
    common.arena_liberar(&a)
}

// Do TestaTiposNumericos (ids 8..14, largura, sinal, literal e faixa por tipo)
test "tipos: numericos" {
    var a: common.Arena = common.Arena{}
    var nomes: common.Interner = common.Interner{}
    var dims: DimTabela = DimTabela{}
    var t: Tipos = Tipos{}
    var lido: u64 = 0
    common.interner_iniciar(&nomes, &a)
    dim_iniciar(&dims)
    tipos_iniciar(&t, &nomes, &dims)
    let ids: [7]i32 = {TIPO_I8, TIPO_I16, TIPO_U8, TIPO_U16, TIPO_U32, TIPO_UINT, TIPO_F64}
    let textos: [7]str = {"i8", "i16", "u8", "u16", "u32", "uint", "f64"}
    var textos_certos: bool = true
    for k in 0..<7 {
        let tx = tipo_texto_teste(&t, ids[k] as u32)
        textos_certos = textos_certos and (ids[k] == 8 + (k as i32)) and tx == textos[k]
        delete(tx)
    }
    let tx_int = tipo_texto_teste(&t, TIPO_INT as u32)
    expect(textos_certos and tx_int == "int" and TIPO_FIXOS_QTD == 17)
    delete(tx_int)
    let metros: u32 = tipo_real(&t, 1)
    expect(tipo_eh_inteiro(TIPO_U8 as u32) and not tipo_eh_inteiro(TIPO_F64 as u32) and tipo_eh_sem_sinal(TIPO_UINT as u32) and not tipo_eh_sem_sinal(TIPO_INT as u32))
    expect(tipo_eh_real(&t, TIPO_F64 as u32) and tipo_eh_real(&t, metros) and tipo_eh_numerico(&t, TIPO_U32 as u32) and not tipo_eh_numerico(&t, TIPO_BOOL as u32))
    expect(tipo_largura_bits(&t, TIPO_I8 as u32) == 8 and tipo_largura_bits(&t, TIPO_U16 as u32) == 16 and tipo_largura_bits(&t, TIPO_F32 as u32) == 32)
    expect(tipo_largura_bits(&t, TIPO_UINT as u32) == 64 and tipo_largura_bits(&t, TIPO_F64 as u32) == 64 and tipo_largura_bits(&t, metros) == 32 and tipo_largura_bits(&t, TIPO_TEXTO as u32) == 0)
    expect(tipo_ler_literal_u64(as_bytes("18446744073709551615"), &lido) and lido == 18446744073709551615)
    expect(not tipo_ler_literal_u64(as_bytes("18446744073709551616"), &lido))
    expect(tipo_ler_literal_u64(as_bytes("42;"), &lido) and lido == 42)
    expect(tipo_inteiro_cabe(TIPO_I8 as u32, true, 128) and not tipo_inteiro_cabe(TIPO_I8 as u32, false, 128) and tipo_inteiro_cabe(TIPO_U8 as u32, false, 255))
    expect(not tipo_inteiro_cabe(TIPO_U8 as u32, false, 256) and tipo_inteiro_cabe(TIPO_U32 as u32, true, 0) and not tipo_inteiro_cabe(TIPO_U32 as u32, true, 1))
    expect(tipo_inteiro_cabe(TIPO_UINT as u32, false, 18446744073709551615) and tipo_inteiro_cabe(TIPO_INT as u32, true, 9223372036854775808))
    expect(tipo_bits_cabem(TIPO_UINT as u32, -1) and not tipo_bits_cabem(TIPO_U8 as u32, 256) and tipo_bits_cabem(TIPO_BOOL as u32, 99))
    expect(not tipo_bits_cabem(TIPO_I8 as u32, 128) and tipo_bits_cabem(TIPO_I8 as u32, -128) and not tipo_bits_cabem(TIPO_I16 as u32, -32769))
    expect(tipo_inteiro_min(TIPO_I16 as u32) == -32768 and tipo_inteiro_max(TIPO_I16 as u32) == 32767 and tipo_inteiro_min(TIPO_U16 as u32) == 0 and tipo_inteiro_max(TIPO_U16 as u32) == 65535)
    let f64_nome: str = tipo_nome_fixo(TIPO_F64 as u32) or_else ""
    expect(f64_nome == "f64" and tipo_nome_fixo(TIPO_FIXOS_QTD as u32) == none)
    tipos_liberar(&t)
    dim_liberar(&dims)
    common.interner_liberar(&nomes)
    common.arena_liberar(&a)
}

// Do TestaTiposPonteiros (ids 15/16, str = id 6, ^T e ?^T)
test "tipos: ponteiros" {
    var a: common.Arena = common.Arena{}
    var nomes: common.Interner = common.Interner{}
    var dims: DimTabela = DimTabela{}
    var t: Tipos = Tipos{}
    common.interner_iniciar(&nomes, &a)
    dim_iniciar(&dims)
    let grifo: i32 = common.internar(&nomes, "Grifo", 5)
    tipos_iniciar(&t, &nomes, &dims)
    let g: u32 = tipo_struct(&t, grifo)
    let ids: [3]i32 = {TIPO_STR, TIPO_CSTR, TIPO_RAWPTR}
    let textos: [3]str = {"str", "cstr", "rawptr"}
    var textos_certos: bool = true
    for k in 0..<3 {
        let tx = tipo_texto_teste(&t, ids[k] as u32)
        textos_certos = textos_certos and tx == textos[k]
        delete(tx)
    }
    expect(TIPO_RAWPTR == 15 and TIPO_CSTR == 16 and TIPO_STR == TIPO_TEXTO and textos_certos)
    let tx_a = tipo_texto_teste(&t, tipo_ponteiro(&t, TIPO_I32 as u32))
    let tx_b = tipo_texto_teste(&t, tipo_ponteiro(&t, tipo_ponteiro(&t, g)))
    expect(tx_a == "^i32" and tx_b == "^^Grifo" and tipo_ponteiro(&t, tipo_ponteiro(&t, g)) == tipo_ponteiro(&t, tipo_ponteiro(&t, g)))
    delete(tx_a)
    delete(tx_b)
    let tx_c = tipo_texto_teste(&t, tipo_anulavel(&t, g))
    expect(tx_c == "?^Grifo" and tipo_anulavel(&t, g) != tipo_ponteiro(&t, g) and tipo_anulavel(&t, g) == tipo_anulavel(&t, g))
    delete(tx_c)
    let nao_numericos: [5]u32 = {TIPO_STR as u32, TIPO_CSTR as u32, TIPO_RAWPTR as u32, tipo_ponteiro(&t, TIPO_I32 as u32), tipo_anulavel(&t, g)}
    var todos_fora: bool = true
    for k in 0..<5 {
        todos_fora = todos_fora and not tipo_eh_numerico(&t, nao_numericos[k]) and tipo_largura_bits(&t, nao_numericos[k]) == 0
    }
    expect(todos_fora)
    tipos_liberar(&t)
    dim_liberar(&dims)
    common.interner_liberar(&nomes)
    common.arena_liberar(&a)
}

// Do TestaTiposV19 (mapa e matriz) + array/fatia/dinamico/opcional/tupla/proc e o texto de cada forma
test "tipos: v19 e formas compostas" {
    var a: common.Arena = common.Arena{}
    var nomes: common.Interner = common.Interner{}
    var dims: DimTabela = DimTabela{}
    var t: Tipos = Tipos{}
    common.interner_iniciar(&nomes, &a)
    dim_iniciar(&dims)
    tipos_iniciar(&t, &nomes, &dims)
    let mapa: u32 = tipo_mapa(&t, TIPO_TEXTO as u32, TIPO_INT as u32)
    expect(mapa == tipo_mapa(&t, TIPO_TEXTO as u32, TIPO_INT as u32) and tipo_classe_de(&t, mapa) == TC_MAPA and t.tem_mapa and t.tem_dinamico and tipos_tem_v19(&t))
    let m: u32 = tipo_matriz(&t, TIPO_F32 as u32, 4, 3)
    let tm = tipo_texto_teste(&t, m)
    let tp = tipo_texto_teste(&t, mapa)
    expect(tipo_matriz_linhas(&t, m) == 4 and tipo_matriz_colunas(&t, m) == 3 and tm == "matrix[4, 3]f32" and tp == "map[str]int")
    delete(tm)
    delete(tp)
    let arr: u32 = tipo_array(&t, TIPO_I32 as u32, 8)
    let fat: u32 = tipo_fatia(&t, TIPO_U8 as u32)
    let din: u32 = tipo_dinamico(&t, TIPO_F64 as u32)
    let opc: u32 = tipo_opcional(&t, TIPO_INT as u32)
    let ta = tipo_texto_teste(&t, arr)
    let tf = tipo_texto_teste(&t, fat)
    let td = tipo_texto_teste(&t, din)
    let to = tipo_texto_teste(&t, opc)
    expect(ta == "[8]i32" and tf == "[]u8" and td == "[dynamic]f64" and to == "?int")
    delete(ta)
    delete(tf)
    delete(td)
    delete(to)
    var elems: [3]u32 = {TIPO_INT as u32, TIPO_TEXTO as u32, TIPO_BOOL as u32}
    let tupla: u32 = tipo_tupla(&t, elems[..])
    expect(tipo_tupla_qtd(&t, tupla) == 3 and tipo_tupla_elemento(&t, tupla, 0) == (TIPO_INT as u32) and tipo_tupla_elemento(&t, tupla, 1) == (TIPO_TEXTO as u32) and tipo_tupla_elemento(&t, tupla, 2) == (TIPO_BOOL as u32))
    expect(tupla == tipo_tupla(&t, elems[..]))
    var params: [2]u32 = {TIPO_INT as u32, TIPO_TEXTO as u32}
    var ass: ProcAssinatura = ProcAssinatura{params = params[..], nomes = none, n = 2, retorno = TIPO_BOOL as u32}
    let p1: u32 = tipo_proc(&t, &ass)
    expect(p1 == tipo_proc(&t, &ass) and tipo_proc_qtd(&t, p1) == 2 and tipo_proc_param(&t, p1, 1) == (TIPO_TEXTO as u32) and tipo_proc_nome(&t, p1, 0) == -1)
    expect(tipo_proc_compativel(&t, p1, p1))
    tipos_liberar(&t)
    dim_liberar(&dims)
    common.interner_liberar(&nomes)
    common.arena_liberar(&a)
}

// Hash FNV de 6 chaves com os valores calculados a partir do C (HashTipo) e o crescimento da tabela (cap 64 -> 1024)
test "tipos: hash igual ao C e crescimento da tabela" {
    var k1: TipoInfo = TipoInfo{classe = 3, a = 0, b = 0, c = 0}
    var k2: TipoInfo = TipoInfo{classe = 6, a = 5, b = 0, c = 0}
    var k3: TipoInfo = TipoInfo{classe = 8, a = 4, b = 0, c = 0}
    var k4: TipoInfo = TipoInfo{classe = 9, a = 7, b = 9, c = 0}
    var k5: TipoInfo = TipoInfo{classe = 21, a = 4, b = 10, c = 0}
    var k6: TipoInfo = TipoInfo{classe = 26, a = 1, b = 2, c = 3}
    expect(hash_tipo(&k1) == 2613195814 and hash_tipo(&k2) == 1743884500 and hash_tipo(&k3) == 3512541297)
    expect(hash_tipo(&k4) == 3889081744 and hash_tipo(&k5) == 3574110598 and hash_tipo(&k6) == 2083691715)
    var a: common.Arena = common.Arena{}
    var nomes: common.Interner = common.Interner{}
    var dims: DimTabela = DimTabela{}
    var t: Tipos = Tipos{}
    common.interner_iniciar(&nomes, &a)
    dim_iniciar(&dims)
    tipos_iniciar(&t, &nomes, &dims)
    expect(len(t.itens) == 17 and t.cap == 64)
    var ordem_certa: bool = true
    for n in 1..<300 {
        let id: u32 = tipo_array(&t, TIPO_I32 as u32, n as u32)
        ordem_certa = ordem_certa and id == (16 + (n as u32))
    }
    for n in 1..<300 {
        ordem_certa = ordem_certa and tipo_array(&t, TIPO_I32 as u32, n as u32) == (16 + (n as u32))
    }
    expect(ordem_certa and len(t.itens) == 316 and t.cap == 1024)
    tipos_liberar(&t)
    dim_liberar(&dims)
    common.interner_liberar(&nomes)
    common.arena_liberar(&a)
}

// R-S6 (unidade): tipo_anexar_texto com 400 niveis de ponteiro (o dev da Forja estoura a pilha entre 450 e 470 niveis; o 2000 vai pela fixture sintetica no espelho)
test "tipos: recursao de 400 niveis" {
    var a: common.Arena = common.Arena{}
    var nomes: common.Interner = common.Interner{}
    var dims: DimTabela = DimTabela{}
    var t: Tipos = Tipos{}
    common.interner_iniciar(&nomes, &a)
    dim_iniciar(&dims)
    tipos_iniciar(&t, &nomes, &dims)
    var p: u32 = TIPO_I32 as u32
    var q: u32 = TIPO_I32 as u32
    for n in 0..<400 {
        p = tipo_ponteiro(&t, p)
        var params: [1]u32 = {q}
        var ass: ProcAssinatura = ProcAssinatura{params = params[..], nomes = none, n = 1, retorno = TIPO_BOOL as u32}
        q = tipo_proc(&t, &ass)
    }
    let tx = tipo_texto_teste(&t, p)
    expect(len(tx) == 403 and tx[0] == 94 and tx[399] == 94 and tx[400] == 105)
    delete(tx)
    expect(tipo_proc_compativel(&t, q, q))
    tipos_liberar(&t)
    dim_liberar(&dims)
    common.interner_liberar(&nomes)
    common.arena_liberar(&a)
}
