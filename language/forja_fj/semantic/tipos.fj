// C2F-A0: NOME_DO_ID por id fixo (indice = TIPO_*, 0..16); NULL do C (so o indice 0) -> ""
const NOME_DO_ID: [17]str = {"", "(sem valor)", "bool", "i32", "int", "f32", "str", "(erro)", "i8", "i16", "u8", "u16", "u32", "uint", "f64", "rawptr", "cstr"}

