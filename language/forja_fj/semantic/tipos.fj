import "common"
import "frontend"

pub struct TipoInfo {
    classe: u8
    a: u32
    b: u32
    c: u32
}

pub struct Tipos {
    itens: [dynamic]TipoInfo
    tabela: [dynamic]u32
    cap: u32
    nomes: ?^common.Interner
    dims: ?^DimTabela
    tem_dinamico: bool
    tem_opcional: bool
    tem_uniao: bool
    tem_mapa: bool
    tem_bit_set: bool
    tem_soa: bool
    tem_matriz: bool
}

struct ProcAssinatura {
    params: ?[]u32
    nomes: ?[]i32
    n: u32
    retorno: u32 // TipoId
}

