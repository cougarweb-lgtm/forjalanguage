// C: semantic/tipos.c:26
proc hash_tipo(k: ^TipoInfo) -> u32 {
    var h: u32 = 2166136261
    h = wrapping_mul(h ~ (k.classe as u32), 16777619)
    h = wrapping_mul(h ~ k.a, 16777619)
    h = wrapping_mul(h ~ k.b, 16777619)
    return wrapping_mul(h ~ k.c, 16777619)
}

// C: semantic/tipos.c:35
// C2F-14/21: tabela de uint32_t calloc -> [dynamic]u32 de heap com cap zeros (o chamador e o dono)
proc alocar_tabela_2(cap: u32) -> [dynamic]u32 {
    return make([dynamic]u32, alloc = heap, len = cap as int)
}

// C: semantic/tipos.c:42
// C2F-14: em vez de alocar uma tabela nova e trocar, zera a mesma lista e a estende para o dobro (mesmo resultado: tabela de cap*2 zeros reinserida na mesma ordem)
proc crescer_2(t: ^Tipos) {
    let cap: u32 = t.cap * 2
    clear(&t.tabela)
    resize(&t.tabela, cap as int)
    for id in 1..<len(t.itens) {
        var i: u32 = hash_tipo(tipo_de(t, id as u32)) & (cap - 1)
        while t.tabela[i] != 0 {
            i = (i + 1) & (cap - 1)
        }
        t.tabela[i] = id as u32
    }
    t.cap = cap
}

// C: semantic/tipos.c:57
proc obter_nome(t: ^Tipos, classe: i32, a: u32, b: u32, c: u32) -> u32 {
    var k: TipoInfo = TipoInfo{classe = classe as u8, a = a, b = b, c = c}
    let mascara: u32 = t.cap - 1
    var i: u32 = hash_tipo(&k) & mascara
    while t.tabela[i] != 0 {
        let x: ^TipoInfo = tipo_de(t, t.tabela[i])
        if ((((x.classe as i32) == (k.classe as i32)) and (x.a == a)) and (x.b == b)) and (x.c == c) {
            return t.tabela[i]
        }
        i = (i + 1) & mascara
    }
    append(&t.itens, item = TipoInfo{})
    t.itens[len(t.itens) - 1] = k
    let novo: u32 = ((len(t.itens) as u64) - 1) as u32
    t.tabela[i] = novo
    if ((len(t.itens) as u64) * 2) > (t.cap as u64) {
        crescer_2(t)
    }
    return novo
}

// C: semantic/tipos.c:73
proc obter(t: ^Tipos, classe: i32, a: u32, b: u32) -> u32 {
    return obter_nome(t, classe, a, b, 0)
}

// C: semantic/tipos.c:75
proc tipos_iniciar(t: ^Tipos, nomes: ^common.Interner, dims: ^DimTabela) {
    t.itens = make([dynamic]TipoInfo, alloc = heap)
    append(&t.itens, item = TipoInfo{}) // slot 0 = nao resolvido
    t.cap = CAP_INICIAL_2 as u32
    t.tabela = alocar_tabela_2(t.cap)
    t.nomes = nomes
    t.dims = dims
    t.tem_dinamico = false
    t.tem_opcional = false
    t.tem_uniao = false
    t.tem_mapa = false
    t.tem_bit_set = false
    t.tem_soa = false
    t.tem_matriz = false
    _ = obter(t, TC_VAZIO, 0, 0)
    _ = obter(t, TC_BOOL, 0, 0)
    _ = obter(t, TC_I32, 0, 0)
    _ = obter(t, TC_INT, 0, 0)
    _ = obter(t, TC_REAL, DIM_ADIMENSIONAL as u32, 0)
    _ = obter(t, TC_TEXTO, 0, 0)
    _ = obter(t, TC_VENENO, 0, 0)
    // v1.2: a ordem aqui fixa os ids 8..14 (TIPO_I8..TIPO_F64); v1.3: 15 TIPO_RAWPTR e 16 TIPO_CSTR
    for k in 0..<9 {
        if obter(t, NOVAS[k], 0, 0) != ((TIPO_I8 as u32) + (k as u32)) {
            common.falha_interna("tipos: id fixo fora de ordem")
        }
    }
}

// C: semantic/tipos.c:104
proc tipos_liberar(t: ^Tipos) {
    delete(t.tabela)
    delete(t.itens)
}

