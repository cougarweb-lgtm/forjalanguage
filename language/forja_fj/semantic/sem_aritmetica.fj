import "common"
import "frontend"

const NOMES_QTD: i32 = 19
const NOMES_2: [19]str = {"wrapping_add", "wrapping_sub", "wrapping_mul", "saturating_add", "saturating_sub", "saturating_mul", "checked_add", "checked_sub", "checked_mul", "overflowing_add", "overflowing_sub", "overflowing_mul", "rotate_left", "rotate_right", "count_ones", "leading_zeros", "trailing_zeros", "byte_swap", "mul_hi_u64"}

// C: semantic/sem_aritmetica.c:28
proc sem_aritmetica_internar(s: ^Semantica) {
    for k in 0..<(NOMES_QTD as int) {
        _ = common.internar(nomes_da_sem(s), NOMES_2[k], len(NOMES_2[k]) as u32)
    }
}

// C: semantic/sem_aritmetica.c:34
// O C grava y->categoria/indice/tipo direto; registrar_embutido (semantic.fj) faz exatamente isso (semantic.c:63).
proc sem_aritmetica_registrar(s: ^Semantica) {
    for k in 0..<(NOMES_QTD as int) {
        let id: i32 = common.internar(nomes_da_sem(s), NOMES_2[k], len(NOMES_2[k]) as u32)
        registrar_embutido(s, id, SIM_PROC_EMBUTIDO, frontend.EMB_WRAPPING_ADD + (k as i32), TIPO_VAZIO as u32)
    }
}

// C: semantic/sem_aritmetica.c:45
proc conferir_inteiro(s: ^Semantica, e: ^frontend.Expr, k: u32) -> bool {
    let v: ^frontend.Expr = (e.args or_else {})[k].valor as ^frontend.Expr
    if tipo_eh_inteiro(v.tipo) {
        return true
    }
    let texto = sem_descrever_str(s, v.tipo)
    defer delete(texto)
    let quem = sem_nome_texto(s, e.nome)
    let msg_1 = format(f"{quem} pede inteiro (i8..i64, u8..u64, int, uint), nao {texto}", alloc = heap)
    defer delete(msg_1)
    return sem_erro(s, common.E0334, v.pos, msg_1)
}

// C: semantic/sem_aritmetica.c:55
proc conferir_dois_inteiros_iguais(s: ^Semantica, e: ^frontend.Expr) -> bool {
    let args = e.args or_else {}
    let v: ^frontend.Expr = args[1].valor as ^frontend.Expr
    if (not conferir_inteiro(s, e, 0)) or (not conferir_inteiro(s, e, 1)) {
        return false
    }
    if v.tipo == (args[0].valor as ^frontend.Expr).tipo {
        return true
    }
    let a = sem_descrever_str(s, (args[0].valor as ^frontend.Expr).tipo)
    defer delete(a)
    let b = sem_descrever_str(s, v.tipo)
    defer delete(b)
    let quem = sem_nome_texto(s, e.nome)
    let msg_1 = format(f"{quem} pede inteiros do mesmo tipo: {a} e {b}", alloc = heap)
    defer delete(msg_1)
    return sem_erro(s, common.E0334, v.pos, msg_1)
}

// C: semantic/sem_aritmetica.c:67
proc resultado_da_familia(s: ^Semantica, familia: u32, tipo: u32) -> u32 {
    var elementos: [2]u32 = {tipo, TIPO_BOOL as u32}
    if familia == 2 {
        return tipo_opcional(&s.tipos, tipo)
    }
    if familia == 3 {
        return tipo_tupla(&s.tipos, elementos[..])
    }
    return tipo
}

// C: semantic/sem_aritmetica.c:75
proc chamar_operacao(s: ^Semantica, e: ^frontend.Expr, embutido: i32) -> bool {
    if (not sem_ligar_embutido(s, e, s.params_minmax[..])) or (not sem_tipar_argumentos(s, e, TIPO_VAZIO as u32)) {
        return false
    }
    if not conferir_dois_inteiros_iguais(s, e) {
        return false
    }
    let familia: u32 = ((embutido - frontend.EMB_WRAPPING_ADD) as u32) / (frontend.EMB_ARIT_FAMILIA_TAM as u32)
    e.tipo = resultado_da_familia(s, familia, ((e.args or_else {})[0].valor as ^frontend.Expr).tipo)
    return true
}

// C: semantic/sem_aritmetica.c:83
proc chamar_rotacao(s: ^Semantica, e: ^frontend.Expr) -> bool {
    if (not sem_ligar_embutido(s, e, s.params_rotacao[..])) or (not sem_tipar_argumentos(s, e, TIPO_VAZIO as u32)) {
        return false
    }
    if (not conferir_inteiro(s, e, 0)) or (not conferir_inteiro(s, e, 1)) {
        return false
    }
    e.tipo = ((e.args or_else {})[0].valor as ^frontend.Expr).tipo
    return true
}

// C: semantic/sem_aritmetica.c:92
// count_ones, leading_zeros, trailing_zeros (-> int) e byte_swap (-> o tipo de x).
proc chamar_um_inteiro(s: ^Semantica, e: ^frontend.Expr, embutido: i32) -> bool {
    if (not sem_ligar_embutido(s, e, s.params_um[..])) or (not sem_tipar_argumentos(s, e, TIPO_VAZIO as u32)) {
        return false
    }
    if not conferir_inteiro(s, e, 0) {
        return false
    }
    if embutido == frontend.EMB_BYTE_SWAP {
        e.tipo = ((e.args or_else {})[0].valor as ^frontend.Expr).tipo
    } else {
        e.tipo = TIPO_INT as u32
    }
    return true
}

// C: semantic/sem_aritmetica.c:100
proc chamar_mul_hi(s: ^Semantica, e: ^frontend.Expr) -> bool {
    if (not sem_ligar_embutido(s, e, s.params_minmax[..])) or (not sem_tipar_argumentos(s, e, TIPO_UINT as u32)) {
        return false
    }
    for k in (0 as u32)..<2 {
        let v: ^frontend.Expr = (e.args or_else {})[k].valor as ^frontend.Expr
        if v.tipo == (TIPO_UINT as u32) {
            continue
        }
        let texto = sem_descrever_str(s, v.tipo)
        defer delete(texto)
        let msg_1 = format(f"mul_hi_u64 pede dois u64, nao {texto}", alloc = heap)
        defer delete(msg_1)
        return sem_erro(s, common.E0334, v.pos, msg_1)
    }
    e.tipo = TIPO_UINT as u32
    return true
}

// C: semantic/sem_aritmetica.c:114
proc sem_chamar_aritmetica(s: ^Semantica, e: ^frontend.Expr, embutido: i32) -> bool {
    if embutido <= frontend.EMB_OVERFLOWING_MUL {
        return chamar_operacao(s, e, embutido)
    }
    if embutido <= frontend.EMB_ROTATE_RIGHT {
        return chamar_rotacao(s, e)
    }
    if embutido == frontend.EMB_MUL_HI_U64 {
        return chamar_mul_hi(s, e)
    }
    return chamar_um_inteiro(s, e, embutido)
}

// G3 S5: os 19 nomes (internados antes de qtd_nomes, na ordem de EMB_WRAPPING_ADD..EMB_MUL_HI_U64) e o registro como embutido
test "sem_aritmetica: nomes internados e registrados na ordem dos embutidos" {
    expect(NOMES_QTD == frontend.EMB_MUL_HI_U64 - frontend.EMB_WRAPPING_ADD + 1)
    var c = S5Cena{}
    s5_cena_montar(&c, {})
    let globais = c.sv.globais or_else {}
    for k in 0..<(NOMES_QTD as int) {
        let id: i32 = common.interner_achar(&c.ins[0], NOMES_2[k], len(NOMES_2[k]) as u32)
        expect(id >= 0 and (id as u32) < c.sv.qtd_nomes)
        expect(globais[id].categoria == (SIM_PROC_EMBUTIDO as u8) and globais[id].indice == frontend.EMB_WRAPPING_ADD + (k as i32) and globais[id].tipo == (TIPO_VAZIO as u32))
    }
    expect(NOMES_2[1] == "wrapping_sub" and NOMES_2[2] == "wrapping_mul" and NOMES_2[3] == "saturating_add" and NOMES_2[4] == "saturating_sub" and NOMES_2[6] == "checked_add" and NOMES_2[7] == "checked_sub" and NOMES_2[8] == "checked_mul")
    expect(NOMES_2[10] == "overflowing_sub" and NOMES_2[11] == "overflowing_mul" and NOMES_2[13] == "rotate_right" and NOMES_2[14] == "count_ones" and NOMES_2[15] == "leading_zeros" and NOMES_2[16] == "trailing_zeros" and NOMES_2[17] == "byte_swap")
    expect(NOMES_2[0] == "wrapping_add" and NOMES_2[5] == "saturating_mul" and NOMES_2[9] == "overflowing_add" and NOMES_2[12] == "rotate_left" and NOMES_2[18] == "mul_hi_u64")
    s5_cena_liberar(&c)
}

test "sem_aritmetica: resultado_da_familia, despacho e erros E0334" {
    var c = S5Cena{}
    s5_cena_montar(&c, {})
    let i32t: u32 = TIPO_I32 as u32
    let intt: u32 = TIPO_INT as u32
    let uintt: u32 = TIPO_UINT as u32
    let f32t: u32 = TIPO_F32 as u32
    let u32t: u32 = TIPO_U32 as u32
    // familia 0 e 1: o proprio tipo; 2: ?T; 3: (T, bool)
    expect(resultado_da_familia(&c.sv, 0, i32t) == i32t and resultado_da_familia(&c.sv, 1, i32t) == i32t)
    let op: u32 = resultado_da_familia(&c.sv, 2, i32t)
    expect(tipo_classe_de(&c.sv.tipos, op) == TC_OPCIONAL and tipo_de(&c.sv.tipos, op).a == i32t)
    let tp: u32 = resultado_da_familia(&c.sv, 3, i32t)
    expect(tipo_classe_de(&c.sv.tipos, tp) == TC_TUPLA and tipo_tupla_qtd(&c.sv.tipos, tp) == 2)
    expect(tipo_tupla_elemento(&c.sv.tipos, tp, 0) == i32t and tipo_tupla_elemento(&c.sv.tipos, tp, 1) == (TIPO_BOOL as u32))
    // dispatch por embutido: wrapping/saturating -> T; checked -> ?T; overflowing -> (T, bool)
    let id_w: i32 = s5_nome(&c, NOMES_2[0])
    var dois: [2]u32 = {i32t, i32t}
    var ch = S5Chamada{}
    s5_chamada_montar(&ch, id_w, dois[..])
    expect(sem_chamar_aritmetica(&c.sv, &ch.e, frontend.EMB_WRAPPING_ADD) and ch.e.tipo == i32t)
    expect(sem_chamar_aritmetica(&c.sv, &ch.e, frontend.EMB_WRAPPING_ADD + 5) and ch.e.tipo == i32t)
    expect(sem_chamar_aritmetica(&c.sv, &ch.e, frontend.EMB_WRAPPING_ADD + 6) and tipo_classe_de(&c.sv.tipos, ch.e.tipo) == TC_OPCIONAL)
    expect(sem_chamar_aritmetica(&c.sv, &ch.e, frontend.EMB_WRAPPING_ADD + 8) and tipo_classe_de(&c.sv.tipos, ch.e.tipo) == TC_OPCIONAL)
    expect(sem_chamar_aritmetica(&c.sv, &ch.e, frontend.EMB_WRAPPING_ADD + 9) and tipo_classe_de(&c.sv.tipos, ch.e.tipo) == TC_TUPLA)
    expect(sem_chamar_aritmetica(&c.sv, &ch.e, frontend.EMB_OVERFLOWING_MUL) and tipo_classe_de(&c.sv.tipos, ch.e.tipo) == TC_TUPLA)
    // tipos diferentes: E0334 no 2o argumento
    ch.folhas[1].tipo = intt
    expect(not sem_chamar_aritmetica(&c.sv, &ch.e, frontend.EMB_WRAPPING_ADD))
    expect(c.diag.codigo == common.E0334 and c.diag.off == 101 and (c.diag.causa or_else "") == "wrapping_add pede inteiros do mesmo tipo: i32 e int")
    // nao inteiro: E0334 no argumento
    ch.folhas[1].tipo = f32t
    expect(not sem_chamar_aritmetica(&c.sv, &ch.e, frontend.EMB_WRAPPING_ADD))
    expect(c.diag.off == 101 and (c.diag.causa or_else "") == "wrapping_add pede inteiro (i8..i64, u8..u64, int, uint), nao f32")
    ch.folhas[0].tipo = f32t
    ch.folhas[1].tipo = i32t
    expect(not sem_chamar_aritmetica(&c.sv, &ch.e, frontend.EMB_WRAPPING_ADD))
    expect(c.diag.off == 100)
    s5_chamada_liberar(&ch)
    // rotate: x inteiro e n inteiro de qualquer tipo; o resultado e o tipo de x
    let id_r: i32 = s5_nome(&c, NOMES_2[12])
    var rot: [2]u32 = {u32t, intt}
    s5_chamada_montar(&ch, id_r, rot[..])
    expect(sem_chamar_aritmetica(&c.sv, &ch.e, frontend.EMB_ROTATE_LEFT) and ch.e.tipo == u32t)
    expect(sem_chamar_aritmetica(&c.sv, &ch.e, frontend.EMB_ROTATE_RIGHT) and ch.e.tipo == u32t)
    ch.folhas[1].tipo = f32t
    expect(not sem_chamar_aritmetica(&c.sv, &ch.e, frontend.EMB_ROTATE_LEFT))
    expect(c.diag.off == 101 and (c.diag.causa or_else "") == "rotate_left pede inteiro (i8..i64, u8..u64, int, uint), nao f32")
    s5_chamada_liberar(&ch)
    // count_ones/leading_zeros/trailing_zeros -> int; byte_swap -> o tipo de x
    let id_c: i32 = s5_nome(&c, NOMES_2[14])
    var um: [1]u32 = {u32t}
    s5_chamada_montar(&ch, id_c, um[..])
    expect(sem_chamar_aritmetica(&c.sv, &ch.e, frontend.EMB_COUNT_ONES) and ch.e.tipo == intt)
    expect(sem_chamar_aritmetica(&c.sv, &ch.e, frontend.EMB_LEADING_ZEROS) and ch.e.tipo == intt)
    expect(sem_chamar_aritmetica(&c.sv, &ch.e, frontend.EMB_COUNT_ONES + 2) and ch.e.tipo == intt)
    expect(sem_chamar_aritmetica(&c.sv, &ch.e, frontend.EMB_BYTE_SWAP) and ch.e.tipo == u32t)
    ch.folhas[0].tipo = f32t
    expect(not sem_chamar_aritmetica(&c.sv, &ch.e, frontend.EMB_COUNT_ONES))
    expect(c.diag.off == 100 and (c.diag.causa or_else "") == "count_ones pede inteiro (i8..i64, u8..u64, int, uint), nao f32")
    s5_chamada_liberar(&ch)
    // mul_hi_u64: dois u64
    let id_m: i32 = s5_nome(&c, NOMES_2[18])
    var mh: [2]u32 = {uintt, uintt}
    s5_chamada_montar(&ch, id_m, mh[..])
    expect(sem_chamar_aritmetica(&c.sv, &ch.e, frontend.EMB_MUL_HI_U64) and ch.e.tipo == uintt)
    ch.folhas[1].tipo = u32t
    expect(not sem_chamar_aritmetica(&c.sv, &ch.e, frontend.EMB_MUL_HI_U64))
    expect(c.diag.off == 101 and (c.diag.causa or_else "") == "mul_hi_u64 pede dois u64, nao u32")
    ch.folhas[0].tipo = i32t
    ch.folhas[1].tipo = uintt
    expect(not sem_chamar_aritmetica(&c.sv, &ch.e, frontend.EMB_MUL_HI_U64))
    expect(c.diag.off == 100 and (c.diag.causa or_else "") == "mul_hi_u64 pede dois u64, nao i32")
    s5_chamada_liberar(&ch)
    s5_cena_liberar(&c)
}
