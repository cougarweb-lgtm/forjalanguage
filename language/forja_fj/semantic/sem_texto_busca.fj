import "common"
import "frontend"

// C: semantic/sem_texto_busca.c:16
proc valor_de_texto_eh_str(s: ^Semantica, e: ^frontend.Expr) -> bool {
    let valor: ?^frontend.Expr = (argumento_do_parametro(e, 1) as ^frontend.Arg).valor
    if not sem_checar(s, valor, TIPO_VAZIO as u32) {
        return false
    }
    if (valor as ^frontend.Expr).tipo == (TIPO_STR as u32) {
        return true
    }
    let texto = s4_descrever(s, (valor as ^frontend.Expr).tipo)
    defer delete(texto)
    let quem = sem_nome_texto(s, e.nome)
    let msg_1 = format(f"{quem} de str pede value str (tipo {texto}); byte unico: text.index_byte", alloc = heap)
    defer delete(msg_1)
    return sem_erro(s, common.E0301, (valor as ^frontend.Expr).pos, msg_1)
}

// C: semantic/sem_texto_busca.c:27
proc sem_chamar_busca_texto(s: ^Semantica, e: ^frontend.Expr, embutido: i32) -> bool {
    if not valor_de_texto_eh_str(s, e) {
        return false
    }
    if embutido == frontend.EMB_CONTAINS {
        e.tipo = TIPO_BOOL as u32
    } else if embutido == frontend.EMB_COUNT {
        e.tipo = TIPO_INT as u32
    } else {
        e.tipo = tipo_opcional(&s.tipos, TIPO_INT as u32)
    }
    return true
}

// C: semantic/sem_texto_busca.c:37
proc sem_chamar_reverse_texto(s: ^Semantica, e: ^frontend.Expr) -> bool {
    let alocador: ?^frontend.Arg = argumento_do_parametro(e, 1)
    if alocador == none {
        let msg_1 = format(f"falta o argumento 'alloc'", alloc = heap)
        defer delete(msg_1)
        return sem_erro(s, common.E0503, e.pos_op, msg_1)
    }
    if not sem_conferir_alocador(s, e, alocador) {
        return false
    }
    e.tipo = TIPO_STR as u32
    return true
}
