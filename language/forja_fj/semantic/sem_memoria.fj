proc eh_ponteiro_de_lista_fixa(s: ^Semantica, t: u32) -> bool {
    let k: ^TipoInfo = tipo_de(&s.tipos, t)
    return (k.classe == (TC_PONTEIRO as u8)) and (common.c2f_b2i32(tipo_eh_lista_fixa(&s.tipos, k.a)) != 0)
}

