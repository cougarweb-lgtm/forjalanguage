// C: semantic/sem_memoria.c:110
proc trocar_por_id_criar(s: ^Semantica, em: ?^frontend.Arg) -> ^frontend.Expr {
    let a: ^frontend.Arg = em as ^frontend.Arg
    let base: ?^frontend.Expr = a.valor
    let campo: ^frontend.Expr = s4_novo_expr(s)
    campo.tipo_no = frontend.EX_CAMPO as u8
    campo.a = base
    campo.nome = s.nome_id
    campo.pos = (base as ^frontend.Expr).pos
    campo.pos_op = campo.pos
    a.valor = campo
    return campo
}

// C: semantic/sem_memoria.c:122
proc trocar_por_id(s: ^Semantica, em: ?^frontend.Arg) -> bool {
    return sem_checar(s, trocar_por_id_criar(s, em), TIPO_VAZIO as u32)
}

// C: semantic/sem_memoria.c:129
proc trocar_por_id_do_parametro(s: ^Semantica, em: ?^frontend.Arg) -> bool {
    let campo: ^frontend.Expr = trocar_por_id_criar(s, em)
    campo.ref = frontend.REF_CAMPO as u8
    campo.ref_id = 0
    campo.tipo = TIPO_U32 as u32
    return true
}

