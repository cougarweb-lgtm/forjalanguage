        defer delete(msg_1)
        return sem_erro(s, common.E0310, vv.pos, msg_1)
    }
    let texto_2 = s4_descrever(s, vv.tipo)
    defer delete(texto_2)
    let msg_2 = format(f"alloc recebe heap, frame, scope, Arena ou Pool (import \"std:mem\"); recebeu {texto_2}", alloc = heap)
    defer delete(msg_2)
    return sem_erro(s, common.E0310, vv.pos, msg_2)
}

// C: semantic/sem_memoria.c:154
proc em_de_alocador(s: ^Semantica, chamada: ^frontend.Expr, em: ?^frontend.Arg) -> bool {
    let v: ?^frontend.Expr = (em as ^frontend.Arg).valor
    var base: u32 = 0
    s.alocador_lendo = (v as ^frontend.Expr).tipo_no == (frontend.EX_NOME as u8)
    let lido: bool = sem_checar(s, v, TIPO_VAZIO as u32)
    s.alocador_lendo = false
    if not lido {
        return false
    }
    base = base_do_alocador(s, (v as ^frontend.Expr).tipo)
    if sem_eh_allocator(s, (v as ^frontend.Expr).tipo) {
        chamada.alocacao = frontend.ALOC_PARAM as u8
        return trocar_por_id_do_parametro(s, em)
    }
    if (s.tipo_arena != 0) and (base == s.tipo_arena) {
        chamada.alocacao = frontend.ALOC_ARENA as u8
    } else if (s.tipo_pool != 0) and (base == s.tipo_pool) {
        chamada.alocacao = frontend.ALOC_POOL as u8
    } else {
        return erro_em_desconhecido(s, v)
    }
    if (chamada.alocacao == (frontend.ALOC_POOL as u8)) and (chamada.ref_id != frontend.EMB_NEW) {
        let msg_1 = format(f"Pool so serve new: make, format e format_c pedem heap, frame, scope ou Arena", alloc = heap)
        defer delete(msg_1)
        return sem_erro(s, common.E0310, (v as ^frontend.Expr).pos, msg_1)
    }
    return trocar_por_id(s, em)
}

// C: semantic/sem_memoria.c:177
proc sem_conferir_alocador(s: ^Semantica, chamada: ^frontend.Expr, em: ?^frontend.Arg) -> bool {
    let a: ^frontend.Arg = em as ^frontend.Arg
    let v: ?^frontend.Expr = a.valor
    let aloc: u8 = sem_alocacao_do_nome(s, v)
    if (aloc == (frontend.ALOC_ESCOPO as u8)) and (not conferir_valor_antigo(s, v)) {
        return false
    }
    if (aloc == (frontend.ALOC_ESCOPO as u8)) and (s.let_em_analise != chamada) {
        let vv: ^frontend.Expr = v as ^frontend.Expr
        vv.tipo = TIPO_VAZIO as u32
        let msg_1 = format(f"alloc = scope so vale direto no let/var: let g = new(T, alloc = scope)", alloc = heap)
        defer delete(msg_1)
        return sem_erro(s, common.E0316, vv.pos, msg_1)
    }
    if aloc != (frontend.ALOC_NENHUM as u8) {
        let vv: ^frontend.Expr = v as ^frontend.Expr
        vv.tipo = TIPO_VAZIO as u32
        chamada.alocacao = aloc
        return true
    }
    if em_nao_declarado(s, v) {
        return erro_em_desconhecido(s, v)
    }
    return em_de_alocador(s, chamada, em)
}

// C: semantic/sem_memoria.c:196
proc resolver_tipo_do_argumento(s: ^Semantica, e: ^frontend.Expr, ref: ^?^frontend.TipoRef, tipo: ^u32) -> bool {
    let no: ?^frontend.Expr = (e.args or_else {})[0].valor
    ref^ = (no as ^frontend.Expr).alvo
    if not sem_resolver_tipo_ref(s, (no as ^frontend.Expr).alvo) {
        return false
    }
    tipo^ = ((no as ^frontend.Expr).alvo as ^frontend.TipoRef).tipo
    let ptr_1: ^frontend.Expr = no as ^frontend.Expr
    ptr_1.tipo = tipo^
    return true
}

// C: semantic/sem_memoria.c:207
proc new_de_struct(s: ^Semantica, e: ^frontend.Expr, ref: ^frontend.TipoRef, tipo: u32) -> bool {
    let lit: ^frontend.Expr = s4_novo_expr(s)
    lit.tipo_no = frontend.EX_LITERAL_STRUCT as u8
    lit.nome = transmute(tipo_de(&s.tipos, tipo).a, to = i32)
    lit.pos = ref.pos
    lit.pos_op = ref.pos
    if not sem_literal_struct(s, lit) {
        return false
    }
    e.b = lit
    return true
}

// C: semantic/sem_memoria.c:219
proc conferir_tipo_do_new(s: ^Semantica, e: ^frontend.Expr, ref: ^frontend.TipoRef, tipo: u32) -> bool {
    let classe: i32 = tipo_classe_de(&s.tipos, tipo)
    e.b = none
    if classe == TC_RESULTADO {
        let msg_1 = format(f"new de 'T ! E' nao existe", alloc = heap)
        defer delete(msg_1)
        return sem_erro(s, common.E0310, ref.pos, msg_1)
    }
    if classe == TC_DINAMICO {
        let msg_2 = format(f"new([dynamic]T) nao existe: a lista ja guarda os elementos fora; crie com make([dynamic]T, alloc = heap)", alloc = heap)
        defer delete(msg_2)
        return sem_erro(s, common.E0310, ref.pos, msg_2)
    }
    if classe == TC_STRUCT {
        return new_de_struct(s, e, ref, tipo)
    }
    if not sem_tipo_sem_zero(s, tipo) {
        return true
    }
    let texto = s4_descrever(s, tipo)
    defer delete(texto)
    let msg_3 = format(f"new({texto}): o tipo nao tem valor zero e new cria o valor zero; use ?^T ou guarde o ponteiro num struct com padrao", alloc = heap)
    defer delete(msg_3)
    return sem_erro(s, common.E0310, ref.pos, msg_3)
}

// C: semantic/sem_memoria.c:235
proc chamar_new(s: ^Semantica, e: ^frontend.Expr) -> bool {
    var ref: ?^frontend.TipoRef = none
    var tipo: u32 = 0
    if not sem_ligar_embutido(s, e, s.params_new[..]) {
        return false
    }
    if not resolver_tipo_do_argumento(s, e, &ref, &tipo) {
        return false
    }
    if not sem_conferir_alocador(s, e, &(e.args or_else {})[1]) {
        return false
    }
    if not conferir_tipo_do_new(s, e, ref as ^frontend.TipoRef, tipo) {
        return false
    }
    e.tipo = tipo_ponteiro(&s.tipos, tipo)
    return true
}

// C: semantic/sem_memoria.c:248
proc conferir_tipo_do_make(s: ^Semantica, ref: ^frontend.TipoRef, tipo: u32) -> bool {
    let classe: i32 = tipo_classe_de(&s.tipos, tipo)
    if common.c2f_s2u_32(classe) == (TC_DINAMICO as u32) {
        return true
    }
    if common.c2f_b2i32(tipo_eh_lista_fixa(&s.tipos, tipo)) != 0 {
        return sem_erro_de_lista_fixa(s, ref.pos, "make nao cria [dynamic, N]T: a lista fixa nasce de {} e nao tem alocador (var l: [dynamic, N]T = {})")
    }
    if common.c2f_b2i32(common.c2f_s2u_32(classe) == (TC_MAPA as u32)) != 0 {
        return true
    }
    if common.c2f_b2i32(common.c2f_s2u_32(classe) == (TC_SOA as u32)) != 0 {
        if tipo_soa_dinamica(&s.tipos, tipo) {
            return true
        }
        let msg_1 = format(f"soa[N]S nao nasce de make: declare var a: soa[N]S = {{}}", alloc = heap)
        defer delete(msg_1)
        return sem_erro(s, common.E0320, ref.pos, msg_1)
    }
    if common.c2f_s2u_32(classe) == (TC_FATIA as u32) {
        let msg_2 = format(f"make de fatia nao existe: crie a lista com make([dynamic]T, alloc = heap) e empreste com l[..]", alloc = heap)
        defer delete(msg_2)
        return sem_erro(s, common.E0310, ref.pos, msg_2)
    }
    let msg_3 = format(f"make cria lista, map ou soa dinamica: make([dynamic]T, alloc = heap, cap = 0)", alloc = heap)
    defer delete(msg_3)
    return sem_erro(s, common.E0310, ref.pos, msg_3)
}

// C: semantic/sem_memoria.c:267
proc conferir_cap(s: ^Semantica, v: ?^frontend.Expr, rotulo: str) -> bool {
    var negativo: bool = false
    var magnitude: u64 = 0
    if (not sem_expr(s, v, TIPO_INT as u32)) or (not sem_compativel(s, TIPO_INT as u32, (v as ^frontend.Expr).tipo, (v as ^frontend.Expr).pos)) {
        return false
    }
    if ((common.c2f_b2i32(sem_inteiro_constante(s, v, &negativo, &magnitude)) != 0) and (common.c2f_b2i32(negativo) != 0)) and (magnitude != 0) {
        let msg_1 = format(f"{rotulo} negativo (-{magnitude})", alloc = heap)
        defer delete(msg_1)
        return sem_erro(s, common.E0421, (v as ^frontend.Expr).pos, msg_1)
    }
    return true
}

// C: semantic/sem_memoria.c:279
proc conferir_elemento_zeravel(s: ^Semantica, pos: u32, elemento: u32, quem: str) -> bool {
    if (tipo_eh_inteiro(elemento) or tipo_eh_real(&s.tipos, elemento)) or (elemento == (TIPO_BOOL as u32)) {
        return true
    }
    let texto = s4_descrever(s, elemento)
    defer delete(texto)
    let msg_1 = format(f"{quem} so vale em lista de inteiro, real ou bool (elemento {texto}): os demais entram um a um com append", alloc = heap)
    defer delete(msg_1)
    return sem_erro(s, common.E0310, pos, msg_1)
}

// C: semantic/sem_memoria.c:288
proc conferir_tamanhos_do_make(s: ^Semantica, e: ^frontend.Expr, tipo: u32) -> bool {
    var k: u32 = 2
    while k < e.nargs {
        let g: ^frontend.Arg = &(e.args or_else {})[k]
        let eh_len: bool = g.indice == frontend.MAKE_PARAM_LEN
        var tern_1: str = "cap"
        if common.c2f_b2i32(eh_len) != 0 {
            tern_1 = "len"
        }
        if not conferir_cap(s, g.valor, tern_1) {
            return false
        }
        if not eh_len {
            k += 1
            continue
        }
        if common.c2f_s2u_32(tipo_classe_de(&s.tipos, tipo)) != (TC_DINAMICO as u32) {
            let msg_1 = format(f"len so vale em make([dynamic]T, alloc = heap, len = n)", alloc = heap)
            defer delete(msg_1)
            return sem_erro(s, common.E0310, (g.valor as ^frontend.Expr).pos, msg_1)
        }
        let arg_1: str = "make com len"
        let arg_2: u32 = tipo_de(&s.tipos, tipo).a
        let arg_3: u32 = (g.valor as ^frontend.Expr).pos
        let arg_4: ^Semantica = s
        if not conferir_elemento_zeravel(arg_4, arg_3, arg_2, arg_1) {
            return false
        }
        k += 1
    }
    return true
}

// C: semantic/sem_memoria.c:302
proc chamar_make(s: ^Semantica, e: ^frontend.Expr) -> bool {
    var ref: ?^frontend.TipoRef = none
    var tipo: u32 = 0
    if not sem_ligar_embutido(s, e, s.params_make[..]) {
        return false
    }
    if not resolver_tipo_do_argumento(s, e, &ref, &tipo) {
        return false
    }
    if not sem_conferir_alocador(s, e, &(e.args or_else {})[1]) {
        return false
    }
    if not conferir_tipo_do_make(s, ref as ^frontend.TipoRef, tipo) {
        return false
    }
    if not conferir_tamanhos_do_make(s, e, tipo) {
        return false
    }
    e.tipo = tipo
    return true
}

// C: semantic/sem_memoria.c:318
proc eh_ponteiro_de_lista(s: ^Semantica, t: u32, anulavel_vale: bool) -> bool {
    let k: ^TipoInfo = tipo_de(&s.tipos, t)
    if (k.classe != (TC_PONTEIRO as u8)) and (not ((common.c2f_b2i32(anulavel_vale) != 0) and (k.classe == (TC_ANULAVEL as u8)))) {
        return false
    }
    return common.c2f_s2u_32(tipo_classe_de(&s.tipos, k.a)) == (TC_DINAMICO as u32)
}

