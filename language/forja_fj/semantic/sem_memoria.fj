// C: semantic/sem_memoria.c:36
proc sem_tipo_eh_dono(s: ^Semantica, t: u32) -> bool {
    let k: ^TipoInfo = tipo_de(&s.tipos, t)
    if k.classe == (TC_DINAMICO as u8) {
        return true
    }
    if k.classe == (TC_ARRAY as u8) {
        return sem_tipo_eh_dono(s, k.a)
    }
    if k.classe == (TC_STRUCT as u8) {
        return ((s.globais or_else {})[k.a].decl as ^frontend.Decl).contem_dono
    }
    if k.classe == (TC_RESULTADO as u8) {
        return sem_tipo_eh_dono(s, k.a)
    }
    if common.c2f_b2i32((k.classe as i32) >= TC_MAPA) != 0 {
        return (k.classe == (TC_MAPA as u8)) or ((k.classe == (TC_SOA as u8)) and (common.c2f_b2i32(tipo_soa_dinamica(&s.tipos, t)) != 0))
    }
    return false
}

// C: semantic/sem_memoria.c:48
proc sem_colecao_dona(s: ^Semantica, t: u32) -> bool {
    let c: i32 = tipo_classe_de(&s.tipos, t)
    return ((common.c2f_s2u_32(c) == (TC_DINAMICO as u32)) or (common.c2f_s2u_32(c) == (TC_MAPA as u32))) or ((common.c2f_s2u_32(c) == (TC_SOA as u32)) and (common.c2f_b2i32(tipo_soa_dinamica(&s.tipos, t)) != 0))
}

// C: semantic/sem_memoria.c:55
proc sem_conferir_movimento_dono(s: ^Semantica, e: ?^frontend.Expr) -> bool {
    let ex: ^frontend.Expr = e as ^frontend.Expr
    if ex.tipo_no == (frontend.EX_EMBRULHA as u8) {
        return true
    }
    if not sem_tipo_eh_dono(s, ex.tipo) {
        return true
    }
    if ex.tipo_no == (frontend.EX_OR_ELSE as u8) {
        return sem_conferir_movimento_dono(s, ex.b)
    }
    if (((ex.tipo_no == (frontend.EX_NOME as u8)) or (ex.tipo_no == (frontend.EX_CAMPO as u8))) or (ex.tipo_no == (frontend.EX_INDICE as u8))) or ((ex.tipo_no == (frontend.EX_UNARIO as u8)) and (ex.op == (frontend.OP_DEREF as u8))) {
        let tipo = s4_descrever(s, ex.tipo)
        defer delete(tipo)
        if tipo_classe_de(&s.tipos, ex.tipo) == TC_MAPA {
            let msg_1 = format(f"copiar {tipo} criaria dois donos da mesma tabela: use &m (^map[K]V) para alterar ou ler", alloc = heap)
            defer delete(msg_1)
            _ = sem_erro(s, common.E0311, ex.pos, msg_1)
        } else if tipo_classe_de(&s.tipos, ex.tipo) == TC_SOA {
            let msg_2 = format(f"copiar {tipo} criaria dois donos das mesmas colunas: use &a (^soa[dynamic]S)", alloc = heap)
            defer delete(msg_2)
            _ = sem_erro(s, common.E0311, ex.pos, msg_2)
        } else {
            let msg_3 = format(f"copiar {tipo} criaria duas donas da mesma memoria: use &x (^[dynamic]T) para alterar ou x[..] para emprestar", alloc = heap)
            defer delete(msg_3)
            _ = sem_erro(s, common.E0311, ex.pos, msg_3)
        }
        sem_forma_do_dono(s, DONO_COPIA, ex.pos, ex.tipo)
        return false
    }
    return true
}

// C: semantic/sem_memoria.c:83
proc sem_alocacao_do_nome(s: ^Semantica, v: ?^frontend.Expr) -> u8 {
    if (v as ^frontend.Expr).tipo_no != (frontend.EX_NOME as u8) {
        return frontend.ALOC_NENHUM as u8
    }
    if (v as ^frontend.Expr).nome == s.nome_heap {
        return frontend.ALOC_HEAP as u8
    }
    if (v as ^frontend.Expr).nome == s.nome_frame {
        return frontend.ALOC_FRAME as u8
    }
    if (v as ^frontend.Expr).nome == s.nome_escopo {
        return frontend.ALOC_ESCOPO as u8
    }
    var tern_1: i32 = frontend.ALOC_NENHUM
    if ((v as ^frontend.Expr).nome == s.nome_scope) and (common.c2f_b2i32(em_nao_declarado(s, v)) != 0) {
        tern_1 = frontend.ALOC_ESCOPO
    }
    return tern_1 as u8
}

// C: semantic/sem_memoria.c:93
proc conferir_valor_antigo(s: ^Semantica, v: ?^frontend.Expr) -> bool {
    let vv: ^frontend.Expr = v as ^frontend.Expr
    var r: ?^common.Renomeado = none
    if vv.nome == s.nome_escopo {
        r = common.renomeado_buscar(common.REN_VALOR_ALOCADOR, "escopo")
    }
    if r == none {
        return true
    }
    common.renomeado_notar_tabela(s.diag as ^common.Diag, vv.pos, common.interner_tam(nomes_da_sem(s), vv.nome), r)
    if not common.renomeado_recusa_em(s.diag as ^common.Diag, r) {
        return true
    }
    return common.renomeado_recusar(s.diag as ^common.Diag, vv.pos, common.interner_tam(nomes_da_sem(s), vv.nome), r)
}

