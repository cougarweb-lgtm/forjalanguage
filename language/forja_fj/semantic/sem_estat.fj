import "common"
import "frontend"

const NOMES_QTD_2: i32 = 9
const NOMES_3: [9]str = {"min_of", "max_of", "sum", "avg", "keys", "values", "from_bytes", "as_bytes", "to_str"}

// C: semantic/sem_estat.c:24
proc nome_interno(s: ^Semantica, texto: str) -> i32 {
    return common.internar(nomes_da_sem(s), texto, len(texto) as u32)
}

// C: semantic/sem_estat.c:29
proc sem_estat_internar(s: ^Semantica) {
    for k in (0 as u64)..<(NOMES_QTD_2 as u64) {
        _ = nome_interno(s, NOMES_3[k])
    }
}

// C: semantic/sem_estat.c:34
proc sem_estat_registrar(s: ^Semantica) {
    for k in (0 as i32)..<NOMES_QTD_2 {
        let y: ^Simbolo = &(s.globais or_else {})[nome_interno(s, NOMES_3[k])]
        y.categoria = SIM_PROC_EMBUTIDO as u8
        y.indice = frontend.EMB_MIN_OF + k
        y.tipo = TIPO_VAZIO as u32
    }
}

// C: semantic/sem_estat.c:45
proc sem_chamar_estatistica(s: ^Semantica, e: ^frontend.Expr, embutido: i32) -> bool {
    var elemento: u32 = 0
    if not sem_ligar_embutido(s, e, s.params_lista[(ASS_COLECAO as int)..<((ASS_COLECAO as int) + 1)]) {
        return false
    }
    if not sem_checar(s, (argumento_do_parametro(e, 0) as ^frontend.Arg).valor, TIPO_VAZIO as u32) {
        return false
    }
    if not sem_colecao_ja_checada(s, e, 0, false, &elemento) {
        return false
    }
    if (not tipo_eh_inteiro(elemento)) and (not tipo_eh_real(&s.tipos, elemento)) {
        let texto = sem_descrever_str(s, elemento)
        defer delete(texto)
        let quem = sem_nome_texto(s, e.nome)
        let msg_1 = format(f"{quem} pede elemento numerico (inteiro ou real); {texto} nao serve", alloc = heap)
        defer delete(msg_1)
        return sem_erro(s, common.E0301, e.pos_op, msg_1)
    }
    if embutido == frontend.EMB_SUM {
        e.tipo = elemento
    } else if embutido == frontend.EMB_AVG {
        e.tipo = TIPO_F64 as u32
    } else {
        e.tipo = tipo_opcional(&s.tipos, elemento)
    }
    return true
}

// C: semantic/sem_estat.c:62
proc sem_chamar_estat(s: ^Semantica, e: ^frontend.Expr, embutido: i32) -> bool {
    if embutido == frontend.EMB_MIN_OF or embutido == frontend.EMB_MAX_OF or embutido == frontend.EMB_SUM or embutido == frontend.EMB_AVG {
        return sem_chamar_estatistica(s, e, embutido)
    } else if embutido == frontend.EMB_KEYS or embutido == frontend.EMB_VALUES {
        return sem_chamar_vistas_do_mapa(s, e, embutido)
    } else if embutido == frontend.EMB_FROM_BYTES {
        return sem_chamar_from_bytes(s, e)
    } else if embutido == frontend.EMB_AS_BYTES {
        return sem_chamar_as_bytes(s, e)
    } else if embutido == frontend.EMB_TO_STR {
        return sem_chamar_to_str(s, e)
    } else {
        let msg_1 = format(f"SemChamarEstat: embutido {embutido} desconhecido", alloc = heap)
        defer delete(msg_1)
        common.falha_interna(msg_1)
    }
    return false
}

// G3 S5: testes dirigidos (so existem em `forja test`)
test "sem_estat: nome_interno, internar, registrar e a tabela de nomes" {
    var c = S5Cena{}
    s5_cena_montar(&c, {})
    expect(NOMES_QTD_2 == 9 and NOMES_3[0] == "min_of" and NOMES_3[1] == "max_of" and NOMES_3[2] == "sum" and NOMES_3[3] == "avg" and NOMES_3[4] == "keys" and NOMES_3[5] == "values" and NOMES_3[6] == "from_bytes" and NOMES_3[7] == "as_bytes" and NOMES_3[8] == "to_str")
    expect(nome_interno(&c.sv, "min_of") == s5_nome(&c, "min_of") and nome_interno(&c.sv, "outro_nome") == s5_nome(&c, "outro_nome"))
    let globais = c.sv.globais or_else {}
    for k in 0..<(NOMES_QTD_2 as int) {
        let id: i32 = common.interner_achar(&c.ins[0], NOMES_3[k], len(NOMES_3[k]) as u32)
        expect(id >= 0 and (id as u32) < c.sv.qtd_nomes)
        expect(globais[id].categoria == (SIM_PROC_EMBUTIDO as u8) and globais[id].indice == frontend.EMB_MIN_OF + (k as i32) and globais[id].tipo == (TIPO_VAZIO as u32))
    }
    s5_cena_liberar(&c)
}

test "sem_estat: sem_chamar_estatistica (min_of, max_of, sum e avg)" {
    var pre: [5]str = {"min_of", "max_of", "sum", "avg", "keys"}
    var c = S5Cena{}
    s5_cena_montar(&c, pre[..])
    let i32t: u32 = TIPO_I32 as u32
    let f32t: u32 = TIPO_F32 as u32
    var um: [1]u32 = {tipo_fatia(&c.sv.tipos, i32t)}
    var ch = S5Chamada{}
    s5_chamada_montar(&ch, s5_nome(&c, "min_of"), um[..])
    expect(sem_chamar_estatistica(&c.sv, &ch.e, frontend.EMB_MIN_OF) and ch.e.tipo == tipo_opcional(&c.sv.tipos, i32t))
    expect(sem_chamar_estatistica(&c.sv, &ch.e, frontend.EMB_MAX_OF) and ch.e.tipo == tipo_opcional(&c.sv.tipos, i32t))
    expect(sem_chamar_estatistica(&c.sv, &ch.e, frontend.EMB_SUM) and ch.e.tipo == i32t)
    expect(sem_chamar_estatistica(&c.sv, &ch.e, frontend.EMB_AVG) and ch.e.tipo == (TIPO_F64 as u32))
    // elemento real: sum devolve o proprio, min_of o opcional dele
    ch.folhas[0].tipo = tipo_fatia(&c.sv.tipos, f32t)
    expect(sem_chamar_estatistica(&c.sv, &ch.e, frontend.EMB_SUM) and ch.e.tipo == f32t)
    expect(sem_chamar_estatistica(&c.sv, &ch.e, frontend.EMB_MIN_OF) and ch.e.tipo == tipo_opcional(&c.sv.tipos, f32t))
    // lista dinamica de int: a colecao vira fatia_inteira e o resultado e o mesmo
    ch.folhas[0].tipo = tipo_dinamico(&c.sv.tipos, i32t)
    expect(sem_chamar_estatistica(&c.sv, &ch.e, frontend.EMB_SUM) and ch.e.tipo == i32t)
    // o despacho de sem_chamar_estat para min_of e sum
    ch.folhas[0].tipo = tipo_fatia(&c.sv.tipos, i32t)
    ch.args[0].valor = &ch.folhas[0]
    expect(sem_chamar_estat(&c.sv, &ch.e, frontend.EMB_AVG) and ch.e.tipo == (TIPO_F64 as u32))
    // (elemento nao numerico: E0301 -> sem_forma_da_regra, stub do S7; colecao que nao e lista: E0310 -> rel_do_uso, stub do S8: sem execucao)
    s5_chamada_liberar(&ch)
    s5_cena_liberar(&c)
}
