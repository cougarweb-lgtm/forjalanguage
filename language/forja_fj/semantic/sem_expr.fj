    }
    if tag == 11 {
        return ex_chamada_2(s, e, ctx)
    }
    if tag == 12 {
        return ex_literal_struct_2(s, e, ctx)
    }
    if tag == 13 {
        return ex_try_2(s, e, ctx)
    }
    if tag == 14 {
        return ex_or_else_2(s, e, ctx)
    }
    if tag == 15 {
        return ex_indice_2(s, e, ctx)
    }
    if tag == 16 {
        return ex_fatia_2(s, e, ctx)
    }
    if tag == 17 {
        return ex_tipo_2(s, e, ctx)
    }
    if tag == 18 {
        return ex_ja_tipado(s, e, ctx)
    }
    if tag == 19 {
        return ex_tupla_2(s, e, ctx)
    }
    if tag == 20 {
        return ex_f_texto_2(s, e, ctx)
    }
    if tag == 21 {
        return ex_chamada_ind_2(s, e, ctx)
    }
    panic("C2F-80: tag sem alvo em chamar_checa_expr (ponteiro NULL no C)")
    return false
}

// C: semantic/sem_expr.c:52
proc eh_aritmetico(op: u8) -> bool {
    return ((op as i32) >= frontend.OP_SOMA) and ((op as i32) <= frontend.OP_RESTO)
}

// C: semantic/sem_expr.c:53
proc eh_bits(op: u8) -> bool {
    return ((op as i32) >= frontend.OP_BIT_E) and ((op as i32) <= frontend.OP_DESLOCA_DIR)
}

// C: semantic/sem_expr.c:55
proc no_flexivel(e: ?^frontend.Expr) -> bool {
    if ((e as ^frontend.Expr).tipo_no == (frontend.EX_INT as u8)) or ((e as ^frontend.Expr).tipo_no == (frontend.EX_REAL as u8)) {
        return true
    }
    if (e as ^frontend.Expr).tipo_no == (frontend.EX_UNARIO as u8) {
        return (((e as ^frontend.Expr).op == (frontend.OP_NEGAR as u8)) or ((e as ^frontend.Expr).op == (frontend.OP_BIT_NAO as u8))) and (common.c2f_b2i32(((e as ^frontend.Expr).a as ^frontend.Expr).flexivel) != 0)
    }
    if (e as ^frontend.Expr).tipo_no != (frontend.EX_BINARIO as u8) {
        return false
    }
    return (((common.c2f_b2i32(eh_aritmetico((e as ^frontend.Expr).op)) != 0) or (common.c2f_b2i32(eh_bits((e as ^frontend.Expr).op)) != 0)) and (common.c2f_b2i32(((e as ^frontend.Expr).a as ^frontend.Expr).flexivel) != 0)) and (common.c2f_b2i32(((e as ^frontend.Expr).b as ^frontend.Expr).flexivel) != 0)
}

// C: semantic/sem_expr.c:63
proc sem_marcar_flexivel(e: ?^frontend.Expr) {
    if (e as ^frontend.Expr).a != none {
        sem_marcar_flexivel((e as ^frontend.Expr).a)
    }
    if (e as ^frontend.Expr).b != none {
        sem_marcar_flexivel((e as ^frontend.Expr).b)
    }
    for i in (0 as u32)..<(e as ^frontend.Expr).nargs {
        sem_marcar_flexivel(((e as ^frontend.Expr).args or_else {})[i].valor)
    }
    let ptr_1: ^frontend.Expr = e as ^frontend.Expr
    ptr_1.flexivel = no_flexivel(e)
}

