// E0420 por largura: o literal (negado se 'negativo') cabe no tipo? 'pos' = onde o erro aponta (o literal, ou o '-').
proc conferir_literal_inteiro(s: ^Semantica, literal: ?^frontend.Expr, tipo: u32, negativo: bool, pos: u32) -> bool {
    var mag: u64 = 0
    if (((literal as ^frontend.Expr).op as i32) <= (DIGITOS_SEGUROS[tipo as int] as i32)) and (not (negativo and tipo_eh_sem_sinal(tipo))) {
        return true
    }
    let digitos = numero_da_fonte(s, (literal as ^frontend.Expr).pos_op)
    defer delete(digitos)
    if not tipo_ler_literal_u64(as_bytes(digitos), &mag) {
        let msg_1 = format(f"o literal passa de 64 bits (maximo 18446744073709551615)", alloc = heap)
        defer delete(msg_1)
        return sem_erro(s, common.E0420, pos, msg_1)
    }
    if tipo_inteiro_cabe(tipo, negativo, mag) {
        return true
    }
    var rotulo: str = "literal"
    var sinal: str = ""
    if negativo {
        rotulo = "valor"
        sinal = "-"
    }
    let nome_fixo: str = tipo_nome_fixo(tipo) or_else "(null)"
    let msg_2 = format(f"o {rotulo} {sinal}{mag} nao cabe em {nome_fixo} ({tipo_inteiro_min(tipo)}..={tipo_inteiro_max(tipo)})", alloc = heap)
    defer delete(msg_2)
    return sem_erro(s, common.E0420, pos, msg_2)
}

