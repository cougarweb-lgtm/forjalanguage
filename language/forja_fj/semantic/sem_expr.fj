// C: semantic/sem_expr.c:778
proc sem_checar(s: ^Semantica, e: ?^frontend.Expr, ctx: u32) -> bool {
    let ok: bool = chamar_checa_expr(CHECAGENS[(e as ^frontend.Expr).tipo_no as int], s, e as ^frontend.Expr, ctx)
    if ((e as ^frontend.Expr).tipo == (TIPO_VENENO as u32)) and ok {
        s.tocou_veneno = true // L8: o erro que vier depois e cascata
    }
    return ok
}

// C: semantic/sem_expr.c:785
proc sem_expr(s: ^Semantica, e: ?^frontend.Expr, ctx: u32) -> bool {
    sem_marcar_flexivel(e)
    return sem_checar(s, e, ctx)
}

// C: semantic/sem_expr.c:791
proc sem_expr_com(s: ^Semantica, e: ?^frontend.Expr, esperado: u32) -> bool {
    return (common.c2f_b2i32(sem_expr(s, e, esperado)) != 0) and (common.c2f_b2i32(sem_coagir(s, e, esperado, (e as ^frontend.Expr).pos)) != 0)
}

// C: semantic/sem_expr.c:796
proc sem_condicao(s: ^Semantica, cond: ?^frontend.Expr) -> bool {
    if not sem_expr(s, cond, TIPO_BOOL as u32) {
        return false
    }
    if (cond as ^frontend.Expr).tipo == (TIPO_BOOL as u32) {
        return true
    }
    let msg_1 = format(f"a condicao precisa ser bool", alloc = heap)
    defer delete(msg_1)
    _ = sem_erro(s, common.E0301, (cond as ^frontend.Expr).pos, msg_1)
    sem_forma_do_valor(s, cond, TIPO_BOOL as u32, "a condicao")
    return false
}

// Valores esperados lidos do C (sem_expr.c:52..53, 453..454, 494..500): faixas de operador e vizinhos de cada borda.
test "sem_expr: faixas de operador" {
    expect(eh_aritmetico(frontend.OP_SOMA as u8) and eh_aritmetico(frontend.OP_MUL as u8) and eh_aritmetico(frontend.OP_RESTO as u8))
    expect(not eh_aritmetico(frontend.OP_MAIOR_IGUAL as u8) and not eh_aritmetico(frontend.OP_NEGAR as u8))
    expect(eh_bits(frontend.OP_BIT_E as u8) and eh_bits(frontend.OP_BIT_XOU as u8) and eh_bits(frontend.OP_DESLOCA_DIR as u8))
    expect(not eh_bits(frontend.OP_BIT_NAO as u8) and not eh_bits(frontend.OP_RESTO as u8) and not eh_bits(frontend.OP_SOMA as u8))
    expect(eh_logico(frontend.OP_E as u8) and eh_logico(frontend.OP_OU as u8) and not eh_logico(frontend.OP_IGUAL as u8))
    expect(eh_comparacao(frontend.OP_IGUAL as u8) and eh_comparacao(frontend.OP_MAIOR_IGUAL as u8))
    expect(not eh_comparacao(frontend.OP_E as u8) and not eh_comparacao(frontend.OP_SOMA as u8))
    expect(eh_ordem(frontend.OP_MENOR as u8) and eh_ordem(frontend.OP_MAIOR_IGUAL as u8))
    expect(not eh_ordem(frontend.OP_IGUAL as u8) and not eh_ordem(frontend.OP_DIFERENTE as u8) and not eh_ordem(frontend.OP_SOMA as u8))
}

test "sem_expr: classe_comparavel" {
    expect(classe_comparavel(TC_BOOL) and classe_comparavel(TC_I32) and classe_comparavel(TC_INT) and classe_comparavel(TC_REAL))
    expect(classe_comparavel(TC_ENUM) and classe_comparavel(TC_PONTEIRO) and classe_comparavel(TC_ANULAVEL) and classe_comparavel(TC_RAWPTR) and classe_comparavel(TC_TEXTO))
    expect(classe_comparavel(TC_I8) and classe_comparavel(TC_U32) and classe_comparavel(TC_F64)) // faixa TC_I8..TC_F64
    expect(not classe_comparavel(TC_VAZIO) and not classe_comparavel(TC_STRUCT) and not classe_comparavel(TC_RESULTADO) and not classe_comparavel(TC_VENENO))
    expect(not classe_comparavel(TC_CSTR) and not classe_comparavel(TC_ARRAY) and not classe_comparavel(TC_TUPLA))
}

test "sem_expr: flexivel de literal, negacao e conta" {
    var lit = frontend.Expr{tipo_no = frontend.EX_INT as u8}
    var nome = frontend.Expr{tipo_no = frontend.EX_NOME as u8}
    var neg = frontend.Expr{tipo_no = frontend.EX_UNARIO as u8, op = frontend.OP_NEGAR as u8, a = &lit}
    var nao = frontend.Expr{tipo_no = frontend.EX_UNARIO as u8, op = frontend.OP_NAO as u8, a = &lit}
    var soma = frontend.Expr{tipo_no = frontend.EX_BINARIO as u8, op = frontend.OP_SOMA as u8, a = &lit, b = &neg}
    var mista = frontend.Expr{tipo_no = frontend.EX_BINARIO as u8, op = frontend.OP_SOMA as u8, a = &lit, b = &nome}
    var igual = frontend.Expr{tipo_no = frontend.EX_BINARIO as u8, op = frontend.OP_IGUAL as u8, a = &lit, b = &lit}
    sem_marcar_flexivel(&soma)
    expect(lit.flexivel and neg.flexivel and soma.flexivel) // literal, -literal e literal + (-literal)
    sem_marcar_flexivel(&nao)
    expect(not nao.flexivel) // OP_NAO nao e flexivel
    sem_marcar_flexivel(&mista)
    expect(not nome.flexivel and not mista.flexivel) // um nome estraga a conta toda
    sem_marcar_flexivel(&igual)
    expect(not igual.flexivel) // comparacao nao e aritmetica nem de bits
}
