// C: semantic/sem_expr.c:211
// Campo pedido onde nao ha struct: '?^T' (pode ser none) e '^^T' (o '.' desreferencia um nivel so) ganham causa propria.
proc erro_campo_sem_struct(s: ^Semantica, e: ^frontend.Expr) -> bool {
    let k: ^TipoInfo = tipo_de(&s.tipos, (e.a as ^frontend.Expr).tipo)
    if eh_lista(s, (e.a as ^frontend.Expr).tipo) {
        let msg_1 = format(f"lista nao tem campo: use l[0] e len(l)", alloc = heap)
        defer delete(msg_1)
        return sem_erro(s, common.E0308, e.pos_op, msg_1)
    }
    if eh_colecao(s, (e.a as ^frontend.Expr).tipo) {
        let msg_2 = format(f"array nao tem campo: use a[0] (.x .y .z .w so em [2]T, [3]T e [4]T de numero; matrix[R, C]T usa m[i, j])", alloc = heap)
        defer delete(msg_2)
        return sem_erro(s, common.E0308, e.pos_op, msg_2)
    }
    if k.classe == (TC_ANULAVEL as u8) {
        let apontado = texto_do_tipo(s, k.a, 96)
        defer delete(apontado)
        let msg_3 = format(f"campo de '?^{apontado}' pode estar em none: converta com 'p as ^{apontado}' antes", alloc = heap)
        defer delete(msg_3)
        return sem_erro(s, common.E0306, e.pos_op, msg_3)
    }
    if k.classe == (TC_OPCIONAL as u8) {
        let apontado = texto_do_tipo(s, (e.a as ^frontend.Expr).tipo, 96)
        defer delete(apontado)
        let msg_4 = format(f"campo de '{apontado}' pode estar em none: desembrulhe com switch v in x {{ case T: ... case none: ... }} ou x or_else padrao", alloc = heap)
        defer delete(msg_4)
        return sem_erro(s, common.E0312, e.pos_op, msg_4)
    }
    if k.classe == (TC_UNIAO as u8) {
        let msg_5 = format(f"union nao tem campo: leia com switch v in x {{ case Variante: v.{sem_nome_texto(s, e.nome)} }}", alloc = heap)
        defer delete(msg_5)
        return sem_erro(s, common.E0313, e.pos_op, msg_5)
    }
    if (k.classe == (TC_PONTEIRO as u8)) and (tipo_classe_de(&s.tipos, k.a) == TC_PONTEIRO) {
        let msg_6 = format(f"'.' desreferencia um nivel so; escreva 'pp^.{sem_nome_texto(s, e.nome)}'", alloc = heap)
        defer delete(msg_6)
        return sem_erro(s, common.E0306, e.pos_op, msg_6)
    }
    let msg_7 = format(f"campo '{sem_nome_texto(s, e.nome)}' pedido em valor que nao e struct", alloc = heap)
    defer delete(msg_7)
    return sem_erro(s, common.E0201, e.pos_op, msg_7)
}

// C: semantic/sem_expr.c:237
proc campo_fora_de_struct(s: ^Semantica, e: ^frontend.Expr) -> bool {
    if (common.c2f_b2i32(tipos_tem_v19(&s.tipos)) != 0) and (common.c2f_b2i32(sem_eh_tipo_v19(s, (e.a as ^frontend.Expr).tipo)) != 0) {
        return sem_campo_v19(s, e)
    }
    var tern_1: i32 = 0
    if common.c2f_b2i32(sem_idioma_de_campo(s, e)) != 0 {
        tern_1 = 0
    } else {
        tern_1 = common.c2f_b2i32(erro_campo_sem_struct(s, e))
    }
    return tern_1 != 0
}

// C: semantic/sem_expr.c:243
proc ex_campo_2(s: ^Semantica, e: ^frontend.Expr, ctx: u32) -> bool {
    if nome_eh_enum(s, e.a) {
        return ex_membro(s, e)
    }
    s.alocador_lendo = (e.a as ^frontend.Expr).tipo_no == (frontend.EX_NOME as u8)
    let base_ok: bool = sem_checar(s, e.a, TIPO_VAZIO as u32)
    s.alocador_lendo = false
    if not base_ok {
        return false
    }
    if sem_eh_lista_fixa_ou_ponteiro(s, (e.a as ^frontend.Expr).tipo) {
        var tern_1: i32 = 0
        if common.c2f_b2i32(sem_idioma_de_campo(s, e)) != 0 {
            tern_1 = 0
        } else {
            tern_1 = common.c2f_b2i32(sem_erro_de_lista_fixa(s, e.pos_op, "[dynamic, N]T nao tem campo: use l[i], len(l), l[..] e append(&l, item = x)"))
        }
        return tern_1 != 0
    }
    if common.c2f_b2i32(sem_eh_allocator(s, (e.a as ^frontend.Expr).tipo)) != 0 {
        return sem_allocator_ler_campo(s, e)
    }
    let estrutura: ?^frontend.Decl = sem_decl_da_struct(s, (e.a as ^frontend.Expr).tipo)
    if estrutura == none {
        var tern_2: i32 = 0
        if common.c2f_b2i32(sem_eh_swizzle(s, e)) != 0 {
            tern_2 = common.c2f_b2i32(sem_swizzle(s, e))
        } else {
            tern_2 = common.c2f_b2i32(campo_fora_de_struct(s, e))
        }
        return tern_2 != 0
    }
    let idx: i32 = sem_achar_campo(estrutura, e.nome)
    if idx < 0 {
        if (estrutura as ^frontend.Decl).externo {
            let msg_1 = format(f"o tipo opaco '{sem_nome_texto(s, (estrutura as ^frontend.Decl).nome)}' nao tem campos visiveis: use as funcoes da biblioteca C", alloc = heap)
            defer delete(msg_1)
            return sem_erro(s, common.E0908, e.pos_op, msg_1)
        }
        var sp: SemParecido = SemParecido{}
        sem_parecido_iniciar(s, common.E0201, e.pos_op, e.nome, &sp)
        sem_parecidos_de_campos(s, estrutura, &sp)
        let msg_2 = format(f"a struct '{sem_nome_texto(s, (estrutura as ^frontend.Decl).nome)}' nao tem o campo '{sem_nome_texto(s, e.nome)}'", alloc = heap)
        defer delete(msg_2)
        return sem_erro_parecido(s, &sp, msg_2)
    }
    e.ref = frontend.REF_CAMPO as u8
    e.ref_id = idx
    e.tipo = ((estrutura as ^frontend.Decl).campos or_else {})[idx].tipo.tipo
    return true
}

// C: semantic/sem_expr.c:276
proc unario_nao(s: ^Semantica, e: ^frontend.Expr) -> bool {
    if not sem_checar(s, e.a, TIPO_BOOL as u32) {
        return false
    }
    if (e.a as ^frontend.Expr).tipo != (TIPO_BOOL as u32) {
        let msg_1 = format(f"'not' pede bool", alloc = heap)
        defer delete(msg_1)
        return sem_erro(s, common.E0301, e.pos, msg_1)
    }
    e.tipo = TIPO_BOOL as u32
    return true
}

// C: semantic/sem_expr.c:284
proc unario_endereco(s: ^Semantica, e: ^frontend.Expr) -> bool {
    let a: ?^frontend.Expr = e.a
    if ((a as ^frontend.Expr).tipo_no == (frontend.EX_CAMPO as u8)) or ((a as ^frontend.Expr).tipo_no == (frontend.EX_INDICE as u8)) {
        if not sem_checar(s, a, TIPO_VAZIO as u32) {
            return false
        }
        if ((common.c2f_b2i32(s.tipos.tem_soa) != 0) and ((a as ^frontend.Expr).tipo_no == (frontend.EX_INDICE as u8))) and (common.c2f_s2u_32(tipo_classe_de(&s.tipos, ((a as ^frontend.Expr).a as ^frontend.Expr).tipo)) == (TC_SOA as u32)) {
            let msg_1 = format(f"&a[i] nao existe em soa: a struct nao fica inteira na memoria; use &a[i].campo", alloc = heap)
            defer delete(msg_1)
            return sem_erro(s, common.E0320, e.pos, msg_1)
        }
        if not sem_lvalor_mutavel_de(s, a, "'&' de campo ou elemento permite altera-lo: declare com var") {
            return false
        }
        e.tipo = tipo_ponteiro(&s.tipos, (a as ^frontend.Expr).tipo)
        return true
    }
    if (a as ^frontend.Expr).tipo_no != (frontend.EX_NOME as u8) {
        let msg_2 = format(f"'&' vale sobre variavel, campo ou elemento (a[i])", alloc = heap)
        defer delete(msg_2)
        return sem_erro(s, common.E0301, e.pos, msg_2)
    }
    if not sem_checar(s, a, TIPO_VAZIO as u32) {
        return false
    }
    if ((a as ^frontend.Expr).ref != (frontend.REF_LOCAL as u8)) and ((a as ^frontend.Expr).ref != (frontend.REF_PARAM as u8)) {
        let msg_3 = format(f"'&' so vale sobre o nome de uma variavel", alloc = heap)
        defer delete(msg_3)
        return sem_erro(s, common.E0301, e.pos, msg_3)
    }
    if (a as ^frontend.Expr).op != (LOC_VAR as u8) {
        let msg_4 = format(f"'{sem_nome_texto(s, (a as ^frontend.Expr).nome)}' e imutavel: '&' permitiria alterar o valor; declare com var", alloc = heap)
        defer delete(msg_4)
        return sem_erro(s, common.E0705, (a as ^frontend.Expr).pos, msg_4)
    }
    sem_higiene_alterar(s, a)
    e.tipo = tipo_ponteiro(&s.tipos, (a as ^frontend.Expr).tipo)
    return true
}

// C: semantic/sem_expr.c:310
// 'p^': so ^T se desreferencia; as outras formas de ponteiro dizem o que fazer.
proc unario_deref(s: ^Semantica, e: ^frontend.Expr) -> bool {
    if not sem_checar(s, e.a, TIPO_VAZIO as u32) {
        return false
    }
    let k: ^TipoInfo = tipo_de(&s.tipos, (e.a as ^frontend.Expr).tipo)
    if k.classe == (TC_PONTEIRO as u8) {
        if s.tem_opaco and sem_tipo_eh_opaco(s, k.a) {
            let apontado = texto_do_tipo(s, k.a, 96)
            defer delete(apontado)
            let msg_1 = format(f"nao da para ler o valor de um tipo opaco ('{apontado}'): passe o ponteiro ^{apontado} para as funcoes da biblioteca C", alloc = heap)
            defer delete(msg_1)
            return sem_erro(s, common.E0908, e.pos_op, msg_1)
        }
        e.tipo = k.a
        return true
    }
    if k.classe == (TC_ANULAVEL as u8) {
        let apontado = texto_do_tipo(s, k.a, 96)
        defer delete(apontado)
        let msg_2 = format(f"'?^{apontado}' pode ser none: teste 'p != none' e converta com 'p as ^{apontado}' antes de ler", alloc = heap)
        defer delete(msg_2)
        return sem_erro(s, common.E0306, e.pos_op, msg_2)
    }
    if k.classe == (TC_RAWPTR as u8) {
        let msg_3 = format(f"rawptr nao tem tipo apontado: converta com 'p as ^T' antes de ler", alloc = heap)
        defer delete(msg_3)
        return sem_erro(s, common.E0306, e.pos_op, msg_3)
    }
    if k.classe == (TC_CSTR as u8) {
        let msg_4 = format(f"cstr nao se desreferencia; converta para str com 'c as str'", alloc = heap)
        defer delete(msg_4)
        return sem_erro(s, common.E0306, e.pos_op, msg_4)
    }
    let tipo = texto_do_tipo(s, (e.a as ^frontend.Expr).tipo, 96)
    defer delete(tipo)
    let msg_5 = format(f"'^' depois de um valor que nao e ponteiro (tipo {tipo})", alloc = heap)
    defer delete(msg_5)
    return sem_erro(s, common.E0306, e.pos_op, msg_5)
}

// C: semantic/sem_expr.c:337
proc unario_negar(s: ^Semantica, e: ^frontend.Expr, ctx: u32) -> bool {
    let a: ^frontend.Expr = e.a as ^frontend.Expr
    if (a.tipo_no == (frontend.EX_INT as u8)) and tipo_eh_real(&s.tipos, ctx) { // v1.11: '-1' em contexto real; o sinal nao muda a exatidao
        e.tipo = ctx
        return sem_literal_inteiro_em_real(s, a, ctx)
    }
    if a.tipo_no == (frontend.EX_INT as u8) { // '-literal' e conferido inteiro: -128 cabe em i8 mesmo que 128 nao caiba
        var tipo: u32 = TIPO_INT as u32
        if tipo_eh_inteiro(ctx) {
            tipo = ctx
        }
        a.tipo = tipo
        e.tipo = tipo
        return conferir_literal_inteiro(s, a, tipo, true, e.pos)
    }
    if not sem_checar(s, a, ctx) {
        return false
    }
    if not tipo_eh_numerico(&s.tipos, a.tipo) {
        if tipo_classe_de(&s.tipos, a.tipo) == TC_MATRIZ { // -m (v1.9)
            e.tipo = a.tipo
            return true
        }
        if tipo_classe_de(&s.tipos, a.tipo) == TC_ARRAY {
            return sem_negar_vetor(s, e) // -a em [N]T (v1.11)
        }
        if sem_eh_quat(s, a.tipo) { // -q (v1.11 L14a)
            e.tipo = a.tipo
            return true
        }
        let msg_1 = format(f"'-' pede numero", alloc = heap)
        defer delete(msg_1)
        return sem_erro(s, common.E0301, e.pos, msg_1)
    }
    if tipo_eh_sem_sinal(a.tipo) {
        let nome_fixo: str = tipo_nome_fixo(a.tipo) or_else "(null)"
        let msg_2 = format(f"'-' em inteiro sem sinal ({nome_fixo})", alloc = heap)
        defer delete(msg_2)
        return sem_erro(s, common.E0305, e.pos, msg_2)
    }
    e.tipo = a.tipo
    return true
}

// C: semantic/sem_expr.c:368
proc unario_bit_nao(s: ^Semantica, e: ^frontend.Expr, ctx: u32) -> bool {
    if not sem_checar(s, e.a, ctx) {
        return false
    }
    if not tipo_eh_sem_sinal((e.a as ^frontend.Expr).tipo) {
        let msg_1 = format(f"'~' em tipo que nao e inteiro sem sinal", alloc = heap)
        defer delete(msg_1)
        return sem_erro(s, common.E0303, e.pos, msg_1)
    }
    e.tipo = (e.a as ^frontend.Expr).tipo
    return true
}

// C: semantic/sem_expr.c:376
proc ex_unario_2(s: ^Semantica, e: ^frontend.Expr, ctx: u32) -> bool {
    var ctx_v: u32 = ctx
    ctx_v = sem_ctx_sem_opcional(s, ctx_v)
    if e.op == (frontend.OP_NAO as u8) {
        return unario_nao(s, e)
    }
    if e.op == (frontend.OP_ENDERECO as u8) {
        return unario_endereco(s, e)
    }
    if e.op == (frontend.OP_DEREF as u8) {
        return unario_deref(s, e)
    }
    if e.op == (frontend.OP_BIT_NAO as u8) {
        return unario_bit_nao(s, e, ctx_v)
    }
    return unario_negar(s, e, ctx_v)
}

// C: semantic/sem_expr.c:387
proc conferir_literal_sob_as(s: ^Semantica, e: ^frontend.Expr, alvo: u32) -> bool {
    var literal: ?^frontend.Expr = e.a
    let negativo: bool = (((literal as ^frontend.Expr).tipo_no == (frontend.EX_UNARIO as u8)) and ((literal as ^frontend.Expr).op == (frontend.OP_NEGAR as u8))) and (((literal as ^frontend.Expr).a as ^frontend.Expr).tipo_no == (frontend.EX_INT as u8))
    if negativo {
        literal = (literal as ^frontend.Expr).a
    }
    if ((literal as ^frontend.Expr).tipo_no != (frontend.EX_INT as u8)) or (not tipo_eh_inteiro(alvo)) {
        return true
    }
    var tern_1: u32 = (literal as ^frontend.Expr).pos
    if common.c2f_b2i32(negativo) != 0 {
        tern_1 = (e.a as ^frontend.Expr).pos
    }
    return conferir_literal_inteiro(s, literal, alvo, negativo, tern_1)
}

// C: semantic/sem_expr.c:396
proc eh_ponteiro_ou_anulavel(c: i32) -> bool {
    return (common.c2f_s2u_32(c) == (TC_PONTEIRO as u32)) or (common.c2f_s2u_32(c) == (TC_ANULAVEL as u32))
}

// C: semantic/sem_expr.c:399
proc conversao_para_proc(s: ^Semantica, e: ^frontend.Expr, origem: u32, alvo: u32) -> bool {
    let co: i32 = tipo_classe_de(&s.tipos, origem)
    if ((common.c2f_s2u_32(co) == (TC_RAWPTR as u32)) or (common.c2f_b2i32(eh_ponteiro_ou_anulavel(co)) != 0)) or (common.c2f_b2i32(tipo_proc_compativel(&s.tipos, origem, alvo)) != 0) {
        return true
    }
    let msg_1 = format(f"'as proc(...)' so converte de rawptr, ^T, ?^T (endereco de funcao vindo do C) ou de proc com a mesma assinatura", alloc = heap)
    defer delete(msg_1)
    return sem_erro(s, common.E0910, e.pos_op, msg_1)
}

// C: semantic/sem_expr.c:408
proc conversao_nao_numerica(s: ^Semantica, e: ^frontend.Expr, origem: u32, alvo: u32) -> bool {
    let t: ^Tipos = &s.tipos
    let co: i32 = tipo_classe_de(t, origem)
    let ca: i32 = tipo_classe_de(t, alvo)
    if origem == alvo {
        return true
    }
    if (common.c2f_s2u_32(co) == (TC_CSTR as u32)) and (alvo == (TIPO_TEXTO as u32)) {
        return true
    }
    if (origem == (TIPO_TEXTO as u32)) and (common.c2f_s2u_32(ca) == (TC_CSTR as u32)) {
        let msg_1 = format(f"str nao termina em NUL: um cstr a partir de str precisa alocar e copiar (format_c, v1.6); para literal escreva let c: cstr = \"...\"", alloc = heap)
        defer delete(msg_1)
        return sem_erro(s, common.E0307, e.pos_op, msg_1)
    }
    if ((common.c2f_b2i32(tipo_eh_familia_ponteiro(t, origem)) != 0) and (common.c2f_b2i32(tipo_eh_numerico(t, alvo)) != 0)) or ((common.c2f_b2i32(tipo_eh_familia_ponteiro(t, alvo)) != 0) and (common.c2f_b2i32(tipo_eh_numerico(t, origem)) != 0)) {
        let msg_2 = format(f"ponteiro nao vira numero nem numero vira ponteiro", alloc = heap)
        defer delete(msg_2)
        return sem_erro(s, common.E0306, e.pos_op, msg_2)
    }
    if common.c2f_s2u_32(ca) == (TC_PROC as u32) {
        return conversao_para_proc(s, e, origem, alvo)
    }
    if (common.c2f_s2u_32(co) == (TC_PROC as u32)) and (common.c2f_s2u_32(ca) == (TC_RAWPTR as u32)) {
        return true
    }
    if (((common.c2f_s2u_32(co) == (TC_PONTEIRO as u32)) or (common.c2f_s2u_32(co) == (TC_ANULAVEL as u32))) or (common.c2f_s2u_32(co) == (TC_CSTR as u32))) and (common.c2f_s2u_32(ca) == (TC_RAWPTR as u32)) {
        return true
    }
    if (common.c2f_s2u_32(co) == (TC_RAWPTR as u32)) and (((common.c2f_s2u_32(ca) == (TC_PONTEIRO as u32)) or (common.c2f_s2u_32(ca) == (TC_ANULAVEL as u32))) or (common.c2f_s2u_32(ca) == (TC_CSTR as u32))) {
        return true
    }
    if (common.c2f_b2i32(eh_ponteiro_ou_anulavel(co)) != 0) and (common.c2f_b2i32(eh_ponteiro_ou_anulavel(ca)) != 0) {
        if tipo_de(t, origem).a == tipo_de(t, alvo).a {
            return true
        }
        let msg_3 = format(f"'as' nao troca o tipo apontado direto; passe por rawptr: (p as rawptr) as ^B", alloc = heap)
        defer delete(msg_3)
        return sem_erro(s, common.E0306, e.pos_op, msg_3)
    }
    let msg_4 = format(f"'as' converte entre numericos, entre ponteiros (^T, ?^T, rawptr, cstr) e de cstr para str", alloc = heap)
    defer delete(msg_4)
    return sem_erro(s, common.E0301, e.pos_op, msg_4)
}

// C: semantic/sem_expr.c:435
proc ex_conversao_2(s: ^Semantica, e: ^frontend.Expr, ctx: u32) -> bool {
    var alvo: u32 = 0
    if (not sem_checar(s, e.a, TIPO_VAZIO as u32)) or (not sem_resolver_tipo_ref(s, e.alvo)) {
        return false
    }
    alvo = (e.alvo as ^frontend.TipoRef).tipo
    if (not tipo_eh_numerico(&s.tipos, (e.a as ^frontend.Expr).tipo)) or (not tipo_eh_numerico(&s.tipos, alvo)) {
        if not conversao_nao_numerica(s, e, (e.a as ^frontend.Expr).tipo, alvo) {
            return false
        }
        e.tipo = alvo
        return true
    }
    if not conferir_literal_sob_as(s, e, alvo) {
        return false
    }
    e.tipo = alvo
    return true
}

// C: semantic/sem_expr.c:453
proc eh_logico(op: u8) -> bool {
    return (op == (frontend.OP_E as u8)) or (op == (frontend.OP_OU as u8))
}

// C: semantic/sem_expr.c:454
proc eh_comparacao(op: u8) -> bool {
    return ((op as i32) >= frontend.OP_IGUAL) and ((op as i32) <= frontend.OP_MAIOR_IGUAL)
}

// C: semantic/sem_expr.c:457
proc contexto_do_literal(s: ^Semantica, outro: u32, op: u8) -> u32 {
    if (common.c2f_b2i32(s.tipos.tem_matriz) != 0) and (common.c2f_s2u_32(tipo_classe_de(&s.tipos, outro)) == (TC_MATRIZ as u32)) {
        return tipo_de(&s.tipos, outro).a
    }
    if sem_eh_quat(s, outro) {
        return TIPO_F32 as u32
    }
    if common.c2f_s2u_32(tipo_classe_de(&s.tipos, outro)) == (TC_ARRAY as u32) {
        return contexto_do_literal(s, tipo_de(&s.tipos, outro).a, op)
    }
    let produto: bool = (op == (frontend.OP_MUL as u8)) or (op == (frontend.OP_DIV as u8))
    var tern_1: u32 = outro
    if (common.c2f_s2u_32(tipo_classe_de(&s.tipos, outro)) == (TC_REAL as u32)) and (common.c2f_b2i32(produto) != 0) {
        tern_1 = TIPO_F32 as u32
    }
    return tern_1
}

// C: semantic/sem_expr.c:468
proc operandos_do_binario(s: ^Semantica, e: ^frontend.Expr, ctx: u32) -> bool {
    let a: ?^frontend.Expr = e.a
    let b: ?^frontend.Expr = e.b
    var tern_1: u32 = TIPO_VAZIO as u32
    if (common.c2f_b2i32(eh_aritmetico(e.op)) != 0) or (common.c2f_b2i32(eh_bits(e.op)) != 0) {
        tern_1 = ctx
    }
    let ctx_operando: u32 = tern_1
    if eh_logico(e.op) {
        return (common.c2f_b2i32(sem_checar(s, a, TIPO_BOOL as u32)) != 0) and (common.c2f_b2i32(sem_checar(s, b, TIPO_BOOL as u32)) != 0)
    }
    if ((a as ^frontend.Expr).tipo_no == (frontend.EX_NONE as u8)) and ((b as ^frontend.Expr).tipo_no != (frontend.EX_NONE as u8)) {
        return (common.c2f_b2i32(sem_checar(s, b, ctx_operando)) != 0) and (common.c2f_b2i32(sem_checar(s, a, (b as ^frontend.Expr).tipo)) != 0)
    }
    if (common.c2f_b2i32((a as ^frontend.Expr).flexivel) != 0) and (not (b as ^frontend.Expr).flexivel) {
        return (common.c2f_b2i32(sem_checar(s, b, ctx_operando)) != 0) and (common.c2f_b2i32(sem_checar(s, a, contexto_do_literal(s, (b as ^frontend.Expr).tipo, e.op))) != 0)
    }
    if not sem_checar(s, a, ctx_operando) {
        return false
    }
    if (b as ^frontend.Expr).tipo_no == (frontend.EX_NONE as u8) {
        return sem_checar(s, b, (a as ^frontend.Expr).tipo)
    }
    var tern_2: u32 = ctx_operando
    if common.c2f_b2i32((b as ^frontend.Expr).flexivel) != 0 {
        tern_2 = contexto_do_literal(s, (a as ^frontend.Expr).tipo, e.op)
    }
    return sem_checar(s, b, tern_2)
}

// C: semantic/sem_expr.c:484
proc aplicar_logica(s: ^Semantica, e: ^frontend.Expr) -> bool {
    if ((e.a as ^frontend.Expr).tipo != (TIPO_BOOL as u32)) or ((e.b as ^frontend.Expr).tipo != (TIPO_BOOL as u32)) {
        let msg_1 = format(f"'and' e 'or' pedem operandos bool", alloc = heap)
        defer delete(msg_1)
        return sem_erro(s, common.E0301, e.pos_op, msg_1)
    }
    e.tipo = TIPO_BOOL as u32
    return true
}

// C: semantic/sem_expr.c:494
proc classe_comparavel(c: i32) -> bool {
    return (((((((((common.c2f_s2u_32(c) == (TC_BOOL as u32)) or (common.c2f_s2u_32(c) == (TC_I32 as u32))) or (common.c2f_s2u_32(c) == (TC_INT as u32))) or (common.c2f_s2u_32(c) == (TC_REAL as u32))) or (common.c2f_s2u_32(c) == (TC_ENUM as u32))) or ((common.c2f_s2u_32(c) >= (TC_I8 as u32)) and (common.c2f_s2u_32(c) <= (TC_F64 as u32)))) or (common.c2f_s2u_32(c) == (TC_PONTEIRO as u32))) or (common.c2f_s2u_32(c) == (TC_ANULAVEL as u32))) or (common.c2f_s2u_32(c) == (TC_RAWPTR as u32))) or (common.c2f_s2u_32(c) == (TC_TEXTO as u32))
}

// C: semantic/sem_expr.c:500
proc eh_ordem(op: u8) -> bool {
    return ((op as i32) >= frontend.OP_MENOR) and ((op as i32) <= frontend.OP_MAIOR_IGUAL)
}

// C: semantic/sem_expr.c:503
proc comparacao_valida(s: ^Semantica, e: ^frontend.Expr) -> bool {
    let ca: i32 = tipo_classe_de(&s.tipos, (e.a as ^frontend.Expr).tipo)
    let cb: i32 = tipo_classe_de(&s.tipos, (e.b as ^frontend.Expr).tipo)
    if common.c2f_s2u_32(ca) != common.c2f_s2u_32(cb) {
        return (((common.c2f_b2i32(eh_ponteiro_ou_anulavel(ca)) != 0) and (common.c2f_b2i32(eh_ponteiro_ou_anulavel(cb)) != 0)) and (not eh_ordem(e.op))) and (tipo_de(&s.tipos, (e.a as ^frontend.Expr).tipo).a == tipo_de(&s.tipos, (e.b as ^frontend.Expr).tipo).a)
    }
    if not classe_comparavel(ca) {
        return false
    }
    if ((common.c2f_s2u_32(ca) == (TC_ENUM as u32)) or (common.c2f_s2u_32(ca) == (TC_PONTEIRO as u32))) or (common.c2f_s2u_32(ca) == (TC_ANULAVEL as u32)) {
        return ((e.a as ^frontend.Expr).tipo == (e.b as ^frontend.Expr).tipo) and (not eh_ordem(e.op))
    }
    return ((common.c2f_s2u_32(ca) != (TC_RAWPTR as u32)) and (common.c2f_s2u_32(ca) != (TC_TEXTO as u32))) or (not eh_ordem(e.op))
}

// C: semantic/sem_expr.c:516
proc erro_de_operandos(s: ^Semantica, e: ^frontend.Expr, causa: str) -> bool {
    let msg_1 = format(f"{causa}", alloc = heap)
    defer delete(msg_1)
    _ = sem_erro(s, common.E0301, e.pos_op, msg_1)
    sem_forma_operandos(s, e)
    return false
}

// C: semantic/sem_expr.c:523
proc erro_de_comparacao(s: ^Semantica, e: ^frontend.Expr) -> bool {
    if (common.c2f_b2i32(eh_lista(s, (e.a as ^frontend.Expr).tipo)) != 0) or (common.c2f_b2i32(eh_lista(s, (e.b as ^frontend.Expr).tipo)) != 0) {
        let msg_1 = format(f"lista nao tem ==, != nem ordem nem conta: compare elemento a elemento num for", alloc = heap)
        defer delete(msg_1)
        return sem_erro(s, common.E0308, e.pos_op, msg_1)
    }
    if (common.c2f_b2i32(eh_colecao(s, (e.a as ^frontend.Expr).tipo)) != 0) or (common.c2f_b2i32(eh_colecao(s, (e.b as ^frontend.Expr).tipo)) != 0) {
        let msg_2 = format(f"array e fatia nao tem ==, != nem ordem: compare elemento a elemento num for", alloc = heap)
        defer delete(msg_2)
        return sem_erro(s, common.E0308, e.pos_op, msg_2)
    }
    if (common.c2f_b2i32(eh_ordem(e.op)) != 0) and ((common.c2f_b2i32(tipo_eh_familia_ponteiro(&s.tipos, (e.a as ^frontend.Expr).tipo)) != 0) or (common.c2f_b2i32(tipo_eh_familia_ponteiro(&s.tipos, (e.b as ^frontend.Expr).tipo)) != 0)) {
        let msg_3 = format(f"ponteiro nao tem ordem; so == e !=", alloc = heap)
        defer delete(msg_3)
        return sem_erro(s, common.E0306, e.pos_op, msg_3)
    }
    if (common.c2f_b2i32(eh_ordem(e.op)) != 0) and (((e.a as ^frontend.Expr).tipo == (TIPO_TEXTO as u32)) or ((e.b as ^frontend.Expr).tipo == (TIPO_TEXTO as u32))) {
        let msg_4 = format(f"str nao tem ordem nesta versao; so == e !=", alloc = heap)
        defer delete(msg_4)
        return sem_erro(s, common.E0307, e.pos_op, msg_4)
    }
    if ((e.a as ^frontend.Expr).tipo == (TIPO_CSTR as u32)) or ((e.b as ^frontend.Expr).tipo == (TIPO_CSTR as u32)) {
        let msg_5 = format(f"== em cstr compararia enderecos: compare como str, (a as str) == (b as str)", alloc = heap)
        defer delete(msg_5)
        return sem_erro(s, common.E0307, e.pos_op, msg_5)
    }
    return erro_de_operandos(s, e, "comparacao entre tipos incompativeis")
}

// C: semantic/sem_expr.c:545
proc comparacao_com_none(s: ^Semantica, e: ^frontend.Expr) -> bool {
    let com_none: bool = ((e.b as ^frontend.Expr).tipo_no == (frontend.EX_NONE as u8)) or ((e.a as ^frontend.Expr).tipo_no == (frontend.EX_NONE as u8))
    if (not com_none) or ((e.op != (frontend.OP_IGUAL as u8)) and (e.op != (frontend.OP_DIFERENTE as u8))) {
        let msg_1 = format(f"?T so se compara com none (x == none, x != none); para o valor use switch ou or_else", alloc = heap)
        defer delete(msg_1)
        return sem_erro(s, common.E0312, e.pos_op, msg_1)
    }
    var tern_1: ?^frontend.Expr = e.b
    if (e.b as ^frontend.Expr).tipo_no == (frontend.EX_NONE as u8) {
        tern_1 = e.a
    }
    let valor: ?^frontend.Expr = tern_1
    var tern_2: i32 = 0
    if e.op == (frontend.OP_IGUAL as u8) {
        tern_2 = 1
    }
    e.op = tern_2 as u8
    e.tipo_no = frontend.EX_OPC_TESTE as u8
    e.a = valor
    e.b = none
    e.tipo = TIPO_BOOL as u32
    return true
}

// C: semantic/sem_expr.c:561
proc comparacao_rara(s: ^Semantica, e: ^frontend.Expr) -> bool {
    let ca: i32 = tipo_classe_de(&s.tipos, (e.a as ^frontend.Expr).tipo)
    let cb: i32 = tipo_classe_de(&s.tipos, (e.b as ^frontend.Expr).tipo)
    if (common.c2f_b2i32(sem_eh_quat(s, (e.a as ^frontend.Expr).tipo)) != 0) or (common.c2f_b2i32(sem_eh_quat(s, (e.b as ^frontend.Expr).tipo)) != 0) {
        return sem_comparacao_quat(s, e)
    }
    if (common.c2f_s2u_32(ca) >= (TC_MAPA as u32)) or (common.c2f_s2u_32(cb) >= (TC_MAPA as u32)) {
        return sem_comparacao_v19(s, e)
    }
    if (common.c2f_s2u_32(ca) == (TC_OPCIONAL as u32)) or (common.c2f_s2u_32(cb) == (TC_OPCIONAL as u32)) {
        return comparacao_com_none(s, e)
    }
    if (common.c2f_s2u_32(ca) == (TC_UNIAO as u32)) or (common.c2f_s2u_32(cb) == (TC_UNIAO as u32)) {
        let msg_1 = format(f"union nao tem ==: compare a variante com switch", alloc = heap)
        defer delete(msg_1)
        return sem_erro(s, common.E0313, e.pos_op, msg_1)
    }
    return erro_de_comparacao(s, e)
}

// C: semantic/sem_expr.c:573
proc aplicar_comparacao(s: ^Semantica, e: ^frontend.Expr) -> bool {
    let ta: u32 = (e.a as ^frontend.Expr).tipo
    let tb: u32 = (e.b as ^frontend.Expr).tipo
    if not comparacao_valida(s, e) {
        return comparacao_rara(s, e)
    }
    if (common.c2f_s2u_32(tipo_classe_de(&s.tipos, ta)) == (TC_REAL as u32)) and (ta != tb) {
        let msg_1 = format(f"comparacao entre dimensoes diferentes", alloc = heap)
        defer delete(msg_1)
        return sem_erro(s, common.E0412, e.pos_op, msg_1)
    }
    if (common.c2f_b2i32(eh_ordem(e.op)) != 0) and (not tipo_eh_numerico(&s.tipos, ta)) {
        let msg_2 = format(f"a ordem (<, <=, >, >=) pede numero", alloc = heap)
        defer delete(msg_2)
        return sem_erro(s, common.E0301, e.pos_op, msg_2)
    }
    e.tipo = TIPO_BOOL as u32
    return true
}

// C: semantic/sem_expr.c:587
proc aritmetica_real(s: ^Semantica, e: ^frontend.Expr, ta: u32, tb: u32) -> bool {
    if e.op == (frontend.OP_RESTO as u8) {
        let msg_1 = format(f"'%' so vale para inteiros", alloc = heap)
        defer delete(msg_1)
        return sem_erro(s, common.E0301, e.pos_op, msg_1)
    }
    if (e.op == (frontend.OP_SOMA as u8)) or (e.op == (frontend.OP_SUB as u8)) {
        if ta != tb {
            let msg_2 = format(f"soma ou subtracao entre dimensoes diferentes", alloc = heap)
            defer delete(msg_2)
            return sem_erro(s, common.E0412, e.pos_op, msg_2)
        }
        e.tipo = ta
        return true
    }
    var sinal: i32 = -1
    if e.op == (frontend.OP_MUL as u8) {
        sinal = 1
    }
    let dim: u32 = dim_combinar(&s.dims, tipo_de(&s.tipos, ta).a, tipo_de(&s.tipos, tb).a, sinal)
    if not dim_declarada(&s.dims, dim) {
        let msg_3 = format(f"a dimensao do resultado nao tem unidade declarada", alloc = heap)
        defer delete(msg_3)
        return sem_erro(s, common.E0412, e.pos_op, msg_3)
    }
    e.tipo = tipo_real(&s.tipos, dim)
    return true
}

// C: semantic/sem_expr.c:604
proc erro_conta_de_colecao(s: ^Semantica, e: ^frontend.Expr) -> bool {
    let msg_1 = format(f"bits (& | ~ << >>) nao existem em array, fatia nem lista: a conta elemento a elemento tem + - * /; use for", alloc = heap)
    defer delete(msg_1)
    return sem_erro(s, common.E0331, e.pos_op, msg_1)
}

// C: semantic/sem_expr.c:610
proc conta_de_opcional(s: ^Semantica, ta: u32, tb: u32) -> bool {
    let ca: i32 = tipo_classe_de(&s.tipos, ta)
    let cb: i32 = tipo_classe_de(&s.tipos, tb)
    return (((common.c2f_s2u_32(ca) == (TC_OPCIONAL as u32)) or (common.c2f_s2u_32(cb) == (TC_OPCIONAL as u32))) or (common.c2f_s2u_32(ca) == (TC_UNIAO as u32))) or (common.c2f_s2u_32(cb) == (TC_UNIAO as u32))
}

// C: semantic/sem_expr.c:616
proc erro_conta_de_opcional(s: ^Semantica, e: ^frontend.Expr) -> bool {
    if (common.c2f_s2u_32(tipo_classe_de(&s.tipos, (e.a as ^frontend.Expr).tipo)) == (TC_UNIAO as u32)) or (common.c2f_s2u_32(tipo_classe_de(&s.tipos, (e.b as ^frontend.Expr).tipo)) == (TC_UNIAO as u32)) {
        let msg_1 = format(f"union nao faz conta: leia a variante com switch", alloc = heap)
        defer delete(msg_1)
        return sem_erro(s, common.E0313, e.pos_op, msg_1)
    }
    let msg_2 = format(f"?T nao faz conta: desembrulhe antes (x or_else 0)", alloc = heap)
    defer delete(msg_2)
    return sem_erro(s, common.E0312, e.pos_op, msg_2)
}

// C: semantic/sem_expr.c:625
proc eh_conta_de_ponteiro(s: ^Semantica, ta: u32, tb: u32) -> bool {
    return (((common.c2f_b2i32(tipo_eh_familia_ponteiro(&s.tipos, ta)) != 0) or (common.c2f_b2i32(tipo_eh_familia_ponteiro(&s.tipos, tb)) != 0)) or (ta == (TIPO_TEXTO as u32))) or (tb == (TIPO_TEXTO as u32))
}

// C: semantic/sem_expr.c:630
proc erro_conta_de_ponteiro(s: ^Semantica, e: ^frontend.Expr) -> bool {
    let dois_textos: bool = ((e.op == (frontend.OP_SOMA as u8)) and (((e.a as ^frontend.Expr).tipo_no == (frontend.EX_TEXTO as u8)) or ((e.a as ^frontend.Expr).tipo == (TIPO_TEXTO as u32)))) and (((e.b as ^frontend.Expr).tipo_no == (frontend.EX_TEXTO as u8)) or ((e.b as ^frontend.Expr).tipo == (TIPO_TEXTO as u32)))
    if (common.c2f_b2i32(dois_textos) != 0) or ((not tipo_eh_familia_ponteiro(&s.tipos, (e.a as ^frontend.Expr).tipo)) and (not tipo_eh_familia_ponteiro(&s.tipos, (e.b as ^frontend.Expr).tipo))) {
        let msg_1 = format(f"str nao se soma nem faz conta; concatenar precisa alocar (format, v1.6/v1.7)", alloc = heap)
        defer delete(msg_1)
        _ = sem_erro(s, common.E0307, e.pos_op, msg_1)
        sem_sugerir_concatenar(s, e)
        return false
    }
    let msg_2 = format(f"ponteiro nao tem conta (sem aritmetica de ponteiro); para andar numa sequencia use fatia e indice (v1.5)", alloc = heap)
    defer delete(msg_2)
    _ = sem_erro(s, common.E0306, e.pos_op, msg_2)
    sem_forma_conta_de_texto(s, e)
    return false
}

// C: semantic/sem_expr.c:644
proc sem_aritmetica(s: ^Semantica, e: ^frontend.Expr) -> bool {
    let ta: u32 = (e.a as ^frontend.Expr).tipo
    let tb: u32 = (e.b as ^frontend.Expr).tipo
    let real_a: bool = common.c2f_s2u_32(tipo_classe_de(&s.tipos, ta)) == (TC_REAL as u32)
    let real_b: bool = common.c2f_s2u_32(tipo_classe_de(&s.tipos, tb)) == (TC_REAL as u32)
    if (common.c2f_b2i32(real_a) != 0) and (common.c2f_b2i32(real_b) != 0) {
        return aritmetica_real(s, e, ta, tb)
    }
    if (ta == (TIPO_F64 as u32)) and (tb == (TIPO_F64 as u32)) {
        if e.op == (frontend.OP_RESTO as u8) {
            let msg_1 = format(f"'%' so vale para inteiros", alloc = heap)
            defer delete(msg_1)
            return sem_erro(s, common.E0301, e.pos_op, msg_1)
        }
        e.tipo = TIPO_F64 as u32
        return true
    }
    if (ta != tb) or (not tipo_eh_inteiro(ta)) {
        if (common.c2f_b2i32(tipos_tem_v19(&s.tipos)) != 0) and ((common.c2f_s2u_32(tipo_classe_de(&s.tipos, ta)) >= (TC_MAPA as u32)) or (common.c2f_s2u_32(tipo_classe_de(&s.tipos, tb)) >= (TC_MAPA as u32))) {
            return sem_conta_v19(s, e)
        }
        if (common.c2f_b2i32(sem_eh_quat(s, ta)) != 0) or (common.c2f_b2i32(sem_eh_quat(s, tb)) != 0) {
            return sem_conta_quat(s, e)
        }
        if conta_de_opcional(s, ta, tb) {
            return erro_conta_de_opcional(s, e)
        }
        if (common.c2f_b2i32(eh_colecao(s, ta)) != 0) or (common.c2f_b2i32(eh_colecao(s, tb)) != 0) {
            return sem_conta_vetor(s, e)
        }
        if eh_conta_de_ponteiro(s, ta, tb) {
            return erro_conta_de_ponteiro(s, e)
        }
        return erro_de_operandos(s, e, "operandos numericos de tipos diferentes")
    }
    e.tipo = ta
    return true
}

// C: semantic/sem_expr.c:669
proc aplicar_bits(s: ^Semantica, e: ^frontend.Expr) -> bool {
    let ta: u32 = (e.a as ^frontend.Expr).tipo
    let tb: u32 = (e.b as ^frontend.Expr).tipo
    if (ta != tb) or (not tipo_eh_sem_sinal(ta)) {
        if (common.c2f_b2i32(tipos_tem_v19(&s.tipos)) != 0) and ((common.c2f_s2u_32(tipo_classe_de(&s.tipos, ta)) >= (TC_MAPA as u32)) or (common.c2f_s2u_32(tipo_classe_de(&s.tipos, tb)) >= (TC_MAPA as u32))) {
            return sem_conta_v19(s, e)
        }
        if conta_de_opcional(s, ta, tb) {
            return erro_conta_de_opcional(s, e)
        }
        if (common.c2f_b2i32(eh_colecao(s, ta)) != 0) or (common.c2f_b2i32(eh_colecao(s, tb)) != 0) {
            return erro_conta_de_colecao(s, e)
        }
        if eh_conta_de_ponteiro(s, ta, tb) {
            return erro_conta_de_ponteiro(s, e)
        }
        if ta != tb {
            return erro_de_operandos(s, e, "operandos de bits de tipos diferentes")
        }
    }
    if not tipo_eh_sem_sinal(ta) {
        let msg_1 = format(f"operador de bits em tipo que nao e inteiro sem sinal", alloc = heap)
        defer delete(msg_1)
        return sem_erro(s, common.E0303, e.pos_op, msg_1)
    }
    e.tipo = ta
    return true
}

// C: semantic/sem_expr.c:686
proc ex_binario_2(s: ^Semantica, e: ^frontend.Expr, ctx: u32) -> bool {
    if not operandos_do_binario(s, e, sem_ctx_sem_opcional(s, ctx)) {
        return false
    }
    if eh_logico(e.op) {
        return aplicar_logica(s, e)
    }
    if eh_bits(e.op) {
        return aplicar_bits(s, e)
    }
    if eh_comparacao(e.op) {
        return aplicar_comparacao(s, e)
    }
    return sem_aritmetica(s, e)
}

