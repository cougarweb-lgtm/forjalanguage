// C: semantic/sem_expr.c:173
proc ex_membro(s: ^Semantica, e: ^frontend.Expr) -> bool {
    let base: ^frontend.Expr = e.a as ^frontend.Expr
    let y: ^Simbolo = sem_achar_simbolo(s, base.nome, base.modulo)
    var pos_uso: u32 = base.pos
    if base.modulo != 0 {
        pos_uso = base.pos_op
    }
    var uso: NomeUsado = NomeUsado{nome = base.nome, pos = pos_uso, modulo = base.modulo}
    if not sem_visivel(s, y, &uso) {
        return false
    }
    if sem_simbolo_veneno(y) { // L8: enum com erro: os membros dele nao sao conferidos
        base.tipo = TIPO_VENENO as u32
        e.tipo = TIPO_VENENO as u32
        return true
    }
    let idx: i32 = sem_achar_membro(s, y.decl, e.nome, e.pos_op)
    if idx < 0 {
        return sem_membro_ausente(s, e, y.decl, idx)
    }
    base.ref = frontend.REF_ENUM as u8
    base.ref_id = y.indice
    base.tipo = y.tipo
    e.ref = frontend.REF_MEMBRO as u8
    e.ref_id = idx
    e.tipo = y.tipo
    return true
}

