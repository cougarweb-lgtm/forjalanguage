import "common"
import "frontend"

// C: semantic/sem_lista_busca.c:26
proc array_enderecavel(v: ?^frontend.Expr) -> bool {
    return ((((v as ^frontend.Expr).tipo_no == (frontend.EX_NOME as u8)) or ((v as ^frontend.Expr).tipo_no == (frontend.EX_CAMPO as u8))) or ((v as ^frontend.Expr).tipo_no == (frontend.EX_INDICE as u8))) or (((v as ^frontend.Expr).tipo_no == (frontend.EX_UNARIO as u8)) and ((v as ^frontend.Expr).op == (frontend.OP_DEREF as u8)))
}

// C: semantic/sem_lista_busca.c:32
proc fatia_inteira(s: ^Semantica, base: ?^frontend.Expr, elemento: u32) -> ^frontend.Expr {
    let fatia: ^frontend.Expr = s4_novo_expr(s)
    fatia.tipo_no = frontend.EX_FATIA as u8
    fatia.op = frontend.FATIA_INTEIRA as u8
    fatia.a = base
    fatia.pos = (base as ^frontend.Expr).pos
    fatia.pos_op = (base as ^frontend.Expr).pos_op
    fatia.tipo = tipo_fatia(&s.tipos, elemento)
    return fatia
}

// C: semantic/sem_lista_busca.c:45
proc sem_colecao_ja_checada(s: ^Semantica, e: ^frontend.Expr, k: i32, alteracao: bool, elemento: ^u32) -> bool {
    var forma: i32 = 0
    let arg: ^frontend.Arg = argumento_do_parametro(e, k) as ^frontend.Arg
    let v: ?^frontend.Expr = arg.valor
    elemento^ = sem_elemento_de(s, (v as ^frontend.Expr).tipo, &forma)
    let quem = sem_nome_texto(s, e.nome)
    if forma == FORMA_NENHUMA {
        let texto = s4_descrever(s, (v as ^frontend.Expr).tipo)
        defer delete(texto)
        let msg_1 = format(f"{quem} pede lista, array ou fatia (tipo {texto})", alloc = heap)
        defer delete(msg_1)
        return sem_erro(s, common.E0310, (v as ^frontend.Expr).pos, msg_1)
    }
    if forma == FORMA_FATIA {
        return true
    }
    // C2F-32: snprintf(motivo, 96, ...) corta em 95 bytes
    let motivo_inteiro = format(f"{quem} altera os elementos: declare com var", alloc = heap)
    defer delete(motivo_inteiro)
    let motivo = motivo_inteiro[0..<min(len(motivo_inteiro), 95)]
    if alteracao and ((forma == FORMA_ARRAY) or (forma == FORMA_DINAMICO)) and (not sem_lvalor_mutavel_de(s, v, motivo)) {
        return false
    }
    if (forma == FORMA_ARRAY) and (not array_enderecavel(v)) {
        let msg_2 = format(f"{quem} precisa de um array que seja variavel, campo ou elemento (nao um valor temporario)", alloc = heap)
        defer delete(msg_2)
        return sem_erro(s, common.E0310, (v as ^frontend.Expr).pos, msg_2)
    }
    arg.valor = fatia_inteira(s, v, elemento^)
    return true
}

// C: semantic/sem_lista_busca.c:67
proc colecao_do_argumento(s: ^Semantica, e: ^frontend.Expr, k: i32, alteracao: bool, elemento: ^u32) -> bool {
    return (common.c2f_b2i32(sem_checar(s, (argumento_do_parametro(e, k) as ^frontend.Arg).valor, TIPO_VAZIO as u32)) != 0) and (common.c2f_b2i32(sem_colecao_ja_checada(s, e, k, alteracao, elemento)) != 0)
}

// C: semantic/sem_lista_busca.c:73
proc chamar_procura(s: ^Semantica, e: ^frontend.Expr, embutido: i32) -> bool {
    var elemento: u32 = 0
    if (not sem_ligar_embutido(s, e, s.params_lista[(ASS_COLECAO_VALOR as int)..<((ASS_COLECAO_VALOR as int) + 2)])) or (not sem_checar(s, (argumento_do_parametro(e, 0) as ^frontend.Arg).valor, TIPO_VAZIO as u32)) {
        return false
    }
    if ((argumento_do_parametro(e, 0) as ^frontend.Arg).valor as ^frontend.Expr).tipo == (TIPO_STR as u32) {
        return sem_chamar_busca_texto(s, e, embutido)
    }
    if not sem_colecao_ja_checada(s, e, 0, false, &elemento) {
        return false
    }
    if (not sem_lista_comparavel(s, e, elemento)) or (not sem_lista_valor_do_elemento(s, (argumento_do_parametro(e, 1) as ^frontend.Arg).valor, elemento)) {
        return false
    }
    if embutido == frontend.EMB_CONTAINS {
        e.tipo = TIPO_BOOL as u32
    } else if embutido == frontend.EMB_COUNT {
        e.tipo = TIPO_INT as u32
    } else {
        e.tipo = tipo_opcional(&s.tipos, TIPO_INT as u32)
    }
    return true
}

// C: semantic/sem_lista_busca.c:87
proc chamar_copy(s: ^Semantica, e: ^frontend.Expr) -> bool {
    var destino: u32 = 0
    var origem: u32 = 0
    if not sem_ligar_embutido(s, e, s.params_lista[(ASS_COPY as int)..<((ASS_COPY as int) + 2)]) {
        return false
    }
    if (not colecao_do_argumento(s, e, 0, true, &destino)) or (not colecao_do_argumento(s, e, 1, false, &origem)) {
        return false
    }
    if destino != origem {
        let a = s4_descrever(s, destino)
        defer delete(a)
        let b = s4_descrever(s, origem)
        defer delete(b)
        let msg_1 = format(f"copy pede o mesmo tipo de elemento nos dois: {a} e {b}", alloc = heap)
        defer delete(msg_1)
        return sem_erro(s, common.E0301, ((argumento_do_parametro(e, 1) as ^frontend.Arg).valor as ^frontend.Expr).pos, msg_1)
    }
    if not sem_lista_sem_dono(s, e, destino, "duplicaria") {
        return false
    }
    e.tipo = TIPO_INT as u32
    return true
}

// C: semantic/sem_lista_busca.c:104
proc chamar_fill(s: ^Semantica, e: ^frontend.Expr) -> bool {
    var elemento: u32 = 0
    if (not sem_ligar_embutido(s, e, s.params_lista[(ASS_COLECAO_VALOR as int)..<((ASS_COLECAO_VALOR as int) + 2)])) or (not colecao_do_argumento(s, e, 0, true, &elemento)) {
        return false
    }
    if (not sem_lista_sem_dono(s, e, elemento, "duplicaria")) or (not sem_lista_valor_do_elemento(s, (argumento_do_parametro(e, 1) as ^frontend.Arg).valor, elemento)) {
        return false
    }
    e.tipo = TIPO_VAZIO as u32
    return true
}

// C: semantic/sem_lista_busca.c:114
proc chamar_clone(s: ^Semantica, e: ^frontend.Expr) -> bool {
    var elemento: u32 = 0
    if not sem_ligar_embutido(s, e, s.params_lista[(ASS_CLONE as int)..<((ASS_CLONE as int) + 2)]) {
        return false
    }
    let alvo: ?^frontend.Expr = (argumento_do_parametro(e, 0) as ^frontend.Arg).valor
    if not sem_checar(s, alvo, TIPO_VAZIO as u32) {
        return false
    }
    if (alvo as ^frontend.Expr).tipo == (TIPO_STR as u32) {
        return sem_chamar_clone_texto(s, e)
    }
    if not sem_colecao_ja_checada(s, e, 0, false, &elemento) {
        return false
    }
    if (not sem_lista_sem_dono(s, e, elemento, "duplicaria")) or (not sem_conferir_alocador(s, e, argumento_do_parametro(e, 1))) {
        return false
    }
    e.tipo = tipo_dinamico(&s.tipos, elemento)
    return true
}

// C: semantic/sem_lista_busca.c:128
proc chamar_swap(s: ^Semantica, e: ^frontend.Expr) -> bool {
    var elemento: u32 = 0
    if (not sem_ligar_embutido(s, e, s.params_lista[(ASS_SWAP as int)..<((ASS_SWAP as int) + 3)])) or (not colecao_do_argumento(s, e, 0, true, &elemento)) {
        return false
    }
    if (not sem_lista_inteiro(s, (argumento_do_parametro(e, 1) as ^frontend.Arg).valor, "o indice")) or (not sem_lista_inteiro(s, (argumento_do_parametro(e, 2) as ^frontend.Arg).valor, "o indice")) {
        return false
    }
    e.tipo = TIPO_VAZIO as u32
    return true
}

// C: semantic/sem_lista_busca.c:138
proc chamar_reverse(s: ^Semantica, e: ^frontend.Expr) -> bool {
    var elemento: u32 = 0
    if not sem_ligar_embutido(s, e, s.params_lista[(ASS_COLECAO_ALLOC as int)..<((ASS_COLECAO_ALLOC as int) + 2)]) {
        return false
    }
    let alvo: ?^frontend.Expr = (argumento_do_parametro(e, 0) as ^frontend.Arg).valor
    if not sem_checar(s, alvo, TIPO_VAZIO as u32) {
        return false
    }
    if (alvo as ^frontend.Expr).tipo == (TIPO_STR as u32) {
        return sem_chamar_reverse_texto(s, e)
    }
    if argumento_do_parametro(e, 1) != none {
        let msg_1 = format(f"sobra argumento: reverse de lista, array ou fatia so leva a colecao (alloc so existe em str)", alloc = heap)
        defer delete(msg_1)
        return sem_erro(s, common.E0502, ((argumento_do_parametro(e, 1) as ^frontend.Arg).valor as ^frontend.Expr).pos, msg_1)
    }
    if not sem_colecao_ja_checada(s, e, 0, true, &elemento) {
        return false
    }
    e.tipo = TIPO_VAZIO as u32
    return true
}

// C: semantic/sem_lista_busca.c:152
proc chamar_replace(s: ^Semantica, e: ^frontend.Expr) -> bool {
    var elemento: u32 = 0
    if (not sem_ligar_embutido(s, e, s.params_lista[(ASS_REPLACE as int)..<((ASS_REPLACE as int) + 4)])) or (not colecao_do_argumento(s, e, 0, true, &elemento)) {
        return false
    }
    if not sem_lista_comparavel(s, e, elemento) {
        return false
    }
    if (not sem_lista_valor_do_elemento(s, (argumento_do_parametro(e, 1) as ^frontend.Arg).valor, elemento)) or (not sem_lista_valor_do_elemento(s, (argumento_do_parametro(e, 2) as ^frontend.Arg).valor, elemento)) {
        return false
    }
    let n: ?^frontend.Arg = argumento_do_parametro(e, 3)
    if (n != none) and (not sem_lista_inteiro(s, (n as ^frontend.Arg).valor, "n")) {
        return false
    }
    e.tipo = TIPO_VAZIO as u32
    return true
}

// C: semantic/sem_lista_busca.c:164
proc sem_chamar_busca(s: ^Semantica, e: ^frontend.Expr, embutido: i32) -> bool {
    if embutido == frontend.EMB_INDEX_OF or embutido == frontend.EMB_LAST_INDEX_OF or embutido == frontend.EMB_CONTAINS or embutido == frontend.EMB_COUNT {
        return chamar_procura(s, e, embutido)
    } else if embutido == frontend.EMB_COPY {
        return chamar_copy(s, e)
    } else if embutido == frontend.EMB_FILL {
        return chamar_fill(s, e)
    } else if embutido == frontend.EMB_CLONE {
        return chamar_clone(s, e)
    } else if embutido == frontend.EMB_SWAP {
        return chamar_swap(s, e)
    } else if embutido == frontend.EMB_REVERSE {
        return chamar_reverse(s, e)
    } else if embutido == frontend.EMB_REPLACE_VALUE {
        return chamar_replace(s, e)
    } else {
        let msg_1 = format(f"SemChamarBusca: embutido {embutido} desconhecido", alloc = heap)
        defer delete(msg_1)
        common.falha_interna(msg_1)
    }
    return false
}
