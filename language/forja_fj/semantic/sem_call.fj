pub const CHAMAR_EXATO_SEM_CHAMAR_CHOICE: u16 = 30
pub proc chamar_chamar_exato(tag: u16, s: ^Semantica, e: ^frontend.Expr) -> bool {
    if tag == 1 {
        return chamar_print(s, e)
    }
    if tag == 2 {
        return chamar_eprint(s, e)
    }
    if tag == 3 {
        return chamar_len(s, e)
    }
    if tag == 4 {
        return chamar_assert(s, e)
    }
    if tag == 5 {
        return chamar_panic(s, e)
    }
    if tag == 6 {
        return chamar_transmute(s, e)
    }
    if tag == 7 {
        return chamar_static_assert(s, e)
    }
    if tag == 8 {
        return sem_chamar_formato(s, e)
    }
    if tag == 9 {
        return sem_chamar_dedup(s, e)
    }
    if tag == 10 {
        return sem_chamar_heap_push(s, e)
    }
    if tag == 11 {
        return sem_chamar_heap_push_by(s, e)
    }
    if tag == 12 {
        return sem_chamar_heap_pop(s, e)
    }
    if tag == 13 {
        return sem_chamar_heap_pop_by(s, e)
    }
    if tag == 14 {
        return sem_chamar_index_by(s, e)
    }
    if tag == 15 {
        return sem_chamar_find_by(s, e)
    }
    if tag == 16 {
        return sem_chamar_any_by(s, e)
    }
    if tag == 17 {
        return sem_chamar_all_by(s, e)
    }
    if tag == 18 {
        return sem_chamar_count_by(s, e)
    }
    if tag == 19 {
        return sem_chamar_set_union(s, e)
    }
    if tag == 20 {
        return sem_chamar_set_intersect(s, e)
    }
    if tag == 21 {
        return sem_chamar_set_diff(s, e)
    }
    if tag == 22 {
        return sem_chamar_resize(s, e)
    }
    if tag == 23 {
        return sem_chamar_sort(s, e)
    }
    if tag == 24 {
        return sem_chamar_sort_by(s, e)
    }
    if tag == 25 {
        return sem_chamar_sort_by_key(s, e)
    }
    if tag == 26 {
        return sem_chamar_binary_search(s, e)
    }
    if tag == 27 {
        return sem_chamar_slice_from(s, e)
    }
    if tag == 28 {
        return sem_chamar_conj(s, e)
    }
    if tag == 29 {
        return sem_chamar_shuffle(s, e)
    }
    if tag == 30 {
        return sem_chamar_choice(s, e)
    }
    return false // tag 0 = entrada NULL da tabela EXATOS: o chamador (chamar_embutido) nunca chega aqui com ela
}

// C: EXATOS[embutido] (sem_call.c:392): id do embutido -> tag CHAMAR_EXATO_*; 0 = sem tratador proprio (o C tem NULL ou indice fora da tabela de 97 entradas).
// LIMITE: cognitiva - despacho por tabela (cadeia if, 1 linha por entrada; a tabela const nao referencia const: E0301)
proc tag_exato(embutido: i32) -> u16 {
    if embutido == frontend.EMB_PRINT {
        return CHAMAR_EXATO_CHAMAR_PRINT
    }
    if embutido == frontend.EMB_EPRINT {
        return CHAMAR_EXATO_CHAMAR_EPRINT
    }
    if embutido == frontend.EMB_LEN {
        return CHAMAR_EXATO_CHAMAR_LEN
    }
    if embutido == frontend.EMB_ASSERT {
        return CHAMAR_EXATO_CHAMAR_ASSERT
    }
    if embutido == frontend.EMB_PANIC {
        return CHAMAR_EXATO_CHAMAR_PANIC
    }
    if embutido == frontend.EMB_TRANSMUTE {
        return CHAMAR_EXATO_CHAMAR_TRANSMUTE
    }
    if embutido == frontend.EMB_STATIC_ASSERT {
        return CHAMAR_EXATO_CHAMAR_STATIC_ASSERT
    }
    if (embutido == frontend.EMB_FORMAT) or (embutido == frontend.EMB_FORMAT_C) {
        return CHAMAR_EXATO_SEM_CHAMAR_FORMATO
    }
    if embutido == frontend.EMB_DEDUP {
        return CHAMAR_EXATO_SEM_CHAMAR_DEDUP
    }
    if embutido == frontend.EMB_HEAP_PUSH {
        return CHAMAR_EXATO_SEM_CHAMAR_HEAP_PUSH
    }
    if embutido == frontend.EMB_HEAP_PUSH_BY {
        return CHAMAR_EXATO_SEM_CHAMAR_HEAP_PUSH_BY
    }
    if embutido == frontend.EMB_HEAP_POP {
        return CHAMAR_EXATO_SEM_CHAMAR_HEAP_POP
    }
    if embutido == frontend.EMB_HEAP_POP_BY {
        return CHAMAR_EXATO_SEM_CHAMAR_HEAP_POP_BY
    }
    if embutido == frontend.EMB_INDEX_BY {
        return CHAMAR_EXATO_SEM_CHAMAR_INDEX_BY
    }
    if embutido == frontend.EMB_FIND_BY {
        return CHAMAR_EXATO_SEM_CHAMAR_FIND_BY
    }
    if embutido == frontend.EMB_ANY_BY {
        return CHAMAR_EXATO_SEM_CHAMAR_ANY_BY
    }
    if embutido == frontend.EMB_ALL_BY {
        return CHAMAR_EXATO_SEM_CHAMAR_ALL_BY
    }
    if embutido == frontend.EMB_COUNT_BY {
        return CHAMAR_EXATO_SEM_CHAMAR_COUNT_BY
    }
    if embutido == frontend.EMB_SET_UNION {
        return CHAMAR_EXATO_SEM_CHAMAR_SET_UNION
    }
    if embutido == frontend.EMB_SET_INTERSECT {
        return CHAMAR_EXATO_SEM_CHAMAR_SET_INTERSECT
    }
    if embutido == frontend.EMB_SET_DIFF {
        return CHAMAR_EXATO_SEM_CHAMAR_SET_DIFF
    }
    if embutido == frontend.EMB_RESIZE {
        return CHAMAR_EXATO_SEM_CHAMAR_RESIZE
    }
    if embutido == frontend.EMB_SORT {
        return CHAMAR_EXATO_SEM_CHAMAR_SORT
    }
    if embutido == frontend.EMB_SORT_BY {
        return CHAMAR_EXATO_SEM_CHAMAR_SORT_BY
    }
    if embutido == frontend.EMB_SORT_BY_KEY {
        return CHAMAR_EXATO_SEM_CHAMAR_SORT_BY_KEY
    }
    if embutido == frontend.EMB_BINARY_SEARCH {
        return CHAMAR_EXATO_SEM_CHAMAR_BINARY_SEARCH
    }
    if embutido == frontend.EMB_SLICE_FROM {
        return CHAMAR_EXATO_SEM_CHAMAR_SLICE_FROM
    }
    if embutido == frontend.EMB_CONJ {
        return CHAMAR_EXATO_SEM_CHAMAR_CONJ
    }
    if embutido == frontend.EMB_SHUFFLE {
        return CHAMAR_EXATO_SEM_CHAMAR_SHUFFLE
    }
    if embutido == frontend.EMB_CHOICE {
        return CHAMAR_EXATO_SEM_CHAMAR_CHOICE
    }
    return 0
}

// C: semantic/sem_call.c:71
proc achar_parametro(a: ^Assinatura, nome: i32) -> i32 {
    for i in (0 as u32)..<a.nparams {
        if (a.params or_else {})[i].nome == nome {
            return transmute(i, to = i32)
        }
    }
    return -1
}

// C: semantic/sem_call.c:80
proc ultimo_ligado(e: ^frontend.Expr, i: u32) -> i32 {
    var tern_1: i32 = -1
    if i > 0 {
        tern_1 = (e.args or_else {})[i - 1].indice
    }
    return tern_1
}

// C: semantic/sem_call.c:86
proc ligar_posicional(s: ^Semantica, e: ^frontend.Expr, a: ^Assinatura, i: u32) -> bool {
    let g: ^frontend.Arg = &(e.args or_else {})[i]
    let ultimo: i32 = ultimo_ligado(e, i)
    if (i > 0) and ((e.args or_else {})[i - 1].nome >= 0) {
        let msg_1 = format(f"argumento posicional depois de um nomeado; escreva nome = valor", alloc = heap)
        defer delete(msg_1)
        _ = sem_erro(s, common.E0502, (g.valor as ^frontend.Expr).pos, msg_1)
        if common.c2f_s2u_32((ultimo + 1)) < a.nparams {
            sem_sugerir_nomear_arg(s, g, sem_nome_texto(s, (a.params or_else {})[ultimo + 1].nome))
        }
        return false
    }
    if i >= a.nparams {
        if a.nparams == 0 {
            let msg_2 = format(f"o proc nao tem parametros", alloc = heap)
            defer delete(msg_2)
            _ = sem_erro(s, common.E0502, (g.valor as ^frontend.Expr).pos, msg_2)
        } else {
            let msg_3 = format(f"sobra argumento: o proc tem so {a.nparams} parametro(s)", alloc = heap)
            defer delete(msg_3)
            _ = sem_erro(s, common.E0502, (g.valor as ^frontend.Expr).pos, msg_3)
        }
        sem_sugerir_tirar_arg(s, g)
        return false
    }
    g.indice = transmute(i, to = i32)
    return true
}

// C: semantic/sem_call.c:107
// C2F-N2: o Renomeado devolvido e copia no heap (renomeado_achar): o chamador faz delete.
// s.nomes e s.modulos (esqueleto do S1: ?[]) guardam 1 elemento: o `Interner *`/`Modulos *` do C = o elemento [0].
proc entrada_do_rotulo(s: ^Semantica, e: ^frontend.Expr, rotulo: i32, era_antigo: ^bool) -> ?^common.Renomeado {
    let nome: str = sem_nome_texto(s, rotulo)
    if (e.modulo == 0) or (s.modulos == none) {
        // chamada indireta (campo de tipo proc) nao tem nome de chamado: e.nome = -1 e nenhum rotulo de embutido casa (no C e lixo de memoria, sem casar)
        if e.nome < 0 {
            return none
        }
        return common.renomeado_achar(common.REN_ROTULO, sem_nome_texto(s, e.nome), nome, era_antigo)
    }
    let caminho: str = common.interner_texto(&(s.nomes or_else {})[0], (s.modulos or_else {})[0].itens[e.modulo].caminho)
    return common.renomeado_achar(common.REN_PARAM, caminho, nome, era_antigo)
}

// C: semantic/sem_call.c:117
proc achar_parametro_renomeado(s: ^Semantica, e: ^frontend.Expr, a: ^Assinatura, nome: i32) -> i32 {
    var era_antigo: bool = false
    let r: ?^common.Renomeado = entrada_do_rotulo(s, e, nome, &era_antigo)
    defer delete(r)
    var declarado: ?str = none
    if r != none {
        if era_antigo {
            declarado = (r as ^common.Renomeado).novo
        } else {
            declarado = (r as ^common.Renomeado).antigo
        }
    }
    var i: u32 = 0
    while (declarado != none) and (i < a.nparams) {
        if sem_nome_texto(s, (a.params or_else {})[i].nome) == (declarado or_else "") {
            return i as i32
        }
        i += 1
    }
    return -1
}

// C: semantic/sem_call.c:130
proc conferir_rotulo_antigo(s: ^Semantica, e: ^frontend.Expr, g: ^frontend.Arg) -> bool {
    var era_antigo: bool = false
    let r: ?^common.Renomeado = entrada_do_rotulo(s, e, g.nome, &era_antigo)
    defer delete(r)
    if (r == none) or (not era_antigo) {
        return true
    }
    let tam_rotulo: u32 = common.interner_tam(&(s.nomes or_else {})[0], g.nome)
    common.renomeado_notar_tabela(s.diag as ^common.Diag, g.pos_nome, tam_rotulo, r)
    if not common.renomeado_recusa_em(s.diag as ^common.Diag, r) {
        return true
    }
    return common.renomeado_recusar(s.diag as ^common.Diag, g.pos_nome, tam_rotulo, r)
}

// C: semantic/sem_call.c:140
proc ligar_nomeado(s: ^Semantica, e: ^frontend.Expr, a: ^Assinatura, i: u32) -> bool {
    let g: ^frontend.Arg = &(e.args or_else {})[i]
    var idx: i32 = achar_parametro(a, g.nome)
    if idx < 0 {
        idx = achar_parametro_renomeado(s, e, a, g.nome)
    }
    if (idx >= 0) and (not conferir_rotulo_antigo(s, e, g)) {
        return false
    }
    if idx < 0 {
        var sp: SemParecido = SemParecido{}
        sem_parecido_iniciar(s, common.E0504, g.pos_nome, g.nome, &sp)
        sem_parecidos_de_params(s, (a.params or_else {})[0..<a.nparams], &sp)
        let msg_1 = format(f"o proc nao tem o parametro '{sem_nome_texto(s, g.nome)}'", alloc = heap)
        defer delete(msg_1)
        return sem_erro_parecido(s, &sp, msg_1)
    }
    if idx <= ultimo_ligado(e, i) {
        let msg_2 = format(f"argumento fora da ordem declarada ou repetido", alloc = heap)
        defer delete(msg_2)
        return sem_erro(s, common.E0501, g.pos_nome, msg_2)
    }
    g.indice = idx
    return true
}

// C: semantic/sem_call.c:158
proc ligar_argumentos(s: ^Semantica, e: ^frontend.Expr, a: ^Assinatura) -> bool {
    var i: u32 = 0
    while i < e.nargs {
        var tern_1: i32 = 0
        if (e.args or_else {})[i].nome < 0 {
            tern_1 = common.c2f_b2i32(ligar_posicional(s, e, a, i))
        } else {
            tern_1 = common.c2f_b2i32(ligar_nomeado(s, e, a, i))
        }
        let ligou: bool = tern_1 != 0
        if not ligou {
            return false
        }
        i += 1
    }
    return true
}

// C: semantic/sem_call.c:168
proc conferir_tipos(s: ^Semantica, e: ^frontend.Expr, a: ^Assinatura) -> bool {
    var i: u32 = 0
    while i < e.nargs {
        let g: ^frontend.Arg = &(e.args or_else {})[i]
        let querido: u32 = (a.params or_else {})[g.indice].tipo.tipo
        s.valor_para_foreign = (common.c2f_b2i32(a.externo) != 0) and ((g.valor as ^frontend.Expr).tipo_no == (frontend.EX_NOME as u8))
        var tern_1: i32 = 0
        if common.c2f_b2i32(sem_eh_allocator(s, querido)) != 0 {
            tern_1 = common.c2f_b2i32(sem_allocator_converter_arg(s, e, g))
        } else {
            tern_1 = common.c2f_b2i32(sem_checar(s, g.valor, querido))
        }
        let ok: bool = tern_1 != 0
        s.valor_para_foreign = false
        s.ctx_tipo = ContextoDoTipo{onde = CTX_ARGUMENTO as u8, valor = g.valor, nome = (a.params or_else {})[g.indice].nome, dono = e.nome}
        if (not ok) or (not sem_coagir(s, g.valor, querido, (g.valor as ^frontend.Expr).pos)) {
            return false
        }
        i += 1
    }
    return true
}

// C: semantic/sem_call.c:183
proc conferir_faltantes(s: ^Semantica, e: ^frontend.Expr, a: ^Assinatura) -> bool {
    let lista: []frontend.Param = a.params or_else {}
    let argumentos: []frontend.Arg = e.args or_else {}
    var i: u32 = 0
    while i < a.nparams {
        var ligado: bool = false
        var k: u32 = 0
        while k < e.nargs {
            ligado = ligado or (argumentos[k].indice == (i as i32))
            k += 1
        }
        if (not ligado) and (lista[i].padrao == none) {
            if not sem_allocator_inserir_no_migrar(s, e, &lista[i]) { // B01d: true = segue para o proximo parametro
                let msg_1 = format(f"falta o argumento '{sem_nome_texto(s, lista[i].nome)}'", alloc = heap)
                defer delete(msg_1)
                return sem_erro(s, common.E0503, e.pos_op, msg_1)
            }
        }
        i += 1
    }
    return true
}

// C: semantic/sem_call.c:197
// C2F-13: params fundido em nparams (len)
proc sem_ligar_embutido(s: ^Semantica, e: ^frontend.Expr, params: ?[]frontend.Param) -> bool {
    var a: Assinatura = Assinatura{params = params, nparams = len(params or_else {}) as u32, externo = false}
    return ligar_argumentos(s, e, &a) and conferir_faltantes(s, e, &a)
}

// C: semantic/sem_call.c:203
proc chamar_com(s: ^Semantica, e: ^frontend.Expr, a: ^Assinatura, retorno: u32) -> bool {
    if ((not ligar_argumentos(s, e, a)) or (not conferir_tipos(s, e, a))) or (not conferir_faltantes(s, e, a)) {
        return false
    }
    e.tipo = retorno
    return true
}

// C: semantic/sem_call.c:211
// C2F-13: params fundido em nparams (len)
proc sem_chamar_com_params(s: ^Semantica, e: ^frontend.Expr, params: []frontend.Param) -> bool {
    var a: Assinatura = Assinatura{params = params, nparams = len(params) as u32, externo = false}
    return ((common.c2f_b2i32(ligar_argumentos(s, e, &a)) != 0) and (common.c2f_b2i32(conferir_tipos(s, e, &a)) != 0)) and (common.c2f_b2i32(conferir_faltantes(s, e, &a)) != 0)
}

// C: semantic/sem_call.c:219
proc chamar_saida(s: ^Semantica, e: ^frontend.Expr, nome: str, para_erro: bool) -> bool {
    if (e.nargs != 1) or ((e.args or_else {})[0].nome >= 0) {
        let msg_1 = format(f"{nome} recebe exatamente 1 argumento posicional", alloc = heap)
        defer delete(msg_1)
        return sem_erro(s, common.E0301, e.pos_op, msg_1)
    }
    let v: ?^frontend.Expr = (e.args or_else {})[0].valor
    let p_1 = e.args or_else {}
    p_1[0].indice = 0
    e.tipo = TIPO_VAZIO as u32
    if (v as ^frontend.Expr).tipo_no == (frontend.EX_FTEXTO as u8) {
        return sem_f_texto(s, v as ^frontend.Expr)
    }
    if not sem_checar(s, v, TIPO_CSTR as u32) {
        return false
    }
    let real: bool = tipo_eh_real(&s.tipos, (v as ^frontend.Expr).tipo)
    if ((((not real) and (not tipo_eh_inteiro((v as ^frontend.Expr).tipo))) and ((v as ^frontend.Expr).tipo != (TIPO_BOOL as u32))) and ((v as ^frontend.Expr).tipo != (TIPO_TEXTO as u32))) and ((v as ^frontend.Expr).tipo != (TIPO_CSTR as u32)) {
        let msg_2 = format(f"{nome} so aceita inteiro (i8..u64, int, uint), real (f32, f64, unidade), bool, str ou cstr", alloc = heap)
        defer delete(msg_2)
        _ = sem_erro(s, common.E0301, (v as ^frontend.Expr).pos, msg_2)
        sem_forma_do_print(s, v)
        return false
    }
    return (not ((common.c2f_b2i32(real) != 0) or (common.c2f_b2i32(para_erro) != 0))) or (common.c2f_b2i32(sem_f_texto_do_argumento(s, e)) != 0)
}

// C: semantic/sem_call.c:238
proc chamar_print(s: ^Semantica, e: ^frontend.Expr) -> bool {
    return chamar_saida(s, e, "print", false)
}

// C: semantic/sem_call.c:243
proc chamar_eprint(s: ^Semantica, e: ^frontend.Expr) -> bool {
    return chamar_saida(s, e, "eprint", true)
}

// C: semantic/sem_call.c:249
proc contem_chamada(e: ?^frontend.Expr) -> bool {
    if (e as ^frontend.Expr).tipo_no == (frontend.EX_CHAMADA as u8) {
        return true
    }
    if ((e as ^frontend.Expr).a != none) and (common.c2f_b2i32(contem_chamada((e as ^frontend.Expr).a)) != 0) {
        return true
    }
    if ((e as ^frontend.Expr).b != none) and (common.c2f_b2i32(contem_chamada((e as ^frontend.Expr).b)) != 0) {
        return true
    }
    var i: u32 = 0
    while i < (e as ^frontend.Expr).nargs {
        if contem_chamada(((e as ^frontend.Expr).args or_else {})[i].valor) {
            return true
        }
        i += 1
    }
    return false
}

// C: semantic/sem_call.c:261
proc chamar_len_v19(s: ^Semantica, e: ^frontend.Expr, v: ?^frontend.Expr) -> bool {
    var c: i32 = tipo_classe_de(&s.tipos, (v as ^frontend.Expr).tipo)
    let por_ponteiro: bool = common.c2f_s2u_32(c) == (TC_PONTEIRO as u32)
    if por_ponteiro {
        let arg_1: u32 = tipo_de(&s.tipos, (v as ^frontend.Expr).tipo).a
        let arg_2: ^Tipos = &s.tipos
        c = tipo_classe_de(arg_2, arg_1)
    }
    if common.c2f_s2u_32(c) == (TC_BIT_SET as u32) {
        if por_ponteiro {
            let msg_1 = format(f"len recebe o bit_set: len(s)", alloc = heap)
            defer delete(msg_1)
            return sem_erro(s, common.E0319, (v as ^frontend.Expr).pos, msg_1)
        }
        let p_1 = e.args or_else {}
        p_1[0].indice = 0
        e.tipo = TIPO_INT as u32
        return true
    }
    if common.c2f_s2u_32(c) == (TC_MATRIZ as u32) {
        let msg_2 = format(f"len de matrix nao existe: o tamanho e fixo no tipo matrix[R, C]T", alloc = heap)
        defer delete(msg_2)
        return sem_erro(s, common.E0321, (v as ^frontend.Expr).pos, msg_2)
    }
    if common.c2f_s2u_32(c) == (TC_SOA as u32) {
        var tern_1: u32 = (v as ^frontend.Expr).tipo
        if common.c2f_b2i32(por_ponteiro) != 0 {
            tern_1 = tipo_de(&s.tipos, (v as ^frontend.Expr).tipo).a
        }
        let soa: u32 = tern_1
        if (not tipo_soa_dinamica(&s.tipos, soa)) and (common.c2f_b2i32(contem_chamada(v)) != 0) {
            let msg_3 = format(f"len de soa[N]S e constante e nao avalia o argumento: guarde o valor numa variavel antes", alloc = heap)
            defer delete(msg_3)
            return sem_erro(s, common.E0320, (v as ^frontend.Expr).pos, msg_3)
        }
        let p_2 = e.args or_else {}
        p_2[0].indice = 0
        e.tipo = TIPO_INT as u32
        return true
    }
    let p_3 = e.args or_else {}
    p_3[0].indice = 0
    e.tipo = TIPO_INT as u32
    return true
}

// C: semantic/sem_call.c:291
proc chamar_len(s: ^Semantica, e: ^frontend.Expr) -> bool {
    var forma: i32 = 0
    if e.nargs == 0 {
        let msg_1 = format(f"len recebe o texto", alloc = heap)
        defer delete(msg_1)
        return sem_erro(s, common.E0503, e.pos_op, msg_1)
    }
    if (e.args or_else {})[0].nome >= 0 {
        let msg_2 = format(f"o 1o argumento deve ser posicional", alloc = heap)
        defer delete(msg_2)
        _ = sem_erro(s, common.E0502, (e.args or_else {})[0].pos_nome, msg_2)
        sem_sugerir_tirar_nome(s, &(e.args or_else {})[0], -1)
        return false
    }
    if e.nargs > 1 {
        let msg_3 = format(f"len recebe so 1 argumento", alloc = heap)
        defer delete(msg_3)
        return sem_erro(s, common.E0504, ((e.args or_else {})[1].valor as ^frontend.Expr).pos, msg_3)
    }
    let v: ?^frontend.Expr = (e.args or_else {})[0].valor
    if not sem_checar(s, v, TIPO_VAZIO as u32) {
        return false
    }
    if (v as ^frontend.Expr).tipo == (TIPO_CSTR as u32) {
        let msg_4 = format(f"len de cstr precisaria contar ate o NUL: use len(c as str)", alloc = heap)
        defer delete(msg_4)
        return sem_erro(s, common.E0307, (v as ^frontend.Expr).pos, msg_4)
    }
    _ = sem_elemento_de(s, (v as ^frontend.Expr).tipo, &forma)
    if ((v as ^frontend.Expr).tipo != (TIPO_TEXTO as u32)) and (common.c2f_s2u_32(forma) == (FORMA_NENHUMA as u32)) {
        if sem_eh_tipo_v19(s, (v as ^frontend.Expr).tipo) {
            return chamar_len_v19(s, e, v)
        }
        let msg_5 = format(f"len pede str, array ou fatia", alloc = heap)
        defer delete(msg_5)
        return sem_erro(s, common.E0301, (v as ^frontend.Expr).pos, msg_5)
    }
    if (((common.c2f_s2u_32(forma) == (FORMA_ARRAY as u32)) or (common.c2f_s2u_32(forma) == (FORMA_PONTEIRO_ARRAY as u32))) and (not sem_eh_lista_fixa_ou_ponteiro(s, (v as ^frontend.Expr).tipo))) and (common.c2f_b2i32(contem_chamada(v)) != 0) {
        let msg_6 = format(f"len de array e constante e nao avalia o argumento: guarde o valor numa variavel antes", alloc = heap)
        defer delete(msg_6)
        return sem_erro(s, common.E0308, (v as ^frontend.Expr).pos, msg_6)
    }
    let p_1 = e.args or_else {}
    p_1[0].indice = 0
    e.tipo = TIPO_INT as u32
    return true
}

// C: semantic/sem_call.c:319
proc chamar_assert(s: ^Semantica, e: ^frontend.Expr) -> bool {
    var a: Assinatura = Assinatura{params = s.params_assert[..], nparams = 2, externo = false}
    return chamar_com(s, e, &a, TIPO_VAZIO as u32)
}

// C: semantic/sem_call.c:325
proc chamar_panic(s: ^Semantica, e: ^frontend.Expr) -> bool {
    var a: Assinatura = Assinatura{params = s.params_panic[..], nparams = 1, externo = false}
    return chamar_com(s, e, &a, TIPO_VAZIO as u32)
}

// C: semantic/sem_call.c:332
proc conferir_forma_transmute(s: ^Semantica, e: ^frontend.Expr) -> bool {
    let argumentos: []frontend.Arg = e.args or_else {}
    if e.nargs == 0 {
        let msg_1 = format(f"falta o valor a converter", alloc = heap)
        defer delete(msg_1)
        return sem_erro(s, common.E0503, e.pos_op, msg_1)
    }
    if e.nargs == 1 {
        let msg_2 = format(f"falta o argumento 'to' (tipo de destino)", alloc = heap)
        defer delete(msg_2)
        return sem_erro(s, common.E0503, e.pos_op, msg_2)
    }
    if argumentos[0].nome >= 0 {
        let msg_3 = format(f"o 1o argumento deve ser posicional", alloc = heap)
        defer delete(msg_3)
        _ = sem_erro(s, common.E0502, argumentos[0].pos_nome, msg_3)
        sem_sugerir_tirar_nome(s, &argumentos[0], -1)
        return false
    }
    if (argumentos[1].nome >= 0) and (argumentos[1].nome != s.nome_to) and (argumentos[1].nome != s.nome_para) { // V-06 = B: o 2o argumento tambem pode ser posicional (o tipo)
        let msg_4 = format(f"transmute nao tem o parametro '{sem_nome_texto(s, argumentos[1].nome)}'", alloc = heap)
        defer delete(msg_4)
        return sem_erro(s, common.E0504, argumentos[1].pos_nome, msg_4)
    }
    if e.nargs > 2 {
        let msg_5 = format(f"transmute so recebe o valor e 'to'", alloc = heap)
        defer delete(msg_5)
        return sem_erro(s, common.E0504, (argumentos[2].valor as ^frontend.Expr).pos, msg_5)
    }
    if (argumentos[1].valor as ^frontend.Expr).tipo_no != (frontend.EX_NOME as u8) {
        let msg_6 = format(f"'to' recebe o nome de um tipo", alloc = heap)
        defer delete(msg_6)
        return sem_erro(s, common.E0201, (argumentos[1].valor as ^frontend.Expr).pos, msg_6)
    }
    return (argumentos[1].nome < 0) or conferir_rotulo_antigo(s, e, &argumentos[1])
}

// 0.45.0: transmute entre rawptr e inteiro de 64 bits (int, uint, i64, u64): o handle de C que a API do sistema trata como numero
proc transmute_rawptr_inteiro64(s: ^Semantica, origem: u32, alvo: u32) -> bool {
    let origem_raw: bool = tipo_classe_de(&s.tipos, origem) == TC_RAWPTR
    let alvo_raw: bool = tipo_classe_de(&s.tipos, alvo) == TC_RAWPTR
    let origem_64: bool = (origem == (TIPO_INT as u32)) or (origem == (TIPO_UINT as u32))
    let alvo_64: bool = (alvo == (TIPO_INT as u32)) or (alvo == (TIPO_UINT as u32))
    return (origem_raw and alvo_64) or (origem_64 and alvo_raw)
}

// C: semantic/sem_call.c:352
proc conferir_tipos_transmute(s: ^Semantica, e: ^frontend.Expr, origem: u32, alvo: u32) -> bool {
    if transmute_rawptr_inteiro64(s, origem, alvo) {
        return true // 0.45.0: rawptr <-> int/uint de 64 bits, so por aqui (explicito e achavel por busca)
    }
    if (not tipo_eh_numerico(&s.tipos, origem)) or (not tipo_eh_numerico(&s.tipos, alvo)) {
        let msg_1 = format(f"transmute so troca bits entre tipos numericos (inteiros, f32, f64, unidades) e entre rawptr e int/uint de 64 bits", alloc = heap)
        defer delete(msg_1)
        return sem_erro(s, common.E0304, e.pos_op, msg_1)
    }
    let bytes_origem: u8 = tipo_largura_bits(&s.tipos, origem) / 8
    let bytes_alvo: u8 = tipo_largura_bits(&s.tipos, alvo) / 8
    if bytes_origem == bytes_alvo {
        return true
    }
    var nome_origem: [64]u8 = {}
    var nome_alvo: [64]u8 = {}
    sem_descrever(s, origem, nome_origem[..], 64)
    sem_descrever(s, alvo, nome_alvo[..], 64)
    let texto_origem = from_bytes(nome_origem[0..<common.c2f_strlen_b(nome_origem[..])], alloc = heap)
    defer delete(texto_origem)
    let texto_alvo = from_bytes(nome_alvo[0..<common.c2f_strlen_b(nome_alvo[..])], alloc = heap)
    defer delete(texto_alvo)
    let msg_2 = format(f"tamanhos diferentes: {texto_origem} tem {bytes_origem} bytes, {texto_alvo} tem {bytes_alvo}", alloc = heap)
    defer delete(msg_2)
    return sem_erro(s, common.E0304, e.pos_op, msg_2)
}

// C: semantic/sem_call.c:366
proc chamar_transmute(s: ^Semantica, e: ^frontend.Expr) -> bool {
    var alvo: u32 = 0
    if not conferir_forma_transmute(s, e) {
        return false
    }
    let para: ^frontend.Arg = &(e.args or_else {})[1]
    if not sem_resolver_nome_tipo(s, (para.valor as ^frontend.Expr).nome, (para.valor as ^frontend.Expr).pos, 0, &alvo) {
        return false
    }
    if sem_eh_allocator(s, alvo) {
        return sem_allocator_nome_fora_de_parametro(s, (para.valor as ^frontend.Expr).pos)
    }
    if not sem_checar(s, (e.args or_else {})[0].valor, TIPO_VAZIO as u32) {
        return false
    }
    if not conferir_tipos_transmute(s, e, ((e.args or_else {})[0].valor as ^frontend.Expr).tipo, alvo) {
        return false
    }
    let p_1 = e.args or_else {}
    p_1[0].indice = 0
    para.indice = 1
    let ptr_1: ^frontend.Expr = para.valor as ^frontend.Expr
    ptr_1.tipo = alvo
    e.tipo = alvo
    return true
}

// C: semantic/sem_call.c:383
proc chamar_static_assert(s: ^Semantica, e: ^frontend.Expr) -> bool {
    var a: Assinatura = Assinatura{params = s.params_assert[..], nparams = 2, externo = false}
    return chamar_com(s, e, &a, TIPO_VAZIO as u32) and sem_conferir_static_assert(s, e)
}

// C: semantic/sem_call.c:414
proc chamar_por_faixa(s: ^Semantica, e: ^frontend.Expr, embutido: i32) -> bool {
    if embutido >= frontend.EMB_MIN_OF {
        return sem_chamar_estat(s, e, embutido)
    }
    if embutido >= frontend.EMB_CAP {
        return sem_chamar_lista(s, e, embutido)
    }
    if embutido >= frontend.EMB_WRAPPING_ADD {
        return sem_chamar_aritmetica(s, e, embutido)
    }
    if embutido >= frontend.EMB_MIN {
        return sem_chamar_matematica(s, e, embutido)
    }
    if embutido >= frontend.EMB_SIZE_OF {
        return sem_chamar_layout(s, e, embutido)
    }
    if embutido >= frontend.EMB_INSERT {
        return sem_chamar_v19(s, e, embutido)
    }
    if embutido >= frontend.EMB_NEW {
        return sem_chamar_memoria(s, e, embutido)
    }
    let msg_1 = format(f"'{sem_nome_texto(s, e.nome)}' nao e um proc que se chame assim", alloc = heap)
    defer delete(msg_1)
    return sem_erro(s, common.E0201, e.pos_op, msg_1)
}

// C: semantic/sem_call.c:426
proc chamar_embutido(s: ^Semantica, e: ^frontend.Expr, embutido: i32) -> bool {
    e.ref = frontend.REF_EMBUTIDO as u8
    e.ref_id = embutido
    if sem_embutido_muta_colecao(embutido) {
        s.corpo_muta_colecao = true
    }
    let tag: u16 = tag_exato(embutido) // EXATOS[embutido] != NULL
    if tag != 0 {
        return chamar_chamar_exato(tag, s, e)
    }
    return chamar_por_faixa(s, e, embutido)
}

// C: semantic/sem_call.c:437
proc marcar_origem_c(s: ^Semantica, e: ^frontend.Expr, decl: ?^frontend.Decl) {
    let retorno: u32 = (decl as ^frontend.Decl).retorno.tipo
    if (not (decl as ^frontend.Decl).externo) or (not (decl as ^frontend.Decl).tem_retorno) {
        return
    }
    let classe: i32 = tipo_classe_de(&s.tipos, retorno)
    if (((retorno == (TIPO_CSTR as u32)) or (common.c2f_b2i32(tipo_opcional_nicho(&s.tipos, retorno)) != 0)) or (common.c2f_s2u_32(classe) == (TC_PONTEIRO as u32))) or (common.c2f_s2u_32(classe) == (TC_ANULAVEL as u32)) {
        e.alocacao = ORIGEM_C as u8
    }
}

// C: semantic/sem_call.c:446
proc sem_chamada(s: ^Semantica, e: ^frontend.Expr) -> bool {
    if s.usa_proc_valor and (e.modulo == 0) and sem_converter_em_chamada_ind(s, e) { // v1.12: local/parametro de tipo proc
        return sem_chamada_ind(s, e)
    }
    var y: ?^Simbolo = sem_achar_simbolo(s, e.nome, e.modulo)
    var uso: NomeUsado = NomeUsado{nome = e.nome, pos = e.pos_op, modulo = e.modulo}
    if not sem_visivel(s, y, &uso) {
        return false
    }
    if (y as ^Simbolo).categoria == (SIM_PROC_EMBUTIDO as u8) {
        return chamar_embutido(s, e, (y as ^Simbolo).indice)
    }
    if sem_simbolo_veneno(y) { // L8: o erro esta na assinatura do proc; os argumentos nao seriam conferidos contra nada
        e.tipo = sem_uso_de_veneno(s)
        return true
    }
    if (y as ^Simbolo).categoria != (SIM_PROC as u8) {
        return erro_de_chamada_sem_proc(s, e, y as ^Simbolo)
    }
    if not sem_math_chamada(s, e, &y) { // S3 P3: std:math confere o tipo e troca f32 pela gemea
        return false
    }
    let decl: ?^frontend.Decl = (y as ^Simbolo).decl
    sem_libm_notar_chamada(s, e, decl) // S3 P4
    var a: Assinatura = Assinatura{params = (decl as ^frontend.Decl).params, nparams = (decl as ^frontend.Decl).nparams, externo = (decl as ^frontend.Decl).externo}
    e.ref = frontend.REF_PROC as u8
    e.ref_id = (y as ^Simbolo).indice
    if not chamar_com(s, e, &a, (decl as ^frontend.Decl).retorno.tipo) {
        return false
    }
    if s.tipo_allocator != 0 {
        sem_allocator_origem_da_chamada(s, e) // B01c
    }
    if s.tem_externo {
        marcar_origem_c(s, e, decl)
    }
    if ((decl as ^frontend.Decl).posse_c == (frontend.POSSE_C_CRIA_SAIDA as u8)) and (not sem_handle_da_saida(s, e, decl)) {
        return false
    }
    return sem_posse_dos_argumentos(s, e, decl)
}

// C: semantic/sem_call.c:457 (corpo do `if (y->categoria != SIM_PROC)` de SemChamada, em proc proprio: limite de aninhamento)
proc erro_de_chamada_sem_proc(s: ^Semantica, e: ^frontend.Expr, y: ^Simbolo) -> bool {
    var local: ?^LocalInfo = none
    if e.modulo == 0 {
        local = escopo_buscar(&s.escopo, e.nome)
    }
    if (local != none) and ((local as ^LocalInfo).tipo == (TIPO_VENENO as u32)) { // b15: local que o let com erro deixou envenenado: chamar por ele e cascata
        e.tipo = sem_uso_de_veneno(s)
        return true
    }
    if (y.categoria == (SIM_NENHUM as u8)) and (e.modulo == 0) and sem_nome_ja_relatado(s, e.nome) { // b15: cascata do mesmo nome
        return sem_erro_calado(s, e.pos_op)
    }
    if (y.categoria == (SIM_NENHUM as u8)) and (e.modulo == 0) and sem_idioma_de_chamada(s, e) { // IA1-L2: range(n), println(x), printf = E0110
        return false
    }
    var sp: SemParecido = SemParecido{}
    sem_parecido_iniciar(s, common.E0201, e.pos_op, e.nome, &sp)
    sem_parecidos_de_nome(s, e.modulo, &sp)
    if y.categoria == (SIM_NENHUM as u8) {
        let msg_1 = format(f"proc '{sem_nome_texto(s, e.nome)}' nao declarado", alloc = heap)
        defer delete(msg_1)
        return sem_erro_parecido(s, &sp, msg_1)
    }
    let msg_2 = format(f"'{sem_nome_texto(s, e.nome)}' nao e um proc", alloc = heap)
    defer delete(msg_2)
    return sem_erro_parecido(s, &sp, msg_2)
}

// C: semantic/sem_call.c:487
proc sem_inteiro_constante(s: ^Semantica, e: ?^frontend.Expr, negativo: ^bool, magnitude: ^u64) -> bool {
    var numero: ?^frontend.Expr = e
    negativo^ = ((e as ^frontend.Expr).tipo_no == (frontend.EX_UNARIO as u8)) and ((e as ^frontend.Expr).op == (frontend.OP_NEGAR as u8))
    if negativo^ {
        numero = (e as ^frontend.Expr).a
    }
    if ((numero as ^frontend.Expr).tipo_no == (frontend.EX_NOME as u8)) and ((numero as ^frontend.Expr).ref == (frontend.REF_CONST as u8)) {
        let simbolo: ^Simbolo = sem_achar_simbolo(s, (numero as ^frontend.Expr).nome, (numero as ^frontend.Expr).modulo)
        numero = (simbolo.decl as ^frontend.Decl).init
    }
    if (numero as ^frontend.Expr).tipo_no != (frontend.EX_INT as u8) {
        return false
    }
    if (numero as ^frontend.Expr).ref == (frontend.REF_COMPONENTE as u8) { // v1.11 L12b: indice criado por v.x; o valor mora em ref_id, nao no fonte
        magnitude^ = common.c2f_s2u_64(((numero as ^frontend.Expr).ref_id) as i64)
        return true
    }
    // C: TipoLerLiteralU64(fonte->texto + pos_op, ...) le ate o 1o caractere que nao e digito da base; aqui copia so o trecho alfanumerico (sem '_': o leitor nao os aceita)
    let fonte: ^common.Fonte = s.fonte as ^common.Fonte
    let ini: int = ((numero as ^frontend.Expr).pos_op) as int
    var fim: int = ini
    while (fim < len(fonte.texto)) and eh_alfanumerico(fonte.texto[fim]) {
        fim += 1
    }
    return tipo_ler_literal_u64(fonte.texto[ini..<fim], magnitude)
}

// Letra ou digito ASCII (o texto de um literal inteiro: 0x1F, 0b101, 123).
proc eh_alfanumerico(c: u8) -> bool {
    let minuscula: u8 = c | 32
    return ((c >= 48) and (c <= 57)) or ((minuscula >= 97) and (minuscula <= 122))
}

// C: semantic/sem_call.c:501
proc sem_faixa_literal(s: ^Semantica, campo: ^frontend.Campo, valor: ?^frontend.Expr) -> bool {
    var negativo: bool = false
    var mag: u64 = 0
    if (not campo.tem_faixa) or (not tipo_eh_inteiro(campo.tipo.tipo)) or (not sem_inteiro_constante(s, valor, &negativo, &mag)) {
        return true
    }
    // os limites cabem em int64 (o parser garante); magnitude acima disso esta fora de qualquer faixa
    var limite: u64 = 9223372036854775807 // INT64_MAX
    var v: i64 = transmute(mag, to = i64)
    if negativo {
        limite = limite + 1
        v = transmute(wrapping_sub(0 as u64, mag), to = i64)
    }
    var dentro: bool = (mag <= limite) and (v >= campo.faixa_min)
    if dentro {
        if campo.faixa_excl {
            dentro = v < campo.faixa_max
        } else {
            dentro = v <= campo.faixa_max
        }
    }
    if dentro {
        return true
    }
    var sinal: str = ""
    if negativo {
        sinal = "-"
    }
    var operador: str = "..="
    if campo.faixa_excl {
        operador = "..<"
    }
    let msg_1 = format(f"valor {sinal}{mag} fora da faixa {campo.faixa_min}{operador}{campo.faixa_max} do campo '{sem_nome_texto(s, campo.nome)}'", alloc = heap)
    defer delete(msg_1)
    return sem_erro(s, common.E0420, (valor as ^frontend.Expr).pos, msg_1)
}

// C: semantic/sem_call.c:518
proc conferir_campo(s: ^Semantica, e: ^frontend.Expr, estrutura: ?^frontend.Decl, i: u32) -> bool {
    let g: ^frontend.Arg = &(e.args or_else {})[i]
    let idx: i32 = sem_achar_campo(estrutura, g.nome)
    if idx < 0 {
        var sp: SemParecido = SemParecido{}
        sem_parecido_iniciar(s, common.E0504, g.pos_nome, g.nome, &sp)
        sem_parecidos_de_campos(s, estrutura, &sp)
        let msg_1 = format(f"a struct nao tem o campo '{sem_nome_texto(s, g.nome)}'", alloc = heap)
        defer delete(msg_1)
        return sem_erro_parecido(s, &sp, msg_1)
    }
    for k in (0 as u32)..<i {
        if (e.args or_else {})[k].indice == idx {
            let msg_2 = format(f"campo '{sem_nome_texto(s, g.nome)}' repetido", alloc = heap)
            defer delete(msg_2)
            return sem_erro(s, common.E0501, g.pos_nome, msg_2)
        }
    }
    g.indice = idx
    let campo: ^frontend.Campo = &((estrutura as ^frontend.Decl).campos or_else {})[idx]
    if not sem_checar(s, g.valor, campo.tipo.tipo) {
        return false
    }
    s.ctx_tipo = ContextoDoTipo{onde = CTX_CAMPO as u8, valor = g.valor, nome = campo.nome, dono = e.nome}
    return (((common.c2f_b2i32(sem_coagir(s, g.valor, campo.tipo.tipo, (g.valor as ^frontend.Expr).pos)) != 0) and (common.c2f_b2i32(sem_conferir_movimento(s, g.valor)) != 0)) and (common.c2f_b2i32(sem_conferir_posse(s, g.valor, PONTO_GUARDA)) != 0)) and (common.c2f_b2i32(sem_faixa_literal(s, campo, g.valor)) != 0)
}

// C: semantic/sem_call.c:540
proc campo_sem_zero(s: ^Semantica, campo: ^frontend.Campo) -> bool {
    if sem_tipo_sem_zero(s, campo.tipo.tipo) {
        return true
    }
    return ((common.c2f_b2i32(s.tem_struct_aninhada) != 0) and (common.c2f_s2u_32(tipo_classe_de(&s.tipos, campo.tipo.tipo)) == (TC_STRUCT as u32))) and (common.c2f_b2i32(sem_struct_exige_literal(s, sem_decl_da_struct(s, campo.tipo.tipo))) != 0)
}

// C: semantic/sem_call.c:548
proc conferir_campos_ponteiro(s: ^Semantica, e: ^frontend.Expr, estrutura: ?^frontend.Decl) -> bool {
    let campos: []frontend.Campo = (estrutura as ^frontend.Decl).campos or_else {}
    let argumentos: []frontend.Arg = e.args or_else {}
    var i: u32 = 0
    while i < (estrutura as ^frontend.Decl).ncampos {
        let campo: ^frontend.Campo = &campos[i]
        var dado: bool = false
        if (campo.padrao == none) and campo_sem_zero(s, campo) { // C: `if (padrao != NULL || !CampoSemZero) continue`
            var k: u32 = 0
            while k < e.nargs {
                dado = dado or (argumentos[k].indice == (i as i32))
                k += 1
            }
            if not dado {
                return erro_campo_ponteiro_sem_valor(s, e, campo)
            }
        }
        i += 1
    }
    return true
}

// C: semantic/sem_call.c:556 (o corpo do campo sem valor de ConferirCamposPonteiro: 4 mensagens E0911/E0503)
proc erro_campo_ponteiro_sem_valor(s: ^Semantica, e: ^frontend.Expr, campo: ^frontend.Campo) -> bool {
    var apontado: [96]u8 = {}
    let classe: i32 = tipo_classe_de(&s.tipos, campo.tipo.tipo)
    if sem_proc_sem_zero(s, campo.tipo.tipo) { // v1.12: o campo (ou a struct de dentro) tem proc
        let msg_1 = format(f"falta o campo '{sem_nome_texto(s, campo.nome)}': proc nao tem valor zero (nao ha proc nulo); de o proc no literal", alloc = heap)
        defer delete(msg_1)
        return sem_erro(s, common.E0911, e.pos_op, msg_1)
    }
    if classe == TC_STRUCT {
        sem_descrever(s, campo.tipo.tipo, apontado[..], 96)
        let nome_tipo = from_bytes(apontado[0..<common.c2f_strlen_b(apontado[..])], alloc = heap)
        defer delete(nome_tipo)
        let msg_2 = format(f"falta o campo '{sem_nome_texto(s, campo.nome)}': a struct {nome_tipo} nao tem valor zero (tem campo ^T ou union sem padrao); de o valor no literal", alloc = heap)
        defer delete(msg_2)
        return sem_erro(s, common.E0503, e.pos_op, msg_2)
    }
    if (classe == TC_ARRAY) or (classe == TC_UNIAO) {
        sem_descrever(s, campo.tipo.tipo, apontado[..], 96)
        let nome_tipo = from_bytes(apontado[0..<common.c2f_strlen_b(apontado[..])], alloc = heap)
        defer delete(nome_tipo)
        var prefixo: str = ""
        if classe == TC_UNIAO {
            prefixo = "union "
        }
        let msg_3 = format(f"falta o campo '{sem_nome_texto(s, campo.nome)}': {prefixo}{nome_tipo} nao tem valor zero; de o valor no literal", alloc = heap)
        defer delete(msg_3)
        return sem_erro(s, common.E0503, e.pos_op, msg_3)
    }
    sem_descrever(s, tipo_de(&s.tipos, campo.tipo.tipo).a, apontado[..], 96)
    let nome_apontado = from_bytes(apontado[0..<common.c2f_strlen_b(apontado[..])], alloc = heap)
    defer delete(nome_apontado)
    let msg_4 = format(f"falta o campo '{sem_nome_texto(s, campo.nome)}': '^{nome_apontado}' nunca e nulo e nao tem valor zero; de o valor no literal ou use '?^{nome_apontado}'", alloc = heap)
    defer delete(msg_4)
    return sem_erro(s, common.E0503, e.pos_op, msg_4)
}

// C: semantic/sem_call.c:579
proc sem_literal_struct(s: ^Semantica, e: ^frontend.Expr) -> bool {
    if common.c2f_b2i32(e.nome == frontend.SYM_QUAT) != 0 {
        sem_quat_garantir(s)
    }
    if common.c2f_b2i32(e.nome == frontend.SYM_ALLOCATOR) != 0 {
        return sem_allocator_literal(s, e)
    }
    let y: ^Simbolo = sem_achar_simbolo(s, e.nome, e.modulo)
    var uso: NomeUsado = NomeUsado{nome = e.nome, pos = e.pos_op, modulo = e.modulo}
    if not sem_visivel(s, y, &uso) {
        return false
    }
    if common.c2f_b2i32((y.categoria == (SIM_STRUCT as u8)) and (common.c2f_b2i32(sem_simbolo_veneno(y)) != 0)) != 0 {
        e.tipo = sem_uso_de_veneno(s)
        return true
    }
    if y.categoria != (SIM_STRUCT as u8) {
        let msg_1 = format(f"struct '{sem_nome_texto(s, e.nome)}' nao declarada", alloc = heap)
        defer delete(msg_1)
        return sem_erro(s, common.E0201, e.pos_op, msg_1)
    }
    if (common.c2f_b2i32(s.tem_opaco) != 0) and (common.c2f_b2i32((y.decl as ^frontend.Decl).externo) != 0) {
        let msg_2 = format(f"o tipo opaco '{sem_nome_texto(s, e.nome)}' (de foreign) nao se cria na Forja: quem cria e uma funcao da biblioteca C (ela devolve ^{sem_nome_texto(s, e.nome)})", alloc = heap)
        defer delete(msg_2)
        return sem_erro(s, common.E0908, e.pos_op, msg_2)
    }
    var i: u32 = 0
    while i < e.nargs {
        if not conferir_campo(s, e, y.decl, i) {
            return false
        }
        i += 1
    }
    if not conferir_campos_ponteiro(s, e, y.decl) {
        return false
    }
    e.ref = frontend.REF_STRUCT as u8
    e.ref_id = y.indice
    e.tipo = y.tipo
    return true
}

// Os ids com tratador proprio na tabela EXATOS do C (sem_call.c:392): 31 entradas; format e format_c dividem o tratador.
test "sem_call: tag_exato cobre so as 31 entradas de EXATOS" {
    var com_tag: int = 0
    for id in 0..<120 {
        let tag: u16 = tag_exato(id as i32)
        if tag != 0 {
            com_tag += 1
        }
    }
    expect(com_tag == 31)
    expect(tag_exato(frontend.EMB_FORMAT) == CHAMAR_EXATO_SEM_CHAMAR_FORMATO)
    expect(tag_exato(frontend.EMB_FORMAT_C) == CHAMAR_EXATO_SEM_CHAMAR_FORMATO)
    expect(tag_exato(frontend.EMB_PRINT) == CHAMAR_EXATO_CHAMAR_PRINT)
    expect(tag_exato(frontend.EMB_EPRINT) == CHAMAR_EXATO_CHAMAR_EPRINT)
    expect(tag_exato(frontend.EMB_SET_DIFF) == CHAMAR_EXATO_SEM_CHAMAR_SET_DIFF)
    expect(tag_exato(frontend.EMB_NEW) == 0)
    expect(tag_exato(frontend.EMB_MIN) == 0)
    expect(tag_exato(frontend.EMB_SQRT) == 0)
    expect(tag_exato(frontend.EMB_APPEND) == 0)
    expect(tag_exato(-1) == 0)
    expect(tag_exato(97) == 0)
}

test "sem_call: achar_parametro, ultimo_ligado, contem_chamada e eh_alfanumerico" {
    var ps = make([dynamic]frontend.Param, alloc = heap)
    append(&ps, item = frontend.Param{nome = 10})
    append(&ps, item = frontend.Param{nome = 20})
    var a: Assinatura = Assinatura{params = ps[..], nparams = 2, externo = false}
    expect(achar_parametro(&a, 10) == 0)
    expect(achar_parametro(&a, 20) == 1)
    expect(achar_parametro(&a, 99) == -1)
    delete(ps)

    var args = make([dynamic]frontend.Arg, alloc = heap)
    append(&args, item = frontend.Arg{nome = -1, indice = 3})
    append(&args, item = frontend.Arg{nome = 5, indice = 7})
    var e: frontend.Expr = frontend.Expr{nargs = 2, args = args[..]}
    expect(ultimo_ligado(&e, 0) == -1)
    expect(ultimo_ligado(&e, 1) == 3)
    expect(ultimo_ligado(&e, 2) == 7)
    delete(args)

    var chamada: frontend.Expr = frontend.Expr{tipo_no = frontend.EX_CHAMADA as u8}
    var nome: frontend.Expr = frontend.Expr{tipo_no = frontend.EX_NOME as u8}
    var raiz: frontend.Expr = frontend.Expr{tipo_no = frontend.EX_NOME as u8, a = &nome}
    expect(not contem_chamada(&raiz))
    raiz.b = &chamada
    expect(contem_chamada(&raiz))
    raiz.b = none
    var lista = make([dynamic]frontend.Arg, alloc = heap)
    append(&lista, item = frontend.Arg{valor = &nome})
    append(&lista, item = frontend.Arg{valor = &chamada})
    raiz.args = lista[..]
    raiz.nargs = 1
    expect(not contem_chamada(&raiz))
    raiz.nargs = 2
    expect(contem_chamada(&raiz))
    delete(lista)
    expect(contem_chamada(&chamada))

    expect(eh_alfanumerico(48) and eh_alfanumerico(57) and eh_alfanumerico(65) and eh_alfanumerico(90))
    expect(eh_alfanumerico(97) and eh_alfanumerico(122) and eh_alfanumerico(120))
    expect(not eh_alfanumerico(95) and not eh_alfanumerico(46) and not eh_alfanumerico(32) and not eh_alfanumerico(0))
    expect(not eh_alfanumerico(64) and not eh_alfanumerico(91) and not eh_alfanumerico(96) and not eh_alfanumerico(123))
    expect(not eh_alfanumerico(47) and not eh_alfanumerico(58) and not eh_alfanumerico(200))
}
