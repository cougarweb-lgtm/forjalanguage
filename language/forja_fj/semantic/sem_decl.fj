struct PassoA {
    de: i32
    ate: i32
    checa: u16
    condicao: u8
}

const PASSO_SEMPRE: i32 = 0
const PASSO_SO_COM_STRUCT_ANINHADA: i32 = 1
const PASSO_SO_COM_PROC_VALOR: i32 = 2
// C2F-A0: PASSOS_A (const PassoA[14]; sem_decl.c:577). `checa` = tag CHECA_DECL_* (C2F-80); de/ate = D_* e condicao = PASSO_* como literais (const nao referencia const: E0301).
// de/ate: D_UNIDADE_BASE 0, D_UNIDADE_DERIV 1, D_CONST 2, D_STRUCT 3, D_ENUM 4, D_PROC 5, D_UNIAO 8, D_ASSERT 10.
const PASSOS_A: [15]PassoA = {
    PassoA{de = 0, ate = 1, checa = 2, condicao = 0}, // D_UNIDADE_BASE..D_UNIDADE_DERIV, DeclUnidade
    PassoA{de = 4, ate = 4, checa = 3, condicao = 0}, // D_ENUM, DeclEnum
    PassoA{de = 3, ate = 3, checa = 6, condicao = 0}, // D_STRUCT, RegistrarStruct
    PassoA{de = 8, ate = 8, checa = 10, condicao = 0}, // D_UNIAO, RegistrarUniao
    PassoA{de = 2, ate = 2, checa = 4, condicao = 0}, // D_CONST, DeclConstEscalar
    PassoA{de = 8, ate = 8, checa = 11, condicao = 0}, // D_UNIAO, DeclUniao
    PassoA{de = 3, ate = 3, checa = 7, condicao = 0}, // D_STRUCT, DeclStruct
    PassoA{de = 3, ate = 3, checa = 1, condicao = 2}, // D_STRUCT, SemConferirProcsDaStruct, PASSO_SO_COM_PROC_VALOR
    PassoA{de = 3, ate = 3, checa = 8, condicao = 1}, // D_STRUCT, ConferirCicloDaStruct, STRUCT_ANINHADA (true)
    PassoA{de = 3, ate = 3, checa = 9, condicao = 1}, // D_STRUCT, ConferirCamposStruct, STRUCT_ANINHADA (true)
    PassoA{de = 8, ate = 8, checa = 12, condicao = 0}, // D_UNIAO, ConferirDonoDaUniao
    PassoA{de = 2, ate = 2, checa = 5, condicao = 0}, // D_CONST, DeclConstStruct
    PassoA{de = 5, ate = 5, checa = 13, condicao = 0}, // D_PROC, DeclProc
    PassoA{de = 2, ate = 2, checa = 15, condicao = 0}, // D_CONST, DeclConstProc (L4a: const cujo tipo carrega proc, depois dos procs)
    PassoA{de = 10, ate = 10, checa = 14, condicao = 0}, // D_ASSERT, SemDeclAssert
}

pub const CHECA_DECL_SEM_CONFERIR_PROCS_DA_STRUCT: u16 = 1
pub const CHECA_DECL_DECL_UNIDADE: u16 = 2
pub const CHECA_DECL_DECL_ENUM: u16 = 3
pub const CHECA_DECL_DECL_CONST_ESCALAR: u16 = 4
