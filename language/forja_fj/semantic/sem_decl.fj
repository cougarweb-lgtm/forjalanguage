pub const CHECA_DECL_CONFERIR_CICLO_DA_STRUCT: u16 = 8
pub const CHECA_DECL_CONFERIR_CAMPOS_STRUCT: u16 = 9
pub const CHECA_DECL_REGISTRAR_UNIAO: u16 = 10
pub const CHECA_DECL_DECL_UNIAO: u16 = 11
pub const CHECA_DECL_CONFERIR_DONO_DA_UNIAO: u16 = 12
pub const CHECA_DECL_DECL_PROC: u16 = 13
pub const CHECA_DECL_SEM_DECL_ASSERT: u16 = 14
pub const CHECA_DECL_DECL_CONST_PROC: u16 = 15
pub proc chamar_checa_decl(tag: u16, s: ^Semantica, d: ^frontend.Decl) -> bool {
    if tag == 1 {
        return sem_conferir_procs_da_struct(s, d)
    }
    if tag == 2 {
        return decl_unidade(s, d)
    }
    if tag == 3 {
        return decl_enum(s, d)
    }
    if tag == 4 {
        return decl_const_escalar(s, d)
    }
    if tag == 5 {
        return decl_const_struct(s, d)
    }
    if tag == 6 {
        return registrar_struct(s, d)
    }
    if tag == 7 {
        return decl_struct(s, d)
    }
    if tag == 8 {
        return conferir_ciclo_da_struct(s, d)
    }
    if tag == 9 {
        return conferir_campos_struct(s, d)
    }
    if tag == 10 {
        return registrar_uniao(s, d)
    }
    if tag == 11 {
        return decl_uniao(s, d)
    }
    if tag == 12 {
        return conferir_dono_da_uniao(s, d)
    }
    if tag == 13 {
        return decl_proc(s, d)
    }
    if tag == 14 {
        return sem_decl_assert(s, d)
    }
    if tag == 15 {
        return decl_const_proc(s, d)
    }
    return false // tag fora de 1..15: 1..14 existem no C (todo PassoA tem checa); 15 e da L4a
}

// C: semantic/sem_decl.c:58
proc dim_da_unidade(s: ^Semantica, nome: i32, pos: u32, dim: ^u32) -> bool {
    let y: ^Simbolo = sem_achar_simbolo(s, nome, 0)
    var uso: NomeUsado = NomeUsado{nome = nome, pos = pos, modulo = 0}
    if not sem_visivel(s, y, &uso) {
        return false
    }
    if (y.categoria == (SIM_UNIDADE as u8)) and ((y.envenenado as i32) != 0) {
        return sem_erro_calado(s, pos)
    }
    if y.categoria != (SIM_UNIDADE as u8) {
        let msg_1 = format(f"unidade '{sem_nome_texto(s, nome)}' nao declarada", alloc = heap)
        defer delete(msg_1)
        return sem_erro(s, common.E0201, pos, msg_1)
    }
    dim^ = tipo_de(&s.tipos, y.tipo).a
    return true
}

// C: semantic/sem_decl.c:69
proc decl_unidade(s: ^Semantica, d: ^frontend.Decl) -> bool {
    var dim: u32 = 0
    var a: u32 = 0
    var b: u32 = 0
    if not sem_verificar_caixa(s, d.nome, d.pos, CAIXA_PASCAL) {
        return false
    }
    if d.tipo_no == (frontend.D_UNIDADE_BASE as u8) {
        dim = dim_nova_base(&s.dims, d.chave)
    } else {
        if (not dim_da_unidade(s, d.nome_a, d.pos_a, &a)) or (not dim_da_unidade(s, d.nome_b, d.pos_b, &b)) {
            return false
        }
        var tern_1: i32 = -1
        if d.op == (frontend.OP_MUL as u8) {
            tern_1 = 1
        }
        dim = dim_combinar(&s.dims, a, b, tern_1)
        dim_nomear(&s.dims, dim, d.chave)
    }
    var y: Simbolo = Simbolo{categoria = SIM_UNIDADE as u8, indice = 0, decl = d, tipo = tipo_real(&s.tipos, dim), envenenado = 0}
    return sem_declarar_global(s, d, &y)
}

// C: semantic/sem_decl.c:86
proc membro_do_enum(s: ^Semantica, d: ^frontend.Decl, i: u32) -> bool {
    let m: ^frontend.Membro = &(d.membros or_else {})[i]
    if not sem_verificar_caixa(s, m.nome, m.pos, CAIXA_SNAKE) {
        return false
    }
    for j in (0 as u32)..<i {
        if (d.membros or_else {})[j].nome == m.nome {
            let msg_1 = format(f"o membro '{sem_nome_texto(s, m.nome)}' ja existe no enum '{sem_nome_texto(s, d.nome)}'", alloc = heap)
            defer delete(msg_1)
            return sem_erro(s, common.E0202, m.pos, msg_1)
        }
    }
    return true
}

// C: semantic/sem_decl.c:100
proc conferir_valores_do_enum(s: ^Semantica, d: ^frontend.Decl) -> bool {
    let membros: []frontend.Membro = d.membros or_else {}
    var k: u32 = 0
    while k < d.nmembros {
        let m: ^frontend.Membro = &membros[k]
        if (m.valor < -2147483648) or (m.valor > 2147483647) { // INT32_MIN, INT32_MAX
            let msg_1 = format(f"o valor {m.valor} do membro '{sem_nome_texto(s, m.nome)}' nao cabe em i32 (-2147483648..=2147483647): o enum vira int no C", alloc = heap)
            defer delete(msg_1)
            return sem_erro(s, common.E0420, m.pos_valor, msg_1)
        }
        var j: u32 = 0
        while j < k {
            if membros[j].valor == m.valor {
                let msg_2 = format(f"o membro '{sem_nome_texto(s, m.nome)}' repete o valor {m.valor} de '{sem_nome_texto(s, membros[j].nome)}': dois nomes com o mesmo valor colidem no switch; use o membro original", alloc = heap)
                defer delete(msg_2)
                return sem_erro(s, common.E0202, m.pos, msg_2)
            }
            j += 1
        }
        k += 1
    }
    return true
}

// C: semantic/sem_decl.c:117
proc decl_enum(s: ^Semantica, d: ^frontend.Decl) -> bool {
    if not sem_verificar_caixa(s, d.nome, d.pos, CAIXA_PASCAL) {
        return false
    }
    var i: u32 = 0
    while i < d.nmembros {
        if not membro_do_enum(s, d, i) {
            return false
        }
        i += 1
    }
    if (d.op == 1) and (not conferir_valores_do_enum(s, d)) {
        return false
    }
    let antes_1: u32 = s.qtd_enum
    s.qtd_enum += 1
    d.indice = transmute(antes_1, to = i32)
    var y: Simbolo = Simbolo{categoria = SIM_ENUM as u8, indice = d.indice, decl = d, tipo = tipo_enum(&s.tipos, d.chave), envenenado = 0}
    return sem_declarar_global(s, d, &y)
}

// C: semantic/sem_decl.c:131
proc decl_const(s: ^Semantica, d: ^frontend.Decl) -> bool {
    if (not sem_verificar_caixa(s, d.nome, d.pos, CAIXA_MAIUSCULA)) or (not sem_resolver_tipo_ref(s, &d.tipo)) {
        return false
    }
    if (common.c2f_b2i32(tipos_tem_v19(&s.tipos)) != 0) and (common.c2f_b2i32(sem_tipo_tem_v19(s, d.tipo.tipo)) != 0) {
        let msg_1 = format(f"constante nao guarda map, bit_set, soa nem matrix (nem dentro de struct ou array): use let dentro do proc", alloc = heap)
        defer delete(msg_1)
        return sem_erro(s, common.E0301, d.tipo.pos, msg_1)
    }
    let classe: i32 = tipo_classe_de(&s.tipos, d.tipo.tipo)
    if ((((((common.c2f_s2u_32(classe) == (TC_PONTEIRO as u32)) or (common.c2f_s2u_32(classe) == (TC_ANULAVEL as u32))) or (common.c2f_s2u_32(classe) == (TC_RAWPTR as u32))) or (common.c2f_s2u_32(classe) == (TC_FATIA as u32))) or (common.c2f_s2u_32(classe) == (TC_DINAMICO as u32))) or (common.c2f_s2u_32(classe) == (TC_OPCIONAL as u32))) or (common.c2f_s2u_32(classe) == (TC_UNIAO as u32)) {
        let msg_2 = format(f"constante so guarda numero, bool, enum, str, cstr, struct ou array (nao ?T nem union)", alloc = heap)
        defer delete(msg_2)
        return sem_erro(s, common.E0301, d.tipo.pos, msg_2)
    }
    if (not s.fase_const_proc) and sem_tipo_tem_proc(s, d.tipo.tipo) { // L4a: o inicializador cita procs; fica para o passo DeclConstProc (os procs ainda nao existem aqui)
        return true
    }
    if not sem_expr_com(s, d.init, d.tipo.tipo) {
        return false
    }
    let antes_1: u32 = s.qtd_const
    s.qtd_const += 1
    d.indice = transmute(antes_1, to = i32)
    var tern_1: u32 = d.tipo.tipo
    if common.c2f_b2i32(s.tocou_veneno) != 0 {
        tern_1 = TIPO_VENENO as u32
    }
    var y: Simbolo = Simbolo{categoria = SIM_CONST as u8, indice = d.indice, decl = d, tipo = tern_1, envenenado = common.c2f_b2i32(s.tocou_veneno) as u8}
    return sem_declarar_global(s, d, &y)
}

// L4a: 2a chance das consts adiadas por decl_const (tipo com proc); as demais ja foram declaradas e passam direto
proc decl_const_proc(s: ^Semantica, d: ^frontend.Decl) -> bool {
    if not sem_tipo_tem_proc(s, d.tipo.tipo) {
        return true
    }
    s.fase_const_proc = true
    let ok: bool = decl_const(s, d)
    s.fase_const_proc = false
    return ok
}

// C: semantic/sem_decl.c:150
proc const_eh_composta(s: ^Semantica, d: ^frontend.Decl) -> bool {
    if d.tipo.forma == (frontend.TR_ARRAY as u8) {
        return true
    }
    return (d.tipo.forma == (frontend.TR_NOME as u8)) and (sem_achar_simbolo(s, d.tipo.nome, d.tipo.modulo).categoria == (SIM_STRUCT as u8))
}

// C: semantic/sem_decl.c:156
proc decl_const_escalar(s: ^Semantica, d: ^frontend.Decl) -> bool {
    return (common.c2f_b2i32(const_eh_composta(s, d)) != 0) or (common.c2f_b2i32(decl_const(s, d)) != 0)
}

// C: semantic/sem_decl.c:161
proc decl_const_struct(s: ^Semantica, d: ^frontend.Decl) -> bool {
    return (not const_eh_composta(s, d)) or (common.c2f_b2i32(decl_const(s, d)) != 0)
}

// C: semantic/sem_decl.c:169
proc limites_cabem_no_campo(s: ^Semantica, f: ^frontend.Campo) -> bool {
    let tipo: u32 = f.tipo.tipo
    let limites: [2]i64 = {f.faixa_min, f.faixa_max}
    let posicoes: [2]u32 = {f.pos_min, f.pos_max}
    if (not f.tem_faixa) or (not tipo_eh_inteiro(tipo)) {
        return true
    }
    for k in 0..<2 {
        let cabe: bool = tipo_bits_cabem(tipo, limites[k]) and (not (tipo_eh_sem_sinal(tipo) and (limites[k] < 0)))
        if not cabe {
            let nome_fixo: str = tipo_nome_fixo(tipo) or_else "(null)"
            let msg_1 = format(f"o limite {limites[k]} da faixa nao cabe em {nome_fixo} ({tipo_inteiro_min(tipo)}..={tipo_inteiro_max(tipo)})", alloc = heap)
            defer delete(msg_1)
            return sem_erro(s, common.E0420, posicoes[k], msg_1)
        }
    }
    return true
}

// C: semantic/sem_decl.c:187
proc tipo_do_campo_valido(s: ^Semantica, f: ^frontend.Campo) -> bool {
    var elemento: u32 = f.tipo.tipo
    var texto: [96]u8 = {}
    while tipo_classe_de(&s.tipos, elemento) == TC_ARRAY {
        elemento = tipo_de(&s.tipos, elemento).a
    }
    let classe_elemento: i32 = tipo_classe_de(&s.tipos, elemento)
    if ((classe_elemento == TC_OPCIONAL) or (classe_elemento == TC_UNIAO)) and sem_tipo_tem_struct_por_valor(s, elemento) {
        sem_descrever(s, f.tipo.tipo, texto[..], 96)
        let nome_tipo = from_bytes(texto[0..<common.c2f_strlen_b(texto[..])], alloc = heap)
        defer delete(nome_tipo)
        let msg_1 = format(f"campo de tipo {nome_tipo} guarda struct por valor (ainda nao suportado): guarde ^Struct na variante ou o valor fora da struct", alloc = heap)
        defer delete(msg_1)
        return sem_erro(s, common.E0301, f.tipo.pos, msg_1)
    }
    if classe_elemento == TC_STRUCT {
        s.tem_struct_aninhada = true
    }
    let classe: i32 = tipo_classe_de(&s.tipos, f.tipo.tipo)
    if f.tem_faixa and (classe == TC_STRUCT) {
        let msg_2 = format(f"faixa em campo struct nao existe: ponha a faixa nos campos da struct de dentro", alloc = heap)
        defer delete(msg_2)
        return sem_erro(s, common.E0308, f.pos_min, msg_2)
    }
    if f.tem_faixa and ((classe == TC_ARRAY) or (classe == TC_FATIA) or (classe == TC_DINAMICO)) {
        let msg_3 = format(f"faixa em campo array nao existe: ponha a faixa num struct do elemento ou confira com assert", alloc = heap)
        defer delete(msg_3)
        return sem_erro(s, common.E0308, f.pos_min, msg_3)
    }
    if f.tem_faixa and (classe >= TC_MAPA) {
        let msg_4 = format(f"faixa em campo map, bit_set, soa ou matrix nao existe: confira com assert", alloc = heap)
        defer delete(msg_4)
        return sem_erro(s, common.E0308, f.pos_min, msg_4)
    }
    return true
}

// C: semantic/sem_decl.c:213
proc marcar_campo_dono(s: ^Semantica, d: ^frontend.Decl, f: ^frontend.Campo) -> bool {
    if not sem_tipo_eh_dono(s, f.tipo.tipo) {
        return true
    }
    d.contem_dono = true
    if f.padrao == none {
        return true
    }
    let msg_1 = format(f"campo dono com padrao alocaria escondido a cada literal: tire o padrao (a lista comeca vazia, sem alocador) e passe make(...) no literal", alloc = heap)
    defer delete(msg_1)
    _ = sem_erro(s, common.E0311, (f.padrao as ^frontend.Expr).pos, msg_1)
    sem_forma_do_dono(s, DONO_CAMPO_PADRAO, (f.padrao as ^frontend.Expr).pos, TIPO_VAZIO as u32)
    return false
}

// C: semantic/sem_decl.c:223
proc campo_da_struct(s: ^Semantica, d: ^frontend.Decl, f: ^frontend.Campo, i: u32) -> bool {
    if not sem_verificar_caixa(s, f.nome, f.pos, CAIXA_SNAKE) {
        return false
    }
    for j in (0 as u32)..<i {
        if (d.campos or_else {})[j].nome == f.nome {
            let msg_1 = format(f"o campo '{sem_nome_texto(s, f.nome)}' ja existe na struct '{sem_nome_texto(s, d.nome)}'", alloc = heap)
            defer delete(msg_1)
            return sem_erro(s, common.E0202, f.pos, msg_1)
        }
    }
    s.adia_assinatura_proc = true
    let resolvido: bool = sem_resolver_tipo_ref(s, &f.tipo)
    s.adia_assinatura_proc = false
    if not resolvido {
        return false
    }
    if (not tipo_do_campo_valido(s, f)) or (not limites_cabem_no_campo(s, f)) {
        return false
    }
    if not marcar_campo_dono(s, d, f) {
        return false
    }
    if f.padrao == none {
        return true
    }
    return (common.c2f_b2i32(sem_expr_com(s, f.padrao, f.tipo.tipo)) != 0) and (common.c2f_b2i32(sem_faixa_literal(s, f, f.padrao)) != 0)
}

// C: semantic/sem_decl.c:244
proc registrar_alocador(s: ^Semantica, d: ^frontend.Decl, tipo: u32) {
    sem_registrar_nao_copiavel(s, d) // P48 S18: Mutex, Cond e Atomic* da std:sync/std:atomic
    if (s.modulos or_else {})[0].itens[d.modulo].origem != (frontend.MOD_STD as u8) { // s.modulos: o `Modulos *` do C = elemento [0]
        return
    }
    if d.nome == s.nome_arena {
        s.tipo_arena = tipo
    }
    if d.nome == s.nome_pool {
        s.tipo_pool = tipo
    }
}

// C: semantic/sem_decl.c:252
proc registrar_struct(s: ^Semantica, d: ^frontend.Decl) -> bool {
    if not sem_verificar_caixa(s, d.nome, d.pos, CAIXA_PASCAL) {
        return false
    }
    if d.externo {
        s.tem_opaco = true
    }
    let antes_1: u32 = s.qtd_struct
    s.qtd_struct += 1
    d.indice = transmute(antes_1, to = i32)
    var y: Simbolo = Simbolo{categoria = SIM_STRUCT as u8, indice = d.indice, decl = d, tipo = tipo_struct(&s.tipos, d.chave), envenenado = 0}
    if d.modulo != 0 {
        registrar_alocador(s, d, y.tipo)
    }
    return sem_declarar_global(s, d, &y)
}

// C: semantic/sem_decl.c:262
proc decl_struct(s: ^Semantica, d: ^frontend.Decl) -> bool {
    var i: u32 = 0
    while i < d.ncampos {
        if campo_da_struct(s, d, &(d.campos or_else {})[i], i) {
            i += 1
            continue
        }
        sem_venenar_campos(d, i)
        return false
    }
    return true
}

// C: semantic/sem_decl.c:275
proc struct_do_campo(s: ^Semantica, t: u32) -> ?^frontend.Decl {
    var t_v: u32 = t
    while common.c2f_s2u_32(tipo_classe_de(&s.tipos, t_v)) == (TC_ARRAY as u32) {
        t_v = tipo_de(&s.tipos, t_v).a
    }
    if common.c2f_s2u_32(tipo_classe_de(&s.tipos, t_v)) != (TC_STRUCT as u32) {
        return none
    }
    return (s.globais or_else {})[tipo_de(&s.tipos, t_v).a].decl
}

// C: semantic/sem_decl.c:285
proc alcanca(s: ^Semantica, atual: ?^frontend.Decl, alvo: ^frontend.Decl, caminho: ^CaminhoCiclo) -> bool {
    let decl: ^frontend.Decl = atual as ^frontend.Decl
    if caminho.n >= 64 {
        return false
    }
    caminho.nomes[caminho.n] = decl.chave // IA1-L8: o caminho guarda chaves (globais[chave])
    caminho.n += 1
    if decl == alvo {
        return true
    }
    let campos: []frontend.Campo = decl.campos or_else {}
    var i: u32 = 0
    while i < decl.ncampos {
        let proxima: ?^frontend.Decl = struct_do_campo(s, campos[i].tipo.tipo)
        if (proxima != none) and alcanca(s, proxima, alvo, caminho) {
            return true
        }
        i += 1
    }
    caminho.n -= 1
    return false
}

// C: semantic/sem_decl.c:299
proc nome_no_ciclo(s: ^Semantica, nome: i32, saida: []u8, cap: u64) {
    let tipo: u32 = (s.globais or_else {})[nome].tipo
    if tipo_eh_lista_fixa(&s.tipos, tipo) {
        sem_descrever(s, tipo, saida, cap)
    } else {
        _ = common.c2f_snprintf(saida[0..<(cap as int)], sem_nome_texto(s, nome))
    }
}

// C: semantic/sem_decl.c:307
proc erro_de_ciclo(s: ^Semantica, d: ^frontend.Decl, f: ^frontend.Campo, caminho: ^CaminhoCiclo) -> bool {
    var cadeia: [256]u8 = {}
    var nome: [96]u8 = {}
    var uso: u64 = 0
    var k: u32 = 0
    while (k < caminho.n) and ((uso + 1) < 256) {
        nome_no_ciclo(s, caminho.nomes[k], nome[..], 96)
        let nome_texto = from_bytes(nome[0..<common.c2f_strlen_b(nome[..])], alloc = heap)
        // snprintf devolve o tamanho que TERIA; passa de 256 = o laco acaba
        if k == 0 {
            uso += (common.c2f_snprintf(cadeia[(uso as int)..<256], nome_texto) as u64)
        } else {
            let parte = format(f" -> {nome_texto}", alloc = heap)
            uso += (common.c2f_snprintf(cadeia[(uso as int)..<256], parte) as u64)
            delete(parte)
        }
        delete(nome_texto)
        k += 1
    }
    var m: u32 = 0
    while m < caminho.n {
        let dono: ^frontend.Decl = (s.globais or_else {})[caminho.nomes[m]].decl as ^frontend.Decl
        dono.com_erro = true
        m += 1
    }
    let texto_cadeia = from_bytes(cadeia[0..<common.c2f_strlen_b(cadeia[..])], alloc = heap)
    defer delete(texto_cadeia)
    let msg_1 = format(f"a struct '{sem_nome_texto(s, d.nome)}' contem a si mesma por valor ({texto_cadeia}): troque um dos campos por ponteiro (^T)", alloc = heap)
    defer delete(msg_1)
    return sem_erro(s, common.E0301, f.tipo.pos, msg_1)
}

// C: semantic/sem_decl.c:321
proc conferir_ciclo_da_struct(s: ^Semantica, d: ^frontend.Decl) -> bool {
    if not s.tem_struct_aninhada {
        return true
    }
    let campos: []frontend.Campo = d.campos or_else {}
    var i: u32 = 0
    while i < d.ncampos {
        let dentro: ?^frontend.Decl = struct_do_campo(s, campos[i].tipo.tipo)
        var caminho: CaminhoCiclo = CaminhoCiclo{}
        if (dentro != none) and alcanca(s, dentro, d, &caminho) {
            // o caminho comeca em 'dentro'; a cadeia do aviso comeca e termina em d
            var completo: CaminhoCiclo = CaminhoCiclo{}
            completo.nomes[0] = d.chave
            completo.n = 1
            var k: u32 = 0
            while (k < caminho.n) and (completo.n < 64) {
                completo.nomes[completo.n] = caminho.nomes[k]
                completo.n += 1
                k += 1
            }
            return erro_de_ciclo(s, d, &campos[i], &completo)
        }
        i += 1
    }
    return true
}

// C: semantic/sem_decl.c:338
proc struct_contem_dono(s: ^Semantica, d: ?^frontend.Decl) -> bool {
    if (d as ^frontend.Decl).contem_dono {
        return true
    }
    var i: u32 = 0
    while i < (d as ^frontend.Decl).ncampos {
        let dentro: ?^frontend.Decl = struct_do_campo(s, ((d as ^frontend.Decl).campos or_else {})[i].tipo.tipo)
        if (dentro != none) and (common.c2f_b2i32(struct_contem_dono(s, dentro)) != 0) {
            return true
        }
        i += 1
    }
    return false
}

// C: semantic/sem_decl.c:349
proc sem_struct_exige_literal(s: ^Semantica, d: ?^frontend.Decl) -> bool {
    var i: u32 = 0
    while i < (d as ^frontend.Decl).ncampos {
        let f: ^frontend.Campo = &((d as ^frontend.Decl).campos or_else {})[i]
        if f.padrao != none {
            i += 1
            continue
        }
        if sem_tipo_sem_zero(s, f.tipo.tipo) {
            return true
        }
        if (common.c2f_s2u_32(tipo_classe_de(&s.tipos, f.tipo.tipo)) == (TC_STRUCT as u32)) and (common.c2f_b2i32(sem_struct_exige_literal(s, sem_decl_da_struct(s, f.tipo.tipo))) != 0) {
            return true
        }
        i += 1
    }
    return false
}

// C: semantic/sem_decl.c:360
proc conferir_campo_struct(s: ^Semantica, d: ^frontend.Decl, f: ^frontend.Campo) -> bool {
    let dentro: ?^frontend.Decl = struct_do_campo(s, f.tipo.tipo)
    var texto: [96]u8 = {}
    if dentro == none {
        return true
    }
    if struct_contem_dono(s, dentro) {
        d.contem_dono = true
        if f.padrao != none {
            let msg_1 = format(f"campo dono com padrao alocaria escondido a cada literal: tire o padrao (a lista comeca vazia, sem alocador) e passe make(...) no literal", alloc = heap)
            defer delete(msg_1)
            _ = sem_erro(s, common.E0311, (f.padrao as ^frontend.Expr).pos, msg_1)
            sem_forma_do_dono(s, DONO_CAMPO_PADRAO, (f.padrao as ^frontend.Expr).pos, TIPO_VAZIO as u32)
            return false
        }
    }
    if (tipo_classe_de(&s.tipos, f.tipo.tipo) != TC_ARRAY) or (not sem_struct_exige_literal(s, dentro)) {
        return true
    }
    sem_descrever(s, f.tipo.tipo, texto[..], 96)
    let nome_tipo = from_bytes(texto[0..<common.c2f_strlen_b(texto[..])], alloc = heap)
    defer delete(nome_tipo)
    let nome_dentro: str = sem_nome_texto(s, (dentro as ^frontend.Decl).nome)
    if sem_proc_sem_zero(s, f.tipo.tipo) {
        let msg_2 = format(f"o campo '{sem_nome_texto(s, f.nome)}' guarda {nome_tipo} em array, mas {nome_dentro} tem campo proc, que nao tem valor zero (nao ha proc nulo): guarde ^{nome_dentro}", alloc = heap)
        defer delete(msg_2)
        return sem_erro(s, common.E0911, f.tipo.pos, msg_2)
    }
    let msg_3 = format(f"o campo '{sem_nome_texto(s, f.nome)}' guarda {nome_tipo} em array, mas {nome_dentro} nao tem valor zero (campo ^T ou union sem padrao); use ?^T ou de padrao na struct de dentro", alloc = heap)
    defer delete(msg_3)
    return sem_erro(s, common.E0503, f.tipo.pos, msg_3)
}

// C: semantic/sem_decl.c:384
proc conferir_campos_struct(s: ^Semantica, d: ^frontend.Decl) -> bool {
    if not s.tem_struct_aninhada {
        return true
    }
    var i: u32 = 0
    while i < d.ncampos {
        if not conferir_campo_struct(s, d, &(d.campos or_else {})[i]) {
            return false
        }
        i += 1
    }
    return true
}

// C: semantic/sem_decl.c:396
proc registrar_uniao(s: ^Semantica, d: ^frontend.Decl) -> bool {
    if not sem_verificar_caixa(s, d.nome, d.pos, CAIXA_PASCAL) {
        return false
    }
    let antes_1: u32 = s.qtd_uniao
    s.qtd_uniao += 1
    d.indice = transmute(antes_1, to = i32)
    var y: Simbolo = Simbolo{categoria = SIM_UNIAO as u8, indice = d.indice, decl = d, tipo = tipo_uniao(&s.tipos, d.chave), envenenado = 0}
    return sem_declarar_global(s, d, &y)
}

// C: semantic/sem_decl.c:405
proc variante_proibida(s: ^Semantica, v: ^frontend.Campo) -> bool {
    let t: u32 = v.tipo.tipo
    let classe: i32 = tipo_classe_de(&s.tipos, t)
    var texto: [96]u8 = {}
    if not sem_exige_copiavel(s, t, v.tipo.pos, "variante de union por valor: a union guarda o valor") {
        return false
    }
    if classe == TC_OPCIONAL {
        sem_descrever(s, tipo_de(&s.tipos, t).a, texto[..], 96)
        let nome_tipo = from_bytes(texto[0..<common.c2f_strlen_b(texto[..])], alloc = heap)
        defer delete(nome_tipo)
        let msg_1 = format(f"variante ?T nao existe: a union ja escolhe; use ?{nome_tipo} fora dela", alloc = heap)
        defer delete(msg_1)
        return sem_erro(s, common.E0313, v.tipo.pos, msg_1)
    }
    if classe == TC_UNIAO {
        let msg_2 = format(f"union dentro de union: liste as variantes direto", alloc = heap)
        defer delete(msg_2)
        return sem_erro(s, common.E0313, v.tipo.pos, msg_2)
    }
    if classe == TC_RESULTADO {
        let msg_3 = format(f"variante 'T ! E' nao existe", alloc = heap)
        defer delete(msg_3)
        return sem_erro(s, common.E0313, v.tipo.pos, msg_3)
    }
    if sem_tipo_eh_dono(s, t) {
        let msg_4 = format(f"variante dona nao existe: a union nao libera a lista; guarde ^[dynamic]T", alloc = heap)
        defer delete(msg_4)
        return sem_erro(s, common.E0313, v.tipo.pos, msg_4)
    }
    return true
}

// C: semantic/sem_decl.c:423
proc variante_da_uniao(s: ^Semantica, d: ^frontend.Decl, i: u32) -> bool {
    let campos: []frontend.Campo = d.campos or_else {}
    let v: ^frontend.Campo = &campos[i]
    var texto: [96]u8 = {}
    if (not sem_resolver_tipo_ref(s, &v.tipo)) or (not variante_proibida(s, v)) {
        return false
    }
    var j: u32 = 0
    while j < i {
        if campos[j].tipo.tipo == v.tipo.tipo {
            sem_descrever(s, v.tipo.tipo, texto[..], 96)
            let nome_tipo = from_bytes(texto[0..<common.c2f_strlen_b(texto[..])], alloc = heap)
            defer delete(nome_tipo)
            let msg_1 = format(f"variante {nome_tipo} repetida", alloc = heap)
            defer delete(msg_1)
            return sem_erro(s, common.E0313, v.tipo.pos, msg_1)
        }
        j += 1
    }
    return true
}

// C: semantic/sem_decl.c:436
proc decl_uniao(s: ^Semantica, d: ^frontend.Decl) -> bool {
    if (d.ncampos < 2) or (d.ncampos > 255) {
        sem_venenar_campos(d, 0)
        let msg_1 = format(f"union precisa de 2 a 255 variantes (tem {d.ncampos})", alloc = heap)
        defer delete(msg_1)
        return sem_erro(s, common.E0313, d.pos, msg_1)
    }
    var i: u32 = 0
    while i < d.ncampos {
        if variante_da_uniao(s, d, i) {
            i += 1
            continue
        }
        sem_venenar_campos(d, i)
        return false
    }
    return true
}

// C: semantic/sem_decl.c:451
proc conferir_dono_da_uniao(s: ^Semantica, d: ^frontend.Decl) -> bool {
    let campos: []frontend.Campo = d.campos or_else {}
    var i: u32 = 0
    while i < d.ncampos {
        let v: ^frontend.Campo = &campos[i]
        var texto: [96]u8 = {}
        if sem_tipo_eh_dono(s, v.tipo.tipo) {
            sem_descrever(s, v.tipo.tipo, texto[..], 96)
            let nome_tipo = from_bytes(texto[0..<common.c2f_strlen_b(texto[..])], alloc = heap)
            defer delete(nome_tipo)
            let msg_1 = format(f"variante dona nao existe: a struct '{nome_tipo}' tem lista; guarde ^{nome_tipo}", alloc = heap)
            defer delete(msg_1)
            return sem_erro(s, common.E0313, v.tipo.pos, msg_1)
        }
        i += 1
    }
    return true
}

// C: semantic/sem_decl.c:465
proc param_do_proc(s: ^Semantica, d: ^frontend.Decl, p: ^frontend.Param, i: u32) -> bool {
    if not sem_verificar_caixa(s, p.nome, p.pos, CAIXA_SNAKE) {
        return false
    }
    for j in (0 as u32)..<i {
        if (d.params or_else {})[j].nome == p.nome {
            let msg_1 = format(f"o parametro '{sem_nome_texto(s, p.nome)}' ja existe no proc '{sem_nome_texto(s, d.nome)}'", alloc = heap)
            defer delete(msg_1)
            return sem_erro(s, common.E0202, p.pos, msg_1)
        }
    }
    if d.externo {
        s.tipo_proc_permitido = &p.tipo
    }
    s.alocador_permitido = &p.tipo
    let resolvido: bool = sem_resolver_tipo_ref(s, &p.tipo)
    s.tipo_proc_permitido = none
    s.alocador_permitido = none
    if (not resolvido) or (not sem_allocator_conferir_param(s, d, p, i)) {
        return false
    }
    if sem_tipo_eh_dono(s, p.tipo.tipo) {
        let msg_2 = format(f"parametro nao recebe lista por valor: use ^[dynamic]T para alterar ou []T (l[..]) para ler e alterar", alloc = heap)
        defer delete(msg_2)
        _ = sem_erro(s, common.E0311, p.tipo.pos, msg_2)
        sem_forma_do_dono(s, DONO_PARAMETRO, p.tipo.pos, TIPO_VAZIO as u32)
        return false
    }
    if not sem_exige_copiavel(s, p.tipo.tipo, p.tipo.pos, "parametro por valor: o proc recebe o endereco (^T)") {
        return false
    }
    return (p.padrao == none) or (common.c2f_b2i32(sem_expr_com(s, p.padrao, p.tipo.tipo)) != 0)
}

// C: semantic/sem_decl.c:490
proc elemento_do_retorno(s: ^Semantica, d: ^frontend.Decl, el: ^frontend.Param, i: u32) -> bool {
    if not sem_verificar_caixa(s, el.nome, el.pos, CAIXA_SNAKE) {
        return false
    }
    for j in (0 as u32)..<i {
        if (d.retornos or_else {})[j].nome == el.nome {
            let msg_1 = format(f"o elemento '{sem_nome_texto(s, el.nome)}' ja existe no retorno do proc '{sem_nome_texto(s, d.nome)}'", alloc = heap)
            defer delete(msg_1)
            return sem_erro(s, common.E0202, el.pos, msg_1)
        }
    }
    if not sem_resolver_tipo_ref(s, &el.tipo) {
        return false
    }
    if common.c2f_s2u_32(tipo_classe_de(&s.tipos, el.tipo.tipo)) == (TC_RESULTADO as u32) {
        let msg_2 = format(f"elemento 'T ! E' nao existe: use ?E num elemento", alloc = heap)
        defer delete(msg_2)
        return sem_erro(s, common.E0314, el.tipo.pos, msg_2)
    }
    return true
}

// C: semantic/sem_decl.c:507
proc retorno_multiplo(s: ^Semantica, d: ^frontend.Decl) -> bool {
    var elementos: [8]u32 = {}
    if d.retorno.erro >= 0 {
        let msg_1 = format(f"retorno multiplo nao tem '! E': ponha o erro num elemento ?E (-> (valor: T, erro: ?E))", alloc = heap)
        defer delete(msg_1)
        return sem_erro(s, common.E0314, d.retorno.pos_tamanho, msg_1)
    }
    if (d.nretornos < 2) or (d.nretornos > 8) {
        let msg_2 = format(f"retorno multiplo tem de 2 a 8 valores (tem {d.nretornos}); um so valor e '-> T'", alloc = heap)
        defer delete(msg_2)
        return sem_erro(s, common.E0314, d.retorno.pos, msg_2)
    }
    let retornos: []frontend.Param = d.retornos or_else {}
    var i: u32 = 0
    while i < d.nretornos {
        if not elemento_do_retorno(s, d, &retornos[i], i) {
            return false
        }
        elementos[i] = retornos[i].tipo.tipo
        i += 1
    }
    d.retorno.tipo = tipo_tupla(&s.tipos, elementos[0..<(d.nretornos as int)])
    return true
}

// C: semantic/sem_decl.c:525
proc retorno_do_proc(s: ^Semantica, d: ^frontend.Decl) -> bool {
    d.retorno.tipo = TIPO_VAZIO as u32
    if not d.tem_retorno {
        return true
    }
    if d.retorno.forma == (frontend.TR_TUPLA as u8) {
        return retorno_multiplo(s, d)
    }
    return (common.c2f_b2i32(sem_resolver_tipo_ref(s, &d.retorno)) != 0) and (common.c2f_b2i32(sem_exige_copiavel(s, d.retorno.tipo, d.retorno.pos, "retorno por valor: devolva o endereco (^T)")) != 0)
}

// C: semantic/sem_decl.c:534
proc decl_proc(s: ^Semantica, d: ^frontend.Decl) -> bool {
    if ((not d.externo) or (d.simbolo >= 0)) and (not sem_verificar_caixa(s, d.nome, d.pos, CAIXA_SNAKE)) {
        return false
    }
    if sem_simbolo_c_eh_alias(s, d.modulo, d.nome) and (not (d.externo and (d.simbolo < 0))) { // 0.45.0: o proc foreign sem alias pode ter o nome do simbolo C que outros aliases ligam
        return erro_simbolo_c_de_alias(s, d.nome, d.pos)
    }
    var i: u32 = 0
    while i < d.nparams {
        if not param_do_proc(s, d, &(d.params or_else {})[i], i) {
            return false
        }
        i += 1
    }
    if not retorno_do_proc(s, d) {
        return false
    }
    var tern_1: i32 = 0
    if common.c2f_b2i32(d.externo) != 0 {
        tern_1 = common.c2f_b2i32(sem_checar_externo(s, d))
    } else {
        tern_1 = common.c2f_b2i32(sem_checar_exportado(s, d))
    }
    if not (tern_1 != 0) {
        return false
    }
    if (d.posse_c != (frontend.POSSE_C_NENHUMA as u8)) and (not sem_checar_posse_c(s, d)) {
        return false
    }
    if d.externo {
        sem_libm_notar_decl(s, d)
    }
    let antes_1: u32 = s.qtd_proc
    s.qtd_proc += 1
    d.indice = transmute(antes_1, to = i32)
    var y: Simbolo = Simbolo{categoria = SIM_PROC as u8, indice = d.indice, decl = d, tipo = TIPO_VAZIO as u32, envenenado = 0}
    if sem_declarar_global(s, d, &y) {
        return true
    }
    sem_sugerir_alias_de_foreign(s, d)
    return false
}

// C: semantic/sem_decl.c:554
proc passe_da_categoria(s: ^Semantica, de: i32, ate: i32, checa: u16, presentes: u32) -> bool {
    // C2F-54: deslocamento por quantidade nao constante = quantidade & 31 (u32); de/ate sao D_* (0..10)
    let desloca_ate: u32 = (ate as u32) & 31
    let desloca_de: u32 = (de as u32) & 31
    let faixa: u32 = (((2 as u32) << desloca_ate) - 1) & (~(((1 as u32) << desloca_de) - 1))
    var ok: bool = true
    if (presentes & faixa) == 0 { // nenhuma declaracao da categoria: o passe nao teria o que visitar
        return true
    }
    var d: ?^frontend.Decl = (s.programa as ^frontend.Programa).primeira
    while d != none {
        let decl: ^frontend.Decl = d as ^frontend.Decl
        if ((decl.tipo_no as i32) < de) or ((decl.tipo_no as i32) > ate) or decl.com_erro { // com_erro: o 1o erro da declaracao ja esta na lista
            d = decl.prox
            continue
        }
        sem_entrar_na_decl(s, d)
        s.tocou_veneno = false
        if chamar_checa_decl(checa, s, decl) {
            d = decl.prox
            continue
        }
        decl.com_erro = true
        sem_envenenar(s, d) // L8: o uso desta declaracao vira TIPO_VENENO e o erro que viria dele e calado
        ok = false
        if not sem_guardar_erro(s, decl.modulo) { // lista cheia: o resto seria cortado
            break
        }
        d = decl.prox
    }
    return ok
}

// C: semantic/sem_decl.c:588
proc sem_passe_a(s: ^Semantica) -> bool {
    var presentes: u32 = 0
    var ok: bool = true
    if not sem_checar_modificadores(s, &presentes) { // fatal: o diagnostico fica pendente em s.diag (SemanticaAnalisar o guarda)
        s.pula_passe_b = true
        return false
    }
    var i: int = 0
    while (i < 15) and (not s.lista.cortado) {
        let passo: PassoA = PASSOS_A[i]
        let pula_aninhada: bool = (passo.condicao == (PASSO_SO_COM_STRUCT_ANINHADA as u8)) and (not s.tem_struct_aninhada) // sem struct dentro de struct: nao percorre as Decl
        let pula_proc_valor: bool = (passo.condicao == (PASSO_SO_COM_PROC_VALOR as u8)) and (not s.usa_proc_valor) // v1.12: sem tipo proc de campo, nao percorre as Decl
        if pula_aninhada or pula_proc_valor {
            i += 1
            continue
        }
        let passo_ok: bool = passe_da_categoria(s, passo.de, passo.ate, passo.checa, presentes)
        ok = passo_ok and ok
        if (not passo_ok) and (passo.checa == CHECA_DECL_CONFERIR_CICLO_DA_STRUCT) { // fatal: struct que contem a si mesma faz as conferencias seguintes recursarem sem fim
            s.pula_passe_b = true
            break
        }
        i += 1
    }
    return ok
}

// C: semantic/sem_decl.c:612
// C2F-13: Semantica.proc (const Decl *) vira proc_c: []Decl no esqueleto do S1 (FATIA); a vista de 1 elemento sobre a Decl = slice_from(d, len = 1)
proc iniciar_corpo(s: ^Semantica, d: ?^frontend.Decl) {
    let decl: ^frontend.Decl = d as ^frontend.Decl
    s.proc_c = decl
    s.prox_local = decl.nparams as i32
    s.prof_laco = 0
    s.marca_laco = 0
    clear(&s.rastreados)
    clear(&s.nomes_locais)
    s.em_teste = decl.tipo_no == (frontend.D_TEST as u8)
    s.em_defer = false
    if s.em_teste {
        decl.retorno.tipo = TIPO_VAZIO as u32
    }
    let r: ^TipoInfo = tipo_de(&s.tipos, decl.retorno.tipo)
    var erro_do_proc: u32 = 0
    if r.classe == (TC_RESULTADO as u8) {
        erro_do_proc = r.b
    }
    s.erro_do_proc = erro_do_proc
    s.corpo_tem_ponteiro = false
    s.corpo_muta_colecao = false
    s.corpo_com_erro = false
    clear(&s.nomes_relatados)
    sem_higiene_iniciar_corpo(s)
    sem_marcar_ponteiro_do_corpo(s, decl.retorno.tipo)
    let params: []frontend.Param = decl.params or_else {}
    var i: u32 = 0
    while i < decl.nparams {
        var local: LocalInfo = LocalInfo{nome = params[i].nome, tipo = params[i].tipo.tipo, natureza = LOC_PARAM as u8, origem = 0, id = i as i32, anterior = 0, pos = params[i].pos, usos = 0, grupo = 0}
        escopo_empurrar(&s.escopo, &local)
        sem_gravar_nome_local(s, local.nome, local.tipo, local.pos)
        sem_marcar_ponteiro_do_corpo(s, local.tipo)
        i += 1
    }
}

// C: semantic/sem_decl.c:640
// C2F-20: a tabela de nomes do corpo e copiada elemento a elemento para uma fatia da arena (ArenaAlocar + memcpy); a Decl a guarda
proc guardar_nomes_dos_locais(s: ^Semantica, d: ^frontend.Decl) {
    let n: int = len(s.nomes_locais)
    let copia: []frontend.LocalNome = frontend.arena_fatia_local_nome(s.arena as ^common.Arena, n)
    for k in 0..<n {
        copia[k] = s.nomes_locais[k]
    }
    d.nomes_locais = copia
}

// C: semantic/sem_decl.c:648
proc termina_em_return(s: ^Semantica, d: ?^frontend.Decl) -> bool {
    var ultimo: ?^frontend.Stmt = (d as ^frontend.Decl).corpo
    if (not (d as ^frontend.Decl).tem_retorno) or (common.c2f_b2i32(tipo_ref_so_erro(&(d as ^frontend.Decl).retorno)) != 0) {
        return true
    }
    while (ultimo != none) and ((ultimo as ^frontend.Stmt).prox != none) {
        ultimo = (ultimo as ^frontend.Stmt).prox
    }
    if (ultimo != none) and ((ultimo as ^frontend.Stmt).tipo_no == (frontend.ST_RETURN as u8)) {
        return true
    }
    let msg_1 = format(f"proc com retorno precisa terminar em return", alloc = heap)
    defer delete(msg_1)
    return sem_erro(s, common.E0302, (d as ^frontend.Decl).pos_fim, msg_1)
}

// C: semantic/sem_decl.c:657
proc titulo_do_test(s: ^Semantica, d: ?^frontend.Decl) -> bool {
    let decl: ^frontend.Decl = d as ^frontend.Decl
    if common.interner_tam(&(s.nomes or_else {})[0], decl.nome) == 0 {
        let msg_1 = format(f"o titulo do test esta vazio", alloc = heap)
        defer delete(msg_1)
        return sem_erro(s, common.E0802, decl.pos_titulo, msg_1)
    }
    // S4 P1: o titulo e unico por modulo (modulo + 1 no byte; as Decl de cada modulo sao contiguas, ModulosOrdenarDecls).
    let dono: u8 = common.c2f_trunc_u8((decl.modulo as u64) + 1)
    let titulos: []u8 = s.titulo_visto or_else {}
    if titulos[decl.nome] == dono {
        let msg_2 = format(f"ja existe um test com o titulo \"{sem_nome_texto(s, decl.nome)}\"", alloc = heap)
        defer delete(msg_2)
        return sem_erro(s, common.E0802, decl.pos_titulo, msg_2)
    }
    titulos[decl.nome] = dono
    return true
}

// C: semantic/sem_decl.c:669
proc corpo_da_decl(s: ^Semantica, d: ?^frontend.Decl) -> bool {
    if ((d as ^frontend.Decl).tipo_no == (frontend.D_TEST as u8)) and (not titulo_do_test(s, d)) {
        return false
    }
    let altura: u32 = escopo_altura(&s.escopo)
    iniciar_corpo(s, d)
    let ok: bool = (common.c2f_b2i32(sem_bloco(s, (d as ^frontend.Decl).corpo)) != 0) and ((common.c2f_b2i32(s.corpo_com_erro) != 0) or (common.c2f_b2i32(termina_em_return(s, d)) != 0))
    let ptr_1: ^frontend.Decl = d as ^frontend.Decl
    ptr_1.nlocais = common.c2f_s2u_32(s.prox_local)
    guardar_nomes_dos_locais(s, d as ^frontend.Decl)
    let ptr_2: ^frontend.Decl = d as ^frontend.Decl
    ptr_2.fuga_relevante = s.corpo_tem_ponteiro
    escopo_recuar(&s.escopo, altura)
    return ok
}

// C: semantic/sem_decl.c:687
proc corpos_do_programa(s: ^Semantica, fuga: ^CorposDaFuga) -> bool {
    var ok: bool = true
    var d: ?^frontend.Decl = (s.programa as ^frontend.Programa).primeira
    while d != none {
        if (d as ^frontend.Decl).externo {
            d = (d as ^frontend.Decl).prox
            continue
        }
        if ((d as ^frontend.Decl).tipo_no != (frontend.D_PROC as u8)) and ((d as ^frontend.Decl).tipo_no != (frontend.D_TEST as u8)) {
            d = (d as ^frontend.Decl).prox
            continue
        }
        if (d as ^frontend.Decl).com_erro {
            d = (d as ^frontend.Decl).prox
            continue
        }
        sem_entrar_na_decl(s, d)
        s.tocou_veneno = false
        s.corpo_com_erro = false
        let clong_ok: bool = (not s.usa_clong) or (common.c2f_b2i32(sem_c_long_corpo(s, d)) != 0)
        if ((common.c2f_b2i32(clong_ok) != 0) and (common.c2f_b2i32(corpo_da_decl(s, d)) != 0)) and (not s.corpo_com_erro) {
            sem_higiene_guardar(s, d)
            if s.tocou_veneno {
                d = (d as ^frontend.Decl).prox
                continue
            }
            fuga_corpos_registrar(fuga, d)
            if ((common.c2f_b2i32((d as ^frontend.Decl).fuga_relevante) != 0) and (common.c2f_b2i32(s.corpo_muta_colecao) != 0)) and (not sem_emprestimo_corpo(s, d)) {
                let ptr_1: ^frontend.Decl = d as ^frontend.Decl
                ptr_1.com_erro = true
                ok = false
                if s.lista.cortado {
                    break
                }
            }
            d = (d as ^frontend.Decl).prox
            continue
        }
        let ptr_2: ^frontend.Decl = d as ^frontend.Decl
        ptr_2.com_erro = true
        sem_envenenar(s, d)
        ok = false
        if (common.c2f_b2i32((s.diag as ^common.Diag).tem) != 0) and (not sem_guardar_erro(s, (d as ^frontend.Decl).modulo)) {
            break
        }
        if s.lista.cortado {
            break
        }
        d = (d as ^frontend.Decl).prox
    }
    return ok
}

// C: semantic/sem_decl.c:719
proc sem_passe_b(s: ^Semantica) -> bool {
    var fuga: CorposDaFuga = CorposDaFuga{}
    let clong_ok: bool = sem_c_long_decls(s)
    fuga_corpos_iniciar(&fuga, s)
    let corpos_ok: bool = (common.c2f_b2i32(corpos_do_programa(s, &fuga)) != 0) and (common.c2f_b2i32(clong_ok) != 0)
    s.tocou_veneno = false
    let fuga_ok: bool = (not s.lista.cortado) and (common.c2f_b2i32(sem_fuga_programa(&fuga)) != 0)
    fuga_corpos_liberar(&fuga)
    let higiene_ok: bool = sem_higiene_relatar(s)
    return ((common.c2f_b2i32(corpos_ok) != 0) and (common.c2f_b2i32(fuga_ok) != 0)) and (common.c2f_b2i32(higiene_ok) != 0)
}

// C: semantic/sem_decl.c:732
proc sem_verificar_main(s: ^Semantica) -> bool {
    let y: ^Simbolo = &(s.globais or_else {})[frontend.SYM_MAIN]
    if ((y.categoria == (SIM_PROC as u8)) and ((y.decl as ^frontend.Decl).nparams == 0)) and ((not (y.decl as ^frontend.Decl).tem_retorno) or (common.c2f_b2i32(tipo_ref_so_erro(&(y.decl as ^frontend.Decl).retorno)) != 0)) {
        return true
    }
    let msg_1 = format(f"falta 'proc main()' sem parametros e sem retorno de valor", alloc = heap)
    defer delete(msg_1)
    return sem_erro(s, common.E0201, 0, msg_1)
}
