import "common"
import "frontend"

// C2F-A0: tabela GRUPOS (const char *const[2]) em const literal
const GRUPOS: [2]str = {"xyzw", "rgba"}

// C: semantic/sem_vetor.c:14
proc eh_vetor(s: ^Semantica, t: u32) -> bool {
    return common.c2f_s2u_32(tipo_classe_de(&s.tipos, t)) == (TC_ARRAY as u32)
}

// C: semantic/sem_vetor.c:20
proc elemento_ou_proprio(s: ^Semantica, t: u32) -> u32 {
    var tern_1: u32 = t
    if common.c2f_b2i32(eh_vetor(s, t)) != 0 {
        tern_1 = tipo_de(&s.tipos, t).a
    }
    return tern_1
}

// C: semantic/sem_vetor.c:26
proc operando_valido(s: ^Semantica, e: ^frontend.Expr, x: ?^frontend.Expr) -> bool {
    let xx: ^frontend.Expr = x as ^frontend.Expr
    if tipo_eh_numerico(&s.tipos, elemento_ou_proprio(s, xx.tipo)) {
        return true
    }
    let texto = sem_descrever_str(s, xx.tipo)
    defer delete(texto)
    let msg_1 = format(f"{texto} nao faz conta elemento a elemento: so [N]T de numero (inteiro, real ou unidade)", alloc = heap)
    defer delete(msg_1)
    return sem_erro(s, common.E0331, e.pos_op, msg_1)
}

// C: semantic/sem_vetor.c:35
proc soma_ou_sub_sem_dois_arrays(s: ^Semantica, e: ^frontend.Expr) -> bool {
    if (e.op != (frontend.OP_SOMA as u8)) and (e.op != (frontend.OP_SUB as u8)) {
        return false
    }
    return not ((common.c2f_b2i32(eh_vetor(s, (e.a as ^frontend.Expr).tipo)) != 0) and (common.c2f_b2i32(eh_vetor(s, (e.b as ^frontend.Expr).tipo)) != 0))
}

// C: semantic/sem_vetor.c:42
proc forma_valida(s: ^Semantica, e: ^frontend.Expr) -> bool {
    if e.op == (frontend.OP_RESTO as u8) {
        let msg_1 = format(f"'%' nao existe em conta de array: use for", alloc = heap)
        defer delete(msg_1)
        return sem_erro(s, common.E0331, e.pos_op, msg_1)
    }
    if soma_ou_sub_sem_dois_arrays(s, e) {
        let msg_2 = format(f"soma e subtracao pedem dois arrays [N]T do mesmo tipo (array com escalar so em * e /)", alloc = heap)
        defer delete(msg_2)
        return sem_erro(s, common.E0331, e.pos_op, msg_2)
    }
    if (e.op == (frontend.OP_DIV as u8)) and (not eh_vetor(s, (e.a as ^frontend.Expr).tipo)) {
        let msg_3 = format(f"escalar / array nao existe: so array / escalar", alloc = heap)
        defer delete(msg_3)
        return sem_erro(s, common.E0331, e.pos_op, msg_3)
    }
    return true
}

// C: semantic/sem_vetor.c:53
proc mesmo_tamanho(s: ^Semantica, e: ^frontend.Expr) -> bool {
    let ta: u32 = (e.a as ^frontend.Expr).tipo
    let tb: u32 = (e.b as ^frontend.Expr).tipo
    if (not eh_vetor(s, ta)) or (not eh_vetor(s, tb)) {
        return true
    }
    if tipo_de(&s.tipos, ta).b == tipo_de(&s.tipos, tb).b {
        return true
    }
    let texto_a = sem_descrever_str(s, ta)
    defer delete(texto_a)
    let texto_b = sem_descrever_str(s, tb)
    defer delete(texto_b)
    let msg_1 = format(f"{texto_a} e {texto_b} tem N diferente: a conta pede o mesmo N", alloc = heap)
    defer delete(msg_1)
    return sem_erro(s, common.E0331, e.pos_op, msg_1)
}

// C: semantic/sem_vetor.c:64
proc tipo_do_elemento(s: ^Semantica, e: ^frontend.Expr, resultado: ^u32) -> bool {
    var elemento_a: frontend.Expr = frontend.Expr{tipo_no = frontend.EX_NOME as u8, tipo = elemento_ou_proprio(s, (e.a as ^frontend.Expr).tipo)}
    var elemento_b: frontend.Expr = frontend.Expr{tipo_no = frontend.EX_NOME as u8, tipo = elemento_ou_proprio(s, (e.b as ^frontend.Expr).tipo)}
    var conta: frontend.Expr = e^
    conta.a = &elemento_a
    conta.b = &elemento_b
    if not sem_aritmetica(s, &conta) {
        return false
    }
    resultado^ = conta.tipo
    return true
}

// C: semantic/sem_vetor.c:77
proc sem_conta_vetor(s: ^Semantica, e: ^frontend.Expr) -> bool {
    var elemento: u32 = 0
    if (not operando_valido(s, e, e.a)) or (not operando_valido(s, e, e.b)) {
        return false
    }
    if ((not forma_valida(s, e)) or (not mesmo_tamanho(s, e))) or (not tipo_do_elemento(s, e, &elemento)) {
        return false
    }
    var tern_1: ?^frontend.Expr = e.b
    if common.c2f_b2i32(eh_vetor(s, (e.a as ^frontend.Expr).tipo)) != 0 {
        tern_1 = e.a
    }
    let vetor: ?^frontend.Expr = tern_1
    let arg_1: u32 = tipo_de(&s.tipos, (vetor as ^frontend.Expr).tipo).b
    let arg_2: u32 = elemento
    let arg_3: ^Tipos = &s.tipos
    e.tipo = tipo_array(arg_3, arg_2, arg_1)
    return true
}

// C: semantic/sem_vetor.c:88
proc sem_negar_vetor(s: ^Semantica, e: ^frontend.Expr) -> bool {
    let elemento: u32 = elemento_ou_proprio(s, (e.a as ^frontend.Expr).tipo)
    if not tipo_eh_numerico(&s.tipos, elemento) {
        let msg_1 = format(f"'-' em array pede [N]T de numero (inteiro, real ou unidade)", alloc = heap)
        defer delete(msg_1)
        return sem_erro(s, common.E0331, e.pos, msg_1)
    }
    if tipo_eh_sem_sinal(elemento) {
        let nome: str = tipo_nome_fixo(elemento) or_else "(null)"
        let msg_2 = format(f"'-' em inteiro sem sinal ({nome})", alloc = heap)
        defer delete(msg_2)
        return sem_erro(s, common.E0305, e.pos, msg_2)
    }
    e.tipo = (e.a as ^frontend.Expr).tipo
    return true
}

// C: semantic/sem_vetor.c:100
proc sem_composta_vetor(s: ^Semantica, st: ^frontend.Stmt) -> bool {
    var tern_1: i32 = frontend.OP_SUB
    if st.op == (frontend.ATRIB_SOMA as u8) {
        tern_1 = frontend.OP_SOMA
    }
    var conta: frontend.Expr = frontend.Expr{tipo_no = frontend.EX_BINARIO as u8, op = tern_1 as u8, a = st.alvo, b = st.expr}
    conta.pos = (st.alvo as ^frontend.Expr).pos
    conta.pos_op = (st.expr as ^frontend.Expr).pos
    if not sem_conta_vetor(s, &conta) {
        return false
    }
    if conta.tipo == (st.alvo as ^frontend.Expr).tipo {
        return true
    }
    let msg_1 = format(f"a conta nao tem o tipo do alvo: o '+=' e o '-=' pedem o mesmo [N]T", alloc = heap)
    defer delete(msg_1)
    return sem_erro(s, common.E0301, (st.expr as ^frontend.Expr).pos, msg_1)
}

// C: semantic/sem_vetor.c:115
// strchr(GRUPOS[g], letra): a letra NUL (que acharia o terminador) nunca vem de um nome de campo, entao nao e tratada.
proc posicao_da_letra(letra: u8, grupo: ^i32) -> i32 {
    for g in 0..<2 {
        let letras: str = GRUPOS[g]
        for p in 0..<len(letras) {
            if letras[p] == letra {
                grupo^ = g as i32
                return p as i32
            }
        }
    }
    return -1
}

// C: semantic/sem_vetor.c:128
proc nome_de_swizzle(nome: str) -> bool {
    var grupo: i32 = 0
    let letras: u64 = len(nome) as u64
    if (letras == 0) or (letras > (frontend.SWIZZLE_LETRAS_MAX as u64)) {
        return false
    }
    for j in (0 as u64)..<letras {
        if posicao_da_letra(nome[j], &grupo) < 0 {
            return false
        }
    }
    return true
}

// C: semantic/sem_vetor.c:140
proc sem_eh_swizzle(s: ^Semantica, e: ^frontend.Expr) -> bool {
    if not eh_vetor(s, (e.a as ^frontend.Expr).tipo) {
        return false
    }
    let arg_1: u32 = elemento_ou_proprio(s, (e.a as ^frontend.Expr).tipo)
    let arg_2: ^Tipos = &s.tipos
    if not tipo_eh_numerico(arg_2, arg_1) {
        return false
    }
    return nome_de_swizzle(sem_nome_texto(s, e.nome))
}

// C: semantic/sem_vetor.c:148
proc ler_letras(s: ^Semantica, e: ^frontend.Expr, n: u32, empacotado: ^i32) -> bool {
    let nome: str = sem_nome_texto(s, e.nome)
    let letras: u64 = len(nome) as u64
    var primeiro_grupo: i32 = -1
    var pacote: i32 = common.c2f_shl_i32(letras as i32, frontend.SWIZZLE_DESLOCA_CONTA as u32)
    for j in (0 as u64)..<letras {
        var grupo: i32 = 0
        let posicao: i32 = posicao_da_letra(nome[j], &grupo)
        if (primeiro_grupo >= 0) and (grupo != primeiro_grupo) {
            let msg_1 = format(f"'.{nome}' mistura xyzw com rgba: use as letras de um grupo so", alloc = heap)
            defer delete(msg_1)
            return sem_erro(s, common.E0332, e.pos_op, msg_1)
        }
        primeiro_grupo = grupo
        if common.c2f_s2u_32(posicao) >= n {
            // c2f_byte_texto devolve texto de heap: let + defer delete (dentro da f-string vazaria)
            let letra_pedida = common.c2f_byte_texto(nome[j])
            defer delete(letra_pedida)
            let letra_limite = common.c2f_byte_texto("xyzwrgba"[((grupo * 4) + transmute(n, to = i32)) - 1])
            defer delete(letra_limite)
            let msg_2 = format(f"a letra '{letra_pedida}' passa do tamanho: [{n}]T so tem as letras ate '{letra_limite}'", alloc = heap)
            defer delete(msg_2)
            return sem_erro(s, common.E0332, e.pos_op, msg_2)
        }
        pacote = common.c2f_ou_i32(pacote, common.c2f_shl_i32(posicao, common.c2f_s2u_32((frontend.SWIZZLE_BITS_POR_LETRA * (j as i32)))))
    }
    empacotado^ = pacote
    return true
}

// C: semantic/sem_vetor.c:171
proc literal_de_indice(s: ^Semantica, e: ^frontend.Expr, valor: i32) -> ^frontend.Expr {
    let literal: ^frontend.Expr = s4_novo_expr(s)
    literal.tipo_no = frontend.EX_INT as u8
    literal.op = 1
    literal.ref = frontend.REF_COMPONENTE as u8
    literal.ref_id = valor
    literal.tipo = TIPO_INT as u32
    literal.pos = e.pos_op
    literal.pos_op = e.pos_op
    return literal
}

// C: semantic/sem_vetor.c:184
proc sem_swizzle(s: ^Semantica, e: ^frontend.Expr) -> bool {
    let vetor: ^TipoInfo = tipo_de(&s.tipos, (e.a as ^frontend.Expr).tipo)
    let n: u32 = vetor.b
    let elemento: u32 = vetor.a
    var pacote: i32 = 0
    if (n < 2) or (n > (frontend.SWIZZLE_LETRAS_MAX as u32)) {
        let msg_1 = format(f"as letras x y z w (ou r g b a) so existem em [2]T, [3]T e [4]T; em [{n}]T use o indice", alloc = heap)
        defer delete(msg_1)
        return sem_erro(s, common.E0332, e.pos_op, msg_1)
    }
    if not ler_letras(s, e, n, &pacote) {
        return false
    }
    let letras: u32 = common.c2f_s2u_32(pacote) >> 8
    if letras == 1 {
        e.tipo_no = frontend.EX_INDICE as u8
        e.b = literal_de_indice(s, e, common.c2f_e_i32(pacote, frontend.SWIZZLE_MASCARA_LETRA))
        e.tipo = elemento
        return true
    }
    e.ref = frontend.REF_COMPONENTE as u8
    e.ref_id = pacote
    e.tipo = tipo_array(&s.tipos, elemento, letras)
    return true
}

// G3 S5: testes dirigidos (so existem em `forja test`)
test "sem_vetor: letras, nome_de_swizzle, eh_vetor e elemento_ou_proprio" {
    var g: i32 = -1
    expect(posicao_da_letra("x"[0], &g) == 0 and g == 0)
    expect(posicao_da_letra("w"[0], &g) == 3 and g == 0)
    expect(posicao_da_letra("r"[0], &g) == 0 and g == 1)
    expect(posicao_da_letra("a"[0], &g) == 3 and g == 1)
    expect(posicao_da_letra("g"[0], &g) == 1 and g == 1)
    expect(posicao_da_letra("q"[0], &g) == -1 and posicao_da_letra("X"[0], &g) == -1)
    expect(nome_de_swizzle("x") and nome_de_swizzle("xyzw") and nome_de_swizzle("rgba") and nome_de_swizzle("xr"))
    expect(nome_de_swizzle("zzzz") and nome_de_swizzle("bgr"))
    expect(not nome_de_swizzle("") and not nome_de_swizzle("xyzwx") and not nome_de_swizzle("xq") and not nome_de_swizzle("comprimento"))
    var c = S5Cena{}
    s5_cena_montar(&c, {})
    let a3: u32 = tipo_array(&c.sv.tipos, TIPO_F32 as u32, 3)
    expect(eh_vetor(&c.sv, a3) and not eh_vetor(&c.sv, TIPO_F32 as u32) and not eh_vetor(&c.sv, TIPO_BOOL as u32))
    expect(elemento_ou_proprio(&c.sv, a3) == (TIPO_F32 as u32) and elemento_ou_proprio(&c.sv, TIPO_I32 as u32) == (TIPO_I32 as u32))
    s5_cena_liberar(&c)
}

test "sem_vetor: sem_conta_vetor (forma, N, elemento, E0331)" {
    var c = S5Cena{}
    s5_cena_montar(&c, {})
    let f32t: u32 = TIPO_F32 as u32
    let a3: u32 = tipo_array(&c.sv.tipos, f32t, 3)
    let a4: u32 = tipo_array(&c.sv.tipos, f32t, 4)
    let i3: u32 = tipo_array(&c.sv.tipos, TIPO_I32 as u32, 3)
    var fa = s5_folha(a3, false)
    var fb = s5_folha(a3, false)
    var e = frontend.Expr{tipo_no = frontend.EX_BINARIO as u8, op = frontend.OP_SOMA as u8, a = &fa, b = &fb, pos = 4, pos_op = 6}
    expect(sem_conta_vetor(&c.sv, &e) and e.tipo == a3)
    e.op = frontend.OP_MUL as u8
    expect(sem_conta_vetor(&c.sv, &e) and e.tipo == a3)
    // array * escalar e escalar * array: o tipo e o do array
    fb = s5_folha(f32t, false)
    expect(sem_conta_vetor(&c.sv, &e) and e.tipo == a3)
    e.op = frontend.OP_DIV as u8
    expect(sem_conta_vetor(&c.sv, &e) and e.tipo == a3)
    fa = s5_folha(f32t, false)
    fb = s5_folha(a3, false)
    e.op = frontend.OP_MUL as u8
    expect(sem_conta_vetor(&c.sv, &e) and e.tipo == a3)
    // escalar / array nao existe
    e.op = frontend.OP_DIV as u8
    expect(not sem_conta_vetor(&c.sv, &e))
    expect(c.diag.codigo == common.E0331 and c.diag.off == 6 and (c.diag.causa or_else "") == "escalar / array nao existe: so array / escalar")
    // escalar + array: soma pede dois arrays
    e.op = frontend.OP_SOMA as u8
    expect(not sem_conta_vetor(&c.sv, &e))
    expect(c.diag.codigo == common.E0331 and (c.diag.causa or_else "") == "soma e subtracao pedem dois arrays [N]T do mesmo tipo (array com escalar so em * e /)")
    e.op = frontend.OP_SUB as u8
    expect(not sem_conta_vetor(&c.sv, &e) and (c.diag.causa or_else "") == "soma e subtracao pedem dois arrays [N]T do mesmo tipo (array com escalar so em * e /)")
    // resto nao existe
    fa = s5_folha(a3, false)
    e.op = frontend.OP_RESTO as u8
    expect(not sem_conta_vetor(&c.sv, &e) and (c.diag.causa or_else "") == "'%' nao existe em conta de array: use for")
    // N diferente
    fb = s5_folha(a4, false)
    e.op = frontend.OP_SOMA as u8
    expect(not sem_conta_vetor(&c.sv, &e))
    expect(c.diag.codigo == common.E0331 and c.diag.off == 6 and (c.diag.causa or_else "") == "[3]f32 e [4]f32 tem N diferente: a conta pede o mesmo N")
    // elemento nao numerico (bool)
    fb = s5_folha(tipo_array(&c.sv.tipos, TIPO_BOOL as u32, 3), false)
    expect(not sem_conta_vetor(&c.sv, &e))
    expect(c.diag.codigo == common.E0331 and (c.diag.causa or_else "") == "[3]bool nao faz conta elemento a elemento: so [N]T de numero (inteiro, real ou unidade)")
    // elementos inteiros: o resultado e o array do tipo do elemento (elementos de tipo diferente caem em erro_de_operandos de sem_aritmetica, que chega ao stub S7 sem_forma_da_regra: sem execucao)
    fa = s5_folha(i3, false)
    fb = s5_folha(i3, false)
    expect(sem_conta_vetor(&c.sv, &e) and e.tipo == i3)
    s5_cena_liberar(&c)
}

test "sem_vetor: sem_negar_vetor e sem_composta_vetor" {
    var c = S5Cena{}
    s5_cena_montar(&c, {})
    let f32t: u32 = TIPO_F32 as u32
    let a3: u32 = tipo_array(&c.sv.tipos, f32t, 3)
    var fa = s5_folha(a3, false)
    var e = frontend.Expr{tipo_no = frontend.EX_UNARIO as u8, a = &fa, pos = 4, pos_op = 6}
    expect(sem_negar_vetor(&c.sv, &e) and e.tipo == a3)
    fa = s5_folha(f32t, false)
    expect(sem_negar_vetor(&c.sv, &e) and e.tipo == f32t)
    fa = s5_folha(tipo_array(&c.sv.tipos, TIPO_U32 as u32, 2), false)
    expect(not sem_negar_vetor(&c.sv, &e))
    expect(c.diag.codigo == common.E0305 and c.diag.off == 4 and (c.diag.causa or_else "") == "'-' em inteiro sem sinal (u32)")
    fa = s5_folha(tipo_array(&c.sv.tipos, TIPO_BOOL as u32, 2), false)
    expect(not sem_negar_vetor(&c.sv, &e))
    expect(c.diag.codigo == common.E0331 and c.diag.off == 4 and (c.diag.causa or_else "") == "'-' em array pede [N]T de numero (inteiro, real ou unidade)")
    // composta: alvo += expr (a conta tem de dar o tipo do alvo)
    var alvo = s5_folha(a3, false)
    var rhs = s5_folha(a3, false)
    alvo.pos = 10
    rhs.pos = 20
    var st = frontend.Stmt{op = frontend.ATRIB_SOMA as u8, alvo = &alvo, expr = &rhs}
    expect(sem_composta_vetor(&c.sv, &st))
    st.op = 2
    expect(sem_composta_vetor(&c.sv, &st))
    // alvo [3]f32 -= f32: soma/sub pedem dois arrays
    rhs = s5_folha(f32t, false)
    expect(not sem_composta_vetor(&c.sv, &st))
    expect(c.diag.codigo == common.E0331)
    s5_cena_liberar(&c)
}

test "sem_vetor: sem_eh_swizzle, ler_letras, sem_swizzle e literal_de_indice" {
    var pre: [8]str = {"x", "xy", "zw", "rgb", "xr", "xyzw", "q", "xxxx"}
    var c = S5Cena{}
    s5_cena_montar(&c, pre[..])
    let f32t: u32 = TIPO_F32 as u32
    let a3: u32 = tipo_array(&c.sv.tipos, f32t, 3)
    var fa = s5_folha(a3, false)
    var e = frontend.Expr{tipo_no = frontend.EX_CAMPO as u8, a = &fa, nome = s5_nome(&c, "xy"), pos = 4, pos_op = 6}
    expect(sem_eh_swizzle(&c.sv, &e))
    e.nome = s5_nome(&c, "q")
    expect(not sem_eh_swizzle(&c.sv, &e))
    e.nome = s5_nome(&c, "xr")
    expect(sem_eh_swizzle(&c.sv, &e))
    fa = s5_folha(f32t, false)
    expect(not sem_eh_swizzle(&c.sv, &e))
    fa = s5_folha(tipo_array(&c.sv.tipos, TIPO_BOOL as u32, 3), false)
    expect(not sem_eh_swizzle(&c.sv, &e))
    fa = s5_folha(a3, false)
    // ler_letras: "xy" em [3]: pacote = (2 << 8) + (0 << 0) + (1 << 2) = 516 (zw: 512 + 2 + 12 = 526; rgb: 768 + 0 + 4 + 32 = 804)
    var pacote: i32 = 0
    e.nome = s5_nome(&c, "xy")
    expect(ler_letras(&c.sv, &e, 3, &pacote) and pacote == 516)
    e.nome = s5_nome(&c, "zw")
    expect(not ler_letras(&c.sv, &e, 3, &pacote))
    expect(c.diag.codigo == common.E0332 and c.diag.off == 6 and (c.diag.causa or_else "") == "a letra 'w' passa do tamanho: [3]T so tem as letras ate 'z'")
    e.nome = s5_nome(&c, "xr")
    expect(not ler_letras(&c.sv, &e, 3, &pacote))
    expect(c.diag.codigo == common.E0332 and (c.diag.causa or_else "") == "'.xr' mistura xyzw com rgba: use as letras de um grupo so")
    e.nome = s5_nome(&c, "rgb")
    expect(ler_letras(&c.sv, &e, 3, &pacote) and pacote == 804)
    // sem_swizzle de uma letra vira indice com literal em ref_id
    e.nome = s5_nome(&c, "x")
    expect(sem_swizzle(&c.sv, &e))
    expect(e.tipo_no == (frontend.EX_INDICE as u8) and e.tipo == f32t)
    let lit: ^frontend.Expr = e.b as ^frontend.Expr
    expect(lit.tipo_no == (frontend.EX_INT as u8) and lit.ref_id == 0 and lit.tipo == (TIPO_INT as u32) and lit.pos == 6 and lit.pos_op == 6 and lit.op == 1 and lit.ref == (frontend.REF_COMPONENTE as u8))
    // duas letras: componente empacotado e tipo [2]f32
    e.tipo_no = frontend.EX_CAMPO as u8
    e.nome = s5_nome(&c, "zw")
    fa = s5_folha(tipo_array(&c.sv.tipos, f32t, 4), false)
    expect(sem_swizzle(&c.sv, &e))
    expect(e.ref == (frontend.REF_COMPONENTE as u8) and e.ref_id == 526 and e.tipo == tipo_array(&c.sv.tipos, f32t, 2))
    // letras iguais: "xxxx" em [4] -> [4]f32
    e.nome = s5_nome(&c, "xxxx")
    expect(sem_swizzle(&c.sv, &e) and e.ref_id == 1024 and e.tipo == tipo_array(&c.sv.tipos, f32t, 4))
    // N fora de 2..4
    fa = s5_folha(tipo_array(&c.sv.tipos, f32t, 5), false)
    e.nome = s5_nome(&c, "xy")
    expect(not sem_swizzle(&c.sv, &e))
    expect(c.diag.codigo == common.E0332 and c.diag.off == 6 and (c.diag.causa or_else "") == "as letras x y z w (ou r g b a) so existem em [2]T, [3]T e [4]T; em [5]T use o indice")
    s5_cena_liberar(&c)
}
