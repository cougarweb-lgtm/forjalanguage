import "common"
import "frontend"

// C: semantic/sem_mapa_vistas.c:18
proc sem_chamar_vistas_do_mapa(s: ^Semantica, e: ^frontend.Expr, embutido: i32) -> bool {
    if not sem_ligar_embutido(s, e, s.params_lista[(ASS_MAPA as int)..<((ASS_MAPA as int) + 2)]) {
        return false
    }
    let m: ^frontend.Expr = (argumento_do_parametro(e, 0) as ^frontend.Arg).valor as ^frontend.Expr
    if not sem_checar(s, m, TIPO_VAZIO as u32) {
        return false
    }
    var mapa: u32 = m.tipo
    if tipo_classe_de(&s.tipos, m.tipo) == TC_PONTEIRO {
        mapa = tipo_de(&s.tipos, m.tipo).a
    }
    if tipo_classe_de(&s.tipos, mapa) != TC_MAPA {
        let texto = sem_descrever_str(s, m.tipo)
        defer delete(texto)
        let quem = sem_nome_texto(s, e.nome)
        let msg_1 = format(f"{quem} pede map[K]V (tipo {texto})", alloc = heap)
        defer delete(msg_1)
        return sem_erro(s, common.E0301, m.pos, msg_1)
    }
    var elemento: u32 = tipo_de(&s.tipos, mapa).b
    if embutido == frontend.EMB_KEYS {
        elemento = tipo_de(&s.tipos, mapa).a
    }
    if (not sem_lista_sem_dono(s, e, elemento, "duplicaria")) or (not sem_conferir_alocador(s, e, argumento_do_parametro(e, 1))) {
        return false
    }
    e.tipo = tipo_dinamico(&s.tipos, elemento)
    return true
}

// C: semantic/sem_mapa_vistas.c:36
proc sem_chamar_clear_mapa(s: ^Semantica, e: ^frontend.Expr, alvo: ?^frontend.Expr) -> bool {
    if common.c2f_s2u_32(tipo_classe_de(&s.tipos, (alvo as ^frontend.Expr).tipo)) != (TC_PONTEIRO as u32) {
        let msg_1 = format(f"clear recebe o endereco do map: clear(&m)", alloc = heap)
        defer delete(msg_1)
        return sem_erro(s, common.E0318, (alvo as ^frontend.Expr).pos, msg_1)
    }
    if not sem_conferir_clear_mapa(s, alvo) {
        return false
    }
    e.tipo = TIPO_VAZIO as u32
    return true
}

// G3 S5: testes dirigidos (so existem em `forja test`)
test "sem_mapa_vistas: sem_chamar_vistas_do_mapa (keys e values) e sem_chamar_clear_mapa" {
    var pre: [3]str = {"keys", "values", "clear"}
    var c = S5Cena{}
    s5_cena_montar(&c, pre[..])
    let i32t: u32 = TIPO_I32 as u32
    let mapa: u32 = tipo_mapa(&c.sv.tipos, TIPO_INT as u32, i32t)
    var dois: [2]u32 = {mapa, TIPO_VAZIO as u32}
    var ch = S5Chamada{}
    s5_chamada_montar(&ch, s5_nome(&c, "keys"), dois[..])
    // o 2o argumento e o alocador: alloc = heap
    ch.folhas[1] = frontend.Expr{tipo_no = frontend.EX_NOME as u8, nome = c.sv.nome_heap, pos = 101}
    expect(sem_chamar_vistas_do_mapa(&c.sv, &ch.e, frontend.EMB_KEYS) and ch.e.tipo == tipo_dinamico(&c.sv.tipos, TIPO_INT as u32))
    expect(ch.e.alocacao == (frontend.ALOC_HEAP as u8))
    ch.e.tipo = 0
    expect(sem_chamar_vistas_do_mapa(&c.sv, &ch.e, frontend.EMB_VALUES) and ch.e.tipo == tipo_dinamico(&c.sv.tipos, i32t))
    // map por ponteiro tambem vale, pelo despacho de sem_chamar_estat
    ch.folhas[0].tipo = tipo_ponteiro(&c.sv.tipos, mapa)
    ch.e.tipo = 0
    expect(sem_chamar_estat(&c.sv, &ch.e, frontend.EMB_KEYS) and ch.e.tipo == tipo_dinamico(&c.sv.tipos, TIPO_INT as u32))
    expect(sem_chamar_estat(&c.sv, &ch.e, frontend.EMB_VALUES) and ch.e.tipo == tipo_dinamico(&c.sv.tipos, i32t))
    s5_chamada_liberar(&ch)
    // clear(&m): o alvo tem de ser ponteiro (E0318); com ponteiro que nao e &m so confere o for
    var alvo = s5_folha(mapa, false)
    alvo.pos = 77
    var e = frontend.Expr{tipo_no = frontend.EX_CHAMADA as u8, pos = 5}
    expect(not sem_chamar_clear_mapa(&c.sv, &e, &alvo))
    expect(c.diag.codigo == common.E0318 and c.diag.off == 77 and (c.diag.causa or_else "") == "clear recebe o endereco do map: clear(&m)")
    alvo = s5_folha(tipo_ponteiro(&c.sv.tipos, mapa), false)
    e.tipo = 0
    expect(sem_chamar_clear_mapa(&c.sv, &e, &alvo) and e.tipo == (TIPO_VAZIO as u32))
    // (colecao que nao e map: E0301 -> sem_forma_da_regra, stub do S7: sem execucao)
    s5_cena_liberar(&c)
}
