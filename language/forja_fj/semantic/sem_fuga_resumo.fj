import "common"
import "frontend"

// C: semantic/sem_fuga_resumo.c:13
// C2F-VOID: ctx
// C2F-80: `rodada` e a tag do FugaRodada (chamar_fuga_rodada). `mudou |= rodada()` roda a rodada SEMPRE (sem curto-circuito).
proc fuga_ponto_fixo(n: u32, teto: u32, rodada: u16, ctx: rawptr) -> bool {
    for volta in (0 as u32)..<teto {
        var mudou: bool = false
        for i in (0 as u32)..<n {
            let cresceu: bool = chamar_fuga_rodada(rodada, ctx, i)
            if cresceu {
                mudou = true
            }
        }
        if not mudou {
            return true
        }
    }
    return false
}

// C: semantic/sem_fuga_resumo.c:25
// C2F-INDECIDIVEL: c
proc fuga_mascara_params(f: ^Fuga, c: []u64) -> u64 {
    var mascara: u64 = 0
    var n: u32 = 0
    while (n < f.np) and (n < (FUGA_PARAMS_MAX as u32)) {
        if fuga_tem(c, fuga_bit_param(f, n)) {
            mascara = mascara | (1 << ((n as u64) & 63))
        }
        n += 1
    }
    return mascara
}

// C: semantic/sem_fuga_resumo.c:34
// C2F-INDECIDIVEL: c
proc fuga_mascara_flags(f: ^Fuga, c: []u64) -> u8 {
    var mascara: u8 = 0
    for g in (0 as u32)..<(FUGA_FLAGS as u32) {
        if fuga_tem(c, fuga_bit_flag(f, g as i32)) {
            mascara = mascara | ((1 << (g & 7)) as u8)
        }
    }
    return mascara
}

// C: semantic/sem_fuga_resumo.c:45
proc somar_mascara(f: ^Fuga, destino: ^u64, mascara: u64) {
    if (mascara & (~destino^)) == 0 {
        return
    }
    destino^ = destino^ | mascara
    let ptr_1: ^FugaTabela = f.tab as ^FugaTabela
    ptr_1.mudou = true
}

// C: semantic/sem_fuga_resumo.c:52
// C2F-INDECIDIVEL: v
proc fuga_registrar_retorno(f: ^Fuga, v: []u64) {
    let flags_c: u8 = fuga_mascara_flags(f, v)
    let arg_1: u64 = fuga_mascara_params(f, v)
    let arg_2: ^u64 = &(f.meu as ^FugaResumo).retorno_de
    let arg_3: ^Fuga = f
    somar_mascara(arg_3, arg_2, arg_1)
    if common.c2f_e_i32(flags_c as i32, common.c2f_nao_i32((f.meu as ^FugaResumo).flags as i32)) == 0 {
        return
    }
    let ptr_1: ^FugaResumo = f.meu as ^FugaResumo
    ptr_1.flags = ptr_1.flags | ((flags_c as i32) as u8)
    let ptr_2: ^FugaTabela = f.tab as ^FugaTabela
    ptr_2.mudou = true
}

// C: semantic/sem_fuga_resumo.c:62
// C2F-INDECIDIVEL: p, v
proc fuga_registrar_guarda(f: ^Fuga, p: []u64, v: []u64) {
    let mascara: u64 = fuga_mascara_params(f, v)
    if mascara == 0 {
        return
    }
    let guarda: []u64 = (f.meu as ^FugaResumo).guarda or_else {}
    for d in (0 as u32)..<f.np {
        if fuga_tem(p, fuga_bit_param(f, d)) {
            somar_mascara(f, &guarda[d], mascara)
        }
    }
    if fuga_mascara_flags(f, p) != 0 {
        somar_mascara(f, &guarda[f.np], mascara)
    }
}

// C: semantic/sem_fuga_resumo.c:73
proc fuga_resumo_de(f: ^Fuga, d: ?^frontend.Decl) -> ?^FugaResumo {
    if (((common.c2f_b2i32((d as ^frontend.Decl).externo) != 0) or ((d as ^frontend.Decl).tipo_no != (frontend.D_PROC as u8))) or ((d as ^frontend.Decl).indice < 0)) or (common.c2f_s2u_32((d as ^frontend.Decl).indice) >= (f.tab as ^FugaTabela).n) {
        return none
    }
    let r: ^FugaResumo = &((f.tab as ^FugaTabela).proc_c or_else {})[(d as ^frontend.Decl).indice]
    var tern_1: ?^FugaResumo = r
    if r.guarda == none {
        tern_1 = none
    }
    return tern_1
}

// C: semantic/sem_fuga_resumo.c:82
// C2F-INDECIDIVEL: dst
proc fuga_resultado_da_chamada(f: ^Fuga, e: ?^frontend.Expr, dst: []u64) {
    var tern_1: ?^frontend.Decl = none
    if (e as ^frontend.Expr).ref == (frontend.REF_PROC as u8) {
        tern_1 = sem_achar_simbolo(f.s as ^Semantica, (e as ^frontend.Expr).nome, (e as ^frontend.Expr).modulo).decl
    }
    let decl: ?^frontend.Decl = tern_1
    var tern_2: ?^FugaResumo = none
    if decl == none {
        tern_2 = none
    } else {
        tern_2 = fuga_resumo_de(f, decl)
    }
    let r: ?^FugaResumo = tern_2
    if r == none {
        var tern_3: i32 = FUGA_DESC
        if (decl != none) and (common.c2f_b2i32((decl as ^frontend.Decl).externo) != 0) {
            tern_3 = FUGA_FOREIGN
        }
        fuga_ligar_flag(f, dst, tern_3)
        return
    }
    for g in (0 as u32)..<(FUGA_FLAGS as u32) {
        if common.c2f_e_i32(common.c2f_sar_i32((r as ^FugaResumo).flags as i32, g), 1) != 0 {
            fuga_ligar_flag(f, dst, transmute(g, to = i32))
        }
    }
    var k: u32 = 0
    while k < (e as ^frontend.Expr).nargs {
        let i: u32 = common.c2f_s2u_32(((e as ^frontend.Expr).args or_else {})[k].indice)
        if (i < (FUGA_PARAMS_MAX as u32)) and ((((r as ^FugaResumo).retorno_de >> ((i as u64) & 63)) & 1) != 0) {
            fuga_avaliar(f, ((e as ^frontend.Expr).args or_else {})[k].valor, dst)
        }
        k += 1
    }
}

// C: semantic/sem_fuga_resumo.c:101
proc corpo_de(c: ^CorposDaFuga, i: u32) -> ^frontend.Decl {
    return c.corpos[i as u64] as ^frontend.Decl
}

// C: semantic/sem_fuga_resumo.c:106
proc fuga_corpos_iniciar(c: ^CorposDaFuga, s: ^Semantica) {
    c^ = CorposDaFuga{s = s}
    c.corpos = make([dynamic]?^frontend.Decl, alloc = heap)
    c.tab.rascunho = make([dynamic]u64, alloc = heap)
}

// C: semantic/sem_fuga_resumo.c:113
proc fuga_corpos_liberar(c: ^CorposDaFuga) {
    delete(c.corpos)
    delete(c.tab.rascunho)
}

// C: semantic/sem_fuga_resumo.c:122
proc fuga_corpos_registrar(c: ^CorposDaFuga, d: ?^frontend.Decl) {
    let decl: ^frontend.Decl = d as ^frontend.Decl
    let arena: ^common.Arena = (c.s as ^Semantica).arena as ^common.Arena
    if not decl.fuga_relevante {
        return
    }
    if c.tab.proc_c == none {
        c.tab.n = (c.s as ^Semantica).qtd_proc
        c.tab.proc_c = arena_fatia_fuga_resumo(arena, (c.tab.n as int) + 1)
    }
    append(&c.corpos, item = d)
    if decl.tipo_no != (frontend.D_PROC as u8) {
        return
    }
    c.nprocs += 1
    if (decl.indice < 0) or (common.c2f_s2u_32(decl.indice) >= c.tab.n) {
        return
    }
    let r: ^FugaResumo = &(c.tab.proc_c or_else {})[decl.indice]
    r.nparams = decl.nparams
    r.guarda = common.arena_fatia_u64(arena, (decl.nparams as int) + 1)
}

// C: semantic/sem_fuga_resumo.c:140
// C2F-VOID: ctx
proc rodada_do_corpo(ctx: rawptr, i: u32) -> bool {
    let c: ^CorposDaFuga = ctx as ^CorposDaFuga
    let d: ^frontend.Decl = corpo_de(c, i)
    if d.tipo_no != (frontend.D_PROC as u8) {
        return false
    }
    c.tab.mudou = false
    let suspeito: []bool = c.suspeito or_else {}
    suspeito[i] = not sem_fuga_proc(c.s as ^Semantica, d, &c.tab, true)
    return c.tab.mudou
}

// C: semantic/sem_fuga_resumo.c:152
proc conferir_corpos(c: ^CorposDaFuga) -> bool {
    var ok: bool = true
    var i: u32 = 0
    while (i as u64) < (len(c.corpos) as u64) {
        let d: ^frontend.Decl = corpo_de(c, i)
        if ((not (c.suspeito or_else {})[i]) and (d.tipo_no != (frontend.D_TEST as u8))) or (common.c2f_b2i32(sem_fuga_proc(c.s as ^Semantica, d, &c.tab, false)) != 0) {
            i += 1
            continue
        }
        ok = false
        if not ((c.s as ^Semantica).diag as ^common.Diag).tem {
            i += 1
            continue
        }
        d.com_erro = true
        if not sem_guardar_erro(c.s as ^Semantica, d.modulo) {
            break
        }
        i += 1
    }
    return ok
}

// C: semantic/sem_fuga_resumo.c:169
proc sem_fuga_programa(c: ^CorposDaFuga) -> bool {
    c.suspeito = common.arena_fatia_bool((c.s as ^Semantica).arena as ^common.Arena, len(c.corpos) + 1)
    return fuga_ponto_fixo(len(c.corpos) as u32, c.nprocs + 1, FUGA_RODADA_RODADA_DO_CORPO, c as rawptr) and conferir_corpos(c)
}

// ---------------------------------------------------------------- G3 S6: testes de resumo, ponto fixo e programa

test "sem_fuga_resumo: fuga_ponto_fixo respeita o teto (0 voltas = nao fecha; sem corpos fecha na 1a)" {
    let c = s6_cen_novo("proc g() {}\n")
    defer s6_cen_liberar(c)
    var cp: CorposDaFuga = CorposDaFuga{}
    expect(not fuga_ponto_fixo(0, 0, FUGA_RODADA_RODADA_DO_CORPO, &cp as rawptr))
    expect(fuga_ponto_fixo(0, 1, FUGA_RODADA_RODADA_DO_CORPO, &cp as rawptr))
}

// proc h(a: ^int, l: ^[dynamic]^int) { append(l, item = a) }  +  proc g(l: ^[dynamic]^int) { var x: int = 1  h(&x, l) }
// (valor do E0706 e da cadeia = saida real do forja.exe em ps6_t\t5.fj)
test "sem_fuga_resumo: programa com 2 procs (ponto fixo propaga o resumo de h para g) -> E0706 por callee; registrar_retorno/guarda; resultado da chamada" {
    let c = s6_cen_novo("proc h(a: ^int, l: ^[dynamic]^int) {\n    append(l, item = a)\n}\nproc g(l: ^[dynamic]^int) {\n    var x: int = 1\n    h(&x, l)\n}\n")
    defer s6_cen_liberar(c)
    let s: ^Semantica = &c.s
    let arena: ^common.Arena = s.arena as ^common.Arena
    let t_p: u32 = tipo_ponteiro(&s.tipos, TIPO_INT as u32)
    let t_pdp: u32 = tipo_ponteiro(&s.tipos, tipo_dinamico(&s.tipos, t_p))
    let n_a = s6_nome(c, "a")
    let n_l = s6_nome(c, "l")
    let n_x = s6_nome(c, "x")
    let n_h = s6_nome(c, "h")
    let n_g = s6_nome(c, "g")
    // h
    let nome_l_h = s6_ex_nome(s, n_l, 1, t_pdp, 48)
    nome_l_h.ref = frontend.REF_PARAM as u8
    let nome_a_h = s6_ex_nome(s, n_a, 0, t_p, 58)
    nome_a_h.ref = frontend.REF_PARAM as u8
    let corpo_h = s6_ch(s, 41, s6_ex_embutido2(s, frontend.EMB_APPEND, s6_nome(c, "append"), 41, nome_l_h, nome_a_h))
    var nl_h: [2]i32 = {n_a, n_l}
    let h = s6_decl_proc(s, n_h, nl_h[..], 2, corpo_h)
    var ph = make([dynamic]frontend.Param, alloc = common.arena_mem(arena), cap = 2)
    append(&ph, item = frontend.Param{nome = n_a, pos = 7, tipo = frontend.TipoRef{tipo = t_p}})
    append(&ph, item = frontend.Param{nome = n_l, pos = 16, tipo = frontend.TipoRef{tipo = t_pdp}})
    h.params = ph[..]
    h.indice = 0
    h.fuga_relevante = true
    // g
    let nome_l_g = s6_ex_nome(s, n_l, 0, t_pdp, 120)
    nome_l_g.ref = frontend.REF_PARAM as u8
    let end_x = s6_ex_unario(s, frontend.OP_ENDERECO, s6_ex_nome(s, n_x, 1, TIPO_INT as u32, 117), t_p, 116)
    let chamada_h = s6_ex_embutido2(s, 0, n_h, 114, end_x, nome_l_g)
    chamada_h.ref = frontend.REF_PROC as u8
    let corpo_g = s6_liga(s6_st_local(s, frontend.ST_VAR, 95, n_x, 1, TIPO_INT as u32, s6_ex_int(s, 108)), s6_ch(s, 114, chamada_h))
    var nl_g: [2]i32 = {n_l, n_x}
    let g = s6_decl_proc(s, n_g, nl_g[..], 1, corpo_g)
    var um: [1]i32 = {n_l}
    g.params = s6_params(s, um[..], t_pdp)
    g.indice = 1
    g.fuga_relevante = true
    s.qtd_proc = 2
    let globais: []Simbolo = s.globais or_else {}
    globais[n_h].decl = h
    var cp: CorposDaFuga = CorposDaFuga{}
    fuga_corpos_iniciar(&cp, s)
    defer fuga_corpos_liberar(&cp)
    fuga_corpos_registrar(&cp, h)
    fuga_corpos_registrar(&cp, g)
    expect(cp.tab.n == 2 and len(cp.corpos) == 2 and cp.nprocs == 2)
    let tabela: []FugaResumo = cp.tab.proc_c or_else {}
    expect(tabela[0].nparams == 2 and len(tabela[0].guarda or_else {}) == 3 and tabela[1].nparams == 1 and len(tabela[1].guarda or_else {}) == 2)
    expect(not sem_fuga_programa(&cp))
    // resumo de h: o parametro a (bit 0) e guardado em l (destino 1); nada e devolvido
    let guarda_h: []u64 = tabela[0].guarda or_else {}
    expect(guarda_h[0] == 0 and guarda_h[1] == 1 and guarda_h[2] == 0 and tabela[0].retorno_de == 0 and tabela[0].flags == 0)
    let suspeito: []bool = cp.suspeito or_else {}
    expect(not suspeito[0] and suspeito[1]) // so g tem local cujo endereco foge
    expect(g.com_erro and not h.com_erro)
    expect(s.lista.n == 1)
    let e = &s.lista.itens[0]
    expect(e.codigo == common.E0706 and e.off == 116)
    expect((e.causa or_else "") == "'x' e local de 'g' e o proc 'h' guarda o parametro 'a' em memoria que sobrevive a chamada: x -> chamada a h")
    expect((e.extras or_else "") == "\"cadeia\": [\"x (local, 5:9)\", \"chamada a h (6:5)\"]")
    // registrar_retorno (somar_mascara avisa a tabela so quando cresce)
    var fh: Fuga = Fuga{}
    fuga_iniciar(&fh, s, h, &cp.tab)
    defer delete(fh.prov)
    expect(fh.meu == &tabela[0])
    fuga_zerar(&fh, fh.v)
    fuga_ligar(fh.v, fuga_bit_param(&fh, 0))
    fuga_ligar_flag(&fh, fh.v, FUGA_HEAP)
    cp.tab.mudou = false
    fuga_registrar_retorno(&fh, fh.v)
    expect(tabela[0].retorno_de == 1 and tabela[0].flags == 2 and cp.tab.mudou)
    cp.tab.mudou = false
    fuga_registrar_retorno(&fh, fh.v)
    expect(not cp.tab.mudou) // nada novo
    // resultado da chamada h(&x, l): flags do resumo (HEAP) + so os argumentos que o retorno carrega (param 0 = &x)
    var fg: Fuga = Fuga{}
    fuga_iniciar(&fg, s, g, &cp.tab)
    defer delete(fg.prov)
    expect(fuga_resumo_de(&fg, h) != none)
    h.externo = true
    expect(fuga_resumo_de(&fg, h) == none) // foreign nao tem resumo
    h.externo = false
    h.indice = -1
    expect(fuga_resumo_de(&fg, h) == none)
    h.indice = 0
    fuga_zerar(&fg, fg.v)
    fuga_resultado_da_chamada(&fg, chamada_h, fg.v)
    expect(fg.v[0] == 18) // bit LOCAL x (1<<1) + FUGA_HEAP (nl+np+1 = 4 -> 1<<4)
    // chamada sem decl = DESC ; decl externo = FOREIGN
    let n_zz = s6_nome(c, "zz")
    let n_ee = s6_nome(c, "ee")
    let chama_zz = s6_ex_embutido2(s, 0, n_zz, 0, end_x, nome_l_g)
    chama_zz.ref = frontend.REF_PROC as u8
    fuga_zerar(&fg, fg.v)
    fuga_resultado_da_chamada(&fg, chama_zz, fg.v)
    expect(fg.v[0] == 64) // FUGA_DESC = 1 << (3 + 3)
    let ext = s4_novo_decl(s)
    ext.tipo_no = frontend.D_PROC as u8
    ext.externo = true
    globais[n_ee].decl = ext
    let chama_ee = s6_ex_embutido2(s, 0, n_ee, 0, end_x, nome_l_g)
    chama_ee.ref = frontend.REF_PROC as u8
    fuga_zerar(&fg, fg.v)
    fuga_resultado_da_chamada(&fg, chama_ee, fg.v)
    expect(fg.v[0] == 32) // FUGA_FOREIGN = 1 << (3 + 2)
    // registrar_guarda: p = {param 0}, v = {param 1} -> guarda[0] |= 2 ; flags em p -> guarda[np] |= 2
    fuga_zerar(&fh, fh.v)
    fuga_zerar(&fh, fh.p or_else {})
    fuga_ligar(fh.v, fuga_bit_param(&fh, 1))
    fuga_ligar(fh.p or_else {}, fuga_bit_param(&fh, 0))
    cp.tab.mudou = false
    fuga_registrar_guarda(&fh, fh.p or_else {}, fh.v)
    expect(guarda_h[0] == 2 and guarda_h[1] == 1 and cp.tab.mudou)
    fuga_ligar_flag(&fh, fh.p or_else {}, FUGA_GLOBAL)
    fuga_registrar_guarda(&fh, fh.p or_else {}, fh.v)
    expect(guarda_h[2] == 2)
    fuga_zerar(&fh, fh.v) // sem parametros em v: nada a registrar
    cp.tab.mudou = false
    fuga_registrar_guarda(&fh, fh.p or_else {}, fh.v)
    expect(not cp.tab.mudou)
}
