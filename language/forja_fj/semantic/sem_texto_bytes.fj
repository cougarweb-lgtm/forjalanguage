import "common"
import "frontend"

// C: semantic/sem_texto_bytes.c:16
proc sem_chamar_clone_texto(s: ^Semantica, e: ^frontend.Expr) -> bool {
    if (not sem_conferir_alocador(s, e, argumento_do_parametro(e, 1))) or (not sem_f_texto_do_argumento(s, e)) {
        return false
    }
    e.tipo = TIPO_STR as u32
    return true
}

// C: semantic/sem_texto_bytes.c:24
proc vista_de_texto(s: ^Semantica, chamada: ^frontend.Expr, bytes: ?^frontend.Expr) -> ^frontend.Expr {
    let vista: ^frontend.Expr = s4_novo_expr(s)
    let argumento = frontend.arena_fatia_arg(s.arena as ^common.Arena, 1)
    argumento[0] = frontend.Arg{nome = -1, pos_nome = (bytes as ^frontend.Expr).pos, valor = bytes, indice = 0}
    vista.tipo_no = frontend.EX_CHAMADA as u8
    vista.ref = frontend.REF_EMBUTIDO as u8
    vista.ref_id = frontend.EMB_TRANSMUTE
    vista.nome = chamada.nome
    vista.pos = (bytes as ^frontend.Expr).pos
    vista.pos_op = chamada.pos_op
    vista.args = argumento
    vista.nargs = 1
    vista.tipo = TIPO_STR as u32
    return vista
}

// C: semantic/sem_texto_bytes.c:42
proc sem_chamar_from_bytes(s: ^Semantica, e: ^frontend.Expr) -> bool {
    var elemento: u32 = 0
    if not sem_ligar_embutido(s, e, s.params_lista[(ASS_BYTES as int)..<((ASS_BYTES as int) + 2)]) {
        return false
    }
    if not sem_checar(s, (argumento_do_parametro(e, 0) as ^frontend.Arg).valor, TIPO_VAZIO as u32) {
        return false
    }
    if not sem_colecao_ja_checada(s, e, 0, false, &elemento) {
        return false
    }
    if elemento != (TIPO_U8 as u32) {
        let texto = s4_descrever(s, elemento)
        defer delete(texto)
        let msg_1 = format(f"from_bytes pede lista, array ou fatia de u8 (elemento {texto})", alloc = heap)
        defer delete(msg_1)
        return sem_erro(s, common.E0301, e.pos_op, msg_1)
    }
    if not sem_conferir_alocador(s, e, argumento_do_parametro(e, 1)) {
        return false
    }
    let args_e = e.args or_else {}
    args_e[0].valor = vista_de_texto(s, e, args_e[0].valor)
    if not sem_f_texto_do_argumento(s, e) {
        return false
    }
    e.tipo = TIPO_STR as u32
    return true
}

// C: semantic/sem_texto_bytes.c:61
proc sem_chamar_as_bytes(s: ^Semantica, e: ^frontend.Expr) -> bool {
    if not sem_ligar_embutido(s, e, s.params_lista[(ASS_TEXTO as int)..<((ASS_TEXTO as int) + 1)]) {
        return false
    }
    let alvo: ?^frontend.Expr = (argumento_do_parametro(e, 0) as ^frontend.Arg).valor
    if not sem_checar(s, alvo, TIPO_VAZIO as u32) {
        return false
    }
    if (alvo as ^frontend.Expr).tipo != (TIPO_STR as u32) {
        let texto = s4_descrever(s, (alvo as ^frontend.Expr).tipo)
        defer delete(texto)
        let msg_1 = format(f"as_bytes pede str (tipo {texto})", alloc = heap)
        defer delete(msg_1)
        return sem_erro(s, common.E0301, (alvo as ^frontend.Expr).pos, msg_1)
    }
    e.tipo = tipo_fatia(&s.tipos, TIPO_U8 as u32)
    return true
}

// G3 S4: a vista de texto e uma chamada transmute com o 1o argumento = os bytes, tipo str, posicao dos bytes e a do operador da chamada original
test "sem_texto_bytes: vista_de_texto" {
    var arenas = make([dynamic]common.Arena, alloc = heap)
    append(&arenas, item = common.Arena{})
    let arena: ^common.Arena = &arenas[0]
    var sv: Semantica = Semantica{}
    sv.arena = arena
    var chamada: frontend.Expr = frontend.Expr{nome = 33, pos_op = 12, pos = 10}
    let bytes: ^frontend.Expr = s4_novo_expr(&sv)
    bytes.pos = 21
    let v = vista_de_texto(&sv, &chamada, bytes)
    expect(v.tipo_no == (frontend.EX_CHAMADA as u8) and v.ref == (frontend.REF_EMBUTIDO as u8) and v.ref_id == frontend.EMB_TRANSMUTE)
    expect(v.nome == 33 and v.pos == 21 and v.pos_op == 12 and v.nargs == 1 and v.tipo == (TIPO_STR as u32))
    let a = v.args or_else {}
    expect(len(a) == 1 and a[0].nome == -1 and a[0].pos_nome == 21 and a[0].indice == 0 and a[0].valor == bytes)
    common.arena_liberar(arena)
    delete(arenas)
}
