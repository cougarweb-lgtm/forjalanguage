import "common"
import "frontend"

struct Saida {
    dados: []u8
    tam: u64
    cap: u64
}

// C: semantic/sem_nome.c:21
proc eh_maiuscula(c: u8) -> bool {
    return (common.c2f_char_i32(c) >= 65) and (common.c2f_char_i32(c) <= 90) // 'A' 'Z'
}

// C: semantic/sem_nome.c:22
proc eh_minuscula(c: u8) -> bool {
    return (common.c2f_char_i32(c) >= 97) and (common.c2f_char_i32(c) <= 122) // 'a' 'z'
}

// C: semantic/sem_nome.c:23
proc eh_digito_2(c: u8) -> bool {
    return (common.c2f_char_i32(c) >= 48) and (common.c2f_char_i32(c) <= 57) // '0' '9'
}

// C: semantic/sem_nome.c:24
proc eh_espaco(c: u8) -> bool {
    return (c == 32) or (c == 9) // ' ' '\t'
}

// C: semantic/sem_nome.c:25
proc eh_letra_ou_digito(c: u8) -> bool {
    return ((common.c2f_b2i32(eh_maiuscula(c)) != 0) or (common.c2f_b2i32(eh_minuscula(c)) != 0)) or (common.c2f_b2i32(eh_digito_2(c)) != 0)
}

// C: semantic/sem_nome.c:27
proc primeiro_valido(c: u8, caixa: i32) -> bool {
    var tern_1: i32 = 0
    if common.c2f_s2u_32(caixa) == (CAIXA_SNAKE as u32) {
        tern_1 = common.c2f_b2i32((common.c2f_b2i32(eh_minuscula(c)) != 0) or (c == 95))
    } else {
        tern_1 = common.c2f_b2i32(eh_maiuscula(c))
    }
    return tern_1 != 0 // '_'
}

// C: semantic/sem_nome.c:32
proc resto_valido(c: u8, caixa: i32) -> bool {
    if common.c2f_s2u_32(caixa) == (CAIXA_PASCAL as u32) {
        return eh_letra_ou_digito(c)
    }
    if common.c2f_s2u_32(caixa) == (CAIXA_MAIUSCULA as u32) {
        return ((common.c2f_b2i32(eh_maiuscula(c)) != 0) or (common.c2f_b2i32(eh_digito_2(c)) != 0)) or (c == 95) // '_'
    }
    return ((common.c2f_b2i32(eh_minuscula(c)) != 0) or (common.c2f_b2i32(eh_digito_2(c)) != 0)) or (c == 95) // '_'
}

// C: semantic/sem_nome.c:39
proc caixa_confere(nome: str, tam: u32, caixa: i32) -> bool {
    if (tam == 0) or (not primeiro_valido(nome[0], caixa)) {
        return false
    }
    for i in (1 as u32)..<tam {
        if not resto_valido(nome[i], caixa) {
            return false
        }
    }
    return true
}

// C: semantic/sem_nome.c:50
proc empurrar(o: ^Saida, c: u8) {
    if (o.tam + 1) < o.cap {
        let antes_1: u64 = o.tam
        o.tam += 1
        o.dados[antes_1] = c
    }
    o.dados[o.tam] = 0 // '\0'
}

// C: semantic/sem_nome.c:56
proc sem_minusculas(nome: str, tam: u32) -> bool {
    for i in (0 as u32)..<tam {
        if eh_minuscula(nome[i]) {
            return false
        }
    }
    return true
}

// C: semantic/sem_nome.c:64
proc minuscula(c: u8) -> u8 {
    var tern_1: i32 = common.c2f_char_i32(c)
    if common.c2f_b2i32(eh_maiuscula(c)) != 0 {
        tern_1 = (((common.c2f_char_i32(c) - 65) + 97) as u8) as i32
    }
    return tern_1 as u8 // 'A' 'a'
}

// C: semantic/sem_nome.c:65
proc maiuscula(c: u8) -> u8 {
    var tern_1: i32 = common.c2f_char_i32(c)
    if common.c2f_b2i32(eh_minuscula(c)) != 0 {
        tern_1 = (((common.c2f_char_i32(c) - 97) + 65) as u8) as i32
    }
    return tern_1 as u8 // 'a' 'A'
}

// C: semantic/sem_nome.c:68
// "meu_tipo" / "METROS" -> "MeuTipo" / "Metros".
proc sugerir_pascal(nome: str, tam: u32, o: ^Saida) {
    var inicio: bool = true
    let tudo_maiusculo: bool = sem_minusculas(nome, tam)
    for i in (0 as u32)..<tam {
        if nome[i] == 95 { // '_'
            inicio = true
            continue
        }
        var c: u8 = nome[i]
        if inicio {
            c = maiuscula(nome[i])
        } else if tudo_maiusculo {
            c = minuscula(nome[i])
        }
        empurrar(o, c)
        inicio = false
    }
}

// C: semantic/sem_nome.c:82
proc sugerir_com_sublinhado(nome: str, tam: u32, caixa: i32, o: ^Saida) {
    for i in (0 as u32)..<tam {
        let quebra: bool = (((i > 0) and (common.c2f_b2i32(eh_maiuscula(nome[i])) != 0)) and (not eh_maiuscula(nome[i - 1]))) and (nome[i - 1] != 95) // '_'
        if quebra {
            empurrar(o, 95) // '_'
        }
        var tern_1: i32 = 0
        if common.c2f_s2u_32(caixa) == (CAIXA_MAIUSCULA as u32) {
            tern_1 = maiuscula(nome[i]) as i32
        } else {
            tern_1 = minuscula(nome[i]) as i32
        }
        empurrar(o, tern_1 as u8)
    }
}

// C: semantic/sem_nome.c:97
proc sem_verificar_caixa(s: ^Semantica, nome: i32, pos: u32, caixa: i32) -> bool {
    let texto: str = sem_nome_texto(s, nome)
    let tam: u32 = common.interner_tam(nomes_da_sem(s), nome)
    var buffer: [128]u8 = {}
    var o: Saida = Saida{dados = buffer[..], tam = 0, cap = 128}
    if (SEM_VERIFICA_CAIXA == 0) or caixa_confere(texto, tam, caixa) {
        return true
    }
    buffer[0] = 0
    if caixa == CAIXA_PASCAL {
        sugerir_pascal(texto, tam, &o)
    } else {
        sugerir_com_sublinhado(texto, tam, caixa, &o)
    }
    // C2F-A0: REGRA[caixa] (tabela de 3 textos)
    var regra: str = "proc, parametro, campo, membro de enum e variavel usam snake_case"
    if caixa == CAIXA_PASCAL {
        regra = "tipo, unidade, struct e enum usam PascalCase"
    } else if caixa == CAIXA_MAIUSCULA {
        regra = "constante usa MAIUSCULO_COM_SUBLINHADO"
    }
    let sugestao = from_bytes(buffer[0..<common.c2f_strlen_b(buffer[..])], alloc = heap)
    defer delete(sugestao)
    let msg_1 = format(f"o nome '{texto}' esta na caixa errada ({regra}); use '{sugestao}'", alloc = heap)
    defer delete(msg_1)
    _ = sem_erro(s, common.E0102, pos, msg_1)
    sem_sugerir_caixa(s, nome, pos, sugestao)
    return false
}

// C: semantic/sem_nome.c:112
proc caminho_do_modulo(s: ^Semantica, modulo: u8) -> str {
    return sem_nome_texto(s, modulos_da_sem(s).itens[modulo].caminho)
}

// C: semantic/sem_nome.c:118
// Caminho lento da visibilidade (v1.8): o nome e de outro modulo, ou foi escrito com apelido. Erros E1003 em u.pos.
proc sem_visivel_lento(s: ^Semantica, y: ?^Simbolo, u: ^NomeUsado) -> bool {
    let sim: ^Simbolo = y as ^Simbolo
    let nome: str = sem_nome_texto(s, u.nome)
    if (u.modulo == 0) and (sim.decl != none) and ((sim.decl == s.decl_quat) or (sim.decl == s.decl_allocator)) {
        return true // v1.11 L14a: o quat e da linguagem, vale em todo modulo; B01a: o Allocator tambem
    }
    sem_higiene_import_usado(s, u.modulo)
    if u.modulo == 0 {
        let msg_1 = format(f"'{nome}' e do modulo \"{caminho_do_modulo(s, (sim.decl as ^frontend.Decl).modulo)}\": importe-o e escreva apelido.{nome}", alloc = heap)
        defer delete(msg_1)
        _ = sem_erro(s, common.E1003, u.pos, msg_1)
        sem_sugerir_qualificar(s, u, sim.decl)
        return false
    }
    if (sim.decl == none) and (sim.categoria != (SIM_NENHUM as u8)) {
        let msg_2 = format(f"'{nome}' e da linguagem, nao do modulo \"{caminho_do_modulo(s, u.modulo)}\": escreva sem apelido", alloc = heap)
        defer delete(msg_2)
        return sem_erro(s, common.E1003, u.pos, msg_2)
    }
    if (sim.decl == none) or ((sim.decl as ^frontend.Decl).modulo != u.modulo) {
        var sp: SemParecido = SemParecido{}
        sem_parecido_iniciar(s, common.E1003, u.pos, u.nome, &sp)
        sem_parecidos_de_nome(s, u.modulo, &sp)
        let msg_3 = format(f"'{nome}' nao existe no modulo \"{caminho_do_modulo(s, u.modulo)}\"", alloc = heap)
        defer delete(msg_3)
        return sem_erro_parecido(s, &sp, msg_3)
    }
    if not (sim.decl as ^frontend.Decl).publico {
        var sp: SemParecido = SemParecido{}
        sem_parecido_iniciar(s, common.E1003, u.pos, u.nome, &sp)
        sem_parecidos_de_nome(s, u.modulo, &sp)
        let msg_4 = format(f"'{nome}' existe no modulo \"{caminho_do_modulo(s, u.modulo)}\" mas nao e pub", alloc = heap)
        defer delete(msg_4)
        return sem_erro_parecido(s, &sp, msg_4)
    }
    return true
}

// C: semantic/sem_nome.c:148
// v1.8 (D2): nome de topo unico no programa; 'y' declarado em outro modulo diz qual.
proc erro_nome_repetido(s: ^Semantica, nome: i32, pos: u32, y: ^Simbolo) -> bool {
    if (y.decl != none) and ((y.decl as ^frontend.Decl).modulo != s.modulo_atual) {
        let msg_1 = format(f"'{sem_nome_texto(s, nome)}' ja foi declarado no modulo \"{caminho_do_modulo(s, (y.decl as ^frontend.Decl).modulo)}\" (nomes de topo sao unicos no programa)", alloc = heap)
        defer delete(msg_1)
        return sem_erro(s, common.E0202, pos, msg_1)
    }
    if (y.decl != none) and (common.fonte_trecho_do_offset(s.fonte, (y.decl as ^frontend.Decl).pos) != s.arquivo_atual) { // v1.13: outro arquivo do mesmo pacote
        let antes: common.FontePosicao = common.fonte_localizar_no_arquivo(s.fonte, (y.decl as ^frontend.Decl).pos)
        let caminho: str = antes.caminho or_else "(null)" // o %s de NULL do mingw
        let msg_2 = format(f"'{sem_nome_texto(s, nome)}' ja declarado em {caminho}:{antes.linha} (mesmo pacote)", alloc = heap)
        defer delete(msg_2)
        return sem_erro(s, common.E0202, pos, msg_2)
    }
    let msg_3 = format(f"o nome '{sem_nome_texto(s, nome)}' ja foi declarado", alloc = heap)
    defer delete(msg_3)
    return sem_erro(s, common.E0202, pos, msg_3)
}

// C: semantic/sem_nome.c:162
// v1.8: um import deste arquivo ja usa o nome como apelido.
proc conflita_com_apelido(s: ^Semantica, nome: i32, pos: u32) -> bool {
    if (s.qtd_modulos <= 1) or (not frontend.modulos_apelido_no_pacote(modulos_da_sem(s), s.modulo_atual, nome)) {
        return false
    }
    let msg_1 = format(f"'{sem_nome_texto(s, nome)}' e o apelido de um import deste arquivo", alloc = heap)
    defer delete(msg_1)
    return not sem_erro(s, common.E0202, pos, msg_1)
}

// C: semantic/sem_nome.c:169
proc sem_declarar_global(s: ^Semantica, d: ^frontend.Decl, novo: ^Simbolo) -> bool {
    let y: ^Simbolo = &(s.globais or_else {})[d.chave]
    if conflita_com_apelido(s, d.nome, d.pos) {
        return false
    }
    if common.c2f_b2i32(d.nome == frontend.SYM_ALLOCATOR) != 0 {
        let msg_1 = format(f"o nome '{sem_nome_texto(s, d.nome)}' e reservado pela linguagem", alloc = heap)
        defer delete(msg_1)
        return sem_erro(s, common.E0202, d.pos, msg_1)
    }
    if (d.chave != d.nome) and ((s.globais or_else {})[d.nome].categoria == (SIM_PROC_EMBUTIDO as u8)) {
        let msg_2 = format(f"o nome '{sem_nome_texto(s, d.nome)}' e reservado pela linguagem", alloc = heap)
        defer delete(msg_2)
        return sem_erro(s, common.E0202, d.pos, msg_2)
    }
    if (y.categoria == (SIM_NENHUM as u8)) or (((y.envenenado as i32) != 0) and (y.tipo == (TIPO_VENENO as u32))) {
        y^ = novo^
        return true
    }
    if y.categoria == (SIM_PROC_EMBUTIDO as u8) {
        let msg_3 = format(f"o nome '{sem_nome_texto(s, d.nome)}' e reservado pela linguagem", alloc = heap)
        defer delete(msg_3)
        return sem_erro(s, common.E0202, d.pos, msg_3)
    }
    return erro_nome_repetido(s, d.nome, d.pos, y)
}

// C: semantic/sem_nome.c:190
proc decl_do_modulo(s: ^Semantica, nome: i32, modulo: u8) -> ?^frontend.Decl {
    if s.homonimos == none {
        return none
    }
    var d: ?^frontend.Decl = (s.homonimos or_else {})[nome]
    while d != none {
        if ((d as ^frontend.Decl).modulo as i32) == (modulo as i32) {
            return d
        }
        d = (d as ^frontend.Decl).homonimo
    }
    return none
}

// C: semantic/sem_nome.c:200
proc simbolo_de_outro_modulo(s: ^Semantica, nome: i32, vazio: ^Simbolo) -> ^Simbolo {
    if s.homonimos == none {
        return vazio
    }
    var d: ?^frontend.Decl = (s.homonimos or_else {})[nome]
    while d != none {
        if (s.globais or_else {})[(d as ^frontend.Decl).chave].categoria != (SIM_NENHUM as u8) {
            return &(s.globais or_else {})[(d as ^frontend.Decl).chave]
        }
        d = (d as ^frontend.Decl).homonimo
    }
    return vazio
}

// C: semantic/sem_nome.c:209
proc sem_achar_simbolo_lento(s: ^Semantica, nome: i32, qualificador: u8) -> ^Simbolo {
    return sem_achar_simbolo_em(s, nome, qualificador, s.modulo_atual)
}

// C: semantic/sem_nome.c:214
proc sem_achar_simbolo_em(s: ^Semantica, nome: i32, qualificador: u8, modulo_do_uso: u8) -> ^Simbolo {
    var tern_1: i32 = modulo_do_uso as i32
    if qualificador != 0 {
        tern_1 = qualificador as i32
    }
    let modulo: u8 = tern_1 as u8
    let y: ^Simbolo = &(s.globais or_else {})[nome]
    var tern_2: ?^frontend.Decl = none
    if modulo != 0 {
        tern_2 = decl_do_modulo(s, nome, modulo)
    }
    let propria: ?^frontend.Decl = tern_2
    if propria != none {
        return &(s.globais or_else {})[(propria as ^frontend.Decl).chave]
    }
    if (qualificador != 0) or (y.categoria != (SIM_NENHUM as u8)) {
        return y
    }
    return simbolo_de_outro_modulo(s, nome, y)
}

// C: semantic/sem_nome.c:225
proc sem_gravar_nome_local(s: ^Semantica, nome: i32, tipo: u32, pos: u32) {
    append(&s.nomes_locais, item = frontend.LocalNome{})
    let e: ^frontend.LocalNome = &s.nomes_locais[len(s.nomes_locais) - 1]
    e^ = frontend.LocalNome{nome = nome, tipo = tipo, pos = pos}
}

// C: semantic/sem_nome.c:231
proc sem_declarar_local(s: ^Semantica, novo: ^NovoLocal, id: ^i32) -> bool {
    if novo.nome == s.nome_descarte {
        let msg_1 = format(f"'_' so descarta um valor em let a, _ = f()", alloc = heap)
        defer delete(msg_1)
        return sem_erro(s, common.E0102, novo.pos, msg_1)
    }
    if not sem_verificar_caixa(s, novo.nome, novo.pos, CAIXA_SNAKE) {
        return false
    }
    if conflita_com_apelido(s, novo.nome, novo.pos) {
        return false
    }
    if escopo_buscar(&s.escopo, novo.nome) != none {
        let msg_2 = format(f"o nome '{sem_nome_texto(s, novo.nome)}' ja foi declarado neste proc; a Forja nao tem sombra", alloc = heap)
        defer delete(msg_2)
        return sem_erro(s, common.E0202, novo.pos, msg_2)
    }
    let antes_1: i32 = s.prox_local
    s.prox_local += 1
    id^ = antes_1
    sem_gravar_nome_local(s, novo.nome, novo.tipo, novo.pos)
    sem_marcar_ponteiro_do_corpo(s, novo.tipo)
    var local: LocalInfo = LocalInfo{nome = novo.nome, tipo = novo.tipo, natureza = novo.natureza, origem = novo.origem, id = id^, anterior = 0, pos = novo.pos, usos = 0, grupo = 0}
    escopo_empurrar(&s.escopo, &local)
    return true
}

// C: semantic/sem_nome.c:248
proc sem_pos_depois_da_palavra(s: ^Semantica, pos: u32) -> u32 {
    var pos_v: u32 = pos
    let t: []u8 = (s.fonte as ^common.Fonte).texto
    while (common.c2f_b2i32(eh_letra_ou_digito(t[pos_v])) != 0) or (t[pos_v] == 95) { // '_'
        pos_v += 1
    }
    while eh_espaco(t[pos_v]) {
        pos_v += 1
    }
    return pos_v
}

// C: semantic/sem_nome.c:256
proc sem_pos_do_nome_qualificado(s: ^Semantica, pos: u32) -> u32 {
    var pos_v: u32 = pos
    let t: []u8 = (s.fonte as ^common.Fonte).texto
    while (t[pos_v] != 46) and (t[pos_v] != 0) { // '.' '\0'
        pos_v += 1
    }
    var tern_1: u32 = pos_v
    if t[pos_v] == 46 {
        tern_1 = pos_v + 1
    }
    return tern_1 // '.'
}

// C: semantic/sem_nome.c:263
proc sem_pos_do_erro(s: ^Semantica, pos_retorno: u32) -> u32 {
    let t: []u8 = (s.fonte as ^common.Fonte).texto
    var pos: u32 = pos_retorno
    while (t[pos] != 33) and (t[pos] != 0) { // '!' '\0'
        pos += 1
    }
    if t[pos] == 33 { // '!'
        pos += 1
    }
    while eh_espaco(t[pos]) {
        pos += 1
    }
    return pos
}

// Auxiliar dos test: a Saida tem exatamente o texto esperado (bytes ate tam) e o NUL logo depois
proc saida_confere_teste(o: ^Saida, esperado: str) -> bool {
    if o.tam != (len(esperado) as u64) {
        return false
    }
    for i in (0 as u64)..<o.tam {
        if o.dados[i] != esperado[i] {
            return false
        }
    }
    return o.dados[o.tam] == 0
}

// Funcoes puras de caixa (SemMinusculas, SugerirPascal, SugerirComSublinhado, CaixaConfere) com o corte de Empurrar no cap
test "sem_nome: caixa, sugestao e corte da saida" {
    var buf: [64]u8 = {}
    var o: Saida = Saida{dados = buf[..], tam = 0, cap = 64}
    expect(sem_minusculas("METROS", 6) and not sem_minusculas("Metros", 6) and sem_minusculas("A_1", 3) and sem_minusculas("abc", 0))
    sugerir_pascal("meu_tipo", 8, &o)
    expect(saida_confere_teste(&o, "MeuTipo"))
    o.tam = 0
    sugerir_pascal("METROS", 6, &o)
    expect(saida_confere_teste(&o, "Metros"))
    o.tam = 0
    sugerir_pascal("_a__bC", 6, &o)
    expect(saida_confere_teste(&o, "ABC"))
    o.tam = 0
    sugerir_com_sublinhado("MeuTipo", 7, CAIXA_SNAKE, &o)
    expect(saida_confere_teste(&o, "meu_tipo"))
    o.tam = 0
    sugerir_com_sublinhado("meuTipoX", 8, CAIXA_MAIUSCULA, &o)
    expect(saida_confere_teste(&o, "MEU_TIPO_X"))
    o.tam = 0
    sugerir_com_sublinhado("A_B", 3, CAIXA_SNAKE, &o)
    expect(saida_confere_teste(&o, "a_b"))
    expect(caixa_confere("MeuTipo", 7, CAIXA_PASCAL) and not caixa_confere("meuTipo", 7, CAIXA_PASCAL) and not caixa_confere("Meu_Tipo", 8, CAIXA_PASCAL))
    expect(caixa_confere("_vida_1", 7, CAIXA_SNAKE) and not caixa_confere("Vida", 4, CAIXA_SNAKE) and not caixa_confere("", 0, CAIXA_SNAKE))
    expect(caixa_confere("A_1", 3, CAIXA_MAIUSCULA) and not caixa_confere("Ab", 2, CAIXA_MAIUSCULA) and not caixa_confere("_A", 2, CAIXA_MAIUSCULA))
    var curto: [4]u8 = {}
    var c: Saida = Saida{dados = curto[..], tam = 0, cap = 4}
    sugerir_pascal("abcdef", 6, &c)
    expect(saida_confere_teste(&c, "Abc")) // cap 4 guarda 3 bytes + NUL; o resto e cortado
}
