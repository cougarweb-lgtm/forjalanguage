import "common"

pub struct TipoRef {
    alvo: ?[]TipoRef
    nome: i32
    erro: i32
    pos: u32
    pos_tamanho: u32
    tipo: u32 // TipoId
    forma: u8
    modulo: u8
    modulo_erro: u8
}

pub struct Arg {
    nome: i32
    pos_nome: u32
    valor: ?^Expr
    indice: i32
    pos_fim: u32
}

pub struct Expr {
    tipo_no: u8
    op: u8
    flexivel: bool
    ref: u8
    tipo: u32 // TipoId
    ref_id: i32
    pos: u32
    pos_op: u32
    nome: i32
    a: ?^Expr
    b: ?^Expr
    args: ?[]Arg
    alvo: ?^TipoRef
    nargs: u32
    modulo: u8
    alocacao: u8
    carregar: bool
}

pub struct NomeLet {
    nome: i32
    pos: u32
    tipo: u32 // TipoId
    local_id: i32
}

pub struct Caso {
    tipo_nome: i32
    membro: i32
    pos_membro: u32
    pos: u32
    padrao: bool
    corpo: ?^Stmt
    tipo: u32 // TipoId
    indice_membro: i32
    local_id: i32
    tipo_escrito: ?^TipoRef
    modulo: u8
}

pub struct Stmt {
    tipo_no: u8
    op: u8
    tem_tipo: bool
    pos: u32
    pos_fim: u32
    nome: i32
    tipo: TipoRef
    tipo_local: u32 // TipoId
    local_id: i32
    expr: ?^Expr
    expr2: ?^Expr
    alvo: ?^Expr
    faixa_excl: bool
    item_ref: bool
    nome_indice: i32
    corpo: ?^Stmt
    senao: ?^Stmt
    prox: ?^Stmt
    casos: ?[]Caso
    nomes: ?[]NomeLet
    ncasos: u32
    local_indice: i32
}

pub struct Campo {
    nome: i32
    pos: u32
    tipo: TipoRef
    padrao: ?^Expr
    tem_faixa: bool
    faixa_excl: bool
    faixa_min: i64
    faixa_max: i64
    pos_min: u32
    pos_max: u32
}

pub struct Param {
    nome: i32
    pos: u32
    tipo: TipoRef
    padrao: ?^Expr
}

pub struct LocalNome {
    nome: i32
    tipo: u32 // TipoId
    pos: u32
}

pub struct Membro {
    nome: i32
    pos: u32
    valor: i64
    pos_valor: u32
    tem_valor: bool
}

pub struct Decl {
    tipo_no: u8
    op: u8
    modulo: u8
    nome: i32
    indice: i32
    simbolo: i32
    pos_simbolo: u32
    nlocais: u32
    nomes_locais: ?[]LocalNome
    pos: u32
    pos_fim: u32
    nome_a: i32
    nome_b: i32
    pos_a: u32
    pos_b: u32
    tipo: TipoRef
    init: ?^Expr
    campos: ?[]Campo
    ncampos: u32
    params: ?[]Param
    nparams: u32
    membros: ?[]Membro
    nmembros: u32
    retorno: TipoRef
    tem_retorno: bool
    posse_c: u8
    posse_param: i16
    pos_posse: u32
    retornos: ?[]Param
    nretornos: u32
    corpo: ?^Stmt
    pos_titulo: u32
    publico: bool
    exportado: bool
    externo: bool
    contem_dono: bool
    fuga_relevante: bool
    com_erro: bool
    chave: i32
    homonimo: ?^Decl
    prox: ?^Decl
}

pub struct Programa {
    primeira: ?^Decl
    ultima: ?^Decl
}

