pub proc arena_fatia_ptr_decl(a: ^common.Arena, n: int) -> []?^Decl {
    var l = make([dynamic]?^Decl, alloc = common.arena_mem(a), cap = n)
    for i in 0..<n {
        append(&l, item = none)
    }
    return l[..]
}

pub proc arena_fatia_arg(a: ^common.Arena, n: int) -> []Arg {
    var l = make([dynamic]Arg, alloc = common.arena_mem(a), cap = n)
    for i in 0..<n {
        append(&l, item = Arg{})
    }
    return l[..]
}

pub proc arena_fatia_local_nome(a: ^common.Arena, n: int) -> []LocalNome {
    var l = make([dynamic]LocalNome, alloc = common.arena_mem(a), cap = n)
    for i in 0..<n {
        append(&l, item = LocalNome{})
    }
    return l[..]
}

pub proc arena_fatia_nome_let(a: ^common.Arena, n: int) -> []NomeLet {
    var l = make([dynamic]NomeLet, alloc = common.arena_mem(a), cap = n)
    for i in 0..<n {
        append(&l, item = NomeLet{})
    }
    return l[..]
}

pub proc arena_fatia_tipo_ref(a: ^common.Arena, n: int) -> []TipoRef {
    var l = make([dynamic]TipoRef, alloc = common.arena_mem(a), cap = n)
    for i in 0..<n {
        append(&l, item = TipoRef{})
    }
    return l[..]
}
