// Changelog: 0.2.0 - G3 P-front B: corpo real. As 5 pilhas do Parser deixam de ser INDECIDIVEL: cada uma e [dynamic] do seu tipo (Arg, Campo, Param, Membro, Caso); CopiarLista (void *)
//            vira 5 procs tipados copiar_lista_arg/_campo/_param/_membro/_caso(p, base) -> ?[]T (fatia da arena; none se vazia) que esvaziam a pilha ate base (C2F-14, N3).
//            Parser.toks e a visao []Token do vetor do lexer, refeita em parser_analisar.

import "common"

pub struct Parser {
    fonte: ?^common.Fonte
    tokens: ?^[dynamic]Token
    nomes: ?^common.Interner
    arena: ?^common.Arena
    diag: ?^common.Diag
    erros: ?^common.DiagLista
    modulos: ?^Modulos
    modulo_atual: u8
    arquivo_atual: u32
    cargas: ?^[dynamic]?^Expr
    chaves_literal: ?^[dynamic]u32
    programa: Programa
    toks: []Token // visao de tokens^ (refeita em parser_analisar)
    cur: u32
    sem_literal_struct: bool
    viu_declaracao: bool
    napelidos: u8
    pilha_args: [dynamic]Arg
    pilha_campos: [dynamic]Campo
    pilha_params: [dynamic]Param
    pilha_membros: [dynamic]Membro
    pilha_casos: [dynamic]Caso
}

const SEM_FIM: u32 = 4294967295
const CLASSES: [2]i32 = {4, 5}

// C: frontend/parser.c:23
proc eh_nao_suportada(tipo: i32) -> bool {
    return (common.c2f_s2u_32(tipo) == (KW_UNION as u32)) or (common.c2f_s2u_32(tipo) == (KW_NONE as u32))
}

// O %.*s do C: os bytes do token ate o 1o NUL; texto novo no heap, o chamador faz delete.
proc texto_do_token(p: ^Parser, t: ^Token) -> str {
    let f = p.fonte as ^common.Fonte
    let ini = t.off as int
    let bytes = f.texto[ini..<(ini + (t.len_c as int))]
    return from_bytes(bytes[0..<common.c2f_strlen_b(bytes)], alloc = heap)
}

// C: frontend/parser.c:28
proc erro_sintaxe(p: ^Parser, esperado: str) -> bool {
    let t = token_atual(p)
    if parser_idioma(p, esperado) {
        return false // IA1-L1: forma de outra linguagem = E0110
    }
    let texto = texto_do_token(p, t)
    defer delete(texto)
    let d = p.diag as ^common.Diag
    let tipo = t.tipo as i32
    if eh_nao_suportada(tipo) {
        let msg_ns = format(f"construcao ainda nao suportada na Fase 5: '{texto}'", alloc = heap)
        defer delete(msg_ns)
        return common.diag_relatar(d, common.E0101, t.off, msg_ns)
    }
    if tipo == TK_NL {
        let msg_nl = format(f"fim de linha inesperado; esperado {esperado}", alloc = heap)
        defer delete(msg_nl)
        _ = common.diag_relatar(d, common.E0101, t.off, msg_nl)
    } else if tipo == TK_EOF {
        let msg_eof = format(f"fim de arquivo inesperado; esperado {esperado}", alloc = heap)
        defer delete(msg_eof)
        _ = common.diag_relatar(d, common.E0101, t.off, msg_eof)
    } else {
        let msg_tk = format(f"token inesperado '{texto}'; esperado {esperado}", alloc = heap)
        defer delete(msg_tk)
        _ = common.diag_relatar(d, common.E0101, t.off, msg_tk)
    }
    parser_forma_esperado(p, esperado)
    return false
}

// C: frontend/parser.c:42
proc esperar(p: ^Parser, tipo: i32, esperado: str) -> bool {
    if common.c2f_s2u_32(tipo_atual(p)) != common.c2f_s2u_32(tipo) {
        return erro_sintaxe(p, esperado)
    }
    p.cur += 1
    return true
}

// C: frontend/parser.c:49
proc esperar_fim_de_linha(p: ^Parser) -> bool {
    if common.c2f_s2u_32(tipo_atual(p)) == (TK_EOF as u32) {
        return true
    }
    return esperar(p, TK_NL, "fim de linha")
}

// C: frontend/parser.c:55
proc ler_nome_2(p: ^Parser, nome: ^i32, pos: ^u32, esperado: str) -> bool {
    if common.c2f_s2u_32(tipo_atual(p)) != (TK_IDENT as u32) {
        return erro_sintaxe(p, esperado)
    }
    nome^ = token_atual(p).sym
    pos^ = token_atual(p).off
    p.cur += 1
    return true
}

// C: frontend/parser.c:64
proc esperar_abre_bloco(p: ^Parser) -> bool {
    return (common.c2f_b2i32(esperar(p, TK_LBRACE, "'{'")) != 0) and (common.c2f_b2i32(esperar(p, TK_NL, "fim de linha depois de '{'")) != 0)
}

// C: frontend/parser.c:69
// C2F-14/N3: CopiarLista(p, &pilha, base) -> um proc por tipo de pilha. Copia pilha[base..n) para a arena e esvazia a pilha ate base; none se vazia.
proc copiar_lista_arg(p: ^Parser, base: u64) -> ?[]Arg {
    let b = base as int
    let total = len(p.pilha_args)
    var saida: ?[]Arg = none
    if total > b {
        var l = make([dynamic]Arg, alloc = common.arena_mem(p.arena as ^common.Arena), cap = total - b)
        for i in b..<total {
            append(&l, item = p.pilha_args[i])
        }
        saida = l[..]
    }
    truncate(&p.pilha_args, b)
    return saida
}

