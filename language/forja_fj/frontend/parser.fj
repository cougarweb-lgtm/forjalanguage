// C: frontend/parser.c:80
proc guardar_erro_pendente(p: ^Parser) -> bool {
    parser_forma_da_regra(p)
    return common.diag_lista_guardar(p.erros, p.diag as ^common.Diag, p.modulo_atual as u32)
}

// C: frontend/parser.c:89
// C2F-N2: RenomeadoAchar devolve copia no heap (o C devolvia &tabela[k]): delete ao sair da volta.
proc canonizar_membro(p: ^Parser, modulo: u8) {
    let t = &p.toks[p.cur]
    let nomes = p.nomes as ^common.Interner
    let caminho = common.interner_texto(nomes, (p.modulos as ^Modulos).itens[modulo].caminho)
    let nome = common.interner_texto(nomes, t.sym)
    for k in 0..<2 {
        var era_antigo = false
        let ren = common.renomeado_achar(CLASSES[k], caminho, nome, &era_antigo)
        if ren == none {
            continue
        }
        defer delete(ren)
        if not era_antigo {
            continue
        }
        common.renomeado_notar_tabela(p.diag as ^common.Diag, t.off, t.len_c as u32, ren)
        if common.renomeado_recusa_em(p.diag as ^common.Diag, ren) and p.erros != none {
            _ = common.renomeado_recusar(p.diag as ^common.Diag, t.off, t.len_c as u32, ren)
            _ = guardar_erro_pendente(p)
        }
        let novo = (ren as ^common.Renomeado).novo or_else "(null)"
        t.sym = common.internar(nomes, novo, len(novo) as u32)
        return
    }
}

// C: frontend/parser.c:111
proc notar_qualificador_antigo(p: ^Parser) {
    let t: ^Token = token_atual(p)
    var novo: i32 = 0
    if (p.diag as ^common.Diag).trocas == none {
        return
    }
    novo = modulos_apelido_novo(p.modulos, p.arquivo_atual, t.sym)
    if novo < 0 {
        return
    }
    var lit_1 = common.RenTroca{off = t.off, tam = t.len_c as u32, classe = common.REN_QUALIFICADOR, antigo = common.interner_texto(p.nomes as ^common.Interner, t.sym), novo = common.interner_texto(p.nomes as ^common.Interner, novo)}
    let arg_1: ^common.RenTroca = &lit_1
    let arg_2: ^common.Diag = p.diag as ^common.Diag
    common.renomeado_notar(arg_2, arg_1)
}

// C: frontend/parser.c:124
proc ler_apelido(p: ^Parser, pos: ^u32) -> u8 {
    if tipo_atual(p) != TK_IDENT or tipo_seguinte(p) != TK_DOT or (p.toks[p.cur + 2].tipo as i32) != TK_IDENT {
        return 0
    }
    let modulo = modulos_apelido(p.modulos, p.arquivo_atual, token_atual(p).sym)
    if modulo == 0 {
        return 0
    }
    notar_qualificador_antigo(p)
    pos^ = token_atual(p).off
    p.cur += 2
    canonizar_membro(p, modulo)
    return modulo
}

// C: frontend/parser.c:136
proc abre_bloco(tipo: i32) -> bool {
    return (((common.c2f_s2u_32(tipo) == (KW_IF as u32)) or (common.c2f_s2u_32(tipo) == (KW_WHILE as u32))) or (common.c2f_s2u_32(tipo) == (KW_FOR as u32))) or (common.c2f_s2u_32(tipo) == (KW_SWITCH as u32))
}

// C: frontend/parser.c:145
proc fim_do_comando(p: ^Parser, ini: u32, abriu_bloco: ^bool) -> u32 {
    var profundidade: i32 = 0
    abriu_bloco^ = false
    var k: u32 = ini
    while true {
        let tipo = p.toks[k].tipo as i32
        if tipo == TK_EOF {
            return SEM_FIM
        }
        if tipo == TK_LBRACE {
            profundidade += 1
            abriu_bloco^ = true
        }
        if tipo == TK_RBRACE {
            profundidade -= 1
        }
        if profundidade < 0 {
            return SEM_FIM
        }
        if tipo == TK_NL and k >= p.cur and profundidade == 0 {
            return k
        }
        k += 1
    }
    return SEM_FIM
}

// C: frontend/parser.c:163
proc parser_recuperar_comando(p: ^Parser, ini: u32) -> bool {
    var abriu_bloco = false
    if p.erros == none or not (p.diag as ^common.Diag).tem {
        return false
    }
    for k in ini..<p.cur {
        if (p.toks[k].tipo as i32) == TK_NL {
            return false // o erro esta numa linha de baixo do comando: o resto dele e imprevisivel
        }
    }
    let fim = fim_do_comando(p, ini, &abriu_bloco)
    if fim == SEM_FIM {
        return false
    }
    if not abriu_bloco and abre_bloco(p.toks[ini].tipo as i32) {
        return false // cabecalho sem '{': as linhas de baixo eram o corpo e viram cascata
    }
    if not guardar_erro_pendente(p) {
        return false
    }
    p.cur = fim + 1
    p.sem_literal_struct = false
    return true
}

// C: frontend/parser.c:181
proc comeca_declaracao_no_topo(p: ^Parser) -> bool {
    let t: ^Token = token_atual(p)
    let tipo: i32 = t.tipo as i32
    let palavra: bool = (((((((((((common.c2f_s2u_32(tipo) == (KW_PUB as u32)) or (common.c2f_s2u_32(tipo) == (KW_EXPORT as u32))) or (common.c2f_s2u_32(tipo) == (KW_IMPORT as u32))) or (common.c2f_s2u_32(tipo) == (KW_UNIT as u32))) or (common.c2f_s2u_32(tipo) == (KW_CONST as u32))) or (common.c2f_s2u_32(tipo) == (KW_STRUCT as u32))) or (common.c2f_s2u_32(tipo) == (KW_ENUM as u32))) or (common.c2f_s2u_32(tipo) == (KW_UNION as u32))) or (common.c2f_s2u_32(tipo) == (KW_PROC as u32))) or (common.c2f_s2u_32(tipo) == (KW_TEST as u32))) or (common.c2f_s2u_32(tipo) == (KW_FOREIGN as u32))) or ((common.c2f_s2u_32(tipo) == (TK_IDENT as u32)) and (t.sym == SYM_STATIC_ASSERT))
    return (common.c2f_b2i32(palavra) != 0) and ((t.off == 0) or ((p.fonte as ^common.Fonte).texto[t.off - 1] == 10)) // '\n'
}

// C: frontend/parser.c:192
proc recuperar_declaracao(p: ^Parser, ini: u32) -> bool {
    if p.erros == none {
        return false
    }
    if (common.c2f_b2i32((p.diag as ^common.Diag).tem) != 0) and (not guardar_erro_pendente(p)) {
        return false
    }
    if (p.erros as ^common.DiagLista).cortado {
        return false
    }
    if (p.cur <= ini) and (common.c2f_s2u_32(tipo_atual(p)) != (TK_EOF as u32)) {
        p.cur += 1
    }
    while (common.c2f_s2u_32(tipo_atual(p)) != (TK_EOF as u32)) and (not comeca_declaracao_no_topo(p)) {
        p.cur += 1
    }
    p.sem_literal_struct = false
    return true
}

// C: frontend/parser.c:203
// C2F-N3: Vec zerado do C aceita push; [dynamic] zero da R0007 no 1o append: as pilhas nascem aqui (cap > 0 = ja iniciadas, ParserAnalisar e reentrante).
pub proc parser_analisar(p: ^Parser) -> bool {
    var ok = true
    let lista_tokens = p.tokens as ^[dynamic]Token
    p.toks = lista_tokens^[..]
    p.cur = 0
    p.sem_literal_struct = false
    p.viu_declaracao = false
    p.napelidos = 0
    if cap(p.pilha_args) == 0 {
        p.pilha_args = make([dynamic]Arg, alloc = heap, cap = 16)
        p.pilha_campos = make([dynamic]Campo, alloc = heap, cap = 16)
        p.pilha_params = make([dynamic]Param, alloc = heap, cap = 16)
        p.pilha_membros = make([dynamic]Membro, alloc = heap, cap = 16)
        p.pilha_casos = make([dynamic]Caso, alloc = heap, cap = 16)
    }
    while tipo_atual(p) != TK_EOF {
        let ini = p.cur
        if analisar_declaracao(p) {
            continue
        }
        ok = false
        if recuperar_declaracao(p, ini) {
            continue
        }
        parser_forma_da_regra(p) // so age no E0101 que o ErroSintaxe nao cobriu (regra fixa)
        return false
    }
    return ok and (p.erros == none or (p.erros as ^common.DiagLista).n == 0)
}

// C: frontend/parser.c:231
pub proc parser_liberar(p: ^Parser) {
    delete(p.pilha_args)
    delete(p.pilha_campos)
    delete(p.pilha_params)
    delete(p.pilha_membros)
    delete(p.pilha_casos)
}
