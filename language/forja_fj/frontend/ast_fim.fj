import "common"

pub struct AstFim {
    toks: [dynamic]Token
    par: [dynamic]u32
}

pub const AST_FIM_NENHUM: i64 = 4294967295

// C: frontend/ast_fim.c:11
proc tok(f: ^AstFim, i: u32) -> ^Token {
    return &f.toks[i as u64]
}

// C: frontend/ast_fim.c:16
proc par_de(f: ^AstFim, i: u32) -> u32 {
    return f.par[i as u64]
}

// C: frontend/ast_fim.c:24
proc fechador_de(abre: i32) -> i32 {
    let sw_1 = common.c2f_s2u_32(abre)
    if sw_1 == (TK_LPAREN as u32) {
        return TK_RPAREN
    } else if sw_1 == (TK_LBRACE as u32) {
        return TK_RBRACE
    } else if sw_1 == (TK_LCOLCHETE as u32) {
        return TK_RCOLCHETE
    } else if sw_1 == (TK_FTEXTO_INICIO as u32) {
        return TK_FTEXTO_FIM
    } else if sw_1 == (TK_FTEXTO_CHAVE as u32) {
        return TK_FTEXTO_FIM_CHAVE
    } else {
        return TK_EOF
    }
    return 0
}

// C: frontend/ast_fim.c:36
proc casar_pares(f: ^AstFim) {
    var pilha = make([dynamic]u32, alloc = heap)
    defer delete(pilha)
    f.par = make([dynamic]u32, alloc = heap)
    reserve(&f.par, len(f.toks))
    let ntoks: u32 = (len(f.toks) as u64) as u32
    for i in (0 as u32)..<ntoks {
        append(&f.par, item = AST_FIM_NENHUM as u32)
    }
    for i in (0 as u32)..<ntoks {
        let t: i32 = tok(f, i).tipo as i32
        if fechador_de(t) != TK_EOF {
            append(&pilha, item = i)
        } else if len(pilha) > 0 {
            let topo: u32 = pilha[len(pilha) - 1]
            if fechador_de(tok(f, topo).tipo as i32) != t {
                continue
            }
            f.par[i as u64] = topo
            f.par[topo as u64] = i
            truncate(&pilha, len(pilha) - 1) // pilha.n--
        }
    }
}

// C: frontend/ast_fim.c:58
// C2F: `*f = (AstFim){0}` some (f chega zerado; as listas nascem abaixo); f.toks = lx.tokens era a troca de dono do Vec: lista de dono unico nao
// muda de dono (E0311), entao os tokens sao copiados um a um para f.toks e o lexer e liberado
pub proc ast_fim_iniciar(f: ^AstFim, fonte: ^common.Fonte, nomes: ^common.Interner, diag: ^common.Diag) -> bool {
    var lx: Lexer = Lexer{fonte = fonte, nomes = nomes, diag = diag, inicio = 0}
    if not lexer_analisar(&lx) {
        lexer_liberar(&lx)
        return false
    }
    f.toks = make([dynamic]Token, alloc = heap, cap = len(lx.tokens))
    for k in 0..<len(lx.tokens) {
        append(&f.toks, item = lx.tokens[k])
    }
    lexer_liberar(&lx)
    casar_pares(f)
    return true
}

// C: frontend/ast_fim.c:71
pub proc ast_fim_liberar(f: ^AstFim) {
    delete(f.toks)
    delete(f.par)
}

// C: frontend/ast_fim.c:80
proc indice_depois(f: ^AstFim, off: u32) -> u32 {
    var lo: u32 = 0
    var hi: u32 = (len(f.toks) as u64) as u32
    while lo < hi {
        let meio: u32 = lo + ((hi - lo) / 2)
        if tok(f, meio).off < off {
            lo = meio + 1
        } else {
            hi = meio
        }
    }
    return lo
}

// C: frontend/ast_fim.c:90
proc indice_exato(f: ^AstFim, off: u32) -> u32 {
    let i: u32 = indice_depois(f, off)
    var tern_1: u32 = AST_FIM_NENHUM as u32
    if ((i as u64) < (len(f.toks) as u64)) and (tok(f, i).off == off) {
        tern_1 = i
    }
    return tern_1
}

// C: frontend/ast_fim.c:96
proc fim_tok(f: ^AstFim, i: u32) -> u32 {
    return tok(f, i).off + (tok(f, i).len_c as u32)
}

// C: frontend/ast_fim.c:102
proc fim_em_off(f: ^AstFim, off: u32) -> u32 {
    let i: u32 = indice_exato(f, off)
    var tern_1: u32 = 0
    if i == (AST_FIM_NENHUM as u32) {
        tern_1 = off
    } else {
        tern_1 = fim_tok(f, i)
    }
    return tern_1
}

// C: frontend/ast_fim.c:109
proc fim_par(f: ^AstFim, i: u32) -> u32 {
    if (i as u64) >= (len(f.toks) as u64) {
        return 0
    }
    var tern_1: u32 = 0
    if par_de(f, i) != (AST_FIM_NENHUM as u32) {
        tern_1 = fim_tok(f, par_de(f, i))
    } else {
        tern_1 = fim_tok(f, i)
    }
    return tern_1
}

// C: frontend/ast_fim.c:116
proc fim_pareado_apos_nome(f: ^AstFim, off_nome: u32) -> u32 {
    let i: u32 = indice_exato(f, off_nome)
    var tern_1: u32 = 0
    if i == (AST_FIM_NENHUM as u32) {
        tern_1 = off_nome
    } else {
        tern_1 = fim_par(f, i + 1)
    }
    return tern_1
}

// C: frontend/ast_fim.c:123
proc fim_linha(f: ^AstFim, desde: u32) -> u32 {
    var fim: u32 = desde
    var i: u32 = indice_depois(f, desde)
    while (i as u64) < (len(f.toks) as u64) {
        let t: i32 = tok(f, i).tipo as i32
        if ((common.c2f_s2u_32(t) == (TK_NL as u32)) or (common.c2f_s2u_32(t) == (TK_EOF as u32))) or (common.c2f_s2u_32(t) == (TK_RBRACE as u32)) {
            break
        }
        fim = fim_tok(f, i)
        i += 1
    }
    return fim
}

// C: frontend/ast_fim.c:135
proc fim_de_pos_fim(f: ^AstFim, pos_fim: u32) -> u32 {
    let i: u32 = indice_exato(f, pos_fim)
    if i == (AST_FIM_NENHUM as u32) {
        return pos_fim
    }
    let t: i32 = tok(f, i).tipo as i32
    if ((common.c2f_s2u_32(t) == (TK_NL as u32)) or (common.c2f_s2u_32(t) == (TK_EOF as u32))) and (i > 0) {
        return fim_tok(f, i - 1)
    }
    return fim_tok(f, i)
}

// C: frontend/ast_fim.c:145
proc fim_limite(f: ^AstFim, off: u32) -> u32 {
    var i: u32 = indice_exato(f, off)
    if i == (AST_FIM_NENHUM as u32) {
        return off
    }
    if tok(f, i).tipo == (TK_MINUS as u8) {
        i += 1
    }
    return fim_tok(f, i)
}

// C: frontend/ast_fim.c:156
proc fim_erro(f: ^AstFim, t: ?^TipoRef, fim_corpo: u32) -> u32 {
    var i: u32 = indice_depois(f, fim_corpo)
    if ((i as u64) < (len(f.toks) as u64)) and (tok(f, i).tipo == (TK_BANG as u8)) {
        i += 1
    }
    if (t as ^TipoRef).modulo_erro != 0 {
        i += 2
    }
    var tern_1: u32 = fim_corpo
    if (i as u64) < (len(f.toks) as u64) {
        tern_1 = fim_tok(f, i)
    }
    return tern_1
}

// C: frontend/ast_fim.c:164
proc fim_corpo_do_tipo(f: ^AstFim, t: ?^TipoRef) -> u32 {
    let tr: ^TipoRef = t as ^TipoRef
    let alvo: []TipoRef = tr.alvo or_else {} // o C so toca em alvo nos ramos que o usam
    let forma: i32 = tr.forma as i32
    if forma == TR_NOME {
        var pos_nome: u32 = tr.pos
        if (tr.nome >= 0) and (tr.modulo != 0) {
            pos_nome = tr.pos_tamanho
        }
        return fim_em_off(f, pos_nome)
    } else if forma == TR_TUPLA {
        return fim_par(f, indice_exato(f, tr.pos))
    } else if forma == TR_PROC {
        if tr.pos_tamanho == 1 {
            return ast_fim_tipo(f, &alvo[0])
        }
        return fim_pareado_apos_nome(f, tr.pos)
    } else if forma == TR_MAPA {
        return ast_fim_tipo(f, &alvo[1])
    } else if forma == TR_BIT_SET {
        return fim_pareado_apos_nome(f, tr.pos)
    }
    return ast_fim_tipo(f, &alvo[0])
}

// C: frontend/ast_fim.c:178
pub proc ast_fim_tipo(f: ^AstFim, t: ?^TipoRef) -> u32 {
    let fim: u32 = fim_corpo_do_tipo(f, t)
    var tern_1: u32 = fim
    if (t as ^TipoRef).erro >= 0 {
        tern_1 = fim_erro(f, t, fim)
    }
    return tern_1
}

// C: frontend/ast_fim.c:186
proc fim_ultimo_arg(f: ^AstFim, e: ?^Expr) -> u32 {
    var tern_1: u32 = (e as ^Expr).pos_op
    if (e as ^Expr).nargs > 0 {
        tern_1 = ast_fim_expr(f, ((e as ^Expr).args or_else {})[(e as ^Expr).nargs - 1].valor)
    }
    return tern_1
}

// C: frontend/ast_fim.c:191
proc fim_chamada_ind(f: ^AstFim, e: ?^Expr) -> u32 {
    let i: u32 = indice_exato(f, (e as ^Expr).pos_op)
    if i == (AST_FIM_NENHUM as u32) {
        return (e as ^Expr).pos_op
    }
    var tern_1: u32 = i + 1
    if tok(f, i).tipo == (TK_LPAREN as u8) {
        tern_1 = i
    }
    return fim_par(f, tern_1)
}

// C: frontend/ast_fim.c:198
proc fim_natural(f: ^AstFim, e: ?^Expr) -> u32 {
    let sw_1 = common.c2f_s2u_32(((e as ^Expr).tipo_no as i32))
    if sw_1 == (EX_CHAMADA as u32) or sw_1 == (EX_LITERAL_STRUCT as u32) {
        return fim_pareado_apos_nome(f, (e as ^Expr).pos_op)
    } else if sw_1 == (EX_LITERAL_ARRAY as u32) or sw_1 == (EX_INDICE as u32) or sw_1 == (EX_FATIA as u32) {
        return fim_par(f, indice_exato(f, (e as ^Expr).pos_op))
    } else if sw_1 == (EX_CHAMADA_IND as u32) {
        return fim_chamada_ind(f, e)
    } else if sw_1 == (EX_FTEXTO as u32) {
        return fim_par(f, indice_exato(f, (e as ^Expr).pos))
    } else if sw_1 == (EX_UNARIO as u32) {
        var tern_1: u32 = 0
        if (e as ^Expr).op == (OP_DEREF as u8) {
            tern_1 = fim_em_off(f, (e as ^Expr).pos_op)
        } else {
            tern_1 = ast_fim_expr(f, (e as ^Expr).a)
        }
        return tern_1
    } else if sw_1 == (EX_BINARIO as u32) or sw_1 == (EX_OR_ELSE as u32) {
        return ast_fim_expr(f, (e as ^Expr).b)
    } else if sw_1 == (EX_CONVERSAO as u32) or sw_1 == (EX_TIPO as u32) {
        return ast_fim_tipo(f, (e as ^Expr).alvo)
    } else if sw_1 == (EX_TRY as u32) or sw_1 == (EX_EMBRULHA as u32) or sw_1 == (EX_OPC_TESTE as u32) {
        return ast_fim_expr(f, (e as ^Expr).a)
    } else if sw_1 == (EX_TUPLA as u32) {
        return fim_ultimo_arg(f, e)
    } else {
        return fim_em_off(f, (e as ^Expr).pos_op)
    }
    return 0
}

// C: frontend/ast_fim.c:221
pub proc ast_fim_expr(f: ^AstFim, e: ?^Expr) -> u32 {
    var fim: u32 = fim_natural(f, e)
    let i: u32 = indice_exato(f, (e as ^Expr).pos)
    if (((i != (AST_FIM_NENHUM as u32)) and (tok(f, i).tipo == (TK_LPAREN as u8))) and (par_de(f, i) != (AST_FIM_NENHUM as u32))) and (fim_tok(f, par_de(f, i)) > fim) {
        fim = fim_tok(f, par_de(f, i))
    }
    return fim
}

// C: frontend/ast_fim.c:233
proc fim_if(f: ^AstFim, s: ?^Stmt) -> u32 {
    let i: u32 = indice_exato(f, (s as ^Stmt).pos_fim)
    let fim: u32 = fim_de_pos_fim(f, (s as ^Stmt).pos_fim)
    if (((s as ^Stmt).senao == none) or (i == (AST_FIM_NENHUM as u32))) or (((i + 2) as u64) >= (len(f.toks) as u64)) {
        return fim
    }
    if tok(f, i + 2).tipo == (KW_IF as u8) {
        return ast_fim_stmt(f, (s as ^Stmt).senao)
    }
    return fim_par(f, i + 2)
}

// C: frontend/ast_fim.c:243
pub proc ast_fim_stmt(f: ^AstFim, s: ?^Stmt) -> u32 {
    let sw_1 = common.c2f_s2u_32(((s as ^Stmt).tipo_no as i32))
    if sw_1 == (ST_DEFER as u32) {
        var tern_1: u32 = 0
        if (s as ^Stmt).corpo != none {
            tern_1 = ast_fim_stmt(f, (s as ^Stmt).corpo)
        } else {
            tern_1 = fim_em_off(f, (s as ^Stmt).pos)
        }
        return tern_1
    } else if sw_1 == (ST_IF as u32) {
        return fim_if(f, s)
    } else if sw_1 == (ST_WHILE as u32) or sw_1 == (ST_FOR as u32) or sw_1 == (ST_SWITCH as u32) {
        return fim_de_pos_fim(f, (s as ^Stmt).pos_fim)
    } else {
        var tern_2: u32 = 0
        if (s as ^Stmt).expr != none {
            tern_2 = ast_fim_expr(f, (s as ^Stmt).expr)
        } else {
            tern_2 = fim_em_off(f, (s as ^Stmt).pos)
        }
        return fim_linha(f, tern_2)
    }
    return 0
}

// C: frontend/ast_fim.c:255
pub proc ast_fim_caso(f: ^AstFim, c: ^Caso) -> u32 {
    var ultimo: ?^Stmt = c.corpo
    if ultimo == none {
        return fim_linha(f, c.pos)
    }
    while (ultimo as ^Stmt).prox != none {
        ultimo = (ultimo as ^Stmt).prox
    }
    return ast_fim_stmt(f, ultimo)
}

// C: frontend/ast_fim.c:265
pub proc ast_fim_param(f: ^AstFim, p: ^Param) -> u32 {
    var tern_1: u32 = 0
    if p.padrao != none {
        tern_1 = ast_fim_expr(f, p.padrao)
    } else {
        tern_1 = ast_fim_tipo(f, &p.tipo)
    }
    return tern_1
}

// C: frontend/ast_fim.c:270
pub proc ast_fim_campo(f: ^AstFim, c: ^Campo) -> u32 {
    if c.padrao != none {
        return ast_fim_expr(f, c.padrao)
    }
    var tern_1: u32 = 0
    if common.c2f_b2i32(c.tem_faixa) != 0 {
        tern_1 = fim_limite(f, c.pos_max)
    } else {
        tern_1 = ast_fim_tipo(f, &c.tipo)
    }
    return tern_1
}

// C: frontend/ast_fim.c:276
pub proc ast_fim_membro(f: ^AstFim, m: ^Membro) -> u32 {
    var tern_1: u32 = 0
    if common.c2f_b2i32(m.tem_valor) != 0 {
        tern_1 = fim_limite(f, m.pos_valor)
    } else {
        tern_1 = fim_em_off(f, m.pos)
    }
    return tern_1
}

// C: frontend/ast_fim.c:281
pub proc ast_fim_decl(f: ^AstFim, d: ?^Decl) -> u32 {
    let sw_1 = common.c2f_s2u_32(((d as ^Decl).tipo_no as i32))
    if sw_1 == (D_UNIDADE_BASE as u32) or sw_1 == (D_UNIDADE_DERIV as u32) or sw_1 == (D_IMPORT as u32) {
        return fim_linha(f, (d as ^Decl).pos)
    } else if sw_1 == (D_CONST as u32) {
        return fim_linha(f, ast_fim_expr(f, (d as ^Decl).init))
    } else {
        return fim_de_pos_fim(f, (d as ^Decl).pos_fim)
    }
    return 0
}

// C: frontend/ast_fim.c:292
pub proc ast_inicio_decl(f: ^AstFim, d: ?^Decl) -> u32 {
    var i: u32 = indice_exato(f, (d as ^Decl).pos)
    if i == (AST_FIM_NENHUM as u32) {
        return (d as ^Decl).pos
    }
    let pos_e_palavra: bool = (((d as ^Decl).tipo_no == (D_IMPORT as u8)) or ((d as ^Decl).tipo_no == (D_TEST as u8))) or ((d as ^Decl).tipo_no == (D_ASSERT as u8))
    if (not pos_e_palavra) and (i > 0) {
        i -= 1
    }
    if (i > 0) and (tok(f, i - 1).tipo == (KW_EXPORT as u8)) {
        i -= 1
    }
    if (i > 0) and (tok(f, i - 1).tipo == (KW_PUB as u8)) {
        i -= 1
    }
    return tok(f, i).off
}

// G3 P-front A: pares ( ) { } [ ] casados pela pilha (o abridor sem fechador fica sem par); contagem conferida no diferencial C x Forja
test "ast_fim: casar pares" {
    var a: common.Arena = common.Arena{}
    var nomes: common.Interner = common.Interner{}
    common.interner_iniciar(&nomes, &a)
    lexer_nomes_iniciais(&nomes)
    var f: common.Fonte = fonte_de_teste("f(a[1]) {\n")
    var d: common.Diag = common.Diag{}
    var af: AstFim = AstFim{}
    expect(ast_fim_iniciar(&af, &f, &nomes, &d))
    var casados: int = 0
    let nenhum: u32 = AST_FIM_NENHUM as u32
    for k in 0..<len(af.par) {
        if af.par[k] != nenhum {
            casados += 1
        }
    }
    expect(len(af.par) == len(af.toks))
    expect(casados == 4)
    ast_fim_liberar(&af)
    common.fonte_liberar(&f)
    common.interner_liberar(&nomes)
    common.arena_liberar(&a)
}
