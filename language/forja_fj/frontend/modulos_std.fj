    } else if nome == "net" {
        achado = TESTES_NET
    } else if nome == "url" {
        achado = TESTES_URL
    } else if nome == "reload" {
        achado = TESTES_RELOAD
    }
    tam^ = (len(achado or_else "") as u64) // NULL: *tam = 0
    return achado
}

// C: frontend/modulos_std.c:499
// S4 P2: o pedaco de testes vai DEPOIS do texto do modulo (com '\n' entre os dois); copia na arena
pub proc modulos_texto_std_com_testes(nome: str, texto: ?str, arena: ^common.Arena, tam: ^u64) -> ?str {
    var tam_testes: u64 = 0
    let testes: ?str = modulos_texto_std_testes(nome, &tam_testes)
    if testes == none {
        return texto
    }
    let base: str = texto or_else ""
    var partes: [3]str = {base[0..<tam^], "\n", testes or_else ""}
    let novo: str = text.concat(partes[..], alloc = common.arena_mem(arena))
    tam^ = (tam^ + 1) + tam_testes
    return novo
}

// C: frontend/modulos_std.c:520
// IA1-L9b (B11): no alvo linux o texto do std:os sai com o outro os.TARGET no lugar (copia na arena). strstr -> text.str_index_of
pub proc modulos_texto_std_alvo(nome: str, alvo_linux: bool, arena: ^common.Arena, tam: ^u64) -> ?str {
    let texto: ?str = modulos_texto_std(nome, arena, tam)
    if (texto == none) or (not alvo_linux) or (nome != "os") {
        return texto
    }
    let base: str = texto or_else ""
    let achado: ?int = text.str_index_of(base, OS_ALVO_WINDOWS)
    if achado == none {
        return texto
    }
    let antes: u64 = (achado or_else 0) as u64
    let tira: u64 = len(OS_ALVO_WINDOWS) as u64
    var partes: [3]str = {base[0..<antes],OS_ALVO_LINUX, base[(antes + tira)..<tam^]}
    let novo: str = text.concat(partes[..], alloc = common.arena_mem(arena))
    tam^ = ((tam^ - tira) + (len(OS_ALVO_LINUX) as u64))
    return novo
}

// G3 P-front A: tabela std (26 nomes), texto embutido por #load e o os.TARGET trocado no alvo linux; contagem e bytes conferidos contra o C (diferencial)
test "modulos_std: nomes, texto embutido e alvo linux" {
    var a: common.Arena = common.Arena{}
    expect(modulos_std_tem("text", 4) and modulos_std_tem("os", 2) and (not modulos_std_tem("strings", 7)))
    var nomes: [30]str = {}
    expect(modulos_std_nomes(nomes[..], 30) == 26)
    var tam: u64 = 0
    let texto: ?str = modulos_texto_std("mem", &a, &tam)
    expect(texto != none and tam > 0 and (texto or_else "") != "")
    var tam_w: u64 = 0
    var tam_l: u64 = 0
    let win: ?str = modulos_texto_std_alvo("os", false, &a, &tam_w)
    let lin: ?str = modulos_texto_std_alvo("os", true, &a, &tam_l)
    expect(win != none and lin != none)
    expect(text.str_index_of(win or_else "", "\"x86_64-windows\"") != none)
    expect(text.str_index_of(lin or_else "", "\"x86_64-linux\"") != none)
    expect(modulos_texto_std("naoexiste", &a, &tam) == none and tam == 0)
    common.arena_liberar(&a)
}
