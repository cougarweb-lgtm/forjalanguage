// C: frontend/modulos_std.c:434
pub proc modulos_std_tem(nome: str, tam: u32) -> bool {
    if modulos_std_eh_runtime_wasm(nome[0..<tam]) {
        return true
    }
    for k in 0..<STD_QTD {
        if ((len(STD_NOMES[k]) as u32) == tam) and (STD_NOMES[k] == nome[0..<tam]) {
            return true
        }
    }
    return false
}

// C: frontend/modulos_std.c:442
// N1: `const char **nomes` + cap -> fatia; devolve quantos
proc modulos_std_nomes(nomes: []str, cap: u64) -> u64 {
    var n: u64 = 0
    var k: i32 = 0
    while (k < STD_QTD) and (n < cap) {
        nomes[n] = STD_NOMES[k]
        n += 1
        k += 1
    }
    return n
}

// Cada pedaco seguido de '\n' (o `.byte 10` depois de cada .incbin do C), tudo na arena do chamador
proc juntar_pedacos(pedacos: []str, arena: ^common.Arena) -> str {
    var partes = make([dynamic]str, alloc = heap)
    defer delete(partes)
    for k in 0..<len(pedacos) {
        append(&partes, item = pedacos[k])
        append(&partes, item = "\n")
    }
    return text.concat(partes[..], alloc = common.arena_mem(arena))
}

// C: frontend/modulos_std.c:449
// C2F: ganha `arena` (o texto de text, time e fmt e a concatenacao de varios .fj; o C os tinha prontos no .incbin); os demais voltam o #load direto, sem copia
proc modulos_texto_std(nome: str, arena: ^common.Arena, tam: ^u64) -> ?str {
    var achado: ?str = none
    if nome == "mem" {
        achado = STD_MEM
    } else if nome == "os" {
        achado = STD_OS
    } else if nome == "thread" {
        achado = STD_THREAD
    } else if nome == "sync" {
        achado = STD_SYNC
    } else if nome == "atomic" {
        achado = STD_ATOMIC
    } else if nome == "file" {
        achado = STD_FILE
    } else if nome == "text" {
        var pedacos: [5]str = {STD_TEXT, STD_TEXT_PARSE, STD_TEXT_PARSE_FLOAT_TABELA, STD_TEXT_UTF8, STD_TEXT_HTML}
        achado = juntar_pedacos(pedacos[..], arena)
    } else if nome == "time" {
        var pedacos: [2]str = {STD_TIME, STD_TIME_FUSO}
        achado = juntar_pedacos(pedacos[..], arena)
    } else if nome == "rand" {
        achado = STD_RAND
    } else if nome == "path" {
        achado = STD_PATH
    } else if nome == "fmt" {
        var pedacos: [6]str = {STD_FMT, STD_FMT_DIGITOS, STD_FMT_NUMBER, STD_FMT_MONEY, STD_FMT_PARSE, STD_FMT_DATE}
        achado = juntar_pedacos(pedacos[..], arena)
    } else if nome == "math" {
        achado = STD_MATH
    } else if nome == "process" {
        achado = STD_PROCESS
    } else if nome == "binary" {
        achado = STD_BINARY
    } else if nome == "hash" {
        achado = STD_HASH
    } else if nome == "sha" {
        achado = STD_SHA
    } else if nome == "base64" {
        achado = STD_BASE64
    } else if nome == "uuid" {
        achado = STD_UUID
    } else if nome == "csv" {
        achado = STD_CSV
    } else if nome == "linalg" {
        achado = STD_LINALG
    } else if nome == "flags" {
        achado = STD_FLAGS
    } else if nome == "json" {
        achado = STD_JSON
    } else if nome == "async" {
        achado = STD_ASYNC
    } else if nome == "net" {
        achado = STD_NET
    } else if nome == "url" {
        achado = STD_URL
    } else if nome == "reload" {
        achado = STD_RELOAD
    } else if nome == STD_WASM_RT_NOME {
        achado = STD_WASM_RT
    } else if nome == STD_WASM_REAL_NOME {
        achado = STD_WASM_REAL
    } else if nome == STD_WASM_MATH_NOME {
        achado = STD_WASM_MATH
    } else if nome == STD_WASM_TRIG_NOME {
        achado = STD_WASM_TRIG
    } else if nome == STD_WASM_ATAN_NOME {
        achado = STD_WASM_ATAN
    } else if nome == STD_WASM_EXP_NOME {
        achado = STD_WASM_EXP
    } else if nome == STD_WASM_POW_NOME {
        achado = STD_WASM_POW
    } else if nome == STD_WASM_ORDENAR_NOME {
        achado = STD_WASM_ORDENAR
    } else if nome == STD_WASM_TESTE_NOME {
        achado = STD_WASM_TESTE
    } else if nome == STD_A64_RT_NOME {
        achado = STD_A64_RT
    } else if nome == STD_A64_MEM_NOME {
        achado = STD_A64_MEM
    } else if nome == STD_A64_MAPA_NOME {
        achado = STD_A64_MAPA
    } else if nome == STD_A64_ES_NOME {
        achado = STD_A64_ES
    } else if nome == STD_A64_ES_FS_NOME {
        achado = STD_A64_ES_FS
    } else if nome == STD_A64_ES_FS2_NOME {
        achado = STD_A64_ES_FS2
    } else if nome == STD_A64_PROC_NOME {
        achado = STD_A64_PROC
    } else if nome == STD_A64_ERRNO_NOME {
        achado = STD_A64_ERRNO
    } else if nome == STD_A64_IOS_NOME {
        achado = STD_A64_IOS
    }
    tam^ = (len(achado or_else "") as u64) // NULL: *tam = 0
    return achado
}

// C: frontend/modulos_std.c:487
// S4 P2/P4..P7: so os modulos com testes.fj entram aqui
proc modulos_texto_std_testes(nome: str, tam: ^u64) -> ?str {
    var achado: ?str = none
    if nome == "math" {
        achado = TESTES_MATH
    } else if nome == "rand" {
        achado = TESTES_RAND
    } else if nome == "mem" {
        achado = TESTES_MEM
    } else if nome == "text" {
        achado = TESTES_TEXT
    } else if nome == "path" {
        achado = TESTES_PATH
    } else if nome == "fmt" {
        achado = TESTES_FMT
    } else if nome == "time" {
        achado = TESTES_TIME
    } else if nome == "file" {
        achado = TESTES_FILE
    } else if nome == "os" {
        achado = TESTES_OS
    } else if nome == "process" {
        achado = TESTES_PROCESS
    } else if nome == "binary" {
        achado = TESTES_BINARY
    } else if nome == "hash" {
        achado = TESTES_HASH
    } else if nome == "sha" {
        achado = TESTES_SHA
    } else if nome == "base64" {
        achado = TESTES_BASE64
    } else if nome == "uuid" {
        achado = TESTES_UUID
    } else if nome == "csv" {
        achado = TESTES_CSV
    } else if nome == "linalg" {
        achado = TESTES_LINALG
    } else if nome == "flags" {
        achado = TESTES_FLAGS
    } else if nome == "json" {
