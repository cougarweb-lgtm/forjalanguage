// Nome de modulo de runtime do alvo wasm ou a64 (fora de STD_NOMES: nao e API do usuario); quem decide o alvo e o driver
pub proc modulos_std_eh_runtime_wasm(nome: str) -> bool {
    return (nome == STD_WASM_RT_NOME) or (nome == STD_WASM_REAL_NOME) or (nome == STD_WASM_MATH_NOME) or (nome == STD_WASM_TRIG_NOME) or (nome == STD_WASM_ATAN_NOME) or (nome == STD_WASM_EXP_NOME) or (nome == STD_WASM_POW_NOME) or (nome == STD_WASM_ORDENAR_NOME) or (nome == STD_WASM_TESTE_NOME) or modulos_std_eh_a64_so(nome)
}

// Modulos de runtime que so existem no alvo a64 (o driver recusa o import deles nos outros alvos)
pub proc modulos_std_eh_a64_so(nome: str) -> bool {
    return (nome == STD_A64_RT_NOME) or (nome == STD_A64_MEM_NOME) or (nome == STD_A64_MAPA_NOME) or (nome == STD_A64_ES_NOME) or (nome == STD_A64_ES_FS_NOME) or (nome == STD_A64_ES_FS2_NOME) or (nome == STD_A64_PROC_NOME) or (nome == STD_A64_ERRNO_NOME) or (nome == STD_A64_IOS_NOME)
}

