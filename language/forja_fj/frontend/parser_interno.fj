// C: frontend/parser_interno.h:18
proc token_atual(p: ^Parser) -> ^Token {
    return &p.toks[p.cur]
}

// C: frontend/parser_interno.h:19
proc tipo_atual(p: ^Parser) -> i32 {
    return p.toks[p.cur].tipo as i32
}

// C: frontend/parser_interno.h:20
// C2F: toks[cur + 1] como no C (o EOF fecha a lista; chamar com cur no EOF e R0006 aqui e leitura alem do vetor no C)
proc tipo_seguinte(p: ^Parser) -> i32 {
    return p.toks[p.cur + 1].tipo as i32
}
