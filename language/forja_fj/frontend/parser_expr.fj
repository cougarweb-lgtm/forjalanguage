    AnonParserExpr41{nivel_mais1 = 0, op = 0}, AnonParserExpr41{nivel_mais1 = 0, op = 0}, AnonParserExpr41{nivel_mais1 = 0, op = 0}, AnonParserExpr41{nivel_mais1 = 0, op = 0}, AnonParserExpr41{nivel_mais1 = 0, op = 0},
