// C: frontend/parser_expr.c:29
proc nova_expr(p: ^Parser, tipo: i32, pos: u32) -> ^Expr {
    let e: ^Expr = new(Expr, alloc = common.arena_mem(p.arena as ^common.Arena))
    e.tipo_no = tipo as u8
    e.pos = pos
    e.pos_op = pos
    e.nome = -1
    e.carregar = false
    return e
}

// C: frontend/parser_expr.c:53
proc nivel_atual(p: ^Parser, op: ^u8) -> i32 {
    return nivel_do_token(tipo_atual(p), op)
}

// F2: o mesmo mapa da tabela OPERADORES (a tabela fica como oraculo do teste abaixo), sem montar as 82 entradas por chamada
// (indexar const de array por indice de execucao custa O(N): 2 vezes por token, 2% do tempo do parse). nivel = nivel_mais1 - 1 (-1 = nao e operador); op = OP_* de ast.fj.
proc nivel_do_token(t: i32, op: ^u8) -> i32 {
    op^ = 0
    if t < 33 or t > 71 {
        return -1
    }
    if t >= 52 and t <= 57 { // TK_EQ..TK_GE
        op^ = ((t - 52) + 2) as u8
        return 3
    }
    if t >= 47 and t <= 51 { // TK_PLUS TK_MINUS TK_STAR TK_SLASH TK_PERCENT
        op^ = ((t - 47) + 8) as u8
        if t <= 48 {
            return 4
        }
        return 5
    }
    if t == 33 { // KW_OR_ELSE
        return 0
    }
    if t == 34 { // KW_AND
        op^ = 1
        return 2
    }
    if t == 35 { // KW_OR
        return 1
    }
    if t == 66 { // TK_AMP
        op^ = 16
        return 5
    }
    if t == 68 or t == 69 { // TK_PIPE TK_TIL
        op^ = ((t - 68) + 17) as u8
        return 4
    }
    if t == 70 or t == 71 { // TK_SHL TK_SHR
        op^ = ((t - 70) + 19) as u8
        return 5
    }
    return -1
}

test "nivel_do_token_igual_a_tabela_OPERADORES" {
    var diferentes = 0
    for t in 0..<82 {
        let esperado = OPERADORES[t]
        var op: u8 = 99
        let nivel = nivel_do_token(t as i32, &op)
        if nivel != ((esperado.nivel_mais1 as i32) - 1) or op != esperado.op {
            diferentes += 1
        }
    }
    expect(diferentes == 0)
}

// C: frontend/parser_expr.c:61
proc ler_argumento(p: ^Parser, a: ^Arg, so_nomeado: bool) -> bool {
    let nomeado: bool = (tipo_atual(p) == TK_IDENT) and (tipo_seguinte(p) == TK_ASSIGN)
    a.nome = -1
    a.indice = -1
    if so_nomeado and (not nomeado) {
        return erro_sintaxe(p, "nome do campo seguido de '='")
    }
    if nomeado {
        a.nome = token_atual(p).sym
        a.pos_nome = token_atual(p).off
        p.cur += 2
    }
    a.valor = analisar_expr(p)
    if a.valor == none {
        return false
    }
    let ultimo: Token = p.toks[p.cur - 1]
    a.pos_fim = ultimo.off + (ultimo.len_c as u32) // B01d: onde o argumento termina (inicio do ',' ou ')' em geral)
    return true
}

// C: frontend/parser.c:69 (CopiarLista da pilha de Arg). O C usa um Vec generico + void *; em Forja a lista tem tipo, entao ha um proc por tipo de elemento e o de Caso/NomeLet
// fica inline em parser_stmt.fj (analisar_casos, ler_nomes_do_let_multiplo). Copia pilha_args[base..n) para a arena, esvazia a pilha ate base; none se vazia.
proc copiar_args(p: ^Parser, base: int) -> ?[]Arg {
    let n: int = len(p.pilha_args) - base
    if n == 0 {
        return none
    }
    let destino: []Arg = arena_fatia_arg(p.arena as ^common.Arena, n)
    copy(destino, p.pilha_args[base..<len(p.pilha_args)])
    truncate(&p.pilha_args, base)
    return destino
}

// C: frontend/parser_expr.c:81
proc pular_quebras_2(p: ^Parser, pula: bool) {
    while (common.c2f_b2i32(pula) != 0) and (common.c2f_s2u_32(tipo_atual(p)) == (TK_NL as u32)) {
        p.cur += 1
    }
}

// C: frontend/parser_expr.c:87
proc ler_argumentos_ate(p: ^Parser, fecha: i32, so_nomeado: bool) -> bool {
    let multilinha: bool = fecha == TK_RBRACE
    pular_quebras_2(p, multilinha)
    while tipo_atual(p) != fecha {
        var a: Arg = Arg{}
        if not ler_argumento(p, &a, so_nomeado) {
            return false
        }
        append(&p.pilha_args, item = a)
        pular_quebras_2(p, multilinha)
        if tipo_atual(p) != TK_COMMA {
            break
        }
        p.cur += 1
        pular_quebras_2(p, multilinha)
    }
    return true
}

// C: frontend/parser_expr.c:104
// O C nao restaura sem_literal_struct nem esvazia a pilha no caminho de erro: igual aqui (o parser re-sincroniza depois com o estado que ficou).
proc analisar_lista_args(p: ^Parser, e: ^Expr, fecha: i32, so_nomeado: bool) -> bool {
    let salvo: bool = p.sem_literal_struct
    let base: int = len(p.pilha_args)
    p.sem_literal_struct = false
    if not ler_argumentos_ate(p, fecha, so_nomeado) {
        return false
    }
    p.sem_literal_struct = salvo
    var esperado: str = "'}'"
    if fecha == TK_RPAREN {
        esperado = "')'"
    }
    if not esperar(p, fecha, esperado) {
        return false
    }
    e.nargs = (len(p.pilha_args) - base) as u32
    e.args = copiar_args(p, base)
    return true
}

// C: frontend/parser_expr.c:118
proc analisar_lista_args_de_tipo(p: ^Parser, e: ^Expr) -> bool {
    let salvo: bool = p.sem_literal_struct
    let base: int = len(p.pilha_args)
    p.sem_literal_struct = false
    if tipo_atual(p) != TK_RPAREN {
        let t: ^TipoRef = new(TipoRef, alloc = common.arena_mem(p.arena as ^common.Arena))
        if not analisar_tipo_ref(p, t) {
            return false
        }
        let alvo: ^Expr = nova_expr(p, EX_TIPO, t.pos)
        alvo.alvo = t
        let primeiro: Arg = Arg{nome = -1, indice = -1, valor = alvo}
        append(&p.pilha_args, item = primeiro)
        if (tipo_atual(p) != TK_COMMA) and (tipo_atual(p) != TK_RPAREN) {
            return erro_sintaxe(p, "o 1o argumento de new, make, size_of e align_of e um tipo: new(Grifo, alloc = heap)")
        }
        if tipo_atual(p) == TK_COMMA {
            p.cur += 1
        }
        if not ler_argumentos_ate(p, TK_RPAREN, false) {
            return false
        }
    }
    p.sem_literal_struct = salvo
    if not esperar(p, TK_RPAREN, "')'") {
        return false
    }
    e.nargs = (len(p.pilha_args) - base) as u32
    e.args = copiar_args(p, base)
    return true
}

// C: frontend/parser_expr.c:146
proc registrar_chave_literal(p: ^Parser) {
    if p.chaves_literal != none {
        append(p.chaves_literal as ^[dynamic]u32, item = token_atual(p).off)
    }
}

// C: frontend/parser_expr.c:151
proc analisar_nome_ou_chamada(p: ^Parser) -> ?^Expr {
    var pos_apelido: u32 = 0
    var tern_1: i32 = 0
    if p.napelidos != 0 {
        tern_1 = ler_apelido(p, &pos_apelido) as i32
    }
    let modulo: u8 = tern_1 as u8
    let t: ^Token = token_atual(p)
    var tern_2: u32 = t.off
    if modulo != 0 {
        tern_2 = pos_apelido
    }
    let e: ^Expr = nova_expr(p, EX_NOME, tern_2)
    let maiuscula: bool = ((common.c2f_char_i32((p.fonte as ^common.Fonte).texto[t.off]) >= 65) and (common.c2f_char_i32((p.fonte as ^common.Fonte).texto[t.off]) <= 90)) or (t.sym == SYM_QUAT) // 'A' 'Z'
    e.pos_op = t.off
    e.modulo = modulo
    e.nome = t.sym
    p.cur += 1
    if common.c2f_s2u_32(tipo_atual(p)) == (TK_LPAREN as u32) {
        e.tipo_no = EX_CHAMADA as u8
        p.cur += 1
        let de_tipo: bool = (((t.sym == SYM_NEW) or (t.sym == SYM_MAKE)) or (t.sym == SYM_SIZE_OF)) or (t.sym == SYM_ALIGN_OF)
        if de_tipo {
            var tern_3: ?^Expr = none
            if common.c2f_b2i32(analisar_lista_args_de_tipo(p, e)) != 0 {
                tern_3 = e
            }
            return tern_3
        }
        var tern_4: ?^Expr = none
        if common.c2f_b2i32(analisar_lista_args(p, e, TK_RPAREN, false)) != 0 {
            tern_4 = e
        }
        return tern_4
    }
    if ((common.c2f_s2u_32(tipo_atual(p)) == (TK_LBRACE as u32)) and (common.c2f_b2i32(maiuscula) != 0)) and (not p.sem_literal_struct) {
        e.tipo_no = EX_LITERAL_STRUCT as u8
        registrar_chave_literal(p)
        p.cur += 1
        var tern_5: ?^Expr = none
        if common.c2f_b2i32(analisar_lista_args(p, e, TK_RBRACE, true)) != 0 {
            tern_5 = e
        }
        return tern_5
    }
    return e
}

// C: frontend/parser_expr.c:178
proc analisar_parenteses(p: ^Parser) -> ?^Expr {
    let pos: u32 = token_atual(p).off
    let salvo: bool = p.sem_literal_struct
    p.cur += 1
    p.sem_literal_struct = false
    let e: ?^Expr = analisar_expr(p)
    p.sem_literal_struct = salvo
    if (e == none) or (not esperar(p, TK_RPAREN, "')'")) {
        return none
    }
    let ptr_1: ^Expr = e as ^Expr
    ptr_1.pos = pos
    return e
}

// C: frontend/parser_expr.c:192
proc analisar_literal(p: ^Parser, tipo: i32, op: u8) -> ^Expr {
    let e: ^Expr = nova_expr(p, tipo, token_atual(p).off)
    e.op = op
    if common.c2f_s2u_32(tipo) == (EX_INT as u32) {
        let tk: ^Token = token_atual(p)
        e.op = min(tk.len_c as i32, 255) as u8
        if ((tk.len_c as i32) >= 2) and (common.c2f_char_i32((p.fonte as ^common.Fonte).texto[tk.off + 1]) > 57) { // '9'
            e.op = 255
        }
    }
    if common.c2f_s2u_32(tipo) == (EX_TEXTO as u32) {
        e.nome = token_atual(p).sym
    }
    p.cur += 1
    return e
}

// C: frontend/parser_expr.c:207
proc analisar_literal_array(p: ^Parser) -> ?^Expr {
    if p.sem_literal_struct {
        _ = erro_sintaxe(p, "expressao (literal de array no cabecalho: declare o array antes)")
        return none
    }
    let e: ^Expr = nova_expr(p, EX_LITERAL_ARRAY, token_atual(p).off)
    registrar_chave_literal(p)
    p.cur += 1
    if not analisar_lista_args(p, e, TK_RBRACE, false) {
        return none
    }
    var i: u32 = 0
    while i < e.nargs {
        if (e.args or_else {})[i].nome < 0 {
            i += 1
            continue
        }
        let msg_1 = format(f"literal de array so tem valores; literal de struct leva o nome do tipo: Tipo{{campo = valor}}", alloc = heap)
        defer delete(msg_1)
        _ = common.diag_relatar(p.diag as ^common.Diag, common.E0101, (e.args or_else {})[i].pos_nome, msg_1)
        return none
    }
    return e
}

// C: frontend/parser_expr.c:227
proc analisar_pedaco_do_f_texto(p: ^Parser) -> bool {
    let texto: ^Expr = nova_expr(p, EX_TEXTO, token_atual(p).off)
    let a: Arg = Arg{nome = -1, indice = -1, valor = texto}
    texto.nome = token_atual(p).sym
    p.cur += 1
    append(&p.pilha_args, item = a)
    return true
}

// C: frontend/parser_expr.c:238
proc analisar_chave_do_f_texto(p: ^Parser) -> bool {
    let salvo: bool = p.sem_literal_struct
    var a: Arg = Arg{nome = -1, indice = 0}
    p.cur += 1
    p.sem_literal_struct = false
    a.valor = analisar_expr(p)
    p.sem_literal_struct = salvo
    if a.valor == none {
        return false
    }
    a.pos_nome = (a.valor as ^Expr).pos
    if tipo_atual(p) == TK_FTEXTO_FORMATO {
        a.nome = token_atual(p).sym
        a.pos_nome = token_atual(p).off
        p.cur += 1
    }
    if not esperar(p, TK_FTEXTO_FIM_CHAVE, "'}' no fim de {expressao} do f\"...\"") {
        return false
    }
    append(&p.pilha_args, item = a)
    return true
}

// C: frontend/parser_expr.c:259
proc analisar_f_texto(p: ^Parser) -> ?^Expr {
    let base: int = len(p.pilha_args)
    let e: ^Expr = nova_expr(p, EX_FTEXTO, token_atual(p).off)
    p.cur += 1
    while tipo_atual(p) != TK_FTEXTO_FIM {
        var ok: bool = false
        if tipo_atual(p) == TK_FTEXTO_PEDACO {
            ok = analisar_pedaco_do_f_texto(p)
        } else if tipo_atual(p) == TK_FTEXTO_CHAVE {
            ok = analisar_chave_do_f_texto(p)
        } else {
            ok = erro_sintaxe(p, "texto ou '{' no f\"...\"")
        }
        if not ok {
            return none
        }
    }
    p.cur += 1
    e.nargs = (len(p.pilha_args) - base) as u32
    e.args = copiar_args(p, base)
    return e
}

// C: frontend/parser_expr.c:275
proc token_eh_load(p: ^Parser) -> bool {
    let tk: ^Token = token_atual(p)
    if (tipo_atual(p) != TK_IDENT) or (tk.len_c != 4) {
        return false
    }
    let texto: []u8 = (p.fonte as ^common.Fonte).texto
    return common.c2f_memcmp(texto[tk.off..<(tk.off + 4)], as_bytes("load")) == 0
}

// C: frontend/parser_expr.c:283
proc analisar_load(p: ^Parser) -> ?^Expr {
    if p.cargas == none {
        _ = erro_sintaxe(p, "expressao")
        return none
    }
    let e: ^Expr = nova_expr(p, EX_TEXTO, token_atual(p).off)
    p.cur += 1
    if not token_eh_load(p) {
        _ = erro_sintaxe(p, "#load(\"arquivo\")")
        return none
    }
    p.cur += 1
    if not esperar(p, TK_LPAREN, "'(' depois de #load") {
        return none
    }
    if tipo_atual(p) != TK_TEXTO {
        _ = erro_sintaxe(p, "caminho entre aspas em #load")
        return none
    }
    e.nome = token_atual(p).sym
    e.carregar = true
    p.cur += 1
    if not esperar(p, TK_RPAREN, "')' em #load") {
        return none
    }
    append(p.cargas as ^[dynamic]?^Expr, item = e)
    return e
}

// C: frontend/parser_expr.c:301
proc analisar_primario(p: ^Parser) -> ?^Expr {
    let sw_1 = common.c2f_s2u_32(tipo_atual(p))
    if sw_1 == (TK_FTEXTO_INICIO as u32) {
        return analisar_f_texto(p)
    } else if sw_1 == (TK_HASH as u32) {
        return analisar_load(p)
    } else if sw_1 == (TK_LBRACE as u32) {
        return analisar_literal_array(p)
    } else if sw_1 == (TK_LCOLCHETE as u32) {
        parser_idioma_array(p)
        return none
    } else if sw_1 == (TK_INT as u32) {
        return analisar_literal(p, EX_INT, 0)
    } else if sw_1 == (TK_REAL as u32) {
        return analisar_literal(p, EX_REAL, 0)
    } else if sw_1 == (TK_TEXTO as u32) {
        return analisar_literal(p, EX_TEXTO, 0)
    } else if sw_1 == (KW_TRUE as u32) {
        return analisar_literal(p, EX_BOOL, 1)
    } else if sw_1 == (KW_FALSE as u32) {
        return analisar_literal(p, EX_BOOL, 0)
    } else if sw_1 == (KW_NONE as u32) {
        return analisar_literal(p, EX_NONE, 0)
    } else if sw_1 == (TK_IDENT as u32) {
        return analisar_nome_ou_chamada(p)
    } else if sw_1 == (TK_LPAREN as u32) {
        return analisar_parenteses(p)
    } else {
        _ = erro_sintaxe(p, "expressao")
        return none
    }
    return none
}

// C: frontend/parser_expr.c:323
proc analisar_limite_da_fatia(p: ^Parser) -> ?^Expr {
    let t: i32 = tipo_atual(p)
    if ((common.c2f_s2u_32(t) == (TK_RCOLCHETE as u32)) or (common.c2f_s2u_32(t) == (TK_DOTDOTLT as u32))) or (common.c2f_s2u_32(t) == (TK_DOTDOTEQ as u32)) {
        _ = erro_sintaxe(p, "limite da fatia: a[lo..<hi] ou a[..]")
        return none
    }
    return analisar_expr(p)
}

// C: frontend/parser_expr.c:334
proc analisar_fatia_com_faixa(p: ^Parser, base: ?^Expr, inicio: ?^Expr, pos_op: u32) -> ?^Expr {
    let e: ^Expr = nova_expr(p, EX_FATIA, (base as ^Expr).pos)
    let pilha_base: int = len(p.pilha_args)
    if tipo_atual(p) == TK_DOTDOTLT {
        e.op = FATIA_EXCL as u8
    } else {
        e.op = FATIA_INCL as u8
    }
    p.cur += 1
    let fim: ?^Expr = analisar_limite_da_fatia(p)
    if fim == none {
        return none
    }
    var a: Arg = Arg{nome = -1, indice = -1, valor = inicio}
    append(&p.pilha_args, item = a)
    a.valor = fim
    append(&p.pilha_args, item = a)
    e.a = base
    e.pos_op = pos_op
    e.nargs = 2
    e.args = copiar_args(p, pilha_base)
    return e
}

// C: frontend/parser_expr.c:354
proc analisar_segundo_indice(p: ^Parser, e: ^Expr) -> bool {
    p.cur += 1
    let segundo: ?^Expr = analisar_limite_da_fatia(p)
    if segundo == none {
        return false
    }
    var args: []Arg = arena_fatia_arg(p.arena as ^common.Arena, 1)
    args[0] = Arg{nome = -1, pos_nome = (segundo as ^Expr).pos, valor = segundo, indice = -1}
    e.args = args
    e.nargs = 1
    return true
}

// C: frontend/parser_expr.c:366
proc analisar_dentro_do_colchete(p: ^Parser, base: ?^Expr, pos_op: u32) -> ?^Expr {
    var e: ?^Expr = none
    if common.c2f_s2u_32(tipo_atual(p)) == (TK_DOTDOT as u32) {
        p.cur += 1
        e = nova_expr(p, EX_FATIA, (base as ^Expr).pos)
        let ptr_1: ^Expr = e as ^Expr
        ptr_1.op = FATIA_INTEIRA as u8
    } else {
        let primeiro: ?^Expr = analisar_limite_da_fatia(p)
        if primeiro == none {
            return none
        }
        if (common.c2f_s2u_32(tipo_atual(p)) == (TK_DOTDOTLT as u32)) or (common.c2f_s2u_32(tipo_atual(p)) == (TK_DOTDOTEQ as u32)) {
            e = analisar_fatia_com_faixa(p, base, primeiro, pos_op)
            if e == none {
                return none
            }
        } else {
            e = nova_expr(p, EX_INDICE, (base as ^Expr).pos)
            let ptr_2: ^Expr = e as ^Expr
            ptr_2.b = primeiro
            if (common.c2f_b2i32(common.c2f_s2u_32(tipo_atual(p)) == (TK_COMMA as u32)) != 0) and (not analisar_segundo_indice(p, e as ^Expr)) {
                return none
            }
        }
    }
    let ptr_3: ^Expr = e as ^Expr
    ptr_3.a = base
    let ptr_4: ^Expr = e as ^Expr
    ptr_4.pos_op = pos_op
    var tern_1: ?^Expr = none
    if common.c2f_b2i32(esperar(p, TK_RCOLCHETE, "']'")) != 0 {
        tern_1 = e
    }
    return tern_1
}

// C: frontend/parser_expr.c:391
proc analisar_colchete(p: ^Parser, base: ?^Expr) -> ?^Expr {
    let salvo: bool = p.sem_literal_struct
    let pos_op: u32 = token_atual(p).off
    p.cur += 1
    p.sem_literal_struct = false
    let e: ?^Expr = analisar_dentro_do_colchete(p, base, pos_op)
    p.sem_literal_struct = salvo
    return e
}

// C: frontend/parser_expr.c:403
proc analisar_chamada_indireta(p: ^Parser, chamado: ?^Expr) -> ?^Expr {
    let e: ^Expr = nova_expr(p, EX_CHAMADA_IND, (chamado as ^Expr).pos)
    e.a = chamado
    e.pos_op = token_atual(p).off
    p.cur += 1
    var tern_1: ?^Expr = none
    if common.c2f_b2i32(analisar_lista_args(p, e, TK_RPAREN, false)) != 0 {
        tern_1 = e
    }
    return tern_1
}

// C: frontend/parser_expr.c:412
proc analisar_posfixo(p: ^Parser) -> ?^Expr {
    var e: ?^Expr = analisar_primario(p)
    while (e != none) and ((((common.c2f_s2u_32(tipo_atual(p)) == (TK_DOT as u32)) or (common.c2f_s2u_32(tipo_atual(p)) == (TK_CARET as u32))) or (common.c2f_s2u_32(tipo_atual(p)) == (TK_LCOLCHETE as u32))) or (common.c2f_s2u_32(tipo_atual(p)) == (TK_LPAREN as u32))) {
        if common.c2f_s2u_32(tipo_atual(p)) == (TK_LPAREN as u32) {
            e = analisar_chamada_indireta(p, e)
            continue
        }
        if common.c2f_s2u_32(tipo_atual(p)) == (TK_LCOLCHETE as u32) {
            e = analisar_colchete(p, e)
            continue
        }
        if common.c2f_s2u_32(tipo_atual(p)) == (TK_CARET as u32) {
            if parser_idioma_xor(p) {
                return none
            }
            let deref: ^Expr = nova_expr(p, EX_UNARIO, (e as ^Expr).pos)
            deref.op = OP_DEREF as u8
            deref.a = e
            deref.pos_op = token_atual(p).off
            p.cur += 1
            e = deref
            continue
        }
        p.cur += 1
        let campo: ^Expr = nova_expr(p, EX_CAMPO, (e as ^Expr).pos)
        campo.a = e
        if not ler_nome_2(p, &campo.nome, &campo.pos_op, "nome do campo") {
            return none
        }
        e = campo
    }
    return e
}

// C: frontend/parser_expr.c:446
proc analisar_prefixo(p: ^Parser, tipo: i32, op: u8) -> ?^Expr {
    let e: ^Expr = nova_expr(p, tipo, token_atual(p).off)
    e.op = op
    p.cur += 1
    e.a = analisar_unario(p)
    var tern_1: ?^Expr = e
    if e.a == none {
        tern_1 = none
    }
    return tern_1
}

// C: frontend/parser_expr.c:455
proc analisar_unario(p: ^Parser) -> ?^Expr {
    let sw_1 = common.c2f_s2u_32(tipo_atual(p))
    if sw_1 == (TK_MINUS as u32) {
        return analisar_prefixo(p, EX_UNARIO, OP_NEGAR as u8)
    } else if sw_1 == (KW_NOT as u32) {
        return analisar_prefixo(p, EX_UNARIO, OP_NAO as u8)
    } else if sw_1 == (TK_AMP as u32) {
        return analisar_prefixo(p, EX_UNARIO, OP_ENDERECO as u8)
    } else if sw_1 == (TK_TIL as u32) {
        return analisar_prefixo(p, EX_UNARIO, OP_BIT_NAO as u8)
    } else if sw_1 == (KW_TRY as u32) {
        return analisar_prefixo(p, EX_TRY, 0)
    } else if sw_1 == (TK_BANG as u32) {
        parser_idioma_negacao(p)
        return none
    } else {
        return analisar_posfixo(p)
    }
    return none
}

// C: frontend/parser_expr.c:468
proc analisar_conversao(p: ^Parser) -> ?^Expr {
    var e: ?^Expr = analisar_unario(p)
    while (e != none) and (common.c2f_s2u_32(tipo_atual(p)) == (KW_AS as u32)) {
        p.cur += 1
        let conv: ^Expr = nova_expr(p, EX_CONVERSAO, (e as ^Expr).pos)
        conv.a = e
        conv.alvo = new(TipoRef, alloc = common.arena_mem(p.arena as ^common.Arena))
        if not analisar_tipo_ref(p, conv.alvo) {
            return none
        }
        conv.pos_op = (conv.alvo as ^TipoRef).pos
        var tern_1: i32 = -1
        if (conv.alvo as ^TipoRef).forma == (TR_NOME as u8) {
            tern_1 = (conv.alvo as ^TipoRef).nome
        }
        conv.nome = tern_1
        e = conv
    }
    return e
}

// C: frontend/parser_expr.c:484
proc novo_binario(p: ^Parser, token: i32, op: u8, a: ?^Expr, b: ?^Expr) -> ^Expr {
    var tern_1: i32 = EX_BINARIO
    if common.c2f_s2u_32(token) == (KW_OR_ELSE as u32) {
        tern_1 = EX_OR_ELSE
    }
    let e: ^Expr = nova_expr(p, tern_1, (a as ^Expr).pos)
    e.op = op
    e.a = a
    e.b = b
    return e
}

// C: frontend/parser_expr.c:494
proc analisar_binario(p: ^Parser, minimo: i32) -> ?^Expr {
    var esq: ?^Expr = analisar_conversao(p)
    var op: u8 = 0
    while esq != none {
        let nivel: i32 = nivel_atual(p, &op)
        if nivel < minimo {
            break
        }
        let token: i32 = tipo_atual(p)
        let pos_op: u32 = token_atual(p).off
        if ((token == TK_AMP) or (token == TK_PIPE)) and parser_idioma_operador(p) {
            return none
        }
        p.cur += 1
        let dir: ?^Expr = analisar_binario(p, nivel + 1)
        if dir == none {
            return none
        }
        let binario: ^Expr = novo_binario(p, token, op, esq, dir)
        binario.pos_op = pos_op
        esq = binario
        if (nivel == NV_CMP) and (nivel_atual(p, &op) == NV_CMP) {
            break
        }
    }
    return esq
}

// C: frontend/parser_expr.c:513
proc analisar_expr(p: ^Parser) -> ?^Expr {
    return analisar_binario(p, NV_OR_ELSE)
}

// C: frontend/parser_expr.c:519
proc analisar_cabecalho(p: ^Parser) -> ?^Expr {
    p.sem_literal_struct = true
    let e: ?^Expr = analisar_expr(p)
    p.sem_literal_struct = false
    return e
}
