const NV_OR_ELSE: i32 = 0
const NV_OU: i32 = 1
const NV_E: i32 = 2
const NV_CMP: i32 = 3
const NV_SOMA: i32 = 4
const NV_MUL: i32 = 5
// C2F-A0: tabela indexada pelo tipo do token (TK_QTD = 82 entradas): nivel + 1 (0 = nao e operador binario) e o operador; const nao referencia const (E0301), entao os
// valores sao literais: nivel_mais1 = NV_* + 1 (NV_OR_ELSE 1, NV_OU 2, NV_E 3, NV_CMP 4, NV_SOMA 5, NV_MUL 6), op = OP_* de ast.fj.
// Preenchidos (indice = TK_*): 33 KW_OR_ELSE, 34 KW_AND, 35 KW_OR, 47 TK_PLUS, 48 TK_MINUS, 49 TK_STAR, 50 TK_SLASH, 51 TK_PERCENT, 52..57 TK_EQ TK_NE TK_LT TK_LE TK_GT TK_GE,
// 66 TK_AMP, 68 TK_PIPE, 69 TK_TIL, 70 TK_SHL, 71 TK_SHR; o resto e {0, 0}.
