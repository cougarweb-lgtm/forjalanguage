// libera as chaves (heap) e zera o cabecalho, guardando o alocador (como *m = (forja_mapa){0} no C)
pub proc mapa_liberar(m: uint, arquivo: cstr, linha: i32) {
    let alocador: uint = mapa_le_le(m + MAPA_OFF_ALOCADOR, 4)
    if (alocador == ALOC_HEAP as uint) and (mapa_le_campo(m, MAPA_OFF_CHAVES) != 0) {
        mem.mem_liberar(mapa_le_campo(m, MAPA_OFF_CHAVES), arquivo, linha)
    }
    var k: uint = 0
    while k < MAPA_BYTES {
        mapa_grava_campo(m, k, 0)
        k += TAM_PONTEIRO
    }
    mapa_grava_le(m + MAPA_OFF_ALOCADOR, alocador, 4)
}

// ---- soa dinamica: as colunas moram num bloco unico; a coluna k comeca na soma de alinha(cap * tams[j]) para j < k ----

// tamanho da coluna k (int64 no .rdata do programa)
proc soa_tam(tams: uint, k: uint) -> uint {
    return wasm_rt.memoria_ler_u64(tams + k * TAM_PONTEIRO)
}

// bytes do bloco de cap linhas, ou -1 quando alguma conta passaria do limite (cap grande demais)
proc soa_total(tams: uint, ncol: uint, cap: uint) -> int {
    var total: uint = 0
    var k: uint = 0
    while k < ncol {
        let tam: uint = soa_tam(tams, k)
        if (tam != 0) and (cap > SOA_CAP_MAX / tam) {
            return -1
        }
        total += mapa_alinha(cap * tam)
        if total > SOA_TOTAL_MAX {
            return -1
        }
        k += 1
    }
    return total as int
}

// bloco do soa no alocador: frame grava a epoca; heap e frame pelo a64_mem; Arena/Pool pelo caminho de lista
proc soa_bloco(f: SoaForma, alocador: u32, total: uint, epoca: uint) -> uint {
    if alocador == ALOC_FRAME {
        mapa_grava_le(epoca, mem.epoca_frame(), 4)
    }
    if (alocador == ALOC_HEAP) or (alocador == ALOC_FRAME) {
        return mem.mem_alocar(alocador, total as int, f.arquivo, f.linha)
    }
    return mem.alocar_lista_em_handle(alocador as uint, total, f.arquivo, f.linha)
}

// col[k] = bloco + deslocamento da coluna k
proc soa_distribuir(col: uint, f: SoaForma, bloco: uint) {
    var off: uint = 0
    var k: uint = 0
    while k < f.ncol {
        mapa_grava_campo(col, k * TAM_PONTEIRO, bloco + off)
        off += mapa_alinha(f.linhas * soa_tam(f.tams, k))
        k += 1
    }
}

// copia as len linhas das colunas atuais para o bloco novo (de f.linhas linhas)
proc soa_copiar(col: uint, f: SoaForma, bloco: uint, len: uint) {
    var off: uint = 0
    var k: uint = 0
    while k < f.ncol {
        let tam: uint = soa_tam(f.tams, k)
        if len > 0 {
            mapa_copia_bytes(bloco + off, wasm_rt.memoria_ler_u64(col + k * TAM_PONTEIRO), len * tam)
        }
        off += mapa_alinha(f.linhas * tam)
        k += 1
    }
}

// soa[dynamic]S sem alocador (valor zero) = R0007 no crescer; fora do limite = R0007
// LIMITE: 8 parametros; mesma ordem da assinatura de forja_soa_criar (ponte por nome)
pub proc soa_criar(col: uint, tams: uint, ncol: u32, cap: int, alocador: u32, epoca: uint, arquivo: cstr, linha: i32) {
    mapa_grava_le(epoca, 0, 4)
    if cap < 0 {
        mapa_falha("make com cap negativo", cap, arquivo, linha)
    }
    if cap == 0 {
        var k: uint = 0
        while k < (ncol as uint) {
            mapa_grava_campo(col, k * TAM_PONTEIRO, 0)
            k += 1
        }
        return
    }
    let total: int = soa_total(tams, ncol as uint, cap as uint)
    if total < 0 {
        mapa_falha("make com cap grande demais para a memoria", cap, arquivo, linha)
    }
    let f = SoaForma{tams = tams, ncol = ncol as uint, linhas = cap as uint, arquivo = arquivo, linha = linha}
    let bloco: uint = soa_bloco(f,alocador, total as uint, epoca)
    soa_distribuir(col, f,bloco)
}

// append numa soa: cap 0..3 vira 8, depois dobra; o cap novo volta pelo ponteiro cap (int64 em memoria)
// LIMITE: 9 parametros; mesma ordem da assinatura de forja_soa_crescer (ponte por nome)
pub proc soa_crescer(col: uint, tams: uint, ncol: u32, len: int, cap: uint, alocador: u32, epoca: uint, arquivo: cstr, linha: i32) {
    if alocador == 0 {
        mapa_falha("append numa soa sem alocador (valor zero): crie com make(soa[dynamic]S, em = heap)", 0, arquivo, linha)
    }
    let cap_antigo: uint = wasm_rt.memoria_ler_u64(cap)
    var linhas: uint = 0
    var total: int = -1
    if cap_antigo <= SOA_TOTAL_MAX {
        linhas = SOA_LINHAS_INICIAL
        if cap_antigo >= SOA_LINHAS_LIMIAR {
            linhas = cap_antigo * 2
        }
        total = soa_total(tams, ncol as uint, linhas)
    }
    if total < 0 {
        mapa_falha("append: a soa passou do limite de memoria com cap", cap_antigo as int, arquivo, linha)
    }
    let f = SoaForma{tams = tams, ncol = ncol as uint, linhas = linhas, arquivo = arquivo, linha = linha}
    let bloco: uint = soa_bloco(f,alocador, total as uint, epoca)
    soa_copiar(col, f,bloco, len as uint)
    let velho: uint = wasm_rt.memoria_ler_u64(col)
    if (alocador == ALOC_HEAP) and (velho != 0) {
        mem.mem_liberar(velho, arquivo, linha)
    }
    soa_distribuir(col, f,bloco)
    wasm_rt.memoria_escrever_u64(cap, linhas)
}

// libera o bloco unico pela primeira coluna (heap); frame e Arena/Pool nao devolvem nada
pub proc soa_liberar(col: uint, alocador: u32, arquivo: cstr, linha: i32) {
    let primeira: uint = wasm_rt.memoria_ler_u64(col)
    if (alocador == ALOC_HEAP) and (primeira != 0) {
        mem.mem_liberar(primeira, arquivo, linha)
    }
}
