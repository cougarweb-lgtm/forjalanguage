// forja_os_error_text(codigo, destino, n, local): texto do errno (ingles); 0 e codigo sem texto = "". local e ignorado no Linux
pub proc os_error_text(codigo: i64, destino: ^u8, n: i64, local: i32) -> i64 {
    let indice: int = codigo as int
    var texto: str = ""
    if (indice > 0) and (indice <= OS_ERRNO_MAXIMO) {
        texto = OS_TEXTO_ERRNO[indice]
    }
    return rt_errno_entregar(texto, destino, n)
}

// Copia o texto para destino como o rt_os_entregar do x64: so grava se n > tamanho (com NUL no fim); devolve o tamanho
proc rt_errno_entregar(texto: str, destino: ^u8, n: i64) -> i64 {
    let tam: int = len(texto)
    if n > (tam as i64) {
        let base: uint = transmute(destino as rawptr, to = uint)
        let bytes: []u8 = as_bytes(texto)
        for k in 0..<tam {
            host.rt_escrever_u8(base + (k as uint), bytes[k])
        }
        host.rt_escrever_u8(base + (tam as uint), 0)
    }
    return tam as i64
}
