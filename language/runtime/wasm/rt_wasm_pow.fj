const POW_2INF_MENOS1: u64 = 0xffdfffffffffffff
const POW_2UM: u64 = 0x7fe0000000000000
const POW_SIGN_BIAS: u32 = 0x40000
const POWF_OFF: u32 = 0x3f330000
const POWF_2INF: u32 = 0xff000000
const POWF_2UM: u32 = 0x7f000000
const POWF_2INF_MENOS1: u32 = 0xfeffffff
