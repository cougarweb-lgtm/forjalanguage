    0x3fd27616c9496e0b, 0xbfd71969a075c67a, 0x3fdec70a6ca7badd, 0xbfe7154748bef6c8,
    0x3ff71547652ab82b
}

const POWF_EXP2_TAB: [32]u64 = {
    0x3ff0000000000000, 0x3fefd9b0d3158574, 0x3fefb5586cf9890f, 0x3fef9301d0125b51,
    0x3fef72b83c7d517b, 0x3fef54873168b9aa, 0x3fef387a6e756238, 0x3fef1e9df51fdee1,
    0x3fef06fe0a31b715, 0x3feef1a7373aa9cb, 0x3feedea64c123422, 0x3feece086061892d,
    0x3feebfdad5362a27, 0x3feeb42b569d4f82, 0x3feeab07dd485429, 0x3feea47eb03a5585,
    0x3feea09e667f3bcd, 0x3fee9f75e8ec5f74, 0x3feea11473eb0187, 0x3feea589994cce13,
    0x3feeace5422aa0db, 0x3feeb737b0cdc5e5, 0x3feec49182a3f090, 0x3feed503b23e255d,
    0x3feee89f995ad3ad, 0x3feeff76f2fb5e47, 0x3fef199bdd85529c, 0x3fef3720dcef9069,
    0x3fef5818dcfba487, 0x3fef7c97337b9b5f, 0x3fefa4afa2a490da, 0x3fefd0765b6e4540
}

const POWF_EXP2_SHIFT_SCALED: u64 = 0x42e8000000000000

const POWF_EXP2_POLY: [3]u64 = {
    0x3fac6af84b912394, 0x3fcebfce50fac4f3, 0x3fe62e42ff0c52d6
}

const POW_BITS_UM: u64 = 0x3ff0000000000000

const POW_BITS_2P52: u64 = 0x4330000000000000

const POW_BITS_2P1009: u64 = 0x7f00000000000000

const POW_BITS_2P_1022: u64 = 0x0010000000000000

const POW_BITS_2P769: u64 = 0x7000000000000000

const POW_BITS_2P_767: u64 = 0x1000000000000000

const POW_BITS_126: u64 = 0x405f800000000000

const POWF_LIMITE_YLOGX: u64 = 0x405fffffffd1d571

const POWF_BITS_2P23: u32 = 0x4b000000

const POWF_BITS_2P97: u32 = 0x70000000

const POWF_BITS_2P_95: u32 = 0x10000000

// ---- helpers comuns (musl pow.c e __math_*) ----

// Bits de sinal e expoente (12 bits altos) de um double, como o top12 do musl
proc pow_top12(bits: u64) -> u32 {
    return (bits >> 52) as u32
}

// Bits de 0, inf ou NaN: 2*i - 1 >= 2*inf - 1 em u64 (o musl conta com a volta do unsigned)
proc pow_zero_inf_nan(i: u64) -> bool {
    return wrapping_sub(wrapping_mul(i, 2), 1) >= POW_2INF_MENOS1
}

// Infinito com o sinal pedido (musl __math_oflow: 2^769 * 2^769 estoura)
proc pow_oflow(sinal: u32) -> f64 {
    let grande: f64 = transmute(POW_BITS_2P769, to = f64)
    if sinal != 0 {
        return (-grande) * grande
    }
    return grande * grande
}

// Zero com o sinal pedido (musl __math_uflow: 2^-767 * 2^-767 some)
proc pow_uflow(sinal: u32) -> f64 {
    let pequeno: f64 = transmute(POW_BITS_2P_767, to = f64)
    if sinal != 0 {
        return (-pequeno) * pequeno
    }
    return pequeno * pequeno
}

// NaN do musl __math_invalid: (x - x) / (x - x)
proc pow_invalid(x: f64) -> f64 {
    return (x - x) / (x - x)
}

// 0 se y nao e inteiro, 1 se e inteiro impar, 2 se e par (ou grande demais para ter fracao); iy sao bits de y != 0
proc pow_checkint(iy: u64) -> int {
    let e: int = ((iy >> 52) & 0x7ff) as int
    if e < 0x3ff {
        return 0
    }
    if e > 0x3ff + 52 {
        return 2
    }
    let sh: u64 = (0x3ff + 52 - e) as u64
    if (iy & (((1 as u64) << sh) - 1)) != 0 {
        return 0
    }
    if (iy & ((1 as u64) << sh)) != 0 {
        return 1
    }
    return 2
}

// ---- pow (f64) ----

// pow(x, y) em f64 (musl pow.c): caminho normal direto; x ou y fora dele vao para pow_caso_limite
pub proc math_pow(x: f64, y: f64) -> f64 {
    let ix: u64 = transmute(x, to = u64)
    let iy: u64 = transmute(y, to = u64)
    let topx: u32 = pow_top12(ix)
    let topy: u32 = pow_top12(iy)
    if wrapping_sub(topx, 1) >= 0x7fe or wrapping_sub(topy & 0x7ff, 0x3be) >= 0x80 {
        return pow_caso_limite(x, y, ix, iy)
    }
    return pow_nucleo(y, ix, 0)
}

// Casos de borda do pow (musl pow.c, ramo "x ou y fora do caminho normal"); o que sobra cai em pow_nucleo
proc pow_caso_limite(x: f64, y: f64, ix: u64, iy: u64) -> f64 {
    if pow_zero_inf_nan(iy) {
        return pow_caso_y_especial(x, y, ix, iy)
    }
    if pow_zero_inf_nan(ix) {
        return pow_caso_x_especial(x, ix, iy)
    }
    var sinal: u32 = 0
    var ix_pos: u64 = ix
    if (ix >> 63) == 1 {
        let yint: int = pow_checkint(iy)
        if yint == 0 {
            return pow_invalid(x)
        }
        if yint == 1 {
            sinal = POW_SIGN_BIAS
        }
        ix_pos = ix & POW_MASCARA_SEM_SINAL
    }
    if wrapping_sub(pow_top12(iy) & 0x7ff, 0x3be) >= 0x80 {
        return pow_y_extremo(y, ix_pos, iy)
    }
    if (ix_pos >> 52) == 0 {
        // x subnormal: multiplica por 2^52 para o expoente virar negativo (o musl faz o mesmo)
        let ampliado: f64 = x * transmute(POW_BITS_2P52, to = f64)
        ix_pos = wrapping_sub(transmute(ampliado, to = u64) & POW_MASCARA_SEM_SINAL, 0x0340000000000000)
    }
    return pow_nucleo(y, ix_pos, sinal)
}

// y = 0, inf ou NaN (musl pow.c, primeiro ramo); issignaling_inline e 0 neste alvo, por isso o 1.0 sai sempre
proc pow_caso_y_especial(x: f64, y: f64, ix: u64, iy: u64) -> f64 {
    if wrapping_mul(iy, 2) == 0 {
        return 1.0
    }
    if ix == POW_BITS_UM {
        return 1.0
    }
    if wrapping_mul(ix, 2) > POW_2INF or wrapping_mul(iy, 2) > POW_2INF {
        return x + y
    }
    if wrapping_mul(ix, 2) == POW_2UM {
        return 1.0
    }
    let abaixo_de_um: bool = wrapping_mul(ix, 2) < POW_2UM
    let y_positivo: bool = (iy >> 63) == 0
    if abaixo_de_um == y_positivo {
        return 0.0
    }
    return y * y
}

// x = 0, inf ou NaN (musl pow.c, segundo ramo): |x|^y com o sinal de x quando y e inteiro impar
proc pow_caso_x_especial(x: f64, ix: u64, iy: u64) -> f64 {
    var x2: f64 = x * x
    if (ix >> 63) == 1 and pow_checkint(iy) == 1 {
        x2 = -x2
    }
    if (iy >> 63) == 1 {
        return 1.0 / x2
    }
    return x2
}

// |y| < 2^-65 ou |y| >= 2^63 (musl pow.c): 1 +- y, ou +inf / 0 conforme |x| e o sinal de y
proc pow_y_extremo(y: f64, ix: u64, iy: u64) -> f64 {
    if ix == POW_BITS_UM {
        return 1.0
    }
    let topy: u32 = pow_top12(iy)
    if (topy & 0x7ff) < 0x3be {
        if ix > POW_BITS_UM {
            return 1.0 + y
        }
        return 1.0 - y
    }
    let maior_que_um: bool = ix > POW_BITS_UM
    let y_positivo: bool = topy < 0x800
    if maior_que_um == y_positivo {
        return pow_oflow(0)
    }
    return pow_uflow(0)
}

// Caminho geral: log(|x|) em dupla precisao e depois exp(y * log) com a multiplicacao partida em alta e baixa (musl pow.c)
proc pow_nucleo(y: f64, ix: u64, sinal: u32) -> f64 {
    let hi, lo = pow_log_inline(ix)
    let iy: u64 = transmute(y, to = u64)
    let yhi: f64 = transmute(iy & POW_MASCARA_27, to = f64)
    let ylo: f64 = y - yhi
    let lhi: f64 = transmute(transmute(hi, to = u64) & POW_MASCARA_27, to = f64)
    let llo: f64 = hi - lhi + lo
    let ehi: f64 = yhi * lhi
    let elo: f64 = ylo * lhi + y * llo
    return pow_exp_inline(ehi, elo, sinal)
}

// log(x) = y + cauda, com cerca de 15 bits extras (musl pow.c log_inline); ix ja vem normalizado
proc pow_log_inline(ix: u64) -> (y: f64, cauda: f64) {
    let tmp: u64 = wrapping_sub(ix, POW_OFF)
    let i: int = (((tmp >> 45) % 128) as int)
    // (int64_t)tmp >> 52 e o campo de 12 bits altos com extensao de sinal (Forja nao faz >> em inteiro com sinal)
    var k: int = (tmp >> 52) as int
    if k >= 0x800 {
        k -= 0x1000
    }
    let kd: f64 = k as f64
    let iz: u64 = wrapping_sub(ix, tmp & POW_MASCARA_EXPOENTE)
    let z: f64 = transmute(iz, to = f64)
    let invc: f64 = transmute(POW_LOG_INVC[i], to = f64)
    let logc: f64 = transmute(POW_LOG_LOGC[i], to = f64)
    let logctail: f64 = transmute(POW_LOG_LOGCTAIL[i], to = f64)
    let zhi: f64 = transmute(wrapping_add(iz, 0x80000000) & POW_MASCARA_32, to = f64)
    let zlo: f64 = z - zhi
    let rhi: f64 = zhi * invc - 1.0
    let rlo: f64 = zlo * invc
    let r: f64 = rhi + rlo
    let a0: f64 = transmute(POW_LOG_POLY[0], to = f64)
    let a1: f64 = transmute(POW_LOG_POLY[1], to = f64)
    let a2: f64 = transmute(POW_LOG_POLY[2], to = f64)
    let a3: f64 = transmute(POW_LOG_POLY[3], to = f64)
    let a4: f64 = transmute(POW_LOG_POLY[4], to = f64)
    let a5: f64 = transmute(POW_LOG_POLY[5], to = f64)
    let a6: f64 = transmute(POW_LOG_POLY[6], to = f64)
    let t1: f64 = kd * transmute(POW_LN2HI, to = f64) + logc
    let t2: f64 = t1 + r
    let lo1: f64 = kd * transmute(POW_LN2LO, to = f64) + logctail
    let lo2: f64 = t1 - t2 + r
    let ar: f64 = a0 * r
    let ar2: f64 = r * ar
    let ar3: f64 = r * ar2
    let arhi: f64 = a0 * rhi
    let arhi2: f64 = rhi * arhi
    let hi: f64 = t2 + arhi2
    let lo3: f64 = rlo * (ar + arhi)
    let lo4: f64 = t2 - hi + arhi2
    let p: f64 = ar3 * (a1 + r * a2 + ar2 * (a3 + r * a4 + ar2 * (a5 + r * a6)))
    let lo: f64 = lo1 + lo2 + lo3 + lo4 + p
    let y: f64 = hi + lo
    return y, hi - y + lo
}

// exp(x + cauda) com sinal (musl pow.c exp_inline, tabela de 2^(k/128)); |cauda| <= |x| e |cauda| < 2^-8/128
proc pow_exp_inline(x: f64, cauda: f64, sinal: u32) -> f64 {
    var abstop: u32 = pow_top12(transmute(x, to = u64)) & 0x7ff
    // |x| perto de zero, muito grande ou tratado pelo specialcase: o musl separa estes casos com a mesma faixa
    if wrapping_sub(abstop, 0x3c9) >= 0x3f {
        if wrapping_sub(abstop, 0x3c9) >= 0x80000000 {
            let um: f64 = 1.0 + x
            if sinal != 0 {
                return -um
            }
            return um
        }
        if abstop >= 0x409 {
            if (transmute(x, to = u64) >> 63) == 1 {
                return pow_uflow(sinal)
            }
            return pow_oflow(sinal)
        }
        abstop = 0
    }
    let z: f64 = transmute(POW_EXP_INVLN2N, to = f64) * x
    let shift: f64 = transmute(POW_EXP_SHIFT, to = f64)
    let kdb: f64 = z + shift
    let ki: u64 = transmute(kdb, to = u64)
    let kd: f64 = kdb - shift
    let r0: f64 = x + kd * transmute(POW_EXP_NEGLN2HI, to = f64) + kd * transmute(POW_EXP_NEGLN2LO, to = f64)
    let r: f64 = r0 + cauda
    let idx: int = (2 * (ki % 128)) as int
    let top: u64 = wrapping_add(ki, sinal as u64) << 45
    let tail: f64 = transmute(POW_EXP_TAB[idx], to = f64)
    let sbits: u64 = wrapping_add(POW_EXP_TAB[idx + 1], top)
    let c2: f64 = transmute(POW_EXP_POLY[0], to = f64)
    let c3: f64 = transmute(POW_EXP_POLY[1], to = f64)
    let c4: f64 = transmute(POW_EXP_POLY[2], to = f64)
    let c5: f64 = transmute(POW_EXP_POLY[3], to = f64)
    let r2: f64 = r * r
    let tmp: f64 = tail + r + r2 * (c2 + r * c3) + r2 * r2 * (c4 + r * c5)
    if abstop == 0 {
        return pow_specialcase(tmp, sbits, ki)
    }
    let escala: f64 = transmute(sbits, to = f64)
    return escala + escala * tmp
}

// Resultado com k fora da faixa segura (estouro se k > 0, subnormal se k < 0), sem dupla arredondagem (musl specialcase)
proc pow_specialcase(tmp: f64, sbits: u64, ki: u64) -> f64 {
    if (ki & 0x80000000) == 0 {
        let escala: f64 = transmute(wrapping_sub(sbits, (1009 as u64) << 52), to = f64)
        return transmute(POW_BITS_2P1009, to = f64) * (escala + escala * tmp)
    }
    let sb: u64 = wrapping_add(sbits, (1022 as u64) << 52)
    let escala: f64 = transmute(sb, to = f64)
    var y: f64 = escala + escala * tmp
    if y < 1.0 and y > -1.0 {
        // arredonda antes de descer ao subnormal: evita o erro de dupla arredondagem do musl
        var um: f64 = 1.0
        if y < 0.0 {
            um = -1.0
        }
        let lo0: f64 = escala - y + escala * tmp
        let hi: f64 = um + y
        let lo: f64 = um - hi + y + lo0
        y = (hi + lo) - um
        if y == 0.0 {
            y = transmute(sb & POW_BIT_SINAL, to = f64)
        }
    }
    return transmute(POW_BITS_2P_1022, to = f64) * y
}

// ---- powf (f32) ----

// powf(x, y) em f32 (musl powf.c): caminho normal direto; x ou y fora dele vao para powf_caso_limite
pub proc math_powf(x: f32, y: f32) -> f32 {
    let ix: u32 = transmute(x, to = u32)
    let iy: u32 = transmute(y, to = u32)
    if wrapping_sub(ix, 0x00800000) >= 0x7f000000 or powf_zero_inf_nan(iy) {
        return powf_caso_limite(x, y, ix, iy)
    }
    return powf_nucleo(y, ix, 0)
}

// Bits de 0, inf ou NaN em u32 (mesma conta do pow, com 32 bits)
proc powf_zero_inf_nan(i: u32) -> bool {
    return wrapping_sub(wrapping_mul(i, 2), 1) >= POWF_2INF_MENOS1
}

// 0 se y nao e inteiro, 1 se e inteiro impar, 2 se e par (ou grande demais para ter fracao)
proc powf_checkint(iy: u32) -> int {
    let e: int = ((iy >> 23) & 0xff) as int
    if e < 0x7f {
        return 0
    }
    if e > 0x7f + 23 {
        return 2
    }
    let sh: u32 = (0x7f + 23 - e) as u32
    if (iy & (((1 as u32) << sh) - 1)) != 0 {
        return 0
    }
    if (iy & ((1 as u32) << sh)) != 0 {
        return 1
    }
    return 2
}

// NaN do musl __math_invalidf: (x - x) / (x - x)
proc powf_invalid(x: f32) -> f32 {
    return (x - x) / (x - x)
}

// Infinito f32 com o sinal pedido (musl __math_oflowf: 2^97 * 2^97 estoura)
proc powf_oflow(sinal: u32) -> f32 {
    let grande: f32 = transmute(POWF_BITS_2P97, to = f32)
    if sinal != 0 {
        return (-grande) * grande
    }
    return grande * grande
}

// Zero f32 com o sinal pedido (musl __math_uflowf: 2^-95 * 2^-95 some)
proc powf_uflow(sinal: u32) -> f32 {
    let pequeno: f32 = transmute(POWF_BITS_2P_95, to = f32)
    if sinal != 0 {
        return (-pequeno) * pequeno
    }
    return pequeno * pequeno
}

// Casos de borda do powf (musl powf.c, ramo "x ou y fora do caminho normal"); o que sobra cai em powf_nucleo
proc powf_caso_limite(x: f32, y: f32, ix: u32, iy: u32) -> f32 {
    if powf_zero_inf_nan(iy) {
        return powf_caso_y_especial(x, y, ix, iy)
    }
    if powf_zero_inf_nan(ix) {
        return powf_caso_x_especial(x, ix, iy)
    }
    var sinal: u32 = 0
    var ix_pos: u32 = ix
    if (ix & 0x80000000) != 0 {
        let yint: int = powf_checkint(iy)
        if yint == 0 {
            return powf_invalid(x)
        }
        if yint == 1 {
            sinal = POWF_SIGN_BIAS
        }
        ix_pos = ix & 0x7fffffff
    }
    if ix_pos < 0x00800000 {
        // x subnormal: multiplica por 2^23 e corrige o expoente (o musl faz o mesmo)
        let ampliado: f32 = x * transmute(POWF_BITS_2P23, to = f32)
        ix_pos = wrapping_sub(transmute(ampliado, to = u32) & 0x7fffffff, 0x0b800000)
    }
    return powf_nucleo(y, ix_pos, sinal)
}

// y = 0, inf ou NaN (musl powf.c, primeiro ramo); issignalingf e 0 neste alvo, por isso o 1.0 sai sempre
proc powf_caso_y_especial(x: f32, y: f32, ix: u32, iy: u32) -> f32 {
    if wrapping_mul(iy, 2) == 0 {
        return 1.0
    }
    if ix == 0x3f800000 {
        return 1.0
    }
    if wrapping_mul(ix, 2) > POWF_2INF or wrapping_mul(iy, 2) > POWF_2INF {
        return x + y
    }
    if wrapping_mul(ix, 2) == POWF_2UM {
        return 1.0
    }
    let abaixo_de_um: bool = wrapping_mul(ix, 2) < POWF_2UM
    let y_positivo: bool = (iy & 0x80000000) == 0
    if abaixo_de_um == y_positivo {
        return 0.0
    }
    return y * y
}

// x = 0, inf ou NaN (musl powf.c, segundo ramo): |x|^y com o sinal de x quando y e inteiro impar
proc powf_caso_x_especial(x: f32, ix: u32, iy: u32) -> f32 {
    var x2: f32 = x * x
    if (ix & 0x80000000) != 0 and powf_checkint(iy) == 1 {
        x2 = -x2
    }
    if (iy & 0x80000000) != 0 {
        return 1.0 / x2
    }
    return x2
}

// Caminho geral do powf: y * log2(x) em f64 e depois exp2, com os limites de estouro e de zero (musl powf.c)
proc powf_nucleo(y: f32, ix: u32, sinal: u32) -> f32 {
    let logx: f64 = powf_log2_inline(ix)
    let ylogx: f64 = (y as f64) * logx
    let bits_ylogx: u64 = transmute(ylogx, to = u64)
    if ((bits_ylogx >> 47) & 0xffff) >= (transmute(POW_BITS_126, to = u64) >> 47) {
        if ylogx > transmute(POWF_LIMITE_YLOGX, to = f64) {
            return powf_oflow(sinal)
        }
        if ylogx <= -150.0 {
            return powf_uflow(sinal)
        }
    }
    return powf_exp2_inline(ylogx, sinal)
}

// log2(x) em f64 com tabela de 16 entradas (musl powf.c log2_inline; POWF_SCALE = 1 neste alvo)
proc powf_log2_inline(ix: u32) -> f64 {
    let tmp: u32 = wrapping_sub(ix, POWF_OFF)
    let i: int = (((tmp >> 19) % 16) as int)
    let top: u32 = tmp & 0xff800000
    let iz: u32 = wrapping_sub(ix, top)
    // (int32_t)top >> 23: os 9 bits de sinal do expoente (Forja nao faz >> em inteiro com sinal)
    var k: int = (top >> 23) as int
    if k >= 0x100 {
        k -= 0x200
    }
    let kf: f64 = k as f64
    let invc: f64 = transmute(POWF_LOG2_INVC[i], to = f64)
    let logc: f64 = transmute(POWF_LOG2_LOGC[i], to = f64)
    let z: f64 = (transmute(iz, to = f32)) as f64
    let r: f64 = z * invc - 1.0
    let y0: f64 = logc + kf
    let r2: f64 = r * r
    let a0: f64 = transmute(POWF_LOG2_POLY[0], to = f64)
    let a1: f64 = transmute(POWF_LOG2_POLY[1], to = f64)
    let a2: f64 = transmute(POWF_LOG2_POLY[2], to = f64)
    let a3: f64 = transmute(POWF_LOG2_POLY[3], to = f64)
    let a4: f64 = transmute(POWF_LOG2_POLY[4], to = f64)
    let y: f64 = a0 * r + a1
    let p: f64 = a2 * r + a3
    let r4: f64 = r2 * r2
    let q: f64 = a4 * r + y0
    let q2: f64 = p * r2 + q
    return y * r4 + q2
}

// exp2 em f32 com tabela de 32 entradas (musl powf.c exp2_inline, sem TOINT_INTRINSICS)
proc powf_exp2_inline(xd: f64, sinal: u32) -> f32 {
    let shift: f64 = transmute(POWF_EXP2_SHIFT_SCALED, to = f64)
    let kd0: f64 = xd + shift
    let ki: u64 = transmute(kd0, to = u64)
    let kd: f64 = kd0 - shift
    let r: f64 = xd - kd
    let t0: u64 = POWF_EXP2_TAB[(ki % 32) as int]
    let ski: u64 = wrapping_add(ki, sinal as u64)
    let t: u64 = wrapping_add(t0, ski << 47)
    let s: f64 = transmute(t, to = f64)
    let c0: f64 = transmute(POWF_EXP2_POLY[0], to = f64)
    let c1: f64 = transmute(POWF_EXP2_POLY[1], to = f64)
    let c2: f64 = transmute(POWF_EXP2_POLY[2], to = f64)
    let z: f64 = c0 * r + c1
    let r2: f64 = r * r
    let y: f64 = c2 * r + 1.0
    let y2: f64 = z * r2 + y
    return (y2 * s) as f32
}
