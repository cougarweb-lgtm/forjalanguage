// Padroes de bits usados em comparacao e em soma de expoente: literal >= 2^63 so aceita tipo u64 via const (E0420)
const BITS_POS_INF: u64 = 0x7ff0000000000000  // +inf (__math_oflow(0) e exp(+inf))
const BITS_NEG_INF: u64 = 0xfff0000000000000  // -inf (exp(-inf) = 0)
const BITS_NEG_1075: u64 = 0xc090cc0000000000  // asuint64(-1075.0): limite de underflow de exp2
const BITS_DOBRO_928: u64 = 0x811a000000000000  // 2 * asuint64(928.0): limite de caso de borda de exp2
const BITS_EXPOENTE_1009: u64 = 0x3f10000000000000  // 1009 << 52: ajuste do expoente de exp (k > 0)
const BITS_EXPOENTE_1022: u64 = 0x3fe0000000000000  // 1022 << 52: ajuste do expoente no subnormal (k < 0)
const BITS_UM_EXPOENTE: u64 = 0x0010000000000000  // 1 << 52: ajuste do expoente de exp2 (k > 0)
const BITS_ESCALA_2_POW_1009: u64 = 0x7f00000000000000  // bits de 2^1009
const BITS_ESCALA_2_POW_NEG_1022: u64 = 0x0010000000000000  // bits de 2^-1022
const LOG_BITS_PERTO1_LO: u64 = 0x3fee000000000000  // asuint64(1.0 - 0x1p-4): inicio da faixa perto de 1 do log
const LOG_BITS_PERTO1_LARGURA: u64 = 0x0003090000000000  // asuint64(1.0 + 0x1.09p-4) - LO: largura da faixa
const LOG_BITS_OFF: u64 = 0x3fe6000000000000  // OFF do musl: a faixa [OFF, 2*OFF) e reduzida a z
const LOG_BITS_52_EXPOENTE: u64 = 0x0340000000000000  // 52 << 52: ajuste do expoente de subnormal
const LOG_MASCARA_EXPOENTE: u64 = 0xfff0000000000000  // 0xfff << 52: bits de expoente que saem de iz
const LOG_MASCARA_ALTA: u64 = 0xffffffff00000000  // -1 << 32: zera a parte baixa para o split hi/lo
const LOG2_BITS_PERTO1_LO: u64 = 0x3feea4af00000000  // asuint64(1.0 - 0x1.5b51p-5): inicio da faixa perto de 1 do log2
const LOG2_BITS_PERTO1_LARGURA: u64 = 0x000210aa00000000  // asuint64(1.0 + 0x1.6ab2p-5) - LO
const LOG10_AJUSTE_HX: u32 = 0x00095f62  // 0x3ff00000 - 0x3fe6a09e: leva hx para a faixa [sqrt(2)/2, sqrt(2)]
const LOG10_BASE_HX: u32 = 0x3fe6a09e  // hx do centro da faixa de log10

// Subnormal de exp e exp2 (musl specialcase, ramo k < 0): y < 1 e arredondado antes de escalar por 2^-1022
proc exp_subnormal(tmp: f64, sbits: u64) -> f64 {
    let escala: f64 = transmute(wrapping_add(sbits, BITS_EXPOENTE_1022), to = f64)
    var y: f64 = escala + escala * tmp
    if y < 1.0 {
        // dupla arredondagem evitada: o erro de y passa para lo e so depois vira y - 1 (porte do specialcase)
        let baixo: f64 = escala - y + escala * tmp
        let alto: f64 = 1.0 + y
        let soma: f64 = 1.0 - alto + y + baixo
        y = alto + soma - 1.0
        if y == 0.0 {
            // -0.0 some com arredondamento para baixo (WANT_ROUNDING do musl)
            y = 0.0
        }
    }
    return transmute(BITS_ESCALA_2_POW_NEG_1022, to = f64) * y
}

// Caso de borda de exp (musl specialcase): k > 0 escala por 2^1009 para nao estourar o expoente
proc exp_specialcase(tmp: f64, sbits: u64, ki: u64) -> f64 {
    if (ki & 0x80000000) == 0 {
        let escala_alta: f64 = transmute(wrapping_sub(sbits, BITS_EXPOENTE_1009), to = f64)
        return transmute(BITS_ESCALA_2_POW_1009, to = f64) * (escala_alta + escala_alta * tmp)
    }
    return exp_subnormal(tmp, sbits)
}

// Caso de borda de exp2 (musl specialcase): k > 0 usa 2 * scale, sem o fator 2^1009 de exp
proc exp2_specialcase(tmp: f64, sbits: u64, ki: u64) -> f64 {
    if (ki & 0x80000000) == 0 {
        let escala_alta: f64 = transmute(wrapping_sub(sbits, BITS_UM_EXPOENTE), to = f64)
        return 2.0 * (escala_alta + escala_alta * tmp)
    }
    return exp_subnormal(tmp, sbits)
}

// exp(x) do musl exp.c: e^x com tabela de 2 * 128 entradas, polinomio de grau 5 e caso de borda
pub proc math_exp(x: f64) -> f64 {
    let bits: u64 = transmute(x, to = u64)
    var abstop: u32 = ((bits >> 52) & 0x7ff) as u32
    if wrapping_sub(abstop, 0x3c9) >= 0x3f {
        if wrapping_sub(abstop, 0x3c9) >= 0x80000000 {
            return 1.0 + x
        }
        if abstop >= 0x409 {
            if bits == BITS_NEG_INF {
                return 0.0
            }
            if abstop >= 0x7ff {
                return 1.0 + x
            }
            if (bits >> 63) == 1 {
                return 0.0
            }
            return transmute(BITS_POS_INF, to = f64)
        }
        abstop = 0
    }
    // x = k/N * ln2 + r; o truque do Shift arredonda z para inteiro sem chamar floor
    let invln2n: f64 = transmute(EXP_INVLN2N, to = f64)
    let shift: f64 = transmute(EXP_SHIFT, to = f64)
    let negln2hin: f64 = transmute(EXP_NEGLN2HIN, to = f64)
    let negln2lon: f64 = transmute(EXP_NEGLN2LON, to = f64)
    let z: f64 = invln2n * x
    var kd: f64 = z + shift
    let ki: u64 = transmute(kd, to = u64)
    kd = kd - shift
    let r: f64 = x + kd * negln2hin + kd * negln2lon
    let idx: u64 = 2 * (ki % 128)
    let tail: f64 = transmute(EXP_TAB[idx], to = f64)
    let sbits: u64 = wrapping_add(EXP_TAB[idx + 1], ki << 45)
    let r2: f64 = r * r
    let c2: f64 = transmute(EXP_C2, to = f64)
    let c3: f64 = transmute(EXP_C3, to = f64)
    let c4: f64 = transmute(EXP_C4, to = f64)
    let c5: f64 = transmute(EXP_C5, to = f64)
    let tmp: f64 = tail + r + r2 * (c2 + r * c3) + r2 * r2 * (c4 + r * c5)
    if abstop == 0 {
        return exp_specialcase(tmp, sbits, ki)
    }
    let scale: f64 = transmute(sbits, to = f64)
    return scale + scale * tmp
}

// exp2(x) do musl exp2.c: 2^x com a mesma tabela de exp, polinomio de grau 5 e caso de borda
pub proc math_exp2(x: f64) -> f64 {
    let bits: u64 = transmute(x, to = u64)
    var abstop: u32 = ((bits >> 52) & 0x7ff) as u32
    if wrapping_sub(abstop, 0x3c9) >= 0x3f {
        if wrapping_sub(abstop, 0x3c9) >= 0x80000000 {
            return 1.0 + x
        }
        if abstop >= 0x409 {
            if bits == BITS_NEG_INF {
                return 0.0
            }
            if abstop >= 0x7ff {
                return 1.0 + x
            }
            if (bits >> 63) == 0 {
                return transmute(BITS_POS_INF, to = f64)
            }
            if bits >= BITS_NEG_1075 {
                return 0.0
            }
        }
        // x acima de 928 (em modulo, com o dobro dos bits) e tratado como caso de borda
        if wrapping_mul(bits, 2) > BITS_DOBRO_928 {
            abstop = 0
        }
    }
    // x = k/N + r, com kd = x + Shift arredondado (exp2_shift = 1.5 * 2^52 / N)
    let shift: f64 = transmute(EXP_EXP2_SHIFT, to = f64)
    let kd_soma: f64 = x + shift
    let ki: u64 = transmute(kd_soma, to = u64)
    let kd: f64 = kd_soma - shift
    let r: f64 = x - kd
    let idx: u64 = 2 * (ki % 128)
    let tail: f64 = transmute(EXP_TAB[idx], to = f64)
    let sbits: u64 = wrapping_add(EXP_TAB[idx + 1], ki << 45)
    let r2: f64 = r * r
    let c1: f64 = transmute(EXP_EXP2_C1, to = f64)
    let c2: f64 = transmute(EXP_EXP2_C2, to = f64)
    let c3: f64 = transmute(EXP_EXP2_C3, to = f64)
    let c4: f64 = transmute(EXP_EXP2_C4, to = f64)
    let c5: f64 = transmute(EXP_EXP2_C5, to = f64)
    let tmp: f64 = tail + r * c1 + r2 * (c2 + r * c3) + r2 * r2 * (c4 + r * c5)
    if abstop == 0 {
        return exp2_specialcase(tmp, sbits, ki)
    }
    let scale: f64 = transmute(sbits, to = f64)
    return scale + scale * tmp
}

// k = (int64_t)tmp >> 52 do musl: o `>>` com sinal nao existe em i64 na Forja, entao reinterpreta os 12 bits altos
proc log_expoente_com_sinal(tmp: u64) -> i64 {
    var k: i64 = (tmp >> 52) as i64
    if k >= 2048 {
        k = k - 4096
    }
    return k
}

// log(x) perto de 1 (musl log.c, faixa 1 - 2^-4 .. 1 + 0x1.09p-4): polinomio em r = x - 1 com correcao hi/lo
proc log_perto_de_um(x: f64) -> f64 {
    let r: f64 = x - 1.0
    let r2: f64 = r * r
    let r3: f64 = r * r2
    let b0: f64 = transmute(LOG_B0, to = f64)
    let b1: f64 = transmute(LOG_B1, to = f64)
    let b2: f64 = transmute(LOG_B2, to = f64)
    let b3: f64 = transmute(LOG_B3, to = f64)
    let b4: f64 = transmute(LOG_B4, to = f64)
    let b5: f64 = transmute(LOG_B5, to = f64)
    let b6: f64 = transmute(LOG_B6, to = f64)
    let b7: f64 = transmute(LOG_B7, to = f64)
    let b8: f64 = transmute(LOG_B8, to = f64)
    let b9: f64 = transmute(LOG_B9, to = f64)
    let b10: f64 = transmute(LOG_B10, to = f64)
    let quarto: f64 = b7 + r * b8 + r2 * b9 + r3 * b10
    let terco: f64 = b4 + r * b5 + r2 * b6 + r3 * quarto
    let y: f64 = r3 * (b1 + r * b2 + r2 * b3 + r3 * terco)
    // r = rhi + rlo com rhi de metade alta: rhi * rhi e exato, e o resto de r vai para lo
    let w27: f64 = r * 134217728.0
    let rhi: f64 = r + w27 - w27
    let rlo: f64 = r - rhi
    let w: f64 = rhi * rhi * b0
    let hi: f64 = r + w
    var lo: f64 = r - hi + w
    lo = lo + b0 * rlo * (rhi + r)
    return y + lo + hi
}

// log2(x) perto de 1 (musl log2.c): mesma ideia de log_perto_de_um, com r / ln2 separado em hi e lo
proc log2_perto_de_um(x: f64) -> f64 {
    let r: f64 = x - 1.0
    let invln2hi: f64 = transmute(LOG2_INVLN2HI, to = f64)
    let invln2lo: f64 = transmute(LOG2_INVLN2LO, to = f64)
    let rhi: f64 = transmute(transmute(r, to = u64) & LOG_MASCARA_ALTA, to = f64)
    let rlo: f64 = r - rhi
    let hi: f64 = rhi * invln2hi
    let lo: f64 = rlo * invln2hi + r * invln2lo
    let r2: f64 = r * r
    let r4: f64 = r2 * r2
    let p: f64 = r2 * (transmute(LOG2_B0, to = f64) + r * transmute(LOG2_B1, to = f64))
    var y: f64 = hi + p
    var lo_corr: f64 = lo + (hi - y + p)
    let b2: f64 = transmute(LOG2_B2, to = f64)
    let b3: f64 = transmute(LOG2_B3, to = f64)
    let b4: f64 = transmute(LOG2_B4, to = f64)
    let b5: f64 = transmute(LOG2_B5, to = f64)
    let b6: f64 = transmute(LOG2_B6, to = f64)
    let b7: f64 = transmute(LOG2_B7, to = f64)
    let b8: f64 = transmute(LOG2_B8, to = f64)
    let b9: f64 = transmute(LOG2_B9, to = f64)
    lo_corr = lo_corr + r4 * (b2 + r * b3 + r2 * (b4 + r * b5) + r4 * (b6 + r * b7 + r2 * (b8 + r * b9)))
    y = y + lo_corr
    return y
}

// log(x) do musl log.c: tabela de 128 faixas (invc, logc, chi, clo), polinomio de grau 5 e caso de borda
// LIMITE: 70 linhas (constantes do musl em lets; o corpo logico e curto)
pub proc math_log(x: f64) -> f64 {
    let bits: u64 = transmute(x, to = u64)
    let top: u32 = (bits >> 48) as u32
    if wrapping_sub(bits, LOG_BITS_PERTO1_LO) < LOG_BITS_PERTO1_LARGURA {
        if x == 1.0 {
            return 0.0
        }
        return log_perto_de_um(x)
    }
    var ix: u64 = bits
    if wrapping_sub(top, 0x10) >= 0x7fe0 {
        if wrapping_mul(bits, 2) == 0 {
            return transmute(BITS_NEG_INF, to = f64)
        }
        if bits == BITS_POS_INF {
            return x
        }
        if (top & 0x8000) != 0 or (top & 0x7ff0) == 0x7ff0 {
            let nulo: f64 = x - x
            return nulo / nulo
        }
        // subnormal: normaliza multiplicando por 2^52 e corrige o expoente
        ix = wrapping_sub(transmute(x * 4503599627370496.0, to = u64), LOG_BITS_52_EXPOENTE)
    }
    let tmp: u64 = wrapping_sub(ix, LOG_BITS_OFF)
    let i: u64 = (tmp >> 45) % 128
    let k: i64 = log_expoente_com_sinal(tmp)
    let iz: u64 = wrapping_sub(ix, tmp & LOG_MASCARA_EXPOENTE)
    let invc: f64 = transmute(LOG_TAB[2 * i], to = f64)
    let logc: f64 = transmute(LOG_TAB[2 * i + 1], to = f64)
    let chi: f64 = transmute(LOG_TAB2[2 * i], to = f64)
    let clo: f64 = transmute(LOG_TAB2[2 * i + 1], to = f64)
    let z: f64 = transmute(iz, to = f64)
    // r ~ z/c - 1 (|r| < 1/(2N)), sem FMA: o musl usa (z - chi - clo) * invc
    let r: f64 = (z - chi - clo) * invc
    let kd: f64 = k as f64
    let w: f64 = kd * transmute(LOG_LN2HI, to = f64) + logc
    let hi: f64 = w + r
    let lo: f64 = w - hi + r + kd * transmute(LOG_LN2LO, to = f64)
    let r2: f64 = r * r
    let a0: f64 = transmute(LOG_A0, to = f64)
    let a1: f64 = transmute(LOG_A1, to = f64)
    let a2: f64 = transmute(LOG_A2, to = f64)
    let a3: f64 = transmute(LOG_A3, to = f64)
    let a4: f64 = transmute(LOG_A4, to = f64)
    return lo + r2 * a0 + r * r2 * (a1 + r * a2 + r2 * (a3 + r * a4)) + hi
}

// log2(x) do musl log2.c: mesma reducao de log, com r / ln2 em hi e lo e polinomio de grau 6
// LIMITE: 70 linhas (constantes do musl em lets; o corpo logico e curto)
pub proc math_log2(x: f64) -> f64 {
    let bits: u64 = transmute(x, to = u64)
    let top: u32 = (bits >> 48) as u32
    if wrapping_sub(bits, LOG2_BITS_PERTO1_LO) < LOG2_BITS_PERTO1_LARGURA {
        if x == 1.0 {
            return 0.0
        }
        return log2_perto_de_um(x)
    }
    var ix: u64 = bits
    if wrapping_sub(top, 0x10) >= 0x7fe0 {
        if wrapping_mul(bits, 2) == 0 {
            return transmute(BITS_NEG_INF, to = f64)
        }
        if bits == BITS_POS_INF {
            return x
        }
        if (top & 0x8000) != 0 or (top & 0x7ff0) == 0x7ff0 {
            let nulo: f64 = x - x
            return nulo / nulo
        }
        ix = wrapping_sub(transmute(x * 4503599627370496.0, to = u64), LOG_BITS_52_EXPOENTE)
    }
    let tmp: u64 = wrapping_sub(ix, LOG_BITS_OFF)
    let i: u64 = (tmp >> 46) % 64
    let k: i64 = log_expoente_com_sinal(tmp)
    let iz: u64 = wrapping_sub(ix, tmp & LOG_MASCARA_EXPOENTE)
    let invc: f64 = transmute(LOG2_TAB[2 * i], to = f64)
    let logc: f64 = transmute(LOG2_TAB[2 * i + 1], to = f64)
    let chi: f64 = transmute(LOG2_TAB2[2 * i], to = f64)
    let clo: f64 = transmute(LOG2_TAB2[2 * i + 1], to = f64)
    let z: f64 = transmute(iz, to = f64)
    let kd: f64 = k as f64
    let r: f64 = (z - chi - clo) * invc
    let invln2hi: f64 = transmute(LOG2_INVLN2HI, to = f64)
    let invln2lo: f64 = transmute(LOG2_INVLN2LO, to = f64)
    // r / ln2 em hi + lo: rhi tem so a metade alta de r, o resto vai para rlo
    let rhi: f64 = transmute(transmute(r, to = u64) & LOG_MASCARA_ALTA, to = f64)
    let rlo: f64 = r - rhi
    let t1: f64 = rhi * invln2hi
    let t2: f64 = rlo * invln2hi + r * invln2lo
    let t3: f64 = kd + logc
    let hi: f64 = t3 + t1
    let lo: f64 = t3 - hi + t1 + t2
    let r2: f64 = r * r
    let r4: f64 = r2 * r2
    let a0: f64 = transmute(LOG2_A0, to = f64)
    let a1: f64 = transmute(LOG2_A1, to = f64)
    let a2: f64 = transmute(LOG2_A2, to = f64)
    let a3: f64 = transmute(LOG2_A3, to = f64)
    let a4: f64 = transmute(LOG2_A4, to = f64)
    let a5: f64 = transmute(LOG2_A5, to = f64)
    let p: f64 = a0 + r * a1 + r2 * (a2 + r * a3) + r4 * (a4 + r * a5)
    return lo + r2 * p + hi
}

// log10(x) do musl log10.c (fdlibm): reducao por bits para [sqrt(2)/2, sqrt(2)], polinomio Lg1..Lg7 e soma hi/lo
// LIMITE: 75 linhas (cada constante do musl e um let com seu valor de origem)
pub proc math_log10(x: f64) -> f64 {
    var bits: u64 = transmute(x, to = u64)
    var hx: u32 = (bits >> 32) as u32
    var k: i32 = 0
    var xv: f64 = x
    if hx < 0x00100000 or (hx >> 31) == 1 {
        if wrapping_mul(bits, 2) == 0 {
            return transmute(BITS_NEG_INF, to = f64)
        }
        if (hx >> 31) == 1 {
            let nulo: f64 = x - x
            return nulo / nulo
        }
        // subnormal: escala x por 2^54 e compensa k
        k = k - 54
        xv = x * 18014398509481984.0
        bits = transmute(xv, to = u64)
        hx = (bits >> 32) as u32
    } else if hx >= 0x7ff00000 {
        return x
    } else if hx == 0x3ff00000 and (bits & 0xffffffff) == 0 {
        return 0.0
    }
    // reduz x para [sqrt(2)/2, sqrt(2)]: soma o ajuste ao hx e recalcula o expoente k
    hx = hx + LOG10_AJUSTE_HX
    k = k + ((hx >> 20) as i32) - 0x3ff
    hx = (hx & 0x000fffff) + LOG10_BASE_HX
    bits = ((hx as u64) << 32) | (bits & 0xffffffff)
    let f: f64 = transmute(bits, to = f64) - 1.0
    let hfsq: f64 = 0.5 * f * f
    let s: f64 = f / (2.0 + f)
    let z: f64 = s * s
    let w: f64 = z * z
    let lg1: f64 = transmute(LOG10_LG1, to = f64)
    let lg2: f64 = transmute(LOG10_LG2, to = f64)
    let lg3: f64 = transmute(LOG10_LG3, to = f64)
    let lg4: f64 = transmute(LOG10_LG4, to = f64)
    let lg5: f64 = transmute(LOG10_LG5, to = f64)
    let lg6: f64 = transmute(LOG10_LG6, to = f64)
    let lg7: f64 = transmute(LOG10_LG7, to = f64)
    let t1: f64 = w * (lg2 + w * (lg4 + w * lg6))
    let t2: f64 = z * (lg1 + w * (lg3 + w * (lg5 + w * lg7)))
    let rr: f64 = t2 + t1
    // hi = f - hfsq com os 32 bits baixos zerados; lo recebe o resto exato
    let hi: f64 = transmute(transmute(f - hfsq, to = u64) & LOG_MASCARA_ALTA, to = f64)
    let lo: f64 = f - hi - hfsq + s * (hfsq + rr)
    let ivln10hi: f64 = transmute(LOG10_IVLN10HI, to = f64)
    let ivln10lo: f64 = transmute(LOG10_IVLN10LO, to = f64)
    let dk: f64 = k as f64
    let y: f64 = dk * transmute(LOG10_LOG10_2HI, to = f64)
    let val_hi: f64 = hi * ivln10hi
    var val_lo: f64 = dk * transmute(LOG10_LOG10_2LO, to = f64) + (lo + hi) * ivln10lo + lo * ivln10hi
    let soma: f64 = y + val_hi
    val_lo = val_lo + ((y - soma) + val_hi)
    return val_lo + soma
}

// ---- f32: padroes de bits e limites (valores >= 2^31 so entram como const u32, pelo mesmo motivo de E0420) ----
const F32_BITS_POS_INF: u32 = 0x7f800000  // +inf em f32
const F32_BITS_NEG_INF: u32 = 0xff800000  // -inf em f32; tambem a mascara do expoente
const F32_BITS_UM: u32 = 0x3f800000  // 1.0f
const F32_BITS_SINAL: u32 = 0x80000000  // bit de sinal
const F32_BITS_EXPOENTE_INVALIDO: u32 = 0xff000000  // 2 * bits >= isto: NaN ou -inf (log)
const F32_MASCARA_HI: u32 = 0xfffff000  // u.i &= 0xfffff000 do log10f (zera 12 bits baixos)
const EXPF_BITS_LIMITE_ALTO: u32 = 0x42b17217  // 0x1.62e42ep6f: acima disso estoura f32 (expf)
const EXPF_BITS_LIMITE_BAIXO: u32 = 0xc2cff1b4  // -0x1.9fe368p6f: abaixo disso zera (expf)
const LOGF_BITS_OFF: u32 = 0x3f330000  // OFF do logf/log2f: centro da faixa reduzida
const LOG10F_AJUSTE: u32 = 0x004afb0d  // 0x3f800000 - 0x3f3504f3: leva ix para a faixa de sqrt(2)
const LOG10F_BASE: u32 = 0x3f3504f3  // ix do centro da faixa de log10f

// k = (int32_t)tmp >> 23 do musl: reinterpreta os 9 bits altos como sinalizados (sem `>>` com sinal em i32)
proc log_expoente_f32(tmp: u32) -> i32 {
    var k: i32 = (tmp >> 23) as i32
    if k >= 256 {
        k = k - 512
    }
    return k
}

// expf do musl expf.c: e^x em f32, tabela de 32 entradas, polinomio de grau 3 e conta em double
pub proc math_expf(x: f32) -> f32 {
    let bits: u32 = transmute(x, to = u32)
    let abstop: u32 = (bits >> 20) & 0x7ff
    if abstop >= 0x42b {
        if bits == F32_BITS_NEG_INF {
            return 0.0
        }
        if abstop >= 0x7f8 {
            return x + x
        }
        if x > transmute(EXPF_BITS_LIMITE_ALTO, to = f32) {
            return transmute(F32_BITS_POS_INF, to = f32)
        }
        if x < transmute(EXPF_BITS_LIMITE_BAIXO, to = f32) {
            return 0.0
        }
    }
    // x * N / ln2 = k + r com r em [-1/2, 1/2]; o Shift arredonda z para inteiro como em exp
    let xd: f64 = x as f64
    let z: f64 = transmute(EXP2F_INVLN2_SCALED, to = f64) * xd
    let shift: f64 = transmute(EXP2F_SHIFT, to = f64)
    var kd: f64 = z + shift
    let ki: u64 = transmute(kd, to = u64)
    kd = kd - shift
    let r: f64 = z - kd
    let t: u64 = wrapping_add(EXP2F_TAB[ki % 32], ki << 47)
    let s: f64 = transmute(t, to = f64)
    let c0: f64 = transmute(EXP2F_PS0, to = f64)
    let c1: f64 = transmute(EXP2F_PS1, to = f64)
    let c2: f64 = transmute(EXP2F_PS2, to = f64)
    let zc: f64 = c0 * r + c1
    let r2: f64 = r * r
    var y: f64 = c2 * r + 1.0
    y = zc * r2 + y
    return (y * s) as f32
}

// exp2f do musl exp2f.c: 2^x em f32, mesma tabela de expf com polinomio nao escalado
pub proc math_exp2f(x: f32) -> f32 {
    let bits: u32 = transmute(x, to = u32)
    let abstop: u32 = (bits >> 20) & 0x7ff
    if abstop >= 0x430 {
        if bits == F32_BITS_NEG_INF {
            return 0.0
        }
        if abstop >= 0x7f8 {
            return x + x
        }
        if x > 0.0 {
            return transmute(F32_BITS_POS_INF, to = f32)
        }
        if x <= -150.0 {
            return 0.0
        }
    }
    // x = k/N + r: o Shift de exp2f ja vem escalado por N
    let xd: f64 = x as f64
    let shift: f64 = transmute(EXP2F_SHIFT_SCALED, to = f64)
    let kd_soma: f64 = xd + shift
    let ki: u64 = transmute(kd_soma, to = u64)
    let kd: f64 = kd_soma - shift
    let r: f64 = xd - kd
    let t: u64 = wrapping_add(EXP2F_TAB[ki % 32], ki << 47)
    let s: f64 = transmute(t, to = f64)
    let c0: f64 = transmute(EXP2F_P0, to = f64)
    let c1: f64 = transmute(EXP2F_P1, to = f64)
    let c2: f64 = transmute(EXP2F_P2, to = f64)
    let zc: f64 = c0 * r + c1
    let r2: f64 = r * r
    var y: f64 = c2 * r + 1.0
    y = zc * r2 + y
    return (y * s) as f32
}

// logf do musl logf.c: log em f32, tabela de 16 faixas em double e polinomio de grau 3
pub proc math_logf(x: f32) -> f32 {
    var bits: u32 = transmute(x, to = u32)
    if bits == F32_BITS_UM {
        return 0.0
    }
    if wrapping_sub(bits, 0x00800000) >= 0x7f000000 {
        if wrapping_mul(bits, 2) == 0 {
            return transmute(F32_BITS_NEG_INF, to = f32)
        }
        if bits == F32_BITS_POS_INF {
            return x
        }
        if (bits & F32_BITS_SINAL) != 0 or wrapping_mul(bits, 2) >= F32_BITS_EXPOENTE_INVALIDO {
            let nulo: f32 = x - x
            return nulo / nulo
        }
        // subnormal: multiplica por 2^23 e tira 23 << 23 do expoente
        bits = wrapping_sub(transmute(x * 8388608.0, to = u32), 0x0b800000)
    }
    let tmp: u32 = wrapping_sub(bits, LOGF_BITS_OFF)
    let i: u32 = (tmp >> 19) % 16
    let k: i32 = log_expoente_f32(tmp)
    let iz: u32 = wrapping_sub(bits, tmp & F32_BITS_NEG_INF)
    let invc: f64 = transmute(LOGF_TAB[2 * i], to = f64)
    let logc: f64 = transmute(LOGF_TAB[2 * i + 1], to = f64)
    let z: f64 = (transmute(iz, to = f32)) as f64
    let r: f64 = z * invc - 1.0
    let y0: f64 = logc + (k as f64) * transmute(LOGF_LN2, to = f64)
    let r2: f64 = r * r
    var y: f64 = transmute(LOGF_A1, to = f64) * r + transmute(LOGF_A2, to = f64)
    y = transmute(LOGF_A0, to = f64) * r2 + y
    y = y * r2 + (y0 + r)
    return y as f32
}

// log2f do musl log2f.c: mesma reducao de logf, com k somado direto e polinomio de grau 4
pub proc math_log2f(x: f32) -> f32 {
    var bits: u32 = transmute(x, to = u32)
    if bits == F32_BITS_UM {
        return 0.0
    }
    if wrapping_sub(bits, 0x00800000) >= 0x7f000000 {
        if wrapping_mul(bits, 2) == 0 {
            return transmute(F32_BITS_NEG_INF, to = f32)
        }
        if bits == F32_BITS_POS_INF {
            return x
        }
        if (bits & F32_BITS_SINAL) != 0 or wrapping_mul(bits, 2) >= F32_BITS_EXPOENTE_INVALIDO {
            let nulo: f32 = x - x
            return nulo / nulo
        }
        bits = wrapping_sub(transmute(x * 8388608.0, to = u32), 0x0b800000)
    }
    let tmp: u32 = wrapping_sub(bits, LOGF_BITS_OFF)
    let i: u32 = (tmp >> 19) % 16
    let k: i32 = log_expoente_f32(tmp)
    let iz: u32 = wrapping_sub(bits, tmp & F32_BITS_NEG_INF)
    let invc: f64 = transmute(LOG2F_TAB[2 * i], to = f64)
    let logc: f64 = transmute(LOG2F_TAB[2 * i + 1], to = f64)
    let z: f64 = (transmute(iz, to = f32)) as f64
    let r: f64 = z * invc - 1.0
    let y0: f64 = logc + (k as f64)
    let r2: f64 = r * r
    var y: f64 = transmute(LOG2F_A1, to = f64) * r + transmute(LOG2F_A2, to = f64)
    y = transmute(LOG2F_A0, to = f64) * r2 + y
    let p: f64 = transmute(LOG2F_A3, to = f64) * r + y0
    y = y * r2 + p
    return y as f32
}

// log10f do musl log10f.c: reducao por bits, polinomio Lg1..Lg4 em f32 e soma hi/lo (tudo em f32, como o C)
pub proc math_log10f(x: f32) -> f32 {
    var bits: u32 = transmute(x, to = u32)
    var xv: f32 = x
    var k: i32 = 0
    if bits < 0x00800000 or (bits >> 31) == 1 {
        if wrapping_mul(bits, 2) == 0 {
            return transmute(F32_BITS_NEG_INF, to = f32)
        }
        if (bits >> 31) == 1 {
            let nulo: f32 = x - x
            return nulo / nulo
        }
        // subnormal: escala x por 2^25 e compensa k em 25
        k = k - 25
        xv = x * 33554432.0
        bits = transmute(xv, to = u32)
    } else if bits >= F32_BITS_POS_INF {
        return x
    } else if bits == F32_BITS_UM {
        return 0.0
    }
    // reduz para [sqrt(2)/2, sqrt(2)]: soma o ajuste ao ix e recalcula k
    bits = bits + LOG10F_AJUSTE
    k = k + ((bits >> 23) as i32) - 0x7f
    bits = (bits & 0x007fffff) + LOG10F_BASE
    let xr: f32 = transmute(bits, to = f32)
    let f: f32 = xr - 1.0
    let s: f32 = f / (2.0 + f)
    let z: f32 = s * s
    let w: f32 = z * z
    let t1: f32 = w * (transmute(LOG10F_LG2, to = f32) + w * transmute(LOG10F_LG4, to = f32))
    let t2: f32 = z * (transmute(LOG10F_LG1, to = f32) + w * transmute(LOG10F_LG3, to = f32))
    let rr: f32 = t2 + t1
    let hfsq: f32 = 0.5 * f * f
    let hi: f32 = transmute(transmute(f - hfsq, to = u32) & F32_MASCARA_HI, to = f32)
    let lo: f32 = f - hi - hfsq + s * (hfsq + rr)
    let dk: f32 = k as f32
    let ivln10hi: f32 = transmute(LOG10F_IVLN10HI, to = f32)
    let ivln10lo: f32 = transmute(LOG10F_IVLN10LO, to = f32)
    let log10_2hi: f32 = transmute(LOG10F_LOG10_2HI, to = f32)
    let log10_2lo: f32 = transmute(LOG10F_LOG10_2LO, to = f32)
    return dk * log10_2lo + (lo + hi) * ivln10lo + lo * ivln10hi + hi * ivln10hi + dk * log10_2hi
}
