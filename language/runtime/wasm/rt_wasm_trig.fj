}

// ---- utilitarios de bits e de piso (sem embutido de floor/trunc) ----

// Palavra alta do double (GET_HIGH_WORD do musl): o sinal, o expoente e o topo da mantissa
proc trig_palavra_alta(d: f64) -> u32 {
    return (transmute(d, to = u64) >> 32) as u32
}

// Expoente biased do double (u.i >> 52 & 0x7ff do __rem_pio2)
proc trig_expoente(d: f64) -> int {
    return ((transmute(d, to = u64) >> 52) & 0x7ff) as int
}

// Zera a palavra baixa do double (SET_LOW_WORD(d, 0) do __tan)
proc trig_zera_baixa(d: f64) -> f64 {
    return transmute(transmute(d, to = u64) & 0xffffffff00000000, to = f64)
}

// 2^k exato por bits (scalbn(1.0, k) do musl); k entre -1022 e 1023
proc trig_pot2(k: int) -> f64 {
    return transmute(((1023 + k) as u64) << 52, to = f64)
}

// Piso de t >= 0 (< 2^51): somar e subtrair 2^52 arredonda para o inteiro mais perto; se subiu, desce 1
proc trig_piso_pos(t: f64) -> f64 {
    let arredondado: f64 = (t + TRIG_TOINT) - TRIG_TOINT
    if arredondado > t {
        return arredondado - 1.0
    }
    return arredondado
}

// ---- nucleos de sin, cos e tan (kernels do musl sobre [-pi/4, pi/4]) ----

// __sin do musl (k_sin.c); com_y diz se a cauda y de x entra na conta
proc sin_nucleo(x: f64, y: f64, com_y: bool) -> f64 {
    let z: f64 = x * x
    let w: f64 = z * z
    let r: f64 = SIN_S2 + z * (SIN_S3 + z * SIN_S4) + z * w * (SIN_S5 + z * SIN_S6)
    let v: f64 = z * x
    if not com_y {
        return x + v * (SIN_S1 + z * r)
    }
    return x - ((z * (0.5 * y - v * r) - y) - v * SIN_S1)
}

// __cos do musl (k_cos.c); y e a cauda de x
proc cos_nucleo(x: f64, y: f64) -> f64 {
    let z: f64 = x * x
    let w: f64 = z * z
    let r: f64 = z * (COS_C1 + z * (COS_C2 + z * COS_C3)) + w * w * (COS_C4 + z * (COS_C5 + z * COS_C6))
    let hz: f64 = 0.5 * z
    let wc: f64 = 1.0 - hz
    return wc + (((1.0 - wc) - hz) + (z * r - x * y))
}

// Coeficiente T[i] do __tan do musl, lido da tabela de bits
proc tan_t(i: int) -> f64 {
    return transmute(TRIG_TAN_T_BITS[i], to = f64)
}

// __tan do musl (k_tan.c): tan, ou -1/tan se impar; |x| >= 0.6744 reduz por pi/4 - x
proc tan_nucleo(x0: f64, y0: f64, impar: bool) -> f64 {
    var x: f64 = x0
    var y: f64 = y0
    let hx: u32 = trig_palavra_alta(x)
    let grande: bool = (hx & 0x7fffffff) >= 0x3FE59428
    var negativo: bool = false
    if grande {
        negativo = (hx >> 31) == 1
        if negativo {
            x = -x
            y = -y
        }
        x = (TAN_PIO4 - x) + (TAN_PIO4LO - y)
        y = 0.0
    }
    let z: f64 = x * x
    let w: f64 = z * z
    let r1: f64 = tan_t(1) + w * (tan_t(3) + w * (tan_t(5) + w * (tan_t(7) + w * (tan_t(9) + w * tan_t(11)))))
    let v: f64 = z * (tan_t(2) + w * (tan_t(4) + w * (tan_t(6) + w * (tan_t(8) + w * (tan_t(10) + w * tan_t(12))))))
    let s: f64 = z * x
    let r: f64 = y + z * (s * (r1 + v) + y) + s * tan_t(0)
    let soma: f64 = x + r
    if grande {
        var sg: f64 = 1.0
        if impar {
            sg = -1.0
        }
        let v2: f64 = sg - 2.0 * (x + (r - soma * soma / (soma + sg)))
        if negativo {
            return -v2
        }
        return v2
    }
    if not impar {
        return soma
    }
    let w0: f64 = trig_zera_baixa(soma)
    let v3: f64 = r - (w0 - x)
    let a: f64 = -1.0 / soma
    let a0: f64 = trig_zera_baixa(a)
    return a0 + a * (1.0 + a0 * w0 + a0 * v3)
}

// ---- reducao de x por pi/2 em f64 (__rem_pio2 e __rem_pio2_large do musl) ----

// Reducao para |x| em (pi/4, 9pi/4] que nao cai no caso medio: quadrante = +-1..+-4
proc rem_pio2_pequeno(x: f64, ix: u32, negativo: bool) -> (quad: int, cabeca: f64, cauda: f64) {
    var m: int = 4
    if ix <= 0x4002d97c {
        m = 1
    } else if ix <= 0x400f6a7a {
        m = 2
    } else if ix <= 0x4015fdbc {
        m = 3
    }
    let mf: f64 = m as f64
    if negativo {
        let zn: f64 = x + mf * TRIG_PIO2_1
        let cn: f64 = zn + mf * TRIG_PIO2_1T
        return -m, cn, (zn - cn) + mf * TRIG_PIO2_1T
    }
    let z: f64 = x - mf * TRIG_PIO2_1
    let c0: f64 = z - mf * TRIG_PIO2_1T
    return m, c0, (z - c0) - mf * TRIG_PIO2_1T
}

// Ramo medio (|x| < 2^20 pi/2): n = rint(x * 2/pi) e ate tres rodadas de pi/2 para nao perder bits
proc rem_pio2_medio(x: f64, ix: u32) -> (quad: int, cabeca: f64, cauda: f64) {
    var cociente: f64 = x * TRIG_INVPIO2 + TRIG_TOINT - TRIG_TOINT
    var n: int = cociente as int
    var r: f64 = x - cociente * TRIG_PIO2_1
    var w: f64 = cociente * TRIG_PIO2_1T
    if r - w < -TRIG_PIO4 {
        n -= 1
        cociente -= 1.0
        r = x - cociente * TRIG_PIO2_1
        w = cociente * TRIG_PIO2_1T
    } else if r - w > TRIG_PIO4 {
        n += 1
        cociente += 1.0
        r = x - cociente * TRIG_PIO2_1
        w = cociente * TRIG_PIO2_1T
    }
    var cab: f64 = r - w
    let ex: int = (ix >> 20) as int
    var ey: int = trig_expoente(cab)
    if ex - ey > 16 {
        let t: f64 = r
        w = cociente * TRIG_PIO2_2
        r = t - w
        w = cociente * TRIG_PIO2_2T - ((t - r) - w)
        cab = r - w
        ey = trig_expoente(cab)
        if ex - ey > 49 {
            let t2: f64 = r
            w = cociente * TRIG_PIO2_3
            r = t2 - w
            w = cociente * TRIG_PIO2_3T - ((t2 - r) - w)
            cab = r - w
        }
    }
    return n, cab, (r - cab) - w
}

// Verdadeiro se x cai num ponto do ramo medio mesmo estando na faixa pequena (mantissa de pi/2 e 3pi/2, 2pi, 4pi/2 do musl)
proc rem_pio2_meio_exato(ix: u32) -> bool {
    if ix <= 0x400f6a7a and (ix & 0xfffff) == 0x921fb {
        return true
    }
    return ix == 0x4012d97c or ix == 0x401921fb
}

// q[i] de __rem_pio2_large: soma x[j] * ipio2[jv + i - j] (zero fora da tabela), na mesma ordem do musl
proc rem_pio2_produto(x: []f64, jv: int, i: int) -> f64 {
    var soma: f64 = 0.0
    for j in 0..<len(x) {
        let k: int = jv + i - j
        if k >= 0 {
            soma += x[j] * (TRIG_IPIO2[k] as f64)
        }
    }
    return soma
}

// Parte inteira do 2/pi em 24 bits por digito (distill do musl): iq[i] = digito, z = resto
proc rem_pio2_distila(q: [20]f64, jz: int) -> (digitos: [20]u32, fim: f64) {
    var iq: [20]u32 = {}
    var z: f64 = q[jz]
    var i: int = 0
    var j: int = jz
    while j > 0 {
        let fw: f64 = trig_piso_pos(z * TRIG_2_M24)
        iq[i] = trig_piso_pos(z - TRIG_2_24 * fw) as u32
        z = q[j - 1] + fw
        i += 1
        j -= 1
    }
    return iq, z
}

// Passo de n e de ih (quadrante) do musl: z vira fracao em [0, 1), e 1-q se o quadrante passa de 0.5
proc rem_pio2_inteiro(iq0: [20]u32, jz: int, q0: int, z0: f64) -> (digitos: [20]u32, inteiro_n: int, quadrante_ih: int, zfrac: f64) {
    var iq: [20]u32 = iq0
    var z: f64 = z0 * trig_pot2(q0)
    z -= 8.0 * trig_piso_pos(z * 0.125)
    var n: int = trig_piso_pos(z) as int
    z = z - (n as f64)
    var ih: int = 0
    if q0 > 0 {
        let deslocamento: u32 = (24 - q0) as u32
        let pedaco: u32 = iq[jz - 1] >> deslocamento
        n += (pedaco as int)
        iq[jz - 1] = iq[jz - 1] - (pedaco << deslocamento)
        ih = (iq[jz - 1] >> ((23 - q0) as u32)) as int
    } else if q0 == 0 {
        ih = (iq[jz - 1] >> 23) as int
    } else if z >= 0.5 {
        ih = 2
    }
    if ih > 0 {
        n += 1
        var carry: bool = false
        for i in 0..<jz {
            let digito: u32 = iq[i]
            if carry {
                iq[i] = 0xffffff - digito
            } else if digito != 0 {
                carry = true
                iq[i] = 0x1000000 - digito
            }
        }
        if q0 == 1 {
            iq[jz - 1] = iq[jz - 1] & 0x7fffff
        } else if q0 == 2 {
            iq[jz - 1] = iq[jz - 1] & 0x3fffff
        }
        if ih == 2 {
            z = 1.0 - z
            if carry {
                z = z - trig_pot2(q0)
            }
        }
    }
    return iq, n, ih, z
}

// Verdadeiro se iq[jk..jz-1] e todo zero: falta precisao e o musl recalcula com mais termos de ipio2
proc rem_pio2_zerado(iq: [20]u32, jk: int, jz: int) -> bool {
    for i in jk..<jz {
        if iq[i] != 0 {
            return false
        }
    }
    return true
}

// Corta os zeros do fim e reescreve z como os ultimos digitos de 24 bits (fim de __rem_pio2_large)
proc rem_pio2_corta(iq0: [20]u32, jz0: int, q00: int, z: f64) -> (digitos: [20]u32, jz_out: int, q0_out: int) {
    var iq: [20]u32 = iq0
    var jz: int = jz0
    var q0: int = q00
    if z == 0.0 {
        jz -= 1
        q0 -= 24
        while iq[jz] == 0 {
            jz -= 1
            q0 -= 24
        }
        return iq, jz, q0
    }
    let zr: f64 = z * trig_pot2(-q0)
    if zr >= TRIG_2_24 {
        let fw: f64 = trig_piso_pos(zr * TRIG_2_M24)
        iq[jz] = trig_piso_pos(zr - TRIG_2_24 * fw) as u32
        jz += 1
        q0 += 24
        iq[jz] = fw as u32
    } else {
        iq[jz] = trig_piso_pos(zr) as u32
    }
    return iq, jz, q0
}

// q em f64 (os digitos escalados por 2^q0) e fq = PIo2 x q, somas parciais do musl
proc rem_pio2_produtos(iq: [20]u32, jz: int, q0: int, jk: int) -> [20]f64 {
    var q: [20]f64 = {}
    var fw: f64 = trig_pot2(q0)
    var i: int = jz
    while i >= 0 {
        q[i] = fw * (iq[i] as f64)
        fw = fw * TRIG_2_M24
        i -= 1
    }
    var fq: [20]f64 = {}
    i = jz
    while i >= 0 {
        var soma: f64 = 0.0
        var k: int = 0
        while k <= jk and k <= jz - i {
            soma += trig_pio2(k) * q[i + k]
            k += 1
        }
        fq[jz - i] = soma
        i -= 1
    }
    return fq
}

// PIo2[k] de __rem_pio2_large, lido da tabela de bits
proc trig_pio2(k: int) -> f64 {
    return transmute(TRIG_PIO2_BITS[k], to = f64)
}

// Soma os fq em duas partes (cabeca e cauda) com o sinal do quadrante; prec 0 (f32) so usa a cabeca
proc rem_pio2_compoe(fq: [20]f64, jz: int, ih: int, prec: int) -> (cabeca: f64, cauda: f64) {
    var fw: f64 = 0.0
    var i: int = jz
    while i >= 0 {
        fw += fq[i]
        i -= 1
    }
    var a: f64 = fw
    if ih != 0 {
        a = -fw
    }
    if prec == 0 {
        return a, 0.0
    }
    fw = fq[0] - fw
    i = 1
    while i <= jz {
        fw += fq[i]
        i += 1
    }
    var b: f64 = fw
    if ih != 0 {
        b = -fw
    }
    return a, b
}

// __rem_pio2_large do musl: x - N*pi/2 com x em parcelas de 24 bits; prec 0 = f32 (jk 3), prec 1 = f64 (jk 4)
proc rem_pio2_largo(x: []f64, e0: int, prec: int) -> (quad: int, cabeca: f64, cauda: f64) {
    var jk: int = 4
    if prec == 0 {
        jk = 3
    }
    var jv: int = 0
    if e0 >= 3 {
        jv = (e0 - 3) / 24
    }
    let q0: int = e0 - 24 * (jv + 1)
    var q: [20]f64 = {}
    for i in 0..<jk + 1 {
        q[i] = rem_pio2_produto(x, jv, i)
    }
    var jz: int = jk
    while true {
        let iqd, zd = rem_pio2_distila(q, jz)
        let iqi, parte, ih, fracao = rem_pio2_inteiro(iqd, jz, q0, zd)
        if fracao == 0.0 and rem_pio2_zerado(iqi, jk, jz) {
            var k: int = 1
            while iqi[jk - k] == 0 {
                k += 1
            }
            let alvo: int = jz + k
            for i in jz + 1..=alvo {
                q[i] = rem_pio2_produto(x, jv, i)
            }
            jz = alvo
            continue
        }
        let iqc, jzc, q0c = rem_pio2_corta(iqi, jz, q0, fracao)
        let fq = rem_pio2_produtos(iqc, jzc, q0c, jk)
        let ca, cb = rem_pio2_compoe(fq, jzc, ih, prec)
        return parte % 8, ca, cb
    }
    return 0, 0.0, 0.0
}

// Parte grande (|x| >= 2^20 pi/2): mantissa de |x| em tres parcelas de 24 bits e o musl grande
proc rem_pio2_grande_f64(x: f64, ix: u32, negativo: bool) -> (quad: int, cabeca: f64, cauda: f64) {
    let u: u64 = transmute(x, to = u64)
    let z0: f64 = transmute((u & 0x000fffffffffffff) | 0x4160000000000000, to = f64)
    var tx: [3]f64 = {}
    var z: f64 = z0
    for i in 0..<2 {
        tx[i] = trig_piso_pos(z)
        z = (z - tx[i]) * TRIG_2_24
    }
    tx[2] = z
    var nx: int = 3
    while tx[nx - 1] == 0.0 {
        nx -= 1
    }
    let e0: int = ((ix >> 20) as int) - 1046
    let qa, ca, cb = rem_pio2_largo(tx[0..<nx], e0, 1)
    if negativo {
        return -qa, -ca, -cb
    }
    return qa, ca, cb
}

// Reducao de x por pi/2 (__rem_pio2 do musl): quadrante, cabeca e cauda; |x| <= pi/4 nao chega aqui
proc rem_pio2(x: f64) -> (quad: int, cabeca: f64, cauda: f64) {
    let u: u64 = transmute(x, to = u64)
    let ix: u32 = ((u >> 32) as u32) & 0x7fffffff
    let negativo: bool = ((u >> 63) == 1)
    if ix <= 0x401c463b and not rem_pio2_meio_exato(ix) {
        return rem_pio2_pequeno(x, ix, negativo)
    }
    if ix < 0x413921fb {
        return rem_pio2_medio(x, ix)
    }
    if ix >= 0x7ff00000 {
        return 0, x - x, x - x
    }
    return rem_pio2_grande_f64(x, ix, negativo)
}

// ---- reducao de x por pi/2 em f32 (__rem_pio2f do musl, em double por dentro) ----

// Reducao de x float por pi/2: quadrante e resto em double
proc rem_pio2f(x: f32) -> (quad: int, cabeca: f64) {
    let ix: u32 = transmute(x, to = u32) & 0x7fffffff
    let sinal: bool = (transmute(x, to = u32) >> 31) == 1
    let xd: f64 = x as f64
    if ix >= 0x7f800000 {
        return 0, (x - x) as f64
    }
    if ix < 0x4dc90fdb {
        var cociente: f64 = xd * TRIG_INVPIO2 + TRIG_TOINT - TRIG_TOINT
        var n: int = cociente as int
        var y: f64 = xd - cociente * TRIG_PIO2F_1 - cociente * TRIG_PIO2F_1T
        if y < -TRIG_PIO4F {
            n -= 1
            cociente -= 1.0
            y = xd - cociente * TRIG_PIO2F_1 - cociente * TRIG_PIO2F_1T
        } else if y > TRIG_PIO4F {
            n += 1
            cociente += 1.0
            y = xd - cociente * TRIG_PIO2F_1 - cociente * TRIG_PIO2F_1T
        }
        return n, y
    }
    let e0: int = ((ix >> 23) as int) - 150
    let escala: f32 = transmute(ix - ((e0 as u32) << 23), to = f32)
    var tx: [1]f64 = {}
    tx[0] = escala as f64
    let qa, ca, _ = rem_pio2_largo(tx[0..<1], e0, 0)
    if sinal {
        return -qa, -ca
    }
    return qa, ca
}

// ---- nucleos f32: __sindf, __cosdf e __tandf do musl (entrada e calculo em double) ----

// __sindf do musl (k_sinf.c): sin em [-pi/4, pi/4], devolvido em float
proc sin_df(x: f64) -> f32 {
    let z: f64 = x * x
    let w: f64 = z * z
    let r: f64 = SINDF_S3 + z * SINDF_S4
    let s: f64 = z * x
    return ((x + s * (SINDF_S1 + z * SINDF_S2)) + s * w * r) as f32
}

// __cosdf do musl (k_cosf.c): cos em [-pi/4, pi/4], devolvido em float
proc cos_df(x: f64) -> f32 {
    let z: f64 = x * x
    let w: f64 = z * z
    let r: f64 = COSDF_C2 + z * COSDF_C3
    return (((1.0 + z * COSDF_C0) + w * COSDF_C1) + (w * z) * r) as f32
}

// Coeficiente T[i] do __tandf do musl, lido da tabela de bits
proc tandf_t(i: int) -> f64 {
    return transmute(TRIG_TANDF_T_BITS[i], to = f64)
}

// __tandf do musl (k_tanf.c): tan, ou -1/tan se impar, devolvido em float
proc tan_df(x: f64, impar: bool) -> f32 {
    let z: f64 = x * x
    let r: f64 = tandf_t(4) + z * tandf_t(5)
    let t: f64 = tandf_t(2) + z * tandf_t(3)
    let w: f64 = z * z
    let s: f64 = z * x
    let u: f64 = tandf_t(0) + z * tandf_t(1)
    let soma: f64 = (x + s * u) + (s * w) * (t + w * r)
    if impar {
        return (-1.0 / soma) as f32
    }
    return soma as f32
}

// ---- funcoes publicas: sin, cos e tan em f64 (s_sin.c, s_cos.c, s_tan.c do musl) ----

// sin do musl: |x| <= pi/4 vai direto ao nucleo, o resto passa pela reducao por pi/2
pub proc math_sin(x: f64) -> f64 {
    let ix: u32 = trig_palavra_alta(x) & 0x7fffffff
    if ix <= 0x3fe921fb {
        if ix < 0x3e500000 {
            return x
        }
        return sin_nucleo(x, 0.0, false)
    }
    if ix >= 0x7ff00000 {
        return x - x
    }
    let quad, cabeca, cauda = rem_pio2(x)
    let setor: u64 = transmute(quad, to = u64) & 3
    if setor == 0 {
        return sin_nucleo(cabeca, cauda, true)
    }
    if setor == 1 {
        return cos_nucleo(cabeca, cauda)
    }
    if setor == 2 {
        return -sin_nucleo(cabeca, cauda, true)
    }
    return -cos_nucleo(cabeca, cauda)
}

// cos do musl: |x| <= pi/4 vai direto ao nucleo (1.0 para x minusculo), o resto passa pela reducao
pub proc math_cos(x: f64) -> f64 {
    let ix: u32 = trig_palavra_alta(x) & 0x7fffffff
    if ix <= 0x3fe921fb {
        if ix < 0x3e46a09e {
            return 1.0
        }
        return cos_nucleo(x, 0.0)
    }
    if ix >= 0x7ff00000 {
        return x - x
    }
    let quad, cabeca, cauda = rem_pio2(x)
    let setor: u64 = transmute(quad, to = u64) & 3
    if setor == 0 {
        return cos_nucleo(cabeca, cauda)
    }
    if setor == 1 {
        return -sin_nucleo(cabeca, cauda, true)
    }
    if setor == 2 {
        return -cos_nucleo(cabeca, cauda)
    }
    return sin_nucleo(cabeca, cauda, true)
}

// tan do musl: |x| <= pi/4 vai direto ao nucleo, o resto passa pela reducao (impar = quadrante impar)
pub proc math_tan(x: f64) -> f64 {
    let ix: u32 = trig_palavra_alta(x) & 0x7fffffff
    if ix <= 0x3fe921fb {
        if ix < 0x3e400000 {
            return x
        }
        return tan_nucleo(x, 0.0, false)
    }
    if ix >= 0x7ff00000 {
        return x - x
    }
    let quad, cabeca, cauda = rem_pio2(x)
    return tan_nucleo(cabeca, cauda, (transmute(quad, to = u64) & 1) == 1)
}

// ---- funcoes publicas f32: sinf, cosf e tanf do musl (s_sinf.c, s_cosf.c, s_tanf.c) ----

// sinf do musl: faixas de pi/4 com constantes de 1..4 pi/2 e, fora delas, a reducao rem_pio2f
pub proc math_sinf(x: f32) -> f32 {
    let ix: u32 = transmute(x, to = u32)
    let negativo: bool = (ix >> 31) == 1
    let absix: u32 = ix & 0x7fffffff
    let xd: f64 = x as f64
    if absix <= 0x3f490fda {
        if absix < 0x39800000 {
            return x
        }
        return sin_df(xd)
    }
    if absix <= 0x407b53d1 {
        if absix <= 0x4016cbe3 {
            if negativo {
                return -cos_df(xd + TRIG_MPIO2_1)
            }
            return cos_df(xd - TRIG_MPIO2_1)
        }
        if negativo {
            return sin_df(-(xd + TRIG_MPIO2_2))
        }
        return sin_df(-(xd - TRIG_MPIO2_2))
    }
    if absix <= 0x40e231d5 {
        if absix <= 0x40afeddf {
            if negativo {
                return cos_df(xd + TRIG_MPIO2_3)
            }
            return -cos_df(xd - TRIG_MPIO2_3)
        }
        if negativo {
            return sin_df(xd + TRIG_MPIO2_4)
        }
        return sin_df(xd - TRIG_MPIO2_4)
    }
    if absix >= 0x7f800000 {
        return x - x
    }
    let quad, cabeca = rem_pio2f(x)
    let setor: u64 = transmute(quad, to = u64) & 3
    if setor == 0 {
        return sin_df(cabeca)
    }
    if setor == 1 {
        return cos_df(cabeca)
    }
    if setor == 2 {
        return sin_df(-cabeca)
    }
    return -cos_df(cabeca)
}

// cosf do musl: faixas de pi/4 com constantes de 1..4 pi/2 e, fora delas, a reducao rem_pio2f
pub proc math_cosf(x: f32) -> f32 {
    let ix: u32 = transmute(x, to = u32)
    let negativo: bool = (ix >> 31) == 1
    let absix: u32 = ix & 0x7fffffff
    let xd: f64 = x as f64
    if absix <= 0x3f490fda {
        if absix < 0x39800000 {
            return 1.0
        }
        return cos_df(xd)
    }
    if absix <= 0x407b53d1 {
        if absix > 0x4016cbe3 {
            if negativo {
                return -cos_df(xd + TRIG_MPIO2_2)
            }
            return -cos_df(xd - TRIG_MPIO2_2)
        }
        if negativo {
            return sin_df(xd + TRIG_MPIO2_1)
        }
        return sin_df(TRIG_MPIO2_1 - xd)
    }
    if absix <= 0x40e231d5 {
        if absix > 0x40afeddf {
            if negativo {
                return cos_df(xd + TRIG_MPIO2_4)
            }
            return cos_df(xd - TRIG_MPIO2_4)
        }
        if negativo {
            return sin_df(-(xd) - TRIG_MPIO2_3)
        }
        return sin_df(xd - TRIG_MPIO2_3)
    }
    if absix >= 0x7f800000 {
        return x - x
    }
    let quad, cabeca = rem_pio2f(x)
    let setor: u64 = transmute(quad, to = u64) & 3
    if setor == 0 {
        return cos_df(cabeca)
    }
    if setor == 1 {
        return sin_df(-cabeca)
    }
    if setor == 2 {
        return -cos_df(cabeca)
    }
    return sin_df(cabeca)
}

// tanf do musl: faixas de pi/4 com constantes de 1..4 pi/2 e, fora delas, a reducao rem_pio2f
pub proc math_tanf(x: f32) -> f32 {
    let ix: u32 = transmute(x, to = u32)
    let negativo: bool = (ix >> 31) == 1
    let absix: u32 = ix & 0x7fffffff
    let xd: f64 = x as f64
    if absix <= 0x3f490fda {
        if absix < 0x39800000 {
            return x
        }
        return tan_df(xd, false)
    }
    if absix <= 0x407b53d1 {
        if absix <= 0x4016cbe3 {
            if negativo {
                return tan_df(xd + TRIG_MPIO2_1, true)
            }
            return tan_df(xd - TRIG_MPIO2_1, true)
        }
        if negativo {
            return tan_df(xd + TRIG_MPIO2_2, false)
        }
        return tan_df(xd - TRIG_MPIO2_2, false)
    }
    if absix <= 0x40e231d5 {
        if absix <= 0x40afeddf {
            if negativo {
                return tan_df(xd + TRIG_MPIO2_3, true)
            }
            return tan_df(xd - TRIG_MPIO2_3, true)
        }
        if negativo {
            return tan_df(xd + TRIG_MPIO2_4, false)
        }
        return tan_df(xd - TRIG_MPIO2_4, false)
    }
    if absix >= 0x7f800000 {
        return x - x
    }
    let quad, cabeca = rem_pio2f(x)
    return tan_df(cabeca, (transmute(quad, to = u64) & 1) == 1)
}
