// runtime/wasm/rt_wasm_real.fj - texto de f32/f64 do alvo wasm32-wasip1 (print, f"{x}", f"{x:.N}"), porte para Forja pura do runtime nativo
// Versao: 0.1.0 (Ryu d2s/f2s: digitos mais curtos que voltam ao mesmo valor, posicionais; musl fmt_fp: {x:.N} exato para N 0..30)
// LIMITE: arquivo 968 linhas (alvo 800; porte fiel de Ryu d2s/f2s e musl fmt_fp, dividir duplicaria a ligacao do modulo)
// Contrato: fmt_f64_curto, fmt_f32_curto, fmt_f64 e fmt_f32 (v: f64, fmt: u32) acrescentam o texto ao buffer de formatacao
//   via wasm_rt.fmt_bytes (largura, alinhamento e zeros vem de fmt). f32 chega alargado a f64 (como no x64): fmt_f32_curto
//   arredonda para f32 antes do Ryu. curto_texto_f64 e curto_texto_f32 (v: f64, saida: []u8) -> int devolvem o tamanho.
// Fonte C (D4, mesma fonte = bits iguais): third/ryu/d2s.c, f2s.c; runtime/nativo/rt_real_curto.c, rt_fmt_fixo.c, rt_formata.c.
// Escolha de tabela: d2s com a tabela pequena (RYU_OPTIMIZE_SIZE, mesma do x64); f2s com a tabela cheia (RYU_FLOAT_FULL_TABLE).
//   O Ryu e exato: as duas tabelas dao os mesmos digitos (a prova e o teste contra o x64).
// Verificacao: python language/tests/nativo/wasm/real_x64/gerar_e_rodar.py (copia do modulo no x64 + compara com print/format do x64).
// Regra do modulo: sem alocacao; buffers locais [N]u8 e enderecos pelo forja_rt_endereco_de (o bloco PLATAFORMA e o unico trecho de wasm).

// PLATAFORMA-INICIO
import "std:wasm_rt"

// Entrega n bytes de p ao buffer de formatacao do wasm (largura e zeros de fmt: fmt_alinhado de rt_wasm.fj)
proc emite_texto(p: ^u8, n: int, fmt: u32) {
    wasm_rt.fmt_bytes(wasm_rt.endereco_de(p as rawptr), n as uint, fmt)
}
// PLATAFORMA-FIM

