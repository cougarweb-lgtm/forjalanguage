// ---- estruturas ----
struct Dupla128 {
    baixo: u64 = 0
    alto: u64 = 0
}

struct Produto192 {
    baixo: u64 = 0
    meio: u64 = 0
    alto: u64 = 0
}

struct RyuDecimal {
    mantissa: u64 = 0
    expoente: int = 0
}

struct RyuEntrada {
    m2: u64 = 0
    e2: int = 0
    mm_shift: u64 = 0
    aceita: bool = false
}

// vr/vp/vm: a escala; e10: expoente do 1o digito antes de remover; removidos/ultimo/saida: a remocao de digitos
struct RyuEstado {
    vr: u64 = 0
    vp: u64 = 0
    vm: u64 = 0
    e10: int = 0
    removidos: int = 0
    ultimo: u64 = 0
    vr_zeros: bool = false
    vm_zeros: bool = false
    saida: u64 = 0
}

// Digitos de um RyuDecimal sem zeros finais; total = digitos da mantissa com zeros; e10 = expoente do 1o digito
struct RyuTexto {
    mantissa: u64 = 0
    total: int = 0
    nd: int = 0
    e10: int = 0
}

struct FixoNormal {
    y: f64 = 0.0
    e2: int = 0
}

struct FixoEstado {
    a: int = 0
    r: int = 0
    z: int = 0
    e2: int = 0
    precisao: int = 0
}

// ---- util de bits do Ryu (common.h) ----
// ceil(log2(5^e)) pela aproximacao do Ryu; e >= 0
proc ryu_pow5_bits(e: int) -> int {
    let escalado: u64 = (e as u64) * 1217359
    return ((escalado >> 19) + 1) as int
}

// floor(log10(2^e)) e floor(log10(5^e)) pela aproximacao do Ryu
proc ryu_log10_pow2(e: int) -> int {
    return (((e as u64) * 78913) >> 18) as int
}

proc ryu_log10_pow5(e: int) -> int {
    return (((e as u64) * 732923) >> 20) as int
}

// (hi:lo) >> dist, parte baixa de 64 bits; dist 0 da lo (deslocar 64 da 0 no Forja, como o shiftright128 usado)
proc ryu_deslocar_128(lo: u64, hi: u64, dist: int) -> u64 {
    return (hi << ((64 - dist) as u64)) | (lo >> (dist as u64))
}

// m * (mul1 * 2^64 + mul0) em 192 bits: baixo = parte baixa de m*mul0; meio = soma com o vai-um; alto = parte alta
proc ryu_produto_192(m: u64, mul0: u64, mul1: u64) -> Produto192 {
    let alto0: u64 = mul_hi_u64(m, mul0)
    var alto1: u64 = mul_hi_u64(m, mul1)
    let meio: u64 = wrapping_add(alto0, wrapping_mul(m, mul1))
    if meio < alto0 {
        alto1 = wrapping_add(alto1, 1)
    }
    return Produto192{baixo = wrapping_mul(m, mul0), meio = meio, alto = alto1}
}

// (m * mul) >> j, parte baixa de 64 bits (mulShift64 do Ryu)
proc ryu_mulshift64(m: u64, mul: Dupla128, j: int) -> u64 {
    let p = ryu_produto_192(m, mul.baixo, mul.alto)
    return ryu_deslocar_128(p.meio, p.alto, j - 64)
}

// vp, vm e vr de uma vez (mulShiftAll64 do Ryu) para a entrada en
proc ryu_tres_mulshift(en: RyuEntrada, mul: Dupla128, j: int) -> RyuEstado {
    let m: u64 = en.m2
    return RyuEstado{
        vr = ryu_mulshift64(4 * m, mul, j),
        vp = ryu_mulshift64(4 * m + 2, mul, j),
        vm = ryu_mulshift64(4 * m - 1 - en.mm_shift, mul, j),
    }
}

// Pedaco de 2 bits da tabela de offsets do Ryu para o expoente i
proc ryu_bits_ajuste(valor: u32, i: int) -> u64 {
    let deslocamento: u64 = ((i % 16) * 2) as u64
    return (((valor as u64) >> deslocamento) & 3)
}

// 5^i no formato do Ryu (computePow5 com a tabela pequena): base * 26 + offset
proc ryu_pow5_direto(i: int) -> Dupla128 {
    let base: int = i / RYU_TAM_TABELA
    let base2: int = base * RYU_TAM_TABELA
    let offset: int = i - base2
    let mul0: u64 = RYU_POW5_SPLIT2[2 * base]
    let mul1: u64 = RYU_POW5_SPLIT2[2 * base + 1]
    if offset == 0 {
        return Dupla128{baixo = mul0, alto = mul1}
    }
    let p = ryu_produto_192(RYU_POW5_TABELA[offset], mul0, mul1)
    let delta: int = ryu_pow5_bits(i) - ryu_pow5_bits(base2)
    let ajuste: u64 = ryu_bits_ajuste(RYU_POW5_OFFSETS[i / 16], i)
    return Dupla128{
        baixo = wrapping_add(ryu_deslocar_128(p.baixo, p.meio, delta), ajuste),
        alto = ryu_deslocar_128(p.meio, p.alto, delta),
    }
}

// 5^-i no formato do Ryu (computeInvPow5 com a tabela pequena)
proc ryu_pow5_inverso(i: int) -> Dupla128 {
    let base: int = (i + RYU_TAM_TABELA - 1) / RYU_TAM_TABELA
    let base2: int = base * RYU_TAM_TABELA
    let offset: int = base2 - i
    let mul0: u64 = RYU_POW5_INV_SPLIT2[2 * base]
    let mul1: u64 = RYU_POW5_INV_SPLIT2[2 * base + 1]
    if offset == 0 {
        return Dupla128{baixo = mul0, alto = mul1}
    }
    let p = ryu_produto_192(RYU_POW5_TABELA[offset], mul0 - 1, mul1)
    let delta: int = ryu_pow5_bits(base2) - ryu_pow5_bits(i)
    let ajuste: u64 = 1 + ryu_bits_ajuste(RYU_POW5_INV_OFFSETS[i / 16], i)
    return Dupla128{
        baixo = wrapping_add(ryu_deslocar_128(p.baixo, p.meio, delta), ajuste),
        alto = ryu_deslocar_128(p.meio, p.alto, delta),
    }
}

// valor e multiplo de 5^p? (pow5Factor >= p, parando em p)
proc ryu_multiplo_5(valor: u64, p: int) -> bool {
    var v: u64 = valor
    var fatores: int = 0
    while fatores < p and v % 5 == 0 {
        v = v / 5
        fatores += 1
    }
    return fatores >= p
}

// valor e multiplo de 2^p
proc ryu_multiplo_2(valor: u64, p: int) -> bool {
    let mascara: u64 = ((1 as u64) << (p as u64)) - 1
    return (valor & mascara) == 0
}

// mulShift32 do f2s.c: (m * fator) >> j com fator de 64 bits, parte baixa
proc ryu_mulshift32(m: u64, fator: u64, j: int) -> u64 {
    let fator_baixo: u64 = fator & 4294967295
    let fator_alto: u64 = fator >> 32
    let bits0: u64 = m * fator_baixo
    let bits1: u64 = m * fator_alto
    let soma: u64 = (bits0 >> 32) + bits1
    return soma >> ((j - 32) as u64)
}

proc ryu_mulpow5_inv_div2(m: u64, q: int, j: int) -> u64 {
    return ryu_mulshift32(m, RYU_FLT_POW5_INV[q], j)
}

proc ryu_mulpow5_div2(m: u64, i: int, j: int) -> u64 {
    return ryu_mulshift32(m, RYU_FLT_POW5[i], j)
}

// ---- escala do d2s e do f2s (passo 3 do Ryu) ----
// q <= 21 do d2s.c: so um entre mp, mv e mm pode ser multiplo de 5
proc ryu_zeros_5(est: ^RyuEstado, mv: u64, q: int, en: RyuEntrada) {
    if mv % 5 == 0 {
        est.vr_zeros = ryu_multiplo_5(mv, q)
    } else if en.aceita {
        est.vm_zeros = ryu_multiplo_5(mv - 1 - en.mm_shift, q)
    } else if ryu_multiplo_5(mv + 2, q) {
        est.vp -= 1
    }
}

proc ryu_escala_d2s_pos(en: RyuEntrada) -> RyuEstado {
    var q: int = ryu_log10_pow2(en.e2)
    if en.e2 > 3 {
        q -= 1
    }
    let k: int = RYU_BITS_POW5_INV_D + ryu_pow5_bits(q) - 1
    let i: int = -en.e2 + q + k
    var est: RyuEstado = ryu_tres_mulshift(en, ryu_pow5_inverso(q), i)
    est.e10 = q
    if q <= 21 {
        ryu_zeros_5(&est, 4 * en.m2, q, en)
    }
    return est
}

proc ryu_escala_d2s_neg(en: RyuEntrada) -> RyuEstado {
    var q: int = ryu_log10_pow5(-en.e2)
    if -en.e2 > 1 {
        q -= 1
    }
    let i: int = -en.e2 - q
    let k: int = ryu_pow5_bits(i) - RYU_BITS_POW5_D
    let j: int = q - k
    var est: RyuEstado = ryu_tres_mulshift(en, ryu_pow5_direto(i), j)
    est.e10 = q + en.e2
    if q <= 1 {
        est.vr_zeros = true
        if en.aceita {
            est.vm_zeros = en.mm_shift == 1
        } else {
            est.vp -= 1
        }
    } else if q < 63 {
        est.vr_zeros = ryu_multiplo_2(4 * en.m2, q)
    }
    return est
}

proc ryu_escala_f2s_pos(en: RyuEntrada) -> RyuEstado {
    let q: int = ryu_log10_pow2(en.e2)
    let k: int = RYU_BITS_POW5_INV_F + ryu_pow5_bits(q) - 1
    let i: int = -en.e2 + q + k
    let mv: u64 = 4 * en.m2
    var est = RyuEstado{
        vr = ryu_mulpow5_inv_div2(mv, q, i),
        vp = ryu_mulpow5_inv_div2(mv + 2, q, i),
        vm = ryu_mulpow5_inv_div2(mv - 1 - en.mm_shift, q, i),
        e10 = q,
    }
    if q != 0 and ((est.vp - 1) / 10) <= (est.vm / 10) {
        let l: int = RYU_BITS_POW5_INV_F + ryu_pow5_bits(q - 1) - 1
        est.ultimo = ryu_mulpow5_inv_div2(mv, q - 1, -en.e2 + q - 1 + l) % 10
    }
    if q <= 9 {
        ryu_zeros_5(&est, mv, q, en)
    }
    return est
}

proc ryu_escala_f2s_neg(en: RyuEntrada) -> RyuEstado {
    let q: int = ryu_log10_pow5(-en.e2)
    let i: int = -en.e2 - q
    let k: int = ryu_pow5_bits(i) - RYU_BITS_POW5_F
    let j: int = q - k
    let mv: u64 = 4 * en.m2
    var est = RyuEstado{
        vr = ryu_mulpow5_div2(mv, i, j),
        vp = ryu_mulpow5_div2(mv + 2, i, j),
        vm = ryu_mulpow5_div2(mv - 1 - en.mm_shift, i, j),
        e10 = q + en.e2,
    }
    if q != 0 and ((est.vp - 1) / 10) <= (est.vm / 10) {
        let j_digito: int = q - 1 - (ryu_pow5_bits(i + 1) - RYU_BITS_POW5_F)
        est.ultimo = ryu_mulpow5_div2(mv, i + 1, j_digito) % 10
    }
    if q <= 1 {
        est.vr_zeros = true
        if en.aceita {
            est.vm_zeros = en.mm_shift == 1
        } else {
            est.vp -= 1
        }
    } else if q < 31 {
        est.vr_zeros = ryu_multiplo_2(mv, q - 1)
    }
    return est
}

// ---- remocao de digitos (passo 4): a mesma logica para d2s e f2s ----
proc ryu_mais_um_se(valor: u64, cond: bool) -> u64 {
    if cond {
        return valor + 1
    }
    return valor
}

// Enquanto o intervalo tem mais de um digito: tira um digito de vr, vp e vm
proc ryu_passo_geral(est: ^RyuEstado) {
    while (est.vp / 10) > (est.vm / 10) {
        est.vm_zeros = est.vm_zeros and (est.vm % 10 == 0)
        est.vr_zeros = est.vr_zeros and (est.ultimo == 0)
        est.ultimo = est.vr % 10
        est.vr = est.vr / 10
        est.vp = est.vp / 10
        est.vm = est.vm / 10
        est.removidos += 1
    }
}

// vm ainda termina em zero: tira os zeros dele (so no caminho com zeros finais)
proc ryu_passo_so_vm(est: ^RyuEstado) {
    while est.vm % 10 == 0 {
        est.vr_zeros = est.vr_zeros and (est.ultimo == 0)
        est.ultimo = est.vr % 10
        est.vr = est.vr / 10
        est.vp = est.vp / 10
        est.vm = est.vm / 10
        est.removidos += 1
    }
}

// Caminho comum (sem zeros finais): tira digitos enquanto o intervalo tem mais de um; ultimo guarda o digito tirado por ultimo
proc ryu_passo_simples(est: ^RyuEstado) {
    while (est.vp / 10) > (est.vm / 10) {
        est.ultimo = est.vr % 10
        est.vr = est.vr / 10
        est.vp = est.vp / 10
        est.vm = est.vm / 10
        est.removidos += 1
    }
}

proc ryu_remover_com_zeros(est: ^RyuEstado, aceita: bool) {
    ryu_passo_geral(est)
    if est.vm_zeros {
        ryu_passo_so_vm(est)
    }
    if est.vr_zeros and est.ultimo == 5 and est.vr % 2 == 0 {
        est.ultimo = 4
    }
    let empate: bool = (est.vr == est.vm) and ((not aceita) or (not est.vm_zeros))
    est.saida = ryu_mais_um_se(est.vr, empate or (est.ultimo >= 5))
}

proc ryu_remover(est: ^RyuEstado, aceita: bool) {
    if est.vm_zeros or est.vr_zeros {
        ryu_remover_com_zeros(est, aceita)
        return
    }
    ryu_passo_simples(est)
    est.saida = ryu_mais_um_se(est.vr, (est.vr == est.vm) or (est.ultimo >= 5))
}

// ---- d2d e f2d: bits IEEE -> mantissa e expoente decimal mais curtos ----
proc ryu_escala_d2s(en: RyuEntrada) -> RyuEstado {
    if en.e2 >= 0 {
        return ryu_escala_d2s_pos(en)
    }
    return ryu_escala_d2s_neg(en)
}

proc ryu_escala_f2s(en: RyuEntrada) -> RyuEstado {
    if en.e2 >= 0 {
        return ryu_escala_f2s_pos(en)
    }
    return ryu_escala_f2s_neg(en)
}

// double com expoente IEEE (11 bits) e mantissa (52 bits) -> digitos mais curtos (d2d do d2s.c)
proc ryu_d2d(mantissa: u64, expoente_ieee: u64) -> RyuDecimal {
    var e2: int = 1 - RYU_D_BIAS - RYU_D_MANT - 2
    var m2: u64 = mantissa
    if expoente_ieee != 0 {
        e2 = (expoente_ieee as int) - RYU_D_BIAS - RYU_D_MANT - 2
        m2 = ((1 as u64) << 52) | mantissa
    }
    var mm_shift: u64 = 0
    if mantissa != 0 or expoente_ieee <= 1 {
        mm_shift = 1
    }
    let en = RyuEntrada{m2 = m2, e2 = e2, mm_shift = mm_shift, aceita = (m2 % 2) == 0}
    var est: RyuEstado = ryu_escala_d2s(en)
    ryu_remover(&est, en.aceita)
    return RyuDecimal{mantissa = est.saida, expoente = est.e10 + est.removidos}
}

// float com expoente IEEE (8 bits) e mantissa (23 bits) -> digitos mais curtos (f2d do f2s.c)
proc ryu_f2d(mantissa: u64, expoente_ieee: u64) -> RyuDecimal {
    var e2: int = 1 - RYU_F_BIAS - RYU_F_MANT - 2
    var m2: u64 = mantissa
    if expoente_ieee != 0 {
        e2 = (expoente_ieee as int) - RYU_F_BIAS - RYU_F_MANT - 2
        m2 = ((1 as u64) << 23) | mantissa
    }
    var mm_shift: u64 = 0
    if mantissa != 0 or expoente_ieee <= 1 {
        mm_shift = 1
    }
    let en = RyuEntrada{m2 = m2, e2 = e2, mm_shift = mm_shift, aceita = (m2 % 2) == 0}
    var est: RyuEstado = ryu_escala_f2s(en)
    ryu_remover(&est, en.aceita)
    return RyuDecimal{mantissa = est.saida, expoente = est.e10 + est.removidos}
}

// ---- texto Display do Ryu (rt_real_curto.c): posicional, sem expoente, sem zeros finais ----
proc ryu_contar_digitos(mantissa: u64) -> int {
    var n: int = 1
    var resto: u64 = mantissa / 10
    while resto > 0 {
        n += 1
        resto = resto / 10
    }
    return n
}

// Digito p posicoes a partir da direita (0 = unidade)
proc ryu_digito_da_direita(mantissa: u64, p: int) -> u64 {
    var resto: u64 = mantissa
    var restam: int = p
    while restam > 0 {
        resto = resto / 10
        restam -= 1
    }
    return resto % 10
}

proc ryu_texto_de(d: RyuDecimal) -> RyuTexto {
    let total: int = ryu_contar_digitos(d.mantissa)
    var zeros: int = 0
    while zeros < total - 1 and ryu_digito_da_direita(d.mantissa, zeros) == 0 {
        zeros += 1
    }
    return RyuTexto{mantissa = d.mantissa, total = total, nd = total - zeros, e10 = d.expoente + total - 1}
}

// ASCII do digito de indice k (0 = o mais significativo); depois do ultimo digito significativo sai '0'
proc ryu_ascii_do_indice(t: RyuTexto, k: int) -> u8 {
    if k >= t.nd {
        return RT_ASCII_ZERO
    }
    let digito: u64 = ryu_digito_da_direita(t.mantissa, t.total - 1 - k)
    return RT_ASCII_ZERO + (digito as u8)
}

// Parte inteira (e10 >= 0) mais a fracionaria, se houver; devolve o indice depois do ultimo byte escrito
proc curto_parte_inteira(t: RyuTexto, saida: []u8, inicio: int) -> int {
    var n: int = inicio
    var k: int = 0
    while k <= t.e10 {
        saida[n] = ryu_ascii_do_indice(t, k)
        n += 1
        k += 1
    }
    if t.nd > t.e10 + 1 {
        saida[n] = RT_ASCII_PONTO
        n += 1
        var j: int = t.e10 + 1
        while j < t.nd {
            saida[n] = ryu_ascii_do_indice(t, j)
            n += 1
            j += 1
        }
    }
    return n
}

// e10 < 0: "0." seguido de zeros e depois os digitos
proc curto_parte_fracionaria(t: RyuTexto, saida: []u8, inicio: int) -> int {
    var n: int = inicio
    saida[n] = RT_ASCII_ZERO
    saida[n + 1] = RT_ASCII_PONTO
    n += 2
    var zeros: int = 0
    while zeros < -t.e10 - 1 {
        saida[n] = RT_ASCII_ZERO
        n += 1
        zeros += 1
    }
    var k: int = 0
    while k < t.nd {
        saida[n] = ryu_ascii_do_indice(t, k)
        n += 1
        k += 1
    }
    return n
}

// Texto Display de mantissa * 10^expoente com sinal opcional; devolve o tamanho
proc curto_posicional(d: RyuDecimal, negativo: bool, saida: []u8) -> int {
    let t: RyuTexto = ryu_texto_de(d)
    var n: int = 0
    if negativo {
        saida[0] = RT_ASCII_MENOS
        n = 1
    }
    if t.e10 >= 0 {
        return curto_parte_inteira(t, saida, n)
    }
    return curto_parte_fracionaria(t, saida, n)
}

// nan, inf e -inf (o sinal de nan some, como no rt_real_curto.c); devolve o tamanho
proc curto_nao_finito(mantissa: u64, negativo: bool, saida: []u8) -> int {
    if mantissa != 0 {
        saida[0] = RT_ASCII_N
        saida[1] = RT_ASCII_A
        saida[2] = RT_ASCII_N
        return 3
    }
    var n: int = 0
    if negativo {
        saida[0] = RT_ASCII_MENOS
        n = 1
    }
    saida[n] = RT_ASCII_I
    saida[n + 1] = RT_ASCII_N
    saida[n + 2] = RT_ASCII_F
    return n + 3
}

// Texto Display do f64 em saida (ate RT_REAL_SAIDA_MAX bytes); devolve o tamanho. Zero sai "0" ou "-0".
pub proc curto_texto_f64(v: f64, saida: []u8) -> int {
    let bits: u64 = transmute(v, to = u64)
    let negativo: bool = (bits >> 63) != 0
    let expoente: u64 = (bits >> 52) & RYU_D_EXP_MASCARA
    let mantissa: u64 = bits & RYU_D_MANT_MASCARA
    if expoente == RYU_D_EXP_MASCARA {
        return curto_nao_finito(mantissa, negativo, saida)
    }
    if expoente == 0 and mantissa == 0 {
        return curto_posicional(RyuDecimal{mantissa = 0, expoente = 0}, negativo, saida)
    }
    return curto_posicional(ryu_d2d(mantissa, expoente), negativo, saida)
}

// Texto Display do f32 (v arredondado para f32 antes); devolve o tamanho
pub proc curto_texto_f32(v: f64, saida: []u8) -> int {
    let f: f32 = v as f32
    let bits: u32 = transmute(f, to = u32)
    let expoente: u64 = ((bits >> 23) & 255) as u64
    let mantissa: u64 = (bits & 8388607) as u64
    if expoente == RYU_F_EXP_MASCARA or (expoente == 0 and mantissa == 0) {
        return curto_texto_f64(f as f64, saida)
    }
    return curto_posicional(ryu_f2d(mantissa, expoente), (bits >> 31) != 0, saida)
}

// ---- {x:.N}: porte do fmt_fp do musl (rt_fmt_fixo.c), com blocos base 1e9 em indices de um array local ----
// Expoente binario e y em [1,2) de v (v != 0); subnormal normalizado pela mantissa
proc fixo_normalizar(v: f64) -> FixoNormal {
    let bits: u64 = transmute(v, to = u64)
    let expoente: u64 = (bits >> 52) & RYU_D_EXP_MASCARA
    var mantissa: u64 = bits & RYU_D_MANT_MASCARA
    if expoente == 0 and mantissa == 0 {
        return FixoNormal{y = 0.0, e2 = 0}
    }
    var e2: int = (expoente as int) - RYU_D_BIAS
    if expoente == 0 {
        e2 = -1022
        while (mantissa >> 52) == 0 {
            mantissa = mantissa << 1
            e2 -= 1
        }
    }
    let bits_y: u64 = ((RYU_D_BIAS as u64) << 52) | (mantissa & RYU_D_MANT_MASCARA)
    return FixoNormal{y = transmute(bits_y, to = f64), e2 = e2}
}

// Passo 1 do musl: y vira blocos base 1e9 (o laco do do-while garante ao menos um bloco)
proc fixo_expande_blocos(y0: f64, big: []u32, st: ^FixoEstado) {
    var y: f64 = y0
    while true {
        big[st.z] = y as u32
        y = FIXO_BASE_F64 * (y - (big[st.z] as f64))
        st.z += 1
        if y == 0.0 {
            break
        }
    }
}

// e2 > 0: multiplica os blocos por 2^e2 (de 29 em 29 bits)
proc fixo_multiplica(big: []u32, st: ^FixoEstado) {
    while st.e2 > 0 {
        var sh: int = st.e2
        if sh > 29 {
            sh = 29
        }
        var carry: u64 = 0
        var d: int = st.z - 1
        while d >= st.a {
            let x: u64 = ((big[d] as u64) << (sh as u64)) + carry
            big[d] = (x % FIXO_BASE) as u32
            carry = x / FIXO_BASE
            d -= 1
        }
        if carry != 0 {
            st.a -= 1
            big[st.a] = carry as u32
        }
        while st.z > st.a and big[st.z - 1] == 0 {
            st.z -= 1
        }
        st.e2 -= sh
    }
}

// e2 < 0: divide os blocos por 2^-e2 (de 9 em 9 bits), limitando o numero de blocos ao que a precisao pede
proc fixo_divide(big: []u32, st: ^FixoEstado) {
    while st.e2 < 0 {
        var sh: int = -st.e2
        if sh > 9 {
            sh = 9
        }
        let precisao_blocos: int = 1 + (st.precisao + FIXO_MANT_LDBL_TERCO + 8) / 9
        var carry: u64 = 0
        var d: int = st.a
        while d < st.z {
            let resto: u64 = (big[d] as u64) & (((1 as u64) << (sh as u64)) - 1)
            big[d] = ((((big[d] as u64) >> (sh as u64)) + carry)) as u32
            carry = (FIXO_BASE >> (sh as u64)) * resto
            d += 1
        }
        if st.a < st.z and big[st.a] == 0 {
            st.a += 1
        }
        if carry != 0 {
            big[st.z] = carry as u32
            st.z += 1
        }
        if st.z - st.r > precisao_blocos {
            st.z = st.r + precisao_blocos
        }
        st.e2 += sh
    }
}

// Passo 1 inteiro (rt_fixo_blocos): ajusta o expoente, posiciona a/r/z e roda os tres laços
proc fixo_blocos(normal: FixoNormal, big: []u32, st: ^FixoEstado) {
    var y: f64 = normal.y
    var e2: int = normal.e2
    if y != 0.0 {
        y = y * FIXO_DOIS_28
        e2 -= 28
    }
    st.e2 = e2
    st.a = FIXO_SLOTS - 6
    if e2 < 0 {
        st.a = 0
    }
    st.r = st.a
    st.z = st.a
    fixo_expande_blocos(y, big, st)
    fixo_multiplica(big, st)
    fixo_divide(big, st)
}

// Empate do arredondamento do musl: devolve o novo d (pode descer ao propagar o vai-um)
proc fixo_empate(big: []u32, st: ^FixoEstado, d0: int, i: u64) -> int {
    var d: int = d0
    let x: u64 = (big[d] as u64) % i
    let metade: u64 = i / 2
    var meio: f64 = FIXO_DOIS_53
    var impar: bool = ((big[d] as u64) / i) % 2 == 1
    if i == FIXO_BASE and d > st.a {
        if big[d - 1] % 2 == 1 {
            impar = true
        }
    }
    if impar {
        meio = meio + 2.0
    }
    var fracao: f64 = 1.5
    if x < metade {
        fracao = 0.5
    } else if x == metade and d + 1 == st.z {
        fracao = 1.0
    }
    big[d] = ((big[d] as u64) - x) as u32
    if meio + fracao != meio {
        big[d] = ((big[d] as u64) + i) as u32
        while (big[d] as u64) > FIXO_NOVE_MAX {
            big[d] = 0
            d -= 1
            if d < st.a {
                st.a -= 1
                big[st.a] = 0
            }
            big[d] += 1
        }
    }
    return d
}

// Arredondamento na casa de corte da precisao (rt_fixo_arredondar)
proc fixo_arredondar(big: []u32, st: ^FixoEstado) {
    let p: int = st.precisao
    if p >= 9 * (st.z - st.r - 1) {
        return
    }
    var d: int = st.r + 1 + ((p + 9 * FIXO_MAX_EXP_LDBL) / 9 - FIXO_MAX_EXP_LDBL)
    var j: int = (p + 9 * FIXO_MAX_EXP_LDBL) % 9
    var i: u64 = 10
    j += 1
    while j < 9 {
        i = i * 10
        j += 1
    }
    let x: u64 = (big[d] as u64) % i
    if x != 0 or d + 1 != st.z {
        d = fixo_empate(big, st, d, i)
    }
    if st.z > d + 1 {
        st.z = d + 1
    }
}

// Escreve x com ao menos um digito e sem zeros a esquerda; devolve quantos
proc fixo_escreve_inteiro(valor: u64, saida: []u8, inicio: int) -> int {
    var len: int = 1
    var resto: u64 = valor / 10
    while resto > 0 {
        len += 1
        resto = resto / 10
    }
    var x: u64 = valor
    var k: int = len - 1
    while k >= 0 {
        saida[inicio + k] = RT_ASCII_ZERO + ((x % 10) as u8)
        x = x / 10
        k -= 1
    }
    return len
}

// Escreve os 9 digitos de x (com zeros a esquerda) a partir de inicio
proc fixo_escreve_nove(valor: u64, saida: []u8, inicio: int) {
    var x: u64 = valor
    var k: int = 8
    while k >= 0 {
        saida[inicio + k] = RT_ASCII_ZERO + ((x % 10) as u8)
        x = x / 10
        k -= 1
    }
}

// Blocos como "inteiro.fracao" com precisao casas (rt_fixo_escrever); devolve o indice depois do ultimo byte
proc fixo_escrever(big: []u32, st: ^FixoEstado, saida: []u8, inicio: int) -> int {
    var n: int = inicio
    var a: int = st.a
    if a > st.r {
        a = st.r
    }
    var d: int = a
    while d <= st.r {
        if d == a {
            n += fixo_escreve_inteiro(big[d] as u64, saida, n)
        } else {
            fixo_escreve_nove(big[d] as u64, saida, n)
            n += 9
        }
        d += 1
    }
    var p: int = st.precisao
    if p > 0 {
        saida[n] = RT_ASCII_PONTO
        n += 1
    }
    var bloco: [9]u8 = {}
    while d < st.z and p > 0 {
        fixo_escreve_nove(big[d] as u64, bloco[..], 0)
        var k: int = 0
        while k < 9 and k < p {
            saida[n] = bloco[k]
            n += 1
            k += 1
        }
        p -= 9
        d += 1
    }
    while p > 0 {
        saida[n] = RT_ASCII_ZERO
        n += 1
        p -= 1
    }
    return n
}

// rt_fmt_fixo: "%.Nf" exato (N = st.precisao); sem nan/inf (quem chama trata). Devolve o tamanho.
proc rt_fmt_fixo(v: f64, precisao: int, saida: []u8) -> int {
    var big: [FIXO_SLOTS]u32 = {}
    var st = FixoEstado{precisao = precisao}
    var n: int = 0
    if (transmute(v, to = u64) >> 63) != 0 {
        saida[0] = RT_ASCII_MENOS
        n = 1
    }
    fixo_blocos(fixo_normalizar(v), big[..], &st)
    fixo_arredondar(big[..], &st)
    while st.z > st.a and big[st.z - 1] == 0 {
        st.z -= 1
    }
    return fixo_escrever(big[..], &st, saida, n)
}

// Real com precisao: nan/inf saem pelo Display curto (mesmo texto do rt_real_especial)
proc real_texto_fixo(v: f64, precisao: int, saida: []u8) -> int {
    if ((transmute(v, to = u64) >> 52) & RYU_D_EXP_MASCARA) == RYU_D_EXP_MASCARA {
        return curto_texto_f64(v, saida)
    }
    return rt_fmt_fixo(v, precisao, saida)
}

// Precisao de fmt (bits 8..12): N+1 codifica N casas; 0 cairia no padrao 6 (como rt_formata.c)
proc fmt_precisao_de(fmt: u32) -> int {
    let codigo: u32 = (fmt >> RT_FMT_PRECISAO_DESLOC) & RT_FMT_PRECISAO_MASCARA
    if codigo == 0 {
        return RT_REAL_PRECISAO_PADRAO
    }
    return (codigo - 1) as int
}

// Texto com precisao (f"{x:.N}" e forja_fmt_f32/f64): o fmt traz N; f32 chega como double sem arredondar (como no x64)
pub proc texto_f64_fixo(v: f64, fmt: u32, saida: []u8) -> int {
    return real_texto_fixo(v, fmt_precisao_de(fmt), saida)
}

// ---- simbolos de runtime (forja_fmt_f32/f64 e _curto) ----
pub proc fmt_f64_curto(v: f64, fmt: u32) {
    var saida: [RT_REAL_SAIDA_MAX]u8 = {}
    let n: int = curto_texto_f64(v, saida[..])
    emite_texto(&saida[0], n, fmt)
}

pub proc fmt_f32_curto(v: f64, fmt: u32) {
    var saida: [RT_REAL_SAIDA_MAX]u8 = {}
    let n: int = curto_texto_f32(v, saida[..])
    emite_texto(&saida[0], n, fmt)
}

pub proc fmt_f64(v: f64, fmt: u32) {
    var saida: [RT_REAL_SAIDA_MAX]u8 = {}
    let n: int = texto_f64_fixo(v, fmt, saida[..])
    emite_texto(&saida[0], n, fmt)
}

pub proc fmt_f32(v: f64, fmt: u32) {
    fmt_f64(v, fmt)
}
