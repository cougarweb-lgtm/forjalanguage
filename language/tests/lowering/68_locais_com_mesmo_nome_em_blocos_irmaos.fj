proc main() {
    var k = 1
    if k == 1 {
        let a = 10
        print(a)
    }
    if k == 1 {
        let a = 20
        print(a)
    }
    for i in 0..<2 {
        let t = i + 1
        print(t)
    }
    for i in 0..<2 {
        let t = i + 5
        print(t)
    }
    while k < 3 {
        let a = k
        print(a)
        k += 1
    }
}
