// P-IA1-LG: erro do GCC 16.1.0 (tree-widening_mul, .SAT_SUB) com u8 alargado para u32. Molde: tests\lowering\221_gcc_sat_sub_alargado.fj.
// Os valores vem de arrays percorridos por laco (entrada opaca ao IPA-CP). Esperado: 255 - 1 = 254 (com sinal viraria 2^32 - 2).
proc diferenca_u8_u32(a: u8, b: u8) -> u32 {
    var r: u8 = 0
    if a >= b {
        r = a - b
    }
    return r as u32
}

proc main() {
    let a: [4]u8 = {255, 200, 128, 100}
    let b: [4]u8 = {1, 100, 127, 200}
    for i in 0..<4 {
        print(f"u8 {a[i]} {b[i]} -> {diferenca_u8_u32(a[i], b[i])}")
    }
}
