// L-03 (IA1-L5a): o print curto de real convive, no mesmo programa, com o real do f"..." (Ryu d2fixed no nativo): sao dois caminhos de runtime, cada um com o seu texto.
proc main() {
    let x: f64 = 2.0 / 3.0
    print(x)
    print(f"{x}")
    print(f"{x:.3}")
    let y: f32 = 0.1
    print(y)
    print(f"{y}")
    print(f"{y:.2}")
    print(100.5)
}
