// IA1-S2d1 (A20): seed_from_clock e a unica entrada nao deterministica; este teste NAO compara valores, so prova que dois geradores seguidos funcionam e respeitam os limites de cada operacao.
import "std:rand" as rand

proc conferir(rng: ^rand.Rng) -> bool {
    var ok = true
    for _i in 0..<200 {
        let f = rand.next_float(rng)
        let b = rand.below(rng, n = 10)
        let r = rand.int_range(rng, min = -3, max = 3)
        let g = rand.float_range(rng, min = 2.0, max = 3.0)
        let u = rand.next_u32(rng)
        if f < 0.0 or f >= 1.0 or b >= 10 or r < -3 or r > 3 or g < 2.0 or g >= 3.0 or u > 4294967295 {
            ok = false
        }
    }
    return ok
}

proc main() {
    var a = rand.seed_from_clock()
    var b = rand.seed_from_clock()
    print(f"a {conferir(&a)}")
    print(f"b {conferir(&b)}")
    var p = rand.perm(&a, n = 20, alloc = heap)
    defer delete(p)
    print(f"perm {len(p)}")
}
