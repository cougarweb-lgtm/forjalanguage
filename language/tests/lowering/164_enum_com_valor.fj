enum Sinal {
    negativo = -3
    zero = 0
    positivo = 5
}

foreign {
    proc labs(n: Sinal) -> i32
}

proc main() {
    print(labs(Sinal.negativo))
    print(labs(Sinal.positivo))
    let s = Sinal.zero
    switch s {
    case Sinal.negativo:
        print(1)
    case Sinal.zero:
        print(2)
    case Sinal.positivo:
        print(3)
    }
    let t: Sinal = Sinal.positivo
    print(t == Sinal.positivo)
}
