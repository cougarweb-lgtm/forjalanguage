enum ErroLer { vazio }

proc ler(n: int) -> (dados: [dynamic]int, erro: ?ErroLer) {
    var l = make([dynamic]int, alloc = heap)
    if n == 0 {
        return l, ErroLer.vazio
    }
    for i in 0..<n {
        append(&l, item = i * 10)
    }
    return l, none
}

proc main() {
    var d, e = ler(4)
    print(len(d))
    print(d[3])
    print(e == none)
    delete(d)
    var d2, e2 = ler(0)
    print(len(d2))
    print(e2 != none)
    delete(d2)
}
