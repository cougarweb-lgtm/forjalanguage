// IA1-S2d1 (A20): int_range(min, max) uniforme e INCLUSIVO nas duas pontas, com intervalos de 1 valor, pequenos, negativos, e o intervalo cheio (menor int .. maior int: a largura em u64 da 0 com volta
// e devolve um next_u64 reinterpretado). Cada intervalo: 60 sorteios de um gerador novo (semente 99); "dentro" prova min <= v <= max. Depois, "pontas": em 2000 sorteios de 1..6 aparecem o 1 e o 6.
// O esperado vem de um oraculo Python.
import "std:rand" as rand

const MENOR_INT: int = -9223372036854775807 - 1
const MAIOR_INT: int = 9223372036854775807
const MINIMOS: [10]int = {0, 1, -5, -100, 5, MENOR_INT, MAIOR_INT - 1, MENOR_INT, MENOR_INT, 0}
const MAXIMOS: [10]int = {0, 6, 5, -90, 5, MENOR_INT + 1, MAIOR_INT, MAIOR_INT, 0, MAIOR_INT}
const SORTEIOS: int = 60

proc main() {
    for k in 0..<10 {
        let menor = MINIMOS[k]
        let maior = MAXIMOS[k]
        var rng = rand.seed(99)
        for i in 0..<SORTEIOS {
            let v = rand.int_range(&rng, min = menor, max = maior)
            print(f"range {k} {i} {v} {v >= menor and v <= maior}")
        }
        let proximo = rand.next_u64(&rng)
        print(f"fim {k} proximo {proximo}")
    }
    var rng = rand.seed(7)
    var viu_um = false
    var viu_seis = false
    for _i in 0..<2000 {
        let v = rand.int_range(&rng, min = 1, max = 6)
        if v == 1 {
            viu_um = true
        }
        if v == 6 {
            viu_seis = true
        }
    }
    print(f"pontas {viu_um} {viu_seis}")
}
