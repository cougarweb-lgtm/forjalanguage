enum Cor { vermelho, verde }

proc main() {
    var n = 0
    while n < 4 {
        n += 1
        switch cor_de(n) {
        case Cor.vermelho:
            continue
        case Cor.verde:
            print(n)
        }
        print(100 + n)
    }
}

proc cor_de(n: int) -> Cor {
    if n % 2 == 0 {
        return Cor.vermelho
    }
    return Cor.verde
}
