// P-IA1-LG: erro do GCC 16.1.0 (tree-widening_mul, .SAT_SUB) com u16 alargado para u64. Molde: tests\lowering\221_gcc_sat_sub_alargado.fj.
// Os valores vem de arrays percorridos por laco (entrada opaca ao IPA-CP). Esperado: 65535 - 1 = 65534 (com sinal viraria 2^64 - 2).
proc diferenca_u16_u64(a: u16, b: u16) -> u64 {
    var r: u16 = 0
    if a >= b {
        r = a - b
    }
    return r as u64
}

proc main() {
    let a: [4]u16 = {65535, 40000, 1000, 1}
    let b: [4]u16 = {1, 3, 1001, 1}
    for i in 0..<4 {
        print(f"u16 {a[i]} {b[i]} -> {diferenca_u16_u64(a[i], b[i])}")
    }
}
