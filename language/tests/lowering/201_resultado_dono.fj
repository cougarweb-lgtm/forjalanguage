// L-01 (IA1-L4): 'T ! E' com dono dentro (lista, map, struct com lista). O return move o dono para o resultado, try repassa e entrega ao chamador,
// 'switch r in f()' liga o dono ao case. Cada dono e liberado uma vez: em dev nao pode sobrar R0009.
enum Erro {
    vazio
    grande
}

struct Caixa {
    itens: [dynamic]i32
}

proc criar(n: i32) -> [dynamic]i32 ! Erro {
    if n < 0 {
        return Erro.vazio
    }
    if n > 100 {
        return Erro.grande
    }
    var l = make([dynamic]i32, alloc = heap)
    for i in 0..<n {
        append(&l, item = i * 2)
    }
    return l
}

proc repassar(n: i32) -> [dynamic]i32 ! Erro {
    var l = try criar(n)
    append(&l, item = 99)
    return l
}

proc repassar_direto(n: i32) -> [dynamic]i32 ! Erro {
    return criar(n)
}

proc tabela() -> map[str]i32 ! Erro {
    var m = make(map[str]i32, alloc = heap)
    insert(&m, key = "a", value = 7)
    insert(&m, key = "b", value = 8)
    return m
}

proc caixa(n: i32) -> Caixa ! Erro {
    var c = Caixa{itens = make([dynamic]i32, alloc = heap)}
    append(&c.itens, item = n)
    return c
}

proc mostrar(n: i32) {
    switch l in repassar(n) {
    case [dynamic]i32:
        print(f"lista n={len(l)} ultimo={l[len(l) - 1]}")
        delete(l)
    case Erro:
        print("erro")
    }
}

proc usar() -> ! Erro {
    var m = try tabela()
    let a = get(m, key = "a") or_else 0
    print(f"tabela n={len(m)} a={a}")
    delete(m)
    var c = try caixa(5)
    print(f"caixa n={len(c.itens)} v={c.itens[0]}")
    delete(c.itens)
    var d = try repassar_direto(3)
    print(f"direto n={len(d)}")
    delete(d)
}

proc main() -> ! Erro {
    mostrar(3)
    mostrar(0)
    mostrar(-1)
    mostrar(500)
    try usar()
}
