enum Cor { vermelho, verde }

proc main() {
    switch c in cor_de(2) {
    case Cor.vermelho:
        print(c == Cor.verde)
    case Cor.verde:
        print(c == Cor.verde)
    }
    switch c in cor_de(1) {
    case Cor.vermelho:
        print(c == Cor.verde)
    case Cor.verde:
        print(c == Cor.verde)
    }
}

proc cor_de(n: int) -> Cor {
    if n % 2 == 0 {
        return Cor.vermelho
    }
    return Cor.verde
}
