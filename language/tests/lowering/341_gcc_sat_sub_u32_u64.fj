// P-IA1-LG: erro do GCC 16.1.0 (tree-widening_mul, .SAT_SUB) com u32 alargado para u64. Molde: tests\lowering\221_gcc_sat_sub_alargado.fj.
// Os valores vem de arrays percorridos por laco (entrada opaca ao IPA-CP). Esperado: 4294967295 - 1 = 4294967294.
proc diferenca_u32_u64(a: u32, b: u32) -> u64 {
    var r: u32 = 0
    if a >= b {
        r = a - b
    }
    return r as u64
}

proc main() {
    let a: [3]u32 = {4294967295, 3000000000, 7}
    let b: [3]u32 = {1, 5, 9}
    for i in 0..<3 {
        print(f"u32 {a[i]} {b[i]} -> {diferenca_u32_u64(a[i], b[i])}")
    }
}
