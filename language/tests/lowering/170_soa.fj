struct Bala {
    x: int = 0
    dano: int = 10
    viva: bool = true
}

proc total(xs: []int) -> int {
    var t = 0
    for x in xs {
        t += x
    }
    return t
}

proc main() {
    var a: soa[4]Bala = {}
    a[3] = Bala{}
    a[1] = Bala{x = 3, dano = 20}
    print(a[1].x)
    print(a[1].dano)
    a[2].x = 5
    a[2].x += 3
    print(a[2].x)
    let b = a[1]
    print(b.x)
    print(len(a))
    print(a[0].x)
    print(a[3].dano)
    let p = &a[0].x
    p^ = 1
    print(a[0].x)
    print(total(a.dano) - 10)
    var c = 0
    for item in a {
        if item.x > 2 {
            c += 1
        }
    }
    print(c)
    var n = 0
    for i, item in a {
        if item.dano == 20 and item.viva {
            n = i
        }
    }
    print(n + a[1].x + 1)
}
