// IA1-S2b2b (T08): std:text to_upper, to_lower, equal_fold e compare. Caixa so ASCII (bytes >= 128 passam iguais); to_upper/to_lower devolvem texto DONO (sempre delete); equal_fold e compare nao alocam.
// compare: ordem lexicografica por BYTES sem sinal (prefixo vem antes; byte >= 128 vem depois de todo ASCII), -1, 0 ou 1. Os 256 valores de byte passam por to_upper/to_lower e por todos os pares de equal_fold e compare.
// Cada resultado sai como <texto> tamanho, com \r \n \t como barra + letra e bytes >= 128 como \xhh.
import "std:text" as tx

const CAIXA_TEXTOS: [9]str = {"", "abc", "ABC", "aBc XyZ 123", "@[`{", "héllo WÖRLD", "z", "Z", "a-Z_9"}
const FOLD_TEXTOS: [15]str = {"", "abc", "ABC", "aBc", "abd", "ab", "abcd", "é", "É", "a1", "A1", "[", "{", "@", "`"}
const CMP_TEXTOS: [10]str = {"", "a", "ab", "abc", "b", "B", "é", "z", "aa", "é!"}

proc anexa_visivel(saida: ^[dynamic]u8, b: u8) {
    if b == 13 {
        append(saida, item = "\\r")
    } else if b == 10 {
        append(saida, item = "\\n")
    } else if b == 9 {
        append(saida, item = "\\t")
    } else if b >= 128 {
        format(f"\\x{b:02x}", into = saida)
    } else {
        append(saida, item = b)
    }
}

// Imprime "  <texto> tamanho" com os controles visiveis.
proc mostra(saida: ^[dynamic]u8, texto: str) {
    append(saida, item = "  <")
    for i in 0..<len(texto) {
        anexa_visivel(saida, b = texto[i])
    }
    format(f"> {len(texto)}", into = saida)
    let linha = to_str(saida)
    defer delete(linha)
    print(linha)
}

proc caso_caixa(saida: ^[dynamic]u8) {
    for a in 0..<len(CAIXA_TEXTOS) {
        let alto = tx.to_upper(CAIXA_TEXTOS[a], alloc = heap)
        defer delete(alto)
        let baixo = tx.to_lower(CAIXA_TEXTOS[a], alloc = heap)
        defer delete(baixo)
        print(f"caixa {a}")
        mostra(saida, texto = alto)
        mostra(saida, texto = baixo)
    }
}

// Uma linha com os 256 bytes de texto em hexa (2 digitos cada).
proc linha_hexa(saida: ^[dynamic]u8, rotulo: str, texto: str) {
    append(saida, item = rotulo)
    for i in 0..<len(texto) {
        format(f"{texto[i]:02x}", into = saida)
    }
    let linha = to_str(saida)
    defer delete(linha)
    print(linha)
}

proc caso_256_bytes(saida: ^[dynamic]u8) {
    var lista = make([dynamic]u8, alloc = heap, cap = 256)
    defer delete(lista)
    for b in 0..<256 {
        append(&lista, item = b as u8)
    }
    let todos = from_bytes(lista, alloc = heap)
    defer delete(todos)
    let alto = tx.to_upper(todos, alloc = heap)
    defer delete(alto)
    let baixo = tx.to_lower(todos, alloc = heap)
    defer delete(baixo)
    linha_hexa(saida, rotulo = "upper ", texto = alto)
    linha_hexa(saida, rotulo = "lower ", texto = baixo)
    // Todos os pares de 1 byte: quantos iguais ignorando a caixa; e quantos -1, 0 e 1 no compare.
    var iguais = 0
    var menores = 0
    var zeros = 0
    var maiores = 0
    for i in 0..<256 {
        for j in 0..<256 {
            if tx.equal_fold(todos[i..<i + 1], todos[j..<j + 1]) {
                iguais += 1
            }
            let c = tx.compare(todos[i..<i + 1], todos[j..<j + 1])
            if c < 0 {
                menores += 1
            } else if c == 0 {
                zeros += 1
            } else {
                maiores += 1
            }
        }
    }
    print(f"pares fold {iguais} cmp {menores} {zeros} {maiores}")
}

proc caso_equal_fold(saida: ^[dynamic]u8) {
    for a in 0..<len(FOLD_TEXTOS) {
        format(f"fold {a}:", into = saida)
        for b in 0..<len(FOLD_TEXTOS) {
            if tx.equal_fold(FOLD_TEXTOS[a], FOLD_TEXTOS[b]) {
                append(saida, item = " 1")
            } else {
                append(saida, item = " 0")
            }
        }
        let linha = to_str(saida)
        defer delete(linha)
        print(linha)
    }
}

proc caso_compare(saida: ^[dynamic]u8) {
    for a in 0..<len(CMP_TEXTOS) {
        format(f"cmp {a}:", into = saida)
        for b in 0..<len(CMP_TEXTOS) {
            format(f" {tx.compare(CMP_TEXTOS[a], CMP_TEXTOS[b])}", into = saida)
        }
        let linha = to_str(saida)
        defer delete(linha)
        print(linha)
    }
}

proc main() {
    var saida = make([dynamic]u8, alloc = heap)
    defer delete(saida)
    caso_caixa(&saida)
    caso_256_bytes(&saida)
    caso_equal_fold(&saida)
    caso_compare(&saida)
}
