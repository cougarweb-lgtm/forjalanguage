// L-05 (IA1-L5b): append(&l, items = fatia). Copia os elementos de uma vez; cresce quanto precisar; aceita fatia de array, de lista e de fatia, e str numa lista de u8; fatia vazia nao muda nada.
proc main() {
    var arr: [5]i32 = {1, 2, 3, 4, 5}
    var l = make([dynamic]i32, alloc = heap)
    append(&l, items = arr[..])
    print(len(l))
    append(&l, items = arr[1..<3])
    print(len(l))
    print(l[5])
    print(l[6])
    append(&l, items = arr[2..<2])
    print(len(l))
    append(&l, items = l[0..<0])
    print(len(l))

    var grande: [100]int = {}
    for i in 0..<100 {
        grande[i] = i * 3
    }
    var m = make([dynamic]int, alloc = heap, cap = 4)
    append(&m, item = 1000)
    append(&m, items = grande[..])
    append(&m, items = grande[90..<100])
    print(len(m))
    print(m[0])
    print(m[1])
    print(m[100])
    print(m[101])
    print(m[110])

    var copia = make([dynamic]int, alloc = heap)
    append(&copia, items = m[..])
    append(&copia, items = m[..])
    print(len(copia))
    print(copia[110 + 1 + 1])

    var t = make([dynamic]u8, alloc = heap)
    append(&t, items = "abc")
    append(&t, items = "")
    append(&t, items = "defg")
    print(len(t))
    print(t[0])
    print(t[6])

    var r: [3]f32 = {0.5, 1.5, 2.5}
    var rl = make([dynamic]f32, alloc = frame)
    append(&rl, items = r[..])
    append(&rl, items = r[1..<3])
    print(len(rl))
    frame_reset()
    delete(l)
    delete(m)
    delete(copia)
    delete(t)
}
