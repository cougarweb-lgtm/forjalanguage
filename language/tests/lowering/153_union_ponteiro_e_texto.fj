struct Grifo {
    vida: i32 = 100
}

union Alvo { ^Grifo, str }

proc descrever(a: Alvo) {
    switch x in a {
    case ^Grifo:
        x.vida -= 1
        print(x.vida)
    case str:
        print(x)
    }
}

proc main() {
    var g = Grifo{}
    descrever(&g)
    descrever(&g)
    descrever("pedra")
    print(g.vida)
    var lista = make([dynamic]Alvo, alloc = heap)
    append(&lista, item = &g)
    append(&lista, item = "arvore")
    for a in lista {
        descrever(a)
    }
    delete(lista)
}
