// IA1-S2h (D-FMT): format_date com campo fora das faixas do calendario (mes 13) e erro de quem chama: panic (R0003), nao DateError. Com a data certa a conta vale; o mesmo dt dado a format_pattern devolve DateError.out_of_range (315).
import "std:fmt" as fmt
import "std:time" as tm

proc main() {
    let bom = tm.DateTime{year = 2000, month = 2, day = 29}
    let a = fmt.format_date(bom, loc = fmt.PT_BR, alloc = heap)
    print(a)
    delete(a)
    let ruim = tm.DateTime{year = 2000, month = 13, day = 1}
    let b = fmt.format_date(ruim, loc = fmt.PT_BR, alloc = heap)
    print(b)
    delete(b)
    print("nao chega")
}
