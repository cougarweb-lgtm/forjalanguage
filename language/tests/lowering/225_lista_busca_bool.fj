// IA1-L9d: index_of, last_index_of, contains e count em lista, array e fatia de bool.
proc main() {
    var l = make([dynamic]bool, alloc = heap, cap = 4)
    print(contains(l, true))
    print(count(l, false))
    append(&l, item = true)
    print(index_of(l, true) or_else -1)
    print(index_of(l, false) or_else -1)
    append(&l, item = false)
    append(&l, item = true)
    print(index_of(l, false) or_else -1)
    print(last_index_of(l, true) or_else -1)
    print(last_index_of(l, false) or_else -1)
    print(count(l, true))
    print(count(l, false))
    print(contains(l, false))
    let a: [3]bool = {true, true, true}
    print(contains(a, false))
    print(index_of(a, false) or_else -1)
    print(count(a, true))
    let s = l[1..<3]
    print(index_of(s, true) or_else -1)
    print(count(s, true))
    delete(l)
}
