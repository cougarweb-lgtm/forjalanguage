// IA1-L10b (T07): std:text repeat(s, n) e concat(parts): texto DONO (heap) montado no builder de uma vez so (capacidade exata); sempre delete.
// repeat: n <= 0 ou s vazio da texto vazio; concat: lista vazia da texto vazio, sem separador (UTF-8 tratado como bytes).
// Cada resultado sai como <texto> tamanho, com \r \n \t como barra + letra e bytes >= 128 como \xhh.
import "std:text" as tx

const TEXTOS: [5]str = {"", "a", "ab", "é", "a\r\nb"}
const VEZES: [8]int = {-5, -1, 0, 1, 2, 3, 10, 100}
const PECAS: [8]str = {"a", "", "bc", "é", "\r\n", "x", "", "yz"}
const MUITAS: int = 1000

proc anexa_visivel(saida: ^[dynamic]u8, b: u8) {
    if b == 13 {
        append(saida, item = "\\r")
    } else if b == 10 {
        append(saida, item = "\\n")
    } else if b == 9 {
        append(saida, item = "\\t")
    } else if b >= 128 {
        format(f"\\x{b:02x}", into = saida)
    } else {
        append(saida, item = b)
    }
}

// Imprime "  <texto> tamanho" com os controles visiveis.
proc mostra(saida: ^[dynamic]u8, texto: str) {
    append(saida, item = "  <")
    for i in 0..<len(texto) {
        anexa_visivel(saida, b = texto[i])
    }
    format(f"> {len(texto)}", into = saida)
    let linha = to_str(saida)
    defer delete(linha)
    print(linha)
}

proc caso_repeat(saida: ^[dynamic]u8) {
    for a in 0..<len(TEXTOS) {
        for b in 0..<len(VEZES) {
            let resultado = tx.repeat(TEXTOS[a], n = VEZES[b], alloc = heap)
            defer delete(resultado)
            print(f"repeat {a} {b}")
            mostra(saida, texto = resultado)
        }
    }
}

proc caso_concat(saida: ^[dynamic]u8) {
    // Constante nao se fatia: a copia por valor vira array comum.
    var pecas = PECAS
    for k in 0..=len(PECAS) {
        let resultado = tx.concat(pecas[0..<k], alloc = heap)
        defer delete(resultado)
        print(f"concat {k}")
        mostra(saida, texto = resultado)
    }
    // Uma so peca, e muitas pecas iguais (so o tamanho e as pontas).
    let unica = tx.concat(pecas[2..<3], alloc = heap)
    defer delete(unica)
    print("concat unica")
    mostra(saida, texto = unica)
    var muitas = make([dynamic]str, alloc = heap)
    defer delete(muitas)
    for _vez in 0..<MUITAS {
        append(&muitas, item = "ab")
    }
    let junto = tx.concat(muitas[..], alloc = heap)
    defer delete(junto)
    let pares_ba = tx.str_count(junto, sub = "ba")
    print(f"concat muitas {len(junto)} {junto[0]} {junto[len(junto) - 1]} {pares_ba}")
}

proc main() {
    var saida = make([dynamic]u8, alloc = heap)
    defer delete(saida)
    caso_repeat(&saida)
    caso_concat(&saida)
}
