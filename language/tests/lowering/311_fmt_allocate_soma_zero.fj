// IA1-S2g (D-FMT): allocate com a soma dos pesos igual a 0 e erro de quem chama: panic (R0003). Soma 1 ainda vale.
import "std:fmt" as fmt

proc main() {
    var bom: [2]int = {0, 1}
    var ok = fmt.allocate(10, bom[..], alloc = heap)
    print(ok[1])
    delete(ok)
    var pesos: [3]int = {0, 0, 0}
    var ruim = fmt.allocate(10, pesos[..], alloc = heap)
    print(len(ruim))
    delete(ruim)
    print("nao chega")
}
