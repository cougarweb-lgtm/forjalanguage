// K08b (sort_by_key): array fixo entra como a[..] (igual ao sort_by). Chaves 3, 1, 2: a ordem vira seq 1, 2, 0.
struct Item {
    chave: int
    seq: int
}

proc main() {
    var a: [3]Item = {Item{chave = 3, seq = 0}, Item{chave = 1, seq = 1}, Item{chave = 2, seq = 2}}
    sort_by_key(a[..], key = Item.chave)
    print(a[0].seq)
    print(a[1].seq)
    print(a[2].seq)
}
