// IA1-L9e: sum, avg, min_of e max_of sobre lista, array e fatia de inteiros (int, i32, i64, u8): vazio (sum 0, avg 0, min/max none), 1 elemento, negativos e varios.
proc linha_int(s: []int) {
    print(sum(s))
    print(avg(s))
    print(min_of(s) or_else -1000)
    print(max_of(s) or_else -1000)
}

proc linha_i32(s: []i32) {
    print(sum(s))
    print(avg(s))
    print(min_of(s) or_else -1000)
    print(max_of(s) or_else -1000)
}

proc linha_i64(s: []i64) {
    print(sum(s))
    print(avg(s))
    print(min_of(s) or_else -1000)
    print(max_of(s) or_else -1000)
}

proc linha_u8(s: []u8) {
    print(sum(s))
    print(avg(s))
    print(min_of(s) or_else 250)
    print(max_of(s) or_else 250)
}

proc main() {
    var l = make([dynamic]int, alloc = heap, cap = 8)
    defer delete(l)
    linha_int(l[..])
    append(&l, item = 7)
    linha_int(l[..])
    append(&l, item = -3)
    append(&l, item = 12)
    append(&l, item = -20)
    append(&l, item = 5)
    linha_int(l[..])
    print(sum(l))
    print(min_of(l) or_else -1000)
    var a: [4]int = {10, 20, 30, 41}
    print(avg(a))
    linha_int(a[1..<3])
    var neg: [3]int = {-5, -9, -1}
    linha_int(neg[..])
    var b: [3]i32 = {-2147483647, 1, 2}
    linha_i32(b[..])
    var c: [3]i64 = {4000000000000, -1, 5000000000000}
    linha_i64(c[..])
    var d: [4]u8 = {200, 30, 20, 5}
    linha_u8(d[..])
    var vazio = make([dynamic]u8, alloc = heap, cap = 1)
    defer delete(vazio)
    linha_u8(vazio[..])
    print(sum(vazio))
}
