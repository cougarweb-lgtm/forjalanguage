// IA1-L9e: keys, values e clear em map[str]int: vazio, 1 par, varios, chave repetida (troca o valor), remove (o ultimo par ocupa o lugar do removido), clear e reuso.
// A ordem de keys e values e a de iteracao do map (insercao; o remove poe o ultimo par no lugar do removido), igual nas duas listas.
proc mostra(m: ^map[str]int) {
    var k = keys(m, alloc = heap)
    defer delete(k)
    var v = values(m, alloc = heap)
    defer delete(v)
    print(len(k))
    print(len(v))
    for i in 0..<len(k) {
        print(k[i])
        print(v[i])
    }
}

proc main() {
    var m = make(map[str]int, alloc = heap)
    defer delete(m)
    mostra(&m)
    clear(&m)
    print(len(m))
    insert(&m, key = "unico", value = 5)
    mostra(&m)
    insert(&m, key = "b", value = 20)
    insert(&m, key = "c", value = 30)
    insert(&m, key = "a", value = 10)
    insert(&m, key = "b", value = 21)
    mostra(&m)
    remove(&m, key = "unico")
    mostra(&m)
    var total = keys(&m, alloc = heap)
    defer delete(total)
    sort(total[..])
    print(total[0])
    print(total[2])
    clear(&m)
    print(len(m))
    print(has(m, key = "a"))
    print(get(m, key = "b") or_else -1)
    mostra(&m)
    insert(&m, key = "novo", value = 1)
    insert(&m, key = "a", value = 2)
    mostra(&m)
    print(get(m, key = "a") or_else -1)
}
