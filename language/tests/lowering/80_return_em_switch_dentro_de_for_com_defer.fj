enum Cor { vermelho, verde }

proc busca(limite: int) -> int {
    for i in 0..<limite {
        switch cor_de(i) {
        case Cor.vermelho:
            continue
        case Cor.verde:
            for j in 0..<3 {
                switch cor_de(j) {
                case Cor.vermelho:
                    defer print(500 + j)
                    if i > 2 {
                        return i * 10 + j
                    }
                case Cor.verde:
                    break
                }
            }
        }
    }
    return -1
}

proc main() {
    print(busca(10))
    print(busca(2))
}

proc cor_de(n: int) -> Cor {
    if n % 2 == 0 {
        return Cor.vermelho
    }
    return Cor.verde
}
