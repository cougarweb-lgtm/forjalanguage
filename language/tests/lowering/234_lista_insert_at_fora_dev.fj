// IA1-L9c: insert_at com i > len = R0006 em dev. Em release o indice nao e checado (a lista tem folga: cap 8), so o que vem antes e impresso.
proc main() {
    var l = make([dynamic]int, alloc = heap, cap = 8)
    defer delete(l)
    append(&l, item = 1)
    append(&l, item = 2)
    append(&l, item = 3)
    var i = 3
    insert_at(&l, i, 9)
    print(len(l))
    print(l[3])
    i = 5
    print(1)
    insert_at(&l, i, 8)
    print(2)
}
