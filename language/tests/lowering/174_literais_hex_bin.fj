const MASCARA: u32 = 0xFF00FF00

proc main() {
    let a = 0xE0E0E0FF
    print(a)
    let b: u8 = 0b10101010
    print(b)
    let c: u64 = 0xFFFFFFFFFFFFFFFF
    print(c)
    let d: i32 = -0x80000000
    print(d)
    print(MASCARA & 0x0F0F0F0F)
    let e: u16 = 0xAbCd
    print(e)
    print(0x10 + 0b11)
}
