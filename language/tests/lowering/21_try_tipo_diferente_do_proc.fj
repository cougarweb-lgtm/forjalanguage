enum Erro { falhou }

proc pegar(n: i32) -> i32 ! Erro {
    if n < 0 {
        return Erro.falhou
    }
    return n
}

proc dobrar(n: i32) -> int ! Erro {
    let v = try pegar(n)
    let w = v as int
    return w * 2
}

proc main() {
    switch r in dobrar(21) {
    case int:
        print(r)
    case Erro:
        print(0)
    }
    switch r in dobrar(-1) {
    case int:
        print(r)
    case Erro:
        print(1)
    }
}
