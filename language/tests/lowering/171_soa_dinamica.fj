struct Ponto {
    x: int = 0
    y: int = 0
}

proc main() {
    var a = make(soa[dynamic]Ponto, alloc = heap)
    defer delete(a)
    for i in 0..<10 {
        append(&a, item = Ponto{x = i, y = i * i})
    }
    print(len(a))
    var s = 0
    for p in a {
        s += p.x
    }
    print(s)
    a[9].y += 19
    print(a[9].y)
    print(a[3].y)
    var b = make(soa[dynamic]Ponto, alloc = frame, cap = 2)
    print(len(b))
    append(&b, item = a[7])
    print(b[0].x)
}
