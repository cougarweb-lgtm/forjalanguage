// L11a-2 (S3 P2): floor ceil round trunc fmod copysign com +-0.5, -2.5, 2^52 +-1, +-0, +-inf e sinal do NaN. round = metade para longe do zero. Saida = bits em hex.
import "std:math" as math

proc de_bits(b: u64) -> f64 {
    return transmute(b, to = f64)
}

proc bits(r: f64) -> u64 {
    return transmute(r, to = u64)
}

proc linha_arredonda(x: f64) {
    print(f"{bits(math.floor(x)):016x} {bits(math.ceil(x)):016x} {bits(math.round(x)):016x} {bits(math.trunc(x)):016x}")
}

proc linha_resto(x: f64, y: f64) {
    print(f"{bits(math.fmod(x, y)):016x} {bits(math.copysign(x, y)):016x}")
}

proc main() {
    linha_arredonda(0.5)
    linha_arredonda(-0.5)
    linha_arredonda(-2.5)
    linha_arredonda(2.5)
    linha_arredonda(1.5)
    linha_arredonda(0.49999999999999994)
    linha_arredonda(-0.0)
    linha_arredonda(0.0)
    linha_arredonda(-0.3)
    linha_arredonda(4503599627370496.0)
    linha_arredonda(4503599627370495.0)
    linha_arredonda(4503599627370497.0)
    linha_arredonda(-4503599627370497.0)
    linha_arredonda(de_bits(0x7FF0000000000000))
    linha_arredonda(de_bits(0xFFF0000000000000))
    linha_arredonda(de_bits(0x7FF8000000000001))
    linha_arredonda(de_bits(0xFFF8000000000001))
    linha_arredonda(de_bits(0x7FE0000000000000))
    linha_resto(7.5, 2.0)
    linha_resto(-7.5, 2.0)
    linha_resto(7.5, -2.0)
    linha_resto(1.0, 0.0)
    linha_resto(de_bits(0x7FF0000000000000), 2.0)
    linha_resto(5.0, de_bits(0x7FF0000000000000))
    linha_resto(-0.0, 1.0)
    linha_resto(0.0, -1.0)
    linha_resto(3.0, de_bits(0x7FF8000000000001))
    linha_resto(1.0, -0.0)
    print(f"{bits(math.copysign(de_bits(0x7FF8000000000001), -1.0)):016x} {bits(math.copysign(de_bits(0xFFF8000000000001), 1.0)):016x}")
    var i = 0
    var x: f64 = -3.75
    while i < 32 {
        linha_arredonda(x)
        linha_resto(x, 0.7)
        x = x + 0.25
        i = i + 1
    }
}
