// IA1-S2d2 (A42): std:path with_ext (troca/poe/tira a extensao do ultimo componente; ext com ou sem ponto; as barras do fim ficam; sem componente ou "." / ".." devolve copia) e has_ext (comparacao exata COM o ponto). Texto DONO do with_ext: cada caso da delete.
import "std:path" as path

proc caso(p: str, ext: str) {
    let novo = path.with_ext(p, ext = ext, alloc = heap)
    defer delete(novo)
    print(f"with_ext [{p}] [{ext}] -> [{novo}] has {path.has_ext(p, ext = ext)} ext [{path.ext(p)}]")
}

proc main() {
    caso("a.txt", ".md")
    caso("a.txt", "md")
    caso("a.txt", "")
    caso("a.txt", ".")
    caso("a", ".md")
    caso("a", "md")
    caso("a", "")
    caso("a.", "md")
    caso("a.tar.gz", ".zip")
    caso("a.tar.gz", "")
    caso("a/b.txt", "bin")
    caso("a/b.txt/", "bin")
    caso("a/b/", "x")
    caso("a//b.c//", "d")
    caso(".bashrc", "bak")
    caso(".bashrc", "")
    caso("a/.bashrc", ".old")
    caso(".a.b", "c")
    caso("a/.b.c", "")
    caso("a.b/c", "d")
    caso("a.b/", "d")
    caso("...", "x")
    caso("..a", "x")
    caso("a..", "x")
    caso("", "x")
    caso("", "")
    caso(".", "x")
    caso("..", "x")
    caso("a/.", "x")
    caso("a/..", "x")
    caso("/", "x")
    caso("///", "x")
    caso("dir/ação.txt", "bin")
    caso("dir/ação", ".txt")
    caso("a b.c d", "e f")
    caso("a\\b.txt", "md")
    caso("a\\b.txt\\", "md")
    caso("a/b\\c.d", "e")
    caso("C:", "x")
    caso("C:a", "x")
    caso("C:a.b", "x")
    caso("C:\\", "x")
    caso("C:\\a.b", "c")
    caso("C:\\a.b\\", "c")
    caso("\\\\srv\\sh", "x")
    caso("\\\\srv\\sh\\a.b", "c")
    caso("\\\\srv\\sh\\", "x")
    caso("a.txt", ".txt")
    caso("a.TXT", ".txt")
    caso("a.txt", "txt")
}
