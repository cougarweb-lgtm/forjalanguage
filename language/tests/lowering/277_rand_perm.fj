// IA1-S2d1 (A20): perm(n) = permutacao aleatoria de 0..<n (Fisher-Yates), lista DONA no heap. perm(0) e a lista vazia valida; perm(1), perm(10) e perm(1000) saem inteiras (semente 5) e
// "valida" prova que cada numero de 0..<n aparece exatamente 1 vez. Depois do perm(1000) o proximo next_u64 prova que o consumo do gerador bate com o do oraculo Python.
import "std:rand" as rand

const TAMANHOS: [4]int = {0, 1, 10, 1000}

// true se a lista tem cada numero de 0..<len(itens) exatamente uma vez.
proc e_permutacao(itens: []int) -> bool {
    var visto = make([dynamic]bool, alloc = heap, cap = len(itens))
    defer delete(visto)
    for _i in 0..<len(itens) {
        append(&visto, item = false)
    }
    for item in itens {
        if item < 0 or item >= len(itens) or visto[item] {
            return false
        }
        visto[item] = true
    }
    return true
}

proc main() {
    var rng = rand.seed(5)
    for n in TAMANHOS {
        var lista = rand.perm(&rng, n = n, alloc = heap)
        defer delete(lista)
        var linha = make([dynamic]u8, alloc = heap)
        defer delete(linha)
        for item in lista {
            format(f"{item} ", into = &linha)
        }
        let texto = to_str(&linha)
        defer delete(texto)
        print(f"perm {n} len {len(lista)} valida {e_permutacao(lista[..])} itens {texto}")
    }
    let proximo = rand.next_u64(&rng)
    print(f"fim proximo {proximo}")
}
