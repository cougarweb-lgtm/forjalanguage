enum Erro { falhou }

proc validar(n: int) -> ! Erro {
    if n < 0 {
        return Erro.falhou
    }
}

proc f(n: int) -> ! Erro {
    for i in 0..<3 {
        defer print(100 + i)
        try validar(n - i)
        print(i)
    }
}

proc main() {
    switch f(1) {
    case Erro:
        print(9)
    default:
        print(8)
    }
}
