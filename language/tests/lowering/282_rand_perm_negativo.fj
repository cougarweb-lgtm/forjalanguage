// IA1-S2d1 (A20): perm(n < 0) e erro de quem chama: panic (R0003). perm(0) antes prova que a lista vazia e valida (e liberada).
import "std:rand" as rand

proc main() {
    var rng = rand.seed(1)
    var vazia = rand.perm(&rng, n = 0, alloc = heap)
    print(len(vazia))
    delete(vazia)
    var errada = rand.perm(&rng, n = -1, alloc = heap)
    print(len(errada))
    delete(errada)
}
