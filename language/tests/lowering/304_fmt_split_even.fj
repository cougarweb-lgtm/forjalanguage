// IA1-S2g (D-FMT): std:fmt, split_even(total, n): n partes que SOMAM EXATAMENTE total; o resto (|total| mod n) vai de 1 em 1 para os primeiros indices; sinal simetrico (-10 dividido por 3 = [-4, -3, -3]).
// Tabela de totais (0, 1, -1, 10, -10, 100, o menor e o maior int...) por n = 1, 2, 3, 7 (lista inteira) e n = 999, 1000 (resumo), mais 3000 sorteios (xorshift64*) com a conferencia da soma, da diferenca maxima de 1 entre partes e da ordem. Oraculo Python independente (scratchpad, sem o forja).
import "std:fmt" as fmt

const MAIOR: int = 9223372036854775807
const MENOR: int = -9223372036854775807 - 1
const MODULO_HASH: int = 1000003
const SEMENTE: u64 = 88172645463325252
const MULTIPLICADOR: u64 = 2685821657736338717
const SORTEIOS: int = 3000
const TOTAIS: [14]int = {0, 1, -1, 10, -10, 100, -100, 7, 1001, -1001, MAIOR, MENOR, MAIOR - 1, MENOR + 1}
const PARTES: [4]int = {1, 2, 3, 7}
const PARTES_GRANDES: [2]int = {999, 1000}

struct Sorteio {
    estado: u64 = 0
}

// xorshift64*: proximo u64 da sequencia.
proc proximo(s: ^Sorteio) -> u64 {
    var x = s.estado
    x = x ~ (x >> 12)
    x = x ~ (x << 25)
    x = x ~ (x >> 27)
    s.estado = x
    return wrapping_mul(x, b = MULTIPLICADOR)
}

// Inteiro de 0 a 63 bits de comprimento sorteado, com sinal sorteado.
proc sorteia_int(s: ^Sorteio) -> int {
    let bruto = proximo(s)
    let largura = proximo(s) % 64
    let valor = (bruto >> largura) >> 1
    let sinal = proximo(s) & 1
    if sinal == 1 {
        return -(valor as int)
    }
    return valor as int
}

// A lista inteira de split_even(total, n) e a soma.
proc mostra(total: int, n: int) {
    var partes = fmt.split_even(total, n, alloc = heap)
    defer delete(partes)
    var buf = make([dynamic]u8, alloc = heap, cap = 128)
    defer delete(buf)
    format(f"{total} / {n}:", into = &buf)
    var soma = 0
    for p in partes {
        format(f" {p}", into = &buf)
        soma += p
    }
    if soma == total {
        append(&buf, item = " soma ok")
    } else {
        append(&buf, item = " SOMA ERRADA")
    }
    let texto = to_str(&buf)
    print(texto)
    delete(texto)
}

// Resumo de uma lista grande: tamanho, 1a, ultima, maior, menor e a soma.
proc resumo(total: int, n: int) {
    var partes = fmt.split_even(total, n, alloc = heap)
    defer delete(partes)
    var soma = 0
    var maior = partes[0]
    var menor = partes[0]
    for p in partes {
        soma += p
        maior = max(maior, p)
        menor = min(menor, p)
    }
    var ok = "soma ok"
    if soma != total {
        ok = "SOMA ERRADA"
    }
    print(f"{total} / {n}: len {len(partes)} primeira {partes[0]} ultima {partes[n - 1]} maior {maior} menor {menor} {ok}")
}

// 3000 sorteios: soma exata, partes diferindo no maximo 1 e em ordem (modulo nao crescente), n de 1 a 50.
proc sorteios() {
    var s = Sorteio{estado = SEMENTE}
    var falhas = 0
    var hash = 0
    for _k in 0..<SORTEIOS {
        let total = sorteia_int(&s)
        let n = (proximo(&s) % 50 + 1) as int
        var partes = fmt.split_even(total, n, alloc = heap)
        var soma = 0
        for i, p in partes {
            soma += p
            hash = (hash * 31 + (p % MODULO_HASH) + MODULO_HASH) % MODULO_HASH
            if i > 0 and abs(partes[i - 1]) < abs(p) {
                falhas += 1
            }
        }
        if soma != total or abs(partes[0] - partes[n - 1]) > 1 {
            falhas += 1
        }
        delete(partes)
    }
    print(f"{SORTEIOS} sorteios: {falhas} falhas, hash {hash}")
}

proc main() {
    for total in TOTAIS {
        for n in PARTES {
            mostra(total, n)
        }
    }
    for total in TOTAIS {
        for n in PARTES_GRANDES {
            resumo(total, n)
        }
    }
    sorteios()
}
