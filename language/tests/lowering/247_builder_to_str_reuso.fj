// IA1-L9f (T11): to_str(&buf) move os bytes para uma str dona (sem copia): o builder fica vazio (len 0, cap 0) e reutilizavel com o mesmo alocador; builder com folga
// (cap 100), builder vazio (nunca recebeu byte: a str sai vazia mas valida e liberavel com delete) e varios to_str em sequencia.
proc main() {
    var buf = make([dynamic]u8, alloc = heap, cap = 100)
    defer delete(buf)
    append(&buf, item = "abc")
    print(len(buf))
    print(cap(buf))
    let a = to_str(&buf)
    print(a)
    print(len(a))
    print(len(buf))
    print(cap(buf))
    append(&buf, item = "segundo texto")
    let b = to_str(&buf)
    print(b)
    print(len(b))
    print(a)
    delete(a)
    delete(b)

    let vazio = to_str(&buf)
    print(len(vazio))
    print(vazio == "")
    delete(vazio)

    var nunca = make([dynamic]u8, alloc = heap)
    defer delete(nunca)
    let v2 = to_str(&nunca)
    print(len(v2))
    print(v2 == "")
    delete(v2)
    append(&nunca, item = "fim")
    let f = to_str(&nunca)
    print(f)
    print(len(f))
    delete(f)

    var bytes = make([dynamic]u8, alloc = heap)
    defer delete(bytes)
    append(&bytes, item = 79)
    append(&bytes, item = 75)
    append(&bytes, items = "!!")
    let g = to_str(&bytes)
    print(g)
    delete(g)
}
