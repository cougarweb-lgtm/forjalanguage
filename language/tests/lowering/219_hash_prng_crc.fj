// IA1-L9a/L9b: usos reais da aritmetica com volta em Forja pura. FNV-1a 64 bits (FNV-1a("hello") = a430d84680aabd0b), PCG32 (semente 42/54: a15c02b7 7b47f409 ba1d3330 ...),
// xorshift64*, CRC-32 bit a bit (CRC-32("123456789") = cbf43926) e MurmurHash3 x86_32 (rotate_left, wrapping_mul, wrapping_add). O esperado vem de um oraculo Python.
const FNV_OFFSET: u64 = 0xcbf29ce484222325
const FNV_PRIMO: u64 = 0x100000001b3
const PCG_MULTIPLICADOR: u64 = 6364136223846793005
const XORSHIFT_MULTIPLICADOR: u64 = 0x2545F4914F6CDD1D
const CRC_POLINOMIO: u32 = 0xEDB88320

struct Pcg {
    estado: u64
    incremento: u64
}

struct XorShift {
    estado: u64
}

proc fnv1a(texto: str) -> u64 {
    var h: u64 = FNV_OFFSET
    for i in 0..<len(texto) {
        h = h ~ (texto[i] as u64)
        h = wrapping_mul(h, b = FNV_PRIMO)
    }
    return h
}

proc pcg_passo(p: ^Pcg) -> u32 {
    let velho = p.estado
    p.estado = wrapping_add(wrapping_mul(velho, b = PCG_MULTIPLICADOR), b = p.incremento)
    let misturado = (((velho >> 18) ~ velho) >> 27) & 0xFFFFFFFF
    let rotacao = (velho >> 59) as u32
    return rotate_right(misturado as u32, n = rotacao)
}

proc pcg_semente(p: ^Pcg, estado_inicial: u64, sequencia: u64) {
    p.estado = 0
    p.incremento = (sequencia << 1) | 1
    let _descartado = pcg_passo(p)
    p.estado = wrapping_add(p.estado, b = estado_inicial)
    let _outro = pcg_passo(p)
}

proc xorshift_estrela(g: ^XorShift) -> u64 {
    var x = g.estado
    x = x ~ (x >> 12)
    x = x ~ (x << 25)
    x = x ~ (x >> 27)
    g.estado = x
    return wrapping_mul(x, b = XORSHIFT_MULTIPLICADOR)
}

proc crc32(texto: str) -> u32 {
    var crc: u32 = 0xFFFFFFFF
    for i in 0..<len(texto) {
        crc = crc ~ (texto[i] as u32)
        for _bit in 0..<8 {
            if (crc & 1) == 1 {
                crc = (crc >> 1) ~ CRC_POLINOMIO
            } else {
                crc = crc >> 1
            }
        }
    }
    return crc ~ 0xFFFFFFFF
}

proc murmur3(texto: str) -> u32 {
    var h: u32 = 0
    let n = len(texto)
    let blocos = n / 4
    for b in 0..<blocos {
        let i = b * 4
        var k: u32 = (texto[i] as u32) | ((texto[i + 1] as u32) << 8) | ((texto[i + 2] as u32) << 16) | ((texto[i + 3] as u32) << 24)
        k = wrapping_mul(k, b = 0xcc9e2d51)
        k = rotate_left(k, n = 15)
        k = wrapping_mul(k, b = 0x1b873593)
        h = h ~ k
        h = rotate_left(h, n = 13)
        h = wrapping_add(wrapping_mul(h, b = 5), b = 0xe6546b64)
    }
    let base = blocos * 4
    let sobra = n - base
    var resto: u32 = 0
    if sobra == 3 {
        resto = resto ~ ((texto[base + 2] as u32) << 16)
    }
    if sobra >= 2 {
        resto = resto ~ ((texto[base + 1] as u32) << 8)
    }
    if sobra >= 1 {
        resto = resto ~ (texto[base] as u32)
        resto = wrapping_mul(resto, b = 0xcc9e2d51)
        resto = rotate_left(resto, n = 15)
        resto = wrapping_mul(resto, b = 0x1b873593)
        h = h ~ resto
    }
    h = h ~ (n as u32)
    h = h ~ (h >> 16)
    h = wrapping_mul(h, b = 0x85ebca6b)
    h = h ~ (h >> 13)
    h = wrapping_mul(h, b = 0xc2b2ae35)
    return h ~ (h >> 16)
}

proc mostra_fnv(texto: str) {
    print(f"fnv1a \"{texto}\" = {fnv1a(texto):016x}")
}

proc mostra_crc(texto: str) {
    let c = crc32(texto)
    print(f"crc32 \"{texto}\" = {c:08x} bswap={byte_swap(c):08x}")
}

proc mostra_murmur(texto: str) {
    print(f"murmur3 \"{texto}\" = {murmur3(texto):08x}")
}

proc main() {
    mostra_fnv("")
    mostra_fnv("a")
    mostra_fnv("abc")
    mostra_fnv("hello")
    mostra_fnv("The quick brown fox jumps over the lazy dog")

    var pcg = Pcg{estado = 0, incremento = 0}
    pcg_semente(&pcg, 42, 54)
    let p1 = pcg_passo(&pcg)
    let p2 = pcg_passo(&pcg)
    let p3 = pcg_passo(&pcg)
    let p4 = pcg_passo(&pcg)
    let p5 = pcg_passo(&pcg)
    let p6 = pcg_passo(&pcg)
    print(f"pcg32 {p1:08x} {p2:08x} {p3:08x} {p4:08x} {p5:08x} {p6:08x}")

    var xs = XorShift{estado = 88172645463325252}
    let x1 = xorshift_estrela(&xs)
    let x2 = xorshift_estrela(&xs)
    let x3 = xorshift_estrela(&xs)
    let x4 = xorshift_estrela(&xs)
    print(f"xorshift64* {x1:016x} {x2:016x} {x3:016x} {x4:016x}")

    mostra_crc("123456789")
    mostra_crc("hello")

    mostra_murmur("")
    mostra_murmur("a")
    mostra_murmur("abc")
    mostra_murmur("hello")
    mostra_murmur("The quick brown fox jumps over the lazy dog")
}
