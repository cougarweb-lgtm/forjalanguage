import "mods/cores"

pub const LADO: int = 3

pub struct Ponto2 {
    x: int = 0
    y: int = 0
}

pub proc area(lado: int) -> int {
    return lado * lado
}

pub proc soma(p: Ponto2) -> int {
    return p.x + p.y + interno()
}

proc interno() -> int {
    return 10
}

pub proc cor_padrao() -> cores.Cor {
    return cores.Cor.azul
}

test "teste do modulo nao entra no build" {
    expect(area(2) == 4)
}
