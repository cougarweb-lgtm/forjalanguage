// S2b (fixture 354): modulo que recebe o Rng como parametro ^rand.Rng e sorteia nele (shuffle e choice). O mod chama so o embutido; o gerador vem da raiz.
import "std:rand" as rand

pub proc embaralha(s: []int, rng: ^rand.Rng) {
    shuffle(s, rng = rng)
}

pub proc sorteado(s: []int, rng: ^rand.Rng) -> ?int {
    return choice(s, rng = rng)
}
