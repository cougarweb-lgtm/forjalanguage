    caso("/a/b/../c", "/a/d")
    caso("/a/..", "/b")
    caso("/..", "/a")
    caso("/a", "b")
    caso("a", "/b")
    caso("/", ".")
    caso(".", "/")
    caso("a b/c", "a b/d e")
    caso("dir/ação", "dir/é/x")
    caso("A/b", "a/b")
