// IA1-S2d2 (A42): std:path rel(base, target) lexico (Go filepath.Rel). Os dois lados sao limpos antes; "." se iguais; "" (vazio) quando nao existe caminho: um absoluto e outro relativo, volumes diferentes (Windows), base com ".." que sobra. Sem dobrar caixa. Texto DONO: cada caso da delete.
import "std:path" as path

proc caso(base: str, target: str) {
    let r = path.rel(base, target = target, alloc = heap)
    defer delete(r)
    print(f"rel [{base}] [{target}] -> [{r}] len {len(r)}")
}

proc main() {
    caso("a", "a")
    caso("a/b", "a/b")
    caso("a/b", "a/b/")
    caso("a//b", "a/./b")
    caso("a", "a/b")
