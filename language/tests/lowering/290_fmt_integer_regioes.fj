// IA1-S2e (D-FMT): std:fmt, integer (forma dona e write_integer) nas 9 regioes: 0, 999, 1000, 1234, 12345 (es-ES e pt-PT: "1234" mas "12.345"), negativos e os extremos do int (menor e maior int, sem estouro).
// Colunas: pt-BR, en-US, en-GB, es-ES, fr-FR, de-DE, it-IT, pt-PT, ISO. Cada linha de caso e conferida contra o oraculo Python independente (scratchpad).
import "std:fmt" as fmt

proc caso(v: int) {
    var buf = make([dynamic]u8, alloc = heap, cap = 128)
    defer delete(buf)
    format(f"{v}", into = &buf)
    for i in 0..<9 {
        append(&buf, item = "|")
        if i % 2 == 0 {
            fmt.write_integer(v, buf = &buf, loc = fmt.LOCALES[i])
        } else {
            let texto = fmt.integer(v, loc = fmt.LOCALES[i], alloc = heap)
            append(&buf, item = texto)
            delete(texto)
        }
    }
    let linha = to_str(&buf)
    defer delete(linha)
    print(linha)
}

proc main() {
    caso(0)
    caso(1)
    caso(12)
    caso(123)
    caso(999)
    caso(1000)
    caso(1234)
    caso(9999)
    caso(12345)
    caso(99999)
    caso(100000)
    caso(123456)
    caso(1234567)
    caso(1000000)
    caso(-1)
    caso(-999)
    caso(-1000)
    caso(-1234)
    caso(-12345)
    caso(-1234567)
    caso(1000000000000)
    caso(9223372036854775807)
    caso(9223372036854775806)
    caso(-9223372036854775807)
    caso(-9223372036854775807 - 1)
    caso(-9223372036854775807 - 1 + 1000)
}
