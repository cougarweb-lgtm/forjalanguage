import "std:mem"

proc main() {
    let a = mem.arena_create(64)
    var l = make([dynamic]int, alloc = a)
    for i in 0..<20 {
        append(&l, item = i * 2)
    }
    print(len(l))
    print(l[19])
    let s = format(f"soma={l[1] + l[2]}", alloc = a)
    print(s)
    delete(l)
    print(len(l))
    mem.arena_destroy(a)
}
