// IA1-L9c: unordered_remove com i >= len = R0006 em dev (em release a lista tem folga: cap 8 e so o que vem antes e impresso).
proc main() {
    var l = make([dynamic]int, alloc = heap, cap = 8)
    defer delete(l)
    append(&l, item = 1)
    append(&l, item = 2)
    append(&l, item = 3)
    var i = 0
    unordered_remove(&l, i)
    print(l[0])
    i = 3
    print(1)
    unordered_remove(&l, i)
    print(2)
}
