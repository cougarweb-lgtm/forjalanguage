// K15 (set_union): cada chave de b entra em a (presenca = membro). a = {1, 2}, b = {2, 3}: a vira {1, 2, 3}.
proc main() {
    var a = make(map[int]bool, alloc = heap)
    var b = make(map[int]bool, alloc = heap)
    insert(&a, key = 1, value = true)
    insert(&a, key = 2, value = true)
    insert(&b, key = 2, value = true)
    insert(&b, key = 3, value = true)
    set_union(&a, b)
    print(len(a))
    print(has(a, key = 1))
    print(has(a, key = 3))
    print(has(a, key = 4))
    delete(a)
    delete(b)
}
