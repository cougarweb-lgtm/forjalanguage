// IA1-S2d1 (A20): below(n) uniforme em [0, n) sem vies (Lemire: produto de 128 bits com mul_hi_u64 + rejeicao por limiar). n = 1, 2, 3, 7, 1000, 2^32+1, 2^63+1 e 2^64-1;
// nos dois ultimos ha rejeicao de verdade (cerca de 1 em 4 sorteios), entao o consumo de next_u64 muda: depois dos 100 sorteios cada linha "fim" imprime o proximo next_u64, que so bate se o consumo for igual.
// A coluna "dentro" prova v < n. O esperado vem de um oraculo Python com inteiros de 128 bits.
import "std:rand" as rand

const LIMITES: [8]u64 = {1, 2, 3, 7, 1000, 4294967297, 9223372036854775809, 18446744073709551615}
const SORTEIOS: int = 100

proc main() {
    for n in LIMITES {
        var rng = rand.seed(2024)
        var soma: u64 = 0
        for i in 0..<SORTEIOS {
            let v = rand.below(&rng, n = n)
            soma = wrapping_add(soma, b = v)
            print(f"below {n} {i} {v} {v < n}")
        }
        let proximo = rand.next_u64(&rng)
        print(f"fim {n} soma {soma} proximo {proximo}")
    }
}
