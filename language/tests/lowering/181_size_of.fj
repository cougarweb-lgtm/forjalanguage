// v1.11 L9 (A12): size_of, align_of e offset_of viram literal int no lowering; os valores sao os do C que o emit_c escreve (--prova-layout os confere).
unit Metros: f32

struct Vertice {
    x: f32
    y: f32
    uv: f32
}

struct Folga {
    a: i8
    b: i32
    c: i8
}

struct Mistura {
    flag: bool
    peso: f64
    nome: str
}

const TAM_FOLGA: int = size_of(Folga)

static_assert(size_of(Vertice) == 12, msg = "Vertice tem 12 bytes")

proc main() {
    static_assert(offset_of(Mistura.nome) == 16)
    print(size_of(i8))
    print(size_of(i32))
    print(size_of(int))
    print(size_of(f64))
    print(size_of(bool))
    print(size_of(str))
    print(size_of(^Vertice))
    print(size_of([]Vertice))
    print(size_of([3]f32))
    print(size_of(Metros))
    print(size_of(Folga))
    print(align_of(Folga))
    print(align_of(Mistura))
    print(offset_of(Folga.a))
    print(offset_of(Folga.b))
    print(offset_of(Folga.c))
    print(offset_of(Mistura.peso))
    print(offset_of(Mistura.nome))
    print(size_of(Mistura))
    print(TAM_FOLGA + size_of(Vertice))
    let tam: int = size_of([4]Folga)
    print(tam)
    let v = Vertice{x = 1, y = 2, uv = 3}
    let f = Folga{a = 1, b = 2, c = 3}
    let m = Mistura{flag = true, peso = 1.5, nome = "m"}
    var tri: [3]f32 = {1, 2, 3}
    let fatia = tri[..]
    print(v.uv as int)
    print(f.b)
    print(f.c)
    print(m.peso as int)
    print(fatia[1] as int)
    print(m.nome)
}
