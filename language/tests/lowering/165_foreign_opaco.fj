foreign {
    link "kernel32"
    opaque Heap
    proc GetProcessHeap() -> ?^Heap
    proc HeapAlloc(heap: ?^Heap, flags: u32, bytes: u64) -> rawptr
    proc HeapFree(heap: ?^Heap, flags: u32, bloco: rawptr) -> i32
}

proc main() {
    let h = GetProcessHeap()
    let bloco = HeapAlloc(h, flags = 8, bytes = 16)
    let p = bloco as ^i32
    p^ = 42
    print(p^)
    print(HeapFree(h, flags = 0, bloco = bloco) != 0)
}
