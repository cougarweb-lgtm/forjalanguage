// IA1-S2d1 (A20): float_range(min, max) em [min, max): min + next_float * (max - min), impresso pelos BITS do f64 (exato). 6 intervalos x 50 sorteios de um gerador novo (semente 31);
// "dentro" prova min <= v < max. O esperado vem de um oraculo Python (mesmas contas em IEEE 754 binary64).
import "std:rand" as rand

const MINIMOS: [6]f64 = {0.0, -1.0, 1.5, -1000000.0, 0.0, -0.5}
const MAXIMOS: [6]f64 = {1.0, 1.0, 2.5, 1000000.0, 0.000001, -0.25}
const SORTEIOS: int = 50

proc main() {
    for k in 0..<6 {
        let menor = MINIMOS[k]
        let maior = MAXIMOS[k]
        var rng = rand.seed(31)
        for i in 0..<SORTEIOS {
            let v = rand.float_range(&rng, min = menor, max = maior)
            let bits = transmute(v, to = u64)
            print(f"frange {k} {i} {bits} {v >= menor and v < maior}")
        }
        let proximo = rand.next_u64(&rng)
        print(f"fim {k} proximo {proximo}")
    }
}
