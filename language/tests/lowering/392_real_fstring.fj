// Ryu d2fixed P2: f"{x}", format() e {x:?} de real sem precisao = Display curto (igual ao print): posicional, mais curto que volta ao mesmo valor.
// Mesmo texto no x64, no backend C e no ELF. Com precisao ({x:.N}) segue o caminho antigo (P4).
proc f64_de(b: u64) -> f64 {
    return transmute(b, to = f64)
}

proc f32_de(b: u32) -> f32 {
    return transmute(b, to = f32)
}

struct Ponto {
    x: f64
    y: f32
}

proc mostra64(x: f64) {
    print(f"[{x}]")
}

proc main() {
    mostra64(0.1)
    mostra64(0.5)
    mostra64(3.0)
    mostra64(-0.0)
    mostra64(-2.5)
    mostra64(0.1 + 0.2)
    mostra64(2.0 / 3.0)
    mostra64(1000000000000000.0)
    mostra64(100000000000000000000000.0)
    mostra64(0.00001)
    print(f"[{f64_de(1)}]")
    print(f"[{f64_de(0x7FEFFFFFFFFFFFFF)}]")
    print(f"[{f64_de(0x7FF8000000000000)}]")
    print(f"[{f64_de(0x7FF0000000000000)}]")
    print(f"[{f64_de(0xFFF0000000000000)}]")
    let a: f32 = 0.1
    let b: f32 = 3.0
    let c: f32 = 1.0 / 3.0
    print(f"[{a}] [{b}] [{c}]")
    print(f"[{f32_de(0x7F7FFFFF)}] [{f32_de(1)}]")
    let r: f64 = 2.5
    print(f"larg [{r:8}] zero [{r:08}]")
    let p = Ponto{x = 0.1, y = 0.1}
    print(f"{p:?}")
    let t = format(f"{r}", alloc = heap)
    defer delete(t)
    print(t)
}
