// K09 (any_by): para no 1o verdadeiro. O pred imprime cada chave visitada: so 1 e 3 sao visitados (3 satisfaz), o 5 nao.
struct Item {
    chave: int
}

proc ate_tres(a: ^Item) -> bool {
    print(a.chave)
    return a.chave == 3
}

proc main() {
    var l = make([dynamic]Item, alloc = heap)
    append(&l, item = Item{chave = 1})
    append(&l, item = Item{chave = 3})
    append(&l, item = Item{chave = 5})
    print(any_by(l[..], pred = ate_tres))
    delete(l)
}
