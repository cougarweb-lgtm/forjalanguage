// IA1-S2g (D-FMT): allocate com a soma dos pesos fora do int (2^63 - 1 + 1) e erro de quem chama: panic (R0003). A soma exatamente igual ao maior int ainda vale.
import "std:fmt" as fmt

proc main() {
    var bom: [2]int = {9223372036854775806, 1}
    var ok = fmt.allocate(10, bom[..], alloc = heap)
    print(ok[0])
    delete(ok)
    var pesos: [2]int = {9223372036854775807, 1}
    var ruim = fmt.allocate(10, pesos[..], alloc = heap)
    print(len(ruim))
    delete(ruim)
    print("nao chega")
}
