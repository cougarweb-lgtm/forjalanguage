// IA1-L9f (T11): builder grande (> 1 MiB): 150000 pedacos de 7 bytes por format(into =), alternados com append de str; cresce por dobra ate passar de 2 MiB de capacidade.
proc main() {
    var buf = make([dynamic]u8, alloc = heap)
    defer delete(buf)
    for i in 0..<150000 {
        format(f"{i:06};", into = &buf)
    }
    print(len(buf))
    print(len(buf) > 1048576)
    for i in 0..<1000 {
        append(&buf, item = "ab")
    }
    let s = to_str(&buf)
    print(len(s))
    print(s[0..<14])
    print(s[len(s) - 14..<len(s)])
    var soma = 0
    var pontos = 0
    for i in 0..<len(s) {
        soma += s[i] as int
        if s[i] == 59 {
            pontos += 1
        }
    }
    print(soma)
    print(pontos)
    print(len(buf))
    delete(s)
}
