// IA1-S2c (T14): std:text str_reverse inverte por RUNA (nao por byte): os bytes de cada runa ficam na ordem certa. Byte invalido e uma unidade de 1 byte que fica como esta (os bytes originais
// sao preservados, nao viram U+FFFD). Texto vazio da vazio. Cada linha: bytes em hexa | invertido em hexa | validez de antes e depois | reverse(reverse(s)) == s.
import "std:text" as tx

const CASOS: [24]str = {
    "", "41", "41 42", "41 42 43", "c3 a7", "61 c3 a7 c3 a3 6f", "f0 9f 98 80", "41 f0 9f 98 80 42", "e2 82 ac 31 30", "63 6f 72 61 c3 a7 c3 a3 6f",
    "80", "c3", "41 80 42", "41 c3", "c3 41", "e2 82", "f0 9f 98 41", "ff fe 41", "e0 80 80 41", "ed a0 80", "c3 a9 80 c3 a9", "80 c3 a9", "c3 a9 c3", "f4 90 80 80"
}

// "c3 a9" -> texto dono com esses bytes.
proc bytes_de(hex: str) -> str {
    var partes = tx.fields(hex, alloc = heap)
    defer delete(partes)
    var lista = make([dynamic]u8, alloc = heap)
    defer delete(lista)
    for parte in partes {
        let valor = tx.parse_uint_base(parte, base = 16) or_else 0
        append(&lista, item = valor as u8)
    }
    return from_bytes(lista[..], alloc = heap)
}

// Bytes de s em hexa, separados por espaco.
proc hex_de(s: str) -> str {
    var saida = make([dynamic]u8, alloc = heap)
    defer delete(saida)
    for i in 0..<len(s) {
        if i > 0 {
            append(&saida, item = " ")
        }
        format(f"{s[i]:02x}", into = &saida)
    }
    return to_str(&saida)
}

proc main() {
    for hex in CASOS {
        let s = bytes_de(hex)
        defer delete(s)
        let invertido = tx.str_reverse(s, alloc = heap)
        defer delete(invertido)
        let de_volta = tx.str_reverse(invertido, alloc = heap)
        defer delete(de_volta)
        let hex_invertido = hex_de(invertido)
        defer delete(hex_invertido)
        print(f"{hex} | {hex_invertido} | {tx.valid_utf8(s)} {tx.valid_utf8(invertido)} | {de_volta == s}")
    }
    let a = tx.str_reverse("coração 😀 ñ", alloc = heap)
    defer delete(a)
    let b = tx.str_reverse(a, alloc = heap)
    defer delete(b)
    print(a)
    print(b)
}
