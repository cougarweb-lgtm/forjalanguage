// Ryu d2fixed P1: print de real = Display (o texto mais curto que volta ao mesmo valor, SEMPRE posicional, sem expoente, sem ".0" sobrando). Mesmo texto no x64, no backend C e no ELF.
// Real puro e f32: os f64 passam por p64 (parametro f64 tipa o literal).
proc f64_de(b: u64) -> f64 {
    return transmute(b, to = f64)
}

proc f32_de(b: u32) -> f32 {
    return transmute(b, to = f32)
}

proc p64(x: f64) {
    print(x)
}

proc main() {
    // f64 comuns
    p64(0.5)
    p64(3.0)
    p64(1.5)
    p64(-2.5)
    p64(0.1)
    p64(0.1 + 0.2)
    p64(100.0)
    p64(0.0001)
    p64(0.00001)
    p64(0.000001)
    p64(123456.789)
    p64(4.35)
    p64(2.0 / 3.0)
    p64(0.0)
    p64(-0.0)
    // fronteira da regra antiga [-4, 16): agora tudo posicional
    p64(123456789012345.0)
    p64(1000000000000000.0)
    p64(10000000000000000.0)
    p64(1000000000000000000000.0)
    p64(100000000000000000000000.0)
    p64(9007199254740992.0)
    p64(9007199254740993.0)
    // extremos de f64 por bits
    print(f64_de(0x7E37E43C8800759C))
    print(f64_de(0x7FEFFFFFFFFFFFFF))
    print(f64_de(0x0010000000000000))
    print(f64_de(0x000FFFFFFFFFFFFF))
    print(f64_de(1))
    print(-f64_de(1))
    // f32
    print(f32_de(0x7F7FFFFF))
    print(f32_de(1))
    print(f32_de(0x00800000))
    let a: f32 = 0.1
    print(a)
    let b: f32 = 16777216.0
    print(b)
    let c: f32 = 1.0 / 3.0
    print(c)
    let d: f32 = 0.1 + 0.2
    print(d)
    let e: f32 = 123456.79
    print(e)
    // nao finitos
    let zero: f64 = 0.0
    print(zero / zero)
    print(1.0 / zero)
    print(-1.0 / zero)
    let zero32: f32 = 0.0
    print(1.0 / zero32)
}
