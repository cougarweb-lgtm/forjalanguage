proc main() {
    var l = make([dynamic]int, alloc = heap, cap = 2)
    append(&l, item = 10)
    append(&l, item = 20)
    append(&l, item = 30)
    print(len(l))
    print(l[2])
    l[0] = 11
    l[1] += 1
    print(l[0] + l[1])
    var soma = 0
    for x in l {
        soma += x
    }
    print(soma)
    for &x in l {
        x^ = x^ * 2
    }
    print(l[2])
    for i, x in l {
        if i == 1 {
            continue
        }
        print(x)
    }
    let s = l[1..<3]
    print(len(s))
    print(s[0])
    let t = l[..]
    print(len(t))
    delete(l)
    print(len(l))
    append(&l, item = 5)
    print(l[0])
    delete(l)
}
