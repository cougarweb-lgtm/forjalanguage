// IA1-S2d2 (A42): std:path, as fatias que nao alocam: is_abs, base, dir, ext, stem e split (vistas do texto original; base de "" e de "///" e o dir sem pasta sao literais). Alvo Windows: '/' e '\' separam, `X:` e UNC sao volume.
// Cada linha de caso e conferida contra o oraculo Python independente (scratchpad), que nao usa o forja.
import "std:path" as path

proc caso(p: str) {
    let dir_part, file_part = path.split(p)
    print(f"[{p}] abs {path.is_abs(p)} base [{path.base(p)}] dir [{path.dir(p)}] ext [{path.ext(p)}] stem [{path.stem(p)}] split [{dir_part}] [{file_part}]")
}

