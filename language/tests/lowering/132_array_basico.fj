proc main() {
    var a: [4]int = {10, 20, 30, 40}
    print(a[0])
    a[1] = 25
    a[2] += 5
    print(a[1] + a[2])
    print(len(a))
    let z: [3]i32 = {}
    print(z[2])
    var m: [2][3]int = {{1, 2, 3}, {4, 5, 6}}
    m[1][2] = 60
    print(m[1][2] + m[0][0])
    let i = 3
    print(a[i])
    let b: [2]u8 = {255, 7}
    print(b[0])
}
