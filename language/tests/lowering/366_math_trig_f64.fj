// L11a-2 (S3 P2): sin cos tan asin acos atan atan2 da libm do musl com +-0, +-inf, NaN, subnormais, +-1, perto de k*pi/2 e grade de 64 pontos. Saida = bits em hex (igualdade de bits, NaN incluido).
import "std:math" as math

proc de_bits(b: u64) -> f64 {
    return transmute(b, to = f64)
}

proc bits(r: f64) -> u64 {
    return transmute(r, to = u64)
}

proc linha_trig(x: f64) {
    print(f"{bits(math.sin(x)):016x} {bits(math.cos(x)):016x} {bits(math.tan(x)):016x} {bits(math.asin(x)):016x} {bits(math.acos(x)):016x} {bits(math.atan(x)):016x}")
}

proc linha_atan2(y: f64, x: f64) {
    print(f"{bits(math.atan2(y, x)):016x}")
}

proc main() {
    linha_trig(de_bits(0x0000000000000000))
    linha_trig(de_bits(0x8000000000000000))
    linha_trig(de_bits(0x7FF0000000000000))
    linha_trig(de_bits(0xFFF0000000000000))
    linha_trig(de_bits(0x7FF8000000000001))
    linha_trig(de_bits(0x0000000000000001))
    linha_trig(de_bits(0x000FFFFFFFFFFFFF))
    linha_trig(1.0)
    linha_trig(-1.0)
    linha_trig(1.5707963267948966)
    linha_trig(3.141592653589793)
    linha_trig(4.71238898038469)
    linha_trig(6.283185307179586)
    linha_atan2(0.0, 1.0)
    linha_atan2(de_bits(0x8000000000000000), -1.0)
    linha_atan2(1.0, de_bits(0x7FF0000000000000))
    linha_atan2(de_bits(0xFFF0000000000000), de_bits(0xFFF0000000000000))
    linha_atan2(de_bits(0x7FF8000000000001), 1.0)
    var i = 0
    var x: f64 = -4.0
    while i < 64 {
        linha_trig(x)
        linha_atan2(x, 0.5)
        x = x + 0.125
        i = i + 1
    }
}
