// IA1-S2e (D-FMT): number com decimals fora de 0..15 e erro de quem chama: panic (R0003). 15 casas ainda vale; 16 e 0 - 1 nao.
import "std:fmt" as fmt

proc main() {
    let ok = fmt.number(0.5, loc = fmt.ISO, decimals = 15, alloc = heap)
    print(ok)
    delete(ok)
    let ruim = fmt.number(0.5, loc = fmt.ISO, decimals = 16, alloc = heap)
    print(ruim)
    delete(ruim)
    print("nao chega")
}
