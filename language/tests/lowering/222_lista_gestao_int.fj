// IA1-L9c: cap, clear, reserve, truncate, pop, insert_at, ordered_remove, unordered_remove e remove_value em lista de int (bordas 0 e len, vazia, 1 elemento).
proc dump(s: []int) {
    print(len(s))
    for x in s {
        print(x)
    }
}

proc main() {
    var l = make([dynamic]int, alloc = heap, cap = 2)
    print(cap(l))
    print(len(l))
    reserve(&l, 10)
    print(cap(l) >= 10)
    print(len(l))
    reserve(&l, 4)
    print(cap(l) >= 10)
    append(&l, item = 1)
    append(&l, item = 2)
    append(&l, item = 3)
    append(&l, item = 4)
    append(&l, item = 5)
    dump(l[..])
    insert_at(&l, 0, 9)
    insert_at(&l, 6, 8)
    insert_at(&l, 3, 7)
    dump(l[..])
    ordered_remove(&l, 0)
    ordered_remove(&l, 6)
    ordered_remove(&l, 2)
    dump(l[..])
    unordered_remove(&l, 0)
    unordered_remove(&l, 3)
    dump(l[..])
    print(remove_value(&l, 3))
    print(remove_value(&l, 3))
    append(&l, item = 5)
    append(&l, item = 5)
    print(remove_value(&l, 5))
    dump(l[..])
    truncate(&l, 2)
    dump(l[..])
    truncate(&l, 2)
    dump(l[..])
    truncate(&l, 0)
    dump(l[..])
    print(pop(&l) or_else -1)
    append(&l, item = 40)
    append(&l, item = 50)
    print(pop(&l) or_else -1)
    print(pop(&l) or_else -1)
    print(pop(&l) or_else -1)
    print(len(l))
    append(&l, item = 3)
    append(&l, item = 4)
    append(&l, item = 5)
    clear(&l)
    print(len(l))
    print(cap(l) >= 10)
    append(&l, item = 7)
    print(remove_value(&l, 7))
    print(len(l))
    insert_at(&l, 0, 1)
    dump(l[..])
    ordered_remove(&l, 0)
    print(len(l))
    append(&l, item = 6)
    unordered_remove(&l, 0)
    print(len(l))
    delete(l)
}
