// IA1-S2b2b (T15): parse_int_base com base fora de 0 e 2..36 e erro de quem chama: panic (R0003) com mensagem, nunca ParseError. O print antes prova que as bases validas (2, 36 e 0) rodaram; a base 37 para o programa.
import "std:text" as tx

proc main() {
    print(tx.parse_int_base("11", base = 2) or_else -1)
    print(tx.parse_int_base("zz", base = 36) or_else -1)
    print(tx.parse_int_base("0x10", base = 0) or_else -1)
    print(tx.parse_int_base("1", base = 37) or_else -1)
    print("nao chega")
}
