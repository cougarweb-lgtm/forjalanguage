enum Erro { falhou }

proc achar(n: i32) -> int ! Erro {
    if n == 0 {
        return Erro.falhou
    }
    return 30
}

proc main() {
    switch achar(3) {
    case int:
        print(1)
    default:
        print(2)
    }
    switch achar(0) {
    case int:
        print(1)
    default:
        print(2)
    }
}
