// IA1-S2d1 (A20): float_range com min >= max e erro de quem chama: panic (R0003). O fim e aberto, entao min == max nao tem valor possivel.
import "std:rand" as rand

proc main() {
    var rng = rand.seed(1)
    print(rand.float_range(&rng, min = 1.0, max = 2.0) < 2.0)
    print(rand.float_range(&rng, min = 1.0, max = 1.0) < 2.0)
    print("nao chega")
}
