// S2b (shuffle): array, fatia e lista de str com a mesma semente dao a mesma ordem que a lista de inteiros 0..<5 (o oraculo: as tres colecoes andam pelo mesmo laco).
import "std:rand" as rand

const NOMES: [5]str = {"zero", "um", "dois", "tres", "quatro"}

proc main() {
    var ordem = make([dynamic]int, alloc = heap)
    defer delete(ordem)
    var texto = make([dynamic]str, alloc = heap)
    defer delete(texto)
    for i in 0..<5 {
        append(&ordem, item = i)
        append(&texto, item = NOMES[i])
    }
    var a = rand.seed(9)
    shuffle(ordem, rng = &a)
    var b = rand.seed(9)
    shuffle(texto, rng = &b)
    var igual_str = true
    for k in 0..<5 {
        igual_str = igual_str and texto[k] == NOMES[ordem[k]]
    }
    print(igual_str)

    var arr: [5]int = {0, 1, 2, 3, 4}
    var c = rand.seed(9)
    shuffle(arr, rng = &c)
    var igual_arr = true
    for k in 0..<5 {
        igual_arr = igual_arr and arr[k] == ordem[k]
    }
    print(igual_arr)

    var fat: [5]int = {0, 1, 2, 3, 4}
    var d = rand.seed(9)
    shuffle(fat[..], rng = &d)
    var igual_fatia = true
    for k in 0..<5 {
        igual_fatia = igual_fatia and fat[k] == ordem[k]
    }
    print(igual_fatia)
}
