// IA1-L9d: index_of, last_index_of, contains e count em lista, array e fatia de str, comparando por conteudo (e nao por endereco).
proc main() {
    let base = "alfa beta alfa"
    var l = make([dynamic]str, alloc = heap, cap = 4)
    print(index_of(l, "alfa") or_else -1)
    print(contains(l, ""))
    append(&l, item = base[0..<4])
    append(&l, item = "beta")
    append(&l, item = base[10..<14])
    append(&l, item = "gama")
    print(index_of(l, "alfa") or_else -1)
    print(last_index_of(l, "alfa") or_else -1)
    print(count(l, "alfa"))
    print(contains(l, "gama"))
    print(contains(l, "alf"))
    print(contains(l, "alfas"))
    print(index_of(l, base[5..<9]) or_else -1)
    print(index_of(l, "ALFA") or_else -1)
    append(&l, item = "")
    print(index_of(l, "") or_else -1)
    print(count(l, base[0..<0]))
    let a: [3]str = {"x", "yy", "x"}
    print(last_index_of(a, "x") or_else -1)
    print(count(a, "x"))
    print(contains(a, "y"))
    let s = l[1..<4]
    print(index_of(s, "gama") or_else -1)
    print(count(s, "alfa"))
    delete(l)
}
