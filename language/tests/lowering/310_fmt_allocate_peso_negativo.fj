// IA1-S2g (D-FMT): allocate com peso negativo e erro de quem chama: panic (R0003). Pesos {1, 0} ainda valem.
import "std:fmt" as fmt

proc main() {
    var bom: [2]int = {1, 0}
    var ok = fmt.allocate(10, bom[..], alloc = heap)
    print(ok[0])
    delete(ok)
    var pesos: [3]int = {2, -1, 3}
    var ruim = fmt.allocate(10, pesos[..], alloc = heap)
    print(len(ruim))
    delete(ruim)
    print("nao chega")
}
