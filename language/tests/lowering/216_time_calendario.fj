// L-07 (IA1-LT): std:time e std:os wall_time_ns. Calendario UTC exato (epoca, bissextos 2000/1900/2100, antes de 1970), ida e volta de nanossegundos, ISO 8601 (format/parse, erros), add_days/add_seconds, Stopwatch e hora de parede dentro de uma faixa sensata; o mesmo programa vale nos 2 backends e nos 2 sistemas.
import "std:os" as sys
import "std:time" as time

const NS: int = 1000000000
const SEGUNDOS: [32]int = {0, 1, -1, 86399, 86400, -86400, 951782399, 951782400, 951868800, 946684799, 946684800, 978307200, 1234567890, 1262303999, 1262304000, 1356998399, 1582934400, 1583020800, 1700000000, 1735689599, 1735689600, 2000000000, 3000000000, 4107542399, 4107542400, -2208988800, -1000000000, -5000000000, -9000000000, 9223372035, -9223372036, 1393632000}

proc mostra(ns: int) {
    let dt = time.from_unix_ns(ns)
    let texto = time.format_iso(dt, alloc = heap)
    defer delete(texto)
    let dia_semana = time.weekday(dt)
    let dia_ano = time.day_of_year(dt)
    print(f"{ns} -> {texto} semana={dia_semana} ano={dia_ano}")
}

proc ida_e_volta(ns: int) -> bool {
    let dt = time.from_unix_ns(ns)
    var igual = false
    switch r in time.to_unix_ns(dt) {
    case int:
        igual = r == ns
    case time.TimeError:
        igual = false
    }
    return igual
}

proc nome_do_erro(e: time.TimeError) -> str {
    var nome = "fora_da_faixa"
    switch e {
    case time.TimeError.invalid_field:
        nome = "campo_invalido"
    case time.TimeError.invalid_text:
        nome = "texto_invalido"
    case time.TimeError.out_of_range:
        nome = "fora_da_faixa"
    }
    return nome
}

proc converte(dt: time.DateTime) {
    switch r in time.to_unix_ns(dt) {
    case int:
        print(f"to_unix_ns = {r}")
    case time.TimeError:
        print(nome_do_erro(r))
    }
}

proc le(s: str) {
    switch r in time.parse_iso(s) {
    case time.DateTime:
        let texto = time.format_iso(r, alloc = heap)
        defer delete(texto)
        print(f"ok {texto}")
    case time.TimeError:
        print(f"erro {nome_do_erro(r)} em [{s}]")
    }
}

proc mostra_data(dt: time.DateTime) {
    let texto = time.format_iso(dt, alloc = heap)
    defer delete(texto)
    print(texto)
}

proc conta_ida_e_volta() {
    var total = 0
    var certos = 0
    for s in SEGUNDOS {
        total += 2
        if ida_e_volta(s * NS) {
            certos += 1
        }
        if ida_e_volta(s * NS + 999999999) {
            certos += 1
        }
    }
    print(f"ida e volta {certos}/{total}")
    print(ida_e_volta(-9223372036854775807 - 1))
    print(ida_e_volta(9223372036854775807))
    print(ida_e_volta(-1))
}

proc calendario() {
    mostra(0)
    mostra(1700000000 * NS)
    mostra(-1 * NS)
    mostra(-1)
    mostra(951782400 * NS)
    mostra(4107542400 * NS)
    mostra(951782399 * NS + 123000000)
    mostra(1234567890 * NS + 456000)
    mostra(-2208988800 * NS)
    mostra(-9223372036854775807 - 1)
    mostra(9223372036854775807)
    print(time.is_leap_year(2000))
    print(time.is_leap_year(1900))
    print(time.is_leap_year(2100))
    print(time.is_leap_year(2024))
    print(time.is_leap_year(2023))
    print(time.days_in_month(2024, month = 2))
    print(time.days_in_month(2023, month = 2))
    print(time.days_in_month(2026, month = 4))
    print(time.days_in_month(2026, month = 12))
    print(time.days_in_month(2026, month = 13))
}

proc validacao() {
    converte(time.DateTime{year = 2026, month = 11, day = 13, hour = 0, minute = 30, second = 5})
    converte(time.DateTime{year = 2000, month = 2, day = 29})
    converte(time.DateTime{year = 1900, month = 2, day = 29})
    converte(time.DateTime{year = 2026, month = 13, day = 1})
    converte(time.DateTime{year = 2026, month = 2, day = 31})
    converte(time.DateTime{year = 2026, month = 4, day = 31})
    converte(time.DateTime{year = 2026, month = 1, day = 1, hour = 24})
    converte(time.DateTime{year = 2026, month = 1, day = 1, minute = 60})
    converte(time.DateTime{year = 2026, month = 1, day = 1, second = -1})
    converte(time.DateTime{year = 2026, month = 1, day = 1, nanosecond = 1000000000})
    converte(time.DateTime{year = 3000, month = 1, day = 1})
    converte(time.DateTime{year = 1500, month = 1, day = 1})
    converte(time.DateTime{year = 2262, month = 4, day = 11, hour = 23, minute = 47, second = 16, nanosecond = 854775807})
    converte(time.DateTime{year = 2262, month = 4, day = 11, hour = 23, minute = 47, second = 16, nanosecond = 854775808})
    converte(time.DateTime{year = 1677, month = 9, day = 21, hour = 0, minute = 12, second = 43, nanosecond = 145224192})
    converte(time.DateTime{year = 1677, month = 9, day = 21, hour = 0, minute = 12, second = 43, nanosecond = 145224191})
    converte(time.DateTime{})
}

proc leitura() {
    le("2026-11-13")
    le("2026-11-13T00:30:05")
    le("2026-11-13T00:30:05Z")
    le("2026-11-13T00:30:05.5Z")
    le("2026-11-13T23:59:59.123456Z")
    le("2026-11-13T00:30:05.123456789")
    le("2024-02-29")
    le("1969-12-31T23:59:59Z")
    le("2026-11-13T00:30:05.1234567891")
    le("2026-13-01")
    le("2026-02-31")
    le("2023-02-29")
    le("2026-00-10")
    le("2026-11-00")
    le("2026-11-13T24:00:00")
    le("2026-11-13T00:60:00")
    le("2026-11-13T00:00:60")
    le("abc")
    le("")
    le("2026-11-13 00:30:05")
    le("2026-11-13T00:30")
    le("2026-11-13T00:30:05+03:00")
    le("2026-11-13Z")
    le("20261113")
    le("2026-1-13")
    le("2026-11-13T00:30:05.Z")
    le("2026-11-13T00:30:05ZZ")
    le("2026-11-13T0a:30:05")
    le("-026-11-13")
    le("2026/11/13")
}

proc soma() {
    let base = time.DateTime{year = 2026, month = 11, day = 13, hour = 0, minute = 30, second = 5}
    mostra_data(time.add_days(base, days = 20))
    mostra_data(time.add_days(base, days = -317))
    mostra_data(time.add_days(time.DateTime{year = 2024, month = 2, day = 28}, days = 1))
    mostra_data(time.add_days(time.DateTime{year = 2000, month = 2, day = 29}, days = 365))
    mostra_data(time.add_days(time.DateTime{year = 2000, month = 2, day = 29}, days = -366))
    mostra_data(time.add_seconds(time.DateTime{year = 2023, month = 12, day = 31, hour = 23, minute = 59, second = 59}, seconds = 1))
    mostra_data(time.add_seconds(time.DateTime{year = 2024, month = 1, day = 1}, seconds = -1))
    mostra_data(time.add_seconds(base, seconds = 86400 * 49 + 3600 * 5 + 61))
    mostra_data(time.add_seconds(time.DateTime{year = 2026, month = 1, day = 1, nanosecond = 500000000}, seconds = 0))
}

proc relogios() {
    let t0 = sys.wall_time_ns()
    let agora = time.now()
    let t1 = sys.wall_time_ns()
    print(t0 > 1767225600 * NS)
    print(t0 < 4102444800 * NS)
    print(agora.year >= 2026)
    print(agora.year < 2100)
    print(t1 >= t0)
    print(t1 - t0 < 2 * NS)
    let sw = time.stopwatch_start()
    sys.sleep_ms(50)
    let passou = time.elapsed_ns(sw)
    print(passou >= time.ms_to_ns(45))
    print(passou < time.seconds_to_ns(2))
    print(time.ms_to_ns(3))
    print(time.seconds_to_ns(2))
    print(time.ns_to_ms(2500000))
    print(time.ns_to_ms(-2500000))
    print(time.ns_to_ms(passou) >= 45)
}

proc main() {
    calendario()
    conta_ida_e_volta()
    validacao()
    leitura()
    soma()
    relogios()
}
