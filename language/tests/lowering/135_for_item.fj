struct Bala {
    vida: i32 = 3
}

proc gerar() -> [3]int {
    let r: [3]int = {7, 8, 9}
    return r
}

proc main() {
    var a: [5]int = {1, 2, 3, 4, 5}
    var soma = 0
    for x in a {
        soma += x
    }
    print(soma)
    for &x in a {
        x^ = x^ * 10
    }
    print(a[4])
    for i, x in a {
        if i == 1 {
            continue
        }
        if i == 3 {
            break
        }
        print(x)
    }
    let s = a[1..<3]
    for i, &x in s {
        x^ = i
    }
    print(a[1] + a[2])
    var balas: [2]Bala = {Bala{}, Bala{vida = 1}}
    for &b in balas {
        b.vida -= 1
    }
    print(balas[0].vida)
    print(balas[1].vida)
    for x in gerar() {
        print(x)
    }
    let m: [2][2]int = {{1, 2}, {3, 4}}
    var total = 0
    for linha in m {
        for v in linha {
            total += v
        }
    }
    print(total)
    let w: [3]int = {5, 20, 7}
    for x in w {
        defer print(x)
        if x > 10 {
            break
        }
    }
}
