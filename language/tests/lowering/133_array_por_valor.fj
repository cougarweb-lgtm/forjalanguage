proc dobrar(v: [3]int) -> [3]int {
    var r = v
    for k in 0..<3 {
        r[k] = v[k] * 2
    }
    return r
}

proc zerar_primeiro(v: [3]int) {
    var copia = v
    copia[0] = 0
    print(copia[0])
}

proc main() {
    let a: [3]int = {1, 2, 3}
    var b = a
    b[0] = 9
    print(a[0])
    print(b[0])
    let d = dobrar(a)
    print(d[2])
    zerar_primeiro(a)
    print(a[0])
    print(dobrar(a)[1])
}
