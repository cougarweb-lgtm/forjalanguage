enum ErroBusca { vazio }

struct Grifo {
    vida: i32 = 0
}

proc primeiro(g: ^Grifo, ok: bool) -> ^Grifo ! ErroBusca {
    if ok {
        return g
    }
    return ErroBusca.vazio
}

proc main() {
    var g = Grifo{vida = 1}
    var h = Grifo{vida = 5}
    let p = primeiro(&g, ok = true) or_else &g
    p.vida = 8
    print(g.vida)
    let q = primeiro(&g, ok = false) or_else &h
    print(q.vida)
}
