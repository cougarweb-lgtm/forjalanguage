// IA1-S2h (D-FMT): std:fmt, datas e horas por regiao: format_date (3 estilos), format_time (curto e medio) e format_datetime, nas formas donas e nas write_*, para as 9 regioes x 8 datas x 7 horas.
// Cada linha: regiao | data e hora de entrada (aaaa-mm-dd hh:mm:ss) | date short | long | full | time short | medium | datetime short | datetime full com segundos. Conferido contra o oraculo Python independente (scratchpad, sem o forja; nomes copiados de std\fmt.fj, dia da semana pelo datetime do Python).
import "std:fmt" as fmt
import "std:time" as tm

const YEARS: [8]int = {1970, 2000, 1999, 2024, 1600, 2300, 99, 2100}
const MONTHS: [8]int = {1, 2, 12, 2, 1, 12, 7, 2}
const DAYS: [8]int = {1, 29, 31, 29, 1, 31, 15, 28}
const HOURS: [7]int = {0, 1, 11, 12, 12, 13, 23}
const MINUTES: [7]int = {0, 5, 59, 0, 30, 0, 59}
const SECONDS: [7]int = {0, 9, 59, 0, 45, 0, 59}

// Acrescenta um texto dono ao builder e o libera.
proc junta(buf: ^[dynamic]u8, texto: str) {
    append(buf, item = texto)
    delete(texto)
}

// Uma linha: a mesma data e hora por todas as procs publicas.
proc linha(loc: fmt.Locale, dt: tm.DateTime) {
    var buf = make([dynamic]u8, alloc = heap, cap = 256)
    defer delete(buf)
    format(f"{loc.tag}|{dt.year:04}-{dt.month:02}-{dt.day:02} {dt.hour:02}:{dt.minute:02}:{dt.second:02}|", into = &buf)
    fmt.write_date(dt, buf = &buf, loc = loc)
    append(&buf, item = "|")
    fmt.write_date(dt, buf = &buf, loc = loc, style = fmt.DateStyle.long)
    append(&buf, item = "|")
    junta(&buf, fmt.format_date(dt, loc = loc, style = fmt.DateStyle.full, alloc = heap))
    append(&buf, item = "|")
    fmt.write_time(dt, buf = &buf, loc = loc)
    append(&buf, item = "|")
    junta(&buf, fmt.format_time(dt, loc = loc, seconds = true, alloc = heap))
    append(&buf, item = "|")
    junta(&buf, fmt.format_datetime(dt, loc = loc, alloc = heap))
    append(&buf, item = "|")
    fmt.write_datetime(dt, buf = &buf, loc = loc, style = fmt.DateStyle.full, seconds = true)
    let texto = to_str(&buf)
    print(texto)
    delete(texto)
}

proc main() {
    var total = 0
    for li in 0..<9 {
        for di in 0..<8 {
            for ti in 0..<7 {
                let dt = tm.DateTime{year = YEARS[di], month = MONTHS[di], day = DAYS[di], hour = HOURS[ti], minute = MINUTES[ti], second = SECONDS[ti], nanosecond = 123456789}
                linha(fmt.LOCALES[li], dt)
                total += 1
            }
        }
    }
    print(f"linhas={total}")
}
