// S3 P5b-2 (L11c): std:os com entrada padrao vazia (o verificador roda com stdin=DEVNULL). read_line = InputError.end; read_all_stdin = lista de 0 bytes.
import "std:os" as os

proc main() {
    switch linha in os.read_line(alloc = heap) {
    case str:
        print(f"linha {linha}")
        delete(linha)
    case os.InputError:
        print("fim")
    }
    switch dados in os.read_all_stdin(alloc = heap) {
    case [dynamic]u8:
        print(len(dados))
        delete(dados)
    case os.InputError:
        print("erro")
    }
}
