// IA1-L9f (T11) + to_str de qualquer alocador: o builder em frame vira a str sem copia, no frame (a str herda a origem do builder); frame_reset a libera, sem R0007.
proc main() {
    var buf = make([dynamic]u8, alloc = frame, cap = 8)
    append(&buf, item = "texto")
    print(len(buf))
    let s = to_str(&buf)
    print(len(s))
}
