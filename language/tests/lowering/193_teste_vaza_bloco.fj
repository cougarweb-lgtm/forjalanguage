// v1.11 L16b (C12): vazamento por teste no lowering. O main roda sem testes e libera o que aloca (10); em forja test (so no verificar_nativo, C contra x64) o teste "vaza tres"
// deixa tres blocos de heap vivos no mesmo new (R0009 com 3 blocos, 12 bytes) e falha, e os vizinhos passam.
struct Caixa {
    valor: i32 = 7
}

proc criar() -> ^Caixa {
    return new(Caixa, alloc = heap)
}

proc somar(a: i32, b: i32) -> i32 {
    return a + b
}

proc main() {
    let c = criar()
    defer delete(c)
    print(somar(c.valor, b = 3))
}

test "soma" {
    expect(somar(2, b = 3) == 5)
}

test "vaza tres" {
    for i in 0..<3 {
        let c = criar()
        expect(c.valor == 7)
    }
}

test "depois" {
    let c = criar()
    defer delete(c)
    expect(c.valor == 7)
}
