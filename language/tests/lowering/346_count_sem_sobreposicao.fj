// S2a (count em str): nao conta sobreposicao, igual ao std ("aaaa"/"aa" = 2); agulha vazia = len + 1; agulha maior que o texto = 0.
proc main() {
    print(count("aaaa", value = "aa"))
    print(count("abababa", value = "aba"))
    print(count("aaaaa", value = "aa"))
    print(count("aaa", value = "a"))
    print(count("", value = ""))
    print(count("", value = "a"))
    print(count("abc", value = ""))
    print(count("ab", value = "abc"))
}
