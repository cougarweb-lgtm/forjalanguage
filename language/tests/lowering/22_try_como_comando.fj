enum Erro { falhou }

proc validar(n: i32) -> ! Erro {
    if n < 0 {
        return Erro.falhou
    }
}

proc usar(n: i32) -> ! Erro {
    try validar(n)
    print(n)
}

proc main() {
    switch usar(5) {
    case Erro:
        print(0)
    default:
        print(1)
    }
    switch usar(-5) {
    case Erro:
        print(2)
    default:
        print(3)
    }
}
