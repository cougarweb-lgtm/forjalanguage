// IA1-S2c (T13): std:text encode(r, &buf) e from_rune(r): 1 a 4 bytes por runa, nos limites U+007F/0080/07FF/0800/FFFF/10000/10FFFF; runa invalida (surrogate, acima de U+10FFFF, negativa)
// vira U+FFFD (ef bf bd). encode ACRESCENTA ao builder (o que ja estava la fica). Cada linha: runa em decimal | bytes de encode | bytes de from_rune | decode da volta (runa/tamanho).
import "std:text" as tx

const RUNAS: [24]i32 = {
    0, 65, 127, 128, 231, 2047, 2048, 8364, 55295, 55296, 57343, 57344, 65533, 65535, 65536, 128512, 1114111,
    1114112, 2147483647, -1, -2147483647, 1048576, 917999, 4660
}

// Bytes de s em hexa, separados por espaco.
proc hex_de(s: str) -> str {
    var saida = make([dynamic]u8, alloc = heap)
    defer delete(saida)
    for i in 0..<len(s) {
        if i > 0 {
            append(&saida, item = " ")
        }
        format(f"{s[i]:02x}", into = &saida)
    }
    return to_str(&saida)
}

proc main() {
    var junto = make([dynamic]u8, alloc = heap)
    defer delete(junto)
    for r in RUNAS {
        var buf = make([dynamic]u8, alloc = heap)
        defer delete(buf)
        append(&buf, item = "<")
        tx.encode(r, &buf)
        let com_marca = to_str(&buf)
        defer delete(com_marca)
        let codificado = hex_de(com_marca[1..<len(com_marca)])
        defer delete(codificado)
        let sozinha = tx.from_rune(r, alloc = heap)
        defer delete(sozinha)
        let hex_sozinha = hex_de(sozinha)
        defer delete(hex_sozinha)
        let volta, tamanho = tx.decode(sozinha, at = 0)
        print(f"{r} | {codificado} | {hex_sozinha} | {volta as u32:04x}/{tamanho} {com_marca[0] == 60}")
        tx.encode(r, &junto)
    }
    let tudo = to_str(&junto)
    defer delete(tudo)
    print(f"junto: {len(tudo)} bytes, {tx.rune_count(tudo)} runas, valido {tx.valid_utf8(tudo)}")
}
