// P-IA1-LG: erro do GCC 16.1.0 (tree-widening_mul, .SAT_SUB) com a guarda invertida (`if a < b { 0 } else { a - b }`) e u8 alargado para u64.
// Os valores vem de arrays percorridos por laco (entrada opaca ao IPA-CP). Esperado: 255 - 1 = 254.
proc diferenca_sem_negativo(a: u8, b: u8) -> u64 {
    var r: u8 = 0
    if a < b {
        r = 0
    } else {
        r = a - b
    }
    return r as u64
}

proc main() {
    let a: [4]u8 = {10, 200, 0, 255}
    let b: [4]u8 = {20, 100, 0, 1}
    for i in 0..<4 {
        print(f"invertido {a[i]} {b[i]} -> {diferenca_sem_negativo(a[i], b[i])}")
    }
}
