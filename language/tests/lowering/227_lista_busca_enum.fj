// IA1-L9d: index_of, last_index_of, contains e count em lista, array e fatia de enum.
enum Cor { vermelho, verde, azul }

proc main() {
    var l = make([dynamic]Cor, alloc = heap, cap = 4)
    print(index_of(l, Cor.azul) or_else -1)
    print(contains(l, Cor.azul))
    append(&l, item = Cor.verde)
    append(&l, item = Cor.azul)
    append(&l, item = Cor.verde)
    print(index_of(l, Cor.verde) or_else -1)
    print(last_index_of(l, Cor.verde) or_else -1)
    print(index_of(l, Cor.azul) or_else -1)
    print(index_of(l, Cor.vermelho) or_else -1)
    print(count(l, Cor.verde))
    print(count(l, Cor.vermelho))
    print(contains(l, Cor.azul))
    print(contains(l, Cor.vermelho))
    let a: [3]Cor = {Cor.azul, Cor.azul, Cor.vermelho}
    print(last_index_of(a, Cor.azul) or_else -1)
    print(count(a, Cor.azul))
    let s = l[1..<3]
    print(index_of(s, Cor.verde) or_else -1)
    print(count(s, Cor.verde))
    delete(l)
}
