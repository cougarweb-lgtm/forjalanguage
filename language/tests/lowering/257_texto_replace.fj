// IA1-L10b (T06): std:text replace, replace_n e replace_table: texto DONO (heap) montado no builder; sem ocorrencia devolve COPIA (sempre delete).
// replace troca todas as ocorrencias sem sobreposicao, da esquerda para a direita ("aaa" com "aa" da "Xa"); replace_n troca as n primeiras (n <= 0 nao troca); old vazio nao troca nada (copia).
// replace_table: varias trocas numa passada; vale o 1o par da tabela que casa; o texto trocado nao e relido; old vazio ignorado.
// Cada resultado sai como <texto> tamanho, com \r \n \t como barra + letra e bytes >= 128 como \xhh.
import "std:text" as tx

const TEXTOS: [10]str = {"", "a", "aaa", "aaaa", "abcabc", "banana", "a,b,c", "héllo wörld", "xx", "ab"}
const ANTIGOS: [11]str = {"", "a", "aa", "an", "b", ",", "é", "x", "abc", "zzz", "banana"}
const NOVOS: [5]str = {"", "X", "XYZ", "é", ", "}
const LIMITES: [4]int = {0, 1, 2, 5}
const ENCADEADA_TEXTOS: [5]str = {"abc", "aaa", "", "xyz", "bab"}
const LONGO_TEXTOS: [4]str = {"aaa", "aaaa", "a", "baab"}
const VAZIO_TEXTOS: [3]str = {"abc", "bbb", ""}

proc anexa_visivel(saida: ^[dynamic]u8, b: u8) {
    if b == 13 {
        append(saida, item = "\\r")
    } else if b == 10 {
        append(saida, item = "\\n")
    } else if b == 9 {
        append(saida, item = "\\t")
    } else if b >= 128 {
        format(f"\\x{b:02x}", into = saida)
    } else {
        append(saida, item = b)
    }
}

// Imprime "  <texto> tamanho" com os controles visiveis.
proc mostra(saida: ^[dynamic]u8, texto: str) {
    append(saida, item = "  <")
    for i in 0..<len(texto) {
        anexa_visivel(saida, b = texto[i])
    }
    format(f"> {len(texto)}", into = saida)
    let linha = to_str(saida)
    defer delete(linha)
    print(linha)
}

proc caso_replace(saida: ^[dynamic]u8) {
    for a in 0..<len(TEXTOS) {
        for b in 0..<len(ANTIGOS) {
            for c in 0..<len(NOVOS) {
                let resultado = tx.replace(TEXTOS[a], old = ANTIGOS[b], new = NOVOS[c], alloc = heap)
                defer delete(resultado)
                print(f"replace {a} {b} {c}")
                mostra(saida, texto = resultado)
            }
        }
    }
}

proc caso_replace_n(saida: ^[dynamic]u8) {
    for a in 0..<len(TEXTOS) {
        for b in 0..<len(ANTIGOS) {
            for c in 0..<len(NOVOS) {
                for d in 0..<len(LIMITES) {
                    let resultado = tx.replace_n(TEXTOS[a], old = ANTIGOS[b], new = NOVOS[c], n = LIMITES[d], alloc = heap)
                    defer delete(resultado)
                    print(f"replace_n {a} {b} {c} {d}")
                    mostra(saida, texto = resultado)
                }
            }
        }
    }
}

// Aplica a tabela ao texto e imprime o rotulo e o resultado.
proc aplica(saida: ^[dynamic]u8, rotulo: str, texto: str, pares: []tx.Replacement) {
    let resultado = tx.replace_table(texto, pairs = pares, alloc = heap)
    defer delete(resultado)
    print(f"tabela {rotulo}")
    mostra(saida, texto = resultado)
}

proc caso_tabelas(saida: ^[dynamic]u8) {
    var encadeada: [2]tx.Replacement = {tx.Replacement{old = "a", new = "b"}, tx.Replacement{old = "b", new = "c"}}
    for texto in ENCADEADA_TEXTOS {
        aplica(saida, rotulo = "encadeada", texto = texto, pares = encadeada[..])
    }
    var longo_antes: [2]tx.Replacement = {tx.Replacement{old = "aa", new = "X"}, tx.Replacement{old = "a", new = "Y"}}
    for texto in LONGO_TEXTOS {
        aplica(saida, rotulo = "longo_antes", texto = texto, pares = longo_antes[..])
    }
    var curto_antes: [2]tx.Replacement = {tx.Replacement{old = "a", new = "X"}, tx.Replacement{old = "aa", new = "Y"}}
    aplica(saida, rotulo = "curto_antes", texto = "aaa", pares = curto_antes[..])
    var com_vazio: [2]tx.Replacement = {tx.Replacement{old = "", new = "Z"}, tx.Replacement{old = "b", new = ""}}
    for texto in VAZIO_TEXTOS {
        aplica(saida, rotulo = "com_vazio", texto = texto, pares = com_vazio[..])
    }
    var sem_pares = make([dynamic]tx.Replacement, alloc = heap)
    defer delete(sem_pares)
    aplica(saida, rotulo = "sem_pares", texto = "abc", pares = sem_pares[..])
    var acentos: [3]tx.Replacement = {tx.Replacement{old = "é", new = "e"}, tx.Replacement{old = "ü", new = "u"}, tx.Replacement{old = "ñ", new = "n"}}
    aplica(saida, rotulo = "acentos", texto = "línea é ü ñ", pares = acentos[..])
    var html: [3]tx.Replacement = {tx.Replacement{old = "&", new = "&amp;"}, tx.Replacement{old = "<", new = "&lt;"}, tx.Replacement{old = ">", new = "&gt;"}}
    aplica(saida, rotulo = "html", texto = "a<b&&c>d", pares = html[..])
}

proc main() {
    var saida = make([dynamic]u8, alloc = heap)
    defer delete(saida)
    caso_replace(&saida)
    caso_replace_n(&saida)
    caso_tabelas(&saida)
}
