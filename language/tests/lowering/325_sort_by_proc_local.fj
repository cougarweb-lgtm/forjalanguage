// K08a (sort_by): less por variavel local de tipo proc (let comparador = nome), duas vezes na mesma lista.
struct Item {
    chave: int
    seq: int
}

proc por_chave(a: ^Item, b: ^Item) -> bool {
    return a.chave < b.chave
}

proc por_seq_desc(a: ^Item, b: ^Item) -> bool {
    return a.seq > b.seq
}

proc main() {
    var l = make([dynamic]Item, alloc = heap)
    for i in 0..<8 {
        append(&l, item = Item{chave = i % 3, seq = i})
    }
    let comparador = por_chave
    sort_by(l[..], less = comparador)
    print(l[0].seq)
    print(l[2].seq)
    print(l[3].seq)
    let inverso = por_seq_desc
    sort_by(l[..], less = inverso)
    print(l[0].seq)
    print(l[7].seq)
    delete(l)
}
