struct No {
    valor: i32 = 0
    prox: ?^No
}

proc main() {
    var c = No{valor = 3}
    var b = No{valor = 2, prox = &c}
    var a = No{valor = 1, prox = &b}
    var p: ?^No = &a
    while p != none {
        let q = p as ^No
        print(q.valor)
        p = q.prox
    }
    print(c.prox == none)
}
