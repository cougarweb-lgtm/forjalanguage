// IA1-S2d2 (A42): std:path join (partes vazias ignoradas, depois clean, separador nativo) e join2. Lista vazia e partes todas vazias dao "" (texto dono vazio, valido). Texto DONO: cada caso da delete.
import "std:path" as path

proc caso1(a: str) {
    var partes: [1]str = {a}
    let junto = path.join(partes[..], alloc = heap)
    defer delete(junto)
    print(f"join1 [{a}] -> [{junto}] len {len(junto)}")
}

proc caso2(a: str, b: str) {
    let junto = path.join2(a, b = b, alloc = heap)
    defer delete(junto)
    print(f"join2 [{a}] [{b}] -> [{junto}] len {len(junto)}")
}

proc caso3(a: str, b: str, c: str) {
    var partes: [3]str = {a, b, c}
    let junto = path.join(partes[..], alloc = heap)
    defer delete(junto)
    print(f"join3 [{a}] [{b}] [{c}] -> [{junto}] len {len(junto)}")
}

proc vazio() {
    var uma: [1]str = {"x"}
    let junto = path.join(uma[0..<0], alloc = heap)
    defer delete(junto)
    print(f"join0 -> [{junto}] len {len(junto)}")
}

proc main() {
    vazio()
    caso1("")
    caso1("a")
    caso1("a//b/../c")
    caso1("/")
    caso1(".")
    caso2("a", "b")
    caso2("a/", "b")
    caso2("a", "/b")
    caso2("a/", "/b")
    caso2("", "b")
    caso2("a", "")
    caso2("", "")
    caso2("/", "a")
    caso2("a", "..")
    caso2("a", "../b")
    caso2("..", "..")
    caso2("a/b", "../../..")
    caso2("/", "..")
    caso2(".", ".")
    caso2(".", "a")
    caso2("a", ".")
    caso2("dir", "ação.txt")
    caso2("a b", "c d")
    caso2("a\\b", "c")
    caso2("a", "b\\c")
    caso2("a/b", "..\\c")
    caso2("C:", "a")
    caso2("C:\\", "a")
    caso2("C:\\a", "..\\..\\b")
    caso2("C:/x", "y/z")
    caso2("C:", "")
    caso2("\\\\srv\\sh", "x")
    caso2("\\\\srv", "sh")
    caso2("\\\\srv\\sh\\a", "..\\..\\b")
    caso3("a", "b", "c")
    caso3("a", "", "c")
    caso3("", "", "c")
    caso3("", "", "")
    caso3("/", "a", "b")
    caso3("a", "b/", "/c/")
    caso3("a", "..", "b")
    caso3("a", "b", "../../..")
    caso3("", "a", "")
    caso3("C:", "\\a", "b")
    caso3("\\\\srv", "sh", "x")
    caso3("\\\\srv", "", "sh")
    caso3("a.b", "c.d", "e.f")
    caso3("raiz", ".", "x")
}
