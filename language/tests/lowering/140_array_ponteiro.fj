struct Grifo {
    vida: i32 = 10
}

proc encher(p: ^[4]int, valor: int) {
    for i in 0..<len(p) {
        p[i] = valor + i
    }
}

proc main() {
    var a: [4]int = {}
    encher(&a, valor = 100)
    print(a[3])
    var g1 = Grifo{}
    var g2 = Grifo{vida = 20}
    let fortes: [2]^Grifo = {&g1, &g2}
    fortes[1].vida = 21
    print(g2.vida)
    var talvez: [2]?^Grifo = {}
    print(talvez[0] == none)
    talvez[1] = &g1
    print(talvez[1] != none)
    let q = &a[2]
    q^ = 7
    print(a[2])
}
