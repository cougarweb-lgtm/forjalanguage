// IA1-S2e (D-FMT): percent com decimals negativo e erro de quem chama: panic (R0003), o mesmo de number com decimals fora de 0..15. Aqui a variante write_percent.
import "std:fmt" as fmt

proc main() {
    var buf = make([dynamic]u8, alloc = heap, cap = 16)
    defer delete(buf)
    fmt.write_percent(0.5, buf = &buf, loc = fmt.PT_BR, decimals = 0)
    let ok = to_str(&buf)
    print(ok)
    delete(ok)
    fmt.write_percent(0.5, buf = &buf, loc = fmt.PT_BR, decimals = 0 - 1)
    print("nao chega")
}
