// K09 (index_by): pred por variavel local de tipo proc, sobre array fixo entrando como a[..] (igual ao sort_by). Chaves 3, 1, 5: a chave 5 esta no indice 2.
struct Item {
    chave: int
}

proc chave_cinco(a: ^Item) -> bool {
    return a.chave == 5
}

proc main() {
    var a: [3]Item = {Item{chave = 3}, Item{chave = 1}, Item{chave = 5}}
    let predicado = chave_cinco
    let i, ok = index_by(a[..], pred = predicado)
    print(i)
    print(ok)
}
