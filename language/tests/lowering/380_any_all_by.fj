// K09 (any_by e all_by): any_by acha um 1o verdadeiro; all_by acha um 1o falso. Chaves 1, 3, 5, 5. Vazia: any_by = false, all_by = true.
struct Item {
    chave: int
}

proc chave_cinco(a: ^Item) -> bool {
    return a.chave == 5
}

proc maior_que_zero(a: ^Item) -> bool {
    return a.chave > 0
}

proc maior_que_tres(a: ^Item) -> bool {
    return a.chave > 3
}

proc main() {
    var l = make([dynamic]Item, alloc = heap)
    append(&l, item = Item{chave = 1})
    append(&l, item = Item{chave = 3})
    append(&l, item = Item{chave = 5})
    append(&l, item = Item{chave = 5})
    print(any_by(l[..], pred = chave_cinco))
    print(all_by(l[..], pred = maior_que_zero))
    print(all_by(l[..], pred = maior_que_tres))
    var vazia = make([dynamic]Item, alloc = heap)
    print(any_by(vazia[..], pred = chave_cinco))
    print(all_by(vazia[..], pred = chave_cinco))
    delete(vazia)
    delete(l)
}
