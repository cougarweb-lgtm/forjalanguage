struct Vec2 {
    x: i32 = 1
    y: i32 = 2
}

struct Retangulo {
    pos: Vec2
    tam: Vec2
    id: i32 = 9
    cantos: [2]Vec2
}

proc mover(r: ^Retangulo, dx: i32) {
    r^.pos.x += dx
}

proc main() {
    var r = Retangulo{pos = Vec2{x = 10, y = 20}}
    print(r.tam.x)
    print(r.tam.y)
    mover(&r, dx = 5)
    print(r.pos.x)
    r.cantos[1].y = 30
    print(r.cantos[1].y)
    let copia = r
    r.pos.y = 0
    print(copia.pos.y)
    print(r.id)
    let lista: [2]Retangulo = {Retangulo{pos = Vec2{}}, Retangulo{pos = Vec2{x = 7}}}
    print(lista[1].pos.x)
}
