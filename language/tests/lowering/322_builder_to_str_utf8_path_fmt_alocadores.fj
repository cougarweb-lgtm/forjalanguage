// IA1-B01 (to_str de qualquer alocador): utf8 (pad_left, center), path (clean, join) e fmt (number, integer, money) montam o texto num builder e devolvem a str no alocador pedido.
// A mesma saida sai em heap (com delete), em frame (frame_reset no fim) e em Arena (arena_destroy no fim): sem R0007 e sem R0009, em c e x64, dev e release.
import "std:text" as text
import "std:path" as path
import "std:fmt" as fmt
import "std:mem"

proc formatos_heap() {
    let esquerda = text.pad_left("ab", 5, alloc = heap)
    print(esquerda)
    delete(esquerda)
    let centro = text.center("ab", 5, alloc = heap)
    print(centro)
    delete(centro)
    let limpo = path.clean("a//b/./c/../d", alloc = heap)
    print(limpo)
    delete(limpo)
    var trechos: [3]str = {"a", "b", "c"}
    let juntos = path.join(trechos[..], alloc = heap)
    print(juntos)
    delete(juntos)
    let numero = fmt.number(1234.5, loc = fmt.PT_BR, decimals = 2, alloc = heap)
    print(numero)
    delete(numero)
    let inteiro = fmt.integer(1234567, loc = fmt.PT_BR, alloc = heap)
    print(inteiro)
    delete(inteiro)
    let dinheiro = fmt.money(122334, loc = fmt.PT_BR, alloc = heap)
    print(dinheiro)
    delete(dinheiro)
}

proc formatos_frame() {
    let esquerda = text.pad_left("ab", 5, alloc = frame)
    print(esquerda)
    let centro = text.center("ab", 5, alloc = frame)
    print(centro)
    let limpo = path.clean("a//b/./c/../d", alloc = frame)
    print(limpo)
    var trechos: [3]str = {"a", "b", "c"}
    let juntos = path.join(trechos[..], alloc = frame)
    print(juntos)
    let numero = fmt.number(1234.5, loc = fmt.PT_BR, decimals = 2, alloc = frame)
    print(numero)
    let inteiro = fmt.integer(1234567, loc = fmt.PT_BR, alloc = frame)
    print(inteiro)
    let dinheiro = fmt.money(122334, loc = fmt.PT_BR, alloc = frame)
    print(dinheiro)
}

proc formatos_arena() {
    let a = mem.arena_create()
    let esquerda = text.pad_left("ab", 5, alloc = a)
    print(esquerda)
    let centro = text.center("ab", 5, alloc = a)
    print(centro)
    let limpo = path.clean("a//b/./c/../d", alloc = a)
    print(limpo)
    var trechos: [3]str = {"a", "b", "c"}
    let juntos = path.join(trechos[..], alloc = a)
    print(juntos)
    let numero = fmt.number(1234.5, loc = fmt.PT_BR, decimals = 2, alloc = a)
    print(numero)
    let inteiro = fmt.integer(1234567, loc = fmt.PT_BR, alloc = a)
    print(inteiro)
    let dinheiro = fmt.money(122334, loc = fmt.PT_BR, alloc = a)
    print(dinheiro)
    mem.arena_destroy(a)
}

proc main() {
    formatos_heap()
    formatos_frame()
    frame_reset()
    formatos_arena()
}
