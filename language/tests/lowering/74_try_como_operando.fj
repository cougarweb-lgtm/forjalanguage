enum Erro { falhou }

proc tenta(n: int) -> ! Erro {
    if n > 1 {
        return Erro.falhou
    }
}

proc dobra(n: int) -> int ! Erro {
    try tenta(n)
    return n * 2
}

proc soma_dobros(a: int, b: int) -> int ! Erro {
    return (try dobra(a)) + (try dobra(b))
}

proc main() {
    switch r in soma_dobros(1, b = 1) {
    case int:
        print(r)
    case Erro:
        print(0)
    }
    switch r in soma_dobros(1, b = 5) {
    case int:
        print(r)
    case Erro:
        print(0)
    }
}
