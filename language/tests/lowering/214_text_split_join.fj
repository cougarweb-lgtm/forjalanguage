// L-07 (IA1-L6): std:text split e join. split guarda os campos vazios, devolve partes emprestadas do original (so delete na lista); join devolve texto dono (delete nele).
import "std:text" as text

proc mostra_partes(s: str, sep: str) {
    var partes = text.split(s, sep, alloc = heap)
    print(len(partes))
    for p in partes {
        print(f"[{p}]")
    }
    delete(partes)
}

proc main() {
    mostra_partes("a,b,c", ",")
    mostra_partes("a,,b,", ",")
    mostra_partes("", ",")
    mostra_partes("abc", "")
    mostra_partes("um--dois--tres", "--")
    mostra_partes("--", "--")
    mostra_partes("aaa", "aa")

    var xs: [3]str = {"a", "bb", "ccc"}
    let todos = text.join(xs[..], ", ", alloc = heap)
    print(todos)
    delete(todos)
    let um = text.join(xs[1..<2], "|", alloc = heap)
    print(um)
    delete(um)
    let nenhum = text.join(xs[0..<0], "|", alloc = heap)
    print(len(nenhum))
    delete(nenhum)
    var ys: [7]str = {"1", "2", "3", "4", "5", "6", "7"}
    let sete = text.join(ys[..], "", alloc = heap)
    print(sete)
    delete(sete)

    var partes = text.split("x=1;y=22;z=333", ";", alloc = heap)
    let volta = text.join(partes[..], "+", alloc = heap)
    print(volta)
    delete(volta)
    delete(partes)
}
