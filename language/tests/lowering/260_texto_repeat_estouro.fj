// IA1-L10b (T07): std:text repeat com len(s) * n acima do maior int: panic (R0003) com mensagem, nunca texto truncado. O print antes prova que o caso valido anterior rodou.
import "std:text" as tx

const ENORME: int = 4611686018427387904

proc main() {
    let curto = tx.repeat("ab", n = 3, alloc = heap)
    defer delete(curto)
    print(curto)
    let estourado = tx.repeat("ab", n = ENORME, alloc = heap)
    defer delete(estourado)
    print(len(estourado))
}
