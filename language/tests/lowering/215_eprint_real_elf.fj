// IA1-LX: eprint de real e de texto, print curto de f32/f64 e f"..." com real: o mesmo programa vale no Windows e no ELF (x86_64-linux); stdout so com o print, stderr so com o eprint.
proc main() {
    let x: f64 = 0.1
    let y: f32 = 2.5
    let n = 7
    print("inicio")
    eprint(x)
    eprint(y)
    eprint("texto no stderr")
    eprint(f"n = {n}, x = {x}")
    print(1.0 / 3.0)
    print(y)
    eprint(-0.0001)
    print(f"fim {n}")
}
