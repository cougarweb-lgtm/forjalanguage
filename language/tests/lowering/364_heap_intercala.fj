// K17 (heap): push e pop intercalados; a cada pop sai o menor dos que estao no heap naquele momento. Saida: 2 1 4 3 5 8, -1 (vazio) e 0.
proc main() {
    var h = make([dynamic]int, alloc = heap)
    heap_push(&h, 5)
    heap_push(&h, 2)
    print(heap_pop(&h) or_else -1)
    heap_push(&h, 4)
    heap_push(&h, 1)
    print(heap_pop(&h) or_else -1)
    print(heap_pop(&h) or_else -1)
    heap_push(&h, 3)
    heap_push(&h, 8)
    print(heap_pop(&h) or_else -1)
    print(heap_pop(&h) or_else -1)
    print(heap_pop(&h) or_else -1)
    print(heap_pop(&h) or_else -1)
    print(len(h))
    delete(h)
}
