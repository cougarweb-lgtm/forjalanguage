// P-IA1-LG: erro do GCC 16.1.0 (tree-widening_mul, .SAT_SUB) com a subtracao de u8 guardada e o resultado em u64 (`r = (a - b) as u64`).
// Os valores vem de arrays percorridos por laco (entrada opaca ao IPA-CP). Esperado: 255 - 1 = 254.
proc diferenca_guardada_u64(a: u8, b: u8) -> u64 {
    var r: u64 = 0
    if a >= b {
        r = (a - b) as u64
    }
    return r
}

proc main() {
    let a: [4]u8 = {255, 200, 100, 0}
    let b: [4]u8 = {1, 100, 200, 0}
    for i in 0..<4 {
        print(f"guarda {a[i]} {b[i]} -> {diferenca_guardada_u64(a[i], b[i])}")
    }
}
