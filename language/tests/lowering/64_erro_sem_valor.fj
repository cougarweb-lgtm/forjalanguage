enum Erro { falhou }

proc checar(n: i32) -> ! Erro {
    if n < 0 {
        return Erro.falhou
    }
    return
}

proc main() {
    switch checar(1) {
    case Erro:
        print(0)
    default:
        print(1)
    }
    switch checar(-1) {
    case Erro:
        print(0)
    default:
        print(1)
    }
}
