proc main() {
    let f: f32 = 1.0
    let g: f64 = 1.0
    let m: u32 = 4294967295
    print(transmute(f, to = u32))
    print(transmute(m, to = i32))
    print(transmute(g, to = uint))
    let ida: u32 = transmute(f, to = u32)
    let volta: f32 = transmute(ida, to = f32)
    print(volta as int)
}
