// IA1-L9c/L9d: insert_at, remove_value (por conteudo), pop, clone (copia rasa de str), replace_value, fill, swap, reverse e copy em lista e array de str.
proc dump(s: []str) {
    print(len(s))
    for x in s {
        print(x)
    }
}

proc main() {
    let base = "ab cd ab"
    var l = make([dynamic]str, alloc = heap, cap = 2)
    print(pop(&l) == none)
    append(&l, item = "um")
    append(&l, item = "tres")
    insert_at(&l, 1, "dois")
    insert_at(&l, 3, base[0..<2])
    insert_at(&l, 0, "zero")
    dump(l[..])
    print(remove_value(&l, "ab"))
    print(remove_value(&l, base[6..<8]))
    print(remove_value(&l, "um"))
    dump(l[..])
    var c = clone(l, alloc = heap)
    append(&c, item = "dois")
    append(&c, item = base[3..<5])
    replace_value(c, "dois", "DOIS", n = 1)
    dump(c[..])
    replace_value(c, "dois", "2")
    replace_value(c, base[3..<5], "cd!")
    dump(c[..])
    swap(c, 0, 4)
    reverse(c)
    dump(c[..])
    var a: [2]str = {"x", "y"}
    fill(a, "z")
    dump(a[..])
    print(copy(c, a))
    dump(c[..])
    ordered_remove(&c, 0)
    unordered_remove(&c, 0)
    dump(c[..])
    print(pop(&c) or_else "nada")
    print(pop(&l) or_else "nada")
    dump(l[..])
    delete(l)
    delete(c)
}
