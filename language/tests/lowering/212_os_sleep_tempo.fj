// L-07 (IA1-L6): std:os sleep_ms e time_ns. O relogio e monotonico: dormir 60 ms mede pelo menos 50 ms (folga de timer) e bem menos de 2 s; sleep_ms(0) e negativo voltam na hora.
import "std:os" as sys

proc main() {
    let t0 = sys.time_ns()
    sys.sleep_ms(60)
    let t1 = sys.time_ns()
    let passou = t1 - t0
    print(passou >= 50000000)
    print(passou < 2000000000)
    sys.sleep_ms(0)
    sys.sleep_ms(-5)
    let t2 = sys.time_ns()
    print(t2 >= t1)
    print(t2 - t1 < 1000000000)
}
