// IA1-S2d2 (A42): std:path clean (Go filepath.Clean, lexico): separadores repetidos, ".", "..", ".." inicial de relativo, ".." acima da raiz, vazio, volume `X:` e UNC. Saida sempre com o separador nativo (alvo Windows: '\'). Texto DONO: cada caso da delete.
import "std:path" as path

proc caso(p: str) {
    let limpo = path.clean(p, alloc = heap)
    defer delete(limpo)
    print(f"clean [{p}] -> [{limpo}]")
}

