// IA1-S2g (D-FMT): allocate com a lista de pesos vazia e erro de quem chama: panic (R0003).
import "std:fmt" as fmt

proc main() {
    var bom: [1]int = {4}
    var ok = fmt.allocate(10, bom[..], alloc = heap)
    print(ok[0])
    delete(ok)
    var pesos: [3]int = {1, 2, 3}
    var ruim = fmt.allocate(10, pesos[0..<0], alloc = heap)
    print(len(ruim))
    delete(ruim)
    print("nao chega")
}
