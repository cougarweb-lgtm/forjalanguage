// v1.11 L14b (A05): q * r, q * [3]f32 e abs(q) contra o raymath.h da raylib 6.2 (QuaternionMultiply, Vector3RotateByQuaternion, QuaternionLength).
// 200 casos de um LCG de 31 bits (semente 20261109); cada linha imprime em hexa os bits de q*r (x y z w), q*v (x y z) e abs(q), iguais aos do oraculo
// tests\v111\quat_oraculo.c (o .esperado e a saida dele). Cada valor f32 = (n - 2000) / 1000 com n = (estado / 65536) % 4001.
proc bits(x: f32) -> u32 {
    return transmute(x, to = u32)
}

proc proximo(estado: ^uint) -> f32 {
    estado^ = (estado^ * 1103515245 + 12345) % 2147483648
    let n = (estado^ / 65536) % 4001
    let inteiro = (n as int) - 2000
    return (inteiro as f32) / 1000.0
}

proc main() {
    var estado: uint = 20261109
    for caso in 0..<200 {
        let qx = proximo(&estado)
        let qy = proximo(&estado)
        let qz = proximo(&estado)
        let qw = proximo(&estado)
        let rx = proximo(&estado)
        let ry = proximo(&estado)
        let rz = proximo(&estado)
        let rw = proximo(&estado)
        let vx = proximo(&estado)
        let vy = proximo(&estado)
        let vz = proximo(&estado)
        let q = quat{x = qx, y = qy, z = qz, w = qw}
        let r = quat{x = rx, y = ry, z = rz, w = rw}
        let v: [3]f32 = {vx, vy, vz}
        let p = q * r
        let g = q * v
        print(f"{bits(p.x):08x} {bits(p.y):08x} {bits(p.z):08x} {bits(p.w):08x} {bits(g[0]):08x} {bits(g[1]):08x} {bits(g[2]):08x} {bits(abs(q)):08x}")
    }
}
