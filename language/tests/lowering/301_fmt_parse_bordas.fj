// IA1-S2f (D-FMT): std:fmt, leitura estrita por regiao: parse_number, parse_integer, parse_fixed, parse_money e parse_percent. Cada linha: tipo, regiao, [texto] -> ok valor | nome do erro, e `@N` = o `at` (offset em bytes do 1o byte ruim; -1 = intocado, o contrato e gravar so no erro).
// No texto: '~' vale U+00A0 e '^' vale U+202F (montados por byte). Real impresso em %.17g (f"{v}"). Cada linha e conferida contra o oraculo Python independente (scratchpad, sem o forja).
import "std:fmt" as fmt

const NBSP_1: u8 = 0xC2
const NBSP_2: u8 = 0xA0
const NNBSP_1: u8 = 0xE2
const NNBSP_2: u8 = 0x80
const NNBSP_3: u8 = 0xAF
const TIL: u8 = 126
const CIRCUMFLEX: u8 = 94

// O texto do caso com '~' trocado por U+00A0 e '^' por U+202F: texto dono.
proc real_texto(texto: str) -> str {
    var b = make([dynamic]u8, alloc = heap, cap = 64)
    defer delete(b)
    for i in 0..<len(texto) {
        let c = texto[i]
        if c == TIL {
            append(&b, item = NBSP_1)
            append(&b, item = NBSP_2)
        } else if c == CIRCUMFLEX {
            append(&b, item = NNBSP_1)
            append(&b, item = NNBSP_2)
            append(&b, item = NNBSP_3)
        } else {
            append(&b, item = c)
        }
    }
    return to_str(&b)
}

proc nome_erro(e: fmt.ParseError) -> str {
    switch e {
    case fmt.ParseError.empty:
        return "empty"
    case fmt.ParseError.invalid:
        return "invalid"
    case fmt.ParseError.grouping:
        return "grouping"
    case fmt.ParseError.overflow:
        return "overflow"
    }
    return "?"
}

proc imprime(rotulo: str, resultado: str, pos: int) {
    print(f"{rotulo} -> {resultado} @{pos}")
}

proc resultado_int(r: int) -> str {
    return format(f"ok {r}", alloc = heap)
}

proc resultado_real(r: f64) -> str {
    return format(f"ok {r}", alloc = heap)
}

// parse_number
proc num(tag: str, texto: str) {
    let loc = fmt.find_locale(tag) or_else fmt.ISO
    let t = real_texto(texto)
    defer delete(t)
    var pos = -1
    let rotulo = format(f"number {tag} [{texto}]", alloc = heap)
    defer delete(rotulo)
    switch r in fmt.parse_number(t, loc = loc, at = &pos) {
    case f64:
        let s = resultado_real(r)
        imprime(rotulo, s, pos)
        delete(s)
    case fmt.ParseError:
        imprime(rotulo, nome_erro(r), pos)
    }
}

// parse_integer
proc inteiro(tag: str, texto: str) {
    let loc = fmt.find_locale(tag) or_else fmt.ISO
    let t = real_texto(texto)
    defer delete(t)
    var pos = -1
    let rotulo = format(f"integer {tag} [{texto}]", alloc = heap)
    defer delete(rotulo)
    switch r in fmt.parse_integer(t, loc = loc, at = &pos) {
    case int:
        let s = resultado_int(r)
        imprime(rotulo, s, pos)
        delete(s)
    case fmt.ParseError:
        imprime(rotulo, nome_erro(r), pos)
    }
}

// parse_fixed
proc fixo(tag: str, texto: str, scale: int) {
    let loc = fmt.find_locale(tag) or_else fmt.ISO
    let t = real_texto(texto)
    defer delete(t)
    var pos = -1
    let rotulo = format(f"fixed {tag} [{texto}] s={scale}", alloc = heap)
    defer delete(rotulo)
    switch r in fmt.parse_fixed(t, loc = loc, scale = scale, at = &pos) {
    case int:
        let s = resultado_int(r)
        imprime(rotulo, s, pos)
        delete(s)
    case fmt.ParseError:
        imprime(rotulo, nome_erro(r), pos)
    }
}

// parse_money
proc din(tag: str, texto: str, scale: int) {
    let loc = fmt.find_locale(tag) or_else fmt.ISO
    let t = real_texto(texto)
    defer delete(t)
    var pos = -1
    let rotulo = format(f"money {tag} [{texto}] s={scale}", alloc = heap)
    defer delete(rotulo)
    switch r in fmt.parse_money(t, loc = loc, scale = scale, at = &pos) {
    case int:
        let s = resultado_int(r)
        imprime(rotulo, s, pos)
        delete(s)
    case fmt.ParseError:
        imprime(rotulo, nome_erro(r), pos)
    }
}

// parse_percent
proc pct(tag: str, texto: str) {
    let loc = fmt.find_locale(tag) or_else fmt.ISO
    let t = real_texto(texto)
    defer delete(t)
    var pos = -1
    let rotulo = format(f"percent {tag} [{texto}]", alloc = heap)
    defer delete(rotulo)
    switch r in fmt.parse_percent(t, loc = loc, at = &pos) {
    case f64:
        let s = resultado_real(r)
        imprime(rotulo, s, pos)
        delete(s)
    case fmt.ParseError:
        imprime(rotulo, nome_erro(r), pos)
    }
}

// Um 1 seguido de `zeros` zeros: texto dono (para estourar o f64).
proc um_e_zeros(zeros: int) -> str {
    var b = make([dynamic]u8, alloc = heap, cap = 400)
    defer delete(b)
    append(&b, item = "1")
    for _i in 0..<zeros {
        append(&b, item = "0")
    }
    return to_str(&b)
}

proc grandes() {
    let vinte = um_e_zeros(20)
    let enorme = um_e_zeros(330)
    defer delete(vinte)
    defer delete(enorme)
    var pos = -1
    switch r in fmt.parse_number(vinte, loc = fmt.ISO, at = &pos) {
    case f64:
        print(f"1e20 -> ok {r} @{pos}")
    case fmt.ParseError:
        print(f"1e20 -> {nome_erro(r)} @{pos}")
    }
    switch r in fmt.parse_number(enorme, loc = fmt.ISO, at = &pos) {
    case f64:
        print(f"1e330 -> ok {r} @{pos}")
    case fmt.ParseError:
        print(f"1e330 -> {nome_erro(r)} @{pos}")
    }
    let enorme_pct = format(f"{enorme}%", alloc = heap)
    defer delete(enorme_pct)
    switch r in fmt.parse_percent(enorme_pct, loc = fmt.ISO, at = &pos) {
    case f64:
        print(f"1e330% -> ok {r} @{pos}")
    case fmt.ParseError:
        print(f"1e330% -> {nome_erro(r)} @{pos}")
    }
}

