// IA1-L9d: swap com indice == len = R0006 em dev (em release a lista tem folga: cap 8 e so o que vem antes e impresso).
proc main() {
    var l = make([dynamic]int, alloc = heap, cap = 8)
    defer delete(l)
    append(&l, item = 1)
    append(&l, item = 2)
    append(&l, item = 3)
    var j = 2
    swap(l, 0, j)
    print(l[0])
    j = 3
    print(1)
    swap(l, 0, j)
    print(2)
}
