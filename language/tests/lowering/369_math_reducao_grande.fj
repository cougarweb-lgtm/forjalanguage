// L11a-2 (S3 P2): sin cos tan de 1e22, 2^1022, 2^1023 e -2^1023 (reducao de argumento grande: __rem_pio2_large). Saida = bits em hex. Sem notacao 1e: a Forja nao a aceita.
import "std:math" as math

proc de_bits(b: u64) -> f64 {
    return transmute(b, to = f64)
}

proc bits(r: f64) -> u64 {
    return transmute(r, to = u64)
}

proc linha_grande(x: f64) {
    print(f"{bits(math.sin(x)):016x} {bits(math.cos(x)):016x} {bits(math.tan(x)):016x}")
}

proc main() {
    linha_grande(10000000000000000000000.0)
    linha_grande(-10000000000000000000000.0)
    linha_grande(de_bits(0x7FD0000000000000))
    linha_grande(de_bits(0x7FE0000000000000))
    linha_grande(de_bits(0xFFE0000000000000))
    linha_grande(1000000000000000.0)
    linha_grande(100000000.0)
    linha_grande(3.0 * 100000000000000000000.0)
}
