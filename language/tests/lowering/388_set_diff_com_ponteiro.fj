// K15 (set_diff): o 2o argumento pode ser ^map (&b). a = {1, 2, 3}, b = {2}: a vira {1, 3}.
proc main() {
    var a = make(map[int]bool, alloc = heap)
    var b = make(map[int]bool, alloc = heap)
    insert(&a, key = 1, value = true)
    insert(&a, key = 2, value = true)
    insert(&a, key = 3, value = true)
    insert(&b, key = 2, value = true)
    set_diff(&a, &b)
    print(len(a))
    print(has(a, key = 2))
    delete(a)
    delete(b)
}
