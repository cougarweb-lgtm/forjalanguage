// S2a (diferencial): contains, index_of, last_index_of e count de str contra std:text (str_contains, str_index_of, str_last_index_of, str_count) em 42 pares: ASCII, acentuado, multibyte, emoji e agulha vazia. Imprime so as divergencias e o total.
import "std:text" as text

proc main() {
    let textos: [6]str = {"São Paulo", "ação e ação", "日本語テキスト", "a😀b😀", "", "aaaa"}
    let agulhas: [7]str = {"ão", "a", "", "😀", "日本", "xyz", "aa"}
    var divergencias = 0
    var total = 0
    for i in 0..<6 {
        for j in 0..<7 {
            let t = textos[i]
            let g = agulhas[j]
            total += 1
            if contains(t, value = g) != text.str_contains(t, g) {
                divergencias += 1
            }
            if (index_of(t, value = g) or_else -1) != (text.str_index_of(t, g) or_else -1) {
                divergencias += 1
            }
            if (last_index_of(t, value = g) or_else -1) != (text.str_last_index_of(t, g) or_else -1) {
                divergencias += 1
            }
            if count(t, value = g) != text.str_count(t, g) {
                divergencias += 1
            }
        }
    }
    print(divergencias)
    print(total)
}
