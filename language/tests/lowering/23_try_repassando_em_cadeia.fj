enum Erro { falhou }

proc a(n: i32) -> i32 ! Erro {
    if n < 0 {
        return Erro.falhou
    }
    return n
}

proc b(n: i32) -> i32 ! Erro {
    print(10)
    let x = try a(n)
    print(11)
    return x
}

proc c(n: i32) -> i32 ! Erro {
    print(20)
    let y = try b(n)
    print(21)
    return y
}

proc main() {
    switch r in c(7) {
    case i32:
        print(r)
    case Erro:
        print(0)
    }
    switch r in c(-1) {
    case i32:
        print(r)
    case Erro:
        print(0)
    }
}
