enum Cor {
    vermelho
    verde
    azul
    preto
}

proc tamanho(s: bit_set[Cor]) -> int {
    return len(s)
}

proc main() {
    var s: bit_set[Cor] = {Cor.verde, Cor.azul}
    print(len(s))
    print(has(s, key = Cor.azul))
    print(has(s, key = Cor.preto))
    insert(&s, key = Cor.preto)
    print(tamanho(s))
    remove(&s, key = Cor.verde)
    let t: bit_set[Cor] = {Cor.vermelho, Cor.preto}
    let i = s & t
    print(len(i))
    let u = s | t
    let d = u - s
    print(len(d) + 1)
    print(s == t)
    let c = Cor.verde
    let w: bit_set[Cor] = {c, Cor.vermelho}
    print(has(w, key = Cor.verde))
    for item in d {
        if item == Cor.vermelho {
            print(1)
        }
    }
    var n = 0
    for item in u {
        n += 1
    }
    print(n)
    print(w != s)
}
