// K08c (dedup): lista de int. Vazia e de 1 elemento nao mudam; tudo igual vira 1; nenhum igual nao muda; corridas variadas tiram so as consecutivas (o 1 que volta fica). Termina com delete (R0009 zero).
proc main() {
    var v = make([dynamic]int, alloc = heap)
    dedup(&v)
    print(len(v))
    append(&v, item = 7)
    dedup(&v)
    print(len(v))
    print(v[0])
    clear(&v)
    append(&v, item = 4)
    append(&v, item = 4)
    append(&v, item = 4)
    append(&v, item = 4)
    dedup(&v)
    print(len(v))
    print(v[0])
    clear(&v)
    append(&v, item = 1)
    append(&v, item = 2)
    append(&v, item = 3)
    dedup(&v)
    print(len(v))
    clear(&v)
    append(&v, item = 1)
    append(&v, item = 1)
    append(&v, item = 2)
    append(&v, item = 3)
    append(&v, item = 3)
    append(&v, item = 3)
    append(&v, item = 1)
    append(&v, item = 4)
    append(&v, item = 4)
    dedup(&v)
    print(len(v))
    for i in 0..<len(v) {
        print(v[i])
    }
    delete(v)
}
