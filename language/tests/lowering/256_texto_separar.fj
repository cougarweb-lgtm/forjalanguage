// IA1-L10b (T04): std:text split_lines, fields, split_n e split_any: listas DONAS (heap) de vistas do texto original (delete na lista, nunca nas partes).
// Cada parte sai como <parte> tamanho, com \r \n \t escritos como barra + letra e todo byte >= 128 como \xhh (UTF-8 tratado como bytes, e split_any pode cortar no meio de uma runa).
// split_lines: \n e \r\n, sem linha vazia final; fields: runs de espaco ASCII; split_n: no maximo n partes (n <= 0 = lista vazia); split_any: qualquer byte do conjunto separa e campos vazios ficam.
import "std:text" as tx

const LINHAS: [14]str = {"", "a", "a\n", "a\nb", "a\r\nb\r\n", "\n", "\n\n", "a\r", "\r\n\r\n", "x\r\r\ny", "línea\nñ\n", "um\r\ndois\ntres", "\r", "\n\r\n"}
const CAMPOS: [11]str = {"", " ", "a", "  a  b ", "a\tb\nc\r\nd", "\n\t \r", " x", "x ", "ñ  é", "a b", "um\r\n\r\ndois"}
const TEXTOS_N: [6]str = {"", "a,b,c", ",a,", "a::b::c::d", ",,,", "é,ü,日"}
const SEPARADORES_N: [3]str = {"", ",", "::"}
const LIMITES_N: [6]int = {-1, 0, 1, 2, 3, 10}
const TEXTOS_ANY: [7]str = {"", "a", "a,b;;c", ",;", "x:y", ";;a", "é,ü;日"}
const CONJUNTOS: [5]str = {"", ",", ",;", ";:,", "é"}

// Escreve o byte b no builder: \r, \n e \t como barra + letra, bytes >= 128 como \xhh.
proc anexa_visivel(saida: ^[dynamic]u8, b: u8) {
    if b == 13 {
        append(saida, item = "\\r")
    } else if b == 10 {
        append(saida, item = "\\n")
    } else if b == 9 {
        append(saida, item = "\\t")
    } else if b >= 128 {
        format(f"\\x{b:02x}", into = saida)
    } else {
        append(saida, item = b)
    }
}

// Imprime "  <parte> tamanho" com os controles visiveis.
proc mostra_parte(saida: ^[dynamic]u8, parte: str) {
    append(saida, item = "  <")
    for i in 0..<len(parte) {
        anexa_visivel(saida, b = parte[i])
    }
    format(f"> {len(parte)}", into = saida)
    let linha = to_str(saida)
    defer delete(linha)
    print(linha)
}

proc mostra_lista(saida: ^[dynamic]u8, partes: []str) {
    for parte in partes {
        mostra_parte(saida, parte = parte)
    }
}

proc caso_linhas(saida: ^[dynamic]u8) {
    for a in 0..<len(LINHAS) {
        var partes = tx.split_lines(LINHAS[a], alloc = heap)
        defer delete(partes)
        print(f"linhas {a} {len(partes)}")
        mostra_lista(saida, partes = partes[..])
    }
}

proc caso_campos(saida: ^[dynamic]u8) {
    for a in 0..<len(CAMPOS) {
        var partes = tx.fields(CAMPOS[a], alloc = heap)
        defer delete(partes)
        print(f"campos {a} {len(partes)}")
        mostra_lista(saida, partes = partes[..])
    }
    // \v e \f nao cabem num literal de str: o texto vem de bytes.
    var bytes: [7]u8 = {97, 11, 98, 12, 99, 13, 100}
    let texto = from_bytes(bytes[..], alloc = heap)
    defer delete(texto)
    var partes = tx.fields(texto, alloc = heap)
    defer delete(partes)
    print(f"campos vf {len(partes)}")
    mostra_lista(saida, partes = partes[..])
}

proc caso_split_n(saida: ^[dynamic]u8) {
    for a in 0..<len(TEXTOS_N) {
        for b in 0..<len(SEPARADORES_N) {
            for c in 0..<len(LIMITES_N) {
                var partes = tx.split_n(TEXTOS_N[a], sep = SEPARADORES_N[b], n = LIMITES_N[c], alloc = heap)
                defer delete(partes)
                print(f"split_n {a} {b} {c} {len(partes)}")
                mostra_lista(saida, partes = partes[..])
            }
        }
    }
}

proc caso_split_any(saida: ^[dynamic]u8) {
    for a in 0..<len(TEXTOS_ANY) {
        for b in 0..<len(CONJUNTOS) {
            var partes = tx.split_any(TEXTOS_ANY[a], set = CONJUNTOS[b], alloc = heap)
            defer delete(partes)
            print(f"split_any {a} {b} {len(partes)}")
            mostra_lista(saida, partes = partes[..])
        }
    }
}

proc main() {
    var saida = make([dynamic]u8, alloc = heap)
    defer delete(saida)
    caso_linhas(&saida)
    caso_campos(&saida)
    caso_split_n(&saida)
    caso_split_any(&saida)
}
