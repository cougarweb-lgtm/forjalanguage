// K09 (index_by): nenhum elemento satisfaz pred. O resultado e (-1, false).
struct Item {
    chave: int
}

proc chave_nove(a: ^Item) -> bool {
    return a.chave == 9
}

proc main() {
    var l = make([dynamic]Item, alloc = heap)
    append(&l, item = Item{chave = 1})
    append(&l, item = Item{chave = 5})
    let i, ok = index_by(l[..], pred = chave_nove)
    print(i)
    print(ok)
    delete(l)
}
