struct Grifo {
    vida: i32 = 100
    nome: str = "Bico"
}

proc main() {
    let g = Grifo{}
    let x: f32 = 2.5
    let n: u32 = 255
    let neg = -42
    let c: cstr = "ponte"
    let y: f64 = 0.1
    print(f"Vida: {g.vida} de {g.nome}")
    print(f"{x} {x:.2} {x:8.1}|")
    print(f"[{n:x}] [{n:08x}] [{n:5}]")
    print(f"[{neg:6}] [{neg:06}] [{true}]")
    print(f"{{chave}} {1 + 2}")
    print(f"")
    print(f"{c:7}|")
    print(f"{y} {y:.3}")
}
