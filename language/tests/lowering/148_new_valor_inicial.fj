struct Grifo {
    vida: i32 in 1..=100 = 100
    pos: [3]i32 = {1, 2, 3}
    alvo: ?^Grifo
}

proc main() {
    let g = new(Grifo, alloc = heap)
    print(g.vida)
    print(g.pos[2])
    print(g.alvo == none)
    let a = new([4]int, alloc = heap)
    a[3] = 8
    print(a[3] + a[0])
    let n = new(int, alloc = heap)
    print(n^)
    let t = new(?^Grifo, alloc = frame)
    print(t^ == none)
    t^ = g
    print(t^ != none)
    delete(a)
    delete(n)
    delete(g)
}
