// IA1-S2e (D-FMT): std:fmt, as variantes write_number/write_integer/write_percent acrescentam ao builder do chamador (sem apagar o que ja la esta) e find_locale casa a tag EXATA (nao ignora caixa, nao aceita '_', tag vazia e desconhecida = none).
// O esperado vem do oraculo Python independente (scratchpad).
import "std:fmt" as fmt

proc achar(tag: str) {
    switch achada in fmt.find_locale(tag) {
    case fmt.Locale:
        print(f"found {tag} {achada.group_size}")
        if tag == "de-DE" {
            print(f"found de-DE {achada.decimal_sep}")
        }
    case none:
        print(f"none {tag}")
    }
}

proc main() {
    var buf = make([dynamic]u8, alloc = heap, cap = 16)
    defer delete(buf)
    append(&buf, item = "[")
    fmt.write_number(1234.5, buf = &buf, loc = fmt.PT_BR)
    append(&buf, item = "][")
    fmt.write_integer(-1234567, buf = &buf, loc = fmt.EN_US)
    append(&buf, item = "][")
    fmt.write_percent(0.125, buf = &buf, loc = fmt.FR_FR, decimals = 1)
    append(&buf, item = "]")
    let linha = to_str(&buf)
    print(linha)
    delete(linha)
    clear(&buf)
    append(&buf, item = "[")
    fmt.write_number(2.5, buf = &buf, loc = fmt.PT_BR, decimals = 0, rounding = fmt.Rounding.half_even)
    append(&buf, item = "|")
    fmt.write_number(2.5, buf = &buf, loc = fmt.PT_BR, decimals = 0)
    append(&buf, item = "|")
    fmt.write_number(-2.5, buf = &buf, loc = fmt.PT_BR, decimals = 0, rounding = fmt.Rounding.half_down)
    append(&buf, item = "]")
    let segunda = to_str(&buf)
    print(segunda)
    delete(segunda)
    achar("pt-BR")
    achar("ISO")
    achar("de-DE")
    achar("pt-br")
    achar("pt_BR")
    achar("")
    achar("xx")
    var tags = make([dynamic]u8, alloc = heap, cap = 64)
    defer delete(tags)
    append(&tags, item = "tags")
    for i in 0..<9 {
        append(&tags, item = " ")
        append(&tags, item = fmt.LOCALES[i].tag)
    }
    let todas = to_str(&tags)
    print(todas)
    delete(todas)
}
