// S2b (fixture 355): shuffle de lista de struct (troca de lugar, sem copia de dono) e choice que devolve a struct sorteada (?Par). A soma dos campos nao muda com o embaralhar e o sorteado pertence a lista.
import "std:rand" as rand

struct Par {
    a: int
    b: int
}

proc main() {
    var pares = make([dynamic]Par, alloc = heap)
    defer delete(pares)
    for i in 0..<8 {
        append(&pares, item = Par{a = i, b = i * 10})
    }
    var r = rand.seed(77)
    shuffle(pares, rng = &r)
    var soma_a = 0
    var soma_b = 0
    for p in pares {
        soma_a = soma_a + p.a
        soma_b = soma_b + p.b
    }
    print(soma_a == 28 and soma_b == 280)
    print(len(pares) == 8)

    var s = rand.seed(78)
    let escolhido = choice(pares, rng = &s) or_else Par{a = -1, b = -1}
    print(escolhido.a >= 0 and escolhido.a < 8 and escolhido.b == escolhido.a * 10)
}
