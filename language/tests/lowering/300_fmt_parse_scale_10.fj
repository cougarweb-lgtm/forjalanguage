// IA1-S2f (D-FMT): parse_money (e parse_fixed) com scale fora de 0..9 e erro de quem chama: panic (R0003), antes de olhar o texto. 9 casas ainda vale; 10 nao.
import "std:fmt" as fmt

proc main() {
    let ok = fmt.parse_fixed("1,5", loc = fmt.PT_BR, scale = 9) or_else 0
    print(ok)
    let ruim = fmt.parse_money("R$ 1,5", loc = fmt.PT_BR, scale = 10) or_else 0
    print(ruim)
    print("nao chega")
}
