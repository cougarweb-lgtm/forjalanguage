enum Dir { cima, baixo, esq, dir }

proc descrever(d: Dir) {
    switch d {
    case Dir.cima:
        print(1)
    case Dir.baixo:
        print(2)
    case Dir.esq:
        print(3)
    case Dir.dir:
        print(4)
    }
}

proc main() {
    descrever(Dir.cima)
    descrever(Dir.baixo)
    descrever(Dir.esq)
    descrever(Dir.dir)
}
