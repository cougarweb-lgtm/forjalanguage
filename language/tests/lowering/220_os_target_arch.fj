// IA1-L9b (B11): os.TARGET e os.ARCH, constantes de texto resolvidas na compilacao pelo alvo (aqui, o padrao x86_64-windows; o --target x86_64-linux troca o TARGET). Sem runtime.
import "std:os" as os

proc main() {
    print(os.TARGET)
    print(os.ARCH)
    print(len(os.TARGET))
    let alvo = os.TARGET
    print(alvo == "x86_64-windows")
}
