// Ryu P5: sort + sort_by + sort_by_key + heap no MESMO programa (o backend C definia FORJA_ORDENAR_API duas vezes: "redefined [-Werror]", B0002).
struct Item {
    peso: int
}

proc maior_antes(a: ^int, b: ^int) -> bool {
    return a^ > b^
}

proc main() {
    var l = make([dynamic]int, alloc = heap)
    defer delete(l)
    append(&l, item = 3)
    append(&l, item = 1)
    append(&l, item = 2)
    sort(l[..])
    print(l[0])
    sort_by(l[..], less = maior_antes)
    print(l[0])
    var it = make([dynamic]Item, alloc = heap)
    defer delete(it)
    append(&it, item = Item{peso = 9})
    append(&it, item = Item{peso = 4})
    sort_by_key(it[..], key = Item.peso)
    print(it[0].peso)
    var h = make([dynamic]int, alloc = heap)
    defer delete(h)
    heap_push(&h, 7)
    heap_push(&h, 5)
    print(heap_pop(&h) or_else -1)
}
