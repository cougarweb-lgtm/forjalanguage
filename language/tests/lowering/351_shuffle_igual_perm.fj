// S2b (shuffle): shuffle(l, rng = &a) de 0..<n com a semente 5 da a MESMA ordem que rand.perm(n) com a semente 5, e o proximo next_u64 dos dois geradores tambem bate.
// n = 0, 1, 10 e 1000: n = 0 nao sorteia (perm tambem nao). O perm e o oraculo: cada linha imprime true ou false.
import "std:rand" as rand

proc iguais_para(n: int) -> bool {
    var l = make([dynamic]int, alloc = heap)
    defer delete(l)
    for i in 0..<n {
        append(&l, item = i)
    }
    var a = rand.seed(5)
    var b = rand.seed(5)
    shuffle(l, rng = &a)
    var p = rand.perm(&b, n = n, alloc = heap)
    defer delete(p)
    var igual = len(l) == len(p)
    for i in 0..<n {
        igual = igual and l[i] == p[i]
    }
    return igual and rand.next_u64(&a) == rand.next_u64(&b)
}

proc main() {
    print(iguais_para(0))
    print(iguais_para(1))
    print(iguais_para(10))
    print(iguais_para(1000))
}
