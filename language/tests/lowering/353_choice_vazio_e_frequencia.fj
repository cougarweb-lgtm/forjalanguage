// S2b (choice): colecao vazia devolve none SEM sortear (o gerador nao avanca: o proximo next_u64 dos dois bate); 6000 sorteios em 6 elementos caem em 900..1100 cada e somam 6000.
import "std:rand" as rand

proc main() {
    var vazia = make([dynamic]int, alloc = heap)
    defer delete(vazia)
    var r = rand.seed(3)
    var s = rand.seed(3)
    let semvalor = choice(vazia, rng = &r) or_else -1
    print(semvalor)
    print(rand.next_u64(&r) == rand.next_u64(&s))

    var lista = make([dynamic]int, alloc = heap)
    defer delete(lista)
    for i in 0..<6 {
        append(&lista, item = i)
    }
    var sorteio = rand.seed(11)
    var contagem: [6]int = {0, 0, 0, 0, 0, 0}
    for _i in 0..<6000 {
        let k = choice(lista, rng = &sorteio) or_else -1
        contagem[k] = contagem[k] + 1
    }
    var soma = 0
    var faixa = true
    for i in 0..<6 {
        soma = soma + contagem[i]
        faixa = faixa and contagem[i] >= 900 and contagem[i] <= 1100
    }
    print(soma == 6000)
    print(faixa)
}
