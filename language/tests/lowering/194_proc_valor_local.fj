proc dobrar(x: i32) -> i32 {
    return x * 2
}

proc somar(a: i32, b: i32) -> i32 {
    return a + b
}

proc avisar(codigo: i32) {
    print(codigo)
}

proc main() {
    let f = dobrar
    var g: proc(x: i32) -> i32 = dobrar
    print(f(21))
    print(g(5))
    let h: proc(p: i32, q: i32) -> i32 = somar
    print(h(1, q = 2))
    print(h(20, q = 10))
    let a = f
    g = a
    print(g(8))
    let v: proc(c: i32) = avisar
    v(7)
    v(9)
    print(f(h(3, q = 4)))
}
