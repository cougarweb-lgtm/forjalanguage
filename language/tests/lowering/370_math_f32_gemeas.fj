// S3 P3 (L11b-1): as 21 funcoes de std:math com f32 (gemeas privadas pelo gancho). Saida = bits f32 em hex (igualdade de bits, NaN incluido).
import "std:math" as math

proc de_bits(b: u32) -> f32 {
    return transmute(b, to = f32)
}

proc bits(r: f32) -> u32 {
    return transmute(r, to = u32)
}

proc linha_trig(x: f32) {
    print(f"{bits(math.sin(x)):08x} {bits(math.cos(x)):08x} {bits(math.tan(x)):08x} {bits(math.asin(x)):08x} {bits(math.acos(x)):08x} {bits(math.atan(x)):08x}")
}

proc linha_exp(x: f32) {
    print(f"{bits(math.exp(x)):08x} {bits(math.exp2(x)):08x} {bits(math.log(x)):08x} {bits(math.log2(x)):08x} {bits(math.log10(x)):08x} {bits(math.cbrt(x)):08x}")
}

proc linha_arredonda(x: f32) {
    print(f"{bits(math.floor(x)):08x} {bits(math.ceil(x)):08x} {bits(math.round(x)):08x} {bits(math.trunc(x)):08x}")
}

proc linha_dois(y: f32, x: f32) {
    print(f"{bits(math.atan2(y, x)):08x} {bits(math.pow(y, x)):08x} {bits(math.hypot(y, x)):08x} {bits(math.fmod(y, x)):08x} {bits(math.copysign(y, x)):08x}")
}

proc main() {
    linha_trig(de_bits(0x00000000))
    linha_trig(de_bits(0x80000000))
    linha_trig(de_bits(0x7F800000))
    linha_trig(de_bits(0xFF800000))
    linha_trig(de_bits(0x7FC00001))
    linha_trig(de_bits(0x00000001))
    linha_trig(de_bits(0x007FFFFF))
    linha_trig(1.0)
    linha_trig(-1.0)
    linha_trig(0.5)
    linha_exp(de_bits(0x00000000))
    linha_exp(de_bits(0x80000000))
    linha_exp(de_bits(0x7F800000))
    linha_exp(de_bits(0xFF800000))
    linha_exp(de_bits(0x7FC00001))
    linha_exp(de_bits(0x00000001))
    linha_exp(1.0)
    linha_exp(-1.0)
    linha_exp(10.0)
    linha_arredonda(0.5)
    linha_arredonda(-2.5)
    linha_arredonda(de_bits(0x80000000))
    linha_arredonda(de_bits(0x7FC00001))
    linha_arredonda(de_bits(0xFF800000))
    linha_dois(0.0, 1.0)
    linha_dois(de_bits(0x80000000), -1.0)
    linha_dois(1.0, de_bits(0x7F800000))
    linha_dois(de_bits(0xFF800000), de_bits(0xFF800000))
    linha_dois(de_bits(0x7FC00001), 1.0)
    linha_dois(-8.0, 0.3333333)
    var i = 0
    var x: f32 = -4.0
    while i < 64 {
        linha_trig(x)
        linha_exp(x)
        linha_arredonda(x)
        linha_dois(x, 0.5)
        x = x + 0.125
        i = i + 1
    }
}
