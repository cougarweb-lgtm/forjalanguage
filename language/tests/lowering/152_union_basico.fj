struct Circulo {
    raio: f32 = 1.0
}

struct Retangulo {
    largura: f32 = 1.0
    altura: f32 = 1.0
}

union Forma {
    Circulo,
    Retangulo,
    i32
}

proc area(f: Forma) -> f32 {
    var a: f32 = 0.0
    switch c in f {
    case Circulo:
        a = c.raio * c.raio * 3.0
    case Retangulo:
        a = c.largura * c.altura
    case i32:
        a = 0.5
    }
    return a
}

proc nome(f: Forma) -> str {
    var n = "?"
    switch f {
    case Circulo:
        n = "circulo"
    default:
        n = "outro"
    }
    return n
}

proc main() {
    let a: Forma = Circulo{raio = 2.0}
    var b: Forma = Retangulo{largura = 3.0, altura = 5.0}
    print(area(a) as i32)
    print(area(b) as i32)
    print(nome(a))
    print(nome(b))
    b = 9 as i32
    print(area(b) as i32)
    switch n in b {
    case i32:
        print(n)
    default:
        print(0)
    }
    let formas: [2]Forma = {Circulo{}, Retangulo{}}
    var total: f32 = 0.0
    for x in formas {
        total += area(x)
    }
    print(total as i32)
}
