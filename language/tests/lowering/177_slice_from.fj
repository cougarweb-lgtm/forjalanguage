// v1.11: slice_from(p, len = n) cria uma fatia []T emprestada sobre um vetor C (aqui blocos do msvcrt).
struct Par {
    a: i32
    b: i32
}

foreign {
    link "msvcrt"
    proc c_calloc = "calloc"(n: u64, tamanho: u64) -> ?^i32
    proc c_malloc = "malloc"(tamanho: u64) -> ?^Par
    proc c_free = "free"(p: rawptr)
}

proc soma(v: []i32) -> int {
    var total: int = 0
    for x in v {
        total = total + x as int
    }
    return total
}

proc main() {
    let p = c_calloc(5, tamanho = 4)
    let v = slice_from(p, len = 5)
    print(len(v))
    for i in 0..<5 {
        v[i] = (i as i32) * 10
    }
    print(soma(v))
    let meio = v[1..<4]
    print(len(meio))
    print(meio[2])

    let n: i32 = 3
    let w = slice_from(p, len = n)
    print(len(w))
    print(w[2])

    let m: u32 = 4
    let x = slice_from(p, len = m)
    print(len(x))
    print(x[1])

    let q = c_malloc(16)
    let pares = slice_from(q, len = 2)
    pares[0] = Par{a = 3, b = 0}
    pares[1] = Par{a = 0, b = 7}
    print(pares[0].a + pares[1].b)

    let nulo: ?^i32 = none
    let vazio = slice_from(nulo, len = 0)
    print(len(vazio))

    c_free(p as rawptr)
    c_free(q as rawptr)
}
