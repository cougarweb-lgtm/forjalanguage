// K09 (find_by): devolve ?T. Chaves 1, 3, 5: o 1o maior que 2 e a chave 3; sem nenhum maior que 9 o or_else leva -1.
struct Item {
    chave: int
}

proc maior_que_dois(a: ^Item) -> bool {
    return a.chave > 2
}

proc maior_que_nove(a: ^Item) -> bool {
    return a.chave > 9
}

proc main() {
    var l = make([dynamic]Item, alloc = heap)
    append(&l, item = Item{chave = 1})
    append(&l, item = Item{chave = 3})
    append(&l, item = Item{chave = 5})
    let achado = find_by(l[..], pred = maior_que_dois) or_else Item{chave = -1}
    print(achado.chave)
    let nao = find_by(l[..], pred = maior_que_nove) or_else Item{chave = -1}
    print(nao.chave)
    delete(l)
}
