// L-07 (IA1-L6): std:text parse_int e parse_float (-> ! ParseError). Inteiro nos limites de 64 bits; real exato com ate 15 digitos e expoente ate 22; os erros empty, invalid e overflow.
import "std:text" as text

proc mostra_int(s: str) {
    switch r in text.parse_int(s) {
    case int:
        print(r)
    case text.ParseError:
        mostra_erro(r)
    }
}

proc mostra_real(s: str) {
    switch r in text.parse_float(s) {
    case f64:
        print(r)
    case text.ParseError:
        mostra_erro(r)
    }
}

proc mostra_erro(e: text.ParseError) {
    switch e {
    case text.ParseError.empty:
        print("vazio")
    case text.ParseError.invalid:
        print("invalido")
    case text.ParseError.overflow:
        print("estouro")
    }
}

proc main() {
    mostra_int("123")
    mostra_int("-45")
    mostra_int("+7")
    mostra_int("007")
    mostra_int("")
    mostra_int("-")
    mostra_int("12a")
    mostra_int(" 1")
    mostra_int("9223372036854775807")
    mostra_int("-9223372036854775808")
    mostra_int("9223372036854775808")
    mostra_int("-9223372036854775809")
    mostra_int("99999999999999999999x")

    mostra_real("3.14")
    mostra_real("-0.5")
    mostra_real("1e3")
    mostra_real("2.5E-3")
    mostra_real("+10")
    mostra_real(".5")
    mostra_real("5.")
    mostra_real("0.1")
    mostra_real("123456789.125")
    mostra_real("1223.34")
    mostra_real("1e22")
    mostra_real("1e-300")
    mostra_real("0")
    mostra_real("0.000")
    mostra_real("1e400")
    mostra_real("-1e400")
    mostra_real("1e-400")
    mostra_real("")
    mostra_real("abc")
    mostra_real("1.2.3")
    mostra_real("1e")
    mostra_real("1e+")
    mostra_real(".")
    mostra_real("-")
    mostra_real("1 ")
}
