// IA1-L9c/L9d: insert_at, remove_value, pop, clone, replace_value, fill, swap, reverse e copy em lista e array de enum.
enum Cor { vermelho, verde, azul }

proc codigo(c: Cor) -> int {
    switch c {
    case Cor.vermelho:
        return 1
    case Cor.verde:
        return 2
    case Cor.azul:
        return 3
    }
    return 0
}

proc dump(s: []Cor) {
    print(len(s))
    for x in s {
        print(codigo(x))
    }
}

proc main() {
    var l = make([dynamic]Cor, alloc = heap, cap = 2)
    print(pop(&l) == none)
    append(&l, item = Cor.verde)
    append(&l, item = Cor.azul)
    insert_at(&l, 0, Cor.vermelho)
    insert_at(&l, 3, Cor.verde)
    insert_at(&l, 2, Cor.vermelho)
    dump(l[..])
    print(remove_value(&l, Cor.verde))
    print(remove_value(&l, Cor.verde))
    print(remove_value(&l, Cor.verde))
    dump(l[..])
    var c = clone(l, alloc = heap)
    append(&c, item = Cor.vermelho)
    replace_value(c, Cor.vermelho, Cor.azul, n = 1)
    dump(c[..])
    replace_value(c, Cor.vermelho, Cor.verde)
    dump(c[..])
    swap(c, 0, 3)
    reverse(c)
    dump(c[..])
    var a: [2]Cor = {Cor.verde, Cor.verde}
    fill(a, Cor.azul)
    dump(a[..])
    print(copy(c, a))
    dump(c[..])
    ordered_remove(&c, 0)
    unordered_remove(&c, 0)
    dump(c[..])
    let ultimo = pop(&c) or_else Cor.vermelho
    print(codigo(ultimo))
    delete(l)
    delete(c)
}
