enum Cor { vermelho, verde }

proc main() {
    for i in 0..<3 {
        defer print(700 + i)
        switch cor_de(i) {
        case Cor.vermelho:
            defer print(800 + i)
            if i == 2 {
                break
            }
        case Cor.verde:
            defer print(900 + i)
            continue
        }
        print(i)
    }
}

proc cor_de(n: int) -> Cor {
    if n % 2 == 0 {
        return Cor.vermelho
    }
    return Cor.verde
}
