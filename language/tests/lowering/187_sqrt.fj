// v1.11 L13 (A13): sqrt embutido de f32 e de f64: 0, 2, 1e-45 (o menor denormal, bits 1), -1 (da NaN), inf e -0.0. Os bits dizem o resultado exato; o C (__builtin_sqrt) e o x64 (sqrtss/sqrtsd) concordam.
proc bits(x: f32) -> u32 {
    return transmute(x, to = u32)
}

proc bits64(x: f64) -> u64 {
    return transmute(x, to = u64)
}

proc main() {
    let zero: f32 = 0.0
    let um: f32 = 1.0
    let dois: f32 = 2.0
    let menor_bit: u32 = 1
    let pequeno = transmute(menor_bit, to = f32)
    let inf = um / zero
    let negativo = -um
    let neg0 = -zero
    print(f"{bits(sqrt(zero))} {bits(sqrt(neg0))} {bits(sqrt(um))} {bits(sqrt(dois))} {bits(sqrt(pequeno))} {bits(sqrt(inf))}")
    let nan = sqrt(negativo)
    print(nan != nan)
    print(f"{sqrt(dois)} {sqrt(16.0)} {sqrt(2)}")

    let d0: f64 = 0.0
    let d1: f64 = 1.0
    let d2: f64 = 2.0
    let dinf = d1 / d0
    let dneg = -d1
    print(f"{bits64(sqrt(d0))} {bits64(sqrt(d1))} {bits64(sqrt(d2))} {bits64(sqrt(dinf))}")
    let dnan = sqrt(dneg)
    print(dnan != dnan)
    print(sqrt(d2) * sqrt(d2) > 1.99999)
    print(sqrt(2.0 * dois) as int)
}
