foreign {
    proc qsort(base: rawptr, n: u64, tamanho: u64, comparar: proc(a: rawptr, b: rawptr) -> i32)
}

proc crescente(a: i32, b: i32) -> i32 {
    if a < b {
        return -1
    }
    if a > b {
        return 1
    }
    return 0
}

proc decrescente(a: i32, b: i32) -> i32 {
    return crescente(b, b = a)
}

struct Criterio {
    regra: proc(a: i32, b: i32) -> i32
}

proc comparar_cres(a: rawptr, b: rawptr) -> i32 {
    let x = a as ^i32
    let y = b as ^i32
    let regra: proc(a: i32, b: i32) -> i32 = crescente
    return regra(x^, b = y^)
}

proc comparar_decr(a: rawptr, b: rawptr) -> i32 {
    let x = a as ^i32
    let y = b as ^i32
    let criterio = Criterio{regra = decrescente}
    return criterio.regra(x^, b = y^)
}

proc mostrar(v: ^[5]i32) {
    for item in v^ {
        print(item)
    }
}

proc main() {
    var v: [5]i32 = {4, 2, 5, 1, 3}
    qsort(&v[0] as rawptr, n = 5, tamanho = 4, comparar = comparar_cres)
    mostrar(&v)
    qsort(&v[0] as rawptr, n = 5, tamanho = 4, comparar = comparar_decr)
    mostrar(&v)
}
