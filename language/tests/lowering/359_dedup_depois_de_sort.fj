// K08c (dedup depois de sort): 200 inteiros com chaves repetidas (i % 37); sort + dedup deixa 37 distintos, em ordem estrita, soma 666 (0..36). Termina com delete (R0009 zero).
proc main() {
    var l = make([dynamic]int, alloc = heap)
    for i in 0..<200 {
        append(&l, item = i % 37)
    }
    sort(l[..])
    dedup(&l)
    print(len(l))
    var soma = 0
    var ordem = true
    for i in 0..<len(l) {
        soma = soma + l[i]
        if i > 0 and l[i - 1] >= l[i] {
            ordem = false
        }
    }
    print(soma)
    print(ordem)
    print(l[0])
    print(l[len(l) - 1])
    delete(l)
}
