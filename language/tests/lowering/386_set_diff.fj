// K15 (set_diff): sai de a o que esta em b. a = {1..6}, b = {2, 4, 6, 9}: a vira {1, 3, 5}. A chave 9 de b nao esta em a e nao faz nada.
proc main() {
    var a = make(map[int]bool, alloc = heap)
    var b = make(map[int]bool, alloc = heap)
    for i in 1..=6 {
        insert(&a, key = i, value = true)
    }
    insert(&b, key = 2, value = true)
    insert(&b, key = 4, value = true)
    insert(&b, key = 6, value = true)
    insert(&b, key = 9, value = true)
    set_diff(&a, b)
    print(len(a))
    print(has(a, key = 2))
    print(has(a, key = 3))
    print(has(a, key = 6))
    print(has(a, key = 9))
    delete(a)
    delete(b)
}
