// IA1-S2d1 (A20): std:rand, o xoshiro256** com semente por SplitMix64. Cada linha: semente, indice, next_u64. Sementes: 0, 1, 0xDEADBEEFCAFEBABE e o maior u64; 100 saidas de cada.
// Depois: Rng{} (valor padrao) e igual a seed(0); copiar o Rng copia o estado (as duas copias andam sozinhas e iguais). O esperado vem de um oraculo Python (SplitMix64 e xoshiro256** com inteiros de 64 bits).
import "std:rand" as rand

const SEMENTES: [4]u64 = {0, 1, 0xDEADBEEFCAFEBABE, 0xFFFFFFFFFFFFFFFF}
const PASSOS: int = 100

proc imprimir_sequencia(semente: u64) {
    var rng = rand.seed(semente)
    for i in 0..<PASSOS {
        let valor = rand.next_u64(&rng)
        print(f"{semente} {i} {valor}")
    }
}

proc main() {
    for semente in SEMENTES {
        imprimir_sequencia(semente)
    }
    var padrao = rand.Rng{}
    var zero = rand.seed(0)
    for i in 0..<5 {
        let a = rand.next_u64(&padrao)
        let b = rand.next_u64(&zero)
        print(f"padrao {i} {a} {b} {a == b}")
    }
    var original = rand.seed(5)
    let _primeiro = rand.next_u64(&original)
    var copia = original
    let da_copia = rand.next_u64(&copia)
    let do_original = rand.next_u64(&original)
    let de_novo = rand.next_u64(&copia)
    print(f"copia {da_copia == do_original} {de_novo}")
}
