// IA1-L9b: rotate_left/right (n modulo a largura, n negativo), count_ones, leading_zeros, trailing_zeros, byte_swap em todos os inteiros, e mul_hi_u64.
// Cada prova imprime o cabecalho (contagens e byte_swap) e uma linha por rotacao (n = 0, a largura, acima da largura e negativo). O esperado vem de um oraculo Python de inteiros arbitrarios.
const NS: [14]int = {-70, -65, -9, -1, 0, 1, 3, 7, 8, 9, 31, 33, 64, 70}

proc bits_u8(x: u8) {
    print(f"u8 {x} ones={count_ones(x)} lz={leading_zeros(x)} tz={trailing_zeros(x)} bs={byte_swap(x)}")
    for n in NS {
        print(f"  n={n} l={rotate_left(x, n = n)} r={rotate_right(x, n = n)}")
    }
}

proc bits_i8(x: i8) {
    print(f"i8 {x} ones={count_ones(x)} lz={leading_zeros(x)} tz={trailing_zeros(x)} bs={byte_swap(x)}")
    for n in NS {
        print(f"  n={n} l={rotate_left(x, n = n)} r={rotate_right(x, n = n)}")
    }
}

proc bits_u16(x: u16) {
    print(f"u16 {x} ones={count_ones(x)} lz={leading_zeros(x)} tz={trailing_zeros(x)} bs={byte_swap(x)}")
    for n in NS {
        print(f"  n={n} l={rotate_left(x, n = n)} r={rotate_right(x, n = n)}")
    }
}

proc bits_i16(x: i16) {
    print(f"i16 {x} ones={count_ones(x)} lz={leading_zeros(x)} tz={trailing_zeros(x)} bs={byte_swap(x)}")
    for n in NS {
        print(f"  n={n} l={rotate_left(x, n = n)} r={rotate_right(x, n = n)}")
    }
}

proc bits_u32(x: u32) {
    print(f"u32 {x} ones={count_ones(x)} lz={leading_zeros(x)} tz={trailing_zeros(x)} bs={byte_swap(x)}")
    for n in NS {
        print(f"  n={n} l={rotate_left(x, n = n)} r={rotate_right(x, n = n)}")
    }
}

proc bits_i32(x: i32) {
    print(f"i32 {x} ones={count_ones(x)} lz={leading_zeros(x)} tz={trailing_zeros(x)} bs={byte_swap(x)}")
    for n in NS {
        print(f"  n={n} l={rotate_left(x, n = n)} r={rotate_right(x, n = n)}")
    }
}

proc bits_u64(x: u64) {
    print(f"u64 {x} ones={count_ones(x)} lz={leading_zeros(x)} tz={trailing_zeros(x)} bs={byte_swap(x)}")
    for n in NS {
        print(f"  n={n} l={rotate_left(x, n = n)} r={rotate_right(x, n = n)}")
    }
}

proc bits_int(x: int) {
    print(f"int {x} ones={count_ones(x)} lz={leading_zeros(x)} tz={trailing_zeros(x)} bs={byte_swap(x)}")
    for n in NS {
        print(f"  n={n} l={rotate_left(x, n = n)} r={rotate_right(x, n = n)}")
    }
}

proc mul_hi(a: u64, b: u64) {
    print(f"hi {a} {b} = {mul_hi_u64(a, b = b)}")
}

// Literais: sem contexto o dado e o n valem int (64 bits); n pode ser de outra largura e sem sinal.
proc literais() {
    print(f"{count_ones(255)} {leading_zeros(1)} {trailing_zeros(8)} {byte_swap(1)}")
    print(f"{rotate_left(1, n = 40)} {rotate_right(1, n = 1)}")
    let pequeno: u8 = 129
    let passos: u64 = 9
    print(f"{rotate_left(pequeno, n = passos)} {rotate_right(pequeno, n = 3)} {rotate_left(pequeno, n = 255)}")
    print(f"{mul_hi_u64(18446744073709551615, b = 2)}")
}

proc main() {
    bits_u8(0)
    bits_u8(1)
    bits_u8(255)
    bits_u8(128)
    bits_u8(165)
    bits_u8(18)

    bits_i8(0)
    bits_i8(1)
    bits_i8(-1)
    bits_i8(-128)
    bits_i8(127)
    bits_i8(-91)

    bits_u16(0)
    bits_u16(1)
    bits_u16(65535)
    bits_u16(32768)
    bits_u16(4660)
    bits_u16(61680)

    bits_i16(0)
    bits_i16(1)
    bits_i16(-1)
    bits_i16(-32768)
    bits_i16(32767)
    bits_i16(4660)

    bits_u32(0)
    bits_u32(1)
    bits_u32(4294967295)
    bits_u32(2147483648)
    bits_u32(305419896)
    bits_u32(16711935)

    bits_i32(0)
    bits_i32(1)
    bits_i32(-1)
    bits_i32(-2147483648)
    bits_i32(2147483647)
    bits_i32(305419896)

    bits_u64(0)
    bits_u64(1)
    bits_u64(18446744073709551615)
    bits_u64(9223372036854775808)
    bits_u64(81985529216486895)
    bits_u64(17361641481138401520)

    bits_int(0)
    bits_int(1)
    bits_int(-1)
    bits_int(-9223372036854775808)
    bits_int(9223372036854775807)
    bits_int(81985529216486895)

    mul_hi(18446744073709551615, 18446744073709551615)
    mul_hi(0, 18446744073709551615)
    mul_hi(1, 1)
    mul_hi(9223372036854775808, 2)
    mul_hi(4294967296, 4294967296)
    mul_hi(18446744073709551615, 1)
    mul_hi(12345678901234567890, 6531711741328785130)
    mul_hi(9223372036854775808, 9223372036854775808)
    mul_hi(4294967295, 4294967297)
    literais()
}
