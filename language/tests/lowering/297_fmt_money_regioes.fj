// IA1-S2f (D-FMT): std:fmt, money (centavos inteiros; sem arredondar). Por valor, 5 linhas com as 9 regioes (PT_BR EN_US EN_GB ES_ES FR_FR DE_DE IT_IT PT_PT ISO): o padrao; "acc" = accounting (negativo entre parenteses); "sem" = symbol = false; "usd" = code = "USD" (troca o simbolo pelo codigo; posicao e espaco da regiao); "sem+code" = symbol = false vence o code.
// Cada linha e conferida contra o oraculo Python independente (scratchpad, sem o forja). Negativo: o "-" vai na frente de tudo ("-R$ 1,00", "-1,00 €"). Combustivel: scale = 3, 5899 = "R$ 5,899". Menor e maior int incluidos.
import "std:fmt" as fmt

proc linha(rotulo: str, v: int, scale: int, variante: int) {
    var buf = make([dynamic]u8, alloc = heap, cap = 256)
    defer delete(buf)
    append(&buf, item = rotulo)
    for i in 0..<9 {
        append(&buf, item = "|")
        if variante == 0 {
            fmt.write_money(v, buf = &buf, loc = fmt.LOCALES[i], scale = scale)
        } else if variante == 1 {
            fmt.write_money(v, buf = &buf, loc = fmt.LOCALES[i], scale = scale, accounting = true)
        } else if variante == 2 {
            fmt.write_money(v, buf = &buf, loc = fmt.LOCALES[i], scale = scale, symbol = false)
        } else if variante == 3 {
            fmt.write_money(v, buf = &buf, loc = fmt.LOCALES[i], scale = scale, code = "USD")
        } else {
            fmt.write_money(v, buf = &buf, loc = fmt.LOCALES[i], scale = scale, symbol = false, accounting = true, code = "USD")
        }
    }
    let texto = to_str(&buf)
    print(texto)
    delete(texto)
}

proc dinheiro(v: int, scale: int) {
    let cabeca = format(f"{v} s={scale}", alloc = heap)
    defer delete(cabeca)
    linha(cabeca, v, scale, 0)
    linha("  acc", v, scale, 1)
    linha("  sem", v, scale, 2)
    linha("  usd", v, scale, 3)
    linha("  sem+code", v, scale, 4)
}

// As formas donas (money com os padroes) tambem passam por aqui: o texto tem de sair igual ao da variante write_money.
proc dona() {
    let a = fmt.money(122334, loc = fmt.PT_BR, alloc = heap)
    let b = fmt.money(-122334, loc = fmt.PT_BR, accounting = true, alloc = heap)
    let c = fmt.money(5899, loc = fmt.PT_BR, scale = 3, alloc = heap)
    let d = fmt.money(122334, loc = fmt.EN_US, code = "BRL", alloc = heap)
    print(f"{a} {b} {c} {d}")
    delete(a)
    delete(b)
    delete(c)
    delete(d)
}

proc main() {
    dinheiro(0, 2)
    dinheiro(1, 2)
    dinheiro(-1, 2)
    dinheiro(100, 2)
    dinheiro(122334, 2)
    dinheiro(-122334, 2)
    dinheiro(123456789, 2)
    dinheiro(-9223372036854775807 - 1, 2)
    dinheiro(9223372036854775807, 2)
    dinheiro(5899, 3)
    dinheiro(-5899, 3)
    dinheiro(-7, 0)
    dinheiro(9223372036854775807, 0)
    dinheiro(-9223372036854775807 - 1, 9)
    dona()
}
