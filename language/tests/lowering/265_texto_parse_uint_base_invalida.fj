// IA1-S2b2b (T15): parse_uint_base com base 1 (abaixo de 2 e diferente de 0) e erro de quem chama: panic (R0003), mesmo com texto vazio (a base e conferida antes do texto).
import "std:text" as tx

proc main() {
    print(tx.parse_uint_base("ff", base = 16) or_else 0)
    print(tx.parse_uint_base("", base = 1) or_else 0)
    print("nao chega")
}
