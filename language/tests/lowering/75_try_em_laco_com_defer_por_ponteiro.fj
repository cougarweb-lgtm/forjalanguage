enum Erro { falhou }

struct Cont {
    n: int = 0
}

proc tenta(n: int) -> ! Erro {
    if n > 1 {
        return Erro.falhou
    }
}

proc lote(c: ^Cont) -> ! Erro {
    var i = 0
    while i < 5 {
        defer c.n += 1
        try tenta(i)
        i += 1
    }
}

proc main() {
    var c = Cont{}
    switch lote(&c) {
    case Erro:
        print(c.n)
    default:
        print(-1)
    }
}
