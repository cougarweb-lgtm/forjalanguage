// S3 P3 (L11b-1): procs puros (is_nan is_inf is_finite lerp sign deg_to_rad rad_to_deg) e constantes (PI..EPSILON e _F32). Booleanos imprimem como texto; reais saem por bits em hex.
import "std:math" as math

proc bits(r: f64) -> u64 {
    return transmute(r, to = u64)
}

proc bits32(r: f32) -> u32 {
    return transmute(r, to = u32)
}

proc main() {
    let nan64 = math.nan()
    let inf64 = math.inf()
    let nan32 = math.nan_f32()
    let inf32 = math.inf_f32()
    let zero: f64 = 0.0
    print(math.is_nan(nan64))
    print(math.is_nan(zero))
    print(math.is_nan(nan32))
    print(math.is_inf(inf64))
    print(math.is_inf(-inf64))
    print(math.is_inf(nan64))
    print(math.is_inf(inf32))
    print(math.is_finite(1.5))
    print(math.is_finite(inf64))
    print(math.is_finite(nan32))
    print(math.is_finite(inf32))
    let a32: f32 = 0.0
    let b32: f32 = 10.0
    let t32: f32 = 0.25
    print(f"{bits(math.lerp(0.0, 10.0, 0.25)):016x}")
    print(f"{bits32(math.lerp(a32, b32, t32)):08x}")
    print(f"{bits(math.sign(-3.0)):016x} {bits(math.sign(0.0)):016x} {bits(math.sign(-0.0)):016x}")
    print(f"{bits(math.sign(nan64)):016x}")
    print(f"{bits32(math.sign(b32 - 20.0)):08x} {bits32(math.sign(b32)):08x}")
    print(f"{bits(math.deg_to_rad(180.0)):016x} {bits(math.rad_to_deg(math.PI)):016x}")
    let d32: f32 = 90.0
    print(f"{bits32(math.deg_to_rad(d32)):08x} {bits32(math.rad_to_deg(math.PI_F32)):08x}")
    print(f"{bits(math.PI):016x} {bits(math.TAU):016x} {bits(math.E):016x} {bits(math.EPSILON):016x}")
    print(f"{bits32(math.PI_F32):08x} {bits32(math.TAU_F32):08x} {bits32(math.E_F32):08x} {bits32(math.EPSILON_F32):08x}")
    print(f"{bits32(math.inf_f32()):08x} {bits(math.inf()):016x}")
}
