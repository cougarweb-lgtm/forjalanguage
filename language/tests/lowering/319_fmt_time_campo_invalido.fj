// IA1-S2h (D-FMT): format_time com hora fora das faixas (hora 24) e erro de quem chama: panic (R0003). Com a hora certa a conta vale (a fracao de segundo nao conta).
import "std:fmt" as fmt
import "std:time" as tm

proc main() {
    let bom = tm.DateTime{hour = 23, minute = 59, second = 59, nanosecond = 999999999}
    let a = fmt.format_time(bom, loc = fmt.EN_US, seconds = true, alloc = heap)
    print(a)
    delete(a)
    let ruim = tm.DateTime{hour = 24}
    let b = fmt.format_time(ruim, loc = fmt.EN_US, alloc = heap)
    print(b)
    delete(b)
    print("nao chega")
}
