// v1.11 L15b (A08, E0335): append numa lista fixa cheia ([dynamic, 3]int com len 3) e R0007 nos dois modos, exit 101.
proc main() {
    var trio: [dynamic, 3]int = {}
    append(&trio, item = 1)
    append(&trio, item = 2)
    append(&trio, item = 3)
    print(len(trio))
    append(&trio, item = 4)
    print(len(trio))
}
