unit Metros: f32
unit Segundos: f32
unit MetrosPorSegundo = Metros / Segundos

proc main() {
    let d1: Metros = 10.0
    let d2: Metros = 5.0
    print((d1 + d2) as int)
    let t: Segundos = 2.0
    let v: MetrosPorSegundo = d1 / t
    print(v as int)
    let d3: Metros = v * t
    print(d3 as int)
    print(d1 > d2)
    print(d1 == d2)
}
