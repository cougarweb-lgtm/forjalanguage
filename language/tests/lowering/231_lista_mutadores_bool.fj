// IA1-L9c/L9d: insert_at, remove_value, pop, clone, replace_value, fill, swap, reverse e copy em lista e array de bool.
proc dump(s: []bool) {
    print(len(s))
    for x in s {
        print(x)
    }
}

proc main() {
    var l = make([dynamic]bool, alloc = heap, cap = 2)
    print(pop(&l) == none)
    append(&l, item = true)
    insert_at(&l, 0, false)
    insert_at(&l, 2, false)
    insert_at(&l, 1, true)
    dump(l[..])
    print(remove_value(&l, false))
    print(remove_value(&l, false))
    print(remove_value(&l, false))
    dump(l[..])
    var c = clone(l, alloc = heap)
    append(&c, item = false)
    replace_value(c, true, false, n = 1)
    dump(c[..])
    replace_value(c, false, true)
    dump(c[..])
    fill(c, false)
    dump(c[..])
    var a: [3]bool = {true, false, false}
    swap(a, 0, 2)
    dump(a[..])
    reverse(a)
    dump(a[..])
    print(copy(c, a))
    dump(c[..])
    ordered_remove(&c, 1)
    unordered_remove(&c, 0)
    dump(c[..])
    print(pop(&c) or_else true)
    print(pop(&c) or_else true)
    delete(l)
    delete(c)
}
