struct Camera {
    x: i32 = 7
    y: i32
    z: i32
}

proc main() {
    let c = Camera{
        x = 1,
        y = 2,
        z = 3,
    }
    print(c.x)
    print(c.y)
    print(c.z)
    let d = Camera{
        y = 20,
        z = 30
    }
    print(d.x + d.y + d.z)
    let e = Camera{
    }
    print(e.x)
}
