// K15 (set_intersect): sai de a o que nao esta em b; o remove anda de tras para frente. a = {1..6}, b = {2, 4, 6, 9}: a vira {2, 4, 6}.
proc main() {
    var a = make(map[int]bool, alloc = heap)
    var b = make(map[int]bool, alloc = heap)
    for i in 1..=6 {
        insert(&a, key = i, value = true)
    }
    insert(&b, key = 2, value = true)
    insert(&b, key = 4, value = true)
    insert(&b, key = 6, value = true)
    insert(&b, key = 9, value = true)
    set_intersect(&a, b)
    print(len(a))
    print(has(a, key = 1))
    print(has(a, key = 2))
    print(has(a, key = 5))
    print(has(a, key = 6))
    delete(a)
    delete(b)
}
