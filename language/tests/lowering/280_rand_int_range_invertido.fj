// IA1-S2d1 (A20): int_range com min > max e erro de quem chama: panic (R0003). min == max vale (da sempre esse valor).
import "std:rand" as rand

proc main() {
    var rng = rand.seed(1)
    print(rand.int_range(&rng, min = 4, max = 4))
    print(rand.int_range(&rng, min = 5, max = 4))
    print("nao chega")
}
