// IA1-S2g (D-FMT): std:fmt, bytes (forma dona e write_bytes): tamanho em unidades com inteiro EXATO (nada de f64). binary = true (padrao) usa base 1024 (B KiB MiB GiB TiB PiB EiB); false usa base 1000 (B kB MB GB TB PB EB). Abaixo de 1 unidade-base: inteiro + " B"; senao 1 casa half_up sobre a fracao exata, ",0" cortado; o vai-um que estoura a base promove a unidade (1048575 -> "1 MiB"); no maior expoente nao promove (maior int = "8 EiB").
// Colunas: n | pt-BR binario | pt-BR SI | en-US binario | en-US SI. Oraculo Python independente (scratchpad, sem o forja; Fraction).
import "std:fmt" as fmt

const MAIOR: int = 9223372036854775807
const MENOR: int = -9223372036854775807 - 1

// Uma linha: n e as 4 colunas, a binaria em pt-BR pela forma dona e as outras por write_bytes.
proc caso(n: int) {
    var buf = make([dynamic]u8, alloc = heap, cap = 128)
    defer delete(buf)
    format(f"{n}|", into = &buf)
    let pt = fmt.bytes(n, loc = fmt.PT_BR, alloc = heap)
    append(&buf, item = pt)
    delete(pt)
    append(&buf, item = "|")
    fmt.write_bytes(n, buf = &buf, loc = fmt.PT_BR, binary = false)
    append(&buf, item = "|")
    fmt.write_bytes(n, buf = &buf, loc = fmt.EN_US)
    append(&buf, item = "|")
    let en = fmt.bytes(n, loc = fmt.EN_US, binary = false, alloc = heap)
    append(&buf, item = en)
    delete(en)
    let linha = to_str(&buf)
    defer delete(linha)
    print(linha)
}

// Perto da base, das fronteiras e dos vai-um.
proc casos_pequenos() {
    caso(0)
    caso(1)
    caso(999)
    caso(1000)
    caso(1001)
    caso(1023)
    caso(1024)
    caso(1025)
    caso(1075)
    caso(1076)
    caso(1536)
    caso(1949)
    caso(1950)
    caso(10240)
    caso(10291)
    caso(10547)
    caso(999949)
    caso(999950)
    caso(999999)
    caso(1000000)
    caso(1048063)
    caso(1048064)
    caso(1048575)
    caso(1048576)
    caso(1572864)
    caso(1000000000)
    caso(1073741823)
    caso(1073741824)
    caso(1099511627776)
    caso(1000000000000)
    caso(999999999999999)
}

// Os expoentes altos, o maior e o menor int, e os negativos.
proc casos_grandes() {
    caso(1125899906842624)
    caso(1000000000000000)
    caso(1152921504606846975)
    caso(1152921504606846976)
    caso(1729382256910270464)
    caso(999999999999999999)
    caso(1000000000000000000)
    caso(4611686018427387904)
    caso(9000000000000000000)
    caso(MAIOR)
    caso(MENOR)
    caso(MENOR + 1)
    caso(-1)
    caso(-1023)
    caso(-1024)
    caso(-1536)
    caso(-1048575)
    caso(-999999)
}

proc main() {
    casos_pequenos()
    casos_grandes()
}
