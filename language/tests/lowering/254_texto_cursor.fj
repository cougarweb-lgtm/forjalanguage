// IA1-L10a (T05): std:text next_line(&rest) e next_field(&rest, sep): cursor sem alocar, `rest` e uma `var str` passada por endereco; devolve ?str (none quando acabou).
// next_line: \n ou \r\n sem o terminador; a ultima linha sem terminador conta; "a\n" da so "a"; texto vazio = nenhuma linha; um \r solto fica na linha.
// next_field: sep e str ("," ou ", " ou "::"); "a,,b" da "a" "" "b"; separador no fim nao gera campo vazio final; sep vazio devolve o resto inteiro.
// Cada linha e montada no builder e impressa com \r \n \t escritos como \r \n \t (o .esperado nao distingue CRLF de LF).
import "std:text" as tx

const LINHAS: [12]str = {"", "a", "a\n", "a\nb", "a\r\nb\r\n", "\n", "\n\n", "a\r", "\r\n\r\n", "x\r\r\ny", "línea\nñ\n", "um\r\ndois\ntres"}
const CAMPOS: [12]str = {"", "a", "a,b", "a,,b", "a,b,", ",", ",,", "a, b, c", "a::b::", "::x", "é;ü;日", "a:b::c"}
const SEPARADORES: [6]str = {"", ",", ", ", "::", ";", ":"}

// Escreve o byte b no builder; \r, \n e \t saem como barra + letra.
proc anexa_visivel(saida: ^[dynamic]u8, b: u8) {
    if b == 13 {
        append(saida, item = "\\r")
    } else if b == 10 {
        append(saida, item = "\\n")
    } else if b == 9 {
        append(saida, item = "\\t")
    } else {
        append(saida, item = b)
    }
}

// Imprime o que esta no builder `linha` com os controles visiveis e o esvazia (to_str move os bytes).
proc mostra(linha: ^[dynamic]u8) {
    let texto = to_str(linha)
    defer delete(texto)
    var saida = make([dynamic]u8, alloc = heap)
    defer delete(saida)
    for i in 0..<len(texto) {
        anexa_visivel(&saida, b = texto[i])
    }
    let visivel = to_str(&saida)
    defer delete(visivel)
    print(visivel)
}

proc mostra_itens(linha: ^[dynamic]u8, itens: []str) {
    for item in itens {
        format(f"  <{item}> {len(item)}", into = linha)
        mostra(linha)
    }
}

proc percorre_linhas(linha: ^[dynamic]u8, a: int, s: str) {
    var resto = s
    var vistas = make([dynamic]str, alloc = heap)
    defer delete(vistas)
    while true {
        let proxima = tx.next_line(&resto)
        if proxima == none {
            break
        }
        append(&vistas, item = proxima or_else "")
    }
    print(f"linhas {a} {len(vistas)}")
    mostra_itens(linha, itens = vistas[..])
}

proc percorre_campos(linha: ^[dynamic]u8, a: int, b: int, s: str) {
    var resto = s
    var vistos = make([dynamic]str, alloc = heap)
    defer delete(vistos)
    while true {
        let campo = tx.next_field(&resto, sep = SEPARADORES[b])
        if campo == none {
            break
        }
        append(&vistos, item = campo or_else "")
    }
    print(f"campos {a} {b} {len(vistos)}")
    mostra_itens(linha, itens = vistos[..])
}

proc main() {
    var linha = make([dynamic]u8, alloc = heap)
    defer delete(linha)
    for a in 0..<len(LINHAS) {
        percorre_linhas(&linha, a = a, s = LINHAS[a])
    }
    for a in 0..<len(CAMPOS) {
        for b in 0..<len(SEPARADORES) {
            percorre_campos(&linha, a = a, b = b, s = CAMPOS[a])
        }
    }
}
