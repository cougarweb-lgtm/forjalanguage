// IA1-L9e: sum de inteiros estoura como `a + b`: R0002 em dev (u8 200 + 100); em release da a volta (44) e o programa segue.
proc main() {
    var l = make([dynamic]u8, alloc = heap, cap = 4)
    defer delete(l)
    append(&l, item = 200)
    append(&l, item = 30)
    print(sum(l))
    append(&l, item = 70)
    print(1)
    print(sum(l))
    print(2)
}
