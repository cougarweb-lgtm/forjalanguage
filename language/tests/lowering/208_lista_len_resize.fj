// L-05 (IA1-L5b): make(..., len = n) e resize(&l, len = n). Os elementos novos saem zerados (inteiro, real e bool); encolher so muda o len; crescer alem da capacidade realoca.
proc soma(l: []i32) -> i32 {
    var t: i32 = 0
    for x in l {
        t += x
    }
    return t
}

proc main() {
    var a = make([dynamic]i32, alloc = heap, len = 5)
    print(len(a))
    print(a[0])
    print(a[4])
    a[2] = 7
    resize(&a, len = 3)
    print(len(a))
    print(a[2])
    resize(&a, len = 40)
    print(len(a))
    print(a[2])
    print(a[39])
    print(soma(a[..]))
    resize(&a, len = 0)
    print(len(a))
    resize(&a, len = 2)
    print(a[0] + a[1])
    delete(a)

    var b = make([dynamic]f64, alloc = heap, cap = 2, len = 6)
    print(len(b))
    b[5] = 2.5
    resize(&b, len = 100)
    print(b[5])
    print(b[99])
    delete(b)

    var c = make([dynamic]bool, alloc = heap)
    resize(&c, len = 3)
    print(c[1])
    c[1] = true
    resize(&c, len = 10)
    print(c[1])
    print(c[9])
    delete(c)

    var d = make([dynamic]u8, alloc = frame, len = 4)
    d[3] = 255
    resize(&d, len = 1000)
    print(d[3])
    print(d[999])
    frame_reset()
}
