// IA1-L10a (T09): std:text is_digit, is_alpha, is_alnum, is_space, is_upper, is_lower, is_hex_digit e is_print sobre TODOS os 256 valores de byte (ASCII; byte >= 128 nao e classe nenhuma).
// is_space = ' ' \t \n \v \f \r (9..13 e 32); is_print = 32..126.
import "std:text" as tx

proc main() {
    for valor in 0..<256 {
        let b = valor as u8
        let digito = tx.is_digit(b)
        let letra = tx.is_alpha(b)
        let letra_ou_digito = tx.is_alnum(b)
        let espaco = tx.is_space(b)
        let maiuscula = tx.is_upper(b)
        let minuscula = tx.is_lower(b)
        let hexa = tx.is_hex_digit(b)
        let imprimivel = tx.is_print(b)
        print(f"{valor} {digito} {letra} {letra_ou_digito} {espaco} {maiuscula} {minuscula} {hexa} {imprimivel}")
    }
}
