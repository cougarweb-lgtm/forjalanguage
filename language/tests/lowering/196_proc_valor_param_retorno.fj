proc dobrar(valor: i32) -> i32 {
    return valor * 2
}

proc triplicar(valor: i32) -> i32 {
    return valor * 3
}

proc somar(a: i32, b: i32) -> i32 {
    return a + b
}

proc aplicar(f: proc(x: i32) -> i32, n: i32) -> i32 {
    return f(n)
}

proc combinar(g: proc(a: i32, b: i32) -> i32) -> i32 {
    return g(1, b = 2)
}

proc escolher(dobro: bool) -> proc(x: i32) -> i32 {
    if dobro {
        return dobrar
    }
    return triplicar
}

proc repassar(f: proc(x: i32) -> i32) -> proc(x: i32) -> i32 {
    return f
}

struct Par {
    esquerda: proc(x: i32) -> i32
    direita: proc(x: i32) -> i32
}

proc montar(a: proc(x: i32) -> i32, b: proc(x: i32) -> i32) -> Par {
    return Par{esquerda = a, direita = b}
}

proc main() {
    var k: proc(x: i32) -> i32 = dobrar
    print(aplicar(k, n = 4))
    k = escolher(false)
    print(aplicar(k, n = 5))
    print(combinar(somar))
    print(escolher(true)(7))
    print(repassar(triplicar)(3))
    let par = montar(dobrar, b = triplicar)
    print(par.esquerda(10))
    print(par.direita(10))
    print(aplicar(par.direita, n = 2) + aplicar(par.esquerda, n = 2))
}
