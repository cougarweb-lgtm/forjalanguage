// IA1-L9f (T11): format(f"...", into = &buf) formata como o format e ANEXA ao builder (instrucao, sem valor). Inteiros (negativo, i64 minimo, :05), hex de sem sinal,
// bool, str, f64 e f32 com precisao, mistura com append de str e o builder passado a outro proc como ^[dynamic]u8.
proc linha(buf: ^[dynamic]u8, n: int, nome: str) {
    format(f"[{n:03}:{nome}]", into = buf)
    append(buf, item = "\n")
}

proc main() {
    var buf = make([dynamic]u8, alloc = heap)
    defer delete(buf)
    let palavra = "x"
    let neg = -5
    let ok = true
    let minimo: int = -9223372036854775807 - 1
    let grande: u64 = 255
    let r = 2.5
    let q: f32 = 3.14159
    append(&buf, item = "[inicio]")
    format(f"|{neg}|{42:05}|{ok}|{palavra}|{r:.3}|{q:.2}|", into = &buf)
    append(&buf, item = "é")
    format(f"|{minimo}|{0:03}|{grande:x}|{grande:04x}|{false}|", into = &buf)
    format(f"", into = &buf)
    linha(&buf, 7, "sete")
    linha(&buf, 1234, "mil")
    let s = to_str(&buf)
    print(s)
    print(len(s))
    delete(s)
    format(f"depois do to_str {1}", into = &buf)
    let t = to_str(&buf)
    print(t)
    delete(t)
}
