// IA1-S2c (T12): pad_left cuja largura faria o resultado passar do maior int (largura gigante com fill de 2 bytes): panic (R0003) com mensagem, nunca texto truncado.
// O print antes prova que a largura pequena funciona; a gigante para o programa.
import "std:text" as tx

const LARGURA_GIGANTE: int = 9223372036854775807

proc main() {
    let curto = tx.pad_left("a", 3, fill = 183, alloc = heap)
    defer delete(curto)
    print(curto)
    let enorme = tx.pad_left("a", LARGURA_GIGANTE, fill = 183, alloc = heap)
    defer delete(enorme)
    print("nao chega")
}
