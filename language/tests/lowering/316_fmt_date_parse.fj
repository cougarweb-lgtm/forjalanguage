// IA1-S2h (D-FMT): std:fmt, leitura de datas e horas por regiao: parse_pattern, parse_date e parse_time. Primeiro a ida e volta em massa (9 regioes x 8 datas x 7 horas x 3 estilos de data e 2 de hora: parse(format(x)) tem de dar x), depois casos escritos um a um.
// Cada caso: p regiao [padrao] [texto] -> ok aaaa-mm-dd hh:mm:ss | ERR nome, e `@N` = o `at` (offset em bytes de s do 1o byte ruim; -1 = intocado, o contrato e gravar so no erro). Conferido contra o oraculo Python independente (scratchpad, sem o forja); os casos sao lidos deste arquivo pelo oraculo.
import "std:fmt" as fmt
import "std:time" as tm

const YEARS: [8]int = {1970, 2000, 1999, 2024, 1600, 2300, 99, 2100}
const MONTHS: [8]int = {1, 2, 12, 2, 1, 12, 7, 2}
const DAYS: [8]int = {1, 29, 31, 29, 1, 31, 15, 28}
const HOURS: [7]int = {0, 1, 11, 12, 12, 13, 23}
const MINUTES: [7]int = {0, 5, 59, 0, 30, 0, 59}
const SECONDS: [7]int = {0, 9, 59, 0, 45, 0, 59}

proc nome_erro(e: fmt.DateError) -> str {
    switch e {
    case fmt.DateError.empty:
        return "empty"
    case fmt.DateError.invalid_pattern:
        return "invalid_pattern"
    case fmt.DateError.mismatch:
        return "mismatch"
    case fmt.DateError.out_of_range:
        return "out_of_range"
    }
    return "?"
}

// Os 6 campos de a e b (a fracao fica de fora) batem?
proc igual(a: tm.DateTime, b: tm.DateTime) -> bool {
    return a.year == b.year and a.month == b.month and a.day == b.day and a.hour == b.hour and a.minute == b.minute and a.second == b.second
}

// Soma 1 a falhas se a leitura nao deu o esperado (erro de leitura vira o ano -1, que nunca e esperado).
proc confere_data(lido: tm.DateTime, esperado: tm.DateTime, falhas: ^int) {
    if not igual(lido, esperado) {
        falhas^ += 1
    }
}

// Uma regiao: format -> parse de todas as combinacoes.
proc ida_e_volta(loc: fmt.Locale) {
    let estilos: [3]fmt.DateStyle = {fmt.DateStyle.short, fmt.DateStyle.long, fmt.DateStyle.full}
    let erro = tm.DateTime{year = -1}
    var total = 0
    var falhas = 0
    for di in 0..<8 {
        for ti in 0..<7 {
            let dt = tm.DateTime{year = YEARS[di], month = MONTHS[di], day = DAYS[di], hour = HOURS[ti], minute = MINUTES[ti], second = SECONDS[ti]}
            let so_data = tm.DateTime{year = YEARS[di], month = MONTHS[di], day = DAYS[di]}
            for si in 0..<3 {
                let s = fmt.format_date(dt, loc = loc, style = estilos[si], alloc = heap)
                confere_data(fmt.parse_date(s, loc = loc, style = estilos[si]) or_else erro, so_data, &falhas)
                delete(s)
                total += 1
            }
            let curta = tm.DateTime{hour = HOURS[ti], minute = MINUTES[ti]}
            let t1 = fmt.format_time(dt, loc = loc, alloc = heap)
            confere_data(fmt.parse_time(t1, loc = loc) or_else erro, curta, &falhas)
            delete(t1)
            let media = tm.DateTime{hour = HOURS[ti], minute = MINUTES[ti], second = SECONDS[ti]}
            let t2 = fmt.format_time(dt, loc = loc, seconds = true, alloc = heap)
            confere_data(fmt.parse_time(t2, loc = loc, seconds = true) or_else erro, media, &falhas)
            delete(t2)
            total += 2
        }
    }
    print(f"ida e volta {loc.tag} total={total} falhas={falhas}")
}

// Leitura boa no builder: "ok aaaa-mm-dd hh:mm:ss @pos".
proc junta_ok(buf: ^[dynamic]u8, v: tm.DateTime, pos: int) {
    format(f"ok {v.year:04}-{v.month:02}-{v.day:02} {v.hour:02}:{v.minute:02}:{v.second:02} @{pos}", into = buf)
}

// Leitura ruim no builder: "ERR nome @pos".
proc junta_erro(buf: ^[dynamic]u8, e: fmt.DateError, pos: int) {
    format(f"ERR {nome_erro(e)} @{pos}", into = buf)
}

proc imprime(buf: ^[dynamic]u8) {
    let texto = to_str(buf)
    print(texto)
    delete(texto)
}

// parse_pattern.
proc caso(tag: str, pattern: str, texto: str) {
    let loc = fmt.find_locale(tag) or_else fmt.ISO
    var pos = -1
    var buf = make([dynamic]u8, alloc = heap, cap = 128)
    defer delete(buf)
    format(f"p {tag} [{pattern}] [{texto}] -> ", into = &buf)
    switch v in fmt.parse_pattern(texto, pattern, loc = loc, at = &pos) {
    case tm.DateTime:
        junta_ok(&buf, v, pos)
    case fmt.DateError:
        junta_erro(&buf, v, pos)
    }
    imprime(&buf)
}

// parse_date no estilo 0 = short, 1 = long, 2 = full.
proc caso_data(tag: str, estilo: int, texto: str) {
    let loc = fmt.find_locale(tag) or_else fmt.ISO
    let estilos: [3]fmt.DateStyle = {fmt.DateStyle.short, fmt.DateStyle.long, fmt.DateStyle.full}
    var pos = -1
    var buf = make([dynamic]u8, alloc = heap, cap = 128)
    defer delete(buf)
    format(f"d {tag} {estilo} [{texto}] -> ", into = &buf)
    switch v in fmt.parse_date(texto, loc = loc, style = estilos[estilo], at = &pos) {
    case tm.DateTime:
        junta_ok(&buf, v, pos)
    case fmt.DateError:
        junta_erro(&buf, v, pos)
    }
    imprime(&buf)
}

// parse_time curto (segundos = false) ou medio (true).
proc caso_hora(tag: str, segundos: bool, texto: str) {
    let loc = fmt.find_locale(tag) or_else fmt.ISO
    var pos = -1
    var buf = make([dynamic]u8, alloc = heap, cap = 128)
    defer delete(buf)
    format(f"t {tag} {segundos} [{texto}] -> ", into = &buf)
    switch v in fmt.parse_time(texto, loc = loc, seconds = segundos, at = &pos) {
    case tm.DateTime:
        junta_ok(&buf, v, pos)
    case fmt.DateError:
        junta_erro(&buf, v, pos)
    }
    imprime(&buf)
}

