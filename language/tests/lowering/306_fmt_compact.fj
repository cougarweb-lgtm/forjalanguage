// IA1-S2g (D-FMT): std:fmt, compact (forma dona e write_compact): estilo curto CLDR, ate 2 algarismos significativos, na 1a coluna o valor em %.17g e depois pt-BR, en-US, fr-FR e de-DE.
// Regras: abaixo de 1000 e o inteiro half_up sem sufixo; depois mil/milhao/bilhao/trilhao; escalado < 10 tem 1 casa (o ",0" final some), >= 10 nao tem; o vai-um promove a unidade (999950 -> "1 mi", 9950 -> "10 mil", 999500 -> "1 mi"); de 1e15 em diante e o trilhao com o inteiro agrupado ("5.000 tri"); sinal na frente; NaN e infinito sem sufixo. Oraculo Python independente (scratchpad, sem o forja).
import "std:fmt" as fmt

// O f64 com esses bits (NaN, infinito e 1e308 sem depender de literal com expoente).
proc bits(b: u64) -> f64 {
    return transmute(b, to = f64)
}

// Acrescenta |pt-BR|en-US|fr-FR|de-DE de v ao builder, uma pela forma dona e outra pela write_compact.
proc colunas(buf: ^[dynamic]u8, v: f64) {
    append(buf, item = "|")
    fmt.write_compact(v, buf = buf, loc = fmt.PT_BR)
    append(buf, item = "|")
    let en = fmt.compact(v, loc = fmt.EN_US, alloc = heap)
    append(buf, item = en)
    delete(en)
    append(buf, item = "|")
    fmt.write_compact(v, buf = buf, loc = fmt.FR_FR)
    append(buf, item = "|")
    let de = fmt.compact(v, loc = fmt.DE_DE, alloc = heap)
    append(buf, item = de)
    delete(de)
}

// Um caso com o valor impresso em %.17g.
proc caso(v: f64) {
    var buf = make([dynamic]u8, alloc = heap, cap = 128)
    defer delete(buf)
    format(f"{v}", into = &buf)
    colunas(&buf, v)
    let linha = to_str(&buf)
    defer delete(linha)
    print(linha)
}

// Um caso com rotulo fixo (NaN e infinito nao tem %.17g portavel).
proc especial(nome: str, v: f64) {
    var buf = make([dynamic]u8, alloc = heap, cap = 128)
    defer delete(buf)
    append(&buf, item = nome)
    colunas(&buf, v)
    let linha = to_str(&buf)
    defer delete(linha)
    print(linha)
}

// Abaixo de 1000: inteiro half_up, sem sufixo; zero sem sinal.
proc casos_pequenos() {
    caso(0.0)
    caso(-0.0)
    caso(0.4)
    caso(0.5)
    caso(0.49)
    caso(1.0)
    caso(1.4)
    caso(1.5)
    caso(2.5)
    caso(-2.5)
    caso(12.5)
    caso(99.5)
    caso(999.0)
    caso(999.4)
    caso(999.5)
    caso(999.49999)
    caso(-0.004)
    caso(-999.4)
}

// Mil, milhao, bilhao e a promocao de unidade pelo vai-um.
proc casos_medios() {
    caso(1000.0)
    caso(1001.0)
    caso(1049.0)
    caso(1050.0)
    caso(1051.0)
    caso(1500.0)
    caso(1949.0)
    caso(1950.0)
    caso(9949.0)
    caso(9950.0)
    caso(9999.0)
    caso(10000.0)
    caso(12345.0)
    caso(99949.0)
    caso(99950.0)
    caso(99999.0)
    caso(100000.0)
    caso(999499.0)
    caso(999500.0)
    caso(999949.0)
    caso(999950.0)
    caso(999999.0)
    caso(1000000.0)
    caso(1049999.0)
    caso(1050000.0)
    caso(1200000000.0)
    caso(1500000000.0)
    caso(999950000.0)
    caso(999999999.0)
    caso(-1.0)
    caso(-1500.0)
    caso(-999.5)
    caso(-999500.0)
    caso(-999950.0)
}

// Trilhao e acima: sem unidade maior, o inteiro cresce agrupado.
proc casos_grandes() {
    caso(1000000000000.0)
    caso(1234567890123.0)
    caso(999999999999.0)
    caso(15000000000000.0)
    caso(999500000000000.0)
    caso(1000000000000000.0)
    caso(5000000000000000.0)
    caso(-5000000000000000.0)
    caso(123456789012345678.0)
    caso(bits(9214871658872686752))
    especial("NaN", bits(9221120237041090560))
    especial("Inf", bits(9218868437227405312))
    especial("-Inf", bits(18442240474082181120))
}

proc main() {
    casos_pequenos()
    casos_medios()
    casos_grandes()
}
