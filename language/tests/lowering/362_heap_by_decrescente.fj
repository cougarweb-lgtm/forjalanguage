// K17 (heap_push_by / heap_pop_by): less decrescente (a.chave > b.chave) faz max-heap; o proc de less e o mesmo tipo do sort_by. Saida: 9 7 5 3 1 e 0.
struct Item {
    chave: int
    seq: int
}

proc maior_chave(a: ^Item, b: ^Item) -> bool {
    return a.chave > b.chave
}

proc main() {
    var h = make([dynamic]Item, alloc = heap)
    heap_push_by(&h, Item{chave = 3, seq = 1}, less = maior_chave)
    heap_push_by(&h, Item{chave = 9, seq = 2}, less = maior_chave)
    heap_push_by(&h, Item{chave = 1, seq = 3}, less = maior_chave)
    heap_push_by(&h, Item{chave = 7, seq = 4}, less = maior_chave)
    heap_push_by(&h, Item{chave = 5, seq = 5}, less = maior_chave)
    let a = heap_pop_by(&h, less = maior_chave) or_else Item{chave = -1, seq = 0}
    print(a.chave)
    let b = heap_pop_by(&h, less = maior_chave) or_else Item{chave = -1, seq = 0}
    print(b.chave)
    let c = heap_pop_by(&h, less = maior_chave) or_else Item{chave = -1, seq = 0}
    print(c.chave)
    let d = heap_pop_by(&h, less = maior_chave) or_else Item{chave = -1, seq = 0}
    print(d.chave)
    let e = heap_pop_by(&h, less = maior_chave) or_else Item{chave = -1, seq = 0}
    print(e.chave)
    print(len(h))
    delete(h)
}
