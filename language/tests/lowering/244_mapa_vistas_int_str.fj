// IA1-L9e: keys, values e clear em map[int]str (valor texto) e em map[int]int com 100 pares (a tabela cresce): clear deixa o map vazio e usavel; keys e values alinhadas.
proc main() {
    var m = make(map[int]str, alloc = heap)
    defer delete(m)
    insert(&m, key = 7, value = "sete")
    insert(&m, key = -3, value = "menos tres")
    insert(&m, key = 0, value = "")
    insert(&m, key = 12, value = "aé€")
    var k = keys(m, alloc = heap)
    defer delete(k)
    var v = values(m, alloc = heap)
    defer delete(v)
    print(len(k))
    for i in 0..<len(k) {
        print(k[i])
        print(v[i])
        print(len(v[i]))
    }
    clear(&m)
    print(len(m))
    var depois = values(m, alloc = heap)
    defer delete(depois)
    print(len(depois))
    insert(&m, key = 1, value = "um")
    print(get(m, key = 1) or_else "nada")
    print(get(m, key = 7) or_else "nada")

    var g = make(map[int]int, alloc = heap)
    defer delete(g)
    for i in 0..<100 {
        insert(&g, key = i * 3, value = i * i)
    }
    var gk = keys(g, alloc = heap)
    defer delete(gk)
    var gv = values(g, alloc = heap)
    defer delete(gv)
    print(len(gk))
    print(sum(gk))
    print(sum(gv))
    print(min_of(gk) or_else -1)
    print(max_of(gv) or_else -1)
    print(gk[10])
    print(gv[10])
    clear(&g)
    print(len(g))
    print(has(g, key = 30))
    for i in 0..<5 {
        insert(&g, key = i, value = i + 100)
    }
    var gk2 = keys(g, alloc = heap)
    defer delete(gk2)
    var gv2 = values(g, alloc = heap)
    defer delete(gv2)
    print(len(gk2))
    print(sum(gk2))
    print(sum(gv2))
    print(get(g, key = 3) or_else -1)
}
