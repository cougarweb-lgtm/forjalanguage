foreign {
    proc getenv(nome: cstr) -> rawptr
    proc strtol(texto: cstr, fim: ?^rawptr, base: i32) -> i32
    proc memset(destino: rawptr, valor: i32, n: u64) -> rawptr
}

proc main() {
    print(getenv("FORJA_V14_NAO_EXISTE") == none)
    print(strtol("ff", fim = none, base = 16))
    var fim: rawptr = none
    print(strtol("12x", fim = &fim, base = 10))
    print(fim != none)
    var x: i32 = 0
    _ = memset(&x as rawptr, valor = 1, n = 4)
    print(x)
}
