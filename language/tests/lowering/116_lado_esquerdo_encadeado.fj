struct Grifo {
    vida: i32 = 10
}

struct Dono {
    alvo: ^Grifo
}

proc main() {
    var x: int = 1
    var p = &x
    let pp = &p
    pp^^ += 5
    print(x)
    var g = Grifo{}
    let d = Dono{alvo = &g}
    d.alvo.vida -= 1
    print(g.vida)
    let r = &g
    r^.vida += 2
    print(g.vida)
    d.alvo^.vida += 4
    print(g.vida)
}
