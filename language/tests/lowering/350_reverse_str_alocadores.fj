// S2a (reverse de str nos alocadores): heap com delete, frame com frame_reset no fim e Arena com arena_destroy no fim; sem R0009.
import "std:mem"

proc textos_heap() {
    let r = reverse("ação", alloc = heap)
    print(r)
    delete(r)
}

proc textos_frame() {
    let r = reverse("ação", alloc = frame)
    print(r)
}

proc textos_arena() {
    let a = mem.arena_create()
    let r = reverse("ação", alloc = a)
    print(r)
    mem.arena_destroy(a)
}

proc main() {
    textos_heap()
    textos_frame()
    frame_reset()
    textos_arena()
}
