// IA1-S2f (D-FMT): money com scale fora de 0..9 e erro de quem chama: panic (R0003). 9 casas ainda vale; 10 nao.
import "std:fmt" as fmt

proc main() {
    let ok = fmt.money(5899, loc = fmt.PT_BR, scale = 9, alloc = heap)
    print(ok)
    delete(ok)
    let ruim = fmt.money(5899, loc = fmt.PT_BR, scale = 10, alloc = heap)
    print(ruim)
    delete(ruim)
    print("nao chega")
}
