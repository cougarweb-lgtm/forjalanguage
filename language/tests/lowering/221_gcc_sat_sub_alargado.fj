// P-IA1-LG: erro do GCC 16.1.0 (-O2, passe tree-widening_mul) que lia `if a >= b { r = a - b }` como subtracao saturada e alargava o resultado com SINAL:
// 254 (u8) virava 18446744073709551614 ao ser alargado. O C emitido estava certo; o driver agora desliga o passe (driver\cc.c). Cada proc faz o `if a >= b { r = a - b }`
// em tipo estreito e depois alarga: retorno mais largo, f-string de ?T com or_else, campo u64 de struct. Os valores vem de listas e de um laco (o gcc nao dobra
// literais diretos, e o erro so aparecia com valor nao constante). Esperado de um oraculo Python (inteiros sem limite).
struct Caixa {
    v: u64
}

proc u8_para_u64(a: u8, b: u8) -> u64 {
    var r: u8 = 0
    if a >= b {
        r = a - b
    }
    return r as u64
}

proc u8_para_u32(a: u8, b: u8) -> u32 {
    var r: u8 = 0
    if a >= b {
        r = a - b
    }
    return r as u32
}

proc u8_para_u16(a: u8, b: u8) -> u16 {
    var r: u8 = 0
    if a >= b {
        r = a - b
    }
    return r as u16
}

proc u16_para_u64(a: u16, b: u16) -> u64 {
    var r: u16 = 0
    if a >= b {
        r = a - b
    }
    return r as u64
}

proc u16_para_u32(a: u16, b: u16) -> u32 {
    var r: u16 = 0
    if a >= b {
        r = a - b
    }
    return r as u32
}

proc u32_para_u64(a: u32, b: u32) -> u64 {
    var r: u32 = 0
    if a >= b {
        r = a - b
    }
    return r as u64
}

proc opcional_u8(a: u8, b: u8) {
    var r: ?u8 = none
    if a >= b {
        r = a - b
    }
    print(f"?u8 {a} {b} {r or_else 0}")
}

proc opcional_u16(a: u16, b: u16) {
    var r: ?u16 = none
    if a >= b {
        r = a - b
    }
    print(f"?u16 {a} {b} {r or_else 0}")
}

proc opcional_u32(a: u32, b: u32) {
    var r: ?u32 = none
    if a >= b {
        r = a - b
    }
    print(f"?u32 {a} {b} {r or_else 0}")
}

proc caixa_u8(a: u8, b: u8) -> Caixa {
    var r: u8 = 0
    if a >= b {
        r = a - b
    }
    return Caixa{v = r as u64}
}

proc caixa_u32(a: u32, b: u32) -> Caixa {
    var r: u32 = 0
    if a >= b {
        r = a - b
    }
    return Caixa{v = r as u64}
}

proc imprime_u8_na_hora(a: u8, b: u8) {
    var r: u8 = 0
    if a >= b {
        r = a - b
    }
    print(f"u8 na hora {a} {b} {r as u64}")
}

proc main() {
    let a8: [6]u8 = {255, 200, 255, 128, 100, 250}
    let b8: [6]u8 = {1, 100, 0, 127, 200, 251}
    let a16: [6]u16 = {65535, 40000, 65535, 30000, 100, 1000}
    let b16: [6]u16 = {1, 3, 0, 29999, 200, 1001}
    let a32: [6]u32 = {4294967295, 3000000000, 4294967295, 2147483648, 7, 100}
    let b32: [6]u32 = {1, 5, 0, 2147483647, 9, 101}
    for i in 0..<6 {
        print(f"u8 {a8[i]} {b8[i]} u64={u8_para_u64(a8[i], b8[i])} u32={u8_para_u32(a8[i], b8[i])} u16={u8_para_u16(a8[i], b8[i])}")
        print(f"u16 {a16[i]} {b16[i]} u64={u16_para_u64(a16[i], b16[i])} u32={u16_para_u32(a16[i], b16[i])}")
        print(f"u32 {a32[i]} {b32[i]} u64={u32_para_u64(a32[i], b32[i])}")
        opcional_u8(a8[i], b8[i])
        opcional_u16(a16[i], b16[i])
        opcional_u32(a32[i], b32[i])
        let c8 = caixa_u8(a8[i], b8[i])
        let c32 = caixa_u32(a32[i], b32[i])
        print(f"caixa {c8.v} {c32.v}")
        imprime_u8_na_hora(a8[i], b8[i])
    }
}
