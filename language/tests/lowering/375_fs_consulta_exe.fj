// S3 P6 (D8): consultas do sistema de arquivos do std:file sobre o proprio exe, a pasta dele e caminhos que nao existem. So consulta, nada e gravado: roda em cwd temporario do verificador de lowering (C == x64).
import "std:os" as sys
import "std:file" as fs
import "std:path" as pth

proc main() {
    let a = sys.args()
    let exe = a[0]
    print(fs.exists(exe))
    print(fs.is_file(exe))
    print(fs.is_dir(exe))
    switch r in fs.stat(exe) {
    case fs.FileInfo:
        print(r.size > 0)
        print(r.kind == fs.FileKind.file)
    case fs.FileError:
        print("erro")
    }
    let pasta = pth.dir(exe)
    print(fs.is_dir(pasta))
    print(fs.exists("caminho_que_nao_existe_s3p6/arq.txt"))
    switch r in fs.open("", mode = fs.OpenMode.read) {
    case fs.File:
        print("aberto")
    case fs.FileError:
        print(r == fs.FileError.not_found)
    }
    switch r in fs.read_dir("pasta_que_nao_existe_s3p6", alloc = heap) {
    case fs.DirList:
        print("lista")
        delete(r.items)
        delete(r.data)
    case fs.FileError:
        print(r == fs.FileError.not_found)
    }
}
