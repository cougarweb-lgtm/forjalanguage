// L-03 (IA1-L5a): print de f32/f64 fora do f"...": a forma mais curta que volta ao mesmo valor. Posicional com e10 em [-4, 16), cientifico fora disso; sem ".0" sobrando.
proc main() {
    print(1.5)
    print(1.0)
    print(0.1)
    print(-2.5)
    print(100.0)
    print(0.0)
    print(-0.0)
    print(0.0001)
    print(0.00001)
    let a: f32 = 16777216.0
    print(a)
    let b: f32 = 16777216.0 * 16777216.0 * 16777216.0
    print(b)
    let c: f32 = 1.0 / 1024.0 / 1024.0 / 1024.0
    print(c)
    let d: f64 = 0.1
    print(d)
    let e: f64 = 1.0 / 3.0
    print(e)
    let f: f64 = 123456789012345.0
    print(f)
    let g: f64 = 1234567890123456.0
    print(g)
    let h: f64 = 12345678901234567.0
    print(h)
    var grande: f64 = 1.0
    var pequeno: f64 = 1.0
    var passos = 0
    while passos < 300 {
        grande = grande * 10.0
        pequeno = pequeno / 10.0
        passos += 1
    }
    print(grande)
    print(pequeno)
    print(pequeno / 1000000000000000000.0)
    let k: f64 = 0.000025
    print(k)
    let l: f64 = -123.456
    print(l)
    let m: f64 = 0.1 + 0.2
    print(m)
    let n: f32 = 0.1 + 0.2
    print(n)
    let zero: f64 = 0.0
    let nao_numero: f64 = zero / zero
    print(nao_numero)
    let infinito: f64 = 1.0 / zero
    print(infinito)
    print(-infinito)
}
