// IA1-L9d: clone (lista dona nova, independente) de lista, array e fatia; replace_value em todos e com n = 1; vazia e ausente.
proc dump(s: []int) {
    print(len(s))
    for x in s {
        print(x)
    }
}

proc main() {
    var l = make([dynamic]int, alloc = heap, cap = 2)
    append(&l, item = 1)
    append(&l, item = 2)
    append(&l, item = 3)
    append(&l, item = 2)
    append(&l, item = 2)
    var c = clone(l, alloc = heap)
    c[0] = 100
    append(&c, item = 4)
    l[1] = 55
    dump(l[..])
    dump(c[..])
    replace_value(c, 2, 20)
    dump(c[..])
    replace_value(l, 2, 20, n = 1)
    dump(l[..])
    replace_value(l, 2, 21, n = 5)
    dump(l[..])
    replace_value(l, 9, 8)
    replace_value(l, 3, 3)
    dump(l[..])
    let arr: [3]int = {7, 8, 9}
    var ca = clone(arr, alloc = heap)
    ca[0] = 70
    append(&ca, item = 10)
    dump(ca[..])
    var cs = clone(l[1..<3], alloc = heap)
    dump(cs[..])
    var e = make([dynamic]int, alloc = heap, cap = 2)
    var ec = clone(e, alloc = heap)
    print(len(ec))
    replace_value(ec, 1, 2)
    append(&ec, item = 1)
    dump(ec[..])
    var vazio = clone(l[2..<2], alloc = heap)
    print(len(vazio))
    delete(l)
    delete(c)
    delete(ca)
    delete(cs)
    delete(e)
    delete(ec)
    delete(vazio)
}
