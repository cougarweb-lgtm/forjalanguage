// S3 P3 (L11b-1): importa std:math e usa SO math.PI. O rt_math.o nao deve entrar no exe: o tamanho bate com o do programa sem o import (medida manual no relato).
import "std:math" as math

proc bits(r: f64) -> u64 {
    return transmute(r, to = u64)
}

proc main() {
    print(f"{bits(math.PI):016x}")
}
