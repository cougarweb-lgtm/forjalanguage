// IA1-S2c (T12): std:text pad_left, pad_right e center; a largura conta RUNAS (nao bytes), fill e uma runa (i32) repetida, o padrao e o espaco. s com width runas ou mais, ou width <= 0, da copia de s.
// center: a sobra impar vai para a DIREITA (center("a", 4) = " a  "). fill invalido (surrogate U+D800) vira U+FFFD. Cada linha: texto | width | fill | <pad_left>runas <pad_right>runas <center>runas.
import "std:text" as tx

const TEXTOS: [7]str = {"", "a", "ab", "ção", "ñ", "😀", "é€😀"}
const LARGURAS: [9]int = {-3, 0, 1, 2, 3, 4, 5, 6, 9}
const PREENCHIMENTOS: [5]i32 = {32, 48, 183, 128512, 55296}

// Os tres resultados de s para width; k = 0 usa o fill padrao (sem passar o argumento), k > 0 usa PREENCHIMENTOS[k].
proc trio(s: str, width: int, k: int) -> (esquerda: str, direita: str, meio: str) {
    if k == 0 {
        return tx.pad_left(s, width, alloc = heap), tx.pad_right(s, width, alloc = heap), tx.center(s, width, alloc = heap)
    }
    let fill = PREENCHIMENTOS[k]
    return tx.pad_left(s, width, fill = fill, alloc = heap), tx.pad_right(s, width, fill = fill, alloc = heap), tx.center(s, width, fill = fill, alloc = heap)
}

proc main() {
    for s in TEXTOS {
        for width in LARGURAS {
            for k in 0..<len(PREENCHIMENTOS) {
                let esquerda, direita, meio = trio(s, width, k = k)
                defer delete(esquerda)
                defer delete(direita)
                defer delete(meio)
                let numero_fill = PREENCHIMENTOS[k] as u32
                print(f"<{s}> | {width} | {numero_fill} | <{esquerda}>{tx.rune_count(esquerda)} <{direita}>{tx.rune_count(direita)} <{meio}>{tx.rune_count(meio)}")
            }
        }
    }
}
