// v1.11 L15b (A08, E0335): lista fixa [dynamic, N]T no lowering: append ate cheio, copia independente, for nas 3 formas, fatia,
// struct com campo [dynamic, 8]i32, [dynamic, 4]f32 e retorno por valor. Mesmo resultado em dev e em release.
struct Grupo {
    ids: [dynamic, 8]i32
    nome: int
}

proc encher(n: int) -> [dynamic, 4]i32 {
    var saida: [dynamic, 4]i32 = {}
    for i in 0..<n {
        append(&saida, item = (i as i32) * 10)
    }
    return saida
}

proc main() {
    var cheia: [dynamic, 4]i32 = {}
    append(&cheia, item = 1)
    append(&cheia, item = 2)
    append(&cheia, item = 3)
    append(&cheia, item = 4)
    print(f"{len(cheia)} {cheia[0]} {cheia[3]}")

    var parcial: [dynamic, 4]i32 = {}
    append(&parcial, item = 1)
    append(&parcial, item = 2)
    let copia = parcial
    append(&parcial, item = 9)
    print(f"{len(copia)} {len(parcial)} {copia[1]} {parcial[2]}")
    parcial = {}
    print(f"{len(parcial)} {len(copia)}")

    var soma = 0
    for x in cheia {
        soma += x as int
    }
    print(soma)
    for &x in cheia {
        x^ = x^ * 2
    }
    for i, x in cheia {
        print(f"{i}:{x}")
    }

    let fatia = cheia[..]
    print(f"{len(fatia)} {fatia[1]}")

    var grupo = Grupo{nome = 7}
    append(&grupo.ids, item = 5)
    append(&grupo.ids, item = 6)
    print(f"{grupo.nome} {len(grupo.ids)} {grupo.ids[1]}")
    var outro = grupo
    append(&outro.ids, item = 7)
    print(f"{len(grupo.ids)} {len(outro.ids)}")

    var pesos: [dynamic, 4]f32 = {}
    append(&pesos, item = 0.5)
    append(&pesos, item = 1.25)
    print(f"{len(pesos)} {pesos[1]}")

    let feitos = encher(3)
    print(f"{len(feitos)} {feitos[0]} {feitos[2]}")
    let quatro = encher(4)
    var total = 0
    for x in quatro {
        total += x as int
    }
    print(total)
}
