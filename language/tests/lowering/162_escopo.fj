struct Grifo {
    vida: i32 = 5
}

proc soma(n: int) -> int {
    var l = make([dynamic]int, alloc = scope)
    for i in 0..<n {
        append(&l, item = i)
    }
    var t = 0
    for x in l {
        t += x
    }
    return t
}

proc main() {
    var total = 0
    for k in 0..<3 {
        let g = new(Grifo, alloc = scope)
        total += g.vida as int
        let s = format(f"k{k}", alloc = scope)
        print(s)
    }
    print(total)
    print(soma(5))
}
