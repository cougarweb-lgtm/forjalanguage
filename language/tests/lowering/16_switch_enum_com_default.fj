enum Dir { cima, baixo, esq, dir }

proc classificar(d: Dir) {
    switch d {
    case Dir.cima:
        print(1)
    case Dir.baixo:
        print(2)
    default:
        print(3)
    }
}

proc main() {
    classificar(Dir.cima)
    classificar(Dir.baixo)
    classificar(Dir.esq)
    classificar(Dir.dir)
}
