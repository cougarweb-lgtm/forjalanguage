proc main() {
    var quadro = 0
    while quadro < 3 {
        var l = make([dynamic]int, alloc = frame, cap = 1)
        for i in 0..<5 {
            append(&l, item = i + quadro)
        }
        print(l[4])
        let p = new(int, alloc = frame)
        p^ = quadro * 100
        print(p^)
        delete(p)
        delete(l)
        frame_reset()
        quadro += 1
    }
}
