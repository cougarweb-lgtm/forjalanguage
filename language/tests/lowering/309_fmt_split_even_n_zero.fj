// IA1-S2g (D-FMT): split_even com n <= 0 e erro de quem chama: panic (R0003). n = 1 ainda vale.
import "std:fmt" as fmt

proc main() {
    var ok = fmt.split_even(10, 1, alloc = heap)
    print(ok[0])
    delete(ok)
    var ruim = fmt.split_even(10, 0, alloc = heap)
    print(len(ruim))
    delete(ruim)
    print("nao chega")
}
