// v1.11 L1 (K2/A15): literal inteiro em contexto real vira o real de mesmo valor (so se exato); o C emitido e o de quem escreveu 1.0.
unit Metros: f32

struct Ponto {
    x: f32
    y: f32
}

proc dobro(v: f32) -> f32 {
    return v * 2
}

proc um() -> f64 {
    return 1
}

proc main() {
    let a: f32 = 1
    var b: f64 = 2
    b = b + 3
    let c: [3]f32 = {1, 2, 3}
    let p = Ponto{x = 7, y = -2}
    let d: Metros = 4
    let g: f32 = 16777216
    let h: f64 = 9007199254740992
    let soma = a * 2 + 1 - 0.5
    print(a as int)
    print(b as int)
    print(c[2] as int)
    print(p.x as int)
    print(p.y as int)
    print(d as int)
    print(dobro(4) as int)
    print(um() as int)
    print(g as int)
    print(h as int)
    print(f"{a} {b} {c[0]} {p.y} {soma} {g} {h}")
    if a > 0 and p.x == 7 {
        print(1)
    }
}
