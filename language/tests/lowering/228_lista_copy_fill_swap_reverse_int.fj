// IA1-L9d: copy (min dos len, sobreposicao nos dois sentidos), fill, swap e reverse em array, fatia e lista de int.
proc dump(s: []int) {
    print(len(s))
    for x in s {
        print(x)
    }
}

proc main() {
    var a: [6]int = {1, 2, 3, 4, 5, 6}
    var b: [4]int = {0, 0, 0, 0}
    print(copy(b, a))
    dump(b[..])
    print(copy(a[1..<6], a[0..<5]))
    dump(a[..])
    print(copy(a[0..<5], a[1..<6]))
    dump(a[..])
    var c: [6]int = {9, 9, 9, 9, 9, 9}
    print(copy(c, b))
    dump(c[..])
    print(copy(c[0..<0], a))
    print(copy(c[2..<2], a[0..<0]))
    fill(c, 7)
    dump(c[..])
    fill(c[1..<3], 0)
    dump(c[..])
    fill(c[3..<3], 5)
    dump(c[..])
    swap(a, 0, 5)
    swap(a, 2, 2)
    swap(a, 1, 4)
    dump(a[..])
    reverse(a)
    dump(a[..])
    reverse(a[0..<5])
    dump(a[..])
    reverse(a[2..<3])
    reverse(a[2..<2])
    dump(a[..])
    var l = make([dynamic]int, alloc = heap, cap = 2)
    append(&l, item = 1)
    append(&l, item = 2)
    append(&l, item = 3)
    reverse(l)
    dump(l[..])
    swap(l, 0, 2)
    dump(l[..])
    fill(l, 4)
    dump(l[..])
    print(copy(l, a[0..<2]))
    dump(l[..])
    print(copy(a, l))
    dump(a[..])
    var v = make([dynamic]int, alloc = heap, cap = 2)
    reverse(v)
    fill(v, 1)
    print(copy(v, l))
    print(len(v))
    delete(l)
    delete(v)
}
