// K08a (sort_by): ordem decrescente por chave (a.chave > b.chave); os iguais continuam na ordem original.
struct Item {
    chave: int
    seq: int
}

proc maior_chave(a: ^Item, b: ^Item) -> bool {
    return a.chave > b.chave
}

proc main() {
    var l = make([dynamic]Item, alloc = heap)
    for i in 0..<60 {
        append(&l, item = Item{chave = i % 5, seq = i})
    }
    sort_by(l[..], less = maior_chave)
    print(l[0].chave)
    print(l[0].seq)
    print(l[11].seq)
    print(l[12].chave)
    print(l[12].seq)
    print(l[59].chave)
    print(l[59].seq)
    delete(l)
}
