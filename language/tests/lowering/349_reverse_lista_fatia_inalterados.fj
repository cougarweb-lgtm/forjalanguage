// S2a: reverse de fatia, array e lista continua invertendo no lugar, ao lado de reverse(str), que devolve texto novo.
proc main() {
    var xs: [5]int = {1, 2, 3, 4, 5}
    reverse(xs[1..<4])
    print(xs[0])
    print(xs[1])
    print(xs[2])
    print(xs[3])
    print(xs[4])
    var l = make([dynamic]int, alloc = heap)
    append(&l, item = 1)
    append(&l, item = 2)
    append(&l, item = 3)
    reverse(l)
    print(l[0])
    print(l[1])
    print(l[2])
    delete(l)
    let s = reverse("xyz", alloc = heap)
    print(s)
    delete(s)
}
