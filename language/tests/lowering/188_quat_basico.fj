// v1.11 L14a (A05): quat {x, y, z, w: f32}: literal (campo omitido = 0.0), leitura e gravacao de campo, q + r, q - r, -q, q * k, k * q (por componente, ordem x y z w),
// conj(q) = {-x, -y, -z, w}, quat em struct, em parametro e em retorno, e o sinal do zero (conj de zero da -0.0; os bits dizem).
struct Corpo {
    giro: quat
    massa: f32
}

proc bits(x: f32) -> u32 {
    return transmute(x, to = u32)
}

proc dobro(q: quat) -> quat {
    return q * 2.0
}

proc mostra(nome: str, q: quat) {
    print(f"{nome} {q.x} {q.y} {q.z} {q.w}")
}

proc main() {
    let zero = quat{}
    let identidade = quat{w = 1.0}
    var q = quat{x = 1.0, y = 2.0, z = 3.0, w = 4.0}
    let r = quat{x = 0.5, y = 0.25, z = 0.125, w = 0.0625}
    mostra("zero", q = zero)
    mostra("identidade", q = identidade)
    mostra("soma", q = q + r)
    mostra("diferenca", q = q - r)
    mostra("oposto", q = -q)
    let k: f32 = 3.0
    mostra("q*k", q = q * k)
    mostra("k*q", q = k * q)
    mostra("meio", q = 0.5 * q)
    mostra("dois", q = q * 2)
    mostra("conj", q = conj(q))
    mostra("conj conj", q = conj(conj(q)))
    mostra("dobro", q = dobro(r))
    q.x = 9.0
    q.w = q.y + q.z
    mostra("q", q = q)
    let c = Corpo{giro = conj(r), massa = 2.0}
    mostra("corpo", q = c.giro * c.massa)
    var d = Corpo{giro = identidade, massa = 1.0}
    d.giro = d.giro - r
    d.giro.y = 7.0
    mostra("d", q = d.giro)
    let cz = conj(zero)
    print(f"{bits(cz.x)} {bits(cz.y)} {bits(cz.z)} {bits(cz.w)}")
    let nz = -zero
    print(f"{bits(nz.x)} {bits(nz.y)} {bits(nz.z)} {bits(nz.w)}")
    print(f"{q:?}")
}
