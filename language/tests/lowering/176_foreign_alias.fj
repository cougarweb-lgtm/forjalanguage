// A6: nome da Forja diferente do simbolo C. 'remove' e palavra reservada da Forja; 'c_remove' chama o remove do msvcrt.
foreign {
    link "msvcrt"
    proc c_remove = "remove"(caminho: cstr) -> i32
    proc c_abs = "abs"(v: i32) -> i32
    proc labs(v: i32) -> i32
}

proc main() {
    let r = c_remove("arquivo_que_nao_existe_forja.tmp")
    print(r)
    print(c_abs(-7))
    print(labs(-9))
}
