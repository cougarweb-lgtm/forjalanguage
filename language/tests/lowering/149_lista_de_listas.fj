proc criar(n: int) -> [dynamic]int {
    var l = make([dynamic]int, alloc = heap, cap = n)
    for i in 0..<n {
        append(&l, item = i)
    }
    return l
}

proc main() {
    var grade = make([dynamic][dynamic]int, alloc = heap)
    append(&grade, item = criar(3))
    append(&grade, item = criar(5))
    print(len(grade))
    print(len(grade[1]))
    print(grade[1][4])
    append(&grade[0], item = 9)
    print(grade[0][3])
    var total = 0
    for &linha in grade {
        for v in linha {
            total += v
        }
        delete(linha^)
    }
    print(total)
    print(len(grade[0]))
    delete(grade)
}
