// IA1-L9d: index_of, last_index_of, contains e count em lista, array e fatia de f64 (valores exatos em binario).
proc main() {
    var l = make([dynamic]f64, alloc = heap, cap = 4)
    print(index_of(l, 1.5) or_else -1)
    print(contains(l, 1.5))
    print(count(l, 1.5))
    append(&l, item = 1.5)
    append(&l, item = 2.5)
    append(&l, item = 1.5)
    append(&l, item = 0.5)
    print(index_of(l, 1.5) or_else -1)
    print(last_index_of(l, 1.5) or_else -1)
    print(index_of(l, 0.5) or_else -1)
    print(index_of(l, 9.5) or_else -1)
    print(count(l, 1.5))
    print(count(l, 3.5))
    print(contains(l, 2.5))
    print(contains(l, 2.25))
    let x: f64 = 0.5 + 1.0
    print(index_of(l, x) or_else -1)
    let a: [3]f64 = {4.0, 8.0, 4.0}
    print(index_of(a, 8.0) or_else -1)
    print(last_index_of(a, 4.0) or_else -1)
    print(count(a, 4.0))
    let s = l[1..<4]
    print(index_of(s, 1.5) or_else -1)
    print(count(s, 1.5))
    print(contains(s, 0.5))
    let e = l[1..<1]
    print(contains(e, 2.5))
    delete(l)
}
