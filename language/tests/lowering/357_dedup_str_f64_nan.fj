// K08c (dedup): str compara por conteudo (corridas iguais se fundem); f64 com NaN: NaN != NaN, entao NaN consecutivos NAO se fundem. Termina com delete (R0009 zero).
proc main() {
    var s = make([dynamic]str, alloc = heap)
    append(&s, item = "a")
    append(&s, item = "a")
    append(&s, item = "b")
    append(&s, item = "ab")
    append(&s, item = "ab")
    append(&s, item = "a")
    dedup(&s)
    print(len(s))
    for i in 0..<len(s) {
        print(s[i])
    }
    delete(s)
    var f = make([dynamic]f64, alloc = heap)
    let menos_um: f64 = -1.0
    let nan = sqrt(menos_um)
    append(&f, item = 1.0)
    append(&f, item = 1.0)
    append(&f, item = nan)
    append(&f, item = nan)
    append(&f, item = 2.0)
    dedup(&f)
    print(len(f))
    for i in 0..<len(f) {
        print(f[i] == f[i])
    }
    print(f[0] as int)
    print(f[len(f) - 1] as int)
    delete(f)
}
