// K17 (heap): str na lista do heap; pop tira a menor ("ana") e delete(h) no fim solta o bloco com 3 str ainda la (R0009 zero). Saida: ana, 3.
proc main() {
    var h = make([dynamic]str, alloc = heap)
    heap_push(&h, "cia")
    heap_push(&h, "ana")
    heap_push(&h, "bia")
    heap_push(&h, "dan")
    print(heap_pop(&h) or_else "")
    print(len(h))
    delete(h)
}
