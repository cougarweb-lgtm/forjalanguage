// S2a (reverse de str): inverte por runa, igual a text.str_reverse (std:text): ASCII, acentuado, emoji de 4 bytes e bytes invalidos (FF, continuacao solta, E0 80, F5, ED A0 surrogate). Compara com o std.
import "std:text" as text

proc main() {
    let ascii = reverse("abc", alloc = heap)
    print(ascii)
    delete(ascii)
    let acento = reverse("ação", alloc = heap)
    print(acento)
    delete(acento)
    let emoji = reverse("a😀b", alloc = heap)
    print(emoji)
    delete(emoji)
    let ruim: [10]u8 = {0x61, 0xFF, 0x80, 0xE0, 0x80, 0xF5, 0x80, 0xED, 0xA0, 0x62}
    let texto_ruim = from_bytes(ruim, alloc = heap)
    let meu = reverse(texto_ruim, alloc = heap)
    let ref = text.str_reverse(texto_ruim, alloc = heap)
    print(meu == ref)
    print(len(meu))
    delete(meu)
    delete(ref)
    delete(texto_ruim)
}
