// POS-Z: segundo erro do GCC 16.1.0 (-O2 com -DFORJA_DEV, o dev do backend c): num laco `for` com um `while` dentro e if/else que reatribui a mesma var, a escrita se perdia
// (o crc32 do std:hash dava 0xFFFFFFFF). O C emitido esta certo; o driver agora passa -fno-tree-ch com gcc >= 16 (driver\cc.c). Esperado do CRC-32 IEEE de "A" (zlib): 3554254475 (= 740712820 xor 0xFFFFFFFF);
// a primeira linha e o crc sem o xor final, a segunda e o laco sem entrada de byte nenhuma (so mexe no valor inicial), a terceira confere o caso de fatia vazia.
const CRC_POLINOMIO: u32 = 0xEDB88320
const CRC_UM: u32 = 1
const CRC_INICIO: u32 = 0xFFFFFFFF

proc crc_sem_xor_final(b: []u8) -> u32 {
    var crc = CRC_INICIO
    for i in 0..<len(b) {
        crc = crc ~ (b[i] as u32)
        var k = 0
        while k < 8 {
            if (crc & CRC_UM) == CRC_UM {
                crc = (crc >> 1) ~ CRC_POLINOMIO
            } else {
                crc = crc >> 1
            }
            k += 1
        }
    }
    return crc
}

proc crc_sem_byte(b: []u8) -> u32 {
    var crc = CRC_INICIO
    for i in 0..<len(b) {
        var k = 0
        while k < 8 {
            if (crc & CRC_UM) == CRC_UM {
                crc = (crc >> 1) ~ CRC_POLINOMIO
            } else {
                crc = crc >> 1
            }
            k += 1
        }
    }
    return crc ~ CRC_INICIO
}

proc main() {
    var um: [1]u8 = {65}
    print(crc_sem_xor_final(um[..]))
    print(crc_sem_byte(um[..]))
    print(crc_sem_xor_final(um[0..<0]) == CRC_INICIO)
}
