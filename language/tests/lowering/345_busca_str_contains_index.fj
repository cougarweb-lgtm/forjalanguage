// S2a (busca em str): contains, index_of, last_index_of e count com literal, heap e vista (s[2..<9]); achado no inicio, meio e fim; nao achado; agulha maior que o texto; agulha vazia.
proc main() {
    let s = "banana"
    print(contains(s, value = "nan"))
    print(index_of(s, value = "an") or_else -1)
    print(last_index_of(s, value = "an") or_else -1)
    print(index_of(s, value = "x") or_else -1)
    print(count(s, value = "an"))
    let h = clone("abracadabra", alloc = heap)
    defer delete(h)
    let v = h[2..<9]
    print(index_of(v, value = "cad") or_else -1)
    print(contains(v, value = "dab"))
    print(contains(h, value = "xyz"))
    print(contains("ab", value = "abc"))
    print(index_of("ab", value = "abc") or_else -1)
    print(contains("abc", value = ""))
    print(index_of("abc", value = "") or_else -1)
    print(last_index_of("abc", value = "") or_else -1)
    print(count("abc", value = ""))
}
