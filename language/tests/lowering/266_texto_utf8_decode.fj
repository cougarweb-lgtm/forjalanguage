// IA1-S2c (T13): std:text decode(s, at) -> (runa, tamanho) sobre sequencias de 1 a 4 bytes validas (limites U+007F/0080/07FF/0800/FFFF/10000/10FFFF), invalidas
// (continuacao solta, truncada em cada comprimento, overlong C0 80 / E0 80 80 / F0 80 80 80, surrogate ED A0 80, F4 90 80 80, F5..FF) e para todo at de -1 a len(s).
// Politica (como o Go): invalido = (U+FFFD, 1); at fora do texto = (U+FFFD, 0); at no meio de uma runa le a continuacao como byte solto.
// Cada linha: <bytes em hex> | at:runa-em-hex/tamanho ...
import "std:text" as tx

const CASOS: [47]str = {
    "", "41", "7f", "00", "c2 80", "df bf", "e0 a0 80", "ef bf bf", "ef bf bd", "f0 90 80 80", "f4 8f bf bf",
    "61 c3 a7 c3 a3 6f", "f0 9f 98 80", "e2 82 ac",
    "80", "bf", "c0 80", "c1 bf", "c2", "e0 80 80", "e0 9f bf", "e0 a0", "e1 80", "e1", "ed a0 80", "ed 9f bf", "ed bf bf", "ee 80 80",
    "f0 80 80 80", "f0 8f bf bf", "f0 90 80", "f0 90", "f0", "f4 90 80 80", "f5 80 80 80", "f8", "fe", "ff",
    "c3 28", "e2 82 28", "f0 9f 98 28", "e2 28 a1", "41 c3", "c3 41", "c3 c3 a9", "e2 82 e2 82 ac", "f0 9f f0 9f 98 80"
}

// "c3 a9" -> texto dono com esses bytes.
proc bytes_de(hex: str) -> str {
    var partes = tx.fields(hex, alloc = heap)
    defer delete(partes)
    var lista = make([dynamic]u8, alloc = heap)
    defer delete(lista)
    for parte in partes {
        let valor = tx.parse_uint_base(parte, base = 16) or_else 0
        append(&lista, item = valor as u8)
    }
    return from_bytes(lista[..], alloc = heap)
}

proc main() {
    for hex in CASOS {
        let s = bytes_de(hex)
        defer delete(s)
        var saida = make([dynamic]u8, alloc = heap)
        defer delete(saida)
        format(f"{hex} |", into = &saida)
        for at in -1..=len(s) {
            let runa, tamanho = tx.decode(s, at = at)
            format(f" {at}:{runa as u32:04x}/{tamanho}", into = &saida)
        }
        let linha = to_str(&saida)
        defer delete(linha)
        print(linha)
    }
}
