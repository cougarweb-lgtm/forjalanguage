// IA1-S2e (D-FMT): std:fmt, percent (v e a fracao: 0.125 = 12,5%): o expoente decimal sobe 2 sem multiplicar o f64. 1a linha de cada caso: as 9 regioes em half_up (percent_space: espaco antes do "%" em es-ES, fr-FR e de-DE); 2a linha ("modos"): pt-BR nos 5 modos (half_up, half_even, half_down, up, down).
// Cada linha de caso e conferida contra o oraculo Python independente (scratchpad). NaN e infinito saem sem o "%".
import "std:fmt" as fmt

const MODOS: [5]fmt.Rounding = {fmt.Rounding.half_up, fmt.Rounding.half_even, fmt.Rounding.half_down, fmt.Rounding.up, fmt.Rounding.down}

// O f64 com esses bits (NaN e infinito sem depender de divisao por zero).
proc bits(b: u64) -> f64 {
    return transmute(b, to = f64)
}

proc caso(v: f64, d: int) {
    var buf = make([dynamic]u8, alloc = heap, cap = 128)
    defer delete(buf)
    format(f"{v} d={d}", into = &buf)
    for i in 0..<9 {
        let texto = fmt.percent(v, loc = fmt.LOCALES[i], decimals = d, alloc = heap)
        append(&buf, item = "|")
        append(&buf, item = texto)
        delete(texto)
    }
    let linha = to_str(&buf)
    print(linha)
    delete(linha)
    clear(&buf)
    append(&buf, item = "  modos")
    for modo in MODOS {
        append(&buf, item = "|")
        fmt.write_percent(v, buf = &buf, loc = fmt.PT_BR, decimals = d, rounding = modo)
    }
    let modos = to_str(&buf)
    print(modos)
    delete(modos)
}

proc main() {
    caso(0.0115, 2)
    caso(0.0115, 0)
    caso(-0.5, 0)
    caso(0.125, 0)
    caso(0.125, 1)
    caso(0.125, 2)
    caso(0.5, 0)
    caso(1.0, 0)
    caso(0.0, 0)
    caso(-0.0, 2)
    caso(12.0, 0)
    caso(0.005, 0)
    caso(0.015, 0)
    caso(0.025, 0)
    caso(-0.025, 0)
    caso(0.00005, 2)
    caso(0.00004, 2)
    caso(0.999, 0)
    caso(0.9995, 0)
    caso(0.99995, 1)
    caso(123456789.0, 0)
    caso(0.123456789012, 12)
    caso(0.0000000000001, 12)
    caso(0.0000000000001, 15)
    caso(0.1 + 0.2, 1)
    caso(1.0 / 3.0, 2)
    caso(2.0 / 3.0, 5)
    caso(bits(0x7FF8000000000000), 1)
    caso(bits(0x7FF0000000000000), 1)
    caso(bits(0xFFF0000000000000), 0)
}
