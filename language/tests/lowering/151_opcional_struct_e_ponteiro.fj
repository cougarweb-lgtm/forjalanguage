struct Grifo {
    vida: i32 = 100
}

proc melhor(a: ?Grifo, b: Grifo) -> Grifo {
    return a or_else b
}

proc main() {
    var g = Grifo{vida = 40}
    let p: ?^Grifo = &g
    let q: ?^Grifo = none
    switch r in p {
    case ^Grifo:
        print(r.vida)
    case none:
        print(0)
    }
    let h = q or_else &g
    print(h.vida)
    let x = melhor(none, b = Grifo{})
    print(x.vida)
    let y = melhor(Grifo{vida = 7}, b = Grifo{})
    print(y.vida)
    let lista: [3]?i32 = {1, none, 3}
    var soma: i32 = 0
    for item in lista {
        soma += item or_else 10
    }
    print(soma)
}
