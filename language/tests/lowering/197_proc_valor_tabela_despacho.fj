enum Op {
    soma
    subtrai
    multiplica
}

struct Entrada {
    op: Op
    executa: proc(a: int, b: int) -> int
    vezes: i32 = 0
}

proc somar(a: int, b: int) -> int {
    return a + b
}

proc subtrair(a: int, b: int) -> int {
    return a - b
}

proc multiplicar(a: int, b: int) -> int {
    return a * b
}

proc despachar(tabela: ^[3]Entrada, op: Op, a: int, b: int) -> int {
    for &e in tabela^ {
        if e.op == op {
            e.vezes += 1
            return e.executa(a, b = b)
        }
    }
    return 0
}

proc main() {
    var tabela: [3]Entrada = {
        Entrada{op = Op.soma, executa = somar},
        Entrada{op = Op.subtrai, executa = subtrair},
        Entrada{op = Op.multiplica, executa = multiplicar}
    }
    print(despachar(&tabela, op = Op.soma, a = 40, b = 2))
    print(despachar(&tabela, op = Op.subtrai, a = 40, b = 2))
    print(despachar(&tabela, op = Op.multiplica, a = 40, b = 2))
    print(despachar(&tabela, op = Op.multiplica, a = 3000000000, b = 3))
    print(tabela[2].vezes)
    print(tabela[0].executa(1, b = 1))
    let direto = tabela[1]
    print(direto.executa(9, b = 4))
}
