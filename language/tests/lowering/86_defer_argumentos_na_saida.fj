// defer roda o comando inteiro na saida do bloco: argumentos e chamadas internas so valem la (decisao do usuario, 2026-11-07)
proc mostrar(v: int) {
    print(v)
}

proc calc(n: int) -> int {
    print(n)
    return n * 2
}

proc main() {
    var x = 1
    defer mostrar(x)
    x = 2
    defer mostrar(calc(10))
    print(0)
}
