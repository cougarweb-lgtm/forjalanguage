// IA1-L9f (T11): append(&buf, item = "texto") em [dynamic]u8 acrescenta os BYTES do texto (UTF-8 multibyte conta cada byte, texto vazio nao muda nada);
// 12000 voltas de 4 appends forcam varios crescimentos do builder (cap 0 -> 8 -> 16 -> ... ); to_str move os bytes sem copia; o builder fica vazio.
proc soma_bytes(s: str) -> int {
    var total = 0
    for i in 0..<len(s) {
        total += s[i] as int
    }
    return total
}

proc main() {
    var buf = make([dynamic]u8, alloc = heap)
    defer delete(buf)
    for i in 0..<12000 {
        append(&buf, item = "ab")
        append(&buf, item = "é")
        append(&buf, item = "")
        append(&buf, item = "-")
    }
    print(len(buf))
    let s = to_str(&buf)
    print(len(s))
    print(s[0..<10])
    print(s[len(s) - 5..<len(s)])
    print(soma_bytes(s))
    print(len(buf))
    print(cap(buf))
    delete(s)

    var u = make([dynamic]u8, alloc = heap, cap = 2)
    defer delete(u)
    append(&u, item = "aé€😀")
    append(&u, item = "z")
    print(len(u))
    print(u[1])
    print(u[2])
    print(u[len(u) - 1])
    let t = to_str(&u)
    print(t)
    print(len(t))
    print(t == "aé€😀z")
    delete(t)
}
