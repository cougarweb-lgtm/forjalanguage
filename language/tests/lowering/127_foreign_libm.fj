foreign {
    link "m"
    proc c_sqrt = "sqrt"(x: f64) -> f64
    proc pow(x: f64, y: f64) -> f64
    proc floor(x: f64) -> f64
    proc sin(x: f64) -> f64
}

proc main() {
    print(c_sqrt(144.0) as int)
    print(pow(2.0, y = 10.0) as int)
    print(floor(-2.5) as int)
    print((sin(0.0) * 1000.0) as int)
}
