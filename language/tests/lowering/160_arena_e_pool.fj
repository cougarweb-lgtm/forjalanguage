import "std:mem"

struct Grifo {
    vida: i32 = 100
    x: int = 0
}

proc main() {
    let a = mem.arena_create(64)
    var total = 0
    for i in 0..<10 {
        let g = new(Grifo, alloc = a)
        g.x = i
        total += g.x + g.vida as int
    }
    print(total)
    print(mem.arena_used(a) > 0)
    mem.arena_reset(a)
    print(mem.arena_used(a))
    mem.arena_destroy(a)
    let p = mem.pool_create()
    let q = new(Grifo, alloc = p)
    let r = new(Grifo, alloc = p)
    print(mem.pool_live(p))
    delete(q, alloc = p)
    print(mem.pool_live(p))
    print(r.vida)
    delete(r, alloc = p)
    mem.pool_destroy(p)
}
