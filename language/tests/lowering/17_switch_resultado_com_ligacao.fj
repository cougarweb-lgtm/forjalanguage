enum Erro { falhou }

proc achar(n: i32) -> int ! Erro {
    if n == 0 {
        return Erro.falhou
    }
    return 30
}

proc main() {
    switch r in achar(4) {
    case int:
        print(r + 1)
    case Erro:
        print(0)
    }
    switch r in achar(0) {
    case int:
        print(r)
    case Erro:
        print(r == Erro.falhou)
    }
}
