// IA1-S2e (D-FMT): std:fmt, number (forma dona, half_up) nas 9 regioes: separadores, agrupamento por group_size e min_group_digits (es-ES e pt-PT: "1234" sem milhar, "12.345" com), fr-FR e pt-PT com espaco, ISO sem milhar.
// Colunas: pt-BR, en-US, en-GB, es-ES, fr-FR, de-DE, it-IT, pt-PT, ISO. Cada linha de caso e conferida contra o oraculo Python independente (scratchpad).
import "std:fmt" as fmt

// 10 elevado a n por multiplicacao (nao existe literal com expoente).
proc pow10(n: int) -> f64 {
    var r: f64 = 1.0
    for _vez in 0..<n {
        r = r * 10.0
    }
    return r
}

proc caso(v: f64, d: int) {
    var buf = make([dynamic]u8, alloc = heap, cap = 128)
    defer delete(buf)
    format(f"{v} d={d}", into = &buf)
    for i in 0..<9 {
        let texto = fmt.number(v, loc = fmt.LOCALES[i], decimals = d, alloc = heap)
        append(&buf, item = "|")
        append(&buf, item = texto)
        delete(texto)
    }
    let linha = to_str(&buf)
    defer delete(linha)
    print(linha)
}

proc main() {
    caso(0.0, 2)
    caso(1.0, 2)
    caso(12.5, 2)
    caso(123.456, 2)
    caso(999.99, 2)
    caso(1000.0, 2)
    caso(1234.5, 2)
    caso(9999.99, 2)
    caso(12345.678, 2)
    caso(99999.995, 2)
    caso(123456.789, 2)
    caso(1234567.891, 2)
    caso(-1234567.891, 2)
    caso(-1234.5, 2)
    caso(-999.99, 2)
    caso(-0.004, 2)
    caso(0.005, 2)
    caso(1234.5, 0)
    caso(12345.5, 0)
    caso(999.5, 0)
    caso(1234.5678, 3)
    caso(1234567.1234567, 7)
    caso(123456789012.0, 2)
    caso(pow10(15), 2)
    caso(pow10(21), 0)
    caso(0.5, 15)
    caso(1234.5, 15)
    caso(0.1 + 0.2, 2)
}
