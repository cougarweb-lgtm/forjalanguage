// K09 (count_by): conta todos os que satisfazem pred (sem PARE). Chaves 1, 3, 5, 5: cinco = 2, maior que zero = 4; vazia = 0.
struct Item {
    chave: int
}

proc chave_cinco(a: ^Item) -> bool {
    return a.chave == 5
}

proc maior_que_zero(a: ^Item) -> bool {
    return a.chave > 0
}

proc main() {
    var l = make([dynamic]Item, alloc = heap)
    append(&l, item = Item{chave = 1})
    append(&l, item = Item{chave = 3})
    append(&l, item = Item{chave = 5})
    append(&l, item = Item{chave = 5})
    print(count_by(l[..], pred = chave_cinco))
    print(count_by(l[..], pred = maior_que_zero))
    var vazia = make([dynamic]Item, alloc = heap)
    print(count_by(vazia[..], pred = chave_cinco))
    delete(vazia)
    delete(l)
}
