// K09 (index_by): fatia vazia nunca chama pred. O resultado e (-1, false).
struct Item {
    chave: int
}

proc chave_cinco(a: ^Item) -> bool {
    return a.chave == 5
}

proc main() {
    var l = make([dynamic]Item, alloc = heap)
    let i, ok = index_by(l[..], pred = chave_cinco)
    print(i)
    print(ok)
    delete(l)
}
