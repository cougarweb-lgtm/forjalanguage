// IA1-S2e (D-FMT): std:fmt, number nos 5 modos de arredondamento (half_up, half_even, half_down, up, down) na regiao ISO (ponto decimal, sem milhar). Semantica: o valor e reduzido a 15 algarismos significativos (half_even) e depois arredondado em `decimals`.
// Cada linha de caso e conferida contra o oraculo Python independente (scratchpad), que nao usa o forja: empates, vai-um (9.995), 0.1 + 0.2, 1.005, zero sem sinal, NaN, infinito, 1e15..1e308, 5e-324.
import "std:fmt" as fmt

const MODOS: [5]fmt.Rounding = {fmt.Rounding.half_up, fmt.Rounding.half_even, fmt.Rounding.half_down, fmt.Rounding.up, fmt.Rounding.down}

// 10 elevado a n por multiplicacao (nao existe literal com expoente).
proc pow10(n: int) -> f64 {
    var r: f64 = 1.0
    for _vez in 0..<n {
        r = r * 10.0
    }
    return r
}

// O f64 com esses bits (NaN e infinito sem depender de divisao por zero).
proc bits(b: u64) -> f64 {
    return transmute(b, to = f64)
}

proc caso(v: f64, d: int) {
    var buf = make([dynamic]u8, alloc = heap, cap = 64)
    defer delete(buf)
    format(f"{v} d={d}", into = &buf)
    for modo in MODOS {
        append(&buf, item = "|")
        fmt.write_number(v, buf = &buf, loc = fmt.ISO, decimals = d, rounding = modo)
    }
    let linha = to_str(&buf)
    defer delete(linha)
    print(linha)
}

proc main() {
    caso(0.5, 0)
    caso(1.5, 0)
    caso(2.5, 0)
    caso(3.5, 0)
    caso(-0.5, 0)
    caso(-1.5, 0)
    caso(-2.5, 0)
    caso(0.4, 0)
    caso(0.6, 0)
    caso(0.0, 0)
    caso(-0.0, 0)
    caso(0.49999999999999994, 0)
    caso(9.5, 0)
    caso(99.5, 0)
    caso(999999999999999.5, 0)
    caso(0.25, 1)
    caso(0.35, 1)
    caso(0.05, 1)
    caso(-0.05, 1)
    caso(0.15, 1)
    caso(1.25, 1)
    caso(1.35, 1)
    caso(-1.25, 1)
    caso(0.95, 1)
    caso(9.95, 1)
    caso(1.005, 2)
    caso(2.675, 2)
    caso(9.995, 2)
    caso(999.995, 2)
    caso(0.125, 2)
    caso(0.135, 2)
    caso(0.145, 2)
    caso(0.115, 2)
    caso(-0.125, 2)
    caso(-1.005, 2)
    caso(1.0, 2)
    caso(0.004, 2)
    caso(0.005, 2)
    caso(-0.004, 2)
    caso(-0.005, 2)
    caso(0.001, 2)
    caso(-0.001, 2)
    caso(0.015, 2)
    caso(0.025, 2)
    caso(0.035, 2)
    caso(1234567.891, 2)
    caso(99.999, 2)
    caso(99.994999, 2)
    caso(0.994999, 2)
    caso(0.995, 2)
    caso(-0.995, 2)
    caso(0.0, 2)
    caso(-0.0, 2)
    caso(5.0, 2)
    caso(0.1 + 0.2, 2)
    caso(1.0 / 3.0, 2)
    caso(2.0 / 3.0, 2)
    caso(100.0 - 0.01, 2)
    caso(1.0005, 3)
    caso(2.0015, 3)
    caso(0.0005, 3)
    caso(0.0015, 3)
    caso(-0.0005, 3)
    caso(0.9995, 3)
    caso(99.9995, 3)
    caso(0.00005, 4)
    caso(0.00015, 4)
    caso(0.0000000000000005, 15)
    caso(0.1, 15)
    caso(0.123456789012345, 15)
    caso(0.1 + 0.2, 15)
    caso(1.0 / 3.0, 15)
    caso(2.0 / 3.0, 15)
    caso(1.5, 15)
    caso(123456789.123456789, 15)
    caso(-0.000000000000001, 15)
    caso(0.0000001, 2)
    caso(0.0000001, 15)
    caso(0.0000001, 7)
    caso(-0.0000001, 7)
    caso(0.00000015, 7)
    caso(pow10(15), 2)
    caso(pow10(16), 2)
    caso(pow10(16), 0)
    caso(pow10(21), 2)
    caso(pow10(22), 0)
    caso(pow10(23), 3)
    caso(-pow10(21), 2)
    caso(pow10(308), 2)
    caso(123456789012345678.0, 2)
    caso(999999999999999.9, 0)
    caso(999999999999999.9, 1)
    caso(1234567890123456.0, 0)
    caso(bits(1), 2)
    caso(bits(1), 15)
    caso(-bits(1), 15)
    caso(bits(0x0010000000000000), 15)
    caso(bits(0x7FEFFFFFFFFFFFFF), 0)
    caso(bits(0x7FF8000000000000), 2)
    caso(bits(0x7FF0000000000000), 2)
    caso(bits(0xFFF0000000000000), 0)
}
