// IA1-S2d1 (A20): next_u32 (os 32 bits altos), next_float (f64 em [0, 1) = (next_u64 >> 11) / 2^53; impresso pelos BITS, exato) e next_bool (bit alto). Cada gerador novo, 100 saidas por semente.
// A coluna "dentro" prova 0.0 <= x < 1.0. O esperado vem de um oraculo Python.
import "std:rand" as rand

const SEMENTES: [3]u64 = {0, 1, 0xDEADBEEFCAFEBABE}
const PASSOS: int = 100

proc main() {
    for semente in SEMENTES {
        var a = rand.seed(semente)
        for i in 0..<PASSOS {
            let v = rand.next_u32(&a)
            print(f"u32 {semente} {i} {v}")
        }
        var b = rand.seed(semente)
        for i in 0..<PASSOS {
            let v = rand.next_float(&b)
            let dentro = v >= 0.0 and v < 1.0
            let bits = transmute(v, to = u64)
            print(f"float {semente} {i} {bits} {dentro}")
        }
        var c = rand.seed(semente)
        var verdadeiros: int = 0
        for i in 0..<PASSOS {
            let v = rand.next_bool(&c)
            if v {
                verdadeiros += 1
            }
            print(f"bool {semente} {i} {v}")
        }
        print(f"verdadeiros {semente} {verdadeiros}")
    }
}
