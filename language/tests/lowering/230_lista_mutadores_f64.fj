// IA1-L9c/L9d: insert_at, remove_value, pop, clone, replace_value, fill, swap, reverse e copy em lista e fatia de f64 (valores exatos em binario; impressos em decimos).
proc dump(s: []f64) {
    print(len(s))
    for x in s {
        print((x * 10.0) as int)
    }
}

proc main() {
    var l = make([dynamic]f64, alloc = heap, cap = 2)
    print(pop(&l) == none)
    append(&l, item = 1.5)
    append(&l, item = 2.5)
    insert_at(&l, 0, 0.5)
    insert_at(&l, 3, 3.5)
    insert_at(&l, 2, 1.5)
    dump(l[..])
    print(remove_value(&l, 1.5))
    print(remove_value(&l, 9.5))
    dump(l[..])
    ordered_remove(&l, 0)
    unordered_remove(&l, 0)
    dump(l[..])
    var c = clone(l, alloc = heap)
    append(&c, item = 7.5)
    append(&c, item = 1.5)
    replace_value(c, 1.5, 4.5)
    dump(c[..])
    replace_value(c, 4.5, 0.25, n = 1)
    dump(c[..])
    swap(c, 0, 3)
    reverse(c)
    dump(c[..])
    var d = clone(c[1..<3], alloc = heap)
    fill(d, 6.5)
    print(copy(c, d))
    dump(c[..])
    let ultimo = pop(&c) or_else 0.0
    print(ultimo > 5.0)
    print(len(c))
    reserve(&c, 20)
    print(cap(c) >= 20)
    truncate(&c, 1)
    clear(&d)
    print(len(d))
    delete(l)
    delete(c)
    delete(d)
}
