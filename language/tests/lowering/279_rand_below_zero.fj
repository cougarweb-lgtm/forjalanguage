// IA1-S2d1 (A20): below(n = 0) e erro de quem chama: panic (R0003) com mensagem clara, nunca divisao por zero. O print antes prova que below(1) funciona; o programa para no n = 0.
import "std:rand" as rand

proc main() {
    var rng = rand.seed(1)
    print(rand.below(&rng, n = 1))
    print(rand.below(&rng, n = 0))
    print("nao chega")
}
