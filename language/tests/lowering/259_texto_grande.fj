// IA1-L10b: std:text sobre um texto de mais de 1 MiB (150000 x "linha ,é\r\n" = 1.650.000 bytes): repeat, split_lines, fields, split_any, split_n, replace, replace_n, replace_table e concat; so tamanhos, contagens e somas de bytes saem no stdout.
import "std:text" as tx

const REPETICOES: int = 150000
const UNIDADE: str = "linha ,é\r\n"

// Soma dos valores dos bytes de s (confere o conteudo sem imprimi-lo).
proc soma_bytes(s: str) -> int {
    var total = 0
    for i in 0..<len(s) {
        total += s[i] as int
    }
    return total
}

proc caso_listas(grande: str) {
    var linhas = tx.split_lines(grande, alloc = heap)
    defer delete(linhas)
    let ultima = linhas[len(linhas) - 1]
    print(f"linhas {len(linhas)} {len(linhas[0])} {len(ultima)}")
    let juntas = tx.concat(linhas[..], alloc = heap)
    defer delete(juntas)
    print(f"concat {len(juntas)} {soma_bytes(juntas)}")
    var campos = tx.fields(grande, alloc = heap)
    defer delete(campos)
    print(f"fields {len(campos)} {len(campos[0])} {len(campos[1])}")
    var pedacos = tx.split_any(grande, set = ",\r\n", alloc = heap)
    defer delete(pedacos)
    print(f"split_any {len(pedacos)} {len(pedacos[0])} {len(pedacos[len(pedacos) - 1])}")
    var tres = tx.split_n(grande, sep = "\r\n", n = 3, alloc = heap)
    defer delete(tres)
    print(f"split_n {len(tres)} {len(tres[0])} {len(tres[1])} {len(tres[2])}")
}

proc caso_trocas(grande: str) {
    let curto = tx.replace(grande, old = "linha", new = "L", alloc = heap)
    defer delete(curto)
    let ocorrencias = tx.str_count(curto, sub = "L ,")
    print(f"replace {len(curto)} {soma_bytes(curto)} {ocorrencias}")
    let primeiros = tx.replace_n(grande, old = "é", new = "e", n = 10, alloc = heap)
    defer delete(primeiros)
    print(f"replace_n {len(primeiros)} {soma_bytes(primeiros)}")
    var pares: [2]tx.Replacement = {tx.Replacement{old = "linha", new = "L"}, tx.Replacement{old = "é", new = "e"}}
    let tabela = tx.replace_table(grande, pairs = pares[..], alloc = heap)
    defer delete(tabela)
    print(f"replace_table {len(tabela)} {soma_bytes(tabela)}")
}

proc main() {
    let grande = tx.repeat(UNIDADE, n = REPETICOES, alloc = heap)
    defer delete(grande)
    print(f"tamanho {len(grande)} {soma_bytes(grande)}")
    caso_listas(grande)
    caso_trocas(grande)
}
