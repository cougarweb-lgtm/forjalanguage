proc main() {
    var m = make(map[str]int, alloc = scope)
    insert(&m, key = "a", value = 1)
    insert(&m, key = "b", value = 2)
    insert(&m, key = "c", value = 3)
    insert(&m, key = "d", value = 4)
    remove(&m, key = "b")
    for k, v in m {
        print(k)
        print(v)
    }
    for k, &v in m {
        v^ = v^ * 10
    }
    print(get(m, key = "d") or_else 0)
    print(has(m, key = "b"))
    print(has(m, key = "ab"))
}
