// IA1-S2f (D-FMT): std:fmt, fixed (inteiro com `scale` casas decimais IMPLICITAS: 122334 com scale 2 = "1.223,34"), exato em todo o i64. Cada linha: n e scale, depois as 9 regioes (PT_BR EN_US EN_GB ES_ES FR_FR DE_DE IT_IT PT_PT ISO).
// Cada linha e conferida contra o oraculo Python independente (scratchpad, sem o forja). Bordas: 0, 1, 99, 100, negativo, es-ES/pt-PT sem milhar de 4 digitos, menor e maior int com scale 0, 2 e 9.
import "std:fmt" as fmt

proc fixo(n: int, scale: int) {
    var buf = make([dynamic]u8, alloc = heap, cap = 256)
    defer delete(buf)
    format(f"{n} s={scale}", into = &buf)
    for i in 0..<9 {
        let texto = fmt.fixed(n, loc = fmt.LOCALES[i], scale = scale, alloc = heap)
        append(&buf, item = "|")
        append(&buf, item = texto)
        delete(texto)
    }
    let linha = to_str(&buf)
    print(linha)
    delete(linha)
}

proc main() {
    fixo(0, 2)
    fixo(1, 2)
    fixo(99, 2)
    fixo(100, 2)
    fixo(122334, 2)
    fixo(123456789, 2)
    fixo(-5, 2)
    fixo(-122334, 2)
    fixo(1234, 2)
    fixo(123456, 2)
    fixo(5, 0)
    fixo(1234567, 0)
    fixo(5, 3)
    fixo(5899, 3)
    fixo(-1, 3)
    fixo(-9223372036854775807 - 1, 2)
    fixo(9223372036854775807, 2)
    fixo(-9223372036854775807 - 1, 0)
    fixo(9223372036854775807, 9)
    fixo(-9223372036854775807 - 1, 9)
    fixo(1, 9)
    fixo(123456789, 9)
    fixo(100000, 2)
    fixo(99999999, 4)
}
