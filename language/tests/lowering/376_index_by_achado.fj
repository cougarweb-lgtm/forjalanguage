// K09 (index_by): 1a posicao que satisfaz pred, com achou = true. Chaves 1, 3, 5, 5: a 1a com chave 5 esta no indice 2.
struct Item {
    chave: int
}

proc chave_cinco(a: ^Item) -> bool {
    return a.chave == 5
}

proc main() {
    var l = make([dynamic]Item, alloc = heap)
    append(&l, item = Item{chave = 1})
    append(&l, item = Item{chave = 3})
    append(&l, item = Item{chave = 5})
    append(&l, item = Item{chave = 5})
    let i, ok = index_by(l[..], pred = chave_cinco)
    print(i)
    print(ok)
    delete(l)
}
