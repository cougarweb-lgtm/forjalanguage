import "std:mem"

proc rotulo(n: int, alloc: Allocator) -> str {
    return format(f"item-{n}", alloc = alloc)
}

proc via(n: int, alloc: Allocator) -> str {
    return rotulo(n, alloc = alloc)
}

proc lista(n: int, alloc: Allocator) -> [dynamic]int {
    var l = make([dynamic]int, alloc = alloc)
    for i in 0..<n {
        append(&l, item = i * i)
    }
    return l
}

proc soma_lista(n: int, alloc: Allocator) -> int {
    if n == 0 {
        return 0
    }
    var l = lista(3, alloc = alloc)
    let s = l[0] + l[1] + l[2]
    delete(l)
    return s + soma_lista(n - 1, alloc = alloc)
}

proc main() {
    var a = mem.arena_create(512)
    let pa = &a
    let h = rotulo(1, alloc = heap)
    print(h)
    delete(h)
    let f = rotulo(2, alloc = frame)
    print(f)
    let t = rotulo(3, alloc = a)
    print(t)
    let u = via(4, alloc = pa)
    print(u)
    let v = via(5, alloc = heap)
    print(v)
    delete(v)
    var l = lista(4, alloc = heap)
    print(len(l))
    delete(l)
    print(soma_lista(3, alloc = heap))
    print(soma_lista(2, alloc = a))
    frame_reset()
    mem.arena_destroy(a)
}
