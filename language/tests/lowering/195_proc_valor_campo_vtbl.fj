struct Vtbl {
    soma: proc(self: rawptr, a: i32, b: i32) -> i32
    escala: proc(self: rawptr, f: f32) -> f64
    solta: proc(self: rawptr)
    nome: proc(self: rawptr) -> u64
}

struct Objeto {
    vtbl: ^Vtbl
    contagem: i32
}

proc somar(self: rawptr, a: i32, b: i32) -> i32 {
    let o = self as ^Objeto
    return a + b + o.contagem
}

proc escalar(self: rawptr, f: f32) -> f64 {
    return 1.5
}

proc soltar(self: rawptr) {
    let o = self as ^Objeto
    print(o.contagem)
}

proc identificar(self: rawptr) -> u64 {
    return 123456789012
}

proc usar(q: ^Objeto) {
    let eu = q as rawptr
    let r = q.vtbl.soma(eu, a = 1, b = 2)
    let e = q.vtbl.escala(eu, f = 2.0)
    defer q.vtbl.solta(eu)
    print(r)
    print(e as i32)
    print(q.vtbl.nome(eu))
    q.vtbl.solta(eu)
}

proc main() {
    var tabela = Vtbl{soma = somar, escala = escalar, solta = soltar, nome = identificar}
    var o = Objeto{vtbl = &tabela, contagem = 10}
    usar(&o)
    o.contagem = 20
    usar(&o)
}
