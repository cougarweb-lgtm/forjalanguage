enum Erro { falhou }
enum Cor { vermelho, verde }

struct Par {
    a: int = 1
    b: bool = false
}

proc par(n: int) -> Par ! Erro {
    if n < 0 {
        return Erro.falhou
    }
    return Par{a = n, b = true}
}

proc cor(n: int) -> Cor ! Erro {
    if n < 0 {
        return Erro.falhou
    }
    return Cor.verde
}

proc logico(n: int) -> bool ! Erro {
    if n < 0 {
        return Erro.falhou
    }
    return true
}

proc main() {
    let p = par(-1) or_else Par{a = 7}
    print(p.a)
    print(p.b)
    let q = par(3) or_else Par{a = 7}
    print(q.a)
    print(q.b)
    let c = cor(-1) or_else Cor.vermelho
    print(c == Cor.vermelho)
    let l = logico(-1) or_else false
    print(l)
}
