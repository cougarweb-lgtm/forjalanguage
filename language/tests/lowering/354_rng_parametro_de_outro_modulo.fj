// S2b (fixture 354): o Rng e o parametro ^rand.Rng de uma proc de outro modulo (mods/sorteio_rng). A permutacao confere com rand.perm na mesma semente, e choice sorteia um dos 5 elementos.
import "mods/sorteio_rng" as sr
import "std:rand" as rand

proc main() {
    var l: [5]int = {0, 1, 2, 3, 4}
    var r = rand.seed(21)
    sr.embaralha(l[..], rng = &r)
    var b = rand.seed(21)
    var p = rand.perm(&b, n = 5, alloc = heap)
    defer delete(p)
    var igual = true
    for k in 0..<5 {
        igual = igual and l[k] == p[k]
    }
    print(igual)

    var c = rand.seed(4)
    let e = sr.sorteado(l[..], rng = &c) or_else -1
    print(e >= 0 and e < 5)
}
