// IA1-L10a (T02, T03): std:text trim, trim_left, trim_right (espaco ASCII: ' ' \t \n \r \v \f), trim_prefix, trim_suffix, trim_chars e cut; todos devolvem VISTA do original (nada aloca).
// Bordas: texto vazio, so espacos, \r\n, UTF-8, afixo vazio ou igual ao texto, afixo que se repete (so uma vez), cut sem separador, separador vazio, separador no inicio e no fim.
// O ultimo texto (com \v e \f) e montado a partir de bytes: o literal da Forja nao tem \v nem \f. Cada linha e montada no builder e impressa com \r \n \t \v \f escritos como \r \n \t \v \f (o .esperado nao distingue CRLF de LF).
import "std:text" as tx

const TEXTOS: [10]str = {"", "   ", "  hi  ", "\t\n x y \r\n", "x", "  é  ", "ab  ab", "\r\n", "xxhixx", "a=b=c"}
const AFIXOS: [7]str = {"", "  ", "x", "xx", "ab", "hi", "é"}
const CONJUNTOS: [6]str = {"", " ", "x", "xy ", "é", "\r\n"}
const SEPARADORES: [6]str = {"", "=", "==", "  ", "hi", "x"}
const ESPACOS_RAROS: [8]u8 = {32, 11, 12, 65, 66, 12, 11, 32}

// Escreve o byte b no builder; os de controle saem como \r, \n, \t, \v e \f (letra depois da barra).
proc anexa_visivel(saida: ^[dynamic]u8, b: u8) {
    if b == 13 {
        append(saida, item = "\\r")
    } else if b == 10 {
        append(saida, item = "\\n")
    } else if b == 9 {
        append(saida, item = "\\t")
    } else if b == 11 {
        append(saida, item = "\\v")
    } else if b == 12 {
        append(saida, item = "\\f")
    } else {
        append(saida, item = b)
    }
}

// Imprime o que esta no builder `linha` com os controles visiveis e o esvazia (to_str move os bytes).
proc mostra(linha: ^[dynamic]u8) {
    let texto = to_str(linha)
    defer delete(texto)
    var saida = make([dynamic]u8, alloc = heap)
    defer delete(saida)
    for i in 0..<len(texto) {
        anexa_visivel(&saida, b = texto[i])
    }
    let visivel = to_str(&saida)
    defer delete(visivel)
    print(visivel)
}

proc aparar(linha: ^[dynamic]u8, a: int, s: str) {
    let inteiro = tx.trim(s)
    let esquerda = tx.trim_left(s)
    let direita = tx.trim_right(s)
    format(f"trim {a} [{inteiro}] [{esquerda}] [{direita}]", into = linha)
    mostra(linha)
}

proc afixos(linha: ^[dynamic]u8, a: int, s: str) {
    for b in 0..<len(AFIXOS) {
        let sem_prefixo = tx.trim_prefix(s, prefix = AFIXOS[b])
        let sem_sufixo = tx.trim_suffix(s, suffix = AFIXOS[b])
        format(f"afixo {a} {b} [{sem_prefixo}] [{sem_sufixo}]", into = linha)
        mostra(linha)
    }
}

proc conjuntos(linha: ^[dynamic]u8, a: int, s: str) {
    for b in 0..<len(CONJUNTOS) {
        let aparado = tx.trim_chars(s, set = CONJUNTOS[b])
        format(f"chars {a} {b} [{aparado}]", into = linha)
        mostra(linha)
    }
}

proc cortes(linha: ^[dynamic]u8, a: int, s: str) {
    for b in 0..<len(SEPARADORES) {
        let antes, depois, achou = tx.cut(s, sep = SEPARADORES[b])
        format(f"cut {a} {b} [{antes}] [{depois}] {achou}", into = linha)
        mostra(linha)
    }
}

proc tudo_de(linha: ^[dynamic]u8, a: int, s: str) {
    aparar(linha, a = a, s = s)
    afixos(linha, a = a, s = s)
    conjuntos(linha, a = a, s = s)
    cortes(linha, a = a, s = s)
}

proc main() {
    var linha = make([dynamic]u8, alloc = heap)
    defer delete(linha)
    for a in 0..<len(TEXTOS) {
        tudo_de(&linha, a = a, s = TEXTOS[a])
    }
    var bytes_raros = ESPACOS_RAROS
    let raros = from_bytes(bytes_raros[..], alloc = heap)
    defer delete(raros)
    tudo_de(&linha, a = len(TEXTOS), s = raros)
}
