// S3 P3 (L11b-1): literal e mistura. math.sin(1.0) e f64 (literal sozinho vale f64); math.pow(x32, y = 2.0) e f32 (o literal se adapta ao f32 do outro). Saida = bits em hex.
import "std:math" as math

proc bits(r: f64) -> u64 {
    return transmute(r, to = u64)
}

proc bits32(r: f32) -> u32 {
    return transmute(r, to = u32)
}

proc main() {
    let x32: f32 = 2.5
    let x64: f64 = 2.5
    print(f"{bits(math.sin(1.0)):016x}")
    print(f"{bits32(math.pow(x32, y = 2.0)):08x}")
    print(f"{bits(math.pow(x64, y = 2.0)):016x}")
    print(f"{bits32(math.atan2(y = 1.0, x = x32)):08x}")
    print(f"{bits(math.sin(x64)):016x}")
    print(f"{bits(math.hypot(3.0, 4.0)):016x}")
    print(f"{bits32(math.hypot(3.0, x32)):08x}")
}
