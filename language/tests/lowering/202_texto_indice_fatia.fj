// L-02 (IA1-L5a): str indexavel por byte. s[i] e um u8; s[lo..<hi] e um str emprestado (aponta para dentro do original, sem copiar).
proc contar(s: str, alvo: u8) -> int {
    var n = 0
    for i in 0..<len(s) {
        if s[i] == alvo {
            n += 1
        }
    }
    return n
}

proc primeira_palavra(s: str) -> str {
    for i in 0..<len(s) {
        if s[i] == 32 {
            return s[0..<i]
        }
    }
    return s
}

proc main() {
    let s = "ola mundo, ola"
    print(len(s))
    print(s[0])
    print(s[len(s) - 1])
    print(contar(s, 111))
    let a = s[0..<3]
    print(a)
    print(len(a))
    let b = s[4..<9]
    print(b)
    print(f"{a}-{b}")
    print(len(s[3..<3]))
    print(primeira_palavra(s))
    print(primeira_palavra("sozinha"))
    print(s[..])
    let acentos = "café"
    print(len(acentos))
    print(acentos[3])
    print(acentos[4])
}
