// IA1-S2h (D-FMT): std:fmt, duracao no estilo curto da regiao (format_duration e write_duration): componentes h, min, s, ms em ordem decrescente sem os zerados, trunca para ms (para o zero), zero = "0 s", negativa = "-" + valor absoluto, sem dias, menor e maior int sem overflow.
// Cada linha: ns | pt-BR | en-US | de-DE | ISO (de-DE traz os sufixos Std. Min. Sek.). Conferido contra o oraculo Python independente (scratchpad, sem o forja).
import "std:fmt" as fmt

const VALORES: [34]int = {
    0, 1, 999999, 1000000, 1999999, 999000000, 999999999, 1000000000, 1250000000, 59000000000, 60000000000, 61001000000,
    3599000000000, 3600000000000, 3601000000000, 3903250000000, 3661250000000, 86400000000000, 359999999000000, 360000000000000,
    -1, -999999, -1000000, -1500000000, -60000000000, -3600000000000, -3903250000000, -86400000000000,
    9223372036854775807, 9223372036854775806, -9223372036854775807, 1000000000000000, 31536000000000000, 5}

// Uma linha com as 4 regioes; a 1a coluna pela forma dona e as outras por write_duration.
proc linha(ns: int) {
    var buf = make([dynamic]u8, alloc = heap, cap = 128)
    defer delete(buf)
    format(f"{ns}|", into = &buf)
    let a = fmt.format_duration(ns, loc = fmt.PT_BR, alloc = heap)
    append(&buf, item = a)
    delete(a)
    append(&buf, item = "|")
    fmt.write_duration(ns, buf = &buf, loc = fmt.EN_US)
    append(&buf, item = "|")
    fmt.write_duration(ns, buf = &buf, loc = fmt.DE_DE)
    append(&buf, item = "|")
    fmt.write_duration(ns, buf = &buf, loc = fmt.ISO)
    let texto = to_str(&buf)
    print(texto)
    delete(texto)
}

proc main() {
    for i in 0..<34 {
        linha(VALORES[i])
    }
    linha(-9223372036854775807 - 1)
    linha(-9223372036854775807 - 1 + 999999)
    linha(-9223372036854775807 - 1 + 1000000)
}
