// IA1-L9c: truncate com n > len = R0006 em dev (em release a lista tem folga: cap 8 e so o que vem antes e impresso).
proc main() {
    var l = make([dynamic]int, alloc = heap, cap = 8)
    defer delete(l)
    append(&l, item = 1)
    append(&l, item = 2)
    append(&l, item = 3)
    var n = 3
    truncate(&l, n)
    print(len(l))
    n = 5
    print(1)
    truncate(&l, n)
    print(2)
}
