// v1.11 L15b (A08, E0335): l[i] com len <= i < N (duas de quatro) da R0006 em dev; release nao checa. A subtracao le o mesmo
// slot duas vezes e da 0 nos dois modos (em dev o trap vem antes), por isso a saida do release e fixa.
proc main() {
    var duas: [dynamic, 4]i32 = {}
    append(&duas, item = 7)
    append(&duas, item = 8)
    print(duas[1])
    print(duas[2] - duas[2])
}
