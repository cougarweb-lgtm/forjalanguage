// L11a-2 (S3 P2): exp exp2 log log2 log10 cbrt hypot e a tabela de casos especiais do pow (Anexo F do C): 0^-1, (-1)^inf, 1^NaN, (-8)^(1/3). Saida = bits em hex.
import "std:math" as math

proc de_bits(b: u64) -> f64 {
    return transmute(b, to = f64)
}

proc bits(r: f64) -> u64 {
    return transmute(r, to = u64)
}

proc linha_exp_log(x: f64) {
    print(f"{bits(math.exp(x)):016x} {bits(math.exp2(x)):016x} {bits(math.log(x)):016x} {bits(math.log2(x)):016x} {bits(math.log10(x)):016x} {bits(math.cbrt(x)):016x}")
}

proc linha_pow(x: f64, y: f64) {
    print(f"{bits(math.pow(x, y)):016x}")
}

proc main() {
    linha_exp_log(0.0)
    linha_exp_log(-0.0)
    linha_exp_log(1.0)
    linha_exp_log(-1.0)
    linha_exp_log(0.5)
    linha_exp_log(10.0)
    linha_exp_log(-745.0)
    linha_exp_log(709.0)
    linha_exp_log(de_bits(0x7FF0000000000000))
    linha_exp_log(de_bits(0xFFF0000000000000))
    linha_exp_log(de_bits(0x7FF8000000000001))
    linha_exp_log(de_bits(0x0000000000000001))
    linha_exp_log(-8.0)
    linha_exp_log(de_bits(0x0010000000000000))
    linha_exp_log(de_bits(0x7FE0000000000000))
    print(f"{bits(math.hypot(3.0, 4.0)):016x} {bits(math.hypot(de_bits(0x7FD0000000000000), de_bits(0x7FD0000000000000))):016x} {bits(math.hypot(de_bits(0x7FF0000000000000), de_bits(0x7FF8000000000001))):016x} {bits(math.hypot(0.0, -0.0)):016x}")
    linha_pow(0.0, -1.0)
    linha_pow(de_bits(0x8000000000000000), -3.0)
    linha_pow(-1.0, de_bits(0x7FF0000000000000))
    linha_pow(1.0, de_bits(0x7FF8000000000001))
    linha_pow(-8.0, 0.3333333333333333)
    linha_pow(2.0, 0.5)
    linha_pow(2.0, 10.0)
    linha_pow(10.0, -2.0)
    linha_pow(-2.0, 3.0)
    linha_pow(de_bits(0x7FF0000000000000), -0.5)
    linha_pow(0.5, de_bits(0x7FF0000000000000))
    var i = 0
    var x: f64 = 0.01
    while i < 32 {
        linha_exp_log(x)
        linha_pow(x, 2.5)
        x = x * 1.7
        i = i + 1
    }
}
