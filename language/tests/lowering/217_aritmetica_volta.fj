proc prova_int(a: int, b: int) {
    let sa, ea = overflowing_add(a, b = b)
    let ss, es = overflowing_sub(a, b = b)
    let sm, em = overflowing_mul(a, b = b)
    print(f"int {a} {b} w={wrapping_add(a, b = b)} {wrapping_sub(a, b = b)} {wrapping_mul(a, b = b)} s={saturating_add(a, b = b)} {saturating_sub(a, b = b)} {saturating_mul(a, b = b)}")
    print(f"  o={sa} {ea} {ss} {es} {sm} {em}")
    print(f"  c={checked_add(a, b = b) == none} {checked_add(a, b = b) or_else 0} {checked_sub(a, b = b) == none} {checked_sub(a, b = b) or_else 0} {checked_mul(a, b = b) == none} {checked_mul(a, b = b) or_else 0}")
}

proc main() {
    prova_u8(0, 0)
    prova_u8(255, 1)
    prova_u8(0, 1)
    prova_u8(1, 0)
    prova_u8(255, 255)
    prova_u8(128, 2)
    prova_u8(127, 2)
    prova_u8(16, 16)
    prova_u8(15, 17)
    prova_u8(200, 100)

    prova_i8(127, 1)
    prova_i8(-128, -1)
    prova_i8(-128, 1)
    prova_i8(0, 0)
    prova_i8(127, 127)
    prova_i8(-128, -128)
    prova_i8(64, 2)
    prova_i8(-64, 2)
    prova_i8(-65, 2)
    prova_i8(-1, -1)
    prova_i8(100, -100)
    prova_i8(-128, 127)

    prova_u16(65535, 1)
    prova_u16(0, 1)
    prova_u16(65535, 65535)
    prova_u16(256, 256)
    prova_u16(255, 257)
    prova_u16(32768, 2)

    prova_i16(32767, 1)
    prova_i16(-32768, -1)
    prova_i16(-32768, 1)
    prova_i16(181, 181)
    prova_i16(182, 182)
    prova_i16(-32768, -32768)
    prova_i16(16384, 2)
    prova_i16(-16384, 2)
    prova_i16(-16385, 2)

    prova_u32(4294967295, 1)
    prova_u32(0, 1)
    prova_u32(4294967295, 4294967295)
    prova_u32(65536, 65536)
    prova_u32(65535, 65537)
    prova_u32(2147483648, 2)

    prova_i32(2147483647, 1)
    prova_i32(-2147483648, -1)
    prova_i32(-2147483648, 1)
    prova_i32(46341, 46341)
    prova_i32(46340, 46340)
    prova_i32(-2147483648, -2147483648)
    prova_i32(1073741824, 2)
    prova_i32(-1073741824, 2)
    prova_i32(-1073741825, 2)
    prova_i32(2147483647, -2147483647)

    prova_u64(18446744073709551615, 1)
    prova_u64(0, 1)
    prova_u64(18446744073709551615, 18446744073709551615)
    prova_u64(4294967296, 4294967296)
    prova_u64(4294967295, 4294967297)
    prova_u64(9223372036854775808, 2)
    prova_u64(9223372036854775807, 2)

    prova_int(9223372036854775807, 1)
    prova_int(-9223372036854775808, -1)
    prova_int(-9223372036854775808, 1)
    prova_int(3037000499, 3037000499)
    prova_int(3037000500, 3037000500)
    prova_int(-9223372036854775808, -9223372036854775808)
    prova_int(4611686018427387904, 2)
    prova_int(-4611686018427387904, 2)
    prova_int(-4611686018427387905, 2)
    prova_int(9223372036854775807, -9223372036854775807)
    prova_int(0, -1)
}
