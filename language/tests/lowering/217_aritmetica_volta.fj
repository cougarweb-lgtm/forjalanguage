// IA1-L9a: wrapping_, saturating_, checked_ e overflowing_ (add, sub, mul) em todos os inteiros, nas fronteiras de cada largura. wrapping nunca da R0002; os comuns (+ - *) seguem checando.
// Cada prova imprime 3 linhas: wrapping e saturating; overflowing (valor, estourou); checked (e none, valor). O esperado vem de um oraculo Python de inteiros arbitrarios.
proc prova_u8(a: u8, b: u8) {
    let sa, ea = overflowing_add(a, b = b)
    let ss, es = overflowing_sub(a, b = b)
    let sm, em = overflowing_mul(a, b = b)
    print(f"u8 {a} {b} w={wrapping_add(a, b = b)} {wrapping_sub(a, b = b)} {wrapping_mul(a, b = b)} s={saturating_add(a, b = b)} {saturating_sub(a, b = b)} {saturating_mul(a, b = b)}")
    print(f"  o={sa} {ea} {ss} {es} {sm} {em}")
    print(f"  c={checked_add(a, b = b) == none} {(checked_add(a, b = b) or_else 0) as int} {checked_sub(a, b = b) == none} {(checked_sub(a, b = b) or_else 0) as int} {checked_mul(a, b = b) == none} {(checked_mul(a, b = b) or_else 0) as int}")
}

proc prova_i8(a: i8, b: i8) {
    let sa, ea = overflowing_add(a, b = b)
    let ss, es = overflowing_sub(a, b = b)
    let sm, em = overflowing_mul(a, b = b)
    print(f"i8 {a} {b} w={wrapping_add(a, b = b)} {wrapping_sub(a, b = b)} {wrapping_mul(a, b = b)} s={saturating_add(a, b = b)} {saturating_sub(a, b = b)} {saturating_mul(a, b = b)}")
    print(f"  o={sa} {ea} {ss} {es} {sm} {em}")
    print(f"  c={checked_add(a, b = b) == none} {(checked_add(a, b = b) or_else 0) as int} {checked_sub(a, b = b) == none} {(checked_sub(a, b = b) or_else 0) as int} {checked_mul(a, b = b) == none} {(checked_mul(a, b = b) or_else 0) as int}")
}

