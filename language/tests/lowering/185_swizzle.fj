// v1.11 L12b (A04): swizzle v.x, v.xy, v.zyx, c.bgra em [2..4]T; uma letra le e grava (v.x = , &v.x, v.x +=); varias letras montam um [k]T.
// A base de v.zyx e lida uma vez (cria() imprime uma linha so); o indice e constante provado (sem R0006).
unit Metros: f32

struct Corpo {
    pos: [3]f32
    cor: [4]u8
}

proc cria() -> [3]f32 {
    print("cria")
    return {1.0, 2.0, 3.0}
}

proc sobe(v: ^[3]f32) {
    v^.y += 10.0
}

proc main() {
    var v: [3]f32 = {1.5, 2.5, 3.5}
    v.x = 4.0
    v.y += 0.5
    v.z = v.z - 1.0
    print(f"{v[0]} {v[1]} {v[2]}")

    let p = &v.x
    p^ = 9.0
    let invertido = v.zyx
    let xy = v.xy
    let repetido = v.xx
    print(f"{v.x} {invertido[0]} {invertido[1]} {invertido[2]} {xy[1]} {repetido[0]} {repetido[1]}")

    let c = cria().zyx
    print(f"{c[0]} {c[1]} {c[2]}")

    var cor: [4]f32 = {0.25, 0.5, 0.75, 1.0}
    cor.a = 0.5
    let bgra = cor.bgra
    let rg = cor.rg
    print(f"{bgra[0]} {bgra[1]} {bgra[2]} {bgra[3]} {rg[0]} {rg[1]}")

    let inteiros: [4]i32 = {10, 20, 30, 40}
    let wz = inteiros.wz
    let ww = inteiros.wwww
    print(f"{wz[0]} {wz[1]} {ww[3]} {inteiros.y}")

    var bytes: [2]u8 = {200, 7}
    bytes.y += 1
    let yx = bytes.yx
    print(f"{yx[0]} {yx[1]}")

    var d: [2]Metros = {1.5, 2.5}
    d.x = d.y
    let m: Metros = d.x
    print(f"{m}")

    var corpo = Corpo{pos = {1.0, 2.0, 3.0}, cor = {1, 2, 3, 4}}
    corpo.pos.z = 8.0
    corpo.cor.a += 5
    let zy = corpo.pos.zy
    let bg = corpo.cor.bg
    print(f"{corpo.pos.x} {zy[0]} {zy[1]} {bg[0]} {bg[1]} {corpo.cor.a}")

    var w: [3]f32 = {1.0, 2.0, 3.0}
    sobe(&w)
    let pw = &w
    pw^.x = 7.0
    let yzx = pw^.yzx
    print(f"{w.y} {yzx[0]} {yzx[1]} {yzx[2]} {w.xy.y}")
}
