// IA1-S2c (T13): std:text rune_count, valid_utf8 e next_rune. Textos PT-BR (acento, ñ, emoji) e textos com bytes invalidos (cada byte invalido conta como 1 runa U+FFFD).
// Linha da tabela: bytes em hexa | runas | valido | as runas lidas por next_rune (hexa; o fim do texto e none). A seguir, tres literais com acento.
import "std:text" as tx

const CASOS: [26]str = {
    "", "41", "61 62 63", "63 6f 72 61 c3 a7 c3 a3 6f", "c3 b1", "f0 9f 98 80", "e2 82 ac 31 30", "41 f0 9f 98 80 42", "ef bf bd",
    "80", "c3", "41 c3", "c3 41", "e0 80 80", "ed a0 80", "f4 90 80 80", "ff 41 fe", "e2 82", "f0 9f 98", "c3 28", "41 80 80 42",
    "c2 80 df bf", "e0 a0 80 ef bf bf", "f0 90 80 80 f4 8f bf bf", "c0 80", "e1 80 80 80"
}

// "c3 a9" -> texto dono com esses bytes.
proc bytes_de(hex: str) -> str {
    var partes = tx.fields(hex, alloc = heap)
    defer delete(partes)
    var lista = make([dynamic]u8, alloc = heap)
    defer delete(lista)
    for parte in partes {
        let valor = tx.parse_uint_base(parte, base = 16) or_else 0
        append(&lista, item = valor as u8)
    }
    return from_bytes(lista[..], alloc = heap)
}

// Percorre s com next_rune e acrescenta cada runa (hexa) ao builder; devolve quantas leu.
proc percorrer(saida: ^[dynamic]u8, s: str) -> int {
    var resto = s
    var lidas = 0
    while true {
        let achada = tx.next_rune(&resto)
        if achada == none {
            break
        }
        format(f" {(achada or_else 0) as u32:04x}", into = saida)
        lidas += 1
    }
    return lidas
}

proc mostra_literal(s: str) {
    var saida = make([dynamic]u8, alloc = heap)
    defer delete(saida)
    format(f"literal {len(s)} bytes | {tx.rune_count(s)} runas | {tx.valid_utf8(s)} |", into = &saida)
    let lidas = percorrer(&saida, s)
    format(f" | lidas {lidas}", into = &saida)
    let linha = to_str(&saida)
    defer delete(linha)
    print(linha)
}

proc main() {
    for hex in CASOS {
        let s = bytes_de(hex)
        defer delete(s)
        var saida = make([dynamic]u8, alloc = heap)
        defer delete(saida)
        format(f"{hex} | {tx.rune_count(s)} | {tx.valid_utf8(s)} |", into = &saida)
        let lidas = percorrer(&saida, s)
        format(f" | lidas {lidas}", into = &saida)
        let linha = to_str(&saida)
        defer delete(linha)
        print(linha)
    }
    mostra_literal("coração")
    mostra_literal("Ñandú à la carte")
    mostra_literal("fim 😀 de linha")
}
