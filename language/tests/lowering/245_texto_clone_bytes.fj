// IA1-L9e: clone(str), from_bytes e as_bytes: o clone e independente (sobrevive ao delete do original), as_bytes e uma vista sem copia (mesmos bytes, UTF-8 multibyte
// conta cada byte), from_bytes copia (mudar a lista depois nao muda o texto), vazio e ida e volta.
proc soma_bytes(b: []u8) -> int {
    var total = 0
    for x in b {
        total += x as int
    }
    return total
}

proc main() {
    let origem = format(f"alfa-{1234}-omega", alloc = heap)
    let copia = clone(origem, alloc = heap)
    delete(origem)
    print(copia)
    print(len(copia))
    delete(copia)

    let u = "aé€😀"
    let cu = clone(u, alloc = heap)
    print(cu)
    print(len(cu))
    print(cu == u)
    delete(cu)

    let vazio = ""
    let cv = clone(vazio, alloc = heap)
    print(len(cv))
    print(cv == vazio)
    delete(cv)

    let b = as_bytes(u)
    print(len(b))
    print(b[0])
    print(b[1])
    print(b[2])
    print(b[len(b) - 1])
    print(soma_bytes(b))
    let volta = from_bytes(b, alloc = heap)
    print(volta)
    print(volta == u)
    print(len(volta))
    delete(volta)

    var lista = make([dynamic]u8, alloc = heap, cap = 4)
    defer delete(lista)
    append(&lista, item = 72)
    append(&lista, item = 105)
    append(&lista, item = 33)
    let t = from_bytes(lista, alloc = heap)
    lista[0] = 74
    lista[1] = 111
    print(t)
    print(lista[0])
    print(len(t))
    delete(t)

    var arr: [3]u8 = {111, 107, 0}
    let ta = from_bytes(arr[0..<2], alloc = heap)
    print(ta)
    delete(ta)
    let td = from_bytes(arr, alloc = heap)
    print(len(td))
    print(td[2])
    delete(td)

    var nada = make([dynamic]u8, alloc = heap, cap = 1)
    defer delete(nada)
    let tn = from_bytes(nada, alloc = heap)
    print(len(tn))
    print(tn == "")
    delete(tn)
}
