proc main() {
    let a: i8 = -128
    let b: i8 = 127
    let c: i16 = -32768
    let d: i16 = 32767
    let e: i32 = -2147483648
    let f: i32 = 2147483647
    let g: int = -9223372036854775808
    let h: int = 9223372036854775807
    let k: u8 = 255
    let m: u16 = 65535
    let n: u32 = 4294967295
    let p: uint = 18446744073709551615
    print(a)
    print(b)
    print(c)
    print(d)
    print(e)
    print(f)
    print(g)
    print(h)
    print(k)
    print(m)
    print(n)
    print(p)
}
