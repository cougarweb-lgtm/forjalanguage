// IA1-S2e (D-FMT): std:fmt, imprime TODOS os campos das 9 constantes de regiao (LOCALES) para conferir as tabelas (nomes de mes e de dia, separadores, padroes de data e hora, compactos, duracao) contra o snapshot escrito a mao no oraculo Python independente (scratchpad). Espaco na saida = U+0020 (fr-FR e pt-PT usam espaco comum de milhar).
import "std:fmt" as fmt

proc linha_lista(rotulo: str, itens: []str) {
    var buf = make([dynamic]u8, alloc = heap, cap = 128)
    defer delete(buf)
    append(&buf, item = "  ")
    append(&buf, item = rotulo)
    append(&buf, item = " ")
    for i in 0..<len(itens) {
        if i > 0 {
            append(&buf, item = "|")
        }
        append(&buf, item = itens[i])
    }
    let linha = to_str(&buf)
    defer delete(linha)
    print(linha)
}

proc imprimir_regiao(l: fmt.Locale) {
    print(f"{l.tag}|dec={l.decimal_sep}|grp={l.group_sep}|size={l.group_size}|min={l.min_group_digits}|{l.currency_symbol}|{l.currency_code}|{l.currency_before}|{l.currency_space}|{l.percent_space}")
    var compactos: [4]str = {l.compact_k, l.compact_m, l.compact_b, l.compact_t}
    linha_lista("compact", itens = compactos[..])
    var meses = l.months_long
    linha_lista("meses", itens = meses[..])
    var meses_curtos = l.months_short
    linha_lista("meses3", itens = meses_curtos[..])
    var dias = l.weekdays_long
    linha_lista("dias", itens = dias[..])
    var dias_curtos = l.weekdays_short
    linha_lista("dias3", itens = dias_curtos[..])
    print(f"  ampm {l.am_text}|{l.pm_text}")
    print(f"  datas {l.date_short}|{l.date_long}|{l.date_full}")
    print(f"  horas {l.time_short}|{l.time_medium}")
    print(f"  dur {l.dur_h}|{l.dur_min}|{l.dur_s}|{l.dur_ms}")
}

proc main() {
    for i in 0..<9 {
        imprimir_regiao(fmt.LOCALES[i])
    }
}
