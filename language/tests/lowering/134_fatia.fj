proc somar(s: []int) -> int {
    var total = 0
    for i in 0..<len(s) {
        total += s[i]
    }
    return total
}

proc main() {
    var a: [6]int = {1, 2, 3, 4, 5, 6}
    let tudo = a[..]
    print(len(tudo))
    print(somar(tudo))
    let meio = a[1..<4]
    print(len(meio))
    print(somar(meio))
    print(somar(a[3..=5]))
    let sub = meio[1..<3]
    print(sub[0])
    sub[1] = 40
    print(a[3])
    let vazia = a[2..<2]
    print(len(vazia))
    print(somar(vazia))
    let fv: []int = {}
    print(len(fv))
}
