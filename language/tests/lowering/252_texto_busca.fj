// IA1-L10a (T01): std:text busca em BYTES, em Forja pura: str_contains, str_index_of, str_last_index_of, str_count (sem sobreposicao), starts_with, ends_with, index_byte e index_any.
// Bordas: texto e substring vazios, ocorrencia no inicio e no fim, sobreposicao ("aaaa" com "aa"), \r\n, UTF-8 multibyte tratado como bytes (byte >= 0x80), ausente = -1 (or_else).
import "std:text" as tx

const TEXTOS: [10]str = {"", "abc", "abcabc", "aaaa", "banana", "a\nb\r\nc", "café", "日本語日本", "x=1;y=2;;", "  ab  "}
const SUBS: [10]str = {"", "a", "abc", "aa", "ana", "é", "本", "\n", ";;", "zzz"}
const BYTES: [8]u8 = {97, 98, 10, 13, 169, 183, 255, 0}
const CONJUNTOS: [6]str = {"", "a", "ab", "xyz", "\r\n", "éz"}

proc busca_de_substring() {
    for a in 0..<len(TEXTOS) {
        for b in 0..<len(SUBS) {
            let s = TEXTOS[a]
            let sub = SUBS[b]
            let achou = tx.str_contains(s, sub = sub)
            let primeira = tx.str_index_of(s, sub = sub) or_else -1
            let ultima = tx.str_last_index_of(s, sub = sub) or_else -1
            let vezes = tx.str_count(s, sub = sub)
            let comeca = tx.starts_with(s, prefix = sub)
            let termina = tx.ends_with(s, suffix = sub)
            print(f"{a} {b} {achou} {primeira} {ultima} {vezes} {comeca} {termina}")
        }
    }
}

proc busca_de_byte() {
    for a in 0..<len(TEXTOS) {
        for b in 0..<len(BYTES) {
            let posicao = tx.index_byte(TEXTOS[a], b = BYTES[b]) or_else -1
            print(f"byte {a} {b} {posicao}")
        }
    }
}

proc busca_em_conjunto() {
    for a in 0..<len(TEXTOS) {
        for b in 0..<len(CONJUNTOS) {
            let posicao = tx.index_any(TEXTOS[a], set = CONJUNTOS[b]) or_else -1
            print(f"any {a} {b} {posicao}")
        }
    }
}

proc main() {
    busca_de_substring()
    busca_de_byte()
    busca_em_conjunto()
}
