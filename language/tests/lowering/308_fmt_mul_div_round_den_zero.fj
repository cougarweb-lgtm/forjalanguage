// IA1-S2g (D-FMT): mul_div_round com den = 0 e erro de quem chama: panic (R0003), nao MoneyError. Com den 1 a conta vale.
import "std:fmt" as fmt

proc main() {
    let ok = fmt.mul_div_round(10, 3, 1, rounding = fmt.Rounding.half_up) or_else -1
    print(ok)
    let ruim = fmt.mul_div_round(10, 3, 0, rounding = fmt.Rounding.half_up) or_else -1
    print(ruim)
    print("nao chega")
}
