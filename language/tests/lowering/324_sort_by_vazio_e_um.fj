// K08a (sort_by): n = 0 e n = 1 (a ordenacao nao compara nada e nao mexe no elemento unico).
struct Item {
    chave: int
    seq: int
}

proc por_chave(a: ^Item, b: ^Item) -> bool {
    return a.chave < b.chave
}

proc main() {
    var vazio = make([dynamic]Item, alloc = heap)
    sort_by(vazio[..], less = por_chave)
    print(len(vazio))
    var um = make([dynamic]Item, alloc = heap)
    append(&um, item = Item{chave = 7, seq = 1})
    sort_by(um[..], less = por_chave)
    print(um[0].seq)
    print(len(um))
    delete(vazio)
    delete(um)
}
