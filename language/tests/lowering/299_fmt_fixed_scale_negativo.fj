// IA1-S2f (D-FMT): write_fixed com scale negativo e erro de quem chama: panic (R0003), o mesmo de fixed e money com scale fora de 0..9. Aqui a variante write_fixed.
import "std:fmt" as fmt

proc main() {
    var buf = make([dynamic]u8, alloc = heap, cap = 16)
    defer delete(buf)
    fmt.write_fixed(5899, buf = &buf, loc = fmt.PT_BR, scale = 0)
    let ok = to_str(&buf)
    print(ok)
    delete(ok)
    fmt.write_fixed(5899, buf = &buf, loc = fmt.PT_BR, scale = 0 - 1)
    print("nao chega")
}
