// K08b (sort_by_key): n = 0 (nada a ordenar) e n = 1 (um elemento fica como esta).
struct Item {
    chave: int
    seq: int
}

proc main() {
    var vazio = make([dynamic]Item, alloc = heap)
    sort_by_key(vazio[..], key = Item.chave)
    print(len(vazio))
    delete(vazio)
    var um = make([dynamic]Item, alloc = heap)
    append(&um, item = Item{chave = 9, seq = 7})
    sort_by_key(um[..], key = Item.chave)
    print(um[0].seq)
    delete(um)
}
