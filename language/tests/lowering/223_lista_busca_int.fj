// IA1-L9d: index_of, last_index_of, contains e count em lista, array e fatia de inteiros (vazia, 1 elemento, ausente, negativo, u8).
proc main() {
    var l = make([dynamic]int, alloc = heap, cap = 4)
    print(index_of(l, 5) or_else -1)
    print(last_index_of(l, 5) or_else -1)
    print(contains(l, 5))
    print(count(l, 5))
    append(&l, item = 5)
    print(index_of(l, 5) or_else -1)
    print(last_index_of(l, 5) or_else -1)
    print(contains(l, 5))
    print(count(l, 5))
    print(index_of(l, 6) or_else -1)
    append(&l, item = 7)
    append(&l, item = 5)
    append(&l, item = 9)
    append(&l, item = 5)
    print(index_of(l, 5) or_else -1)
    print(last_index_of(l, 5) or_else -1)
    print(index_of(l, 9) or_else -1)
    print(last_index_of(l, 9) or_else -1)
    print(index_of(l, 7) or_else -1)
    print(count(l, 5))
    print(count(l, 7))
    print(count(l, 8))
    print(contains(l, 9))
    print(contains(l, 8))
    let a: [4]int = {3, 1, 3, 2}
    print(index_of(a, 3) or_else -1)
    print(last_index_of(a, 3) or_else -1)
    print(count(a, 3))
    print(contains(a, 2))
    print(contains(a, 4))
    let s = l[1..<4]
    print(index_of(s, 5) or_else -1)
    print(last_index_of(s, 5) or_else -1)
    print(count(s, 5))
    print(contains(s, 7))
    print(contains(s, 3))
    let e = l[2..<2]
    print(index_of(e, 5) or_else -1)
    print(count(e, 5))
    print(contains(e, 5))
    append(&l, item = -4)
    print(index_of(l, -4) or_else -1)
    var b = make([dynamic]u8, alloc = heap, cap = 4)
    append(&b, item = 200)
    append(&b, item = 7)
    append(&b, item = 200)
    print(index_of(b, 200) or_else -1)
    print(last_index_of(b, 200) or_else -1)
    print(count(b, 200))
    delete(l)
    delete(b)
}
