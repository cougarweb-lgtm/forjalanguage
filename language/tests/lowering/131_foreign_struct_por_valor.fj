struct Divisao {
    quot: i32 = 0
    rem: i32 = 0
}

struct DivisaoLonga {
    quot: i64 = 0
    rem: i64 = 0
}

foreign {
    proc div(numerador: i32, denominador: i32) -> Divisao
    proc lldiv(numerador: i64, denominador: i64) -> DivisaoLonga
}

proc main() {
    let a = div(17, denominador = 5)
    print(a.quot)
    print(a.rem)
    let b = lldiv(-17, denominador = 5)
    print(b.quot)
    print(b.rem)
}
