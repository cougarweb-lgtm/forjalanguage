// K15 (set_union e set_intersect com str e vazio): a = {"x"}; uniao com vazio nao muda; uniao com {"y", "x"} da 2 membros; intersecao com vazio esvazia.
proc main() {
    var a = make(map[str]bool, alloc = heap)
    var b = make(map[str]bool, alloc = heap)
    var vazio = make(map[str]bool, alloc = heap)
    insert(&a, key = "x", value = true)
    set_union(&a, vazio)
    print(len(a))
    insert(&b, key = "y", value = true)
    insert(&b, key = "x", value = true)
    set_union(&a, b)
    print(len(a))
    print(has(a, key = "y"))
    set_intersect(&a, vazio)
    print(len(a))
    delete(a)
    delete(b)
    delete(vazio)
}
