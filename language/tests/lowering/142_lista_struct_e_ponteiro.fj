struct Bala {
    vida: i32 in 0..=100 = 100
    x: int = 0
}

struct Mundo {
    balas: [dynamic]Bala
    quadro: int = 0
}

proc disparar(m: ^Mundo, x: int) {
    append(&m.balas, item = Bala{x = x})
}

proc total_x(balas: []Bala) -> int {
    var t = 0
    for b in balas {
        t += b.x
    }
    return t
}

proc encher(l: ^[dynamic]int, n: int) {
    for i in 0..<n {
        append(l, item = i * i)
    }
}

proc main() {
    var m = Mundo{balas = make([dynamic]Bala, alloc = heap)}
    disparar(&m, x = 3)
    disparar(&m, x = 4)
    m.balas[1].vida -= 40
    print(m.balas[1].vida)
    print(len(m.balas))
    print(total_x(m.balas[..]))
    var q = make([dynamic]int, alloc = heap)
    encher(&q, n = 20)
    print(len(q))
    print(q[19])
    let p = &q
    print(p[3])
    print(len(p))
    var soma = 0
    for v in p {
        soma += v
    }
    print(soma)
    delete(p^)
    print(len(q))
    let g = new(Bala, alloc = heap)
    print(g.vida)
    g.x = 9
    print(g.x)
    delete(g)
    delete(m.balas)
    print(len(m.balas))
}
