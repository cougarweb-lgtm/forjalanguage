proc main() {
    var m = make(map[int]int, alloc = heap)
    defer delete(m)
    insert(&m, key = 1, value = 100)
    insert(&m, key = 2, value = 200)
    insert(&m, key = 3, value = 300)
    print(get(m, key = 1) or_else 0)
    print(len(m))
    print(get(m, key = 9) or_else 0)
    print(has(m, key = 2))
    insert(&m, key = 2, value = 500)
    print(get(m, key = 2) or_else 0)
    var reserva = 0
    let p = get_ptr(&m, key = 1) or_else &reserva
    p^ = p^ / 2
    print(get(m, key = 1) or_else 0)
    remove(&m, key = 3)
    print(has(m, key = 3))
    for i in 0..<1000 {
        insert(&m, key = i * 3, value = i)
    }
    print(has(m, key = 2997))
    let g = get(m, key = 2997) or_else 0
    print(g * 3)
    remove(&m, key = 1)
    remove(&m, key = 2)
    print(len(m))
    print(get(m, key = 0) or_else 7)
}
