const CEM_U8: u8 = 255
const DOIS_E_MEIO: f64 = 2.5
const MENOR_INT: int = -9223372036854775808
const MAIOR_U32: u32 = 4294967295
const SOMA_U8: u8 = 200 + 55
const MENOR_I16: i16 = -32768

proc main() {
    print(CEM_U8)
    print((DOIS_E_MEIO * 2.0) as int)
    print(MENOR_INT)
    print(MAIOR_U32)
    print(SOMA_U8)
    print(MENOR_I16)
}
