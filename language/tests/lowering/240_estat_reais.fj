// IA1-L9e: sum, avg, min_of e max_of sobre lista, array e fatia de f64 e f32: vazio, 1 elemento, negativos, fracoes que nao fecham em binario (0.1 + 0.2 + 0.3) e NaN
// (min_of e max_of ignoram NaN e so devolvem NaN se todos forem; sum e avg propagam). A soma de f32 e em f32; a media e em f64.
proc linha_f64(s: []f64) {
    print(sum(s))
    print(avg(s))
    print(min_of(s) or_else -1000.0)
    print(max_of(s) or_else -1000.0)
}

proc linha_f32(s: []f32) {
    print(sum(s))
    print(avg(s))
    print(min_of(s) or_else -1000.0)
    print(max_of(s) or_else -1000.0)
}

proc main() {
    var l = make([dynamic]f64, alloc = heap, cap = 8)
    defer delete(l)
    linha_f64(l[..])
    append(&l, item = 2.5)
    linha_f64(l[..])
    append(&l, item = -1.5)
    append(&l, item = 0.1)
    append(&l, item = 0.2)
    append(&l, item = 0.3)
    linha_f64(l[..])
    var a: [4]f64 = {-1.5, 2.25, -8.125, 4.0}
    linha_f64(a[..])
    print(sum(a))
    print(max_of(a) or_else -1000.0)
    var g: [3]f64 = {10000000000.0, 0.00001, -0.5}
    linha_f64(g[..])
    var f: [3]f32 = {0.1, 0.2, 0.3}
    linha_f32(f[..])
    var h: [4]f32 = {1.5, -2.5, 100.25, -0.75}
    linha_f32(h[..])
    var um: [1]f32 = {-7.5}
    linha_f32(um[..])
    var vazio = make([dynamic]f32, alloc = heap, cap = 1)
    defer delete(vazio)
    linha_f32(vazio[..])
    let zero: f64 = 0.0
    let nan: f64 = sqrt(zero - 1.0)
    var n: [4]f64 = {nan, 3.0, nan, 1.0}
    linha_f64(n[..])
    var so: [1]f64 = {nan}
    linha_f64(so[..])
    var fim: [3]f64 = {2.0, 5.0, nan}
    linha_f64(fim[..])
}
