// IA1-B01 (to_str de qualquer alocador): as procs de std:text que montam o texto num builder (to_str(&buf)) devolvem a str no alocador pedido.
// A mesma saida sai em heap (com delete), em frame (frame_reset no fim) e em Arena (arena_destroy no fim): sem R0007 e sem R0009, em c e x64, dev e release.
import "std:text" as text
import "std:mem"

proc textos_heap() {
    let maiusc = text.to_upper("def", alloc = heap)
    print(maiusc)
    delete(maiusc)
    let minusc = text.to_lower("ABC", alloc = heap)
    print(minusc)
    delete(minusc)
    let trocado = text.replace("a-b-c", "-", "+", alloc = heap)
    print(trocado)
    delete(trocado)
    let repetido = text.repeat("ab", 3, alloc = heap)
    print(repetido)
    delete(repetido)
    var partes: [3]str = {"ab", "cd", "e"}
    let colado = text.concat(partes[..], alloc = heap)
    print(colado)
    delete(colado)
    let unido = text.join(partes[..], ", ", alloc = heap)
    print(unido)
    delete(unido)
}

proc textos_frame() {
    let maiusc = text.to_upper("def", alloc = frame)
    print(maiusc)
    let minusc = text.to_lower("ABC", alloc = frame)
    print(minusc)
    let trocado = text.replace("a-b-c", "-", "+", alloc = frame)
    print(trocado)
    let repetido = text.repeat("ab", 3, alloc = frame)
    print(repetido)
    var partes: [3]str = {"ab", "cd", "e"}
    let colado = text.concat(partes[..], alloc = frame)
    print(colado)
    let unido = text.join(partes[..], ", ", alloc = frame)
    print(unido)
}

proc textos_arena() {
    let a = mem.arena_create()
    let maiusc = text.to_upper("def", alloc = a)
    print(maiusc)
    let minusc = text.to_lower("ABC", alloc = a)
    print(minusc)
    let trocado = text.replace("a-b-c", "-", "+", alloc = a)
    print(trocado)
    let repetido = text.repeat("ab", 3, alloc = a)
    print(repetido)
    var partes: [3]str = {"ab", "cd", "e"}
    let colado = text.concat(partes[..], alloc = a)
    print(colado)
    let unido = text.join(partes[..], ", ", alloc = a)
    print(unido)
    mem.arena_destroy(a)
}

proc main() {
    textos_heap()
    textos_frame()
    frame_reset()
    textos_arena()
}
