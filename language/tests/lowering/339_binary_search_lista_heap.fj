// K08b (binary_search): lista heap ordenada (sort) de 60 inteiros pares; 40 acha na posicao 20, 41 nao acha (posicao 21). Termina com delete (R0009 zero).
proc main() {
    var l = make([dynamic]int, alloc = heap)
    for i in 0..<60 {
        append(&l, item = 2 * i)
    }
    let i, ok = binary_search(l[..], value = 40)
    print(i)
    print(ok)
    let j, achou = binary_search(l[..], value = 41)
    print(j)
    print(achou)
    delete(l)
}
