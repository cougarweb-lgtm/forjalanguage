// K17 (heap_push / heap_pop): f64 com NaN (o NaN sai por ultimo, como no sort) e str por bytes, depois pelo tamanho. Saida: true x4, banana ma maca uva, 0.
proc main() {
    var h = make([dynamic]f64, alloc = heap)
    let menos_um: f64 = -1.0
    let nan = sqrt(menos_um)
    heap_push(&h, 2.5)
    heap_push(&h, nan)
    heap_push(&h, 0.5)
    heap_push(&h, 1.0)
    let a = heap_pop(&h) or_else menos_um
    let b = heap_pop(&h) or_else menos_um
    let c = heap_pop(&h) or_else menos_um
    let d = heap_pop(&h) or_else menos_um
    print(a == 0.5)
    print(b == 1.0)
    print(c == 2.5)
    print(d != d)
    print(len(h))
    delete(h)
    var s = make([dynamic]str, alloc = heap)
    heap_push(&s, "uva")
    heap_push(&s, "maca")
    heap_push(&s, "ma")
    heap_push(&s, "banana")
    print(heap_pop(&s) or_else "")
    print(heap_pop(&s) or_else "")
    print(heap_pop(&s) or_else "")
    print(heap_pop(&s) or_else "")
    delete(s)
}
