// Jogo sem update do teste de hot reload (M8 H3): exporta outro nome no lugar de update. Versao: 1.0.0. Changelog: 1.0.0 - H3: primeira versao.
struct Estado {
    passos: i64
    soma: f64
    ultimo: f64
}

pub export proc atualiza(e: ^Estado, dt: f64) {
    e.passos += 1
    e.soma += dt
    e.ultimo = dt
}

proc main() {
}
