// Jogo v3 do teste de hot reload (M8 H3): Estado com campo novo, interface diferente (o reload tem de recusar). Versao: 1.0.0. Changelog: 1.0.0 - H3: primeira versao.
struct Estado {
    passos: i64
    soma: f64
    ultimo: f64
    extra: i64
}

pub export proc update(e: ^Estado, dt: f64) {
    e.passos += 1
    e.soma += dt
    e.ultimo = dt
}

proc main() {
}
