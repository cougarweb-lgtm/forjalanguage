// Jogo v2 do teste de hot reload (M8 H3): mesma interface da v1, o contador sobe 10 por quadro. Versao: 1.0.0. Changelog: 1.0.0 - H3: primeira versao.
struct Estado {
    passos: i64
    soma: f64
    ultimo: f64
}

pub export proc update(e: ^Estado, dt: f64) {
    e.passos += 10
    e.soma += dt
    e.ultimo = dt
}

proc main() {
}
