// Jogo v1 do teste de hot reload (M8 H3). Versao: 1.0.0. Changelog: 1.0.0 - H3: primeira versao, o contador do host sobe 1 por quadro.
struct Estado {
    passos: i64
    soma: f64
    ultimo: f64
}

pub export proc update(e: ^Estado, dt: f64) {
    e.passos += 1
    e.soma += dt
    e.ultimo = dt
}

proc main() {
}
