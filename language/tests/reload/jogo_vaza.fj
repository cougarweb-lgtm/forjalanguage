// Jogo que vaza do teste de hot reload (M8 H3): cada update aloca um bloco no heap e nao libera; em dev o R0009 aparece ao descarregar. Versao: 1.0.0. Changelog: 1.0.0 - H3: primeira versao.
struct Estado {
    passos: i64
    soma: f64
    ultimo: f64
}

struct Vazamento {
    valor: i64
}

proc aloca_vazamento(valor: i64) -> ^Vazamento {
    let v = new(Vazamento, alloc = heap)
    v.valor = valor
    return v
}

pub export proc update(e: ^Estado, dt: f64) {
    e.passos += 1
    e.soma += dt
    e.ultimo = dt
    _ = aloca_vazamento(e.passos)
}

proc main() {
}
