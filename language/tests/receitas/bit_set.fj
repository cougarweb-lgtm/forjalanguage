// receita: bit_set
// tags: bit_set conjunto flags conjunto_bits
// titulo: bit_set[Enum] - conjunto de membros com uniao, interseccao e diferenca
// nota: membros do enum usado em bit_set nao tem "= valor" (com valor = E0319); o limite e 64 membros.
// nota: {} e vazio; o literal so funciona com o tipo dado pelo contexto (var s: bit_set[Cor] = {...}).
// nota: | e uniao, & e interseccao, - e diferenca; len conta membros; has(s, key = c) testa um.
enum Cor { vermelho, verde, azul }
proc main() {
    var s: bit_set[Cor] = {Cor.verde}
    insert(&s, key = Cor.azul)
    print(has(s, key = Cor.verde))
    print(has(s, key = Cor.vermelho))
    let t: bit_set[Cor] = {Cor.azul}
    print(len(s | t))
    print(len(s & t))
    print(len(s - t))
}
