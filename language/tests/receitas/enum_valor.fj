// receita: enum_valor
// tags: enum_valor valor_enum
// titulo: Enum com valor fixo por membro, lido no C
// nota: enum Nivel { baixo = -1, medio = 0, alto = 5 } fixa o numero de cada membro; valor repetido = E0202 e fora de i32 = E0420.
// nota: as int em enum = E0301: o numero nao se le com as; ele so chega ao C, que recebe o enum como int32 (aqui pelo foreign).
// nota: enum sempre qualificado no uso: Nivel.baixo, nunca baixo sozinho.
foreign {
    link "msvcrt"
    proc c_abs = "abs"(x: Nivel) -> i32
}

enum Nivel {
    baixo = -1
    medio = 0
    alto = 5
}

proc main() {
    print(c_abs(Nivel.baixo))
    print(c_abs(Nivel.alto))
    let n = Nivel.medio
    switch n {
    case Nivel.baixo:
        print("baixo")
    case Nivel.medio:
        print("medio")
    case Nivel.alto:
        print("alto")
    }
}
