// receita: erro
// tags: erro resultado try or_else falha
// titulo: Resultado T ! E com try, or_else e switch
// nota: T ! E e valor ou erro, e o E e um enum; try repassa o erro so se o proc devolver ! E do MESMO E.
// nota: x or_else v da o padrao quando da erro; switch r in f() trata os dois casos.
// nota: resultado ignorado nao compila (E0601): trate com switch, or_else ou try.
enum Erro { nao_achou, invalido }

proc achar(id: i32) -> i32 ! Erro {
    if id == 0 {
        return Erro.nao_achou
    }
    if id < 0 {
        return Erro.invalido
    }
    return id * 10
}

proc dobro(id: i32) -> i32 ! Erro {
    let v = try achar(id)
    return v * 2
}

proc main() {
    print(achar(3) or_else -1)
    print(achar(0) or_else -1)
    print(dobro(3) or_else 0)
    switch r in dobro(4) {
    case i32:
        print(r)
    case Erro:
        print("falhou")
    }
    switch r in dobro(-2) {
    case i32:
        print(r)
    case Erro:
        print("falhou")
    }
}
