// receita: sort_by
// tags: sort_by ordenar ordem sort sort_by_key
// titulo: Ordenar uma lista ou array (sort, sort_by, sort_by_key)
// nota: sort(s) ordena numeros em ordem crescente; s e a fatia l[..] (ou um array), nunca a lista inteira.
// nota: sort_by(s, less = p) usa um proc proprio proc(^T, ^T) -> bool: devolve true quando o 1o vem antes do 2o; passe o NOME do proc.
// nota: sort_by_key(s, key = Item.peso) ordena structs pelo campo (so a chave, sem proc).
proc maior_antes(a: ^int, b: ^int) -> bool {
    return a^ > b^
}

proc main() {
    var l = make([dynamic]int, alloc = heap)
    defer delete(l)
    append(&l, item = 3)
    append(&l, item = 1)
    append(&l, item = 2)
    sort(l[..])
    print(l[0])
    sort_by(l[..], less = maior_antes)
    print(l[0])
}
