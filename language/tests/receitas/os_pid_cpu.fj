// receita: os_pid_cpu
// tags: os_pid_cpu os_pid cpu_count pid_processo nucleos
// titulo: std:os - pid do processo e numero de nucleos
// nota: os.pid() devolve o pid do proprio processo; os.cpu_count() devolve o numero de nucleos logicos (int).
// nota: So leitura: use o pid para nomear arquivo por processo e o cpu_count para dimensionar um pool de threads.
import "std:os"
proc main() {
    print(os.pid() > 0)
    print(os.cpu_count() >= 1)
}
