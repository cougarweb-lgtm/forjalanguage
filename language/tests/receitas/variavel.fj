// receita: variavel
// tags: variavel let var const atribuir constante mutavel
// titulo: Variavel, constante e atribuicao
// nota: let e imutavel; var e mutavel; const e global, de nome MAIUSCULO e com tipo escrito.
// nota: += e -= so em var (*= e /= nao existem); atribuir a let ou a parametro e erro (E0705).
// nota: inteiro sem contexto e int (64 bits); real sem contexto e f32.
const MAX: i32 = 100

proc main() {
    let x = 5
    var n: i32 = 0
    n += 1
    n += x as i32
    print(n)
    print(MAX)
}
