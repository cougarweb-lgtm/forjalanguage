// receita: condicional
// tags: condicional if else e ou nao
// titulo: If, else if e else com and, or e not
// nota: if e else sem parenteses e com chaves; o corpo fica em linhas separadas.
// nota: logica e and, or, not; && || ! nao existem.
// nota: nao ha ?: (ternario): para guardar um valor, declare var e atribua em cada ramo.
proc faixa(nota: int) -> int {
    var r = 1
    if nota >= 90 {
        r = 3
    } else if nota >= 70 or nota == 60 {
        r = 2
    }
    return r
}

proc main() {
    let ativo = true
    let bloqueado = false
    if ativo and not bloqueado {
        print(1)
    } else {
        print(0)
    }
    print(faixa(95))
    print(faixa(60))
    print(faixa(10))
    var s = 0
    if not ativo or bloqueado {
        s = 1
    } else if s == 0 {
        s = 2
    }
    print(s)
}
