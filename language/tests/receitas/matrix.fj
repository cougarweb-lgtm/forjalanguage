// receita: matrix
// tags: matrix matriz vetor_matriz transpose
// titulo: matrix[R, C]T - literal por linhas, m * v e transpose
// nota: o literal de matrix vai POR LINHAS: {1.0, 2.0, 3.0, 4.0} em 2x2 e [1 2; 3 4]; m[linha, coluna] le e grava.
// nota: sem ==, sem m[i], sem for e sem len em matrix; imprima elemento a elemento com as int dentro de print.
// nota: v * m nao existe (E0321): escreva transpose(m) * v.
proc main() {
    var m: matrix[2, 2]f32 = {1.0, 2.0, 3.0, 4.0}
    m[0, 1] = 5.0
    let v: [2]f32 = {1.0, 1.0}
    let w = m * v
    print(w[0] as int)
    print(w[1] as int)
    let t = transpose(m)
    print(t[1, 0] as int)
    let p = m * m
    print(p[0, 0] as int)
}
