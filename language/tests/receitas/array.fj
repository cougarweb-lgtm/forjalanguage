// receita: array
// tags: array fatia colecao indice
// titulo: Array de tamanho fixo, copia por valor e fatia
// nota: [N]T e valor: atribuir ou passar copia; literal {..} tem exatamente N elementos (senao E0309); {} zera tudo.
// nota: array nao vira fatia sozinho: para ler ou alterar pela funcao passe a[..] (fatia []T); a[1..<3] pega um trecho.
// nota: fatia nao e dona: nao se da delete nela; devolver a[..] de array local e E0706.
const N: int = 4

proc soma(v: []int) -> int {
    var total = 0
    for x in v {
        total += x
    }
    return total
}

proc zerar_primeiro(v: []int) {
    v[0] = 0
}

proc main() {
    var a: [N]int = {1, 2, 3, 4}
    var copia = a
    copia[0] = 100
    print(a[0])
    print(copia[0])
    print(soma(a[..]))
    print(soma(a[1..<3]))
    zerar_primeiro(a[..])
    print(a[0])
    let z: [3]int = {}
    print(len(z) + z[2])
}
