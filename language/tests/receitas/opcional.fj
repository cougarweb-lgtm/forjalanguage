// receita: opcional
// tags: opcional talvez none ausente
// titulo: Valor opcional com none, or_else e switch
// nota: ?T guarda um valor ou none; int vira ?int sozinho em return n, e return none marca a ausencia.
// nota: le com x or_else padrao (o padrao so entra se for none) ou com switch x in f() { case int: ... case none: ... }.
// nota: comparar com none vale (x == none); comparar ?T com ?T, contar ou acessar campo nao (E0312).
proc achar(n: int) -> ?int {
    if n > 0 {
        return n
    }
    return none
}

proc main() {
    let a = achar(3) or_else 0
    let b = achar(-1) or_else 0
    print(a + b)
    switch x in achar(-2) {
    case int:
        print(x)
    case none:
        print("nada")
    }
    if achar(4) == none {
        print("sem")
    } else {
        print("com")
    }
}
