// receita: loop
// tags: loop for while repetir contar iterar intervalo
// titulo: Laco for e while
// nota: 0..<n e exclusivo (vai ate n-1); 1..=n e inclusivo. Nao existe 'for cond {}': use while.
// nota: break sai do laco; continue pula para a proxima volta.
proc main() {
    var soma = 0
    for i in 0..<4 {
        soma += i
    }
    print(soma)
    for i in 1..=4 {
        soma += i
    }
    print(soma)
    var k = 0
    while k < 10 {
        k += 3
        if k == 6 {
            continue
        }
        if k > 8 {
            break
        }
    }
    print(k)
}
