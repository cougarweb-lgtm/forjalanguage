// receita: memoria
// tags: memoria alocar heap new delete defer_delete
// titulo: Alocacao no heap com new, delete e defer delete
// nota: new(T, alloc = heap) devolve ^T nunca nulo com os padroes da struct; alloc = e obrigatorio (o antigo em = da E0110, forma antiga).
// nota: heap tem dono unico: guarde o resultado e libere com delete ou defer delete; sem isso e E0317 ou R0009 no fim do run.
// nota: alloc = scope so vale como inicializador direto de let/var e solta no fim do bloco; nao sai dele (E0316).
struct Bala {
    dano: int = 1
    tipo: int = 2
}

proc main() {
    let b = new(Bala, alloc = heap)
    defer delete(b)
    b.dano = 7
    print(b.dano + b.tipo)
    let c = new(Bala, alloc = heap)
    c.tipo = 5
    print(c.dano * c.tipo)
    delete(c)
    let t = new(Bala, alloc = scope)
    print(t.dano)
}
