// receita: rand
// tags: rand std_rand aleatorio semente sorteio
// titulo: std:rand - gerador com semente (mesma semente, mesma sequencia)
// nota: seed(n) da um Rng deterministico (xoshiro256**); seed_from_clock muda a cada execucao: nao use em teste fixo.
// nota: as chamadas pedem ^Rng: declare com var e passe &rng; sem var o estado nao avanca.
// nota: a mesma semente sempre da a mesma sequencia: guarde a semente para repetir um caso.
import "std:rand"
proc main() {
    var rng = rand.seed(0)
    print(rand.next_u64(&rng))
    print(rand.next_u64(&rng))
    var outro = rand.seed(0)
    print(rand.next_u32(&outro))
    print(rand.next_u32(&outro))
}
