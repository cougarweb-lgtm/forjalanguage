// receita: proc
// tags: proc funcao parametro argumento retorno
// titulo: Procedimento, argumento nomeado, ponteiro de parametro e retorno multiplo
// nota: parametro e imutavel; para alterar o valor de quem chamou, passe ^T com &x e grave com p^.
// nota: 1o argumento posicional, os demais nomeados (nome = valor); posicional depois de nomeado = E0502.
// nota: retorno multiplo e nomeado: let q, r = f(); _ descarta um dos valores.
proc dobrar(v: ^int) {
    v^ = v^ * 2
}

proc soma(a: int, b: int = 10) -> int {
    return a + b
}

proc par(n: int) -> (q: int, r: int) {
    return n / 2, n % 2
}

proc main() {
    var x = 4
    dobrar(&x)
    print(x)
    print(soma(1))
    print(soma(1, b = 2))
    let q, _ = par(7)
    print(q)
    let _, r = par(7)
    print(r)
}
