// receita: ponteiro
// tags: ponteiro endereco deref nulo anulavel
// titulo: Ponteiro ^T, ?^T anulavel, p^ e p.campo
// nota: ^T nunca e nulo; o anulavel e ?^T, testado com == none antes do `as ^T`.
// nota: p^ le e grava pelo ponteiro; p.campo ja desreferencia um nivel sozinho.
// nota: sem aritmetica de ponteiro (E0306); &x so vale para var local ou parametro.
struct No {
    valor: int
    prox: ?^No = none
}

proc dobrar(p: ^int) {
    p^ = p^ * 2
}

proc valor_do_proximo(n: ^No) -> int {
    if n.prox == none {
        return -1
    }
    let q: ^No = n.prox as ^No
    return q.valor
}

proc main() {
    var x: int = 5
    let p: ^int = &x
    p^ = p^ + 2
    dobrar(p)
    print(x)
    var b = No{valor = 9}
    var a = No{valor = 4, prox = &b}
    print(valor_do_proximo(&a))
    b.valor = b.valor + 1
    print(valor_do_proximo(&a))
    print(a.prox == none)
}
