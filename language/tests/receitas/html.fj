// receita: html
// tags: html std_html escapar entidade
// titulo: std:text - escapar e desfazer escape de HTML
// nota: text.html_escape troca & < > " ' por &amp; &lt; &gt; &quot; &#39;; devolve texto do alocador que voce passa (heap aqui, com delete).
// nota: text.html_unescape desfaz as 5 entidades nomeadas e as numericas; entidade invalida fica como texto comum, nao falha.
import "std:text"
proc main() {
    let limpo = text.html_escape("<a href=\"x\">Tom & Jerry</a>", alloc = heap)
    defer delete(limpo)
    print(limpo)
    let volta = text.html_unescape("&lt;b&gt; &amp; &#65;", alloc = heap)
    defer delete(volta)
    print(volta)
}
