// receita: imprimir
// tags: imprimir print saida
// titulo: print de inteiro, bool, str e real; as int; f"..." com largura
// nota: print aceita inteiro, bool, str, cstr e real (f32 e f64 imprimem 2.5 direto).
// nota: x as int trunca a parte fracionaria (2.5 vira 2); f"..." monta texto com formato.
// nota: f"a={a:03}" le o inteiro com largura 3 e zero a esquerda; cada print termina a linha.
proc main() {
    let a = 7
    let ok = true
    let nome = "forja"
    print(a)
    print(ok)
    print(nome)
    let r: f32 = 2.5
    print(r as int)
    print(r)
    print(f"a={a:03} ok={ok} nome={nome}")
    print(a + 1)
}
