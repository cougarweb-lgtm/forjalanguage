// receita: numero
// tags: numero conversao as transmute
// titulo: Conversao com as, transmute de bits e operadores sem sinal
// nota: sem conversao implicita: int + i32 = E0301; converta antes com as, como em (e as i32) + 1.
// nota: transmute(x, to = T) reinterpreta os bits (mesmo tamanho, E0304); & | ~ << >> so em tipos sem sinal.
// nota: estreitar fora da faixa com as = R0002 em dev (overflow trava; release da a volta).
proc main() {
    let a: i64 = 300
    let b = a as i32
    let c: i32 = 7
    print(b + c)
    let e: u8 = 255
    print((e as i32) + 1)
    let f: f32 = 1.0
    let bits = transmute(f, to = u32)
    print(bits)
    let flags: u32 = 0xF0
    print(flags & 0x3C)
    print(flags >> 4)
    let n: f32 = 2.75
    print(n as int)
}
