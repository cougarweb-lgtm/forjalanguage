// receita: comentario
// tags: comentario comentarios barra_dupla
// titulo: Comentario so com // ate o fim da linha
// nota: so existe // (ate o fim da linha); ele pode vir depois de codigo, como print(1) // fim.
// nota: bloco de comentario nao existe (E0101) e /// e um // comum; nao tente desligar trecho com bloco.
proc main() {
    // esta linha inteira e comentario
    print(1) // comentario depois do codigo
    print(2)
}
