// receita: array_conta
// tags: array_conta soma_vetorial elemento_a_elemento
// titulo: [N]T com + - * / e k * a por elemento
// nota: + - * / entre [N]T sao por elemento (nao e produto escalar); += e -= valem, *= e /= nao existem.
// nota: N diferentes ou tipo nao numerico dao E0331; == entre arrays da E0308: compare elemento a elemento.
// nota: literal real sem contexto e f32; use o mesmo tipo nos dois lados da conta.
proc main() {
    let a: [3]f32 = {1.0, 2.0, 3.0}
    let b: [3]f32 = {0.5, 0.5, 0.5}
    var c = a + b
    c += b
    let e = 2.0 * a
    print(c[0] as int)
    print(c[2] as int)
    print(e[2] as int)
    print(len(c))
}
