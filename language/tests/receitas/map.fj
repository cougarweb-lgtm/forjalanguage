// receita: map
// tags: map dicionario tabela insert get has remove
// titulo: map[K]V - insert, get com or_else, has e remove
// nota: make(map[K]V, alloc = heap) e DONO: defer delete(m); insert e remove recebem &m (endereco).
// nota: get devolve ?V: use or_else ou switch; m[k] nao existe, use get.
// nota: chave repetida sobrescreve; for k, v in m percorre na ordem de insercao.
proc main() {
    var m = make(map[str]int, alloc = heap)
    defer delete(m)
    insert(&m, key = "ouro", value = 10)
    insert(&m, key = "prata", value = 4)
    insert(&m, key = "ouro", value = 12)
    print(len(m))
    print(get(m, key = "ouro") or_else 0)
    print(has(m, key = "cobre"))
    remove(&m, key = "prata")
    print(len(m))
    print(get(m, key = "prata") or_else -1)
    for k, v in m {
        print(len(k) + v)
    }
}
