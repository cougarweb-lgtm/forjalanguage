// receita: text
// tags: text std_text dividir juntar aparar
// titulo: std:text - dividir, juntar, aparar e ler inteiro
// nota: split e join pedem alloc = heap; o resultado e dono: delete na lista e no str. join recebe partes[..] (fatia), nao a lista.
// nota: str nao tem + nem indice; monte o texto com text.join, format ou f"...". "..." nunca interpola.
// nota: parse_int devolve int ! ParseError: use or_else ou switch; "12a" nao vira 0, da erro.
import "std:text"
proc main() {
    let bruto = "  maca,pera,uva  "
    let limpo = text.trim(bruto)
    print(limpo)
    var partes = text.split(limpo, ",", alloc = heap)
    defer delete(partes)
    print(len(partes))
    let junto = text.join(partes[..], " | ", alloc = heap)
    defer delete(junto)
    print(junto)
    print(text.parse_int("42") or_else 0)
    print(text.parse_int("12a") or_else -1)
    print(text.starts_with(limpo, "pe"))
}
