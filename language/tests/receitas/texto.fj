// receita: texto
// tags: texto string str cstr len igualdade
// titulo: str em bytes UTF-8, igualdade e f"..." com format
// nota: str e bytes UTF-8 imutaveis: len conta bytes ("olá" tem 4); == e != valem, sem + e sem indice.
// nota: "..." nunca interpola; monte texto com f"{expr:larg}", e {{ vira chave.
// nota: format(f"...", alloc = heap) devolve str e pede delete; str -> cstr so por format_c.
proc main() {
    let s: str = "olá"
    print(len(s))
    print(s == "olá")
    print(s != "ola")
    let n = 7
    let t = format(f"vida {n} x={n + 2:03}", alloc = heap)
    defer delete(t)
    print(t)
    print(len(t))
    print(f"{{chave}} {n}")
}
