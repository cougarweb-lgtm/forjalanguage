// receita: dynamic
// tags: dynamic lista make append cap
// titulo: Lista dinamica dona com make, append por endereco e delete
// nota: make([dynamic]T, alloc = heap, cap = N) cria lista vazia; precisa de var; append recebe o ENDERECO: append(&l, item = x).
// nota: lista e dona: nao se copia (let b = a e E0311); libere com delete(l) ou defer delete(l).
// nota: dentro de proc o parametro e ^[dynamic]T e append(l, item = x) vai direto; para ler ou alterar elementos passe l[..] a uma fatia.
proc encher(l: ^[dynamic]int, n: int) {
    for i in 0..<n {
        append(l, item = i * i)
    }
}

proc soma(v: []int) -> int {
    var total = 0
    for x in v {
        total += x
    }
    return total
}

proc main() {
    var l = make([dynamic]int, alloc = heap, cap = 2)
    defer delete(l)
    append(&l, item = 10)
    encher(&l, n = 4)
    print(len(l))
    print(l[4])
    print(soma(l[..]))
}
