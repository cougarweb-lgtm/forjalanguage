// receita: hexadecimal
// tags: hexadecimal hex binario literal_hex
// titulo: Literais 0x e 0b (sem _ dentro do numero)
// nota: 0xFF e 0b1010 valem onde o tipo couber; o tipo vem do contexto (u32, u8...).
// nota: _ nao vale dentro do literal: 0b1010_0000 da E0001; escreva 0b10100000.
// nota: >>, & e | so existem em tipo sem sinal: para bits use u8 ou u32.
proc main() {
    let cor: u32 = 0xE0E0E0FF
    print(cor >> 24)
    let flags: u8 = 0b10100000
    print(flags | 0b00000001)
    print(0xFF)
    print(0b1010)
}
