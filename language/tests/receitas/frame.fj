// receita: frame
// tags: frame frame_reset quadro
// titulo: Memoria de quadro com alloc = frame e frame_reset
// nota: alloc = frame aloca na arena de 16 MiB do modulo; nao se libera um a um: quem esvazia e frame_reset().
// nota: depois de frame_reset() lista ou ponteiro de frame velho nao vale mais; uso = R0008 em dev. Aloque de novo no quadro seguinte.
// nota: delete em memoria de frame e valido e nao faz nada; nao o use como substituto do frame_reset.
proc main() {
    var q = 0
    while q < 3 {
        var l = make([dynamic]int, alloc = frame, cap = 1)
        append(&l, item = q + 5)
        append(&l, item = q * 10)
        print(l[0] + l[1])
        frame_reset()
        q += 1
    }
}
