// receita: fuso
// tags: fuso std_fuso zona_horaria offset_iso rfc5322
// titulo: std:time - ler ISO com deslocamento e escrever no fuso local
// nota: time.parse_iso_offset devolve ZonedTime (instante UTC + offset_s); o texto do fuso vai no offset_s em segundos a leste de Greenwich (Sao Paulo = -10800).
// nota: time.format_iso_offset e time.format_rfc5322 recebem o instante UTC e o offset e devolvem texto do alocador que voce passa.
import "std:time"
proc main() {
    switch r in time.parse_iso_offset("2026-11-18T21:05:00-03:00") {
    case time.ZonedTime:
        print(r.offset_s)
        let utc = time.format_iso(r.dt_utc, alloc = heap)
        defer delete(utc)
        print(utc)
        let local = time.format_iso_offset(r.dt_utc, r.offset_s, alloc = heap)
        defer delete(local)
        print(local)
        let rfc = time.format_rfc5322(r.dt_utc, r.offset_s, alloc = heap)
        defer delete(rfc)
        print(rfc)
    case time.TimeError:
        print("data invalida")
    }
}
