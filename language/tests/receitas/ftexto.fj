// receita: ftexto
// tags: ftexto format interpolar formatar
// titulo: Texto formatado com f-string, format e delete
// nota: f"a={a} b={a + 1:03}" interpola; {e:FMT} usa [0][largura][.precisao][x]; {{ e }} sao chaves literais.
// nota: "..." comum nunca interpola; f"..." so vale como 1o argumento de print, format ou format_c.
// nota: format(f"...", alloc = heap) devolve str que pede delete; format_c devolve cstr (com NUL) para falar com C.
proc main() {
    let a = 1
    let s = format(f"a={a} b={a + 1:03}", alloc = heap)
    defer delete(s)
    print(s)
    print(len(s))
    print(f"vida {7:04} {{ok}}")
    let c = format_c(f"id {a}", alloc = heap)
    defer delete(c)
    print(c as str)
}
