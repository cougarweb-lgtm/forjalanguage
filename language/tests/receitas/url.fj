// receita: url
// tags: url std_url endereco_web percentual query_string
// titulo: std:url - codificar, decodificar e separar uma URL
// nota: url.encode e url.decode_form devolvem texto do alocador que voce passa (aqui uma Arena); o '+' vira espaco so no formulario.
// nota: url.parse nao aloca: os campos de Url sao vistas do texto de entrada, que tem de viver enquanto a Url for usada.
// nota: URL invalida (escape % sem dois digitos ou porta ruim) volta como UrlError, nunca como texto vazio.
import "std:mem"
import "std:url"
proc main() {
    let a = mem.arena_create()
    defer mem.arena_destroy(a)
    print(url.encode("a b&c", alloc = a))
    print(url.decode_form("a+b%21", alloc = a) or_else "?")
    switch r in url.parse("https://exemplo.com:8443/caminho?q=1#topo") {
    case url.Url:
        print(r.host)
        print(r.port)
        print(r.path)
    case url.UrlError:
        print("url invalida")
    }
}
