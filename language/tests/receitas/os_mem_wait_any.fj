// receita: os_mem_wait_any
// tags: os_mem_wait_any os_mem_available wait_any espera_filhos memoria_livre
// titulo: std:os mem_available e std:process wait_any (Windows)
// nota: os.mem_available() devolve a RAM livre em bytes (u64 ! OsError); no Linux e o freeram, menor que o MemAvailable.
// nota: process.wait_any(ps, timeout_ms) devolve o indice do primeiro filho que termina, ou -1 se o prazo passar; ate 64 filhos no Windows (8 no Linux).
import "std:os"
import "std:process"
proc main() {
    switch m in os.mem_available() {
    case u64:
        print(m > 0)
    case os.OsError:
        print("sem dado")
    }
    var args: [3]str = {"/c", "exit", "7"}
    let cmd = process.Command{program = "cmd.exe", args = args[..], env = {}, cwd = "", timeout_ms = 0}
    switch p in process.spawn(cmd) {
    case process.Process:
        var ps: [1]process.Process = {p}
        print(process.wait_any(ps[..], timeout_ms = -1) or_else -9)
        print(process.exit_code(p))
        process.close(p)
    case process.ProcessError:
        print("falhou")
    }
}
