// receita: perfil_resumo
// tags: perfil_resumo perfil gargalo medir_proc chrome_trace
// titulo: --perfil - onde o tempo vai, proc a proc
// nota: forja build --perfil a.fj -o a.exe grava a.exe.perfil.txt (agregado por proc: chamadas, total, proprio, %proprio, nome; o que a IA le) e a.exe.perfil.json (Chrome Trace, abre no Perfetto).
// nota: Procs inlinadas nao aparecem em release (--sem-otim inline as mostra). O custo e ~9-10x: serve para achar o gargalo, nao para medir tempo absoluto.
// nota: FORJA_PERFIL_SAIDA=<base sem extensao> troca o caminho. forja run --perfil sem ela nao deixa arquivo acessivel (o exe e temporario): use build.
proc fib(n: int) -> int {
    if n < 2 {
        return n
    }
    return fib(n - 1) + fib(n - 2)
}
proc main() {
    print(fib(20))
}
