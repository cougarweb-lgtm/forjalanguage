// receita: enum
// tags: enum switch caso
// titulo: Enum com valor, case qualificado e switch sem fallthrough
// nota: valor de enum e sempre qualificado: Nivel.medio, tambem no case.
// nota: switch cobre todos os casos ou tem default (E0607); nao ha fallthrough.
// nota: as int em enum = E0301; para ler o membro, use switch.
enum Nivel { baixo = -1, medio, alto }

proc peso(n: Nivel) -> int {
    var p = 0
    switch n {
    case Nivel.baixo:
        p = 10
    case Nivel.medio:
        p = 20
    case Nivel.alto:
        p = 30
    }
    return p
}

proc main() {
    let n = Nivel.medio
    print(peso(n))
    print(peso(Nivel.alto))
    print(peso(Nivel.baixo))
    var total = 0
    switch n {
    case Nivel.baixo:
        total = 1
    default:
        total = 2
    }
    print(total)
}
