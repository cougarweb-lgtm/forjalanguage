// receita: unidade
// tags: unidade medida fisica
// titulo: Unidade fisica, unidade derivada e troca com as
// nota: + - == so entre a mesma unidade; somar Metros com Segundos = E0412.
// nota: unidade derivada se declara com unit X = A/B; trocar de unidade so com as.
// nota: literal numerico entra direto no tipo da unidade: let d: Metros = 100.0.
unit Metros: f32
unit Segundos: f32
unit MetrosPorSegundo = Metros / Segundos

proc somar_percurso(a: Metros, b: Metros) -> Metros {
    return a + b
}

proc main() {
    let d: Metros = 100.0
    let e: Metros = 50.0
    let t: Segundos = 8.0
    let v: MetrosPorSegundo = d / t
    print(v as int)
    print(somar_percurso(d, e) as int)
    print((d as i32) + 1)
    print(d == e)
}
