// receita: builder
// tags: builder to_str montar_texto buffer concatenar
// titulo: Montar um texto aos poucos (builder de bytes)
// nota: str nao tem `+`: o builder e uma lista de bytes (make([dynamic]u8, alloc = heap)); append(&buf, item = "txt") e format(f"...", into = &buf) acrescentam.
// nota: to_str(&buf) move os bytes para uma str e esvazia o buffer; a str devolvida e dona: delete(s). O buffer tambem pede delete.
proc main() {
    var buf = make([dynamic]u8, alloc = heap)
    defer delete(buf)
    append(&buf, item = "vida ")
    format(f"{7}", into = &buf)
    append(&buf, item = "!")
    let s = to_str(&buf)
    defer delete(s)
    print(s)
    print(len(s))
}
