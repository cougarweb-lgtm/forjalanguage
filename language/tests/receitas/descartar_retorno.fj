// receita: descartar_retorno
// tags: descartar_retorno descartar resultado_ignorado
// titulo: Resultado de funcao: descartar com _ = ou guardar
// nota: f() solto como linha de comando nao compila (E0709): escreva `_ = f()` para descartar de proposito.
// nota: `let _r = f()` guarda sem uso e sem erro (nome com _ na frente e isento de E0708).
proc contar(n: int) -> int {
    print(n)
    return n * 2
}
proc main() {
    _ = contar(3)
    let _r = contar(5)
    let dobro = contar(4)
    print(dobro)
}
