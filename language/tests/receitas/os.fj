// receita: os
// tags: os std_os ambiente argumentos sair
// titulo: std:os - argumentos, ambiente e saida do processo
// nota: os.env devolve ?str: ausente da none (use or_else); existente e vazia da "". O texto e emprestado: sem delete.
// nota: os.args()[0] e o programa; conte com len em vez de comparar com um caminho fixo.
// nota: os.exit(n) aceita so 0..255 (outro valor = R0012) e descarrega o stdout antes de sair.
import "std:os"
proc main() {
    print(len(os.args()) >= 1)
    print(os.env("RECEITA_NAO_EXISTE_XYZ") or_else "padrao")
    os.exit(0)
}
