// receita: tupla
// tags: tupla retorno_multiplo desestruturar
// titulo: Retorno multiplo com nomes e desestruturacao
// nota: proc f() -> (a: int, b: int) devolve de 2 a 8 valores com return x, y; quem chama usa let a, b = f().
// nota: _ descarta um elemento (let _, c = f()); a tupla nao e valor solto: sem variavel unica, sem ==, sem argumento (E0314/E0301).
proc par(n: int) -> (a: int, b: int) {
    return n, n + 1
}

proc divmod(n: int, d: int) -> (q: int, r: int) {
    return n / d, n % d
}

proc main() {
    let a, b = par(1)
    print(a)
    print(b)
    let _, c = par(5)
    print(c)
    let q, r = divmod(17, 5)
    print(q * 10 + r)
}
