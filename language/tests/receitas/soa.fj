// receita: soa
// tags: soa colunas struct_de_arrays
// titulo: soa[N]S - struct de arrays, a.campo e a coluna
// nota: {} zera TUDO e ignora os padroes da struct (vx fica 0, nao 2); atribua o que precisa.
// nota: a[i].campo le e grava; a.campo e a fatia []int da coluna, que serve para funcao que recebe []int.
// nota: soa dinamico e dono como lista: make(..., alloc = heap) pede delete; &a[i] nao vale (E0320).
struct Particula {
    x: int = 0
    vx: int = 2
}
proc soma(valores: []int) -> int {
    var total = 0
    for item in valores {
        total += item
    }
    return total
}
proc main() {
    var a: soa[3]Particula = {}
    a[1].vx = 5
    a[1].x += a[1].vx
    print(a[0].vx)
    print(a[1].x)
    print(soma(a.x))
    var b = make(soa[dynamic]Particula, alloc = heap)
    defer delete(b)
    append(&b, item = Particula{x = 7})
    print(b[0].x)
}
