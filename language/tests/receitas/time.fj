// receita: time
// tags: time std_time data_iso calendario
// titulo: std:time - epoca em nanossegundos, ISO 8601 e soma de dias
// nota: from_unix_ns, parse_iso e add_days sao puros e deterministicos; now() e Stopwatch nao sao (nao imprima em teste fixo).
// nota: format_iso pede alloc = heap e o str e dono (delete); parse_iso devolve DateTime ! TimeError: use or_else.
// nota: add_days respeita ano bissexto: 2024-02-28 mais 2 dias e 2024-03-01.
import "std:time"
proc mostrar_iso(dt: time.DateTime) {
    let texto = time.format_iso(dt, alloc = heap)
    defer delete(texto)
    print(texto)
}
proc main() {
    let dt = time.from_unix_ns(1700000000000000000)
    mostrar_iso(dt)
    mostrar_iso(time.add_days(dt, 1))
    let fevereiro = time.parse_iso("2024-02-28T10:00:00Z") or_else time.from_unix_ns(0)
    mostrar_iso(fevereiro)
    mostrar_iso(time.add_days(fevereiro, 2))
    print(time.is_leap_year(2024))
    print(time.ns_to_ms(time.seconds_to_ns(3)))
}
