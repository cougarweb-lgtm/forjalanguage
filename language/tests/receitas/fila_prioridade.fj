// receita: fila_prioridade
// tags: fila_prioridade heap_push heap_pop heap_push_by heap_pop_by monte
// titulo: Fila de prioridade (heap_push, heap_pop)
// nota: a lista e o monte: heap_push(&l, v) insere e heap_pop(&l) tira o MENOR (devolve ?T, none se vazia).
// nota: para outra ordem use heap_push_by(&l, v, less = p) e heap_pop_by(&l, less = p) com o MESMO p nas duas chamadas.
proc maior_antes(a: ^int, b: ^int) -> bool {
    return a^ > b^
}

proc main() {
    var l = make([dynamic]int, alloc = heap)
    defer delete(l)
    heap_push(&l, 5)
    heap_push(&l, 2)
    heap_push(&l, 8)
    print(heap_pop(&l) or_else -1)
    print(heap_pop(&l) or_else -1)
    var m = make([dynamic]int, alloc = heap)
    defer delete(m)
    heap_push_by(&m, 5, less = maior_antes)
    heap_push_by(&m, 8, less = maior_antes)
    print(heap_pop_by(&m, less = maior_antes) or_else -1)
}
