// receita: defer
// tags: defer limpeza
// titulo: Defer roda na saida do bloco, em ordem inversa
// nota: defer roda na saida do bloco onde foi escrito, em ordem inversa a da escrita.
// nota: o comando INTEIRO vai para o fim: defer print(n * 10) le n na saida, nao no defer.
proc main() {
    var n = 1
    defer print(n * 10)
    if n == 1 {
        defer print(7)
        print(1)
    }
    n = 2
    print(n)
}
