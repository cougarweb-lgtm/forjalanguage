// receita: posse
// tags: posse vazamento delete_obrigatorio
// titulo: Dono de alocacao heap: delete em todos os caminhos ou entrega
// nota: let p = new(T, alloc = heap) faz de p o dono: antes do fim do bloco, delete(p) ou entrega (return, passar a proc, campo, append, &p).
// nota: return, break ou continue com o local ainda vivo e E0317; ponteiro de chamada (let g = criar()) nao e conferido no check e, se vazar, dev mostra R0009.
// nota: a analise nao segue o fluxo: delete num ramo so conta para o check, mas libere em todos os ramos.
struct Bala {
    dano: int = 1
}

proc criar(dano: int) -> ^Bala {
    let b = new(Bala, alloc = heap)
    b.dano = dano
    return b
}

proc main() {
    let g = criar(5)
    print(g.dano)
    delete(g)
    let p = new(int, alloc = heap)
    p^ = 4
    if p^ > 3 {
        print("grande")
        delete(p)
    } else {
        print("pequeno")
        delete(p)
    }
}
