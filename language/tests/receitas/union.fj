// receita: union
// tags: union variante soma
// titulo: Union de tipos distintos lida por switch
// nota: union Forma { Circulo, i32 } guarda uma variante; 9 as i32 (literal numerico pede as); struct entra direto: Circulo{raio = 2}.
// nota: le so por switch u in f { case Circulo: ... case i32: ... }; nao tem campo, nao tem ==, nao tem valor zero.
// nota: variante nao pode ser ?T, union, lista nem resultado (E0313).
struct Circulo {
    raio: i32 = 1
}

union Forma { Circulo, i32 }

proc area(f: Forma) -> i32 {
    var r: i32 = 0
    switch u in f {
    case Circulo:
        r = u.raio * u.raio * 3
    case i32:
        r = u
    }
    return r
}

proc main() {
    let f: Forma = 9 as i32
    let g: Forma = Circulo{raio = 2}
    print(area(f))
    print(area(g))
}
