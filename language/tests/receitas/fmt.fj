// receita: fmt
// tags: fmt std_fmt moeda dinheiro locale
// titulo: std:fmt - moeda e numero por locale (PT_BR, EN_US)
// nota: dinheiro vai em centavos (int): money(122334) com 2 casas sai R$ 1.223,34. Nunca use float para dinheiro.
// nota: number, money e integer pedem loc = fmt.PT_BR (const Locale), nao uma string; devolvem str com alloc = heap: delete.
// nota: o separador vem do locale: no PT_BR o ponto e de milhar e a virgula e decimal; no EN_US e o contrario.
import "std:fmt"
proc main() {
    let preco = fmt.money(122334, loc = fmt.PT_BR, alloc = heap)
    defer delete(preco)
    print(preco)
    let portugues = fmt.number(1234.5, loc = fmt.PT_BR, decimals = 2, alloc = heap)
    defer delete(portugues)
    print(portugues)
    let ingles = fmt.number(1234.5, loc = fmt.EN_US, decimals = 2, alloc = heap)
    defer delete(ingles)
    print(ingles)
    let contagem = fmt.integer(1234, loc = fmt.PT_BR, alloc = heap)
    defer delete(contagem)
    print(contagem)
}
