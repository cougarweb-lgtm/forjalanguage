// receita: wasm
// tags: wasm webassembly navegador wasi
// titulo: Compilar para WebAssembly (wasm32-wasip1) e rodar no navegador ou no Node
// nota: forja build --target wasm32-wasip1 [--release] a.fj -o a.wasm gera um modulo WASI preview1 (so build; run e test nao valem nesse alvo). O mesmo programa roda no x64 com a mesma saida.
// nota: O modulo importa so fd_write e proc_exit do wasi_snapshot_preview1; no JS: WebAssembly.instantiate com esses imports, ligar exports.memory e chamar exports._start(). O carregador pronto esta em gaveta\demo_wasm\demo_wasm.html; no Node, tests\nativo\wasm\rodar_wasm.mjs.
// nota: No dev o estouro de inteiro da R0002 (exit 101, JSON no stderr); no --release o valor da a volta. Ainda sem os.exit, fmt de f32/f64 e seno/cosseno/pow (X0001); heap, lista e fmt inteiro vem de std:wasm_rt, so neste alvo.
proc soma_quadrados(n: i32) -> i64 {
    var total: i64 = 0
    for i in 0..<n {
        total += (i as i64) * (i as i64)
    }
    return total
}

proc main() {
    print(soma_quadrados(10))
    print(soma_quadrados(1000))
}
