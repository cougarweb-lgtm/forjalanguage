// receita: file
// tags: file std_file ler_arquivo gravar_arquivo apagar_arquivo
// titulo: std:file - gravar, anexar, ler inteiro e apagar
// nota: write_all, append_str e remove_file devolvem ?FileError: o erro se testa com `!= none`, nao com 0. write_all leva []u8 (dados[..]); append_str leva str.
// nota: read_all(path, alloc = heap) devolve [dynamic]u8 ! FileError: lista DONA, delete no case [dynamic]u8.
// nota: o arquivo de teste e criado e apagado no diretorio atual; nao deixe lixo no diretorio.
import "std:file"
proc main() {
    let nome = "receita_file_tmp.txt"
    var dados: [3]u8 = {72, 105, 33}
    if file.write_all(nome, dados[..]) != none {
        print("falhou ao gravar")
    }
    if file.append_str(nome, "?") != none {
        print("falhou ao anexar")
    }
    switch lidos in file.read_all(nome, alloc = heap) {
    case [dynamic]u8:
        print(len(lidos))
        print(lidos[0] as int)
        delete(lidos)
    case file.FileError:
        print("falhou ao ler")
    }
    print(file.exists(nome))
    print(file.remove_file(nome) == none)
    print(file.exists(nome))
}
