// receita: wrapping
// tags: wrapping wrapping_add wrapping_sub wrapping_mul estouro volta saturating checked_add
// titulo: Aritmetica que da a volta, trava ou avisa o estouro
// nota: em dev e test, estouro de inteiro e R0001; para hash, contador ou PRNG use wrapping_add/sub/mul (da a volta, nunca falha).
// nota: os dois argumentos tem o MESMO tipo inteiro (senao E0334); o nome por extenso: saturating_add trava no limite; checked_add devolve ?T (none no estouro).
proc main() {
    let a: u8 = 250
    let b: u8 = 10
    print(wrapping_add(a, b))
    print(saturating_add(a, b))
    print(checked_add(a, b) or_else 0)
}
