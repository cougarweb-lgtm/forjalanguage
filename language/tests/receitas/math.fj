// receita: math
// tags: math std_math libm arredondar
// titulo: std:math - funcoes f64 da libm, lerp e graus
// nota: math.* trabalha em f64; print nao aceita real: converta com as int (trunca para zero) ou use f"...".
// nota: round arredonda metade para longe do zero (round(2.5) = 3.0); floor vai para baixo (floor(-0.5) = -1.0).
// nota: nan() e inf() sao procs, nao constantes; is_nan(nan()) da true. PI e constante f64.
import "std:math"
proc main() {
    print(math.round(2.5) as int)
    print(math.floor(-0.5) as int)
    print(math.lerp(1.0, 3.0, 0.5) as int)
    print(math.pow(2.0, 10.0) as int)
    print(math.is_nan(math.nan()))
    print((math.deg_to_rad(180.0) * 100.0) as int)
}
