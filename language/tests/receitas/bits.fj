// receita: bits
// tags: bits xor bitwise operador_bit bit_a_bit deslocamento count_ones
// titulo: Bits em inteiro sem sinal: and, or, xor, not, deslocamento e contagem
// nota: `& | ~ << >>` so valem em inteiro SEM sinal (E0303); o xor e `a ~ b` (binario) e `~a` (unario) e o not; `a ^ b` e E0110.
// nota: `& << >>` pesam como `*` e `| ~` como `+` (estilo Go): `a ~ b & 1` e `a ~ (b & 1)`; count_ones devolve `int`.
proc main() {
    let a: u8 = 12
    let b: u8 = 10
    print(a & b)
    print(a | b)
    print(a ~ b)
    print(~a)
    print(a << 2)
    print(a >> 2)
    print(a ~ b & 1)
    print(count_ones(a))
    print(wrapping_add(250 as u8, b))
}
