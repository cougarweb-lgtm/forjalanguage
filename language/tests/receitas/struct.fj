// receita: struct
// tags: struct campo registro literal
// titulo: Struct com campo por linha, literal nomeado e struct dentro de struct
// nota: literal so nomeado e com chaves: Grifo{vida = 50}; campo omitido pega o padrao e Tipo{} usa todos.
// nota: um campo por linha; faixa `vida: i32 in 0..=100 = 100` e padrao com =.
// nota: struct dentro de struct vale por valor; g.pos.y = 7 grava no proprio g.
struct Ponto {
    x: i32 = 0
    y: i32 = 0
}

struct Grifo {
    vida: i32 in 0..=100 = 100
    pos: Ponto
}

proc main() {
    var g = Grifo{vida = 50, pos = Ponto{x = 3}}
    g.pos.y = 7
    g.vida -= 5
    print(g.vida)
    print(g.pos.x + g.pos.y)
    let novo = Grifo{}
    print(novo.vida)
    print(novo.pos.y)
}
