// receita: tcp
// tags: tcp socket std_net conexao eco
// titulo: std:net - TCP local: ouvir, conectar, enviar e receber
// nota: net.tcp_listen("127.0.0.1:0") escolhe a porta; net.tcp_local_addr diz qual. Uma conexao ja aceita pelo SO entra na fila do backlog, por isso aqui o mesmo programa conecta e aceita.
// nota: net.tcp_recv devolve 0 quando o outro lado fechou; net.tcp_close e net.tcp_listener_close zeram o handle e nao derrubam o processo se chamados de novo.
// nota: o erro vai como NetError (conexao_recusada, timeout, fechado_pelo_outro); o main trata com switch, sem excecao.
import "std:net" as net
proc eco_local() -> ! net.NetError {
    var escuta = try net.tcp_listen("127.0.0.1:0")
    let ende = try net.tcp_local_addr(&escuta, heap)
    defer delete(ende)
    var cliente = try net.tcp_connect(ende, 2000)
    var servidor = try net.tcp_accept(&escuta, 2000)
    let enviados = try net.tcp_send(&cliente, as_bytes("oi"))
    var buf: [16]u8 = {}
    let lidos = try net.tcp_recv(&servidor, buf[..], 2000)
    let texto = from_bytes(buf[0..<lidos], alloc = heap)
    defer delete(texto)
    print(enviados)
    print(texto)
    _ = net.tcp_close(&cliente)
    _ = net.tcp_close(&servidor)
    _ = net.tcp_listener_close(&escuta)
}
proc main() {
    switch e in eco_local() {
    case net.NetError:
        print("falha de rede")
    default:
        print("eco ok")
    }
}
