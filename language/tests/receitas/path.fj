// receita: path
// tags: path std_path caminho extensao
// titulo: std:path - nome, extensao e base de um caminho
// nota: base, ext e stem aceitam / e \ e devolvem vista (str emprestado): nao precisam de delete.
// nota: ext pega so a ultima extensao ("dados.tar.gz" da ".gz"); stem tira so ela (da "dados.tar").
// nota: join2 e clean devolvem caminho com separador NATIVO (\ no Windows): nao compare a saida com um caminho fixo.
import "std:path"
proc main() {
    let arquivo = "arq/dados.tar.gz"
    print(path.base(arquivo))
    print(path.ext(arquivo))
    print(path.stem(arquivo))
    print(path.is_abs("relativo/caminho"))
}
