// receita: reload_erro
// tags: reload_erro reload hot_reload arquivo_inexistente dll_ausente
// titulo: std:reload - open de DLL inexistente devolve not_found
// nota: std:reload (so Windows; no Linux todo proc devolve unsupported_target) abre a DLL por copia sombra; caminho que nao existe devolve ReloadError.not_found, sem tocar em disco.
// nota: Quem recebe Library fecha com close; o caso de erro nao precisa de close porque nada foi aberto.
import "std:reload"
proc main() {
    switch r in reload.open("nao_existe_dll.dll", alloc = heap) {
    case reload.Library:
        print("abriu")
    case reload.ReloadError:
        print(r == reload.ReloadError.not_found)
    }
}
