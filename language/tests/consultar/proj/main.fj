// main.fj - projeto da fixture de 'forja consultar' (tests\consultar): dois modulos (main e jogo/fisica) mais std:mem.
import "std:mem"
import "jogo/fisica" as fis

enum Erro { cheio, vazio }

struct Mundo {
    corpos: [4]fis.Corpo
    quadros: i32 = 0
}

proc somar(a: i32, b: i32 = 2) -> i32 {
    let total = a + b
    return total
}

proc dividir(a: int, b: int) -> (q: int, r: int) {
    return a / b, a % b
}

proc achar(n: i32) -> i32 ! Erro {
    if n == 0 {
        return Erro.vazio
    }
    return n
}

proc mover(c: ^fis.Corpo, dt: f32) -> f32 {
    let acel = fis.aceleracao(c, forca = fis.GRAVIDADE)
    var x = acel * dt
    x += fis.DT
    return x
}

proc descrever(f: fis.Forma) -> i32 {
    switch k in f {
    case fis.Corpo:
        return k.vida
    case i32:
        return k
    }
    return 0
}

proc main() {
    var mundo = Mundo{}
    let r = somar(1)
    for i in 0..<3 {
        let s = somar(i as i32, b = r)
        mundo.quadros += s
    }
    let q, resto = dividir(17, b = 5)
    let arena = mem.arena_create()
    mem.arena_destroy(arena)
    switch fis.cor_de(mundo.corpos[0]) {
    case fis.Cor.azul:
        print(1)
    default:
        print(2)
    }
    let deslocamento = mover(&mundo.corpos[0], dt = 0.5)
    print(f"{deslocamento}")
    print(achar(3) or_else 0)
    print(q + resto + fis.proximo(r) as int)
}

test "somar usa o padrao" {
    expect(somar(1) == 3)
}

test "dividir" {
    let q, r = dividir(7, b = 2)
    expect(q == 3)
    expect(r == 1)
}
