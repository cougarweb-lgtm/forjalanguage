// fisica.fj - modulo da fixture de 'forja consultar' (tests\consultar): constantes, enums, struct, union e procs publicos.
pub const GRAVIDADE: f32 = 9.5
pub const DT: f32 = 0.25

pub enum Cor { vermelho, azul }

pub enum Nivel { baixo = -1, medio, alto }

pub struct Corpo {
    massa: f32 = 1.0
    cor: Cor = Cor.vermelho
    vida: i32 = 3
}

pub union Forma {
    Corpo,
    i32
}

pub proc aceleracao(c: ^Corpo, forca: f32 = 1.0) -> f32 {
    let razao = forca * c.massa
    return razao
}

pub proc cor_de(c: Corpo) -> Cor {
    return c.cor
}

pub proc nivel_de(c: Corpo) -> Nivel {
    if c.vida > 2 {
        return Nivel.alto
    }
    return Nivel.baixo
}

proc interno(n: i32) -> i32 {
    return n + 1
}

pub proc proximo(n: i32) -> i32 {
    return interno(n)
}
