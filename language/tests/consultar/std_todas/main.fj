// main.fj - importa e usa cada modulo da std (std\*.fj) para que 'forja consultar simbolos' liste todos (M-U4); modulo novo na std = uma linha de import e um uso aqui.
import "std:file" as arq
import "std:fmt"
import "std:math"
import "std:mem"
import "std:os"
import "std:path"
import "std:rand"
import "std:text"
import "std:time"

proc main() {
    print(time.ms_to_ns(1))
    var partes = text.split("a,b", ",", alloc = heap)
    print(len(partes))
    delete(partes)
    print(math.sign(2.0) as int)
    print(path.sep())
    let _rng = rand.seed(1)
    let inteiro = fmt.integer(5, loc = fmt.PT_BR, alloc = heap)
    print(inteiro)
    delete(inteiro)
    let argumentos = os.args()
    print(len(argumentos))
    let arena = mem.arena_create()
    mem.arena_destroy(arena)
    let erro = arq.FileError.other
    switch erro {
    default:
        print(1)
    }
}
