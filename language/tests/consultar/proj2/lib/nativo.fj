// nativo.fj - foreign da fixture: uma funcao do Windows e o proc que a embrulha.
pub foreign {
    link "kernel32"
    // Milissegundos desde o boot (32 bits).
    proc GetTickCount() -> u32
}

// Tempo em milissegundos.
// Segunda linha do comentario.
pub proc tempo_ms() -> u32 {
    return GetTickCount()
}
