// util.fj - modulo da fixture: const, procs, tipos, test e um proc privado.
pub const LIMITE: i32 = 10

// Dobra o valor.
pub proc dobro(n: i32) -> i32 {
    return n * 2
}

pub struct Par {
    a: i32
    b: i32 = 7
}

pub enum Modo { rapido = 1, lento = 5 }

proc privado(n: i32) -> i32 {
    return dobro(n) + LIMITE
}

test "dobro de 2" {
    expect(dobro(2) == 4)
    expect(privado(1) == 12)
}
