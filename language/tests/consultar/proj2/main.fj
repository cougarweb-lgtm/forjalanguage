// main.fj - segunda fixture de 'forja consultar' e 'forja mapa' (tests\consultar): comentarios acima da API, foreign com link, pub export e test em modulo importado.
import "lib/nativo" as nat
import "lib/util"

// Exportado para a DLL.
pub export proc somar_dll(a: i32, b: i32) -> i32 {
    return a + b
}

proc main() {
    let t = nat.tempo_ms()
    print(util.dobro(t as i32))
}

test "main usa dobro" {
    expect(util.dobro(2) == 4)
}
