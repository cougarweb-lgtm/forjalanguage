// l8_b.fj - IA1-L8: modulo do exemplo dois_modulos. Os nomes de topo repetem os do l8_a e os da raiz, com outro conteudo (comparar decrescente, outro Config e outro Modo).
foreign {
    proc c_puts = "puts"(texto: cstr) -> i32
    proc qsort(base: rawptr, n: u64, tamanho: u64, comparar: proc(a: rawptr, b: rawptr) -> i32)
}

pub const LIMITE: int = 20

pub enum Modo { forte, fraco, medio }

pub struct Config {
    peso: int = 5
}

pub proc somar(a: int, b: int) -> int {
    return a + b + LIMITE
}

proc comparar(a: rawptr, b: rawptr) -> i32 {
    let x = a as ^i32
    let y = b as ^i32
    if x^ < y^ {
        return 1
    }
    if x^ > y^ {
        return -1
    }
    return 0
}

pub proc ordenar() -> int {
    var v: [3]i32 = {3, 1, 2}
    qsort(&v[0] as rawptr, n = 3, tamanho = 4, comparar = comparar)
    return (v[0] as int) * 100 + (v[1] as int) * 10 + (v[2] as int)
}

pub proc dizer() {
    _ = c_puts("puts de l8_b")
}

pub proc modo_padrao() -> Modo {
    return Modo.medio
}

pub proc close(c: Config) -> int {
    return c.peso * LIMITE
}
