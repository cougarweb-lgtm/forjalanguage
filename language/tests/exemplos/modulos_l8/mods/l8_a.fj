// l8_a.fj - IA1-L8: modulo do exemplo dois_modulos. Os nomes de topo (LIMITE, Config, Modo, somar, comparar, ordenar, dizer, close) sao os mesmos do l8_b e da raiz.
foreign {
    proc c_puts = "puts"(texto: cstr) -> i32
    proc qsort(base: rawptr, n: u64, tamanho: u64, comparar: proc(a: rawptr, b: rawptr) -> i32)
}

pub const LIMITE: int = 10

pub enum Modo { rapido, lento }

pub struct Config {
    nivel: int = 1
}

pub proc somar(a: int, b: int) -> int {
    return a + b
}

proc comparar(a: rawptr, b: rawptr) -> i32 {
    let x = a as ^i32
    let y = b as ^i32
    if x^ < y^ {
        return -1
    }
    if x^ > y^ {
        return 1
    }
    return 0
}

pub proc ordenar() -> int {
    var v: [3]i32 = {3, 1, 2}
    qsort(&v[0] as rawptr, n = 3, tamanho = 4, comparar = comparar)
    return (v[0] as int) * 100 + (v[1] as int) * 10 + (v[2] as int)
}

pub proc dizer() {
    _ = c_puts("puts de l8_a")
}

pub proc modo_padrao() -> Modo {
    return Modo.lento
}

pub proc close(c: Config) -> int {
    return c.nivel + LIMITE
}
