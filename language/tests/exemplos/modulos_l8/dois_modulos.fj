// dois_modulos.fj - IA1-L8: a raiz e dois modulos (mods/l8_a e mods/l8_b) declaram os mesmos nomes de topo (LIMITE, Config, Modo, somar, comparar, ordenar, dizer, close),
// cada um com um callback de qsort e um foreign `puts` apelidado de c_puts. Cada nome vale no seu modulo; o C e o x64 imprimem o mesmo (dois_modulos.esperado.txt).
import "mods/l8_a"
import "mods/l8_b"

foreign {
    proc c_puts = "puts"(texto: cstr) -> i32
    proc qsort(base: rawptr, n: u64, tamanho: u64, comparar: proc(a: rawptr, b: rawptr) -> i32)
}

const LIMITE: int = 99

enum Modo { unico }

struct Config {
    raiz: int = 7
}

proc somar(a: int, b: int) -> int {
    return a * b
}

proc comparar(a: rawptr, b: rawptr) -> i32 {
    let x = a as ^i32
    let y = b as ^i32
    return x^ - y^
}

proc ordenar() -> int {
    var v: [3]i32 = {3, 1, 2}
    qsort(&v[0] as rawptr, n = 3, tamanho = 4, comparar = comparar)
    return (v[0] as int) * 100 + (v[1] as int) * 10 + (v[2] as int)
}

proc dizer() {
    _ = c_puts("puts da raiz")
}

proc close(c: Config) -> int {
    return c.raiz + LIMITE
}

proc main() {
    print(l8_a.somar(1, 2))
    print(l8_b.somar(1, 2))
    print(somar(2, 3))
    print(l8_a.LIMITE + l8_b.LIMITE + LIMITE)
    print(l8_a.ordenar())
    print(l8_b.ordenar())
    print(ordenar())
    l8_a.dizer()
    l8_b.dizer()
    dizer()
    print(l8_a.close(l8_a.Config{nivel = 4}))
    print(l8_b.close(l8_b.Config{}))
    print(close(Config{}))
    if l8_a.modo_padrao() == l8_a.Modo.lento and l8_b.modo_padrao() == l8_b.Modo.medio {
        print(Modo.unico == Modo.unico)
    }
}
