// Caso 16 do verificar_ligar.py: funcao static inline, global (get/set), array global e macro-funcao com .sig, pela cola C gerada.
// A saida tem que ser identica a de mods\inline_cola_prova.c (o mesmo roteiro escrito em C puro).
import "inline_cola" as c

proc main() {
    print(c.ic_soma(40, b = 2))
    let t = c.ic_troca(c.IcPar{ a = 1, b = 2 })
    print(t.a)
    print(t.b)
    print(c.ic_contador_get())
    c.ic_contador_set(10)
    print(c.ic_incrementa(5))
    print(c.ic_contador_mais(1))
    print(c.ic_limite_get())
    print(c.ic_nome_get() != none)
    print(c.ic_triplo(14))
    print(c.ic_maior(3, b = 9))
}
