pub struct IcPar {
    a: i32
    b: i32
}

// layout IcPar struct~IcPar tamanho=8 alinhamento=4 a:a=0 b:b=4
static_assert(size_of(IcPar) == 8, msg = "layout de IcPar: tamanho difere da libclang")
static_assert(align_of(IcPar) == 4, msg = "layout de IcPar: alinhamento difere da libclang")
static_assert(offset_of(IcPar.a) == 0, msg = "layout de IcPar: offset de a difere da libclang")
static_assert(offset_of(IcPar.b) == 4, msg = "layout de IcPar: offset de b difere da libclang")

pub foreign {
    link "inline_cola_cola"
    link "inline_cola"
    proc ic_soma = "fjcola_ic_soma"(a: i32, b: i32) -> i32
    proc ic_troca = "fjcola_ic_troca"(p: IcPar) -> IcPar
    proc ic_contador_get = "fjcola_get_ic_contador"() -> i32
