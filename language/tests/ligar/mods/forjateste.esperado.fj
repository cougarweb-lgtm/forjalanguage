// gerado por 'forja ligar' 0.10.0 a partir de forjateste.h; nao edite a mao (gere de novo).
// gerados: 24 (procs 12, tipos 6, consts 3, acessos 3); recusados: 2

pub enum FtCor {
    vermelho = 1
    verde = 2
    azul = 4
}

pub enum FtModo {
    lento
    rapido
}

pub struct FtVec2 {
    x: i32
    y: i32
}

pub struct FtRet {
    pos: FtVec2
    tam: FtVec2
    id: i32
    marca: [4]u8
}

pub struct FtValor {
    armazenamento: [2]u32
}

// layout FtVec2 struct~ft_vec2 tamanho=8 alinhamento=4 x:x=0 y:y=4
static_assert(size_of(FtVec2) == 8, msg = "layout de FtVec2: tamanho difere da libclang")
static_assert(align_of(FtVec2) == 4, msg = "layout de FtVec2: alinhamento difere da libclang")
static_assert(offset_of(FtVec2.x) == 0, msg = "layout de FtVec2: offset de x difere da libclang")
static_assert(offset_of(FtVec2.y) == 4, msg = "layout de FtVec2: offset de y difere da libclang")

// layout FtRet struct~ft_ret tamanho=24 alinhamento=4 pos:pos=0 tam:tam=8 id:id=16 marca:marca=20
static_assert(size_of(FtRet) == 24, msg = "layout de FtRet: tamanho difere da libclang")
static_assert(align_of(FtRet) == 4, msg = "layout de FtRet: alinhamento difere da libclang")
static_assert(offset_of(FtRet.pos) == 0, msg = "layout de FtRet: offset de pos difere da libclang")
static_assert(offset_of(FtRet.tam) == 8, msg = "layout de FtRet: offset de tam difere da libclang")
static_assert(offset_of(FtRet.id) == 16, msg = "layout de FtRet: offset de id difere da libclang")
static_assert(offset_of(FtRet.marca) == 20, msg = "layout de FtRet: offset de marca difere da libclang")

// layout FtValor union~ft_valor tamanho=8 alinhamento=4
static_assert(size_of(FtValor) == 8, msg = "layout de FtValor: tamanho difere da libclang")
static_assert(align_of(FtValor) == 4, msg = "layout de FtValor: alinhamento difere da libclang")

pub const FT_VERSAO: i32 = 7
pub const FT_ESCALA: f64 = 2.5
pub const FT_NOME: cstr = "forjateste"

pub foreign {
    link "forjateste"
    opaque FtContador
    proc ft_contador_criar(inicio: i32) -> ?^FtContador
    proc ft_contador_somar(contador: ?^FtContador, n: i32)
    proc ft_contador_valor(contador: ?^FtContador) -> i32
    proc ft_contador_destruir(contador: ?^FtContador)
    proc ft_cor_valor(cor: FtCor) -> i32
    proc ft_vec2_soma(v: FtVec2) -> i32
    proc ft_ret_mover(r: FtRet, dx: i32) -> FtRet
    proc ft_ret_area(r: ?^FtRet) -> i32
    proc ft_valor_inteiro(v: FtValor) -> i32
    proc ft_visitar(n: i32, visitante: proc(item: i32, ctx: rawptr) -> i32, ctx: rawptr) -> i32
    proc ft_nome() -> ?cstr
    proc ft_contar_textos(textos: ?^cstr, n: i32) -> i32
}

pub proc ft_valor_i(u: ^FtValor) -> ^i32 {
    return (u as rawptr) as ^i32
}

pub proc ft_valor_f(u: ^FtValor) -> ^f32 {
    return (u as rawptr) as ^f32
}

pub proc ft_valor_b(u: ^FtValor) -> ^[8]u8 {
    return (u as rawptr) as ^[8]u8
}

