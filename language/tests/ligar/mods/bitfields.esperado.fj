// gerado por 'forja ligar' 0.10.0 a partir de bitfields.h; nao edite a mao (gere de novo).
// gerados: 22 (procs 4, tipos 3, consts 0, acessos 15); recusados: 0

pub struct BitsDemo {
    bits_0: u32
    bits_1: u8
    tag: i32
    _anon0: BitsDemoAnon0
    pos: BitsDemoPos
    count: i32
}

pub struct BitsDemoAnon0 {
    armazenamento: [1]u32
}

pub struct BitsDemoPos {
    px: i16
    py: i16
}

// layout BitsDemo struct~BitsDemo tamanho=24 alinhamento=4 bits_0:-=0 bits_1:-=4 tag:tag=8 _anon0:-=12 pos:pos=16 count:count=20
static_assert(size_of(BitsDemo) == 24, msg = "layout de BitsDemo: tamanho difere da libclang")
static_assert(align_of(BitsDemo) == 4, msg = "layout de BitsDemo: alinhamento difere da libclang")
static_assert(offset_of(BitsDemo.bits_0) == 0, msg = "layout de BitsDemo: offset de bits_0 difere da libclang")
static_assert(offset_of(BitsDemo.bits_1) == 4, msg = "layout de BitsDemo: offset de bits_1 difere da libclang")
static_assert(offset_of(BitsDemo.tag) == 8, msg = "layout de BitsDemo: offset de tag difere da libclang")
static_assert(offset_of(BitsDemo._anon0) == 12, msg = "layout de BitsDemo: offset de _anon0 difere da libclang")
static_assert(offset_of(BitsDemo.pos) == 16, msg = "layout de BitsDemo: offset de pos difere da libclang")
static_assert(offset_of(BitsDemo.count) == 20, msg = "layout de BitsDemo: offset de count difere da libclang")

// layout BitsDemoAnon0 - tamanho=4 alinhamento=4
static_assert(size_of(BitsDemoAnon0) == 4, msg = "layout de BitsDemoAnon0: tamanho difere da libclang")
static_assert(align_of(BitsDemoAnon0) == 4, msg = "layout de BitsDemoAnon0: alinhamento difere da libclang")

// layout BitsDemoPos - tamanho=4 alinhamento=2 px:px=0 py:py=2
static_assert(size_of(BitsDemoPos) == 4, msg = "layout de BitsDemoPos: tamanho difere da libclang")
static_assert(align_of(BitsDemoPos) == 2, msg = "layout de BitsDemoPos: alinhamento difere da libclang")
static_assert(offset_of(BitsDemoPos.px) == 0, msg = "layout de BitsDemoPos: offset de px difere da libclang")
static_assert(offset_of(BitsDemoPos.py) == 2, msg = "layout de BitsDemoPos: offset de py difere da libclang")

pub foreign {
    link "bitfields"
    proc bits_demo_tamanho() -> i32
    proc bits_demo_preencher(s: ?^BitsDemo, n: i32)
    proc bits_demo_ler(s: ?^BitsDemo, i: i32) -> i32
    proc bits_demo_byte(s: ?^BitsDemo, i: i32) -> i32
}

pub proc bits_demo_anon0_ival(u: ^BitsDemoAnon0) -> ^i32 {
    return (u as rawptr) as ^i32
}

pub proc bits_demo_anon0_fval(u: ^BitsDemoAnon0) -> ^f32 {
    return (u as rawptr) as ^f32
}

pub proc bits_demo_a_get(p: ^BitsDemo) -> u32 {
    return ((p.bits_0 >> 0) & 1) as u32
}

pub proc bits_demo_a_set(p: ^BitsDemo, v: u32) {
    p.bits_0 = (p.bits_0 & 4294967294) | ((v & 1) << 0)
}

pub proc bits_demo_b_get(p: ^BitsDemo) -> u32 {
    return ((p.bits_0 >> 1) & 7) as u32
}

pub proc bits_demo_b_set(p: ^BitsDemo, v: u32) {
    p.bits_0 = (p.bits_0 & 4294967281) | ((v & 7) << 1)
}

pub proc bits_demo_c_get(p: ^BitsDemo) -> i32 {
    let u = (p.bits_0 >> 4) & 31
    if u >= 16 {
        return ((u as i64) - 32) as i32
    }
    return u as i32
}

pub proc bits_demo_c_set(p: ^BitsDemo, v: i32) {
    p.bits_0 = (p.bits_0 & 4294966799) | ((transmute(v, to = u32) & 31) << 4)
}

pub proc bits_demo_d_get(p: ^BitsDemo) -> u32 {
    return ((p.bits_0 >> 9) & 4095) as u32
}

pub proc bits_demo_d_set(p: ^BitsDemo, v: u32) {
    p.bits_0 = (p.bits_0 & 4292870655) | ((v & 4095) << 9)
}

pub proc bits_demo_e_get(p: ^BitsDemo) -> u8 {
    return ((p.bits_1 >> 0) & 3) as u8
}

pub proc bits_demo_e_set(p: ^BitsDemo, v: u8) {
    p.bits_1 = (p.bits_1 & 252) | ((v & 3) << 0)
}

pub proc bits_demo_f_get(p: ^BitsDemo) -> u8 {
    return ((p.bits_1 >> 2) & 31) as u8
}

pub proc bits_demo_f_set(p: ^BitsDemo, v: u8) {
    p.bits_1 = (p.bits_1 & 131) | ((v & 31) << 2)
}

pub proc bits_demo_itens_ptr(p: ^BitsDemo) -> ^i32 {
    let b = slice_from((p as rawptr) as ^u8, len = 25)
    return ((&b[24]) as rawptr) as ^i32
}
