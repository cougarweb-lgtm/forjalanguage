import "forjateste" as ft

struct Acumulador {
    soma: i32 = 0
}

proc somar_visita(item: i32, ctx: rawptr) -> i32 {
    let a = ctx as ^Acumulador
    a^.soma += item
    return item * 2
}

proc main() {
    let c = ft.ft_contador_criar(5)
    ft.ft_contador_somar(c, n = 10)
    print(ft.ft_contador_valor(c))
    ft.ft_contador_destruir(c)
    print(ft.ft_cor_valor(ft.FtCor.azul))
    print(ft.FT_VERSAO)
    print(ft.ft_vec2_soma(ft.FtVec2{x = 3, y = 4}))
    var r = ft.FtRet{pos = ft.FtVec2{x = 1, y = 2}, tam = ft.FtVec2{x = 3, y = 4}, id = 7}
    let m = ft.ft_ret_mover(r, dx = 10)
    print(m.pos.x)
    print(m.marca[3])
    print(ft.ft_ret_area(&r))
    var v = ft.FtValor{}
    let pi = ft.ft_valor_i(&v)
    pi^ = 42
    print(ft.ft_valor_inteiro(v))
    var acc = Acumulador{}
    print(ft.ft_visitar(4, visitante = somar_visita, ctx = &acc as rawptr))
    print(acc.soma)
    var textos: [3]cstr = {"a", "", "bc"}
    print(ft.ft_contar_textos(&textos[0], n = 3))
    print(ft.ft_nome() or_else "nada")
}
