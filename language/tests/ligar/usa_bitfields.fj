// Caso 15 do verificar_ligar.py: bitfield (get/set), union anonima, struct anonima e array flexivel pela ponte gerada de mods\bitfields.h.
// A saida tem que ser identica a de mods\bitfields_prova.c (o mesmo roteiro escrito em C puro).
import "bitfields" as b

proc mostrar_campos(p: ^b.BitsDemo) {
    print(b.bits_demo_a_get(p))
    print(b.bits_demo_b_get(p))
    print(b.bits_demo_c_get(p))
    print(b.bits_demo_d_get(p))
    print(b.bits_demo_e_get(p))
    print(b.bits_demo_f_get(p))
    print(p.tag)
    let ival = b.bits_demo_anon0_ival(&p._anon0)
    print(ival^)
    print(p.pos.px)
    print(p.pos.py)
    print(p.count)
    let itens = slice_from(b.bits_demo_itens_ptr(p), len = 3)
    for i in 0..<3 {
        print(itens[i])
    }
}

proc gravar_pelo_forja(p: ^b.BitsDemo) {
    b.bits_demo_a_set(p, v = 1)
    b.bits_demo_b_set(p, v = 5)
    b.bits_demo_c_set(p, v = -3)
    b.bits_demo_d_set(p, v = 3000)
    b.bits_demo_e_set(p, v = 2)
    b.bits_demo_f_set(p, v = 21)
    p.tag = 7
    let ival = b.bits_demo_anon0_ival(&p._anon0)
    ival^ = -9
    p.pos.px = 100
    p.pos.py = -200
    p.count = 3
    let itens = b.bits_demo_itens_ptr(p)
    let mut = slice_from(itens, len = 3)
    mut[0] = 10
    mut[1] = 20
    mut[2] = 30
}

proc main() {
    var raw: [64]u8 = {}
    let p = ((&raw) as rawptr) as ^b.BitsDemo
    b.bits_demo_preencher(p, n = 3)
    mostrar_campos(p)
    for i in 0..<64 {
        raw[i] = 0
    }
    gravar_pelo_forja(p)
    mostrar_campos(p)
    for i in 0..<36 {
        print(b.bits_demo_byte(p, i = i as i32))
    }
    for i in 0..<6 {
        print(b.bits_demo_ler(p, i = i as i32))
    }
    print(b.bits_demo_tamanho())
}
