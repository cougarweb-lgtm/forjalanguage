import "lib110" as l

proc main() {
    print(l.c_get(4))
    print(l.c_insert(2, b = 3))
    print(l.c_has(7))
    print(l.L110_BASE)
    print(l.L110_DOBRO)
    print(l.L110_MASCARA)
    print(l.L110_TAM)
    print(l.L110_TUDO)
    print(l.L110_META as int)
    var v = l.L110Valor{}
    let p = l.l110_valor__campo_inteiro(&v)
    p^ = 5
    print(l.l110_valor_inteiro(v))
    print(l.l110_log_texto("ola"))
}
