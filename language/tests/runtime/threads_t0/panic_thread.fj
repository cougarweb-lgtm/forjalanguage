// panic_thread.fj - P45 (T0-3): panic dentro de threads criadas por foreign CreateThread (nao e a principal). Duas threads panicam ao mesmo tempo;
// o main espera. Esperado: EXATAMENTE 1 relatorio R0003 no stderr e exit 101. os.multithread_on() liga o flag ANTES do CreateThread (ressalva do P44).
// Verificacao: python -I verificar_threads_t0.py <forja.exe> --panic
import "std:os"

foreign {
    link "kernel32"
    proc CreateThread(atributos: u64, pilha: u64, rotina: proc(p: rawptr) -> u32, parametro: rawptr, flags: u32, id: u64) -> u64
    proc WaitForSingleObject(alvo: u64, ms: u32) -> u32
}

proc rotina(p: rawptr) -> u32 {
    let v = new(int, alloc = heap)
    defer delete(v)
    v^ = 7
    panic("panic fora do main")
    return 0
}

proc main() {
    let c = new(int, alloc = heap)
    defer delete(c)
    os.multithread_on()
    let a = CreateThread(0, pilha = 0, rotina = rotina, parametro = c as rawptr, flags = 0, id = 0)
    let b = CreateThread(0, pilha = 0, rotina = rotina, parametro = c as rawptr, flags = 0, id = 0)
    _ = WaitForSingleObject(a, ms = 4294967295)
    _ = WaitForSingleObject(b, ms = 4294967295)
    print("main: nao devia chegar aqui")
}
