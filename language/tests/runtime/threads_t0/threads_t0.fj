// threads_t0.fj - P44 (T0-2): 8 threads criadas por foreign CreateThread (callback proc com fjt_ na fronteira), cada uma com 10 mil voltas de
// new/delete no heap + new no frame + format + print de uma linha f"..." inteira. Saida esperada: 80 mil linhas "L tNN iNNNNN vNNNNN qNNNNN sNN" (nenhuma intercalada),
// uma por (thread, volta), e R0009 = 0 (nada vazado; esta fixture roda em dev). Verificacao: python -I verificar_threads_t0.py <forja.exe>
import "std:os"

foreign {
    link "kernel32"
    proc CreateThread(atributos: u64, pilha: u64, rotina: proc(p: rawptr) -> u32, parametro: rawptr, flags: u32, id: u64) -> u64
    proc WaitForSingleObject(alvo: u64, ms: u32) -> u32
    proc CloseHandle(alvo: u64) -> i32
}

const FIOS: int = 8
const VOLTAS: int = 10000

struct Carga {
    id: int
}

proc rotina(p: rawptr) -> u32 {
    let c = p as ^Carga
    for i in 0..<VOLTAS {
        let v = new(int, alloc = heap)
        v^ = i
        let q = new(int, alloc = frame)
        q^ = i
        let s = format(f"x{c.id:02}-{i:05}-{v^:05}", alloc = heap)
        print(f"L t{c.id:02} i{i:05} v{v^:05} q{q^:05} s{len(s):02}")
        delete(s)
        delete(v)
        frame_reset()
    }
    return 0
}

proc main() {
    var cargas = make([dynamic]^Carga, alloc = heap)
    var fios = make([dynamic]u64, alloc = heap)
    os.multithread_on()
    for k in 0..<FIOS {
        let c = new(Carga, alloc = heap)
        c.id = k
        let h = CreateThread(0, pilha = 0, rotina = rotina, parametro = c as rawptr, flags = 0, id = 0)
        append(&cargas, item = c)
        append(&fios, item = h)
    }
    for k in 0..<FIOS {
        _ = WaitForSingleObject(fios[k], ms = 4294967295)
        _ = CloseHandle(fios[k])
        delete(cargas[k])
    }
    delete(cargas)
    delete(fios)
}
