// dll_threads.fj - P45 (T0-3): DLL Forja chamada por varias threads de fora (ctypes). Cada chamada de trabalho(n) faz n voltas de new/delete no heap + new no frame +
// format; devolve a soma dos tamanhos dos textos (valor absoluto conferido por verificar_threads_t0.py --dll). A thread que morre devolve o fio dela no DLL_THREAD_DETACH.
// Build: forja build --modo dll --release dll_threads.fj -o dll_threads.dll
pub export proc trabalho(n: int) -> int {
    var soma: int = 0
    for i in 0..<n {
        let v = new(int, alloc = heap)
        v^ = i
        let q = new(int, alloc = frame)
        q^ = i
        let s = format(f"x{v^:05}-{q^:05}", alloc = heap)
        soma += len(s)
        delete(s)
        delete(v)
        frame_reset()
    }
    return soma
}

proc main() {
    print(trabalho(3))
}
