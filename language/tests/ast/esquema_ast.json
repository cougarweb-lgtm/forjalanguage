{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "forja-ast-1.0.0",
  "title": "AST 1.0.0 da Forja (forja ast)",
  "description": "Versao 1.0.0. Tres documentos: arquivo unico (declaracoes), projeto (--projeto ou pasta: um item por modulo, na ordem dos imports) e subarvore (--no <id>). Todo objeto com 'id' e um no: leva 'pos' e 'fim' ([linha, coluna], fim exclusivo; 'pos' = onde o texto do no comeca) e, se for uso de nome resolvido, 'ref' (id da declaracao), 'ref_modulo' e 'ref_tipo'. Nomes da linguagem (print, i32, heap...) levam so 'ref_tipo': 'embutido'. Em --sem-pos 'arquivo', 'pos', 'fim', 'op_pos' e 'pos_nome' somem e o esquema de posicoes nao se aplica (compare com o documento completo). Usa so palavras-chave do JSON Schema que tests/ast/verificar_ast.py entende (type, required, properties, additionalProperties, items, enum, const, pattern, minimum, minItems, maxItems, allOf, if/then/else, $ref).",
  "oneOf": [
    {"$ref": "#/$defs/arquivo"},
    {"$ref": "#/$defs/projeto"},
    {"$ref": "#/$defs/subarvore"}
  ],
  "$defs": {
    "posicao": {
      "type": "array",
      "items": {"type": "integer", "minimum": 1},
      "minItems": 2,
      "maxItems": 2
    },
    "id": {
      "type": "string",
      "pattern": "^[^:\\[\\]]+:.+$"
    },
    "ref_tipo": {
      "enum": ["local", "param", "const", "enum", "membro", "campo", "proc", "struct", "union", "unit", "embutido"]
    },
    "no": {
      "type": "object",
      "required": ["id", "pos", "fim"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "pos": {"$ref": "#/$defs/posicao"},
        "fim": {"$ref": "#/$defs/posicao"},
        "pos_nome": {"$ref": "#/$defs/posicao"},
        "op_pos": {"$ref": "#/$defs/posicao"},
        "ref": {"$ref": "#/$defs/id"},
        "ref_modulo": {"type": "string", "pattern": "^.+$"},
        "ref_tipo": {"$ref": "#/$defs/ref_tipo"},
        "ref_import": {"$ref": "#/$defs/id"}
      },
      "additionalProperties": {"$ref": "#/$defs/qualquer"}
    },
    "qualquer": {
      "if": {"type": "object", "required": ["id"]},
      "then": {"$ref": "#/$defs/no"},
      "else": {
        "if": {"type": "object"},
        "then": {"additionalProperties": {"$ref": "#/$defs/qualquer"}},
        "else": {
          "if": {"type": "array"},
          "then": {"items": {"$ref": "#/$defs/qualquer"}}
        }
      }
    },
    "declaracao": {
      "allOf": [
        {"$ref": "#/$defs/no"},
        {
          "required": ["no"],
          "properties": {
            "no": {"enum": ["unit", "unit_derivada", "const", "struct", "enum", "proc", "test", "link", "union", "import", "static_assert"]}
          }
        }
      ]
    },
    "arquivo": {
      "type": "object",
      "required": ["arquivo", "ast_versao", "modulo", "declaracoes"],
      "properties": {
        "arquivo": {"type": "string"},
        "ast_versao": {"const": "1.0.0"},
        "modulo": {"type": "string", "pattern": "^.+$"},
        "declaracoes": {"type": "array", "items": {"$ref": "#/$defs/declaracao"}}
      },
      "additionalProperties": false
    },
    "projeto": {
      "type": "object",
      "required": ["arquivo", "ast_versao", "projeto", "modulos"],
      "properties": {
        "arquivo": {"type": "string"},
        "ast_versao": {"const": "1.0.0"},
        "projeto": {"const": true},
        "modulos": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["modulo", "arquivo", "declaracoes"],
            "properties": {
              "modulo": {"type": "string", "pattern": "^.+$"},
              "arquivo": {"type": "string"},
              "declaracoes": {"type": "array", "items": {"$ref": "#/$defs/declaracao"}}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "subarvore": {
      "type": "object",
      "required": ["ast_versao", "no_id", "subarvore"],
      "properties": {
        "ast_versao": {"const": "1.0.0"},
        "no_id": {"$ref": "#/$defs/id"},
        "subarvore": {"$ref": "#/$defs/no"}
      },
      "additionalProperties": false
    }
  }
}
