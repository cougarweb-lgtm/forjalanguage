import "std:os"
    // Corte BIR0 (D0778, plano_bir0): corpo de nativo_construir_exe para o espelho (--corte). IR -> BIR validada -> dump no stdout, rc 0.
    var sd: common.SaidaDiag = common.SaidaDiag{}
    let nome: str = pedido.alvo or_else NATIVO_ALVO_PADRAO
    let sysv: bool = nome == "x86_64-linux"
    if (not sysv) and (nome != "x86_64-windows") {
        common.diag_imprimir_json_sem_fonte(common.X0003, "alvo desconhecido no backend nativo", common.c2f_saida_stderr(), &sd)
        return SAIDA_USO
    }
    if pedido.dll and sysv {
        common.diag_imprimir_json_sem_fonte(common.X0003, NATIVO_X0003_SO, common.c2f_saida_stderr(), &sd)
        return SAIDA_USO
    }
    var nomes_alvo: bir.BirNomesMem = bir.BirNomesMem{copia = "memcpy", zera = "memset"}
    if sysv {
        nomes_alvo = bir.BirNomesMem{copia = "forja_memcpy", zera = "forja_memset"}
    }
    var entrada: bir.BirEntrada = bir.BirEntrada{ir = pedido.ir, tipos = pedido.tipos, nomes = pedido.nomes, fonte = pedido.fonte, modo = pedido.modo, teste = pedido.teste, traco = pedido.traco, dll = pedido.dll, poda = true, sysv = sysv, guarda = pedido.guarda_memoria, checagem = pedido.checagem, simbolos_dbg = pedido.simbolos, perfil = pedido.perfil, nomes_mem = nomes_alvo}
    var programa: bir.BirPrograma = bir.BirPrograma{}
    var erro: common.Diag = common.Diag{tem = false}
    var dump = make([dynamic]u8, alloc = heap)
    defer delete(dump)
    let saida = common.c2f_saida_stdout()
    var codigo: i32 = 0
    if not bir.bir_construir(&entrada, &programa, &erro) {
        common.diag_imprimir_json(&erro, (pedido.fonte as ^common.Fonte), saida, &sd)
        codigo = 3
        if erro.codigo == common.X0001 {
            codigo = 1
        }
    } else if not bir.bir_validar(&programa, &erro) {
        common.diag_imprimir_json(&erro, (pedido.fonte as ^common.Fonte), saida, &sd)
        codigo = 3
    } else {
        bir.bir_imprimir(&programa, &dump)
        common.c2f_saida_escrever(saida, dump[..])
    }
    bir.bir_liberar(&programa)
    os.exit(codigo as int)
    return codigo
