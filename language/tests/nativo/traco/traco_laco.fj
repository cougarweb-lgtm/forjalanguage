// modos: dev
// traco_laco.fj - P18a: laco com for e if/else: o mesmo IrInstr aparece uma vez por volta no traco; stderr com --traco identico nos dois backends.

proc main() {
    var total: int = 0
    for i in 0..<5 {
        let dobro: int = i * 2
        if dobro > 4 {
            total = total + dobro
        } else {
            total = total - 1
        }
    }
    var k: i32 = 3
    while k > 0 {
        k = k - 1
    }
    print(total)
    print(k)
}
