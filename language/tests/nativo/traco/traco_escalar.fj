// modos: dev
// traco_escalar.fj - P18a: locais e temporarios escalares de varias larguras (i8 u8 i16 u16 i32 u32 int uint bool); o stderr com --traco tem de ser identico nos dois backends.

proc soma(a: i32, b: i32) -> i32 {
    let c: i32 = a + b
    return c * 2
}

proc larguras() {
    let a: i8 = -5
    let b: u8 = 200
    let c: i16 = -30000
    let d: u16 = 60000
    let e: u32 = 4000000000
    let f: int = -9000000000
    let g: uint = 18000000000000000000
    let h: bool = a < 0
    print(a)
    print(b)
    print(c)
    print(d)
    print(e)
    print(f)
    print(g)
    print(h)
}

proc main() {
    var x: i32 = 7
    x = soma(x, b = 5)
    let y: int = (x as int) * 1000
    larguras()
    print(x)
    print(y)
}
