// modos: dev
// traco_real.fj - P18a: f32 e f64 no traco (os bits do real, 8 hex para f32 e 16 para f64 estendidos a 64); stderr com --traco identico nos dois backends.

proc media(a: f64, b: f64) -> f64 {
    let s: f64 = a + b
    return s / 2.0
}

proc main() {
    let x: f32 = 1.5
    var y: f32 = x * 2.0
    y = y + 0.25
    let p: f64 = media(3.0, b = 4.5)
    let q: f64 = (y as f64) * p
    print(y as int)
    print(p > 3.0)
    print(q as int)
}
