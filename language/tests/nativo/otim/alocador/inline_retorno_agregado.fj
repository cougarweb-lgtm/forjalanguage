// inline_retorno_agregado: a folha devolve struct; o chamador usa os campos e guarda o retorno em var.
// Saida esperada: -3 7 / -1 6 / 1 5 / 3 4 / 3 5 / 2 7 / 29 / 2
struct Par {
    menor: int = 0
    maior: int = 0
}

proc ordena(a: int, b: int) -> Par {
    if a <= b {
        return Par{menor = a, maior = b}
    }
    return Par{menor = b, maior = a}
}

proc main() {
    var total = 0
    var ultimo = Par{menor = 0, maior = 0}
    for i in 0..<6 {
        ultimo = ordena(7 - i, i * 2 - 3)
        total = total + ultimo.maior - ultimo.menor
        print(ultimo.menor)
        print(ultimo.maior)
    }
    print(total)
    let p = ordena(1, 2)
    print(p.maior)
}
