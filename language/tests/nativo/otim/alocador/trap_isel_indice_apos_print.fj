// M7a F5 stress do isel: R0006 (indice fora do limite) exato depois de print, com o acesso a[i*2+1] montado em [base+indice*8+desloc]; imprime 0..3 e para com exit 101 na volta 4.
proc main() {
    var a: [8]int = {}
    var acc = 0
    for i in 0..<20 {
        print(i)
        a[i * 2 + 1] = i + acc
        acc = acc + a[i * 2 + 1]
    }
    print(acc)
}
