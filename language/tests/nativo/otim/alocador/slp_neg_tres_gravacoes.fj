// S3 (slp, negativa): so 3 gravacoes contiguas (indices 0..2) e uma quarta longe (indice 6): grupo cheio nao existe (3 lanes de 4 gravariam 4 bytes alem); saida igual a --sem-otim slp.
proc bits(v: f32) -> int {
    return transmute(v, to = u32) as int
}

proc main() {
    for i in 0..<4 {
        let f = i as f32
        let a: [8]f32 = {f, f + 1.0, f + 2.0, f + 3.0, f + 4.0, f + 5.0, f + 6.0, f + 7.0}
        var r: [8]f32 = {}
        r[0] = a[0] + 0.5
        r[1] = a[1] + 0.5
        r[2] = a[2] + 0.5
        r[6] = a[6] + 0.5
        print(bits(r[0]) + bits(r[1]) + bits(r[2]) + bits(r[6]))
        print(bits(r[3]))
    }
}
