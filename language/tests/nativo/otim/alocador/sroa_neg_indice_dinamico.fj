// sroa_neg_indice_dinamico: vetor local [4]int indexado por variavel do laco (v[i]) -> indice dinamico; o slot e mantido (sroa recusa ... indice_dinamico).
proc main() {
    var v: [4]int = {}
    for i in 0..<4 {
        v[i] = i * i + 1
    }
    var s = 0
    for i in 0..<4 {
        s = s + v[i]
    }
    print(s)
}
