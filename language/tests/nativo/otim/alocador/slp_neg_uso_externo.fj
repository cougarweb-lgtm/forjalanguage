// S3 (slp, negativa): o produto da lane 1 e lido tambem fora da arvore (print): intermediario usado fora, recusa; saida igual a --sem-otim slp.
proc bits(v: f32) -> int {
    return transmute(v, to = u32) as int
}

proc main() {
    for i in 0..<4 {
        let f = i as f32
        let a: [4]f32 = {f, f + 1.0, f + 2.0, f + 3.0}
        let b: [4]f32 = {2.0, 3.0, 4.0, 5.0}
        var r: [4]f32 = {}
        let t = a[1] * b[1]
        r[0] = a[0] * b[0]
        r[1] = t
        r[2] = a[2] * b[2]
        r[3] = a[3] * b[3]
        print(bits(r[0]) + bits(r[1]) + bits(r[2]) + bits(r[3]))
        print(bits(t))
    }
}
