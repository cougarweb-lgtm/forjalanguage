// S3 (slp, negativa): 4 gravacoes f32 da mesma base, mas em indices 0, 2, 4, 6 (nao contiguas): nenhum grupo vira vetor; saida igual a --sem-otim slp.
proc bits(v: f32) -> int {
    return transmute(v, to = u32) as int
}

proc main() {
    for i in 0..<4 {
        let f = i as f32
        let a: [8]f32 = {f, f + 1.0, f + 2.0, f + 3.0, f + 4.0, f + 5.0, f + 6.0, f + 7.0}
        var r: [8]f32 = {}
        r[0] = a[0] * 1.5
        r[2] = a[2] * 1.5
        r[4] = a[4] * 1.5
        r[6] = a[6] * 1.5
        print(bits(r[0]) + bits(r[2]) + bits(r[4]) + bits(r[6]))
    }
}
