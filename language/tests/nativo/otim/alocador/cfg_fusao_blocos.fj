// M7b R4b stress do passe cfg: blocos em fila (o fim de um if cai no inicio do proximo) que o passe funde, com contas que dependem da ordem entre eles (a gravacao no meio e lida depois).
proc passos(a: int, b: int) -> int {
    var x = a
    if a > 0 {
        x = x + b
    }
    x = x * 2
    if b > 0 {
        x = x - a
    }
    var y = x
    if x > 100 {
        y = y - 100
    } else {
        y = y + 100
    }
    if y > 0 {
        y = y * 3
    }
    return y + x
}

proc main() {
    var acc = 0
    for i in -5..<25 {
        for j in -3..<7 {
            acc = acc + passos(i, j)
        }
    }
    print(acc)
    print(passos(1, 1))
    print(passos(-1, -1))
}
