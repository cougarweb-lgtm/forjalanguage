// M7a F3 stress do alocador: i8, i16, i32, u8, u16, u32 em registrador (extensao com zero, movzx a cada definicao), conversoes com sinal e sem sinal, comparacoes e booleanos.
proc curtos(n: int) -> int {
    var a: i8 = 100
    var b: i16 = -30000
    var c: i32 = 2000000000
    var d: u8 = 200
    var e: u16 = 65000
    var f: u32 = 4000000000
    var soma = 0
    for i in 0..<n {
        a = wrapping_add(a, b = 37)
        b = wrapping_sub(b, b = 1234)
        c = wrapping_add(c, b = 123456789)
        d = wrapping_mul(d, b = 3)
        e = wrapping_add(e, b = 777)
        f = wrapping_mul(f, b = 5)
        let sa = a as int
        let sb = b as int
        let sc = c as int
        let ud = d as int
        let ue = e as int
        let uf = f as int
        soma = (soma + sa * 3 - sb + sc % 1000 + ud + ue - uf % 977) % 1000003
        if a < 0 and b > 0 {
            soma = soma + 1
        }
        if d > 100 or e < 1000 {
            soma = soma + 2
        }
        if c < 0 {
            soma = soma + 3
        }
    }
    print(a)
    print(b)
    print(c)
    print(d)
    print(e)
    print(f)
    return soma
}

proc truncar(x: int) -> int {
    var acc = 0
    for i in 0..<64 {
        let v = (x + i * 257) as u64
        let t8 = (v & 255) as u8
        let t16 = (v & 65535) as u16
        let s8 = (v & 127) as i8
        acc = acc + (t8 as int) + (t16 as int) + (s8 as int)
    }
    return acc
}

proc main() {
    print(curtos(200))
    print(curtos(3))
    print(truncar(1000000))
    print(truncar(-5))
}
