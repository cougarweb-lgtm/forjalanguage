// sroa_aninhada_desloc: struct dentro de struct por valor (Caixa.dentro: Par); os campos internos viram escalares e o deslocamento entra no acesso c.dentro.y.
struct Par {
    x: int = 0
    y: int = 0
}

struct Caixa {
    tamanho: int = 0
    dentro: Par
    rotulo: int = 0
}

proc main() {
    var c = Caixa{tamanho = 4, rotulo = 9}
    c.dentro.x = 1
    for i in 0..<15 {
        c.dentro.y = c.dentro.y + i + c.dentro.x
        c.dentro.x = (c.dentro.x * 2) % 97
        c.tamanho = c.tamanho + 1
    }
    print(c.tamanho)
    print(c.dentro.x)
    print(c.dentro.y)
    print(c.rotulo)
}
