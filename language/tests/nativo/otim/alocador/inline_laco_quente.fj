// inline_laco_quente: folha `passo_longo` (24 comandos: 23 lets + return) chamada dentro do laco; folha `passo_curto`
// (16 comandos: 15 lets + return) chamada fora do laco. Saida esperada: -4841837926063621340 e -886016167734056863.
proc passo_longo(a: int, b: int) -> int {
    let t1 = wrapping_add(a, b)
    let t2 = wrapping_mul(t1, 3)
    let t3 = wrapping_sub(t2, a)
    let t4 = wrapping_add(t3, b)
    let t5 = wrapping_mul(t4, 5)
    let t6 = wrapping_sub(t5, t1)
    let t7 = wrapping_add(t6, t2)
    let t8 = wrapping_mul(t7, 7)
    let t9 = wrapping_sub(t8, t3)
    let t10 = wrapping_add(t9, t4)
    let t11 = wrapping_mul(t10, 3)
    let t12 = wrapping_sub(t11, t5)
    let t13 = wrapping_add(t12, t6)
    let t14 = wrapping_mul(t13, 5)
    let t15 = wrapping_sub(t14, t7)
    let t16 = wrapping_add(t15, t8)
    let t17 = wrapping_mul(t16, 3)
    let t18 = wrapping_sub(t17, t9)
    let t19 = wrapping_add(t18, t10)
    let t20 = wrapping_mul(t19, 7)
    let t21 = wrapping_sub(t20, t11)
    let t22 = wrapping_add(t21, t12)
    let t23 = wrapping_mul(t22, 3)
    return wrapping_sub(t23, t13)
}

proc passo_curto(a: int) -> int {
    let u1 = wrapping_add(a, 1)
    let u2 = wrapping_mul(u1, 2)
    let u3 = wrapping_sub(u2, a)
    let u4 = wrapping_add(u3, u1)
    let u5 = wrapping_mul(u4, 3)
    let u6 = wrapping_sub(u5, u2)
    let u7 = wrapping_add(u6, u3)
    let u8 = wrapping_mul(u7, 2)
    let u9 = wrapping_sub(u8, u4)
    let u10 = wrapping_add(u9, u5)
    let u11 = wrapping_mul(u10, 3)
    let u12 = wrapping_sub(u11, u6)
    let u13 = wrapping_add(u12, u7)
    let u14 = wrapping_mul(u13, 2)
    let u15 = wrapping_sub(u14, u8)
    return wrapping_add(u15, u9)
}

proc main() {
    var acc = 0
    for i in 0..<50 {
        acc = passo_longo(acc, i)
    }
    print(acc)
    print(passo_curto(acc))
}
