// Regra 2 do alocador (0.3.0): 12 inteiros de vida longa vivos no laco todo e temporarios curtos (2 a 10 posicoes) usados muito dentro do laco.
proc densidade(n: int) -> int {
    var v1 = 1
    var v2 = 2
    var v3 = 3
    var v4 = 4
    var v5 = 5
    var v6 = 6
    var v7 = 7
    var v8 = 8
    var v9 = 9
    var v10 = 10
    var v11 = 11
    var v12 = 12
    var acc = 0
    for i in 0..<n {
        let t1 = (i * 7 + 3) % 1000003
        acc = (acc + t1 * t1) % 1000003
        let t2 = (t1 + i) % 1000003
        acc = (acc + t2 * 2) % 1000003
        let t3 = (t2 * 5 + 1) % 1000003
        acc = (acc + t3) % 1000003
        v1 = (v1 + acc) % 1000003
        v2 = (v2 + v1) % 1000003
        v3 = (v3 * 3 + v2) % 1000003
        v4 = (v4 + v3 - v1 + 1000003) % 1000003
        v5 = (v5 + v4) % 1000003
        v6 = (v6 + v5 + v2) % 1000003
        v7 = (v7 * 5 + v6) % 1000003
        v8 = (v8 + v7 - v3 + 1000003) % 1000003
        v9 = (v9 + v8) % 1000003
        v10 = (v10 + v9 + v4) % 1000003
        v11 = (v11 + v10 - v5 + 1000003) % 1000003
        v12 = (v12 + v11 + v6) % 1000003
    }
    return acc + v1 + v2 + v3 + v4 + v5 + v6 + v7 + v8 + v9 + v10 + v11 + v12
}

proc main() {
    print(densidade(300))
    print(densidade(7))
    print(densidade(0))
}
