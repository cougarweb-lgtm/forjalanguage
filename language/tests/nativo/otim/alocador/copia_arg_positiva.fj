// M7a passe `copia_arg` (positiva): acerta(caixas[i], raio) em laco; o chamado so le os dois parametros, entao as copias do argumento saem. Igual a --sem-otim copia_arg e ao backend C.
struct Caixa {
    minx: int = 0
    maxx: int = 0
    valor: int = 0
}

struct Raio {
    ox: int = 0
    dx: int = 1
}

proc acerta(c: Caixa, r: Raio) -> int {
    let t1 = (c.minx - r.ox) * 8 / r.dx
    let t2 = (c.maxx - r.ox) * 8 / r.dx
    if t1 <= t2 {
        return t1 + c.valor
    }
    return t2 - c.valor
}

proc main() {
    var caixas: [16]Caixa = {}
    var raio = Raio{ox = 3, dx = 2}
    var soma = 0
    for i in 0..<16 {
        caixas[i] = Caixa{minx = i, maxx = i + 5, valor = i * 3}
    }
    for i in 0..<16 {
        raio.ox = raio.ox + i % 3
        soma = soma + acerta(caixas[i], raio)
        print(soma)
    }
    print(raio.ox)
}
