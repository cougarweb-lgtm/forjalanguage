// R5 (negativa): real fora do padrao minss/maxss (<=, >=, ==, braço com conta) NAO vira SELECIONA (ficaria diferente com NaN e +-0): o losango continua com desvio e a saida igual a --sem-otim selecao e ao backend C.
proc menor_ou_igual(a: f64, b: f64) -> f64 {
    var m = b
    if a <= b {
        m = a
    }
    return m
}

proc maior_ou_igual(a: f64, b: f64) -> f64 {
    var m = b
    if a >= b {
        m = a
    }
    return m
}

proc igual(a: f64, b: f64, c: f64) -> f64 {
    var m = c
    if a == b {
        m = a
    }
    return m
}

proc com_conta(a: f64, b: f64) -> f64 {
    var m = b
    if a < b {
        m = a + 1.0
    }
    return m
}

proc marca(x: f64) -> f64 {
    if x != x {
        return 7.0
    }
    if x == 0.0 {
        return 1.0 / x
    }
    return x
}

proc main() {
    let z: f64 = 0.0
    let nz: f64 = -z
    let nan: f64 = z / z
    var vals: [5]f64 = {}
    vals[0] = 2.5
    vals[1] = z
    vals[2] = nz
    vals[3] = nan
    vals[4] = -1.0
    for i in 0..<5 {
        for j in 0..<5 {
            print(marca(menor_ou_igual(vals[i], vals[j])))
            print(marca(maior_ou_igual(vals[i], vals[j])))
            print(marca(igual(vals[i], vals[j], 9.0)))
            print(marca(com_conta(vals[i], vals[j])))
        }
    }
}
