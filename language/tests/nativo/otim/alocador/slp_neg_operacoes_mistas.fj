// S3 (slp, negativa): ADD numa lane, SUB noutra: arvore nao isomorfa; saida igual a --sem-otim slp.
proc bits(v: f32) -> int {
    return transmute(v, to = u32) as int
}

proc main() {
    for i in 0..<4 {
        let f = i as f32
        let a: [4]f32 = {f, f + 1.0, f + 2.0, f + 3.0}
        let b: [4]f32 = {2.5, 3.5, 4.5, 5.5}
        var r: [4]f32 = {}
        r[0] = a[0] + b[0]
        r[1] = a[1] - b[1]
        r[2] = a[2] + b[2]
        r[3] = a[3] - b[3]
        print(bits(r[0]) + bits(r[1]) + bits(r[2]) + bits(r[3]))
    }
}
