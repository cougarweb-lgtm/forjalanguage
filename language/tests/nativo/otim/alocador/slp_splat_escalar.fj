// S3 (slp): escalar vezes vetor (o escalar, calculado antes no bloco, e o mesmo em todas as lanes: splat) e escalar + vetor com constante, f32, bits exatos.
struct Vec4 {
    x: f32 = 0.0
    y: f32 = 0.0
    z: f32 = 0.0
    w: f32 = 0.0
    enchimento: [14]f32 // enchimento: o slot passa de 64 B, o sroa o recusa (tamanho) e o slp o vetoriza; ate 64 B o sroa o escalariza e o slp recusa: slot_escalarizavel
}

proc bits(v: f32) -> int {
    return transmute(v, to = u32) as int
}

proc main() {
    for i in 0..<5 {
        let f = i as f32
        let s = f * 0.75 + 1.25
        let v = Vec4{x = f + 1.0, y = f - 2.5, z = f * f, w = 4.0 - f}
        var r = Vec4{}
        var t = Vec4{}
        r.x = s * v.x
        r.y = s * v.y
        r.z = s * v.z
        r.w = s * v.w
        t.x = v.x * 2.5 + s
        t.y = v.y * 2.5 + s
        t.z = v.z * 2.5 + s
        t.w = v.w * 2.5 + s
        print(bits(r.x) + bits(r.y) + bits(r.z) + bits(r.w))
        print(bits(t.x) + bits(t.y) + bits(t.z) + bits(t.w))
        print(bits(t.z))
    }
}
