// inline_vira_folha: `calcula` so chama folhas (quadrado, cubo_mais); depois do inline ele nao tem mais chamada.
// Saida esperada: 16 / -9 / 1200
proc quadrado(x: int) -> int {
    return x * x
}

proc cubo_mais(x: int, k: int) -> int {
    return x * x * x + k
}

proc calcula(x: int) -> int {
    let a = quadrado(x)
    let b = cubo_mais(x, a)
    return a + b
}

proc main() {
    print(calcula(2))
    print(calcula(-3))
    print(calcula(10))
}
