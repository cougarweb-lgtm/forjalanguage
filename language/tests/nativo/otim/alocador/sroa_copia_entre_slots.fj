// sroa_copia_entre_slots: struct local copiada para outra struct local (var b = a); as duas viram escalares e a copia e independente da origem.
struct Par {
    a: int = 0
    b: int = 0
}

proc main() {
    var a = Par{a = 5, b = 7}
    var b = a
    for i in 0..<6 {
        b.a = b.a + i
        a.b = a.b + b.a
    }
    print(a.a)
    print(a.b)
    print(b.a)
    print(b.b)
}
