// numeracao_expr_ebb: a mesma conta pura (x * y + 3) repetida no mesmo bloco e depois de um if (a 2a ocorrencia e dominada pela 1a); y e redefinido no fim e a conta nova tem de dar outro valor.
// espera: expr>0
proc main() {
    let x = 11
    var y = 13
    var total = 0
    for k in 0..<10 {
        let p = x * y + 3
        let q = x * y + 3
        total = total + p + q + k
        if k % 2 == 0 {
            total = total + (x * y + 3)
        }
        y = y + 1
    }
    print(total)
    print(x * y + 3)
}
