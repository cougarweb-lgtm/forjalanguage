// S4b (slp, negativa): Vec4 local de 36 B (4 campos + 5 de enchimento) por valor, inlinado em laco: o slot passa do limiar de 32 B da gravacao, mas o sroa o escalariza (64 B); a carga contigua consulta o veredito real do sroa e recusa (slot_escalarizavel); saida igual a --sem-otim slp.
struct Vec4 {
    x: f32 = 0.0
    y: f32 = 0.0
    z: f32 = 0.0
    w: f32 = 0.0
    p0: f32 = 0.0
    p1: f32 = 0.0
    p2: f32 = 0.0
    p3: f32 = 0.0
    p4: f32 = 0.0
}

proc bits(v: f32) -> int {
    return transmute(v, to = u32) as int
}

proc soma(a: Vec4, b: Vec4) -> Vec4 {
    var r = Vec4{}
    r.x = a.x + b.x
    r.y = a.y + b.y
    r.z = a.z + b.z
    r.w = a.w + b.w
    return r
}

proc escala(a: Vec4, s: f32) -> Vec4 {
    var r = Vec4{}
    r.x = a.x * s
    r.y = a.y * s
    r.z = a.z * s
    r.w = a.w * s
    return r
}

proc main() {
    var acc = Vec4{x = 1.0, y = 2.0, z = 3.0, w = 4.0}
    acc.p0 = 1.0
    acc.p1 = 2.0
    acc.p2 = 3.0
    acc.p3 = 4.0
    acc.p4 = 5.0
    let passo = Vec4{x = 0.001, y = 0.002, z = 0.003, w = 0.004}
    var total: f32 = 0.0
    for i in 0..<5 {
        let t = soma(acc, passo)
        acc = escala(t, 0.999)
        total = total + acc.x * 0.5 + acc.w * 0.25
    }
    total = total + acc.p0 * 0.0 + acc.p1 * 0.0 + acc.p2 * 0.0 + acc.p3 * 0.0 + acc.p4 * 0.0
    print(bits(acc.x))
    print(bits(acc.y))
    print(bits(acc.z))
    print(bits(acc.w))
    print(bits(total))
}
