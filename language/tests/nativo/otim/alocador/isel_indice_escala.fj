// M7a F5 stress do isel: [base+indice*escala+desloc] em array de 1, 2, 4 e 8 bytes, array de struct (passo 24), soa com colunas e indice em laco aninhado; leitura e gravacao, valor vivo depois.
struct Par {
    a: int = 0
    b: int = 0
    c: int = 0
}

struct Ponto {
    x: f32 = 0.0
    y: f32 = 0.0
    n: int = 0
}

proc preenche(bytes: ^[64]u8, curtos: ^[64]u16, meios: ^[64]i32, longos: ^[64]int) {
    for i in 0..<64 {
        bytes^[i] = (i * 3) as u8
        curtos^[i] = (i * 300) as u16
        meios^[i] = (i * 70000 - 100000) as i32
        longos^[i] = i * 1000003 - 5
    }
}

proc soma(bytes: ^[64]u8, curtos: ^[64]u16, meios: ^[64]i32, longos: ^[64]int) -> int {
    var acc = 0
    for i in 0..<64 {
        acc = acc + (bytes^[i] as int) + (curtos^[i] as int) + (meios^[i] as int) + longos^[i]
    }
    return acc
}

proc pares(v: ^[16]Par) -> int {
    var acc = 0
    for i in 0..<16 {
        v^[i].a = i
        v^[i].b = i * 2
        v^[i].c = v^[i].a + v^[i].b
    }
    for i in 0..<16 {
        acc = acc + v^[i].c * (i + 1)
    }
    return acc
}

proc pontos(p: ^soa[32]Ponto) -> int {
    for i in 0..<32 {
        p^[i].x = (i as f32) * 1.5
        p^[i].y = (i as f32) * -0.5
        p^[i].n = i * i
    }
    var s: f32 = 0.0
    var n = 0
    for i in 0..<32 {
        s = s + p^[i].x * p^[i].y
        n = n + p^[i].n
    }
    return (s * 100.0) as int + n
}

proc matriz() -> int {
    var m: [8][8]int = {}
    for i in 0..<8 {
        for j in 0..<8 {
            m[i][j] = i * 10 + j
        }
    }
    var acc = 0
    for i in 0..<8 {
        for j in 0..<8 {
            acc = acc + m[j][i] * (i + 1)
        }
    }
    return acc
}

proc main() {
    var bytes: [64]u8 = {}
    var curtos: [64]u16 = {}
    var meios: [64]i32 = {}
    var longos: [64]int = {}
    preenche(&bytes, &curtos, &meios, &longos)
    print(soma(&bytes, &curtos, &meios, &longos))
    var v: [16]Par = {}
    print(pares(&v))
    var p: soa[32]Ponto = {}
    print(pontos(&p))
    print(matriz())
}
