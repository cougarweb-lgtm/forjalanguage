// R6a-3 (negativa): o indice e redefinido entre a conta de endereco e o acesso do ramo (j muda dentro do laco); a conta do ramo nao pode usar o j novo no lugar do antigo. Saida igual a --sem-otim endereco.
proc rodar(v: ^[32]int, n: int) -> int {
    var acc = 0
    var j = 0
    while j < n {
        let antes = v^[j]
        v^[j] = antes + 1
        if antes > 10 {
            j += 2
            acc = acc + v^[j - 2]
            v^[j - 2] = acc
        } else {
            j += 1
            acc = acc + antes
        }
    }
    return acc
}

proc main() {
    var v: [32]int = {}
    for i in 0..<32 {
        v[i] = (i * 7) % 23
    }
    print(rodar(&v, 30))
    print(v[0] + v[5] + v[29])
}
