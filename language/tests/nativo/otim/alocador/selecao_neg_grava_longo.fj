// R5 (negativa): braço com gravacao em memoria e braço com mais de 4 instrucoes NAO viram SELECIONA; saida igual a --sem-otim selecao e ao backend C.
proc com_grava(v: ^int, a: int, b: int) -> int {
    var m = b
    if a < b {
        v^ = a
        m = a
    }
    return m
}

proc longo(a: int, b: int) -> int {
    var m = b
    if a < b {
        let t1 = a * 3
        let t2 = t1 + b
        let t3 = t2 - a
        let t4 = t3 * 5
        m = t4 + 1
    }
    return m
}

proc main() {
    var cel = 0
    var acc = 0
    for i in -10..<10 {
        acc = acc + com_grava(&cel, i, 3) + longo(i, 4) + cel
    }
    print(acc)
    print(cel)
}
