// sroa_neg_endereco_condicional: p aponta para a ou para b conforme o laco (o equivalente a p = cond ? &a : &b, que a Forja nao tem) -> endereco_multiplo; a e b sao mantidos.
struct Par {
    a: int = 0
    b: int = 0
}

proc main() {
    var a = Par{a = 1}
    var b = Par{b = 2}
    var p: ^Par = &a
    for i in 0..<4 {
        if i % 2 == 1 {
            p = &b
        } else {
            p = &a
        }
        p.a = p.a + i
    }
    print(a.a)
    print(b.a)
}
