// R5: losango e triangulo puros de inteiro (min, max, clamp, abs, dois valores no mesmo if, braço com conta) viram SELECIONA (cmp + cmov); stdout igual a --sem-otim selecao e ao backend C.
proc menor(a: int, b: int) -> int {
    var m = b
    if a < b {
        m = a
    }
    return m
}

proc maior32(a: i32, b: i32) -> i32 {
    var m: i32 = 0
    if a > b {
        m = a
    } else {
        m = b
    }
    return m
}

proc limitar(x: int, lo: int, hi: int) -> int {
    var r = x
    if r < lo {
        r = lo
    }
    if r > hi {
        r = hi
    }
    return r
}

proc modulo(x: int) -> int {
    var r = x
    if x < 0 {
        r = 0 - x
    }
    return r
}

proc ordena_par(a: int, b: int) -> int {
    var p = a
    var q = b
    if a > b {
        p = b
        q = a
    }
    return p * 1000 + q
}

proc escolhe_com_conta(a: int, b: int, c: int) -> int {
    var r = 0
    if a >= b {
        r = a * 3 + c
    } else {
        r = b - c
    }
    return r
}

proc sem_sinal(a: u32, b: u32) -> u32 {
    var m = a
    if b < a {
        m = b
    }
    return m
}

proc constante(x: int) -> int {
    var r = 7
    if x > 100 {
        r = 9
    }
    return r
}

proc main() {
    var acc = 0
    var acc32: i32 = 0
    var estado = 11
    for i in -30..<30 {
        estado = (estado * 1103515245 + 12345) % 2147483648
        let v = (estado / 65536) % 201 - 100
        acc = acc + menor(i, v) + limitar(v, -20, 40) + modulo(v) + ordena_par(i, v) + escolhe_com_conta(i, v, 5) + constante(v)
        acc32 = acc32 + maior32(i as i32, v as i32)
    }
    print(acc)
    print(acc32)
    print(sem_sinal(4000000000, 3))
    print(sem_sinal(3, 4000000000))
    print(menor(-9223372036854775807, 5))
    print(limitar(5, 7, 3))
}
