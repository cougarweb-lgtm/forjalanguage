// M7a F3 stress do alocador: R0005 exato (nulo) dentro de laco, depois de um print; com --checagem sim para no ponteiro none da volta 3.
struct No {
    valor: int = 0
}

proc main() {
    var nos: [4]No = {}
    var acc = 0
    var p: ?^No = none
    for i in 0..<10 {
        nos[0].valor = i
        if i < 3 {
            p = &nos[0]
        } else {
            p = none
        }
        print(i)
        let q = p as ^No
        acc = acc + q.valor * 7 + i
    }
    print(acc)
}
