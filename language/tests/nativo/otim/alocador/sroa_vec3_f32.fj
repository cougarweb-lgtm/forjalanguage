// sroa_vec3_f32: Vec3 de 3 f32 (12 B) por valor: local passada e devolvida por valor a proc num laco; os campos viram escalares f32.
struct Vec3 {
    x: f32 = 0.0
    y: f32 = 0.0
    z: f32 = 0.0
}

proc somar(a: Vec3, b: Vec3) -> Vec3 {
    return Vec3{x = a.x + b.x, y = a.y + b.y, z = a.z + b.z}
}

proc main() {
    var p = Vec3{x = 1.0, y = 2.0, z = 3.0}
    let passo = Vec3{x = 0.5, y = 0.25, z = 0.125}
    for i in 0..<10 {
        p = somar(p, passo)
        p.z = p.z * 0.5 + (i as f32)
    }
    print((p.x * 1000.0) as int)
    print((p.y * 1000.0) as int)
    print((p.z * 1000.0) as int)
}
