// M7a F4 stress do alocador: 22 f64 vivos ao mesmo tempo (mais que os 14 xmm alocaveis) em laco; recorrencias contraidas (fator < 1) para nada estourar.
proc mistura(n: int) -> f64 {
    var a: f64 = 1.0
    var b: f64 = 2.0
    var c: f64 = 3.0
    var d: f64 = 4.0
    var e: f64 = 5.0
    var f: f64 = 6.0
    var g: f64 = 7.0
    var h: f64 = 8.0
    var i2: f64 = 9.0
    var j: f64 = 10.0
    var k: f64 = 11.0
    var l: f64 = 12.0
    var m: f64 = 13.0
    var o: f64 = 14.0
    var p: f64 = 15.0
    var q: f64 = 16.0
    var r: f64 = 17.0
    var s: f64 = 18.0
    var t: f64 = 19.0
    var u: f64 = 20.0
    var v: f64 = 21.0
    var w: f64 = 22.0
    for i in 0..<n {
        let x = (i % 7) as f64
        a = a * 0.5 + b * 0.25 + x
        b = b * 0.5 + c * 0.25 + a * 0.125
        c = c * 0.5 + d * 0.25 - x
        d = d * 0.5 + e * 0.25 + c * 0.0625
        e = e * 0.5 + f * 0.25 + d
        f = f * 0.5 + g * 0.25 - e * 0.125
        g = g * 0.5 + h * 0.25 + f
        h = h * 0.5 + i2 * 0.25 + g * 0.03125
        i2 = i2 * 0.5 + j * 0.25 + h
        j = j * 0.5 + k * 0.25 - i2 * 0.125
        k = k * 0.5 + l * 0.25 + j
        l = l * 0.5 + m * 0.25 + k * 0.0625
        m = m * 0.5 + o * 0.25 + l
        o = o * 0.5 + p * 0.25 - m * 0.125
        p = p * 0.5 + q * 0.25 + o
        q = q * 0.5 + r * 0.25 + p * 0.03125
        r = r * 0.5 + s * 0.25 + q
        s = s * 0.5 + t * 0.25 - r * 0.125
        t = t * 0.5 + u * 0.25 + s
        u = u * 0.5 + v * 0.25 + t * 0.0625
        v = v * 0.5 + w * 0.25 + u
        w = w * 0.5 + a * 0.25 - v * 0.125
    }
    return a + b + c + d + e + f + g + h + i2 + j + k + l + m + o + p + q + r + s + t + u + v + w
}

proc main() {
    print((mistura(10) * 1000.0) as int)
    print((mistura(1000) * 1000.0) as int)
    print((mistura(0) * 1000.0) as int)
}
