// numeracao_neg_alias: duas fatias do MESMO array (bases diferentes que se sobrepoem): ler por uma, gravar pela outra, ler pela primeira de novo. A gravacao por base diferente pode sobrepor
// a carga lembrada, entao a 2a leitura tem de ver o valor novo (9 e nao o antigo).
// espera: carga=0
proc trocar(s: []int, t: []int, i: int) -> int {
    let antes = s[i]
    t[i] = 9
    let depois = s[i]
    return antes * 100 + depois
}

proc main() {
    var a: [6]int = {}
    for k in 0..<6 {
        a[k] = k + 1
    }
    var soma = 0
    for i in 0..<6 {
        soma = soma + trocar(a[..], a[..], i)
    }
    print(soma)
    print(a[0] + a[5])
}
