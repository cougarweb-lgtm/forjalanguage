// inline_basica: folha sem laco e sem chamada, com varios `return` em ramos; chamada dentro do laco do chamador.
// Saida esperada (uma linha por print): -1 -1 -1 0 11 20 31 40 99 39
proc classifica(n: int) -> int {
    if n < 0 {
        return -1
    }
    if n == 0 {
        return 0
    }
    if n % 2 == 0 {
        return n * 10
    }
    return n * 10 + 1
}

proc main() {
    var soma = 0
    for i in 0..<8 {
        let r = classifica(i - 3)
        print(r)
        soma += r
    }
    print(soma)
    print(classifica(0) + classifica(-9) + classifica(4))
}
