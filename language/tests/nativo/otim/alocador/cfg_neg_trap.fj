// M7b R4b negativa do passe cfg: o bloco do panic fica no meio do fluxo (nao e movido nem fundido); depois do print da volta 6 vem o R0003 com a mesma mensagem e exit 101 que com --sem-otim cfg,layout.
proc confere(i: int, acc: int) -> int {
    if i == 6 {
        panic("volta 6")
    }
    return acc + i
}

proc main() {
    var acc = 0
    var i = 0
    while i < 10 {
        print(i)
        acc = confere(i, acc)
        i = i + 1
    }
    print(acc)
}
