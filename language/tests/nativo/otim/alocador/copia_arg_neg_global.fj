// M7a passe `copia_arg` (negativa): origem GLOBAL (const de struct, em .rdata) passada por valor, e origem heap (new, base desconhecida) com o chamado gravando pelo ponteiro; nenhuma das duas e slot local, a copia fica.
struct Caixa {
    v: int = 0
    w: int = 0
}

const BASE: Caixa = Caixa{v = 4, w = 9}

proc le(a: Caixa) -> int {
    return a.v * 100 + a.w
}

proc mexe(a: Caixa, q: ^Caixa) -> int {
    q.v = a.v + 10
    q.w = a.w + 20
    return a.v * 100 + a.w
}

proc main() {
    let h = new(Caixa, alloc = heap)
    defer delete(h)
    h.v = 1
    h.w = 2
    var soma = 0
    for i in 0..<4 {
        soma = soma + le(BASE) + mexe(h^, h)
        print(h.v)
        print(h.w)
    }
    print(soma)
}
