// trap_numeracao_indice_campo: campo de elemento de array de structs lido duas vezes por volta, com o indice j = i + 2 saindo do array na volta 6 (array de 8): R0006 na 1a leitura, depois do
// print da volta. A carga lembrada da 1a leitura nao pode esconder nem adiantar o trap (o desvio de checagem de cada leitura fica onde esta).
struct Reg {
    a: int = 0
    b: int = 0
}

proc main() {
    var r: [8]Reg = {}
    for k in 0..<8 {
        r[k].a = k + 1
        r[k].b = k * 4
    }
    var soma = 0
    var i = 0
    while i < 10 {
        print(i)
        let j = i + 2
        soma = soma + r[j].a * 2
        soma = soma + r[j].a + r[j].b
        i = i + 1
    }
    print(soma)
}
