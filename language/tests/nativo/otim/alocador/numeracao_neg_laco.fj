// numeracao_neg_laco: cada volta calcula x * 2 + 1 e le a[i] UMA vez com x e i mudando por volta: nada pode valer de uma volta para a outra (o cabecalho do laco tem 2 predecessores e comeca
// uma EBB nova); a saida tem de bater com o passe desligado.
// espera: expr=0 carga=0
proc main() {
    var a: [10]int = {}
    for k in 0..<10 {
        a[k] = k * k
    }
    var x = 3
    var soma = 0
    for i in 0..<10 {
        soma = soma + (x * 2 + 1) + a[i]
        x = x + i + 1
    }
    print(soma)
    print(x)
}
