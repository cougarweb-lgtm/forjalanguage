// sroa_neg_maior_64: struct de 9 campos int (72 B) passa do teto de 64 B do passe -> o slot e mantido (sroa recusa ... tamanho).
struct Grande {
    a: int = 0
    b: int = 0
    c: int = 0
    d: int = 0
    e: int = 0
    f: int = 0
    g: int = 0
    h: int = 0
    i: int = 0
}

proc main() {
    var g = Grande{a = 1, i = 9}
    for k in 0..<5 {
        g.a = g.a + k
        g.i = g.i + g.a
    }
    print(g.a)
    print(g.i)
}
