// sroa_campo_laco_if: campo com varias definicoes em caminhos de if/else dentro de laco; o valor que chega ao print depende do ramo tomado em cada volta.
struct Estado {
    modo: int = 0
    valor: int = 0
    marca: int = 0
}

proc main() {
    var e = Estado{}
    for i in 0..<12 {
        if i % 3 == 0 {
            e.valor = e.valor + i
        } else if i % 3 == 1 {
            e.valor = e.valor * 2 % 1000
        } else {
            e.valor = e.valor - 1
        }
        if e.valor > 50 {
            e.modo = 1
        } else {
            e.modo = e.modo + 1
        }
        e.marca = e.marca + e.modo
    }
    print(e.modo)
    print(e.valor)
    print(e.marca)
}
