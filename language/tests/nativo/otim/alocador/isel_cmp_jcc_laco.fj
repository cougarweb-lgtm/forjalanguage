// M7a F5 stress do isel: cmp+jcc fundidos (inteiro com e sem sinal, 32 e 64 bits, contra zero e contra registrador), laco com break e continue, if encadeado, fallthrough invertido.
proc classifica(a: int, b: int) -> int {
    var r = 0
    if a < b {
        r = r + 1
    }
    if a <= b {
        r = r + 2
    }
    if a > b {
        r = r + 4
    }
    if a >= b {
        r = r + 8
    }
    if a == b {
        r = r + 16
    }
    if a != b {
        r = r + 32
    }
    if a < 0 {
        r = r + 64
    }
    if a == 0 {
        r = r + 128
    }
    return r
}

proc sem_sinal(a: u64, b: u64) -> int {
    var r = 0
    if a < b {
        r = r + 1
    }
    if a <= b {
        r = r + 2
    }
    if a > b {
        r = r + 4
    }
    if a >= b {
        r = r + 8
    }
    return r
}

proc sem_sinal32(a: u32, b: u32) -> int {
    var r = 0
    if a < b {
        r = r + 1
    }
    if a >= b {
        r = r + 2
    }
    if a == 0 {
        r = r + 4
    }
    return r
}

proc com_sinal32(a: i32, b: i32) -> int {
    var r = 0
    if a < b {
        r = r + 1
    }
    if a > b {
        r = r + 2
    }
    if a < 0 {
        r = r + 4
    }
    return r
}

proc laco_com_break(n: int) -> int {
    var acc = 0
    var i = 0
    while i < n {
        if i % 7 == 6 {
            i = i + 1
            continue
        }
        if acc > 5000 {
            break
        }
        acc = acc + i * 3
        i = i + 1
    }
    return acc * 1000 + i
}

proc main() {
    var total = 0
    for a in -3..<4 {
        for b in -3..<4 {
            total = total + classifica(a, b) * (a + 4) + classifica(b, a)
        }
    }
    print(total)
    print(sem_sinal(1, 2) * 100 + sem_sinal(5, 5) * 10 + sem_sinal(0xFFFFFFFFFFFFFFFF, 1))
    print(sem_sinal32(1, 2) * 100 + sem_sinal32(0, 0) * 10 + sem_sinal32(0xFFFFFFFF, 1))
    print(com_sinal32(-5, 3) * 100 + com_sinal32(3, -5) * 10 + com_sinal32(0, 0))
    print(laco_com_break(100))
    print(laco_com_break(10))
}
