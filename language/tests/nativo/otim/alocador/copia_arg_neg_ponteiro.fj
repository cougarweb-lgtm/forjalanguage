// M7a passe `copia_arg` (negativa): p^ por valor (base desconhecida) e o mesmo objeto por ponteiro; o chamado grava por q e depois le o parametro por valor.
struct Caixa {
    v: int = 0
    w: int = 0
}

proc mexe(a: Caixa, q: ^Caixa) -> int {
    q.v = a.v + 7
    q.w = a.w + 9
    return a.v * 100 + a.w
}

proc rodada(p: ^Caixa) -> int {
    return mexe(p^, p)
}

proc main() {
    var x = Caixa{v = 3, w = 4}
    var soma = 0
    for i in 0..<4 {
        soma = soma + rodada(&x)
        print(x.v)
        print(x.w)
    }
    print(soma)
}
