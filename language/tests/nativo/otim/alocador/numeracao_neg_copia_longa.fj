// numeracao_neg_copia_longa: copia de variavel de definicao unica (`base`) usada muito longe da copia (mais de 96 instrucoes depois): a janela do passe corta a propagacao e a saida tem de bater com o
// passe desligado e com o backend C.
// espera: expr=0
proc main() {
    let base = 17
    let d = base
    var a = 0
    var b = 1
    var c = 2
    for i in 0..<4 {
        a = a + i * 3 + 1
        b = b + a * 2 + i
        c = c + b % 7 + a % 5
        a = a + c % 11 + b % 13
        b = b + a % 17 + c % 19
        c = c + b % 23 + a % 29
        a = a + c % 31 + b % 37
        b = b + a % 41 + c % 43
        c = c + b % 47 + a % 53
        a = a + c % 59 + b % 61
        b = b + a % 67 + c % 71
        c = c + b % 73 + a % 79
        a = a + c % 83 + b % 89
        b = b + a % 97 + c % 101
        c = c + b % 103 + a % 107
    }
    print(a + b + c + d)
}
