// M7a F6b passe `checagem`: formas que NAO sao afim constante e ficam checadas: subtracao (i*8 - k + 8), limite do laco em variavel (n), indice em variavel que muda
// (p) e produto de dois contadores (i*k). Todas dentro da capacidade (sem trap); saida igual com e sem o passe e com o backend C.
proc main() {
    var a: [64]int = {}
    var b: [16]int = {}
    var c: [64]int = {}
    var n = 7
    n += 1
    var p = 0
    var soma = 0
    for i in 0..<4 {
        for k in 0..<8 {
            a[i * 8 - k + 8] = a[i * 8 - k + 8] + i + k
        }
    }
    for i in 0..<n {
        for k in 0..<n {
            c[i * n + k] = i + k
        }
    }
    for k in 0..<16 {
        b[p] = k
        p = (p + 5) % 16
    }
    for i in 0..<8 {
        for k in 0..<8 {
            soma = soma + c[i * k] + c[i * 8 + k]
        }
    }
    for i in 0..<64 {
        soma = soma + a[i] + c[i]
    }
    print(soma + b[3])
}
