// M7b R4b stress do passe layout: laco com continue, break e if aninhado (o corpo do laco tem de ficar contiguo e a ordem dos blocos nao pode mudar o resultado), laco dentro de laco, laco que nunca roda.
proc varre(n: int) -> int {
    var acc = 0
    var i = 0
    while i < n {
        i = i + 1
        if i % 7 == 0 {
            continue
        }
        if i > 90 {
            break
        }
        if i % 2 == 0 {
            if i % 3 == 0 {
                acc = acc + 100
            } else {
                acc = acc + i
            }
        } else {
            acc = acc - 1
        }
    }
    return acc + i
}

proc grade(n: int, m: int) -> int {
    var acc = 0
    for a in 0..<n {
        for b in 0..<m {
            if a == b {
                continue
            }
            if b > a + 3 {
                break
            }
            acc = acc + a * b
        }
    }
    return acc
}

proc main() {
    print(varre(0))
    print(varre(50))
    print(varre(200))
    print(grade(0, 5))
    print(grade(12, 12))
    print(grade(30, 4))
}
