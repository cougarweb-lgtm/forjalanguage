// numeracao_carga_campo: o mesmo campo de um elemento de array de structs lido duas vezes sem gravacao no meio (CSE de carga por base, deslocamento e tamanho).
// espera: carga>0
struct Ponto {
    x: int = 0
    y: int = 0
    z: int = 0
}

proc main() {
    var ps: [16]Ponto = {}
    for i in 0..<16 {
        ps[i].x = i
        ps[i].y = i * 2
        ps[i].z = i * 3
    }
    var soma = 0
    for i in 0..<16 {
        soma = soma + ps[i].y * ps[i].y + ps[i].x + ps[i].z
    }
    print(soma)
}
