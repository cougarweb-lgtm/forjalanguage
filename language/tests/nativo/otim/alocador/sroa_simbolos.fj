// sroa_simbolos: mesmo programa de sroa_struct_local; o runner o compila com --simbolos sim (DWARF/PDB) e so confere que a saida bate. Sem checagem de remark.
struct Par {
    a: int = 0
    b: int = 0
}

proc main() {
    var p = Par{a = 1, b = 2}
    for i in 0..<20 {
        p.a = (p.a + i * 3) % 1000
        p.b = (p.b + p.a) % 1000
    }
    print(p.a)
    print(p.b)
}
