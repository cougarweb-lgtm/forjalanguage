// inline_folha_laco_trap: trap (indice fora, R0006) DENTRO do laco da folha `soma_vetor`, chamada num laco do chamador.
// Com --checagem sim: imprime 6 e depois para com R0006 na folha (exit 101); a mensagem e o rastreio sao os mesmos de --sem-otim inline.
proc soma_vetor(v: []int, n: int) -> int {
    var s = 0
    for k in 0..<n {
        s += v[k]
    }
    return s
}

proc main() {
    var a: [4]int = {}
    for k in 0..<4 {
        a[k] = k + 1
    }
    for i in 0..<3 {
        print(soma_vetor(a[..], 3 + i * 2))
    }
}
