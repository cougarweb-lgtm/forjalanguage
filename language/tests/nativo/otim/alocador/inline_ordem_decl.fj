// inline_ordem_decl: ordem de declaracao 1 (folha, funcao que chama a folha, chamador). `mistura` e declarada ANTES de `main`: absorve `dobra` e `soma_um` e vira folha, entao
// entra em `main`. A ordem inversa esta em inline_ordem_decl2.fj. Saida esperada: 2097130 e 11 (uma linha cada). Com este arquivo `mistura` entra em `main` (b1, b2); no -decl2 nao
proc dobra(a: int) -> int {
    return wrapping_mul(a, 2)
}

proc soma_um(a: int) -> int {
    return wrapping_add(a, 1)
}

proc mistura(x: int, y: int) -> int {
    return wrapping_add(dobra(x), soma_um(y))
}

proc main() {
    var acc = 0
    for i in 0..<20 {
        acc = mistura(acc, i)
    }
    print(acc)
    print(mistura(3, 4))
}
