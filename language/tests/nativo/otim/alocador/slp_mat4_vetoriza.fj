// S4b (slp, positiva): mat4 local 4x4 f32 com indice dinamico em `m` (o sroa recusa o slot por indice_dinamico): as cargas contiguas de `m` seguem vetorizando mesmo com o veredito real do sroa. Imprime os bits dos 16 elementos.
proc bits(v: f32) -> int {
    return transmute(v, to = u32) as int
}

proc main() {
    let a: matrix[4, 4]f32 = {0.5, 0.25, 0.125, 0.0625, 0.0625, 0.5, 0.25, 0.125, 0.125, 0.0625, 0.5, 0.25, 0.25, 0.125, 0.0625, 0.5}
    var m: matrix[4, 4]f32 = {1.0, 0.5, 0.0, 0.0, 0.0, 1.0, 0.5, 0.0, 0.0, 0.0, 1.0, 0.5, 0.5, 0.0, 0.0, 1.0}
    for i in 0..<12 {
        m = m * a
        m[(i + 1) % 4, i % 4] = m[i % 4, (i + 2) % 4] + 0.125
    }
    for r in 0..<4 {
        for c in 0..<4 {
            print(bits(m[r, c]))
        }
    }
}
