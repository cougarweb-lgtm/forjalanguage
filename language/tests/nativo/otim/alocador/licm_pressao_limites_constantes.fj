// R6a-3 (D0704, pressao de GPR): limites CONSTANTES de laco aninhado (inclusive vindos de proc inlinado) nao sobem para o pre-cabecalho do laco de fora (gastavam um registrador por limite e o contador espilhava);
// `limites` nao pode aparecer no remark do licm, `escala` (conta invariante de param) continua subindo. stdout igual a --sem-otim licm e ao backend C.
proc soma_ate(k: int) -> int {
    var acc = 0
    for j in 0..<6 {
        acc = acc + j * k
    }
    return acc
}

proc limites(base: int) -> int {
    var acc = 0
    for i in 0..<5 {
        for j in (i + 1)..<5 {
            acc = acc + soma_ate(i + j) - base
        }
    }
    return acc
}

proc escala(n: int, k: int) -> int {
    var acc = 0
    for i in 0..<n {
        let c = k * 7 + 3
        acc = acc + i * c
    }
    return acc
}

proc main() {
    print(limites(2))
    print(limites(-5))
    print(escala(9, 4))
    print(escala(0, 4))
}
