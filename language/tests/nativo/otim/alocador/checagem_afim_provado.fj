// M7a F6b passe `checagem`: indice afim i*C + k com i, k em 0..<48 e capacidade 2304 (47*48+47 = 2303 < 2304) e provado, na forma de matmul (a^[i * 48 + k], b^[k * 48 + j]).
// Sem trap; saida igual com e sem o passe e com o backend C.
const LADO: int = 48

proc main() {
    var a: [2304]int = {}
    var b: [2304]int = {}
    var soma = 0
    for i in 0..<LADO {
        for k in 0..<LADO {
            a[i * LADO + k] = i + k
            b[k * LADO + i] = i * 2 - k
        }
    }
    for i in 0..<LADO {
        for k in 0..<LADO {
            soma = (soma + a[i * LADO + k] * b[k * LADO + i]) % 1000003
        }
    }
    print(soma)
    print(a[2303] + b[2303])
}
