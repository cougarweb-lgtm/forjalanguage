// R6a: laco que pode rodar 0 vezes com leitura de indice invariante que estoura (v[k], k = 99): a leitura e a conferencia NAO sobem; com 0 voltas nada trapa, com 1 volta R0006 (exit 101) depois do print.
proc le(v: []int, n: int, k: int) -> int {
    var acc = 0
    for i in 0..<n {
        acc = acc + v[k] + i
    }
    return acc
}

proc main() {
    var a: [6]int = {}
    for j in 0..<6 {
        a[j] = j * 3
    }
    print(le(a[..], 0, 99))
    print(le(a[..], 4, 2))
    print(le(a[..], 1, 99))
}
