// M7a F5 stress do isel: imul por constante (0, 1, 2^k, 3, 5, 9, 12, negativa, 0x204), shl/shr por 2^k e por registrador, / e % por 2^k SEM sinal (shr/and) e COM sinal (idiv), 32 e 64 bits, valores negativos.
proc multiplica(x: int) -> int {
    return x * 0 + x * 1 + x * 2 + x * 4 + x * 8 + x * 3 + x * 5 + x * 9 + x * 12 + x * -7 + x * 516 + x * 1024
}

proc multiplica32(x: i32) -> i32 {
    return wrapping_add(wrapping_mul(x, b = 3), b = wrapping_mul(x, b = 16))
}

proc divide_sem_sinal(x: u64) -> u64 {
    return x / 1 + x / 2 + x / 8 + x / 1024 + x % 1 + x % 2 + x % 16 + x % 1024
}

proc divide_sem_sinal32(x: u32) -> u32 {
    return wrapping_add(x / 4, b = x % 8)
}

proc divide_com_sinal(x: int) -> int {
    return x / 2 + x / 8 + x % 2 + x % 16
}

proc desloca(v: u64, n: u64) -> u64 {
    return (v << 3) + (v >> 5) + (v << n) + (v >> n)
}

proc main() {
    var acc = 0
    for i in -20..<20 {
        acc = acc + multiplica(i) + divide_com_sinal(i * 977)
    }
    print(acc)
    print(multiplica32(12345))
    print(multiplica32(-12345))
    var u: u64 = 0
    for i in 0..<200 {
        u = u + divide_sem_sinal((i as u64) * 7919 + 0xFFFFFFFFFFFFF000) + desloca((i as u64) * 31, (i as u64) % 60)
    }
    print(u)
    print(divide_sem_sinal32(0xFFFFFFFF))
    print(divide_sem_sinal32(77))
}
