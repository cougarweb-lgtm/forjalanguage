// inline_recursao_neg_laco: recursao direta COM laco no corpo: o passe recusa (`inline recusa fj_soma_rec: laco`), a saida nao muda.
// Saida esperada: 20 (10 + 6 + 3 + 1 + 0 das voltas n = 5..1).
proc soma_rec(n: int) -> int {
    var s = 0
    for k in 0..<n {
        s += k
    }
    if n <= 0 {
        return 0
    }
    return s + soma_rec(n - 1)
}

proc main() {
    print(soma_rec(5))
}
