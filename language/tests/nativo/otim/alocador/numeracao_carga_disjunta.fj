// numeracao_carga_disjunta: campo a do elemento i lido, campo b do elemento j gravado (j qualquer), campo a do elemento i lido de novo: com a mesma base de array e o mesmo passo, os campos
// sao disjuntos modulo o tamanho do elemento (16 bytes), entao a gravacao nao mata a carga e a 2a leitura reaproveita a 1a. O resultado tem de ser o mesmo com o passe desligado.
// espera: carga>0
struct Par {
    a: int = 0
    b: int = 0
}

proc main() {
    var v: [8]Par = {}
    for i in 0..<8 {
        v[i].a = i + 1
        v[i].b = i + 100
    }
    var soma = 0
    for i in 0..<8 {
        let j = 7 - i
        let antes = v[i].a
        v[j].b = antes + 1
        let depois = v[i].a
        soma = soma + antes * 3 + depois * 7
    }
    print(soma)
    print(v[3].a + v[3].b)
}
