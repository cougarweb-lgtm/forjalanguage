// M7b F1: divisao e resto por constante em i8, u8, i16 e u16, varridos por inteiro (todos os valores do tipo). Constantes com e sem sinal, potencias de 2, 0x204..0x207 (516..519, que colidem no imul), MIN e o maior valor.
proc mix(h: u64, v: u64) -> u64 {
    return wrapping_add(wrapping_mul(h, b = 1099511628211), b = v)
}

proc hash_i8(x: i8, h0: u64) -> u64 {
    var h = h0
    h = mix(mix(h, (x / 1) as u64), (x % 1) as u64)
    h = mix(mix(h, (x / 2) as u64), (x % 2) as u64)
    h = mix(mix(h, (x / 3) as u64), (x % 3) as u64)
    h = mix(mix(h, (x / 4) as u64), (x % 4) as u64)
    h = mix(mix(h, (x / 5) as u64), (x % 5) as u64)
    h = mix(mix(h, (x / 6) as u64), (x % 6) as u64)
    h = mix(mix(h, (x / 7) as u64), (x % 7) as u64)
    h = mix(mix(h, (x / 9) as u64), (x % 9) as u64)
    h = mix(mix(h, (x / 10) as u64), (x % 10) as u64)
    h = mix(mix(h, (x / 11) as u64), (x % 11) as u64)
    h = mix(mix(h, (x / 25) as u64), (x % 25) as u64)
    h = mix(mix(h, (x / 64) as u64), (x % 64) as u64)
    h = mix(mix(h, (x / 100) as u64), (x % 100) as u64)
    h = mix(mix(h, (x / 127) as u64), (x % 127) as u64)
    h = mix(mix(h, (x / -2) as u64), (x % -2) as u64)
    h = mix(mix(h, (x / -3) as u64), (x % -3) as u64)
    h = mix(mix(h, (x / -7) as u64), (x % -7) as u64)
    h = mix(mix(h, (x / -10) as u64), (x % -10) as u64)
    h = mix(mix(h, (x / -64) as u64), (x % -64) as u64)
    h = mix(mix(h, (x / -100) as u64), (x % -100) as u64)
    h = mix(mix(h, (x / -127) as u64), (x % -127) as u64)
    h = mix(mix(h, (x / -128) as u64), (x % -128) as u64)
    return h
}

proc hash_u8(x: u8, h0: u64) -> u64 {
    var h = h0
    h = mix(mix(h, (x / 1) as u64), (x % 1) as u64)
    h = mix(mix(h, (x / 2) as u64), (x % 2) as u64)
    h = mix(mix(h, (x / 3) as u64), (x % 3) as u64)
    h = mix(mix(h, (x / 4) as u64), (x % 4) as u64)
    h = mix(mix(h, (x / 5) as u64), (x % 5) as u64)
    h = mix(mix(h, (x / 6) as u64), (x % 6) as u64)
    h = mix(mix(h, (x / 7) as u64), (x % 7) as u64)
    h = mix(mix(h, (x / 9) as u64), (x % 9) as u64)
    h = mix(mix(h, (x / 10) as u64), (x % 10) as u64)
    h = mix(mix(h, (x / 11) as u64), (x % 11) as u64)
    h = mix(mix(h, (x / 16) as u64), (x % 16) as u64)
    h = mix(mix(h, (x / 25) as u64), (x % 25) as u64)
    h = mix(mix(h, (x / 64) as u64), (x % 64) as u64)
    h = mix(mix(h, (x / 100) as u64), (x % 100) as u64)
    h = mix(mix(h, (x / 127) as u64), (x % 127) as u64)
    h = mix(mix(h, (x / 128) as u64), (x % 128) as u64)
    h = mix(mix(h, (x / 129) as u64), (x % 129) as u64)
    h = mix(mix(h, (x / 200) as u64), (x % 200) as u64)
    h = mix(mix(h, (x / 255) as u64), (x % 255) as u64)
    return h
}

proc hash_i16(x: i16, h0: u64) -> u64 {
    var h = h0
    h = mix(mix(h, (x / 1) as u64), (x % 1) as u64)
    h = mix(mix(h, (x / 2) as u64), (x % 2) as u64)
    h = mix(mix(h, (x / 3) as u64), (x % 3) as u64)
    h = mix(mix(h, (x / 5) as u64), (x % 5) as u64)
    h = mix(mix(h, (x / 7) as u64), (x % 7) as u64)
    h = mix(mix(h, (x / 10) as u64), (x % 10) as u64)
    h = mix(mix(h, (x / 100) as u64), (x % 100) as u64)
    h = mix(mix(h, (x / 1000) as u64), (x % 1000) as u64)
    h = mix(mix(h, (x / 4096) as u64), (x % 4096) as u64)
    h = mix(mix(h, (x / 10000) as u64), (x % 10000) as u64)
    h = mix(mix(h, (x / 32767) as u64), (x % 32767) as u64)
    h = mix(mix(h, (x / 516) as u64), (x % 516) as u64)
    h = mix(mix(h, (x / 517) as u64), (x % 517) as u64)
    h = mix(mix(h, (x / 518) as u64), (x % 518) as u64)
    h = mix(mix(h, (x / 519) as u64), (x % 519) as u64)
    h = mix(mix(h, (x / -2) as u64), (x % -2) as u64)
    h = mix(mix(h, (x / -3) as u64), (x % -3) as u64)
    h = mix(mix(h, (x / -7) as u64), (x % -7) as u64)
    h = mix(mix(h, (x / -100) as u64), (x % -100) as u64)
    h = mix(mix(h, (x / -1000) as u64), (x % -1000) as u64)
    h = mix(mix(h, (x / -516) as u64), (x % -516) as u64)
    h = mix(mix(h, (x / -32767) as u64), (x % -32767) as u64)
    h = mix(mix(h, (x / -32768) as u64), (x % -32768) as u64)
    return h
}

proc hash_u16(x: u16, h0: u64) -> u64 {
    var h = h0
    h = mix(mix(h, (x / 1) as u64), (x % 1) as u64)
    h = mix(mix(h, (x / 2) as u64), (x % 2) as u64)
    h = mix(mix(h, (x / 3) as u64), (x % 3) as u64)
    h = mix(mix(h, (x / 5) as u64), (x % 5) as u64)
    h = mix(mix(h, (x / 7) as u64), (x % 7) as u64)
    h = mix(mix(h, (x / 10) as u64), (x % 10) as u64)
    h = mix(mix(h, (x / 100) as u64), (x % 100) as u64)
    h = mix(mix(h, (x / 256) as u64), (x % 256) as u64)
    h = mix(mix(h, (x / 1000) as u64), (x % 1000) as u64)
    h = mix(mix(h, (x / 4096) as u64), (x % 4096) as u64)
    h = mix(mix(h, (x / 10000) as u64), (x % 10000) as u64)
    h = mix(mix(h, (x / 32767) as u64), (x % 32767) as u64)
    h = mix(mix(h, (x / 32768) as u64), (x % 32768) as u64)
    h = mix(mix(h, (x / 32769) as u64), (x % 32769) as u64)
    h = mix(mix(h, (x / 65535) as u64), (x % 65535) as u64)
    h = mix(mix(h, (x / 516) as u64), (x % 516) as u64)
    h = mix(mix(h, (x / 517) as u64), (x % 517) as u64)
    h = mix(mix(h, (x / 518) as u64), (x % 518) as u64)
    h = mix(mix(h, (x / 519) as u64), (x % 519) as u64)
    return h
}

proc main() {
    var h: u64 = 14695981039346656037
    for i in -128..<128 {
        h = hash_i8(i as i8, h0 = h)
    }
    print(h)
    for i in 0..<256 {
        h = hash_u8(i as u8, h0 = h)
    }
    print(h)
    for i in -32768..<32768 {
        h = hash_i16(i as i16, h0 = h)
    }
    print(h)
    for i in 0..<65536 {
        h = hash_u16(i as u16, h0 = h)
    }
    print(h)
}
