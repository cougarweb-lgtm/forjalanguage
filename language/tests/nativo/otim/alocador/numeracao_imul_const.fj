// numeracao_imul_const: multiplicacao por constante em i32, i64 e u32 (2^k, 3, 5, 9, 7, negativos, estouro que da a volta): o isel pos-alocador troca por shl, lea ou imul r,r,imm; a saida tem de
// bater com o backend C, que da a volta na mesma largura.
proc mix(h: u64, v: u64) -> u64 {
    return wrapping_add(wrapping_mul(h, b = 1099511628211), b = v)
}

proc hash_i32(x: i32, h0: u64) -> u64 {
    var h = h0
    h = mix(h, wrapping_mul(x, b = 1) as u64)
    h = mix(h, wrapping_mul(x, b = 2) as u64)
    h = mix(h, wrapping_mul(x, b = 3) as u64)
    h = mix(h, wrapping_mul(x, b = 5) as u64)
    h = mix(h, wrapping_mul(x, b = 7) as u64)
    h = mix(h, wrapping_mul(x, b = 9) as u64)
    h = mix(h, wrapping_mul(x, b = 16) as u64)
    h = mix(h, wrapping_mul(x, b = -1) as u64)
    h = mix(h, wrapping_mul(x, b = -3) as u64)
    h = mix(h, wrapping_mul(x, b = -8) as u64)
    h = mix(h, wrapping_mul(x, b = 65537) as u64)
    h = mix(h, wrapping_mul(x, b = 2147483647) as u64)
    h = mix(h, wrapping_mul(x, b = -2147483647) as u64)
    return h
}

proc hash_i64(x: i64, h0: u64) -> u64 {
    var h = h0
    h = mix(h, wrapping_mul(x, b = 2) as u64)
    h = mix(h, wrapping_mul(x, b = 3) as u64)
    h = mix(h, wrapping_mul(x, b = 5) as u64)
    h = mix(h, wrapping_mul(x, b = 9) as u64)
    h = mix(h, wrapping_mul(x, b = 1024) as u64)
    h = mix(h, wrapping_mul(x, b = -5) as u64)
    h = mix(h, wrapping_mul(x, b = 4611686018427387904) as u64)
    h = mix(h, wrapping_mul(x, b = 3037000500) as u64)
    return h
}

proc hash_u32(x: u32, h0: u64) -> u64 {
    var h = h0
    h = mix(h, wrapping_mul(x, b = 3) as u64)
    h = mix(h, wrapping_mul(x, b = 8) as u64)
    h = mix(h, wrapping_mul(x, b = 9) as u64)
    h = mix(h, wrapping_mul(x, b = 4000000000) as u64)
    return h
}

proc main() {
    var h: u64 = 14695981039346656037
    var x: i64 = 123456789
    for k in 0..<64 {
        x = wrapping_add(wrapping_mul(x, b = 6364136223846793005), b = 1442695040888963407)
        h = hash_i32(x as i32, h)
        h = hash_i64(x, h)
        h = hash_u32(((x as u64) >> 7) as u32, h)
    }
    print(h)
    print(h % 1000003)
}
