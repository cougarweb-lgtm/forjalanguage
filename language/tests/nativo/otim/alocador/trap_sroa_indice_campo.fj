// trap_sroa_indice_campo: R0006 vindo de indice de campo (b.v[k], array dentro de struct local) depois de prints; a linha do trap e a do acesso fora (k = 4), exit 101 com --checagem sim.
// Saida esperada ate o trap: 0 1 2 3 3 13 23 33, depois R0006.
struct Buffer {
    v: [4]int
    n: int = 0
}

proc main() {
    var b = Buffer{n = 3}
    for i in 0..<4 {
        b.v[i] = i * 10
        print(i)
    }
    var k = 0
    while k < 6 {
        print(b.v[k] + b.n)
        k = k + 1
    }
    print(99)
}
