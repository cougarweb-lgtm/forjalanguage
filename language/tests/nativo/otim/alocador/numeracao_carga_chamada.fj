// numeracao_carga_chamada: carga, chamada de proc que grava na mesma memoria (via fatia), carga de novo: a chamada mata toda carga lembrada. A proc tem laco (nao e folha: nao entra em linha).
// espera: carga=0
proc zerar_primeiros(v: []int, n: int) {
    for k in 0..<n {
        v[k] = 0
    }
}

proc main() {
    var a: [8]int = {}
    for i in 0..<8 {
        a[i] = i + 5
    }
    var soma = 0
    for r in 0..<3 {
        let antes = a[2]
        zerar_primeiros(a[..], r + 1)
        let depois = a[2]
        soma = soma + antes * 10 + depois
        a[0] = 50 + r
        a[1] = 60 + r
        a[2] = 70 + r
    }
    print(soma)
    print(a[0] + a[1] + a[2])
}
