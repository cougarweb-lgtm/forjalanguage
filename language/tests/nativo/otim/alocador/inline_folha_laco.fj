// inline_folha_laco: folha `soma_ate` COM laco (sem chamada), chamada dentro do laco do chamador e fora dele.
// Saida esperada (uma linha por print): 0 1 3 6 10 15 e depois 21 e 55.
proc soma_ate(n: int) -> int {
    var s = 0
    for k in 0..<n {
        s += k + 1
    }
    return s
}

proc main() {
    var acc = 0
    for i in 0..<6 {
        let r = soma_ate(i)
        print(r)
        acc += r
    }
    print(soma_ate(6))
    print(soma_ate(10))
    print(acc)
}
