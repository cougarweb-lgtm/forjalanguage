// M7a F6b passe `checagem`: i*48 + k com i, k em 0..<48 e capacidade 2303: o maximo 47*48+47 = 2303 excede por 1, NAO pode ser provado. Estoura em i = 47, k = 47, DEPOIS
// dos prints da linha: com --checagem sim imprime 0..47, depois 2256..2302 e para com R0006 (exit 101), igual com e sem o passe e com o backend C.
proc main() {
    var a: [2303]int = {}
    var soma = 0
    for i in 0..<48 {
        print(i)
        for k in 0..<48 {
            soma = soma + k
            a[i * 48 + k] = soma
        }
    }
    print(soma + a[0])
}
