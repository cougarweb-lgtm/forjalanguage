// sroa_neg_sobreposicao: grava i64 num slot (Par.a) e le os 4 primeiros bytes pela memoria (memcpy para um i32) -> sobreposicao de larguras; o slot e mantido (sroa recusa ... sobreposicao; ou escapa, pelo &s e &baixo passados a foreign).
// Nota: a Forja nao tem cast de ponteiro (`as ^T` = E0306), entao a leitura pela memoria passa por foreign.
struct Par {
    a: i64 = 0
    b: int = 0
}

foreign {
    link "msvcrt"
    proc c_copia = "memcpy"(dst: ^i32, src: ^Par, n: int) -> rawptr
}

proc main() {
    var s = Par{a = 4294967301, b = 3}
    var baixo: i32 = 0
    _ = c_copia(&baixo, &s, 4)
    print(baixo as int)
    s.b = s.b + 1
    print(s.b)
}
