// S3 (slp, negativa): print (CHAMA) entre as gravacoes das lanes: o vetor mudaria a ordem do que se ve; saida igual a --sem-otim slp.
proc main() {
    for i in 0..<3 {
        let f = i as f32
        let a: [4]f32 = {f + 1.0, f + 2.0, f + 3.0, f + 4.0}
        var r: [4]f32 = {}
        r[0] = a[0] * 3.0
        print(i)
        r[1] = a[1] * 3.0
        print(i + 10)
        r[2] = a[2] * 3.0
        r[3] = a[3] * 3.0
        print((r[0] + r[1] + r[2] + r[3]) as int)
    }
}
