// R6a-3: soa com colunas f32, f64 e int; a mesma conta de endereco (a + i*s + desloc) serve a carga, ao store e aos ramos. O passe `endereco` recoloca a cadeia em cada acesso; a saida tem de ser igual a --sem-otim endereco.
struct Corpo {
    x: f32 = 0.0
    v: f32 = 0.0
    massa: f64 = 1.0
    toques: int = 0
}

proc passo(a: ^soa[64]Corpo, dt: f32) {
    for i in 0..<64 {
        let nx = a^[i].x + a^[i].v * dt
        if nx > 50.0 {
            a^[i].x = 100.0 - nx
            a^[i].v = -a^[i].v
            a^[i].toques += 1
            a^[i].massa = a^[i].massa + 0.5
        } else if nx < 0.0 {
            a^[i].x = -nx
            a^[i].v = -a^[i].v
            a^[i].toques += 1
        } else {
            a^[i].x = nx
        }
    }
}

proc main() {
    var a: soa[64]Corpo = {}
    for i in 0..<64 {
        a[i].x = ((i % 50) as f32) + 0.25
        a[i].v = ((i % 9) as f32) * 0.75 - 3.0
    }
    for k in 0..<200 {
        passo(&a, dt = 0.125)
    }
    var soma: f64 = 0.0
    var toques = 0
    for i in 0..<64 {
        soma = soma + (a[i].x as f64) + a[i].massa
        toques += a[i].toques
    }
    print((soma * 1000.0) as int)
    print(toques)
}
