// R6a: laco com print e conta invariante (k * 3 + 1) e indice que estoura na volta 6: imprime 0..5 e para com R0006 (exit 101) DEPOIS dos prints, igual a --sem-otim licm.
proc soma(v: []int, n: int, k: int) -> int {
    var acc = 0
    for i in 0..<n {
        print(i)
        let c = k * 3 + 1
        acc = acc + v[i] + c
    }
    return acc
}

proc main() {
    var a: [6]int = {}
    for j in 0..<6 {
        a[j] = j * 7
    }
    print(soma(a[..], 9, 4))
}
