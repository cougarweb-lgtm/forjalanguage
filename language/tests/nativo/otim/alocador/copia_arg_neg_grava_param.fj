// M7a passe `copia_arg` (negativa): o chamado grava no proprio parametro agregado; a origem local (sem &) nao pode mudar.
struct Caixa {
    v: int = 0
    w: int = 0
}

proc estraga(a: Caixa) -> int {
    var b = a
    b.v = b.v + 50
    return b.v + a.w
}

proc grava(a: Caixa) -> int {
    var c = a
    c.w = 77
    return c.w + a.v
}

proc muda(a: Caixa) -> int {
    var r = a.v
    var d = a
    d.v = 1
    r = r + d.v
    return r
}

proc main() {
    var x = Caixa{v = 5, w = 6}
    var soma = 0
    for i in 0..<4 {
        x.v = x.v + i
        soma = soma + estraga(x) + grava(x) + muda(x)
        print(x.v)
        print(x.w)
    }
    print(soma)
}
