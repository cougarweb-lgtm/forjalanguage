// licm_cmp_imediato_real_laco (R6a-2): o imediato real de CMP real dentro do laco (100.0 no caminho quente, 0.0 em ramo raro) vira CONST vreg no pre-cabecalho; laco de 0 iteracoes e NaN
// (NaN nao e maior que nada: cai no else) dao o mesmo que --sem-otim licm e o backend C.
proc avanca(x: []f32, v: []f32, n: int) -> f32 {
    var soma: f32 = 0.0
    for i in 0..<n {
        let nx = x[i] + v[i]
        if nx > 100.0 {
            x[i] = 100.0
            v[i] = -v[i]
        } else {
            if nx < 0.0 {
                x[i] = 0.0
                v[i] = -v[i]
            } else {
                x[i] = nx
            }
        }
        soma = soma + x[i]
    }
    return soma
}

proc main() {
    var x: [6]f32 = {}
    var v: [6]f32 = {}
    let zero: f32 = 0.0
    for i in 0..<6 {
        x[i] = (i as f32) * 30.0 - 10.0
        v[i] = 15.0
    }
    print((avanca(x[..], v[..], 6) * 100.0) as int)
    print((avanca(x[..], v[..], 0) * 100.0) as int)
    x[2] = zero / zero
    let r = avanca(x[..], v[..], 6)
    print(r != r)
    print(x[2] != x[2])
    print((x[5] * 100.0) as int)
}
