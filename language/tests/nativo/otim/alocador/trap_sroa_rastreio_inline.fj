// trap_sroa_rastreio_inline: R0006 dentro de folha inlinada (pega le a[..] com indice fora) chamada num laco do chamador que tem struct local; a pilha de rastreio tem de bater com a do backend C.
// Saida esperada ate o trap: 2 5 9 e depois R0006 (i = 3).
struct Par {
    a: int = 0
    b: int = 0
}

proc pega(v: []int, i: int) -> int {
    return v[i] + 1
}

proc main() {
    var a: [3]int = {1, 2, 3}
    var p = Par{a = 0, b = 0}
    for i in 0..<5 {
        p.a = p.a + pega(a[..], i)
        print(p.a)
    }
    print(p.a)
}
