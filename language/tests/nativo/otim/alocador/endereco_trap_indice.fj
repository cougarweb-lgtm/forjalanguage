// R6a-3: o indice sai do range na volta 6, depois de print; imprime 0..5 e para com R0006 (exit 101), igual a --sem-otim endereco (e a pilha do rastreio dev igual ao backend C). A checagem de indice continua antes do acesso.
proc mexer(v: []int, n: int) -> int {
    var acc = 0
    for i in 0..<n {
        print(i)
        v[i] = v[i] + 1
        acc = acc + v[i] * 2
        v[i] = acc
    }
    return acc
}

proc main() {
    var a: [6]int = {}
    for j in 0..<6 {
        a[j] = j * 7
    }
    print(mexer(a[..], 9))
}
