// numeracao_copia_propagada: cadeia de copias de variaveis (b = a, c = b) usadas em contas e em laco; o passe troca o uso de c por a enquanto a nao muda.
// espera: copia>0
proc main() {
    var a = 7
    let b = a
    let c = b
    var soma = 0
    for i in 0..<20 {
        let d = c
        soma = soma + d * i + b
    }
    a = 100
    let e = a
    let f = e
    print(soma)
    print(c + f)
    print(b)
}
