// R6a: vreg que o laco le ANTES de redefinir (t), e vreg redefinido por um ramo e vivo depois do laco (u): nenhum dos dois pode subir. stdout igual a --sem-otim licm e ao backend C.
proc le_antes(n: int, k: int) -> int {
    var t = 5
    var acc = 0
    for i in 0..<n {
        acc = acc + t
        t = k * 2 + 1
    }
    return acc * 1000 + t
}

proc ramo(n: int, k: int) -> int {
    var u = 11
    var acc = 0
    for i in 0..<n {
        if i == 3 {
            u = k * 7
        }
        acc = acc + i
    }
    return acc * 1000 + u
}

proc main() {
    print(le_antes(4, 6))
    print(le_antes(0, 6))
    print(ramo(6, 2))
    print(ramo(2, 2))
    print(ramo(0, 2))
}
