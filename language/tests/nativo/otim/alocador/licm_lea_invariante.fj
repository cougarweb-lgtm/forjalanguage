// R6a: o endereco-base de cada coluna (a + 4096, a + 8192) e invariante do laco do soa: sobe como conta pura (lea); o acesso ao dado nao sobe. stdout igual a --sem-otim licm e ao backend C.
struct Particula {
    x: f32 = 0.0
    v: f32 = 0.0
    n: int = 0
}

proc avancar(a: ^soa[64]Particula, dt: f32) {
    for i in 0..<64 {
        let nx = a^[i].x + a^[i].v * dt
        if nx > 50.0 {
            a^[i].x = 100.0 - nx
            a^[i].v = -a^[i].v
            a^[i].n += 1
        } else {
            a^[i].x = nx
        }
    }
}

proc main() {
    var a: soa[64]Particula = {}
    for i in 0..<64 {
        a[i].x = (i as f32) * 0.75
        a[i].v = ((i % 5) as f32) - 1.5
    }
    for passo in 0..<40 {
        avancar(&a, dt = 0.5)
    }
    var soma: f64 = 0.0
    var rebotes = 0
    for i in 0..<64 {
        soma = soma + (a[i].x as f64)
        rebotes += a[i].n
    }
    print((soma * 100.0) as int)
    print(rebotes)
}
