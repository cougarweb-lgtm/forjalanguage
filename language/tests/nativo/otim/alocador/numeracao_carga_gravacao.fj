// numeracao_carga_gravacao: carga, gravacao no MESMO campo, carga de novo: a 2a leitura tem de ver o valor novo (a gravacao sobreposta mata a carga lembrada).
// A leitura depois da gravacao em campo diferente do mesmo elemento pode reaproveitar.
struct Par {
    a: int = 0
    b: int = 0
}

proc main() {
    var v: [4]Par = {}
    var soma = 0
    for i in 0..<4 {
        v[i].a = i + 1
        v[i].b = i * 10
        let antes = v[i].a
        v[i].a = antes * 5
        let depois = v[i].a
        let lado = v[i].b
        v[i].b = lado + 1
        soma = soma + antes * 1000 + depois * 100 + lado + v[i].b + v[i].a
    }
    print(soma)
}
