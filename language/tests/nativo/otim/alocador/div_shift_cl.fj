// M7a F3 stress do alocador: divisao e resto (rax/rdx) e deslocamento por cl com operandos e resultados vivendo em registradores; com e sem sinal, 32 e 64 bits.
proc mistura64(a: int, b: int, n: int) -> int {
    var acc = 0
    var x = a
    for i in 1..<n {
        let d = b + i
        acc = acc + x / d + x % d
        x = (x * 3 + acc) % 1000003
    }
    return acc
}

proc mistura_u32(a: u32, n: u32) -> u32 {
    var x: u32 = a
    var acc: u32 = 0
    for i in 1..<n {
        let d: u32 = i + 3
        acc = wrapping_add(acc, b = x / d)
        acc = wrapping_add(acc, b = x % d)
        x = wrapping_add(wrapping_mul(x, b = 1664525), b = 1013904223)
    }
    return acc
}

proc desloca(v: u64, n: u64) -> u64 {
    var acc: u64 = 0
    var x: u64 = v
    for i in 0..<n {
        let k: u64 = i % 31
        acc = acc ~ (x << k)
        acc = acc ~ (x >> k)
        x = wrapping_add(wrapping_mul(x, b = 6364136223846793005), b = 1442695040888963407)
    }
    return acc
}

proc desloca_u32(v: u32, n: u32) -> u32 {
    var acc: u32 = 0
    var x: u32 = v
    for i in 0..<n {
        let k: u32 = i % 20
        acc = acc ~ (x >> k) ~ (x << k)
        x = wrapping_add(wrapping_mul(x, b = 1103515245), b = 12345)
    }
    return acc
}

proc main() {
    print(mistura64(123456, b = 7, n = 500))
    print(mistura64(-98765, b = 3, n = 300))
    print(mistura_u32(4000000000, n = 400))
    print(desloca(88172645463325252, n = 200))
    print(desloca_u32(4000000000, n = 200))
    print(desloca_u32(2147483647, n = 100))
}
