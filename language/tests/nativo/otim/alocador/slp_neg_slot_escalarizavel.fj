// S4a (slp, negativa): Vec4 local (16 B) gravado em 4 campos e lido: o sroa o escalariza, entao o slp recusa (slot_escalarizavel) e nenhum grupo vira vetor; saida igual a --sem-otim slp.
struct Vec4 {
    x: f32 = 0.0
    y: f32 = 0.0
    z: f32 = 0.0
    w: f32 = 0.0
}

proc bits(v: f32) -> int {
    return transmute(v, to = u32) as int
}

proc escala(a: Vec4, s: f32) -> Vec4 {
    var r = Vec4{}
    r.x = a.x * s
    r.y = a.y * s
    r.z = a.z * s
    r.w = a.w * s
    return r
}

proc main() {
    var v = Vec4{x = 1.0, y = 2.0, z = 3.0, w = 4.0}
    for i in 0..<5 {
        v = escala(v, 1.5)
        print(bits(v.x) + bits(v.y) + bits(v.z) + bits(v.w))
    }
}
