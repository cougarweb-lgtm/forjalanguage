// numeracao_neg_cmp_inteiro_copia (R6a-2): CMP INTEIRO com imediato continua comparando o vreg original (e o teste de guarda); o resultado igual a --sem-otim numeracao e ao backend C.
proc limita(v: []int, n: int) -> int {
    var acc = 0
    for i in 0..<n {
        let x = v[i]
        let c = x
        if c > 100 {
            acc = acc + 100
        } else {
            acc = acc + c
        }
    }
    return acc
}

proc main() {
    var a: [6]int = {}
    for j in 0..<6 {
        a[j] = j * 40 - 20
    }
    print(limita(a[..], 6))
    print(limita(a[..], 0))
    print(limita(a[..], 3))
}
