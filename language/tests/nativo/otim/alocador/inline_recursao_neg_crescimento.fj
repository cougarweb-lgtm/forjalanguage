// inline_recursao_neg_crescimento: recursao direta com corpo de mais de 64 instrucoes BIR: o passe recusa (`inline recusa fj_pesada: tamanho`), a saida nao muda.
// Saida esperada: o valor de pesada(3, 1) calculado igual com e sem o passe (conferido contra --sem-otim inline e o backend C).
proc pesada(n: int, a: int) -> int {
    if n <= 0 {
        return a
    }
    let t1 = wrapping_add(a, 7)
    let t2 = wrapping_mul(t1, 3)
    let t3 = wrapping_sub(t2, a)
    let t4 = wrapping_add(t3, t1)
    let t5 = wrapping_mul(t4, 5)
    let t6 = wrapping_sub(t5, t2)
    let t7 = wrapping_add(t6, t3)
    let t8 = wrapping_mul(t7, 3)
    let t9 = wrapping_sub(t8, t4)
    let t10 = wrapping_add(t9, t5)
    let t11 = wrapping_mul(t10, 7)
    let t12 = wrapping_sub(t11, t6)
    let t13 = wrapping_add(t12, t7)
    let t14 = wrapping_mul(t13, 3)
    let t15 = wrapping_sub(t14, t8)
    let t16 = wrapping_add(t15, t9)
    let t17 = wrapping_mul(t16, 5)
    let t18 = wrapping_sub(t17, t10)
    let t19 = wrapping_add(t18, t11)
    let t20 = wrapping_mul(t19, 3)
    let t21 = wrapping_sub(t20, t12)
    let t22 = wrapping_add(t21, t13)
    let t23 = wrapping_mul(t22, 7)
    let t24 = wrapping_sub(t23, t14)
    let t25 = wrapping_add(t24, t15)
    let t26 = wrapping_mul(t25, 3)
    let t27 = wrapping_sub(t26, t16)
    let t28 = wrapping_add(t27, t17)
    let t29 = wrapping_mul(t28, 5)
    let t30 = wrapping_sub(t29, t18)
    let t31 = wrapping_add(t30, t19)
    let t32 = wrapping_mul(t31, 3)
    let t33 = wrapping_sub(t32, t20)
    let t34 = wrapping_add(t33, t21)
    let t35 = wrapping_mul(t34, 7)
    let t36 = wrapping_sub(t35, t22)
    let t37 = wrapping_add(t36, t23)
    let t38 = wrapping_mul(t37, 3)
    let t39 = wrapping_sub(t38, t24)
    let t40 = wrapping_add(t39, t25)
    return wrapping_add(pesada(n - 1, t40), pesada(n - 1, t20))
}

proc main() {
    print(pesada(3, 1))
}
