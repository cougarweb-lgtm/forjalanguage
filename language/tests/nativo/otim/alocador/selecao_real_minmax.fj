// R5: losango real no padrao exato do minss/maxss (a < b ? a : b, a > b ? a : b e as trocadas), com NaN e +-0 nos dois lados: com NaN ou zeros iguais sai o SEGUNDO operando, como no desvio.
proc menor(a: f64, b: f64) -> f64 {
    var m = b
    if a < b {
        m = a
    }
    return m
}

proc maior(a: f64, b: f64) -> f64 {
    var m = b
    if a > b {
        m = a
    }
    return m
}

proc menor_invertido(a: f64, b: f64) -> f64 {
    var m = a
    if a < b {
        m = b
    }
    return m
}

proc maior32(a: f32, b: f32) -> f32 {
    var m: f32 = b
    if a > b {
        m = a
    }
    return m
}

proc menor32(a: f32, b: f32) -> f32 {
    var m: f32 = 0.0
    if a < b {
        m = a
    } else {
        m = b
    }
    return m
}

proc grampo_zero(x: f64) -> f64 {
    var r = x
    if r < 0.0 {
        r = 0.0
    }
    return r
}

// 1/x distingue +0 de -0 (+inf, -inf); NaN vira 7.0 (so o NaN nao e igual a ele mesmo).
proc marca(x: f64) -> f64 {
    if x != x {
        return 7.0
    }
    if x == 0.0 {
        return 1.0 / x
    }
    return x
}

proc main() {
    let z: f64 = 0.0
    let nz: f64 = -z
    let nan: f64 = z / z
    let inf: f64 = 1.0 / z
    let z32: f32 = 0.0
    let nan32: f32 = z32 / z32
    var vals: [8]f64 = {}
    vals[0] = 1.5
    vals[1] = -2.5
    vals[2] = z
    vals[3] = nz
    vals[4] = nan
    vals[5] = inf
    vals[6] = -inf
    vals[7] = 3.0
    for i in 0..<8 {
        for j in 0..<8 {
            let a = vals[i]
            let b = vals[j]
            print(marca(menor(a, b)))
            print(marca(maior(a, b)))
            print(marca(menor_invertido(a, b)))
        }
        print(marca(grampo_zero(vals[i])))
    }
    print(menor32(nan32, 1.0))
    print(menor32(1.0, nan32))
    print(maior32(nan32, 2.0))
    print(maior32(2.0, nan32))
    print(maior32(3.0, 2.0))
}
