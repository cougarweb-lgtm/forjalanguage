// M7a F6b passe `checagem`: C = 0 (i*0 + k, provado em k), C grande (3000, provado: 2*3000+2 = 6002 < 6003) e C acima de 2^31 com i em 0..<1 (nao entra na conta, a
// checagem fica; o programa nao estoura). Sem trap; saida igual com e sem o passe e com o backend C.
const C_ZERO: int = 0
const C_GRANDE: int = 3000
const C_ENORME: int = 1099511627776

proc main() {
    var a: [10]int = {}
    var g: [6003]int = {}
    var e: [8]int = {}
    var soma = 0
    for i in 0..<5 {
        for k in 0..<10 {
            a[i * C_ZERO + k] = a[i * C_ZERO + k] + i + k
        }
    }
    for i in 0..<3 {
        for k in 0..<3 {
            g[i * C_GRANDE + k] = i * 10 + k + 1
        }
    }
    for i in 0..<1 {
        for k in 0..<4 {
            e[i * C_ENORME + k] = k * 7
        }
    }
    for i in 0..<10 {
        soma = soma + a[i] * (i + 1)
    }
    print(soma + g[0] + g[3002] + g[6002] + e[3])
}
