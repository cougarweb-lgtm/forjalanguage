// sroa_vetor4_indice_const: [4]f32 local usado so com indices constantes (0..3) dentro de laco; cada elemento vira escalar.
proc main() {
    var v: [4]f32 = {1.0, 2.0, 3.0, 4.0}
    for i in 0..<6 {
        v[0] = v[0] + 0.5
        v[1] = v[0] * 0.25
        v[2] = v[1] + v[3] * 0.125
        v[3] = v[3] - 0.25 + (i as f32) * 0.5
    }
    print((v[0] * 100.0) as int)
    print((v[1] * 100.0) as int)
    print((v[2] * 100.0) as int)
    print((v[3] * 100.0) as int)
}
