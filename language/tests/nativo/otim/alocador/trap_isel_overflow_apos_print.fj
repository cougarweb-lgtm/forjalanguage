// M7a F5 stress do isel: soma i32 que estoura no meio do laco, DEPOIS do print da volta e depois de um cmp+jcc fundido; em release a soma volta (wrapping), em dev e R0002; saida e codigo iguais com e sem o passe isel.
proc main() {
    var acc: i32 = 2147483000
    var passo: i32 = 100
    var i = 0
    while i < 50 {
        print(i)
        if passo > 0 {
            acc = acc + passo
        }
        passo = passo + 50
        i = i + 1
    }
    print(acc)
}
