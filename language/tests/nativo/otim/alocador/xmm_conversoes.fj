// M7a F4 stress do alocador: f32 e f64 misturados com conversoes int <-> real e f32 <-> f64 dentro de laco; o arredondamento de f32 tem de sobreviver ao registrador.
proc conv(n: int) -> int {
    var f32a: f32 = 0.1
    var f64a: f64 = 0.1
    var i32a: i32 = 7
    var i64a: i64 = 9007199254740993
    var total: int = 0
    for i in 0..<n {
        f32a = f32a * 1.5 + (i as f32) * 0.001
        f64a = f64a * 1.25 + (f32a as f64) * 0.5
        let volta = f64a as f32
        i32a = (i32a + (volta as i32)) % 1000
        i64a = i64a + (f64a as i64) % 1000
        total = total + (f32a as int) % 1000 + i32a as int + ((i64a as f64) as int) % 1000
        if f32a > 1000.0 {
            f32a = 0.1
        }
        if f64a > 100000.0 {
            f64a = 0.1
        }
    }
    return total + ((f32a as f64) * 1000000.0) as int + (f64a * 1000.0) as int
}

proc main() {
    print(conv(50))
    print(conv(3000))
    print(conv(1))
}
