// inline_tipos: parametros e retornos i8, u16, bool, u32 e f64, com valores negativos, acima de 127, 65535 e reais.
// Saida esperada (uma linha por print): 56 / -56 / 0 / 100 / 14464 / 0 / 65536 / true / false / true / 3599506688 / 65.18799
proc soma_i8(a: i8, b: i8) -> i8 {
    return wrapping_add(a, b)
}

proc neg_i8(v: i8) -> i8 {
    return wrapping_sub(0 as i8, v)
}

proc soma_u16(a: u16, b: u16) -> u16 {
    return wrapping_add(a, b)
}

proc flag_bool(a: bool, b: bool) -> bool {
    return a and not b
}

proc u32_mix(a: u32, b: u32) -> u32 {
    let t = wrapping_mul(a, b)
    return t ~ (a >> 3)
}

proc area(r: f64) -> f64 {
    let pi: f64 = 3.14159
    return pi * r * r
}

proc main() {
    let a: i8 = -100
    let b: i8 = 100
    print((soma_i8(a, a)) as int)
    print((soma_i8(b, b)) as int)
    print((soma_i8(a, b)) as int)
    print((neg_i8(a)) as int)
    let w: u16 = 40000
    print(soma_u16(w, w))
    let m: u16 = 65535
    print(soma_u16(m, 1))
    print((m as int) + 1)
    print(flag_bool(true, false))
    print(flag_bool(false, true))
    print(flag_bool(a < 0, b < 0))
    let x: u32 = 4000000000
    print(u32_mix(x, 3))
    let base: f64 = 1.5
    var total: f64 = 0.0
    for i in 0..<3 {
        total += area(base + (i as f64))
    }
    print(f"{total:.5}")
}
