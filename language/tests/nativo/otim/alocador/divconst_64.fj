// M7b F1: divisao e resto por constante em i64 (int) e u64 (SINAL_64 com imul de um operando, SEM_SINAL_64 com 65 bits, MAIOR_SEM_SINAL, MIN, potencias de 2) sobre valores extremos e uma sequencia congruencial.
proc mix(h: u64, v: u64) -> u64 {
    return wrapping_add(wrapping_mul(h, b = 1099511628211), b = v)
}

proc hash_i64(x: i64, h0: u64) -> u64 {
    var h = h0
    h = mix(mix(h, (x / 1) as u64), (x % 1) as u64)
    h = mix(mix(h, (x / 2) as u64), (x % 2) as u64)
    h = mix(mix(h, (x / 3) as u64), (x % 3) as u64)
    h = mix(mix(h, (x / 5) as u64), (x % 5) as u64)
    h = mix(mix(h, (x / 6) as u64), (x % 6) as u64)
    h = mix(mix(h, (x / 7) as u64), (x % 7) as u64)
    h = mix(mix(h, (x / 10) as u64), (x % 10) as u64)
    h = mix(mix(h, (x / 11) as u64), (x % 11) as u64)
    h = mix(mix(h, (x / 12) as u64), (x % 12) as u64)
    h = mix(mix(h, (x / 100) as u64), (x % 100) as u64)
    h = mix(mix(h, (x / 1000) as u64), (x % 1000) as u64)
    h = mix(mix(h, (x / 1000000007) as u64), (x % 1000000007) as u64)
    h = mix(mix(h, (x / 1099511628211) as u64), (x % 1099511628211) as u64)
    h = mix(mix(h, (x / 4294967296) as u64), (x % 4294967296) as u64)
    h = mix(mix(h, (x / 9223372036854775807) as u64), (x % 9223372036854775807) as u64)
    h = mix(mix(h, (x / 516) as u64), (x % 516) as u64)
    h = mix(mix(h, (x / 517) as u64), (x % 517) as u64)
    h = mix(mix(h, (x / 518) as u64), (x % 518) as u64)
    h = mix(mix(h, (x / 519) as u64), (x % 519) as u64)
    h = mix(mix(h, (x / 1024) as u64), (x % 1024) as u64)
    h = mix(mix(h, (x / -2) as u64), (x % -2) as u64)
    h = mix(mix(h, (x / -3) as u64), (x % -3) as u64)
    h = mix(mix(h, (x / -7) as u64), (x % -7) as u64)
    h = mix(mix(h, (x / -10) as u64), (x % -10) as u64)
    h = mix(mix(h, (x / -1000) as u64), (x % -1000) as u64)
    h = mix(mix(h, (x / -1099511628211) as u64), (x % -1099511628211) as u64)
    h = mix(mix(h, (x / -1024) as u64), (x % -1024) as u64)
    h = mix(mix(h, (x / -9223372036854775807) as u64), (x % -9223372036854775807) as u64)
    h = mix(mix(h, (x / -9223372036854775808) as u64), (x % -9223372036854775808) as u64)
    return h
}

proc hash_u64(x: u64, h0: u64) -> u64 {
    var h = h0
    h = mix(mix(h, x / 1), x % 1)
    h = mix(mix(h, x / 2), x % 2)
    h = mix(mix(h, x / 3), x % 3)
    h = mix(mix(h, x / 5), x % 5)
    h = mix(mix(h, x / 6), x % 6)
    h = mix(mix(h, x / 7), x % 7)
    h = mix(mix(h, x / 10), x % 10)
    h = mix(mix(h, x / 11), x % 11)
    h = mix(mix(h, x / 12), x % 12)
    h = mix(mix(h, x / 100), x % 100)
    h = mix(mix(h, x / 1000), x % 1000)
    h = mix(mix(h, x / 1000000007), x % 1000000007)
    h = mix(mix(h, x / 1099511628211), x % 1099511628211)
    h = mix(mix(h, x / 4294967296), x % 4294967296)
    h = mix(mix(h, x / 9223372036854775807), x % 9223372036854775807)
    h = mix(mix(h, x / 9223372036854775808), x % 9223372036854775808)
    h = mix(mix(h, x / 9223372036854775809), x % 9223372036854775809)
    h = mix(mix(h, x / 14695981039346656037), x % 14695981039346656037)
    h = mix(mix(h, x / 18446744073709551615), x % 18446744073709551615)
    h = mix(mix(h, x / 516), x % 516)
    h = mix(mix(h, x / 517), x % 517)
    h = mix(mix(h, x / 518), x % 518)
    h = mix(mix(h, x / 519), x % 519)
    h = mix(mix(h, x / 4), x % 4)
    h = mix(mix(h, x / 1024), x % 1024)
    return h
}

proc main() {
    var h: u64 = 14695981039346656037
    let bordas: [12]u64 = {0, 1, 2, 3, 7, 9223372036854775807, 9223372036854775808, 9223372036854775809, 18446744073709551614, 18446744073709551615, 516, 4294967296}
    for i in 0..<12 {
        h = hash_u64(bordas[i], h0 = h)
        h = hash_i64(bordas[i] as i64, h0 = h)
        h = hash_i64(wrapping_sub(0 as u64, b = bordas[i]) as i64, h0 = h)
    }
    print(h)
    var x: u64 = 88172645463325252
    for i in 0..<30000 {
        x = wrapping_add(wrapping_mul(x, b = 6364136223846793005), b = 1442695040888963407)
        h = hash_u64(x, h0 = h)
        h = hash_i64(x as i64, h0 = h)
        h = hash_u64(x >> (i as u64 % 64), h0 = h)
    }
    print(h)
}
