// M7a F3 stress do alocador: laco aninhado com chamada e print no meio; valores vivos ATRAVES da chamada (callee-saved) e valores locais ao trecho entre chamadas (r8..r10).
proc passo(x: int, i: int) -> int {
    return (x * 31 + i) % 10007
}

proc mexe(v: int, w: int) -> int {
    let t = v * 3
    let u = w + t
    return (u * u) % 10007
}

proc main() {
    var soma = 0
    var a = 1
    var b = 2
    var c = 3
    var d = 4
    for j in 0..<30 {
        let t = j * 2
        for i in 0..<40 {
            let antes = i * 5 + j
            a = passo(a, i = i + t)
            let depois = antes + a
            b = (b + a + mexe(depois, w = antes)) % 10007
            soma = (soma + b * c - d + antes) % 1000003
            if i % 7 == 0 {
                c = c + 1
            } else {
                d = d + (i % 4)
            }
        }
        print(soma)
    }
    print(a)
    print(b)
    print(c)
    print(d)
}
