// sroa_param_externo: copia de um ^Par (parametro) e de um elemento de lista para struct local; a origem nao muda com a copia.
// O slot origem (passado por &) escapa e fica de fora; o positivo e a copia local c/e.
struct Par {
    a: int = 0
    b: int = 0
}

proc soma_copia(p: ^Par) -> int {
    var c = p^
    c.a = c.a + 10
    return c.a + c.b
}

proc main() {
    var l = make([dynamic]Par, alloc = heap)
    defer delete(l)
    append(&l, item = Par{a = 1, b = 2})
    append(&l, item = Par{a = 3, b = 4})
    var origem = Par{a = 7, b = 8}
    var total = 0
    for i in 0..<2 {
        var e = l[i]
        e.b = e.b + i
        total = total + e.a + e.b
    }
    print(total)
    print(l[0].b)
    print(soma_copia(&origem))
    print(origem.a)
}
