// licm_neg_cmp_inteiro_imediato (R6a-2): CMP inteiro com imediato no laco NAO vira CONST no pre-cabecalho (so o real); o resultado e igual a --sem-otim licm e ao backend C.
proc conta(v: []int, n: int) -> int {
    var acc = 0
    for i in 0..<n {
        if v[i] > 100 {
            acc = acc + 1
        }
        if v[i] < 0 {
            acc = acc + 10
        }
    }
    return acc
}

proc main() {
    var a: [6]int = {}
    for j in 0..<6 {
        a[j] = j * 50 - 30
    }
    print(conta(a[..], 6))
    print(conta(a[..], 0))
}
