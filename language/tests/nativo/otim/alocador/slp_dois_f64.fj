// S3 (slp): 2 lanes f64 (grupo de 2 gravacoes contiguas de 8 bytes): soma e produto com cargas contiguas de dois Par, bits exatos.
struct Par {
    x: f64 = 0.0
    y: f64 = 0.0
    enchimento: [8]f64 // enchimento: o slot passa de 64 B, o sroa o recusa (tamanho) e o slp o vetoriza; ate 64 B o sroa o escalariza e o slp recusa: slot_escalarizavel
}

proc bits(v: f64) -> int {
    return transmute(v, to = u64) as int
}

proc main() {
    for i in 0..<6 {
        let f = i as f64
        let a = Par{x = f + 0.1, y = f * 1.7}
        let b = Par{x = 3.0 - f, y = f + 0.3}
        var s = Par{}
        var m = Par{}
        var q = Par{}
        s.x = a.x + b.x
        s.y = a.y + b.y
        m.x = a.x * b.x
        m.y = a.y * b.y
        q.x = a.x / b.x + a.x
        q.y = a.y / b.y + a.y
        print(bits(s.x) + bits(s.y))
        print(bits(m.x) + bits(m.y))
        print(bits(q.x) + bits(q.y))
    }
}
