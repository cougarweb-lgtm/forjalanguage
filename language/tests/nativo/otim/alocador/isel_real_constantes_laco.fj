// M7a F5 stress do isel: constantes reais (f32 e f64, incluindo 0.0 e negativa) usadas a cada volta de laco, comparacoes < <= > >= == != com NaN e infinito, conta em lugar (x = x op y), conversoes int<->real.
proc varre(n: int) -> f64 {
    var acc: f64 = 0.0
    var x: f64 = 1.0
    for i in 0..<n {
        x = x * 1.0001 + 0.5
        if x > 100.0 {
            x = x - 99.5
        }
        if x <= 0.25 {
            x = x + 2.0
        }
        acc = acc + x * 0.125 - 0.0625
        if acc >= 1000.0 {
            acc = acc * 0.5
        }
    }
    return acc
}

proc varre32(n: int) -> f32 {
    var acc: f32 = 0.0
    var x: f32 = 1.0
    for i in 0..<n {
        x = x * 1.01 + 0.5
        if x > 50.0 {
            x = x - 49.5
        }
        acc = acc + x * 0.125 - 0.5
    }
    return acc
}

proc ordem(a: f64, b: f64) -> int {
    var r = 0
    if a < b {
        r = r + 1
    }
    if a <= b {
        r = r + 2
    }
    if a > b {
        r = r + 4
    }
    if a >= b {
        r = r + 8
    }
    if a == b {
        r = r + 16
    }
    if a != b {
        r = r + 32
    }
    return r
}

proc main() {
    print((varre(1000) * 1000.0) as int)
    print((varre32(1000) * 1000.0) as int)
    let zero: f64 = 0.0
    let nan = zero / zero
    let inf = 1.0 / zero
    print(ordem(1.0, 2.0))
    print(ordem(2.0, 1.0))
    print(ordem(2.0, 2.0))
    print(ordem(nan, 1.0))
    print(ordem(1.0, nan))
    print(ordem(inf, 1.0))
    print(ordem(-inf, inf))
    var s = 0
    for i in 0..<50 {
        s = s + ((i as f64) * 0.75) as int + (i as f32 * 0.5) as int
    }
    print(s)
}
