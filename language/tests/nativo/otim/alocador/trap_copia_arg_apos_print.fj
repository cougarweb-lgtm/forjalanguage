// M7a passe `copia_arg`: R0006 exato (indice fora) no meio do laco DEPOIS do print da volta; a conta do endereco do elemento fica antes do chamado, a copia que sai nao muda o ponto do trap.
struct Caixa {
    v: int = 0
    w: int = 0
}

proc le(a: Caixa) -> int {
    return a.v * 3 + a.w
}

proc main() {
    var caixas: [6]Caixa = {}
    var soma = 0
    var i = 0
    for k in 0..<6 {
        caixas[k] = Caixa{v = k, w = k * 2}
    }
    while i < 20 {
        print(soma)
        soma = soma + le(caixas[i])
        i = i + 1
    }
    print(soma)
}
