// M7a F4 stress do alocador: acumuladores f32 e f64 vivos ATRAVES de chamadas dentro do laco (so xmm6..15 servem), mais temporarios que nao cruzam chamada (xmm2..5).
proc passo(x: f64, y: f32) -> f64 {
    return x * 0.5 + (y as f64) * 0.25
}

proc encolhe(x: f32) -> f32 {
    return x * 0.75
}

proc varre(n: int) -> f64 {
    var acc64: f64 = 1.0
    var acc32: f32 = 2.0
    var outro64: f64 = 3.0
    var outro32: f32 = 4.0
    var soma: f64 = 0.0
    for i in 0..<n {
        let t1 = (i % 5) as f64 * 0.5
        let t2 = (i % 3) as f32 * 0.25
        acc64 = passo(acc64 + t1, y = acc32)
        acc32 = encolhe(acc32 + t2)
        outro64 = outro64 * 0.9 + acc64 * 0.1
        outro32 = outro32 * 0.9 + acc32 * 0.1
        soma = soma + acc64 + (acc32 as f64) + outro64 + (outro32 as f64)
    }
    return soma
}

proc main() {
    print((varre(100) * 1000.0) as int)
    print((varre(7) * 1000.0) as int)
    print((varre(0) * 1000.0) as int)
}
