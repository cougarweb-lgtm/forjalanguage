// M7b R4b stress do passe cfg: if aninhado com ramos vazios e continue em cascata (cadeias de blocos que so saltam: jmp -> jmp -> jmp); o resultado tem de ser o mesmo com --sem-otim cfg,layout.
proc grau(n: int) -> int {
    var r = 0
    if n > 10 {
        if n > 20 {
            if n > 30 {
                r = 3
            } else {
            }
        } else {
        }
    } else {
        if n > 5 {
        } else {
            r = 1
        }
    }
    return r
}

proc soma_pares(limite: int) -> int {
    var acc = 0
    var i = 0
    while i < limite {
        i = i + 1
        if i % 2 == 1 {
            if i % 3 == 1 {
                continue
            }
            continue
        }
        if i > 50 {
            if i > 70 {
                break
            }
        }
        acc = acc + i
    }
    return acc
}

proc main() {
    var total = 0
    for n in 0..<40 {
        total = total + grau(n) * (n + 1)
    }
    print(total)
    print(soma_pares(100))
    print(soma_pares(10))
}
