// M7a passe `copia_arg`: laco que altera a origem entre as iteracoes e entre a copia e o uso; cada chamada tem de ver o valor da sua volta (origem local, sem &).
struct Caixa {
    v: int = 0
    w: int = 0
}

proc le(a: Caixa, b: Caixa) -> int {
    return a.v * 10 + a.w + b.v * 1000
}

proc main() {
    var x = Caixa{v = 1, w = 2}
    var y = Caixa{v = 3, w = 4}
    var soma = 0
    for i in 0..<6 {
        soma = soma + le(x, y)
        x.v = x.v + i
        y.v = soma % 7
        x.w = le(y, x) % 11
        print(soma)
    }
    print(x.v + y.v + x.w)
}
