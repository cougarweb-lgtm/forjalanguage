// R6a: real: CONST/ADD/MUL/NEG de real invariantes sobem (nao trapam, sem FMA, sem reassociar); a ordem das contas e dos bits fica igual a --sem-otim licm e ao backend C.
proc escala(v: []f64, n: int, k: f64) -> f64 {
    var s: f64 = 0.0
    for i in 0..<n {
        let c = k * 2.5 + 1.0
        let d = -c * 0.125
        s = s + v[i] * c + d
    }
    return s
}

proc escala32(v: []f32, n: int, k: f32) -> f32 {
    var s: f32 = 0.0
    for i in 0..<n {
        let c = k * 1.5 + 0.25
        s = s + v[i] * c
    }
    return s
}

proc main() {
    var a: [8]f64 = {}
    var b: [8]f32 = {}
    for i in 0..<8 {
        a[i] = (i as f64) * 0.3 - 1.0
        b[i] = (i as f32) * 0.7 - 2.0
    }
    print((escala(a[..], 8, 1.75) * 1000.0) as int)
    print((escala(a[..], 0, 1.75) * 1000.0) as int)
    print((escala32(b[..], 8, 0.5) * 1000.0) as int)
}
