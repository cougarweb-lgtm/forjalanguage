// M7a passe `copia_arg` (negativa): o chamado passa o parametro adiante a outro proc que grava no dele; a origem do 1o chamador nao pode mudar.
struct Caixa {
    v: int = 0
    w: int = 0
}

proc estraga(a: Caixa) -> int {
    var b = a
    b.v = b.v * 2
    return b.v + a.w
}

proc repassa(a: Caixa) -> int {
    return estraga(a) + a.v
}

proc main() {
    var x = Caixa{v = 5, w = 6}
    var soma = 0
    for i in 0..<4 {
        x.w = x.w + i
        soma = soma + repassa(x)
        print(x.v)
        print(x.w)
    }
    print(soma)
}
