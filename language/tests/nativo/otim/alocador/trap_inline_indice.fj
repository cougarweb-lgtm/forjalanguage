// inline_trap_indice: R0006 (indice fora) dentro da folha `par_em`, que recebe fatia a[..] e e chamada num laco do chamador.
// Com --checagem sim: imprime 0 1 1 8 2 29 3 72 4 145 5 256 6 413 7 e para com R0006 na folha (exit 101).
proc par_em(v: []int, i: int) -> int {
    return v[i] * 3 + v[i + 1]
}

proc main() {
    var a: [8]int = {}
    for k in 0..<8 {
        a[k] = k * k
    }
    var acc = 0
    for i in 0..<10 {
        print(i)
        acc = acc + par_em(a[..], i)
        print(acc)
    }
    print(acc)
}
