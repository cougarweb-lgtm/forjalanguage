// S3 (slp): lanes com NaN, -0, denormal e infinito (somas, produtos, subtracoes e divisoes); o vetor tem de dar os mesmos bits do escalar em cada lane.
struct Vec4 {
    x: f32 = 0.0
    y: f32 = 0.0
    z: f32 = 0.0
    w: f32 = 0.0
    enchimento: [14]f32 // enchimento: o slot passa de 64 B, o sroa o recusa (tamanho) e o slp o vetoriza; ate 64 B o sroa o escalariza e o slp recusa: slot_escalarizavel
}

proc bits(v: f32) -> int {
    return transmute(v, to = u32) as int
}

proc mostra(r: Vec4) {
    print(bits(r.x))
    print(bits(r.y))
    print(bits(r.z))
    print(bits(r.w))
}

proc main() {
    let zero: f32 = 0.0
    let nan: f32 = zero / zero
    let inf: f32 = 1.0 / zero
    let menos_zero: f32 = zero * -1.0
    var denormal: f32 = 1.0
    for k in 0..<135 {
        denormal = denormal * 0.5
    }
    for i in 0..<3 {
        let f = i as f32
        let a = Vec4{x = nan, y = menos_zero, z = denormal, w = inf}
        let b = Vec4{x = f + 1.0, y = menos_zero, z = denormal * 3.0, w = 0.0 - inf}
        var s = Vec4{}
        var d = Vec4{}
        var m = Vec4{}
        var q = Vec4{}
        s.x = a.x + b.x
        s.y = a.y + b.y
        s.z = a.z + b.z
        s.w = a.w + b.w
        d.x = a.x - b.x
        d.y = a.y - b.y
        d.z = a.z - b.z
        d.w = a.w - b.w
        m.x = a.x * b.x
        m.y = a.y * b.y
        m.z = a.z * b.z
        m.w = a.w * b.w
        q.x = a.y / b.x
        q.y = a.z / b.y
        q.z = a.w / b.z
        q.w = b.w / b.w
        mostra(s)
        mostra(d)
        mostra(m)
        mostra(q)
    }
}
