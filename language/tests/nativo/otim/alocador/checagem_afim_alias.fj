// M7a F6b passe `checagem`: k com limite (12) maior que C (8): i*8 + k repete indices entre linhas, mas o maximo 3*8+11 = 35 cabe em 64 e e provado.
// Sem trap; as escritas repetidas acumulam e a saida e igual com e sem o passe e com o backend C.
proc main() {
    var a: [64]int = {}
    var soma = 0
    for i in 0..<4 {
        for k in 0..<12 {
            a[i * 8 + k] = a[i * 8 + k] + i + k + 1
        }
    }
    for i in 0..<64 {
        soma = soma + a[i] * (i + 1)
    }
    print(soma)
    print(a[8] + a[35])
}
