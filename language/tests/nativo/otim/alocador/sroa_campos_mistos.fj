// sroa_campos_mistos: campos i8, i16, f32, f64 e i32 com padding entre eles (buracos no layout); cada campo vira escalar proprio, o padding nao conta.
struct Misto {
    a: i8 = 0
    b: i16 = 0
    c: f32 = 0.0
    d: f64 = 0.0
    e: i32 = 0
}

proc main() {
    var m = Misto{a = 3, b = 300, c = 1.5, d = 2.25, e = 9}
    for i in 0..<10 {
        m.a = m.a + 2
        m.b = m.b + (i as i16) * 10
        m.c = m.c * 1.5
        m.d = m.d + (m.c as f64) * 0.5
        m.e = m.e + (m.a as i32)
    }
    print(m.a as int)
    print(m.b as int)
    print((m.c * 100.0) as int)
    print((m.d * 100.0) as int)
    print(m.e)
}
