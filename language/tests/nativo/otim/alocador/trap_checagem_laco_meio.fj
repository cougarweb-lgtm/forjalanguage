// M7a F6 passe `checagem`: laco contado com limite constante. a[16] com 0..<10 tem a checagem provada (sai da BIR); b[8] com 0..<10 NAO e provada e estoura no meio
// do laco, na volta i = 8, DEPOIS do print da mesma volta: com --checagem sim o programa imprime 0..8 e para com R0006 (exit 101), igual com e sem o passe.
proc main() {
    var a: [16]int = {}
    var b: [8]int = {}
    var acc = 0
    for i in 0..<10 {
        print(i)
        a[i] = i * 3 + acc
        acc = acc + a[i] % 7
        b[i] = acc
    }
    print(acc + b[0])
}
