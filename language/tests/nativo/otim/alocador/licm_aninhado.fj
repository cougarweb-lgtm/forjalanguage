// R6a: laco dentro de laco: `a` so depende de k (sobe ate o pre-cabecalho do laco externo), `b` depende de i (sobe so ate o pre-cabecalho do laco interno). stdout igual a --sem-otim licm e ao backend C.
proc tabela(n: int, m: int, k: int) -> int {
    var acc = 0
    for i in 0..<n {
        let a = k * 5 + 1
        let b = (a + i) * 3
        for j in 0..<m {
            acc = acc + b + a * 2 + j
        }
    }
    return acc
}

proc main() {
    print(tabela(6, 5, 3))
    print(tabela(4, 0, 3))
    print(tabela(0, 9, 3))
    print(tabela(3, 3, -8))
}
