// numeracao_cmp_real_copiaprop (R6a-2): a copia que alimenta um CMP real com imediato e propagada (o CMP compara a origem); o NaN de nx tem de cair no else (a comparacao `>` com NaN e falsa).
// espera: copia>0
proc rebate(x: f32, v: f32) -> f32 {
    let nx = x + v
    let c = nx
    if c > 100.0 {
        return 100.0 - (c - 100.0)
    }
    if c < 0.0 {
        return 0.0 - c
    }
    return c
}

proc rebate64(x: f64, v: f64) -> f64 {
    let nx = x * v
    let c = nx
    if c >= 50.0 {
        return 50.0
    }
    return c + 1.0
}

proc main() {
    let zero: f32 = 0.0
    let nan: f32 = zero / zero
    let zero64: f64 = 0.0
    let nan64: f64 = zero64 / zero64
    print((rebate(90.0, 20.0) * 100.0) as int)
    print((rebate(-5.0, 1.0) * 100.0) as int)
    print((rebate(10.0, 5.0) * 100.0) as int)
    print(rebate(nan, 1.0) != rebate(nan, 1.0))
    print(rebate(1.0, nan) != rebate(1.0, nan))
    print((rebate64(8.0, 8.0) * 100.0) as int)
    print((rebate64(2.0, 3.0) * 100.0) as int)
    print(rebate64(nan64, 3.0) != rebate64(nan64, 3.0))
}
