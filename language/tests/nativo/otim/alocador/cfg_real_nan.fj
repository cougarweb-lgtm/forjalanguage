// M7b R4b: jcc de real com NaN depois do layout (o sucessor da comparacao pode virar o bloco seguinte, o jcc se inverte): todas as seis comparacoes com NaN, infinito e valores normais, em laco.
proc cmp_real(a: f64, b: f64) -> int {
    var r = 0
    if a < b {
        r = r + 1
    }
    if a <= b {
        r = r + 2
    }
    if a > b {
        r = r + 4
    }
    if a >= b {
        r = r + 8
    }
    if a == b {
        r = r + 16
    }
    if a != b {
        r = r + 32
    }
    return r
}

proc cmp_real32(a: f32, b: f32) -> int {
    var r = 0
    if a < b {
        r = r + 1
    } else {
        r = r + 100
    }
    if a >= b {
        r = r + 8
    } else {
        r = r + 200
    }
    return r
}

proc main() {
    let z: f64 = 0.0
    let nan: f64 = z / z
    let inf: f64 = 1.0 / z
    let z32: f32 = 0.0
    let nan32: f32 = z32 / z32
    var acc = 0
    for i in 0..<5 {
        let v = i as f64
        acc = acc + cmp_real(nan, v) + cmp_real(v, nan) + cmp_real(inf, v) + cmp_real(v, inf) + cmp_real(v, 2.0)
        acc = acc + cmp_real32(nan32, i as f32) + cmp_real32(i as f32, nan32) + cmp_real32(i as f32, 2.0)
    }
    print(acc)
    print(cmp_real(nan, nan))
    print(cmp_real32(nan32, nan32))
}
