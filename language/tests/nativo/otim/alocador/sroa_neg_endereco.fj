// sroa_neg_endereco: &s passado a um proc (^Par) e a uma foreign (memset, ^Par) -> o slot escapa; o passe tem de recusar (sroa recusa ... escapa).
struct Par {
    a: int = 0
    b: int = 0
}

foreign {
    link "msvcrt"
    proc c_zera = "memset"(p: ^Par, valor: i32, n: int) -> rawptr
}

proc soma(p: ^Par) -> int {
    return p.a + p.b
}

proc main() {
    var s = Par{a = 1, b = 2}
    print(soma(&s))
    var t = Par{a = 5, b = 6}
    _ = c_zera(&t, 0, 16)
    print(t.a + t.b)
}
