// inline_chamador_gigante: `main` com 130 chamadas em linha reta (cada inline cresce ~14 instrucoes: passa de 1024) e um laco DEPOIS.
// Depois do teto ORC_CHAMADOR_LIVRE so entra sitio dentro de laco: as chamadas retas finais saem com `inline recusa fj_passo: orcamento` (56) e a do laco entra (74 retas + 1 do laco; --debug-code otim).
// Saida esperada: 2108199360050146663
proc passo(a: int) -> int {
    let t1 = wrapping_add(a, 7)
    let t2 = wrapping_mul(t1, 3)
    let t3 = wrapping_sub(t2, a)
    let t4 = wrapping_add(t3, t1)
    let t5 = wrapping_mul(t4, 5)
    return wrapping_sub(t5, t2)
}

