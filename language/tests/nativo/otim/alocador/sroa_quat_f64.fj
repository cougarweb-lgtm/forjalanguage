// sroa_quat_f64: struct de 4 campos f64 (32 B, nome de quaternion; o quat embutido e f32) atualizada por campo num laco e copiada por valor para um parametro.
struct Quat64 {
    x: f64 = 0.0
    y: f64 = 0.0
    z: f64 = 0.0
    w: f64 = 1.0
}

proc girar(q: Quat64, k: f64) -> Quat64 {
    return Quat64{x = q.x + k, y = q.y - k * 0.5, z = q.z * 0.5, w = q.w + q.x * 0.25}
}

proc main() {
    var q = Quat64{}
    for i in 0..<12 {
        q = girar(q, (i as f64) * 0.125)
        q.w = q.w * 0.75
    }
    print((q.x * 1000.0) as int)
    print((q.y * 1000.0) as int)
    print((q.z * 1000.0) as int)
    print((q.w * 1000.0) as int)
}
