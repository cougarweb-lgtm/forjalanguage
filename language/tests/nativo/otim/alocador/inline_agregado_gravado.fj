// inline_agregado_gravado: a folha grava numa copia local do parametro agregado `c` (parametro e imutavel na Forja)
// e so le `r`. Por valor: o chamador nunca ve a mudanca. Saida esperada: por volta 43 5 7; no fim 178.
struct Caixa {
    v: int = 0
    w: int = 0
}

proc escreve_e_le(c: Caixa, r: Caixa) -> int {
    var d = c
    d.v = d.v + r.v
    d.w = d.w + 1
    return d.v * 2 + d.w + c.v
}

proc main() {
    let caixa = Caixa{v = 5, w = 7}
    let raio = Caixa{v = 10, w = 0}
    var acc = 0
    for i in 0..<4 {
        let r = escreve_e_le(caixa, raio)
        acc += r + i
        print(r)
        print(caixa.v)
        print(caixa.w)
    }
    print(acc)
}
