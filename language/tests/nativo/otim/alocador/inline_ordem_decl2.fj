// inline_ordem_decl2: ordem de declaracao 2 (chamador, funcao que chama a folha, folha). `main` e declarada ANTES de `mistura`: quando `main` e examinada `mistura` ainda tem
// CHAMA (nao e folha) e nao entra; `mistura` absorve `dobra` e `soma_um` depois. Mesmo programa de inline_ordem_decl.fj, outra ordem. Saida esperada: 2097130 e 11 (uma linha cada)
proc main() {
    var acc = 0
    for i in 0..<20 {
        acc = mistura(acc, i)
    }
    print(acc)
    print(mistura(3, 4))
}

proc mistura(x: int, y: int) -> int {
    return wrapping_add(dobra(x), soma_um(y))
}

proc soma_um(a: int) -> int {
    return wrapping_add(a, 1)
}

proc dobra(a: int) -> int {
    return wrapping_mul(a, 2)
}
