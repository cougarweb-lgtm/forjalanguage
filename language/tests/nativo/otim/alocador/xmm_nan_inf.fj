// M7a F4 stress do alocador: x/0, 0/0, infinito e NaN dentro de variaveis que moram em xmm, lidos por comparacao (a ordem dos operandos e o NaN tem de ficar igual).
proc classe64(x: f64) {
    print(x == x)
    print(x != x)
    print(x > 1000000000000000000.0)
    print(x < -1000000000000000000.0)
    print(x >= 0.0)
    print(x <= 0.0)
}

proc classe32(x: f32) {
    print(x == x)
    print(x != x)
    print(x > 1000000000000000000.0)
    print(x < -1000000000000000000.0)
    print(x >= 0.0)
    print(x <= 0.0)
}

proc laco(n: int) -> int {
    let z: f64 = 0.0
    var u: f64 = 1.0
    var nan: f64 = z / z
    var inf: f64 = u / z
    let z32: f32 = 0.0
    let nan32: f32 = z32 / z32
    var conta: int = 0
    for i in 0..<n {
        if nan == nan {
            conta = conta + 1
        }
        if nan != nan {
            conta = conta + 2
        }
        if inf > u {
            conta = conta + 4
        }
        if -inf < u {
            conta = conta + 8
        }
        if nan32 >= z32 {
            conta = conta + 16
        }
        if nan < inf {
            conta = conta + 32
        }
        inf = inf + u
        nan = nan + inf
        u = -u
    }
    return conta
}

proc main() {
    let z: f64 = 0.0
    let u: f64 = 1.0
    classe64(u / z)
    classe64(-u / z)
    classe64(z / z)
    classe64((u / z) - (u / z))
    let y: f32 = 0.0
    classe32(1.0 / y)
    classe32(y / y)
    classe32(-(1.0 / y))
    classe32(-y)
    print(laco(10))
}
