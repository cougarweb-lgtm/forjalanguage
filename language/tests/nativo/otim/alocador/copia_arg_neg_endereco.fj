// M7a passe `copia_arg` (negativa): f(x, &x) com o chamado gravando por p. O parametro por valor tem de ser a copia de antes da gravacao; x escapou (&x), entao a copia fica.
struct Caixa {
    v: int = 0
    w: int = 0
}

proc mexe(a: Caixa, p: ^Caixa) -> int {
    p.v = 99
    p.w = a.v + 1
    return a.v * 1000 + a.w
}

proc main() {
    var x = Caixa{v = 5, w = 6}
    var soma = 0
    for i in 0..<4 {
        x.v = 5 + i
        soma = soma + mexe(x, &x)
        print(x.v)
        print(x.w)
    }
    print(soma)
}
