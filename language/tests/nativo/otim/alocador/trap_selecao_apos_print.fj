// R5: braço com print (chamada) e com indice que estoura: NAO vira SELECIONA; com --checagem sim imprime a sequencia e para com R0006 (exit 101) DEPOIS dos prints, igual a --sem-otim selecao.
proc escolhe(v: []int, i: int, limite: int) -> int {
    var r = 0
    if i < limite {
        print(i)
        r = v[i]
    } else {
        r = limite
    }
    return r
}

proc main() {
    var a: [6]int = {}
    for k in 0..<6 {
        a[k] = k * 7
    }
    var acc = 0
    for i in 0..<9 {
        acc = acc + escolhe(a[..], i, 8)
    }
    print(acc)
}
