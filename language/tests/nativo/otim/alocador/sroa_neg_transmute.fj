// sroa_neg_transmute: f32 gravado num struct local e lido como u32 PELA MEMORIA (memcpy dos 4 primeiros bytes de Par.a para um u32) -> classe; o slot e mantido (sroa recusa ... classe).
// Nota: a Forja nao tem cast de ponteiro (`as ^T` = E0306; `to = ^T` no transmute = E0101), entao a leitura por memoria passa por foreign; o &s e o &bits viram endereco (escapa tambem pode aparecer).
struct Par {
    a: f32 = 0.0
    b: int = 0
}

foreign {
    link "msvcrt"
    proc c_copia = "memcpy"(dst: ^u32, src: ^Par, n: int) -> rawptr
}

proc main() {
    var s = Par{a = 1.5, b = 2}
    var bits: u32 = 0
    _ = c_copia(&bits, &s, 4)
    print(bits as int)
    s.b = s.b + 1
    print(s.b)
}
