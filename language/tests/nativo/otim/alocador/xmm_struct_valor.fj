// M7a F4 stress do alocador: struct com campos real passada e devolvida por valor em laco (os campos passam pela memoria; os reais soltos vivem em xmm).
struct Vec2 {
    x: f64 = 0.0
    y: f64 = 0.0
}

struct Par32 {
    a: f32 = 0.0
    b: f32 = 0.0
}

proc somar(a: Vec2, b: Vec2) -> Vec2 {
    return Vec2{x = a.x + b.x, y = a.y + b.y}
}

proc escalar(v: Vec2, k: f64) -> Vec2 {
    return Vec2{x = v.x * k, y = v.y * k}
}

proc troca(p: Par32) -> Par32 {
    return Par32{a = p.b * 0.5, b = p.a + 1.0}
}

proc varre(n: int) -> f64 {
    var p = Vec2{x = 1.0, y = 2.0}
    var q = Par32{a = 3.0, b = 4.0}
    var soma: f64 = 0.0
    var folga: f64 = 0.5
    for i in 0..<n {
        p = escalar(somar(p, Vec2{x = folga, y = (i % 4) as f64}), 0.5)
        q = troca(q)
        folga = folga * 0.99 + (q.a as f64) * 0.01
        soma = soma + p.x + p.y + (q.a as f64) + (q.b as f64) + folga
    }
    return soma
}

proc main() {
    print((varre(60) * 1000.0) as int)
    print((varre(1) * 1000.0) as int)
}
