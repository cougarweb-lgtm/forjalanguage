// inline_quadro_grande: chamador com array local de 1200 int (9600 bytes, > 4 KiB) no quadro, que chama folha dentro do laco
// e le o array depois. Saida esperada: 1 / 9601 / 19201 / 28801 / 23022001 / 38369.
proc mistura(a: int, b: int) -> int {
    return wrapping_add(wrapping_mul(a, 31), b)
}

proc main() {
    var grande: [1200]int = {}
    var acc = 1
    for i in 0..<1200 {
        grande[i] = mistura(i, i + 1)
        acc = wrapping_add(acc, grande[i])
    }
    for i in 0..<1200 {
        if i % 300 == 0 {
            print(grande[i])
        }
    }
    print(acc)
    print(grande[1199])
}
