// numeracao_divisao_guarda: a / b e a % b repetidos com divisor variavel (guarda b == 0 do construtor) e divisor zero em algumas voltas (resultado 0); a divisao dentro do if
// nao pode ser reaproveitada fora dele, onde o divisor pode ser 0 e a guarda leva a outro bloco.
proc main() {
    var soma = 0
    for i in 0..<12 {
        let d = i % 4
        let q = 100 / d
        let r = 100 % d
        let q2 = 100 / d
        soma = soma + q * 3 + r + q2
        if d > 1 {
            soma = soma + 1000 / d
        }
        soma = soma + 1000 / d
    }
    print(soma)
}
