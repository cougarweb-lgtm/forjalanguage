// inline_recursao_fib: fib recursivo curto (so chama a si mesmo): o passe clona o corpo 1 nivel em cada chamada recursiva.
// Saida esperada: fib(0) a fib(24) uma linha cada (0 1 1 2 3 5 8 13 ... 46368) e 75025 (fib(25)).
proc fib(n: int) -> int {
    if n < 2 {
        return n
    }
    return fib(n - 1) + fib(n - 2)
}

proc main() {
    for i in 0..<25 {
        print(fib(i))
    }
    print(fib(25))
}
