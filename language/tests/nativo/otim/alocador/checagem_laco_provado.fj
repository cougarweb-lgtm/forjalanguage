// M7a F6 passe `checagem`: indices que o laco contado prova (limite constante <= capacidade): 0..<N em [N], inicio > 0, laco aninhado e a copia do usuario do contador;
// um segundo laco com limite maior que a capacidade nao e tocado, mas o programa termina antes de estourar (break). Saida igual com e sem o passe e com o backend C.
proc main() {
    var a: [16]int = {}
    var b: [8]int = {}
    var m: [4]int = {}
    var soma = 0
    for i in 0..<16 {
        a[i] = i * i
    }
    for i in 2..<8 {
        b[i] = a[i] + a[i + 1 - 1]
        for j in 0..<4 {
            m[j] = m[j] + b[i] + j
        }
    }
    for i in 0..<100 {
        if i == 8 {
            break
        }
        soma = soma + b[i] + m[i % 4]
    }
    for i in 0..<16 {
        soma = soma + a[i]
    }
    print(soma)
    print(m[0] + m[3])
}
