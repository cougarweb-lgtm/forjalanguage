// M7a F4 stress do alocador: foreign com reais (alvo linux = SysV: nenhum xmm callee-saved sobrevive a chamada) em laco, com f64 e f32 vivos atraves dela.
foreign {
    link "m"
    proc pow(x: f64, y: f64) -> f64
    proc floor(x: f64) -> f64
    proc ceil(x: f64) -> f64
}

proc varre(n: int) -> f64 {
    var a: f64 = 1.0
    var b: f64 = 2.0
    var c: f32 = 3.0
    var d: f32 = 4.0
    var soma: f64 = 0.0
    for i in 0..<n {
        let p = pow(1.5, y = (i % 5) as f64)
        a = a * 0.5 + p + floor(b * 0.5)
        b = b * 0.75 + ceil(a) * 0.1
        c = c * 0.5 + (p as f32) * 0.25
        d = d * 0.5 + c * 0.125
        soma = soma + a + b + (c as f64) + (d as f64)
    }
    return soma
}

proc main() {
    print((varre(40) * 1000.0) as int)
    print((varre(1) * 1000.0) as int)
}
