// M7a F3 stress do alocador: foreign em laco com inteiros vivos atraves da chamada (no alvo linux e a ABI SysV: rsi/rdi nao podem guardar vreg nessa funcao).
foreign {
    link "m"
    proc pow(x: f64, y: f64) -> f64
    proc floor(x: f64) -> f64
}

proc varre(n: int) -> int {
    var a = 1
    var b = 2
    var c = 3
    var d = 4
    var e = 5
    var f = 6
    var soma = 0
    for i in 0..<n {
        let p = pow(2.0, y = (i % 10) as f64) as int
        a = (a + p + i) % 10007
        b = (b * 3 + a) % 10007
        c = (c + b + floor(3.7) as int) % 10007
        d = (d + c) % 10007
        e = (e + d + a) % 10007
        f = (f + e + b) % 10007
        soma = soma + a + b + c + d + e + f
    }
    return soma
}

proc main() {
    print(varre(50))
    print(varre(1))
}
