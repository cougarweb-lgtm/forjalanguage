// R6a: a divisao por divisor invariante (com a guarda de zero e de MIN / -1 em blocos proprios) NAO sobe; divisor 0 e -1 tambem conferem. stdout igual a --sem-otim licm e ao backend C.
proc divide(n: int, num: int, d: int) -> int {
    var acc = 0
    for i in 0..<n {
        let q = num / d
        let r = num % d
        acc = acc + q + r + i
    }
    return acc
}

proc main() {
    print(divide(5, 100, 7))
    print(divide(5, 100, 0))
    print(divide(5, -100, -1))
    print(divide(0, 100, 0))
}
