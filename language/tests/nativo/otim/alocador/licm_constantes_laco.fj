// R6a: conta pura invariante do laco (base e desl dependem so de k) sobe para o pre-cabecalho; stdout igual a --sem-otim licm e ao backend C. Laco que roda 0 vezes tambem confere.
proc soma(n: int, k: int) -> int {
    var acc = 0
    for i in 0..<n {
        let base = k * 3 + 7
        let desl = base * 11 - k
        acc = acc + i * desl
    }
    return acc
}

proc mascara(n: int, k: u32) -> u32 {
    var acc: u32 = 0
    for i in 0..<n {
        let m = (k & 255) ~ 90
        acc = acc + m + (i as u32)
    }
    return acc
}

proc main() {
    print(soma(10, 4))
    print(soma(0, 4))
    print(soma(1, -9))
    print(mascara(7, 1234) as int)
    print(mascara(0, 1234) as int)
}
