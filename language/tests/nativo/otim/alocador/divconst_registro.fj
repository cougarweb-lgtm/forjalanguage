// M7b F1: divisao e resto por constante com o dst no MESMO registrador do dividendo (x = x / 7), com dividendo e resultado no slot (muitas variaveis vivas), em laco e com i8/i16/i32/u32 estendidos depois (o resultado sai zero-estendido).
proc mesmo_registro(a: int, b: i32, c: u32, d: u16, e: i8) -> int {
    var x = a
    var y = b
    var z = c
    var w = d
    var v = e
    var acc = 0
    for i in 0..<400 {
        x = x / 7 + i * 1000003 - x % 13
        y = y / 5 + (i as i32) * 77 - y % 11
        z = wrapping_add(z / 3, b = wrapping_mul(z % 10, b = 2654435761))
        w = wrapping_add(w / 3, b = wrapping_mul(w % 10, b = 40503))
        v = wrapping_add(v / -3, b = (i as i8))
        acc = acc + x % 1000 + (y as int) + (z as int) % 977 + (w as int) + (v as int)
        x = x / 3
        y = y / -9
        z = z / 10
        w = w / 100
        v = v / 2
    }
    return acc
}

proc pressao(s: u32) -> u32 {
    var a: u32 = s + 1
    var b: u32 = s + 2
    var c: u32 = s + 3
    var d: u32 = s + 4
    var e: u32 = s + 5
    var f: u32 = s + 6
    var g: u32 = s + 7
    var h: u32 = s + 8
    var i: u32 = s + 9
    var j: u32 = s + 10
    var k: u32 = s + 11
    var l: u32 = s + 12
    var m: u32 = s + 13
    var n: u32 = s + 14
    for t in 0..<100 {
        a = wrapping_add(a / 7, b = wrapping_mul(n, b = 2654435761))
        b = wrapping_add(b / 9, b = a % 100)
        c = wrapping_add(c / 11, b = b % 100)
        d = wrapping_add(d / 13, b = c % 100)
        e = wrapping_add(e / 17, b = d % 100)
        f = wrapping_add(f / 19, b = e % 100)
        g = wrapping_add(g / 23, b = f % 100)
        h = wrapping_add(h / 29, b = g % 100)
        i = wrapping_add(i / 31, b = h % 100)
        j = wrapping_add(j / 37, b = i % 100)
        k = wrapping_add(k / 41, b = j % 100)
        l = wrapping_add(l / 43, b = k % 100)
        m = wrapping_add(m / 47, b = l % 100)
        n = wrapping_add(wrapping_mul(n, b = 1664525), b = m % 53 + (t as u32))
        a = wrapping_add(a, b = n / 1000003)
    }
    return wrapping_add(wrapping_add(a, b = b), b = wrapping_add(c ~ d ~ e ~ f, b = g ~ h ~ i ~ j ~ k ~ l ~ m ~ n))
}

proc pressao_i64(s: int) -> int {
    var a = s + 1
    var b = s + 2
    var c = s + 3
    var d = s + 4
    var e = s + 5
    var f = s + 6
    var g = s + 7
    var h = s + 8
    var i = s + 9
    var j = s + 10
    var k = s + 11
    var l = s + 12
    var m = s + 13
    for t in 0..<100 {
        a = a / 7 + m * 3
        b = b / -9 + a % 100
        c = c / 11 + b % 100
        d = d / 13 + c % 100
        e = e / 17 + d % 100
        f = f / 19 + e % 100
        g = g / 23 + f % 100
        h = h / 29 + g % 100
        i = i / 31 + h % 100
        j = j / 37 + i % 100
        k = k / 41 + j % 100
        l = l / 43 + k % 100
        m = (m / 47 + l % 100 + t) % 1000000007
    }
    return a + b + c + d + e + f + g + h + i + j + k + l + m
}

proc main() {
    print(mesmo_registro(123456789, b = -987654, c = 4000000000, d = 65000, e = -100))
    print(mesmo_registro(-5, b = 2147483647, c = 7, d = 3, e = 127))
    print(pressao(1))
    print(pressao(4000000000))
    print(pressao_i64(1))
    print(pressao_i64(-123456789012))
}
