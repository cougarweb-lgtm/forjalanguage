// S3 (slp): soma, subtracao, produto e divisao de Vec4 f32 elemento a elemento, em laco (valores de tempo de execucao). Cada grupo de 4 gravacoes contiguas vira carga vetorial + conta vetorial + gravacao vetorial; saida igual a --sem-otim slp (bits exatos).
struct Vec4 {
    x: f32 = 0.0
    y: f32 = 0.0
    z: f32 = 0.0
    w: f32 = 0.0
    enchimento: [14]f32 // enchimento: o slot passa de 64 B, o sroa o recusa (tamanho) e o slp o vetoriza; ate 64 B o sroa o escalariza e o slp recusa: slot_escalarizavel
}

proc bits(v: f32) -> int {
    return transmute(v, to = u32) as int
}

proc main() {
    for i in 0..<5 {
        let f = i as f32
        let a = Vec4{x = f + 1.5, y = f * 2.25, z = f - 3.0, w = 0.5 + f}
        let b = Vec4{x = 0.25 + f, y = f + 0.125, z = 7.0 - f, w = f * 3.0 + 1.0}
        var s = Vec4{}
        var d = Vec4{}
        var m = Vec4{}
        var q = Vec4{}
        s.x = a.x + b.x
        s.y = a.y + b.y
        s.z = a.z + b.z
        s.w = a.w + b.w
        d.x = a.x - b.x
        d.y = a.y - b.y
        d.z = a.z - b.z
        d.w = a.w - b.w
        m.x = a.x * b.x
        m.y = a.y * b.y
        m.z = a.z * b.z
        m.w = a.w * b.w
        q.x = a.x / b.x
        q.y = a.y / b.y
        q.z = a.z / b.z
        q.w = a.w / b.w
        print(bits(s.x) + bits(s.y) + bits(s.z) + bits(s.w))
        print(bits(d.x) + bits(d.y) + bits(d.z) + bits(d.w))
        print(bits(m.x) + bits(m.y) + bits(m.z) + bits(m.w))
        print(bits(q.x) + bits(q.y) + bits(q.z) + bits(q.w))
        print(bits(q.x))
        print(bits(m.w))
    }
}
