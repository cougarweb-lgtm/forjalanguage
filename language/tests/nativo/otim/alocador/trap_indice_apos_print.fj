// M7a F3 stress do alocador: R0006 exato (indice fora) no meio de um laco, DEPOIS do print da mesma volta; com --checagem sim o programa imprime 0..8 e para com exit 101.
// Os valores vivos (acumuladores) cruzam o trap: o bloco frio le os operandos sem o alocador os ter tocado.
proc main() {
    var a: [8]int = {}
    var acc = 0
    var outro = 7
    var i = 0
    while i < 20 {
        print(i)
        outro = outro * 3 + acc
        a[i] = i * 2 + outro % 5
        acc = acc + a[i]
        i = i + 1
    }
    print(acc)
}
