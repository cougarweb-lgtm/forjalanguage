// M7a F3 stress do alocador: 18 inteiros vivos ao mesmo tempo (mais que os 10 registradores), em laco, com spill do intervalo inteiro.
proc mistura(n: int) -> int {
    var a = 1
    var b = 2
    var c = 3
    var d = 4
    var e = 5
    var f = 6
    var g = 7
    var h = 8
    var i2 = 9
    var j = 10
    var k = 11
    var l = 12
    var m = 13
    var o = 14
    var p = 15
    var q = 16
    var r = 17
    var s = 18
    for i in 0..<n {
        a = (a + i) % 1000003
        b = (b * 3 + a) % 1000003
        c = (c + b - a + 1000003) % 1000003
        d = (d * 5 + c) % 1000003
        e = (e + d) % 1000003
        f = (f + e * 2) % 1000003
        g = (g + f - e + 1000003) % 1000003
        h = (h * 7 + g) % 1000003
        i2 = (i2 + h) % 1000003
        j = (j + i2 + a) % 1000003
        k = (k + j - b + 1000003) % 1000003
        l = (l + k + c) % 1000003
        m = (m * 3 + l) % 1000003
        o = (o + m + d) % 1000003
        p = (p + o - e + 1000003) % 1000003
        q = (q + p + f) % 1000003
        r = (r * 11 + q) % 1000003
        s = (s + r + g) % 1000003
    }
    return a + b + c + d + e + f + g + h + i2 + j + k + l + m + o + p + q + r + s
}

proc main() {
    print(mistura(300))
    print(mistura(7))
    print(mistura(0))
}
