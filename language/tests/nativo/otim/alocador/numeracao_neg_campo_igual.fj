// numeracao_neg_campo_igual: campo a do elemento i lido, MESMO campo a do elemento j gravado (j pode ser igual a i), campo a do elemento i lido de novo: as faixas podem se sobrepor, a
// gravacao mata a carga e a 2a leitura tem de ver o valor novo quando j = i (volta do meio, i = 3 e 4 nao: j = 7 - i; sem coincidencia a saida e a mesma de qualquer jeito).
struct Par {
    a: int = 0
    b: int = 0
}

proc main() {
    var v: [8]Par = {}
    for i in 0..<8 {
        v[i].a = i + 1
        v[i].b = i + 100
    }
    var soma = 0
    for i in 0..<8 {
        let j = i % 3 + i / 3
        let antes = v[i].a
        v[j].a = antes + 1
        let depois = v[i].a
        soma = soma + antes * 3 + depois * 7
    }
    print(soma)
    print(v[3].a + v[3].b)
}
