// sroa_struct_local: struct local de 2 campos int, so usada por campo dentro de laco; nao escapa. Positiva: o passe sroa escalariza p.
struct Par {
    a: int = 0
    b: int = 0
}

proc main() {
    var p = Par{a = 1, b = 2}
    for i in 0..<20 {
        p.a = (p.a + i * 3) % 1000
        p.b = (p.b + p.a) % 1000
    }
    print(p.a)
    print(p.b)
}
