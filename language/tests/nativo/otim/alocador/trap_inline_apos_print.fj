// inline_trap_apos_print: dentro da folha `folha`, divisao por variavel (d vira 0 em k == 2, e da 0 sem trap)
// e depois indice fora (a[i] com i == 4, R0006). O trap sai na linha `return q + a[i]` da folha, DEPOIS do print(k)
// da mesma volta do chamador. Saida esperada: 0 60 1 120 2 30 3 -60 4 e sai com exit 101 (R0006).
proc folha(n: int, d: int, a: [4]int, i: int) -> int {
    let q = n / d
    return q + a[i]
}

proc main() {
    let v: [4]int = {10, 20, 30, 40}
    var d = 2
    var k = 0
    while k < 6 {
        print(k)
        print(folha(100, d, v, k))
        d = d - 1
        k = k + 1
    }
    print(k)
}
