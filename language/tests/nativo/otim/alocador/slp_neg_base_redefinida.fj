// S4 (slp, negativa): o ponteiro de base das cargas e redefinido entre as cargas e a ultima conta; a carga vetorial leria da base nova, recusa (valor_redefinido); saida igual a --sem-otim slp.
proc bits(v: f32) -> int {
    return transmute(v, to = u32) as int
}

proc escala(s: ^[8]f32, o: ^[8]f32, d: ^[8]f32) {
    var q: ^[8]f32 = s
    let a0 = q^[0]
    let a1 = q^[1]
    let a2 = q^[2]
    let a3 = q^[3]
    q = o
    d^[0] = a0 * 3.0
    d^[1] = a1 * 3.0
    d^[2] = a2 * 3.0
    d^[3] = a3 * 3.0
    print(bits(q^[0]))
}

proc main() {
    var s: [8]f32 = {}
    var o: [8]f32 = {}
    var d: [8]f32 = {}
    for i in 0..<8 {
        s[i] = (i + 1) as f32
        o[i] = (i + 100) as f32
    }
    escala(&s, &o, &d)
    for j in 0..<8 {
        print(bits(d[j]))
    }
}
