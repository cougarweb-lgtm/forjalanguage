// sroa_neg_retorno_nao_inline: agregado devolvido por proc recursivo (nao inlinavel) -> o slot que recebe o retorno e mantido (sroa recusa ... classe ou grupo, conforme o passe).
struct Par {
    a: int = 0
    b: int = 0
}

proc construir(n: int) -> Par {
    if n == 0 {
        return Par{a = 1, b = 2}
    }
    let r = construir(n - 1)
    return Par{a = r.a + n, b = r.b * 2 % 1000}
}

proc main() {
    var p = construir(4)
    for i in 0..<3 {
        p.a = p.a + i
    }
    print(p.a)
    print(p.b)
}
