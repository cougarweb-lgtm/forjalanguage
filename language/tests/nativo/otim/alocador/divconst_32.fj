// M7b F1: divisao e resto por constante em i32 e u32 (SINAL_MUL com imul de 64 bits, LEMIRE com mul de 64 bits, MIN, potencias de 2, 516..519) sobre valores extremos e uma sequencia congruencial.
proc mix(h: u64, v: u64) -> u64 {
    return wrapping_add(wrapping_mul(h, b = 1099511628211), b = v)
}

proc hash_i32(x: i32, h0: u64) -> u64 {
    var h = h0
    h = mix(mix(h, (x / 1) as u64), (x % 1) as u64)
    h = mix(mix(h, (x / 2) as u64), (x % 2) as u64)
    h = mix(mix(h, (x / 3) as u64), (x % 3) as u64)
    h = mix(mix(h, (x / 5) as u64), (x % 5) as u64)
    h = mix(mix(h, (x / 6) as u64), (x % 6) as u64)
    h = mix(mix(h, (x / 7) as u64), (x % 7) as u64)
    h = mix(mix(h, (x / 9) as u64), (x % 9) as u64)
    h = mix(mix(h, (x / 10) as u64), (x % 10) as u64)
    h = mix(mix(h, (x / 11) as u64), (x % 11) as u64)
    h = mix(mix(h, (x / 12) as u64), (x % 12) as u64)
    h = mix(mix(h, (x / 25) as u64), (x % 25) as u64)
    h = mix(mix(h, (x / 60) as u64), (x % 60) as u64)
    h = mix(mix(h, (x / 100) as u64), (x % 100) as u64)
    h = mix(mix(h, (x / 641) as u64), (x % 641) as u64)
    h = mix(mix(h, (x / 1000) as u64), (x % 1000) as u64)
    h = mix(mix(h, (x / 65537) as u64), (x % 65537) as u64)
    h = mix(mix(h, (x / 1000000007) as u64), (x % 1000000007) as u64)
    h = mix(mix(h, (x / 2147483647) as u64), (x % 2147483647) as u64)
    h = mix(mix(h, (x / 1024) as u64), (x % 1024) as u64)
    h = mix(mix(h, (x / 1073741824) as u64), (x % 1073741824) as u64)
    h = mix(mix(h, (x / 516) as u64), (x % 516) as u64)
    h = mix(mix(h, (x / 517) as u64), (x % 517) as u64)
    h = mix(mix(h, (x / 518) as u64), (x % 518) as u64)
    h = mix(mix(h, (x / 519) as u64), (x % 519) as u64)
    h = mix(mix(h, (x / -2) as u64), (x % -2) as u64)
    h = mix(mix(h, (x / -3) as u64), (x % -3) as u64)
    h = mix(mix(h, (x / -7) as u64), (x % -7) as u64)
    h = mix(mix(h, (x / -10) as u64), (x % -10) as u64)
    h = mix(mix(h, (x / -1000) as u64), (x % -1000) as u64)
    h = mix(mix(h, (x / -516) as u64), (x % -516) as u64)
    h = mix(mix(h, (x / -1024) as u64), (x % -1024) as u64)
    h = mix(mix(h, (x / -2147483647) as u64), (x % -2147483647) as u64)
    h = mix(mix(h, (x / -2147483648) as u64), (x % -2147483648) as u64)
    return h
}

proc hash_u32(x: u32, h0: u64) -> u64 {
    var h = h0
    h = mix(mix(h, (x / 1) as u64), (x % 1) as u64)
    h = mix(mix(h, (x / 2) as u64), (x % 2) as u64)
    h = mix(mix(h, (x / 3) as u64), (x % 3) as u64)
    h = mix(mix(h, (x / 5) as u64), (x % 5) as u64)
    h = mix(mix(h, (x / 6) as u64), (x % 6) as u64)
    h = mix(mix(h, (x / 7) as u64), (x % 7) as u64)
    h = mix(mix(h, (x / 9) as u64), (x % 9) as u64)
    h = mix(mix(h, (x / 10) as u64), (x % 10) as u64)
    h = mix(mix(h, (x / 11) as u64), (x % 11) as u64)
    h = mix(mix(h, (x / 12) as u64), (x % 12) as u64)
    h = mix(mix(h, (x / 25) as u64), (x % 25) as u64)
    h = mix(mix(h, (x / 60) as u64), (x % 60) as u64)
    h = mix(mix(h, (x / 100) as u64), (x % 100) as u64)
    h = mix(mix(h, (x / 641) as u64), (x % 641) as u64)
    h = mix(mix(h, (x / 1000) as u64), (x % 1000) as u64)
    h = mix(mix(h, (x / 65537) as u64), (x % 65537) as u64)
    h = mix(mix(h, (x / 1000000007) as u64), (x % 1000000007) as u64)
    h = mix(mix(h, (x / 2147483647) as u64), (x % 2147483647) as u64)
    h = mix(mix(h, (x / 2147483648) as u64), (x % 2147483648) as u64)
    h = mix(mix(h, (x / 2147483649) as u64), (x % 2147483649) as u64)
    h = mix(mix(h, (x / 4294967295) as u64), (x % 4294967295) as u64)
    h = mix(mix(h, (x / 4) as u64), (x % 4) as u64)
    h = mix(mix(h, (x / 516) as u64), (x % 516) as u64)
    h = mix(mix(h, (x / 517) as u64), (x % 517) as u64)
    h = mix(mix(h, (x / 518) as u64), (x % 518) as u64)
    h = mix(mix(h, (x / 519) as u64), (x % 519) as u64)
    return h
}

proc main() {
    var h: u64 = 14695981039346656037
    let bordas: [12]u32 = {0, 1, 2, 3, 7, 2147483647, 2147483648, 2147483649, 4294967294, 4294967295, 516, 1000000007}
    for i in 0..<12 {
        h = hash_u32(bordas[i], h0 = h)
        h = hash_i32(bordas[i] as i32, h0 = h)
        h = hash_i32(wrapping_sub(0 as u32, b = bordas[i]) as i32, h0 = h)
    }
    print(h)
    var x: u32 = 123456789
    for i in 0..<30000 {
        x = wrapping_add(wrapping_mul(x, b = 1664525), b = 1013904223)
        h = hash_u32(x, h0 = h)
        h = hash_i32(x as i32, h0 = h)
    }
    print(h)
}
