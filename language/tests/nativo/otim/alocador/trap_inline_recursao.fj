// trap_inline_recursao: recursao direta curta (sem print: o clone so entra se a funcao so chama a si mesma) que estoura R0006 (indice fora) em v[n - 1] com n = 0,
// depois de 6 niveis; o rastreio e a mensagem tem de ser os de --sem-otim inline. Com --checagem sim: nada na saida e R0006 (exit 101).
proc desce(v: []int, n: int) -> int {
    if n < 0 {
        return 0
    }
    return v[n] + desce(v, n - 1) + v[n - 1]
}

proc main() {
    var a: [6]int = {}
    for k in 0..<6 {
        a[k] = k
    }
    print(desce(a[..], 5))
}
