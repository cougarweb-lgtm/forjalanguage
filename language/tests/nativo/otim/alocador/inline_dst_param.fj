// inline_dst_param: destino igual a parametro. x = somar(x, i) escalar e p = somar_vec(p, q) agregado (struct).
// Saida esperada: por volta x, p.x, p.y (1 3 -2 / 2 6 -4 / 4 9 -6 / 7 12 -8 / 11 15 -10); no fim 23.
struct Ponto {
    x: int = 0
    y: int = 0
}

proc somar(a: int, b: int) -> int {
    return wrapping_add(a, b)
}

proc somar_vec(a: Ponto, b: Ponto) -> Ponto {
    return Ponto{x = a.x + b.x, y = a.y + b.y}
}

proc main() {
    var x = 1
    var p = Ponto{x = 0, y = 0}
    let q = Ponto{x = 3, y = -2}
    for i in 0..<5 {
        x = somar(x, i)
        p = somar_vec(p, q)
        print(x)
        print(p.x)
        print(p.y)
    }
    print(somar(x, somar(x, 1)))
}
