// S3 (slp): grupo de 4 gravacoes vetorizavel, depois print e um indice dinamico fora do limite (R0006 com --checagem sim): a saida impressa antes do trap e a pilha de rastreio sao as mesmas de --sem-otim slp.
proc bits(v: f32) -> int {
    return transmute(v, to = u32) as int
}

proc pega(v: []f32, k: int) -> f32 {
    return v[k]
}

proc main() {
    var acc = 0
    for i in 0..<8 {
        let f = i as f32
        let a: [4]f32 = {f, f + 1.0, f + 2.0, f + 3.0}
        let b: [4]f32 = {2.0, 3.0, 4.0, 5.0}
        var r: [4]f32 = {}
        r[0] = a[0] * b[0]
        r[1] = a[1] * b[1]
        r[2] = a[2] * b[2]
        r[3] = a[3] * b[3]
        print(bits(r[0]) + bits(r[1]) + bits(r[2]) + bits(r[3]))
        acc = acc + bits(pega(r[..], i))
    }
    print(acc)
}
