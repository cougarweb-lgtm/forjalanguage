// S3 (slp, negativa): cada lane f32 sai de uma conta em f64 convertida de volta (F_PARA_F entre a conta e a gravacao): conversao nao e coberta; saida igual a --sem-otim slp.
proc bits(v: f32) -> int {
    return transmute(v, to = u32) as int
}

proc main() {
    for i in 0..<4 {
        let f = i as f64
        let a: [4]f64 = {f + 0.1, f + 1.1, f + 2.1, f + 3.1}
        let b: [4]f64 = {2.5, 3.5, 4.5, 5.5}
        var r: [4]f32 = {}
        r[0] = (a[0] * b[0]) as f32
        r[1] = (a[1] * b[1]) as f32
        r[2] = (a[2] * b[2]) as f32
        r[3] = (a[3] * b[3]) as f32
        print(bits(r[0]) + bits(r[1]) + bits(r[2]) + bits(r[3]))
    }
}
