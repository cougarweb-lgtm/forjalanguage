// numeracao_neg_ramos: a conta (n * 7 + k) calculada so no ramo "then" nao vale no ramo "else" nem depois do if (o ramo nao domina a juncao); n e k mudam por volta e a mesma conta aparece
// depois do if com valores de n diferentes por ramo. A saida tem de bater com o passe desligado.
proc main() {
    var soma = 0
    var n = 2
    for k in 0..<9 {
        if k % 3 == 0 {
            n = n + 5
            soma = soma + (n * 7 + k)
        } else if k % 3 == 1 {
            n = n * 2 % 17
        } else {
            soma = soma + (n * 7 + k) * 2
        }
        soma = soma + (n * 7 + k)
    }
    print(soma)
    print(n)
}
