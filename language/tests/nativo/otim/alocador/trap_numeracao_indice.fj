// trap_numeracao_indice: a mesma leitura a[i] e a mesma conta (i * 3 + 1) duas vezes por volta; na volta i = 8 o indice sai do array e o R0006 tem de aparecer exatamente na 1a leitura,
// DEPOIS do print da volta e com o mesmo stderr de antes. Com --checagem sim imprime 0..7 e para com exit 101. A 2a ocorrencia nunca pode virar a 1a (o trap nao anda).
proc main() {
    var a: [8]int = {}
    for k in 0..<8 {
        a[k] = k * 2 + 1
    }
    var acc = 0
    var i = 0
    while i < 12 {
        print(i)
        let p = i * 3 + 1
        acc = acc + a[i] + p
        acc = acc + a[i] + (i * 3 + 1)
        i = i + 1
    }
    print(acc)
}
