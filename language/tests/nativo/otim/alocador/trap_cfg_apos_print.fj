// M7b R4b: R0006 (indice fora) em laco com if/continue; com --checagem sim imprime 0..9 e para com exit 101 na volta 10, DEPOIS do print, igual a --sem-otim cfg,layout.
proc main() {
    var a: [10]int = {}
    for k in 0..<10 {
        a[k] = k * 3
    }
    var acc = 0
    var i = 0
    while i < 14 {
        print(i)
        if i % 4 == 0 {
            i = i + 1
            acc = acc + a[i - 1]
            continue
        }
        acc = acc + a[i]
        i = i + 1
    }
    print(acc)
}
