// numeracao_dupla_def: vreg com duas definicoes (x = 1, depois x = 5): o valor lembrado de x + 2 vale so ate a redefinicao; a 2a conta tem de dar 7, nao 3.
// E o contador do laco, que muda a cada volta, nunca faz uma conta antiga valer.
// espera: expr>0
proc main() {
    var x = 1
    let s = x + 2
    let s2 = x + 2
    x = 5
    let t = x + 2
    let t2 = x + 2
    var acumulado = 0
    var n = 3
    for i in 0..<6 {
        acumulado = acumulado + (n + 4) * (n + 4) + i
        n = n + i
    }
    print(s + s2 * 10 + t * 100 + t2 * 1000)
    print(acumulado)
    print(n)
}
