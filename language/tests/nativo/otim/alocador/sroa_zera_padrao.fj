// sroa_zera_padrao: struct com padroes; literal parcial (campos omitidos pegam o padrao), literal vazio e campos alterados em laco.
struct Cfg {
    passo: int = 3
    teto: int = 100
    ativo: bool = true
}

proc main() {
    var c = Cfg{teto = 50}
    var z = Cfg{}
    for i in 0..<8 {
        c.passo = c.passo + i
        if c.passo > c.teto {
            c.teto = c.teto + 1
        }
        z.passo = z.passo + 1
    }
    print(c.passo)
    print(c.teto)
    print(c.ativo)
    print(z.passo)
    print(z.teto)
}
