// R6a-3 (negativa): elemento de 12 bytes (3 x i32): a conta de endereco usa `i * 12`, escala fora de {1,2,4,8}; o passe nao recoloca e a saida tem de ser igual.
struct Tri {
    a: i32 = 0
    b: i32 = 0
    c: i32 = 0
}

proc soma(t: ^[40]Tri) -> int {
    var acc = 0
    for i in 0..<40 {
        t^[i].a = t^[i].b + (i as i32)
        t^[i].c = t^[i].a * 2
        acc = acc + (t^[i].c as int) + (t^[i].b as int)
    }
    return acc
}

proc main() {
    var t: [40]Tri = {}
    for i in 0..<40 {
        t[i].b = (i as i32) * 3
    }
    print(soma(&t))
    print(soma(&t))
}
