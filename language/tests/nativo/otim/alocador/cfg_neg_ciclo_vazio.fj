// M7b R4b negativa do passe cfg: laco infinito (while true) com blocos que so saltam e saida por break; a cadeia de blocos vazios nao pode se perder nem virar laco sem saida.
proc conta(limite: int) -> int {
    var n = 0
    while true {
        if n >= limite {
            break
        }
        if n % 5 == 0 {
        }
        n = n + 1
    }
    return n
}

proc espera(alvo: int) -> int {
    var k = 0
    while true {
        while true {
            k = k + 1
            if k > alvo {
                break
            }
        }
        if k > alvo {
            break
        }
    }
    return k
}

proc main() {
    print(conta(0))
    print(conta(17))
    print(espera(0))
    print(espera(9))
}
