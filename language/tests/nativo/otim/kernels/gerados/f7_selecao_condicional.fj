// f7_selecao_condicional.fj - kernel de micro-benchmark (M7b F0c, fatia F7: selecao condicional (cmov)).
// maximo e escolha por bit com ramo imprevisivel (candidatos a cmov)
// Gerado por gerar_kernels.py 1.0.0; nao editar a mao. Saida = checksum deterministico.

proc main() {
    var x: u32 = 2463534242
    var acc: int = 0
    for i in 0..<30000000 {
        x = x ~ (x << 13)
        x = x ~ (x >> 17)
        x = x ~ (x << 5)
        let a = (x & 65535) as int
        let b = (x >> 16) as int
        var r: int = a
        if b > r {
            r = b
        }
        var s: int = b
        if (x & 1) == 1 {
            s = a
        }
        acc = wrapping_add(acc, r - s)
    }
    print(acc)
}
