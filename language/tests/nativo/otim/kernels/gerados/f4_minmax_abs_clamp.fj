// f4_minmax_abs_clamp.fj - kernel de micro-benchmark (M7b F0c, fatia F4: min/max/abs/clamp e bits).
// min, max, abs e clamp sobre int (cmp+cmov); dividendo na faixa sem MIN
// Gerado por gerar_kernels.py 1.0.0; nao editar a mao. Saida = checksum deterministico.

proc main() {
    var x: u32 = 2463534242
    var acc: int = 0
    for i in 0..<35000000 {
        x = x ~ (x << 13)
        x = x ~ (x >> 17)
        x = x ~ (x << 5)
        let v = ((x & 2147483647) as int) - 1073741824
        acc = wrapping_add(acc, min(v, 1000))
        acc = wrapping_add(acc, max(v, -1000))
        acc = wrapping_add(acc, abs(v))
        acc = wrapping_add(acc, clamp(v, -5000, 5000))
    }
    print(acc)
}
