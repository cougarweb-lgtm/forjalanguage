// f8_laco_curto.fj - kernel de micro-benchmark (M7b F0c, fatia F8: laco curto desenrolavel).
// laco interno de 4 voltas com limite constante dentro de laco externo
// Gerado por gerar_kernels.py 1.0.0; nao editar a mao. Saida = checksum deterministico.

proc main() {
    var acc: int = 0
    for i in 0..<48000000 {
        for j in 0..<4 {
            acc = wrapping_add(acc, wrapping_mul(i, 4) + j)
        }
    }
    print(acc)
}
