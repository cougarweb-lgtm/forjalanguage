// f2_folha_laco.fj - kernel de micro-benchmark (M7b F0c, fatia F2: chamada de folha em laco).
// duas folhas minusculas (passo, mistura) chamadas a cada volta; o custo e a chamada
// Gerado por gerar_kernels.py 1.0.0; nao editar a mao. Saida = checksum deterministico.

proc passo(a: int) -> int {
    return wrapping_add(a, 7)
}

proc mistura(a: int, b: int) -> int {
    return wrapping_add(wrapping_mul(a, 31), b)
}

proc main() {
    var acc: int = 1
    for i in 0..<40000000 {
        acc = mistura(acc, passo(i))
        acc = passo(acc)
    }
    print(acc)
}
