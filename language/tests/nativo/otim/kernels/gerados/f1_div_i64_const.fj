// f1_div_i64_const.fj - kernel de micro-benchmark (M7b F0c, fatia F1: divisao e modulo por constante).
// int (i64) com sinal: / e % por 3, 10, 1000, 1024, -3, -1024
// Gerado por gerar_kernels.py 1.0.0; nao editar a mao. Saida = checksum deterministico.

proc main() {
    var y: u64 = 88172645463325252
    var acc: int = 0
    for i in 0..<14000000 {
        y = y ~ (y << 13)
        y = y ~ (y >> 7)
        y = y ~ (y << 17)
        let v = ((y >> 2) as int) - 2305843009213693952
        acc = wrapping_add(acc, v / 3)
        acc = wrapping_add(acc, v % 10)
        acc = wrapping_add(acc, v / 1000)
        acc = wrapping_add(acc, v % 1024)
        acc = wrapping_add(acc, v / -3)
        acc = wrapping_add(acc, v % -1024)
    }
    print(acc)
}
