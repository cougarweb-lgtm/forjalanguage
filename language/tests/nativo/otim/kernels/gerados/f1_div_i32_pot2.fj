// f1_div_i32_pot2.fj - kernel de micro-benchmark (M7b F0c, fatia F1: divisao e modulo por constante).
// i32 com sinal: / e % por potencias de 2 (2, 8, 1024, 65536) e -8
// Gerado por gerar_kernels.py 1.0.0; nao editar a mao. Saida = checksum deterministico.

proc main() {
    var x: u32 = 2463534242
    var acc: int = 0
    for i in 0..<20000000 {
        x = x ~ (x << 13)
        x = x ~ (x >> 17)
        x = x ~ (x << 5)
        let v = ((x & 2147483647) as i32) - 1073741824
        acc = wrapping_add(acc, (v / 2) as int)
        acc = wrapping_add(acc, (v / 8) as int)
        acc = wrapping_add(acc, (v % 8) as int)
        acc = wrapping_add(acc, (v / 1024) as int)
        acc = wrapping_add(acc, (v % 65536) as int)
        acc = wrapping_add(acc, (v / -8) as int)
    }
    print(acc)
}
