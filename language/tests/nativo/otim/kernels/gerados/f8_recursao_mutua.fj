// f8_recursao_mutua.fj - kernel de micro-benchmark (M7b F0c, fatia F8: recursao mutua pequena).
// par e impar em recursao mutua de profundidade 8, chamados a cada volta
// Gerado por gerar_kernels.py 1.0.0; nao editar a mao. Saida = checksum deterministico.

proc par(n: int, k: int) -> int {
    if n == 0 {
        return k
    }
    return impar(n - 1, wrapping_add(k, 1))
}

proc impar(n: int, k: int) -> int {
    if n == 0 {
        return k
    }
    return par(n - 1, wrapping_add(k, 3))
}

proc main() {
    var acc: int = 0
    for i in 0..<8500000 {
        acc = wrapping_add(acc, par(8, i))
    }
    print(acc)
}
