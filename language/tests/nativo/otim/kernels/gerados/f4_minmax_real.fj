// f4_minmax_real.fj - kernel de micro-benchmark (M7b F0c, fatia F4: min/max/abs/clamp e bits).
// min, max, abs e clamp sobre f64 com valores inteiros (somas exatas, sem reassociar)
// Gerado por gerar_kernels.py 1.0.0; nao editar a mao. Saida = checksum deterministico.

proc main() {
    var x: u32 = 2463534242
    var acc: f64 = 0.0
    for i in 0..<15000000 {
        x = x ~ (x << 13)
        x = x ~ (x >> 17)
        x = x ~ (x << 5)
        let v = ((x & 65535) as f64) - 32768.0
        acc += min(v, 100.0)
        acc += max(v, -100.0)
        acc += abs(v)
        acc += clamp(v, -20000.0, 20000.0)
    }
    print(acc as int)
}
