// f1_div_i32_unidade_min.fj - kernel de micro-benchmark (M7b F0c, fatia F1: divisao e modulo por constante).
// i32 com sinal: / e % por 1, -1 e MIN (dividendo nunca MIN, para nao dar R0002)
// Gerado por gerar_kernels.py 1.0.0; nao editar a mao. Saida = checksum deterministico.

proc main() {
    var x: u32 = 2463534242
    var acc: int = 0
    for i in 0..<27000000 {
        x = x ~ (x << 13)
        x = x ~ (x >> 17)
        x = x ~ (x << 5)
        let v = ((x & 2147483647) as i32) - 1073741824
        acc = wrapping_add(acc, (v / 1) as int)
        acc = wrapping_add(acc, (v / -1) as int)
        acc = wrapping_add(acc, (v % 1) as int)
        acc = wrapping_add(acc, (v / (-2147483647 - 1)) as int)
        acc = wrapping_add(acc, (v % (-2147483647 - 1)) as int)
    }
    print(acc)
}
