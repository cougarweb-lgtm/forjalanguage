// f6_licm_dse.fj - kernel de micro-benchmark (M7b F0c, fatia F6: carga invariante e store morto).
// carga de tab[5] e tab[2] dentro do laco (LICM) e gravacao de out[1] sobrescrita (DSE)
// Gerado por gerar_kernels.py 1.0.0; nao editar a mao. Saida = checksum deterministico.

proc main() {
    let tab: [8]int = {3, 1, 4, 1, 5, 9, 2, 6}
    var out: [4]int = {0, 0, 0, 0}
    var x: u32 = 2463534242
    var acc: int = 0
    for i in 0..<95000000 {
        x = x ~ (x << 13)
        x = x ~ (x >> 17)
        x = x ~ (x << 5)
        let base = tab[5] * 13 + tab[2]
        out[1] = base
        out[1] = wrapping_add((x & 1023) as int, base)
        acc = wrapping_add(acc, out[1])
    }
    print(acc)
}
