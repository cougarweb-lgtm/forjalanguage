// f5_expr_redundante_sccp.fj - kernel de micro-benchmark (M7b F0c, fatia F5: expressoes redundantes e constantes).
// subexpressoes iguais (GVN), constantes dobradas (SCCP) e ramo sempre verdadeiro
// Gerado por gerar_kernels.py 1.0.0; nao editar a mao. Saida = checksum deterministico.

proc main() {
    var x: u32 = 2463534242
    var acc: int = 0
    for i in 0..<96000000 {
        x = x ~ (x << 13)
        x = x ~ (x >> 17)
        x = x ~ (x << 5)
        let a = (x & 65535) as int
        let b = wrapping_mul(a, 3) + 7
        let c = wrapping_mul(a, 3) + 7
        let k = 3 * 1000 + 7
        if 2 > 1 {
            acc = wrapping_add(acc, b + c)
        }
        acc = wrapping_add(acc, k * 2 + a * 0)
    }
    print(acc)
}
