// f4_bits_rot_popcount.fj - kernel de micro-benchmark (M7b F0c, fatia F4: min/max/abs/clamp e bits).
// rotacao (shl|shr) e popcount SWAR escritos a mao em u32
// Gerado por gerar_kernels.py 1.0.0; nao editar a mao. Saida = checksum deterministico.

proc main() {
    var x: u32 = 2463534242
    var acc: int = 0
    for i in 0..<67000000 {
        x = x ~ (x << 13)
        x = x ~ (x >> 17)
        x = x ~ (x << 5)
        let r = (x << 7) | (x >> 25)
        var v = wrapping_sub(r, (r >> 1) & 1431655765)
        v = (v & 858993459) + ((v >> 2) & 858993459)
        v = (v + (v >> 4)) & 252645135
        let c = wrapping_mul(v, 16843009) >> 24
        acc = wrapping_add(acc, c as int)
    }
    print(acc)
}
