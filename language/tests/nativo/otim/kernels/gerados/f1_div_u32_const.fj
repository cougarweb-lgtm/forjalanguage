// f1_div_u32_const.fj - kernel de micro-benchmark (M7b F0c, fatia F1: divisao e modulo por constante).
// u32 sem sinal: / e % por 3, 7, 10, 1000, 8 (dividendo na faixa inteira)
// Gerado por gerar_kernels.py 1.0.0; nao editar a mao. Saida = checksum deterministico.

proc main() {
    var x: u32 = 2463534242
    var acc: int = 0
    for i in 0..<27000000 {
        x = x ~ (x << 13)
        x = x ~ (x >> 17)
        x = x ~ (x << 5)
        acc = wrapping_add(acc, (x / 3) as int)
        acc = wrapping_add(acc, (x % 7) as int)
        acc = wrapping_add(acc, (x / 10) as int)
        acc = wrapping_add(acc, (x % 1000) as int)
        acc = wrapping_add(acc, (x / 8) as int)
    }
    print(acc)
}
