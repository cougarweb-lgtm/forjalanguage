// fixture de RECUSA (origem): o mesmo temporario `g` recebe copia em dois ramos e e lido depois da juncao (mais de uma copia para o mesmo slot).
// Saida igual ao build com --sem-otim tudo.

struct Grande {
    a: i64
    b: i64
    pad: [20]i64
}

proc escolhe(v: []Grande, i: int, usa_b: bool) -> i64 {
    var g: Grande = v[0]
    if usa_b {
        g = v[1]
    }
    return g.a + g.b + (i as i64)
}

proc main() {
    var v: [2]Grande = {}
    v[0].a = 1
    v[0].b = 2
    v[1].a = 100
    v[1].b = 200
    print(escolhe(v[..], 7, false))
    print(escolhe(v[..], 7, true))
}
