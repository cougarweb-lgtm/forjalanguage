// fixture de ACEITE (origem): campos aninhados e cargas de tamanhos diferentes lidos de um agregado copiado (somas de endereco `add vd,#k`).
// Saida igual ao build com --sem-otim tudo.

struct Interno {
    x: i32
    y: i16
    z: i8
    w: f32
}

struct Grande {
    nome: i64
    in1: Interno
    in2: Interno
    pad: [18]i64
}

proc le(v: []Grande, i: int) -> i64 {
    let g: Grande = v[i]
    return g.nome + (g.in1.x as i64) + (g.in1.y as i64) + (g.in1.z as i64) + (g.in2.x as i64) + (g.in2.z as i64) + (g.in2.w as i64)
}

proc main() {
    var v: [2]Grande = {}
    v[0].nome = 5
    v[0].in1.x = 70000
    v[0].in1.y = -3
    v[0].in1.z = 9
    v[0].in2.x = -12
    v[0].in2.z = 100
    v[0].in2.w = 2.0
    v[1].nome = 6
    v[1].in1.x = 1
    print(le(v[..], 0))
    print(le(v[..], 1))
}
