// fixture de ACEITE (origem): leitura de campos de um agregado grande copiado para um temporario; so ha cargas depois da copia.
// Saida esperada: igual ao build com --sem-otim tudo.

struct Grande {
    a: i64
    b: i64
    c: i32
    d: i32
    pad: [20]i64
}

proc soma(p: []Grande, n: int) -> i64 {
    var t: i64 = 0
    var i: int = 0
    while i < n {
        let g: Grande = p[i]
        t += g.a + g.b + (g.c as i64) + (g.d as i64)
        i += 1
    }
    return t
}

proc main() {
    var v: [3]Grande = {}
    var i: int = 0
    while i < 3 {
        v[i].a = (i as i64) + 1
        v[i].b = (i as i64) * 10
        v[i].c = (i as i32) + 100
        v[i].d = (i as i32) + 1000
        i += 1
    }
    print(soma(v[..], 3))
}
