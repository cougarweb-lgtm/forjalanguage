// fixture de RECUSA (origem): o temporario copiado e GRAVADO depois da copia (g.a = 5) e o original e gravado entre a copia e o uso.
// A copia tem de ficar: o valor lido de g e o de antes da gravacao no original. Saida igual ao build com --sem-otim tudo.

struct Grande {
    a: i64
    b: i64
    pad: [20]i64
}

proc muda_temporario(p: []Grande, i: int) -> i64 {
    var g: Grande = p[i]
    g.a = 5
    return g.a + g.b + p[i].a
}

proc muda_original(p: []Grande, i: int) -> i64 {
    let g: Grande = p[i]
    p[i].a = 99
    return g.a + g.b + p[i].a
}

proc main() {
    var v: [2]Grande = {}
    v[0].a = 1
    v[0].b = 2
    v[1].a = 10
    v[1].b = 20
    print(muda_temporario(v[..], 0))
    print(muda_original(v[..], 1))
    print(v[1].a)
}
