// fixture de RECUSA (origem): uma chamada com efeito (que grava no original) entre a copia e o uso; a copia guarda o valor de antes.
// Saida igual ao build com --sem-otim tudo.

struct Grande {
    a: i64
    b: i64
    pad: [20]i64
}

proc zera(p: []Grande) {
    p[0].a = 0
    p[0].b = 0
}

proc depois_da_chamada(v: []Grande) -> i64 {
    let g: Grande = v[0]
    zera(v)
    return g.a + g.b + v[0].a
}

proc main() {
    var v: [1]Grande = {}
    v[0].a = 11
    v[0].b = 22
    print(depois_da_chamada(v[..]))
    print(v[0].b)
}
