// fixture de RECUSA (origem): o endereco do temporario escapa (passado a outra proc, que grava nele); a copia fica.
// Saida igual ao build com --sem-otim tudo.

struct Grande {
    a: i64
    b: i64
    pad: [20]i64
}

proc consome(p: ^Grande) -> i64 {
    p.a = p.a + 1000
    return p.a
}

proc escapa(v: []Grande, i: int) -> i64 {
    var g: Grande = v[i]
    let r: i64 = consome(&g)
    return r + g.b + v[i].a
}

proc main() {
    var v: [2]Grande = {}
    v[0].a = 3
    v[0].b = 4
    v[1].a = 30
    v[1].b = 40
    print(escapa(v[..], 0))
    print(escapa(v[..], 1))
    print(v[0].a)
}
