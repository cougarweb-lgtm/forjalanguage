// fixture de ACEITE (curto): cadeias and/or, and/or aninhados e `not` viram desvio direto (regra V + regra T).
// Saida esperada: a tabela de eh_branco (9 3 0 1 1 0 ...) e as contagens dos laços, igual ao build com --sem-otim tudo.

proc eh_branco(c: u8) -> bool {
    return c == 32 or c == 9 or c == 10 or c == 13 or c == 12
}

proc faixa(x: int) -> bool {
    return (x >= 10 and x < 20) or (x >= 40 and x <= 50 and x != 45)
}

proc aninhado(a: int, b: int, c: int) -> int {
    if (a > 0 and (b > 0 or c > 0)) or (not (a > 5) and b == c) {
        return 1
    }
    return 0
}

proc main() {
    var brancos: int = 0
    for c in 0..<64 {
        if eh_branco(c as u8) {
            brancos += 1
        }
    }
    print(brancos)
    var dentro: int = 0
    for x in 0..<60 {
        if faixa(x) {
            dentro += 1
        }
    }
    print(dentro)
    var soma: int = 0
    for a in -1..<8 {
        for b in -1..<3 {
            for c in -1..<3 {
                soma = soma * 3 + aninhado(a, b, c)
                soma = soma % 1000003
            }
        }
    }
    print(soma)
}
