// fixture de ACEITE com efeito (curto): short-circuit com chamada de efeito colateral no 2o operando; a chamada so roda quando o 1o nao decide.
// Saida esperada (ordem): cada sinal() imprime o argumento antes do resultado; igual ao build com --sem-otim tudo.

proc sinal(n: int, v: bool) -> bool {
    print(n)
    return v
}

proc e_ou(a: bool, b: bool, c: bool) -> int {
    if (a and sinal(1, b)) or sinal(2, c) {
        return 1
    }
    return 0
}

proc main() {
    print(e_ou(false, false, false))
    print(e_ou(false, true, true))
    print(e_ou(true, false, false))
    print(e_ou(true, true, false))
}
