// fixture de RECUSA (curto): o valor booleano do and/or e usado DEPOIS do desvio (vt vivo fora de J), entao a regra nao transforma.
// Saida esperada: igual ao build com --sem-otim tudo.

proc guarda(a: int, b: int) -> int {
    let ok: bool = a > 0 and b > 0
    var r: int = 0
    if ok {
        r = 10
    }
    if ok or a == -1 {
        r += 1
    }
    if ok {
        r += 100
    }
    return r
}

proc main() {
    print(guarda(1, 1))
    print(guarda(1, 0))
    print(guarda(0, 1))
    print(guarda(-1, -1))
}
