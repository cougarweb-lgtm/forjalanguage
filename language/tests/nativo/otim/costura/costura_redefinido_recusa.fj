// fixture de RECUSA (costura): `k` e um vreg local que o laco regrava (`k = k - 1`); a guarda `k < 2` nao pode ser decidida pela entrada do laco,
// porque a aresta de volta traz outro valor. Saida esperada: 0, 3 e 4.

proc laco_redefinido(n: int) -> int {
    var k = n
    var total = 0
    var i = 0
    while i < 4 {
        k = k - 1
        if k < 2 {
            total = total + 1
        }
        i = i + 1
    }
    return total
}

proc main() {
    print(laco_redefinido(10))
    print(laco_redefinido(3))
    print(laco_redefinido(1))
}
