// fixture (costura): juncao com duas entradas de faixas diferentes. O ramo `n < 3` traz n em [MIN, 2] e o ramo `else` traz n em [3, MAX];
// a guarda `n - 2 < 2` depois da juncao so se decide por aresta quando a faixa cabe sem dar a volta (MIN da a volta e fica de fora).
// marca() tem efeito (print): as duas ramificacoes viram chamada e o selecao nao as converte; a juncao com a guarda fica como bloco que o passe copia.
// Saida de referencia: a de --sem-otim costura (cada juncao imprime o valor de marca e depois o resultado).

proc marca(v: int) -> int {
    print(v)
    return v
}

proc juncao(n: int) -> int {
    var r = 0
    if n < 3 {
        r = marca(n + 5)
    } else {
        r = marca(n - 7)
    }
    if n - 2 < 2 {
        r = marca(r + 1000)
    }
    return r
}

proc main() {
    let mn = -9223372036854775807 - 1
    let mx = 9223372036854775807
    print(juncao(mn))
    print(juncao(mn + 2))
    print(juncao(0))
    print(juncao(2))
    print(juncao(3))
    print(juncao(4))
    print(juncao(mx))
}
