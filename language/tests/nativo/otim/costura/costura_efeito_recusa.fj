// fixture de RECUSA (costura): o bloco da guarda `n - 1 < 2` tem uma chamada antes do CMP (sinaliza com print), entao nao e copiado (efeito).
// Saida esperada, na ordem: 0, 1, 2, 102, 3, 6, 4, 8 (o print de sinal vem antes do resultado de cada efeito_recusa).

proc sinal(n: int) -> int {
    print(n)
    if n - 1 < 2 {
        return n
    }
    return n * 2
}

proc efeito_recusa(n: int) -> int {
    if n < 2 {
        return n
    }
    let a = sinal(n)
    if n - 1 < 2 {
        return a + 100
    }
    return a
}

proc main() {
    print(efeito_recusa(0))
    print(efeito_recusa(1))
    print(efeito_recusa(2))
    print(efeito_recusa(3))
    print(efeito_recusa(4))
}
