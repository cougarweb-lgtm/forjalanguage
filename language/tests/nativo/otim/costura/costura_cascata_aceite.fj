// fixture de aceite (costura): cascata de guardas `n - k < 2` sobre o mesmo parametro, com sinal. Cada aresta de entrada ja sabe a faixa de n
// (n = 2 ou 3 ou 4 ou 5 ou fora), entao o bloco da guarda e copiado nela e salta direto ao sucessor decidido.
// Saida esperada (uma linha por print, na ordem de main): 0, 10, 150, 150, 150, 150, 140, 120, 80, 0, 0, 0.
// MIN e MAX dao a volta na conta (n - k vira positivo grande): a faixa recusa esse caso e o resultado segue a conta real.

proc cascata(n: int) -> int {
    var r = 0
    if n - 1 < 2 {
        r = 10
    }
    if n - 2 < 2 {
        r = r + 20
    }
    if n - 3 < 2 {
        r = r + 40
    }
    if n - 4 < 2 {
        r = r + 80
    }
    return r
}

proc main() {
    let mn = -9223372036854775807 - 1
    let mx = 9223372036854775807
    print(cascata(mn))
    print(cascata(mn + 1))
    print(cascata(-1))
    print(cascata(0))
    print(cascata(1))
    print(cascata(2))
    print(cascata(3))
    print(cascata(4))
    print(cascata(5))
    print(cascata(6))
    print(cascata(mx - 1))
    print(cascata(mx))
}
