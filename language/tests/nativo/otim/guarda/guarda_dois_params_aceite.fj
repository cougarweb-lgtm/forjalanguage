// fixture de aceite (F2b): recursao com 2 parametros; a guarda le ora o 1o parametro (k), ora o 2o (h), e a folha devolve o parametro guardado.

proc h(n: int, m: int) -> int {
    if m < 2 {
        return m
    }
    return h(n + 1, m - 1) + h(n + 2, m - 2)
}

proc k(n: int, m: int) -> int {
    if n < 2 {
        return m
    }
    return k(n - 1, m + 1) + k(n - 2, m)
}

proc main() {
    print(h(0, 25))
    print(k(20, 3))
}
