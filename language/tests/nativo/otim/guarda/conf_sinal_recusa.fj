// fixture de RECUSA (N2, fato de desvio): `i >= 5` e cmp com sinal (ge_s), nao conferencia de indice (ge_u); o unico acesso mantem a sua conferencia.
// Saida esperada: -1 e 8.

proc sinal(c: ^[5]int, i: int) -> int {
    if i >= 5 {
        return -1
    }
    return c^[i] * 2
}

proc main() {
    var v: [5]int = {1, 2, 3, 4, 5}
    print(sinal(&v, 7))
    print(sinal(&v, 3))
}
