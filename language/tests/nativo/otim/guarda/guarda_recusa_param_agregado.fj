// fixture de RECUSA (F2b): o parametro guardado (p) e um agregado; a entrada le um campo dele (nao e cmp com imediato), logo nao entra.

struct Par {
    a: int
    b: int
}

proc f(p: Par) -> int {
    if p.a < 2 {
        return p.b
    }
    return f(Par{a = p.a - 1, b = p.b}) + f(Par{a = p.a - 2, b = p.b})
}

proc main() {
    print(f(Par{a = 18, b = 2}))
}
