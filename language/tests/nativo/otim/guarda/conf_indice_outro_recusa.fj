// fixture de RECUSA (N2, fato de desvio): indices diferentes (i e j) e tamanhos diferentes ([5] e [3]) nao sao a mesma conferencia; nenhuma conferencia some.
// Saida esperada: 7 e 22.

proc outro(c: ^[5]int, i: int, j: int) -> int {
    return c^[i] * 2 + c^[j]
}

proc tamanhos(c: ^[5]int, d: ^[3]int, i: int) -> int {
    return c^[i] + d^[i]
}

proc main() {
    var v: [5]int = {1, 2, 3, 4, 5}
    var w: [3]int = {10, 20, 30}
    print(outro(&v, 2, 0))
    print(tamanhos(&v, &w, 1))
}
