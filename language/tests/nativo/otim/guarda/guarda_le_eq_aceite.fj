// fixture de aceite (F2b): guardas com `<=` (devolve o parametro) e `==` (devolve constante).

proc a(n: int) -> int {
    if n <= 1 {
        return n
    }
    return a(n - 1) + a(n - 2)
}

proc b(n: int) -> int {
    if n == 0 {
        return 3
    }
    return b(n - 1) + 1
}

proc main() {
    print(a(27))
    print(b(40))
}
