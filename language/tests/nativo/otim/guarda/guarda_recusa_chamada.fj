// fixture de RECUSA (F2b): a guarda chama outra funcao (sinal) antes do cmp; o bloco de entrada nao tem so cmp + desvia, logo nenhum sitio entra.

proc sinal(n: int) -> int {
    return n - 1
}

proc f(n: int) -> int {
    if sinal(n) < 2 {
        return n
    }
    return f(n - 1)
}

proc main() {
    print(f(10))
}
