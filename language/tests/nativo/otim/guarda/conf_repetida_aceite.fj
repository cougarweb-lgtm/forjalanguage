// fixture de ACEITE (N2, fato de desvio): conferencias repetidas do mesmo indice (i) e de outro (j) na mesma EBB; a 2a de cada par vira constante falsa e a saida nao muda.
// Saida esperada: 34 e 24.

proc soma_pares(c: ^[5]int, i: int, j: int) -> int {
    let a = c^[i] * 3
    let b = c^[i] * 5
    let d = c^[j] + c^[j]
    return a + b + d
}

proc laco(c: ^[5]int, k: int) -> int {
    var s = 0
    var n = 0
    while n < 4 {
        s += c^[k] + c^[k] * 2
        n += 1
    }
    return s
}

proc main() {
    var v: [5]int = {1, 2, 3, 4, 5}
    print(soma_pares(&v, 2, 4))
    print(laco(&v, 1))
}
