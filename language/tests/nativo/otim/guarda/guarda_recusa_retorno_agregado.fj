// fixture de RECUSA (F2b): a folha devolve um agregado (Par); a guarda nao entra porque o retorno nao e escalar.

struct Par {
    a: int
    b: int
}

proc f(n: int) -> Par {
    if n < 2 {
        return Par{a = n, b = 1}
    }
    let x = f(n - 1)
    let y = f(n - 2)
    return Par{a = x.a + y.a, b = x.b + y.b}
}

proc main() {
    let r = f(20)
    print(r.a)
    print(r.b)
}
