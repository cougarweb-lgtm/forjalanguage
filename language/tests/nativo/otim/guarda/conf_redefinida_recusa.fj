// fixture de RECUSA (N2, fato de desvio): o indice muda entre as duas conferencias (`k += 1` redefine o vreg); a 2a nao pode virar constante, nenhuma conferencia some.
// Saida esperada: 23 e 45.

proc redefinido(c: ^[5]int, i: int) -> int {
    var k = i
    let a = c^[k]
    k += 1
    let b = c^[k]
    return a * 10 + b
}

proc main() {
    var v: [5]int = {1, 2, 3, 4, 5}
    print(redefinido(&v, 1))
    print(redefinido(&v, 3))
}
