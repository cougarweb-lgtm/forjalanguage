// e_suja.fj - M3 P20 (bateria 10.2 e, o inverso): o foreign suja TODOS os registradores volateis do Win64 (rax rcx rdx r8-r11 xmm0-xmm5) antes de voltar;
// a Forja nao pode contar com nenhum deles depois da chamada. Valores vivos (inteiros e reais) atravessam laco, chamadas aninhadas e argumentos calculados.
// libs\fx_suja.dll (NASM): fx_suja_i64(a, b) = a + b, fx_suja_f64(a, b) = a + b, fx_suja_vazio(). Saida igual ao backend C.

foreign {
    link "fx_suja"
    proc fx_suja_i64(a: i64, b: i64) -> i64
    proc fx_suja_f64(a: f64, b: f64) -> f64
    proc fx_suja_vazio()
}

proc main() {
    let a: i64 = 11
    let b: i64 = 22
    let c: i64 = 33
    let d: i64 = 44
    let e: i64 = 55
    let f: i64 = 66
    let g: i64 = 77
    let h: i64 = 88
    let x: f64 = 1.5
    let y: f64 = 2.25
    let z: f64 = 4.0
    var soma: i64 = 0
    var real: f64 = 0.0
    for i in 0..<5 {
        let k = i as i64
        let r = fx_suja_i64(fx_suja_i64(a, b = k), b = fx_suja_i64(c, b = d))
        fx_suja_vazio()
        soma += r + e + f + g + h
        real += fx_suja_f64(fx_suja_f64(x, b = y), b = fx_suja_f64(z, b = 0.25)) + x + y + z
        print(r)
    }
    print(soma)
    print((real * 4.0) as int)
    print(a + b + c + d + e + f + g + h)
    print(((x + y + z) * 4.0) as int)
}
