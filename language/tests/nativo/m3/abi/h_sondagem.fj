// h_sondagem.fj - M3 P20 (bateria 10.2 h): sondagem de pilha. Cada nivel tem um local [100000]u8 (alem de uma pagina de 4 KiB) e chama foreign dentro:
// a pilha tem de crescer pagina a pagina (sem pular a guarda) e continuar alinhada a 16 na chamada. 5 niveis = 500 KB, abaixo do 1 MiB reservado.
// libs\fx_alinha.dll: fx_rsp_mod e fx_alinha. Saida igual ao backend C.

foreign {
    link "fx_alinha"
    proc fx_rsp_mod() -> i64
    proc fx_alinha(x: i64) -> i64
}

proc fundo(n: i32) -> i64 {
    var grande: [100000]u8 = {}
    for i in 0..<100000 {
        grande[i] = (i % 251) as u8
    }
    let dentro = fx_rsp_mod() + fx_alinha(n as i64)
    var soma: i64 = dentro
    if n > 1 {
        soma += fundo(n - 1)
    }
    soma += (grande[99999] as i64) + (grande[50000] as i64) + (grande[4095] as i64) + (grande[4096] as i64) + (grande[0] as i64)
    print(soma)
    return soma
}

proc main() {
    print(fundo(5))
}
