// f_pilha.fj - M3 P21 (bateria 10.2 f): desenrolar de pilha atraves do trampolim fjt_. main -> nivel(5) -> fx_chama_nivel (C) -> fjt_nivel -> nivel(4) -> ... -> nivel(0), 5 callbacks
// aninhados (Forja -> C -> Forja), que chama fx_quadros_nos_modulos (C): RtlCaptureStackBackTrace conta os quadros dentro do exe ou da DLL.
// A recursao atravessa a DLL para o gcc -O2 do oraculo C nao fundir os quadros. Um .xdata errado no fjt_ ou num proc faz a captura parar ali (sobram 2 ou 3 quadros).
// Esperado: >= 7 (na pratica 13 ou mais).

foreign {
    link "fx_chamador"
    proc fx_chama_nivel(cb: proc(n: i32) -> i32, n: i32) -> i32
    proc fx_quadros_nos_modulos() -> i32
}

proc nivel(n: i32) -> i32 {
    if n == 0 {
        return fx_quadros_nos_modulos()
    }
    let r = fx_chama_nivel(nivel, n = n - 1)
    return r
}

proc main() {
    let quadros = nivel(5)
    if quadros >= 7 {
        print("ok")
    } else {
        print("pilha parou cedo")
        print(quadros)
    }
}
