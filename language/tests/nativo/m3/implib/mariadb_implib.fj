// mariadb_implib.fj - M3 P19b: import library GNU do vendor (vendor\libmariadb.dll.a) pelo modulo vendor:banco_servidor/mariadb. Sem servidor: so chama
// mysql_get_client_info (versao do cliente) e mysql_get_client_version. libmariadb.dll NAO fica na pasta de busca: a suite poe language\vendor no PATH do run.

import "vendor:db_server/mariadb" as my

proc main() {
    let versao = my.mysql_get_client_info() or_else ""
    print(len(versao as str) > 0)
    print((my.mysql_get_client_version() as uint) >= 30000)
}
