// python_msvc.fj - M3 P19b: import library MSVC curta (python313.lib, copiada do Python 3.13 instalado para a pasta de trabalho pela suite). python313.dll NAO fica na pasta de
// busca: o nome dela vem de dentro da .lib e a suite poe a pasta do Python no PATH do run. Py_GetVersion nao precisa de Py_Initialize.

foreign {
    link "python313"
    proc Py_GetVersion() -> cstr
}

foreign {
    proc strncmp(a: cstr, b: cstr, n: u64) -> i32
}

proc main() {
    let versao = Py_GetVersion()
    if strncmp(versao, b = "3.13", n = 4) == 0 {
        print("python 3.13")
    } else {
        print("outra versao")
    }
    print(len(versao as str) > 4)
}
