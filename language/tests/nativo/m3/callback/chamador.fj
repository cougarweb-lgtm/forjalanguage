// chamador.fj - M3 P21: libs\fx_chamador.dll chama callbacks da Forja: (i32, f64, ^T, struct de 8 B) -> i32, (struct de 24 B por ponteiro) -> i64
// e retorno de struct por valor (8 B no RAX, 24 B por ponteiro oculto). O callback altera a copia da struct de 24 B: o original do C nao muda.

struct P8 {
    a: i32
    b: i32
}

struct P24 {
    x: i64
    y: i64
    z: i64
}

foreign {
    link "fx_chamador"
    proc fx_chama_misto(cb: proc(n: i32, r: f64, alvo: ^i32, p: P8) -> i32, alvo: ^i32) -> i32
    proc fx_chama_grande(cb: proc(g: P24) -> i64) -> i64
    proc fx_chama_retorna(cb8: proc(a: i32, b: i32) -> P8, cb24: proc(n: i64) -> P24) -> i64
}

proc misto(n: i32, r: f64, alvo: ^i32, p: P8) -> i32 {
    alvo^ = alvo^ + n
    print(n)
    print((r * 100.0) as int)
    print(p.a)
    print(p.b)
    return n + p.a * 10 + p.b * 100 + alvo^
}

proc grande(g: P24) -> i64 {
    var copia = g
    copia.x = 999
    print(g.x)
    print(g.y)
    print(g.z)
    return g.x + g.y + g.z + copia.x
}

proc retorna8(a: i32, b: i32) -> P8 {
    return P8{a = a + 1, b = b + 2}
}

proc retorna24(n: i64) -> P24 {
    return P24{x = n, y = n + 1, z = n + 2}
}

proc main() {
    var alvo: i32 = 5
    let r = fx_chama_misto(misto, alvo = &alvo)
    print(r)
    print(alvo)
    print(fx_chama_grande(grande))
    print(fx_chama_retorna(retorna8, cb24 = retorna24))
}
