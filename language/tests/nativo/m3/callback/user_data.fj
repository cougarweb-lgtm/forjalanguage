// user_data.fj - M3 P21: o dado do usuario volta ao callback como rawptr (convertido a ^T com 'as') e como ^i32 direto. libs\fx_chamador.dll.
// Fim: a DLL chama o callback de ^i32 com NULL; dev = R0005 "parametro 'dado' do callback 'tipado'" (exit 101), release segue ("sem dado").

foreign {
    link "fx_chamador"
    proc fx_chama_n(cb: proc(dado: rawptr, i: i32), dado: rawptr, n: i32)
    proc fx_chama_tipado(cb: proc(dado: ^i32, i: i32), dado: ?^i32, n: i32)
}

proc somar(dado: rawptr, i: i32) {
    let acc = dado as ^i64
    acc^ = acc^ + i as i64
}

proc tipado(dado: ^i32, i: i32) {
    if i == 99 {
        print("sem dado")
        return
    }
    dado^ = dado^ * 10 + i
}

proc main() {
    var soma: i64 = 0
    fx_chama_n(somar, dado = &soma as rawptr, n = 10)
    print(soma)
    var valor: i32 = 4
    fx_chama_tipado(tipado, dado = &valor, n = 7)
    print(valor)
    fx_chama_tipado(tipado, dado = none, n = 99)
    print("fim")
}
