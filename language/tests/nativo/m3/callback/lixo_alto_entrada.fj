// lixo_alto_entrada.fj - M3 P21: libs\fx_lixo_entrada.dll (NASM) chama o callback com LIXO nos bits altos de cada argumento estreito (bool, i8, i16, u8, u16, i32;
// os dois ultimos vao pela pilha). O trampolim re-estende na entrada: o proc ve os valores certos, e o bool com byte baixo 0 mas bits altos ligados e falso.

foreign {
    link "fx_lixo_entrada"
    proc fx_lixo_chama(cb: proc(b: bool, a: i8, c: i16, d: u8, e: u16, f: i32) -> i32, bool_valor: i32) -> i32
}

proc confere(b: bool, a: i8, c: i16, d: u8, e: u16, f: i32) -> i32 {
    print(b)
    print(a)
    print(c)
    print(d)
    print(e)
    print(f)
    print(a as int + c as int + d as int + e as int + f as int)
    if b {
        return 1
    }
    return 0
}

proc main() {
    print(fx_lixo_chama(confere, bool_valor = 1))
    print(fx_lixo_chama(confere, bool_valor = 0))
}
