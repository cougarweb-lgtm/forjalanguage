// glfw_3args.fj - M3 P21: estilo glfw. O callback e REGISTRADO numa funcao da DLL (fica guardado) e chamado depois, por outra: tamanho (rawptr, i32, i32) com
// 3 argumentos e erro (i32, cstr). libs\fx_chamador.dll. Fim: erro com cstr NULL; dev = R0005 "parametro 'texto' do callback 'ao_erro'" (exit 101), release segue.

foreign {
    link "fx_chamador"
    proc fx_registra_tamanho(cb: proc(janela: rawptr, w: i32, h: i32))
    proc fx_dispara_tamanho(janela: rawptr, w: i32, h: i32)
    proc fx_registra_erro(cb: proc(codigo: i32, texto: cstr))
    proc fx_dispara_erro(codigo: i32, texto: ?cstr)
}

proc ao_redimensionar(janela: rawptr, w: i32, h: i32) {
    print(w * h)
}

proc ao_erro(codigo: i32, texto: cstr) {
    if codigo == 1 {
        print("sem texto")
        return
    }
    print(codigo)
    print(texto)
}

proc main() {
    fx_registra_tamanho(ao_redimensionar)
    fx_registra_erro(ao_erro)
    fx_dispara_tamanho(none, w = 640, h = 480)
    fx_dispara_tamanho(none, w = 3, h = 4)
    fx_dispara_erro(65537, texto = "sem monitor")
    fx_dispara_erro(1, texto = none)
    print("fim")
}
