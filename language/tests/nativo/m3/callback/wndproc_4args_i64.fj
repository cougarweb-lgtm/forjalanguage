// wndproc_4args_i64.fj - M3 P21: WNDPROC real (4 argumentos: rawptr, u32, u64, i64 -> i64). user32!CallWindowProcA chama o proc da Forja (trampolim fjt_) direto,
// sem janela. Valores de 64 bits com bits altos cheios atravessam o callback sem perda.

foreign {
    link "user32"
    proc CallWindowProcA(anterior: proc(h: rawptr, m: u32, w: u64, l: i64) -> i64, hwnd: rawptr, msg: u32, w: u64, l: i64) -> i64
}

proc meu_wndproc(h: rawptr, m: u32, w: u64, l: i64) -> i64 {
    print(m)
    print(w)
    print(l)
    if m == 1025 {
        return l * 2 + 1
    }
    return -1
}

proc main() {
    print(CallWindowProcA(meu_wndproc, hwnd = none, msg = 1025, w = 7, l = 9))
    print(CallWindowProcA(meu_wndproc, hwnd = none, msg = 4000000000, w = 18000000000000000000, l = -5000000000))
}
