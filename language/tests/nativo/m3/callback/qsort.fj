// qsort.fj - M3 P21: o qsort do CRT (sem 'link': o gcc deste PC nao liga "c") chama o proc da Forja (trampolim fjt_) para comparar. Cinco inteiros saem ordenados, crescente e depois decrescente.

foreign {
    proc qsort(base: rawptr, n: u64, tamanho: u64, comparar: proc(a: rawptr, b: rawptr) -> i32)
}

proc crescente(a: rawptr, b: rawptr) -> i32 {
    let x = a as ^i32
    let y = b as ^i32
    if x^ < y^ {
        return -1
    }
    if x^ > y^ {
        return 1
    }
    return 0
}

proc decrescente(a: rawptr, b: rawptr) -> i32 {
    return crescente(b, b = a)
}

proc main() {
    var v: [5]i32 = {4, 2, 5, 1, 3}
    qsort(&v[0] as rawptr, n = 5, tamanho = 4, comparar = crescente)
    for item in v {
        print(item)
    }
    qsort(&v[0] as rawptr, n = 5, tamanho = 4, comparar = decrescente)
    for item in v {
        print(item)
    }
}
