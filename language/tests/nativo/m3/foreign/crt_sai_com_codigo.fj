// crt_sai_com_codigo.fj - M3 P19c: main -> ! E devolve o erro (exit 1) com bytes pendentes no stdout do CRT (puts) e no buffer do print: saem os dois, na ordem do programa.

foreign {
    link "ucrt"
    proc puts(texto: cstr) -> i32
}

enum Erro { primeiro, segundo }

proc falha() -> i32 ! Erro {
    return Erro.segundo
}

proc main() -> ! Erro {
    print(7)
    _ = puts("crt pendente")
    print(8)
    let a = try falha()
    print(a)
}
