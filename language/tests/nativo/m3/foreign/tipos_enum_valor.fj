// tipos_enum_valor.fj - M3 P23: enum com valor (inclusive negativo) cruza foreign como inteiro de 32 bits, na ida e na volta (m3\libs\fx_tipos.dll).

enum Cor {
    vermelho = 1
    verde = 2
    azul = 4
}

enum Nivel { baixo = -1, medio, alto }

foreign {
    link "fx_tipos"
    proc fx_cor_peso(c: Cor) -> i32
    proc fx_cor_proxima(c: Cor) -> Cor
    proc fx_nivel_dobro(n: Nivel) -> i32
    proc fx_nivel_de(n: i32) -> Nivel
}

proc main() {
    print(fx_cor_peso(Cor.azul))
    print(fx_cor_proxima(Cor.vermelho) == Cor.verde)
    print(fx_cor_proxima(Cor.verde) == Cor.azul)
    print(fx_cor_proxima(Cor.azul) == Cor.vermelho)
    print(fx_nivel_dobro(Nivel.baixo))
    print(fx_nivel_dobro(Nivel.alto))
    print(fx_nivel_de(-50) == Nivel.baixo)
    print(fx_nivel_de(0) == Nivel.medio)
    print(fx_nivel_de(9) == Nivel.alto)
    print(fx_nivel_de(9) == Nivel.baixo)
}
