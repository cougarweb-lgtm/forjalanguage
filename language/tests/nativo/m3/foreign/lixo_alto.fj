// lixo_alto.fj - M3 P19: m3\libs\fx_lixo.dll (NASM) devolve bool/u8/i8/i16/u16/i32/u32 com lixo nos bits altos de RAX e devolve ECX inteiro dos argumentos estreitos:
// o x64 tem de re-estender o retorno e estender os argumentos a 32 bits, como o C.

foreign {
    link "fx_lixo"
    proc fx_lixo_bool() -> bool
    proc fx_lixo_u8() -> u8
    proc fx_lixo_i8() -> i8
    proc fx_lixo_i16() -> i16
    proc fx_lixo_u16() -> u16
    proc fx_lixo_i32() -> i32
    proc fx_lixo_u32() -> u32
    proc fx_ver_bool(a: bool) -> i32
    proc fx_ver_i8(a: i8) -> i32
    proc fx_ver_u8(a: u8) -> i32
    proc fx_ver_i16(a: i16) -> i32
    proc fx_ver_u16(a: u16) -> i32
}

proc main() {
    print(fx_lixo_bool())
    print(fx_lixo_bool() == true)
    print(fx_lixo_u8())
    print(fx_lixo_u8() as i64)
    print(fx_lixo_i8())
    print(fx_lixo_i8() as i64)
    print(fx_lixo_i16())
    print(fx_lixo_i16() as i64)
    print(fx_lixo_u16())
    print(fx_lixo_u16() as u64)
    print(fx_lixo_i32())
    print(fx_lixo_i32() as i64)
    print(fx_lixo_u32())
    print(fx_lixo_u32() as u64)
    print(fx_ver_bool(true))
    print(fx_ver_i8(-5))
    print(fx_ver_u8(250))
    print(fx_ver_i16(-1000))
    print(fx_ver_u16(60000))
}
