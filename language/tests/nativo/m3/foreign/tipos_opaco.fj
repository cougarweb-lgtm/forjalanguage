// tipos_opaco.fj - M3 P23: handle opaco (opaque Obj + ?^Obj) criado, usado e liberado numa DLL (m3\libs\fx_tipos.dll); o ponteiro cruza a ABI como rawptr.

foreign {
    link "fx_tipos"
    opaque Obj
    proc fx_obj_novo(valor: i32) -> ?^Obj
    proc fx_obj_soma(o: ?^Obj, n: i32) -> i32
    proc fx_obj_libera(o: ?^Obj)
}

struct Caixa {
    dono: ?^Obj
    nome: i32
}

proc main() {
    let o = fx_obj_novo(7)
    let c = Caixa{dono = o, nome = 1}
    print(fx_obj_soma(c.dono, n = 3))
    print(fx_obj_soma(c.dono, n = -20))
    print(fx_obj_soma(o, n = 1000000))
    fx_obj_libera(c.dono)
    print(c.nome)
}
