// dll_basica.fj - M3 P19: DLL da pasta (m3\libs\fx_basica.dll): inteiros de 8 a 64 bits, f32 e f64, mistura de classes, 6 e 12 argumentos e retorno NULL.

foreign {
    link "fx_basica"
    proc fx_i8(a: i8, b: i8) -> i8
    proc fx_u8(a: u8, b: u8) -> u8
    proc fx_i16(a: i16, b: i16) -> i16
    proc fx_u16(a: u16, b: u16) -> u16
    proc fx_i32(a: i32, b: i32) -> i32
    proc fx_u32(a: u32, b: u32) -> u32
    proc fx_i64(a: i64, b: i64) -> i64
    proc fx_u64(a: u64, b: u64) -> u64
    proc fx_f32(a: f32, b: f32) -> f32
    proc fx_f64(a: f64, b: f64) -> f64
    proc fx_mistura(a: i32, b: f64, c: i64, d: f32) -> f64
    proc fx_mistura6(a: i32, b: f64, c: i64, d: f32, e: u8, f: i16) -> f64
    proc fx_seis(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64) -> i64
    proc fx_doze(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64, h: i64, i: i64, j: i64, k: i64, l: i64) -> i64
    proc fx_doze_mist(a: i32, b: f64, c: i32, d: f64, e: i32, f: f64, g: i32, h: f64, i: i32, j: f64, k: i32, l: f64) -> f64
    proc fx_texto(quer: i32) -> cstr
}

proc main() {
    print(fx_i8(100, b = 27))
    print(fx_i8(-100, b = -28))
    print(fx_u8(200, b = 55))
    print(fx_i16(-300, b = 100))
    print(fx_u16(256, b = 255))
    print(fx_i32(5, b = 9))
    print(fx_u32(4000000000, b = 294967295))
    print(fx_i64(3000000000, b = 3))
    print(fx_u64(9000000000000000000, b = 9000000000000000000))
    print(f"{fx_f32(1.5, b = 2.0)}")
    print((fx_f64(1.0, b = 3.0) * 1000000.0) as int)
    print((fx_mistura(1, b = 2.5, c = 3, d = 4.25) * 100.0) as int)
    print((fx_mistura6(1, b = 2.5, c = 3, d = 4.25, e = 5, f = -6) * 100.0) as int)
    print(fx_seis(1, b = 2, c = 3, d = 4, e = 5, f = 6))
    print(fx_doze(1, b = 2, c = 3, d = 4, e = 5, f = 6, g = 7, h = 8, i = 9, j = 10, k = 11, l = 12))
    print((fx_doze_mist(1, b = 2.0, c = 3, d = 4.0, e = 5, f = 6.0, g = 7, h = 8.0, i = 9, j = 10.0, k = 11, l = 12.0) * 10.0) as int)
    let t = fx_texto(1)
    print(t)
    print(len(t as str))
    _ = fx_texto(0)
    print(99)
}
