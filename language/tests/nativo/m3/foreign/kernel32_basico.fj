// kernel32_basico.fj - M3 P19: foreign direto do KERNEL32 (System32, sem DLL na pasta): o x64 tem de imprimir o mesmo que o C.

foreign {
    link "kernel32"
    proc GetCurrentProcessId() -> u32
    proc lstrlenA(texto: cstr) -> i32
    proc GetTickCount64() -> u64
}

proc main() {
    if GetCurrentProcessId() != 0 {
        print("ok")
    }
    print(lstrlenA("forja"))
    print(GetTickCount64() > 0)
}
