// alias.fj - M3 P19: foreign com nome da Forja diferente do simbolo (A6): o x64 chama IrExterno.simbolo, nao o nome do proc.

foreign {
    link "kernel32"
    proc pid = "GetCurrentProcessId"() -> u32
    proc comprimento = "lstrlenA"(texto: cstr) -> i32
}

proc main() {
    print(pid() != 0)
    print(comprimento("alias"))
}
