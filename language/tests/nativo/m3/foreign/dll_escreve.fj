// dll_escreve.fj - M3 P19c: DLL UCRT (m3\libs\fx_basica.dll, fx_escreve usa printf) que escreve no stdout entre dois print: a ordem tem de ser a do programa, igual ao C.

foreign {
    link "fx_basica"
    proc fx_escreve(n: i32) -> i32
}

proc main() {
    print(1)
    _ = fx_escreve(10)
    print(2)
    _ = fx_escreve(20)
    _ = fx_escreve(30)
    print(3)
}
