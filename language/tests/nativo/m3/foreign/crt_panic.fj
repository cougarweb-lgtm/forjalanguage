// crt_panic.fj - M3 P19c: puts deixa bytes no stdout do CRT e o programa morre em panic (stderr R0003, exit 101): stdout e exit iguais ao C, com puts e print na ordem do programa.

foreign {
    link "msvcrt"
    proc puts(texto: cstr) -> i32
}

proc main() {
    print(1)
    _ = puts("antes")
    print(2)
    _ = puts("depois")
    panic("parei")
}
