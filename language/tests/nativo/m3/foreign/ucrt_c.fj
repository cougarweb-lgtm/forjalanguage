// ucrt_c.fj - M3 P19: libc do CRT sem 'link' (o gcc deste PC nao tem libc.a, entao o link "c" nao liga no backend C; o x64 liga o CRT implicito, ucrtbase.dll):
// strlen, abs por alias, labs, toupper.

foreign {
    proc strlen(texto: cstr) -> u64
    proc c_abs = "abs"(x: i32) -> i32
    proc labs(x: i32) -> i32
    proc toupper(c: i32) -> i32
}

proc main() {
    print(strlen("forja nativa"))
    print(c_abs(-42))
    print(labs(-7))
    print(toupper(97))
}
