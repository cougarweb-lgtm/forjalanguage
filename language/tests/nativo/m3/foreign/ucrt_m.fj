// ucrt_m.fj - M3 P19: link "m" vira ucrtbase.dll no x64 (sqrt por alias, pow, floor, sqrtf com f32 de ida e de volta).

foreign {
    link "m"
    proc c_sqrt = "sqrt"(x: f64) -> f64
    proc pow(x: f64, y: f64) -> f64
    proc floor(x: f64) -> f64
    proc sqrtf(x: f32) -> f32
}

proc main() {
    let r = c_sqrt(2.0) as f32
    print(f"{r}")
    print(pow(2.0, y = 10.0) as int)
    print(floor(-2.5) as int)
    print(f"{sqrtf(2.0)}")
}
