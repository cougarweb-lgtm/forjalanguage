// tipos_struct_aninhada.fj - M3 P23: struct por valor com struct dentro e [N]T em campo, na ida e na volta (m3\libs\fx_tipos.dll):
// Vec2 (8 B, registrador), Caixa (16 B), Lote (16 B, [3]i32 + f32) e Retangulo (32 B) vao por ponteiro; o retorno de 16 B usa o ponteiro oculto.

struct Vec2 {
    x: i32
    y: i32
}

struct Caixa {
    a: Vec2
    b: Vec2
}

struct Lote {
    ids: [3]i32
    peso: f32
}

struct Retangulo {
    pos: Vec2
    tam: Vec2
    cantos: [2]Vec2
}

foreign {
    link "fx_tipos"
    proc fx_vec_soma(a: Vec2, b: Vec2) -> Vec2
    proc fx_caixa_cresce(c: Caixa, d: i32) -> Caixa
    proc fx_lote_soma(l: Lote) -> i32
    proc fx_lote_dobra(l: Lote) -> Lote
    proc fx_ret_soma(r: Retangulo) -> i32
}

proc main() {
    let v = fx_vec_soma(Vec2{x = 1, y = 2}, b = Vec2{x = 30, y = -4})
    print(v.x)
    print(v.y)
    let c = fx_caixa_cresce(Caixa{a = Vec2{x = 10, y = 20}, b = Vec2{x = 30, y = 40}}, d = 3)
    print(c.a.x)
    print(c.a.y)
    print(c.b.x)
    print(c.b.y)
    var l = Lote{peso = 2.5}
    l.ids[0] = 1
    l.ids[1] = 2
    l.ids[2] = 3
    print(fx_lote_soma(l))
    let d = fx_lote_dobra(l)
    print(d.ids[0])
    print(d.ids[1])
    print(d.ids[2])
    print(f"{d.peso}")
    var r = Retangulo{pos = Vec2{x = 1, y = 2}, tam = Vec2{x = 3, y = 4}}
    r.cantos[0].x = 5
    r.cantos[1].y = 6
    print(fx_ret_soma(r))
}
