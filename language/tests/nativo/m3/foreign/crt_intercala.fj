// crt_intercala.fj - M3 P19c: print, puts e putchar intercalados com link "msvcrt" (= ucrtbase, o stdout do oraculo C): mais de 4 KB de saida, a ordem tem de ser a do programa.

foreign {
    link "msvcrt"
    proc puts(texto: cstr) -> i32
    proc putchar(c: i32) -> i32
}

proc main() {
    for i in 0..<700 {
        print(i)
        _ = puts("crt")
        _ = putchar((65 + i % 26) as i32)
        _ = putchar(10)
        print(i + 1000)
    }
}
