// compressao_basico.fj - M3b P23e: std:compressao sobre zlib (vendor\libz.a, ESTATICA) com --backend x64 igual ao backend C (copia do caso interop\estatica\compressao_basico).
// O preparo (verificar_nativo.py, PrepararEstatica) leva vendor\libz.a e os modulos vendor\compressao\*.fj para a pasta de trabalho.

import "vendor:compression/compression"

const TAMANHO: int = 512

proc preencher(buffer: []u8) {
    for i in 0..<len(buffer) {
        buffer[i] = ((i % 8) + 65) as u8
    }
}

proc principal() -> ! compression.ZlibError {
    var original: [512]u8 = {}
    preencher(original[..])
    var pequeno: [600]u8 = {}
    let comprimidos = try compression.compress(original[..], dst = pequeno[..], level = 9)
    print(f"original {TAMANHO} bytes -> comprimido {comprimidos} bytes")

    var volta: [512]u8 = {}
    let restaurados = try compression.decompress(pequeno[0..<(comprimidos as int)], dst = volta[..])
    print(f"restaurados {restaurados} bytes")

    var iguais = true
    for i in 0..<TAMANHO {
        if volta[i] != original[i] {
            iguais = false
        }
    }
    print(f"conteudo igual: {iguais}")
    print(f"crc32 original {compression.crc(original[..], previous = 0)} volta {compression.crc(volta[..], previous = 0)}")
}

proc main() {
    print(f"zlib {compression.versao()}")
    switch r in principal() {
    case compression.ZlibError:
        print("erro inesperado")
    default:
        print("ok")
    }

    var original: [512]u8 = {}
    preencher(original[..])
    var minusculo: [4]u8 = {}
    switch r in compression.compress(original[..], dst = minusculo[..], level = 6) {
    case i64:
        print("inesperado")
    case compression.ZlibError:
        print(f"erro tratado: destino pequeno demais ({r == compression.ZlibError.dest_too_small})")
    }

    var lixo: [16]u8 = {}
    var saida: [64]u8 = {}
    switch r in compression.decompress(lixo[..], dst = saida[..]) {
    case i64:
        print("inesperado")
    case compression.ZlibError:
        print(f"erro tratado: dados invalidos ({r == compression.ZlibError.invalid_data})")
    }
}
