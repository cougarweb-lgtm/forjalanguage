// fx_coff.fj - M3b P23e: libfx_coff.a (estatica de teste, tests\nativo\m3\estatica\libs) com COMDAT em dois membros (inline e selectany de C++), WEAK_EXTERNAL (fraco com forte em outro
// membro e fraco sozinho), simbolo COMUM (-fcommon) em dois membros e -ffunction-sections. x64 tem de sair igual ao backend C (ld).

foreign {
    link "fx_coff"
    proc fx_usa_a(x: i32) -> i32
    proc fx_usa_b(x: i32) -> i32
    proc fx_chama_fraco() -> i32
    proc fx_chama_so() -> i32
    proc fx_marca_d() -> i32
    proc fx_inc_e()
    proc fx_inc_f()
    proc fx_ler_contador() -> i32
}

proc main() {
    print(fx_usa_a(4))
    print(fx_usa_b(4))
    print(fx_chama_fraco())
    print(fx_chama_so())
    print(fx_marca_d())
    fx_inc_e()
    fx_inc_f()
    fx_inc_e()
    print(fx_ler_contador())
}
