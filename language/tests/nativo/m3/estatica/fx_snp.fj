// fx_snp.fj - M3b P23f: vsnprintf que a ucrtbase nao exporta, chamado de dentro de uma .a (libfx_snp.a, tests\nativo\m3\estatica\libs) com --backend x64 igual ao backend C.
// O x64 liga o vsnprintf do rt_win_legado.o (camada fina sobre __stdio_common_vsprintf); o C usa o da toolchain. Os dois devolvem o tamanho que o texto inteiro exige e fecham com NUL
// mesmo quando cortam (cap 6: "00042-" vira "00042" + NUL, retorno 11).

foreign {
    link "fx_snp"
    proc fx_snp_formatar(dst: ?^u8, cap: i32, n: i32, texto: cstr) -> i32
}

proc mostrar(buf: []u8, quantos: i32) {
    for i in 0..<quantos {
        print(buf[i])
    }
}

proc main() {
    var inteiro: [16]u8 = {}
    var cortado: [16]u8 = {}
    let a = fx_snp_formatar(&inteiro[0], cap = 16, n = 42, texto = "ab")
    let b = fx_snp_formatar(&cortado[0], cap = 6, n = 42, texto = "ab")
    print(a)
    print(b)
    mostrar(inteiro[..], quantos = 9)
    mostrar(cortado[..], quantos = 6)
}
