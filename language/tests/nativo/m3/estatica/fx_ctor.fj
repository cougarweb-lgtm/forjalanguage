// fx_ctor.fj - M3b P23f: libfx_ctor.a (estatica de teste, tests\nativo\m3\estatica\libs) com construtores: tres do gcc (.ctors, prioridades 101, 102 e padrao) e um do MSVC (.CRT$XCU).
// Eles rodam antes do main: fx_ctor_ordem tem de ser 123 (101, 102, padrao) e fx_ctor_xc 7. Sem os construtores sairia 0 e 0. x64 tem de sair igual ao backend C (ld + CRT).

foreign {
    link "fx_ctor"
    proc fx_ctor_ordem() -> i32
    proc fx_ctor_xc() -> i32
}

proc main() {
    print(fx_ctor_ordem())
    print(fx_ctor_xc())
}
