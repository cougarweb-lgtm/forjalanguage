// rede_versao.fj - M3b P23f: libcurl.a (vendor\libcurl.a, ESTATICA) so com curl_version, sem rede, com --backend x64 igual ao backend C.
// O libcurl pede vsnprintf, que a ucrtbase nao exporta: o legado (rt_legado.c) o define sobre __stdio_common_vsprintf (a mesma CRT do sprintf/sscanf, sem msvcrt nem libmingwex).
// O libcurl chama ws2_32, crypt32, bcrypt, advapi32, secur32 e iphlpapi (os 'link' abaixo), a UCRT e o kernel32 sem 'link' (CRT e kernel32 implicitos).

foreign {
    link "curl"
    link "ws2_32"
    link "crypt32"
    link "bcrypt"
    link "advapi32"
    link "secur32"
    link "iphlpapi"
    proc curl_version() -> ?cstr
}

proc versao() -> str {
    let v = curl_version()
    return (v or_else "?") as str
}

proc main() {
    print(f"libcurl {versao()}")
}
