// fx_leg.fj - M3b P23g: a camada fina do rt_win_legado.o (printf, fprintf, snprintf, strcasecmp, hypotf, sincosf, __popcountdi2, sscanf, stat64i32, opendir/readdir/closedir) chamada de dentro de uma
// .a (libfx_leg.a, tests\nativo\m3\estatica\libs) com --backend x64 igual ao backend C. As linhas do print e as do printf da .a saem no mesmo stdout, na ordem do programa.

foreign {
    link "fx_leg"
    proc fx_leg_printf(n: i32, texto: cstr) -> i32
    proc fx_leg_fprintf_stderr(n: i32) -> i32
    proc fx_leg_snprintf(dst: ?^u8, cap: i32, n: i32) -> i32
    proc fx_leg_strcasecmp() -> i32
    proc fx_leg_matematica() -> i32
    proc fx_leg_sscanf() -> i32
    proc fx_leg_diretorio() -> i32
}

proc main() {
    print("antes")
    print(fx_leg_printf(7, texto = "ola"))
    print(fx_leg_fprintf_stderr(9))
    var buf: [16]u8 = {}
    print(fx_leg_snprintf(&buf[0], cap = 6, n = 42))
    for i in 0..<6 {
        print(buf[i])
    }
    print(fx_leg_strcasecmp())
    print(fx_leg_matematica())
    print(fx_leg_sscanf())
    print(fx_leg_diretorio())
    print("depois")
}
