// abi_j.fj - M3b P23f (bateria ABI 10.2 item j, a parte estatica): callback da Forja chamado de dentro de codigo de uma .a (libfx_cb.a, tests\nativo\m3\estatica\libs) captura a pilha com
// RtlCaptureStackBackTrace atravessando os quadros de C da .a. fx_cb_descer(cb, x, n) desce n quadros de C antes de chamar o callback: se o .pdata/.xdata dos quadros da .a foram mesclados,
// o desenrolar passa por todos e fundo - raso = 5; se faltasse, a captura pararia no primeiro quadro sem .pdata. A diferenca nao depende de quantos quadros ha acima do main. Igual ao backend C.

foreign {
    link "fx_cb"
    link "kernel32"
    proc fx_cb_descer(cb: proc(x: i32) -> i32, x: i32, n: i32) -> i32
    proc RtlCaptureStackBackTrace(saltar: u32, capturar: u32, quadros: ?^u64, hash: ?^u32) -> u16
}

proc contar(x: i32) -> i32 {
    var quadros: [64]u64 = {}
    let n = RtlCaptureStackBackTrace(0, capturar = 64, quadros = &quadros[0], hash = none)
    let total = n as i32
    return total + x
}

proc main() {
    let raso = fx_cb_descer(contar, x = 0, n = 0)
    let fundo = fx_cb_descer(contar, x = 0, n = 5)
    print(fundo - raso)
}
