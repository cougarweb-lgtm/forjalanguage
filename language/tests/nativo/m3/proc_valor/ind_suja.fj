// ind_suja.fj - M3 P21v-c (o "e inverso" por chamada indireta): o alvo (libs\fx_suja.dll, achado por GetProcAddress) suja TODOS os registradores volateis do Win64 (rax rcx rdx r8-r11 xmm0-xmm5)
// antes de voltar; a Forja nao pode contar com nenhum deles depois do call r64. Valores vivos (inteiros e reais) atravessam laco, chamadas aninhadas e argumentos calculados por outras
// chamadas indiretas. O proc fica em let, em campo de struct e em parametro. Saida igual ao backend C.

struct Suja {
    soma_i: proc(a: i64, b: i64) -> i64
    soma_f: proc(a: f64, b: f64) -> f64
    vazio: proc()
}

foreign {
    link "kernel32"
    proc LoadLibraryA(nome: cstr) -> rawptr
    proc GetProcAddress(modulo: rawptr, nome: cstr) -> rawptr
}

proc carregar() -> Suja {
    let m = LoadLibraryA("fx_suja.dll")
    return Suja{
        soma_i = GetProcAddress(m, nome = "fx_suja_i64") as proc(a: i64, b: i64) -> i64,
        soma_f = GetProcAddress(m, nome = "fx_suja_f64") as proc(a: f64, b: f64) -> f64,
        vazio = GetProcAddress(m, nome = "fx_suja_vazio") as proc()
    }
}

proc dobrar_por(f: proc(a: i64, b: i64) -> i64, x: i64) -> i64 {
    return f(f(x, b = x), b = f(x, b = 1))
}

proc main() {
    let s = carregar()
    let a: i64 = 11
    let b: i64 = 22
    let c: i64 = 33
    let d: i64 = 44
    let e: i64 = 55
    let f: i64 = 66
    let g: i64 = 77
    let h: i64 = 88
    let x: f64 = 1.5
    let y: f64 = 2.25
    let z: f64 = 4.0
    var soma: i64 = 0
    var real: f64 = 0.0
    for i in 0..<5 {
        let k = i as i64
        let r = s.soma_i(s.soma_i(a, b = k), b = s.soma_i(c, b = d))
        s.vazio()
        soma += r + e + f + g + h
        real += s.soma_f(s.soma_f(x, b = y), b = s.soma_f(z, b = 0.25)) + x + y + z
        print(r)
    }
    print(soma)
    print((real * 4.0) as int)
    print(dobrar_por(s.soma_i, x = 7))
    print(a + b + c + d + e + f + g + h)
    print(((x + y + z) * 4.0) as int)
}
