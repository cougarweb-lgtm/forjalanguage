// ind_retorno.fj - M3 P21v-c: retorno de chamada indireta: struct por valor de 1 a 40 bytes (1, 2, 4 e 8 B voltam no RAX; 3, 5, 12, 16, 24 e 40 B por ponteiro oculto em RCX) e
// escalares estreitos (bool, i8, u8, i16, u16) e largos. O chamador usa so o valor devolvido; o alvo e um proc da Forja guardado em let. Igual ao backend C.

struct R1 {
    a: u8
}

struct R2 {
    a: i16
}

struct R3 {
    a: u8
    b: u8
    c: u8
}

struct R4 {
    a: f32
}

struct R8 {
    a: i32
    b: f32
}

struct R12 {
    a: i32
    b: i32
    c: i32
}

struct R16 {
    a: i64
    b: f64
}

struct R24 {
    a: i64
    b: f64
    c: i64
}

struct R40 {
    a: i64
    b: i64
    c: i64
    d: i64
    e: f64
}

proc r1(n: i32) -> R1 {
    return R1{a = (n + 200) as u8}
}

proc r2(n: i32) -> R2 {
    return R2{a = (n - 30000) as i16}
}

proc r3(n: i32) -> R3 {
    return R3{a = (n + 1) as u8, b = (n + 2) as u8, c = (n + 3) as u8}
}

proc r4(n: i32) -> R4 {
    return R4{a = (n as f32) * 0.5}
}

proc r8(n: i32) -> R8 {
    return R8{a = n * 1000, b = (n as f32) + 0.25}
}

proc r12(n: i32) -> R12 {
    return R12{a = n, b = n * 2, c = n * 3}
}

proc r16(n: i64) -> R16 {
    return R16{a = n * 100000000000, b = (n as f64) + 0.5}
}

proc r24(n: i64) -> R24 {
    return R24{a = n, b = (n as f64) * 1.5, c = n * 9000000000}
}

proc r40(n: i64) -> R40 {
    return R40{a = n, b = n + 1, c = n + 2, d = n + 3, e = (n as f64) * 0.125}
}

proc eh_bool(n: i32) -> bool {
    return n > 5
}

proc eh_i8(n: i32) -> i8 {
    return (n - 100) as i8
}

proc eh_u8(n: i32) -> u8 {
    return (n + 250) as u8
}

proc eh_i16(n: i32) -> i16 {
    return (n - 30000) as i16
}

proc eh_u16(n: i32) -> u16 {
    return (n + 65000) as u16
}

proc eh_i64(n: i64) -> i64 {
    return n * 4000000000
}

proc eh_f32(n: i32) -> f32 {
    return (n as f32) / 4.0
}

proc eh_f64(n: i64) -> f64 {
    return (n as f64) / 8.0
}

proc mostra(x: f64) {
    print((x * 4.0) as int)
}

proc main() {
    let g1 = r1
    let g2 = r2
    let g3 = r3
    let g4 = r4
    let g8 = r8
    let g12 = r12
    let g16 = r16
    let g24 = r24
    let g40 = r40
    let a = g1(50)
    print(a.a)
    let b = g2(7)
    print(b.a)
    let c = g3(10)
    print(c.a)
    print(c.b)
    print(c.c)
    let d = g4(9)
    mostra(d.a as f64)
    let e = g8(3)
    print(e.a)
    mostra(e.b as f64)
    let f = g12(5)
    print(f.a + f.b + f.c)
    let g = g16(7)
    print(g.a)
    mostra(g.b)
    let h = g24(3)
    print(h.a)
    mostra(h.b)
    print(h.c)
    let i = g40(10)
    print(i.a + i.b + i.c + i.d)
    mostra(i.e)
    print(g40(1).d + g24(2).a + g16(3).a)
    let h_bool = eh_bool
    let h_i8 = eh_i8
    let h_u8 = eh_u8
    let h_i16 = eh_i16
    let h_u16 = eh_u16
    let h_i64 = eh_i64
    let h_f32 = eh_f32
    let h_f64 = eh_f64
    print(h_bool(9))
    print(h_bool(2))
    print(h_i8(10))
    print(h_u8(5))
    print(h_i16(500))
    print(h_u16(535))
    print(h_i64(3))
    mostra(h_f32(7) as f64)
    mostra(h_f64(9))
    print((h_i8(1) as i64) * 3 + (h_u8(0) as i64) + (h_i16(0) as i64) + (h_u16(0) as i64))
}
