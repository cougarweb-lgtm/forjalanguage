// d3d12_warp.fj - M3 P21v-b: Direct3D 12 em Forja PURA, sem casca C. COM por tabela de funcoes: CreateDXGIFactory2 -> EnumWarpAdapter -> GetDesc do adaptador -> D3D12CreateDevice ->
// CreateCommandQueue -> GetDesc da fila (retorno de struct por __ret) -> Release de tudo. Usa o adaptador de software (WARP): roda sem placa de video. Imprime a contagem final 0.

struct Guid {
    d1: u32
    d2: u16
    d3: u16
    d4: [8]u8
}

struct AdapterDesc {
    descricao: [128]u16
    vendor: u32
    dispositivo: u32
    subsistema: u32
    revisao: u32
    memoria_video: u64
    memoria_sistema: u64
    memoria_compartilhada: u64
    luid: i64
}

struct QueueDesc {
    tipo: i32
    prioridade: i32
    flags: i32
    no: u32
}

struct VtblFabrica {
    qi: rawptr
    add_ref: proc(self: rawptr) -> u32
    release: proc(self: rawptr) -> u32
    resto: [24]rawptr
    enum_warp: proc(self: rawptr, riid: ^Guid, saida: ^rawptr) -> i32
}

struct VtblAdaptador {
    qi: rawptr
    add_ref: proc(self: rawptr) -> u32
    release: proc(self: rawptr) -> u32
    resto: [5]rawptr
    get_desc: proc(self: rawptr, desc: ^AdapterDesc) -> i32
}

struct VtblDispositivo {
    qi: rawptr
    add_ref: proc(self: rawptr) -> u32
    release: proc(self: rawptr) -> u32
    resto: [5]rawptr
    criar_fila: proc(self: rawptr, desc: ^QueueDesc, riid: ^Guid, saida: ^rawptr) -> i32
}

struct VtblFila {
    qi: rawptr
    add_ref: proc(self: rawptr) -> u32
    release: proc(self: rawptr) -> u32
    resto: [15]rawptr
    get_desc: proc(self: rawptr, ret: ^QueueDesc) -> ^QueueDesc
}

struct Fabrica {
    vtbl: ^VtblFabrica
}

struct Adaptador {
    vtbl: ^VtblAdaptador
}

struct Dispositivo {
    vtbl: ^VtblDispositivo
}

struct Fila {
    vtbl: ^VtblFila
}

foreign {
    link "dxgi"
    link "d3d12"
    proc CreateDXGIFactory2(flags: u32, riid: ^Guid, saida: ^rawptr) -> i32
    proc D3D12CreateDevice(adaptador: rawptr, nivel: u32, riid: ^Guid, saida: ^rawptr) -> i32
}

const IID_FABRICA4: Guid = Guid{ d1 = 0x1BC6EA02, d2 = 0xEF36, d3 = 0x464F, d4 = {0xBF, 0x0C, 0x21, 0xCA, 0x39, 0xE5, 0x16, 0x8A} }
const IID_ADAPTADOR: Guid = Guid{ d1 = 0x2411E7E1, d2 = 0x12AC, d3 = 0x4CCF, d4 = {0xBD, 0x14, 0x97, 0x98, 0xE8, 0x53, 0x4D, 0xC0} }
const IID_DISPOSITIVO: Guid = Guid{ d1 = 0x189819F1, d2 = 0x1DB6, d3 = 0x4B57, d4 = {0xBE, 0x54, 0x18, 0x21, 0x33, 0x9B, 0x85, 0xF7} }
const IID_FILA: Guid = Guid{ d1 = 0x0EC870A6, d2 = 0x5D7E, d3 = 0x4C22, d4 = {0x8C, 0xFC, 0x5B, 0xAA, 0xE0, 0x76, 0x16, 0xED} }

proc main() {
    var iid_fabrica = IID_FABRICA4
    var iid_adaptador = IID_ADAPTADOR
    var iid_dispositivo = IID_DISPOSITIVO
    var iid_fila = IID_FILA
    var bruto: rawptr = none

    print(CreateDXGIFactory2(0, riid = &iid_fabrica, saida = &bruto) >= 0)
    let fabrica = bruto as ^Fabrica
    print(fabrica.vtbl.enum_warp(bruto, riid = &iid_adaptador, saida = &bruto) >= 0)
    let adaptador = bruto as ^Adaptador
    var desc = AdapterDesc{ vendor = 0 }
    print(adaptador.vtbl.get_desc(bruto, desc = &desc) >= 0)
    print(desc.vendor == 0x1414)
    print(desc.descricao[0])

    let adaptador_bruto = bruto
    print(D3D12CreateDevice(adaptador_bruto, nivel = 0xB000, riid = &iid_dispositivo, saida = &bruto) >= 0)
    let dispositivo = bruto as ^Dispositivo
    var pedido = QueueDesc{ tipo = 0, prioridade = 0, flags = 0, no = 0 }
    print(dispositivo.vtbl.criar_fila(bruto, desc = &pedido, riid = &iid_fila, saida = &bruto) >= 0)
    let fila = bruto as ^Fila
    var lido = QueueDesc{ tipo = 7, prioridade = 7, flags = 7, no = 7 }
    let ret = fila.vtbl.get_desc(bruto, ret = &lido)
    print(lido.tipo)
    print(ret.prioridade)
    print(lido.no)

    print(fila.vtbl.release(bruto))
    print(dispositivo.vtbl.release(dispositivo as rawptr))
    print(adaptador.vtbl.release(adaptador as rawptr))
    print(fabrica.vtbl.release(fabrica as rawptr))
}
