// ind_despacho.fj - M3 P21v-c: tabela de despacho em struct com campos proc (campo de struct, campo de struct dentro de ponteiro, elemento de array de structs, parametro e retorno de proc Forja).
// O alvo da chamada indireta vem de local, campo, parametro, retorno de funcao e elemento de array; o chamado altera o estado por ponteiro. Igual ao backend C.

struct Estado {
    total: i64
    passos: i32
}

struct Acao {
    peso: i32
    aplicar: proc(e: ^Estado, x: i32) -> i64
    desfazer: proc(e: ^Estado) -> i32
}

proc somar(e: ^Estado, x: i32) -> i64 {
    e.total = e.total + (x as i64)
    e.passos = e.passos + 1
    return e.total
}

proc multiplicar(e: ^Estado, x: i32) -> i64 {
    e.total = e.total * (x as i64)
    e.passos = e.passos + 1
    return e.total
}

proc subtrair(e: ^Estado, x: i32) -> i64 {
    e.total = e.total - (x as i64)
    e.passos = e.passos + 1
    return e.total
}

proc zerar(e: ^Estado) -> i32 {
    let antes = e.passos
    e.total = 0
    e.passos = 0
    return antes
}

proc voltar_um(e: ^Estado) -> i32 {
    e.passos = e.passos - 1
    return e.passos
}

proc escolher_aplicar(i: i32) -> proc(e: ^Estado, x: i32) -> i64 {
    if i == 0 {
        return somar
    }
    if i == 1 {
        return multiplicar
    }
    return subtrair
}

proc rodar(e: ^Estado, f: proc(e: ^Estado, x: i32) -> i64, vezes: i32) -> i64 {
    var ultimo: i64 = 0
    for k in 0..<vezes {
        ultimo = f(e, x = k + 2)
    }
    return ultimo
}

proc main() {
    var e = Estado{total = 1, passos = 0}
    let tabela: [3]Acao = {
        Acao{peso = 10, aplicar = somar, desfazer = zerar},
        Acao{peso = 20, aplicar = multiplicar, desfazer = voltar_um},
        Acao{peso = 30, aplicar = subtrair, desfazer = zerar}
    }
    for i in 0..<3 {
        let a = tabela[i]
        print(a.aplicar(&e, x = a.peso))
        print(e.passos)
    }
    print(tabela[1].aplicar(&e, x = 2))
    print(tabela[1].desfazer(&e))
    print(rodar(&e, f = escolher_aplicar(0), vezes = 4))
    print(rodar(&e, f = escolher_aplicar(1), vezes = 3))
    print(rodar(&e, f = tabela[2].aplicar, vezes = 2))
    let p = &e
    let g = escolher_aplicar(2)
    print(g(p, x = 5))
    print(p.total)
    let ultimo = tabela[0].desfazer(p)
    print(ultimo)
    print(e.total)
    print(e.passos)
}
