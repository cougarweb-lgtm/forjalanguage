// ind_args.fj - M3 P21v-c: chamada indireta (IR_CHAMADA_IND) com 0 a 12 argumentos misturados: i8..u64, bool, f32, f64, ^T e struct por valor de 1 a 40 bytes
// (1, 2, 3, 4, 5, 8, 12, 16, 24 e 40: registrador, ponteiro para copia e pilha). O alvo e um proc da Forja guardado em let (trampolim fjt_). Igual ao backend C.

struct P1 {
    a: i8
}

struct P2 {
    a: i16
}

struct P3 {
    a: u8
    b: u8
    c: u8
}

struct P4 {
    a: f32
}

struct P5 {
    a: u8
    b: u8
    c: u8
    d: u8
    e: u8
}

struct P8 {
    a: i32
    b: f32
}

struct P12 {
    a: i32
    b: i32
    c: i32
}

struct P16 {
    a: i64
    b: f64
}

struct P24 {
    a: i64
    b: f64
    c: i64
}

struct P40 {
    a: i64
    b: i64
    c: i64
    d: i64
    e: f64
}

proc a0() -> i32 {
    return 70
}

proc a1(a: i8) -> i16 {
    return (a as i16) * 3
}

proc a2(a: u8, b: i16) -> i64 {
    return (a as i64) * 1000 + (b as i64)
}

proc a3(a: f32, b: f64, c: u64) -> f64 {
    return (a as f64) + b + (c as f64)
}

proc a4(a: ^i32, b: u16, c: i64, d: bool) -> i32 {
    a^ = a^ + 1
    if d {
        return (b as i32) + (c as i32)
    }
    return 0 - (b as i32)
}

proc a5(a: i8, b: u8, c: i16, d: u16, e: i32) -> i64 {
    return (a as i64) + (b as i64) * 10 + (c as i64) * 100 + (d as i64) * 1000 + (e as i64) * 10000
}

proc a6(a: u32, b: i64, c: u64, d: f32, e: f64, f: bool) -> f64 {
    var r = (a as f64) + (b as f64) + (c as f64) + (d as f64) + e
    if f {
        r = r * 2.0
    }
    return r
}

proc a7(p: ^i64, q: ^f64, a: i8, b: i16, c: f32, d: bool, e: u8) -> i32 {
    p^ = p^ + (a as i64) + (b as i64)
    q^ = q^ + (c as f64)
    if d {
        return (e as i32) + 1
    }
    return (e as i32) - 1
}

proc a8(t: P3, u: P8, a: i32, b: f64, c: i8, d: u16, e: f32, f: i64) -> i64 {
    let s = (t.a as i64) + (t.b as i64) * 10 + (t.c as i64) * 100
    let r = (u.a as i64) + ((u.b * 4.0) as i64) + (a as i64) + (b as i64) + (c as i64) + (d as i64) + (e as i64)
    return s * 1000000 + r + f
}

proc a9(t: P12, u: P24, a: f32, b: i8, c: bool, d: u32, e: f64, f: u8, g: i16) -> f64 {
    var r = (t.a as f64) + (t.b as f64) + (t.c as f64) + (u.a as f64) + u.b + (u.c as f64)
    r = r + (a as f64) + (b as f64) + (d as f64) + e + (f as f64) + (g as f64)
    if c {
        r = r + 0.5
    }
    return r
}

proc a10(t: P40, a: i8, b: P1, c: P2, d: P4, e: u64, f: P5, g: f64, h: i32) -> f64 {
    var r = (t.a as f64) + (t.b as f64) + (t.c as f64) + (t.d as f64) + t.e
    r = r + (a as f64) + (b.a as f64) + (c.a as f64) + (d.a as f64) + (e as f64)
    r = r + (f.a as f64) + (f.b as f64) + (f.c as f64) + (f.d as f64) + (f.e as f64) + g + (h as f64)
    return r
}

proc a11(a: i8, b: P5, c: i16, d: P16, e: f32, f: P40, g: u64, h: f64, i: ^i32, j: u8, k: bool) -> i64 {
    i^ = i^ + (j as i32)
    var r = (a as i64) + (b.e as i64) + (c as i64) + d.a + (d.b as i64) + (e as i64) + f.d + (g as i64) + (h as i64) + (j as i64)
    if k {
        r = r + 1000
    }
    return r
}

proc a12(a: i8, b: u8, c: i16, d: u16, e: i32, f: u32, g: i64, h: u64, i: f32, j: f64, k: ^i64, l: P24) -> f64 {
    k^ = k^ + g
    var r = (a as f64) + (b as f64) + (c as f64) + (d as f64) + (e as f64) + (f as f64) + (g as f64) + (h as f64) + (i as f64) + j
    r = r + (l.a as f64) + l.b + (l.c as f64)
    return r
}

proc mostra(x: f64) {
    print((x * 4.0) as int)
}

proc main() {
    let f0 = a0
    let f1 = a1
    let f2 = a2
    let f3 = a3
    let f4 = a4
    let f5 = a5
    let f6 = a6
    let f7 = a7
    let f8 = a8
    let f9 = a9
    let f10 = a10
    let f11 = a11
    let f12 = a12
    var alvo32: i32 = 41
    var alvo64: i64 = 1000
    var alvof: f64 = 1.5
    print(f0())
    print(f1(-5))
    print(f2(250, b = -300))
    mostra(f3(1.5, b = 2.25, c = 9000000000))
    print(f4(&alvo32, b = 65535, c = -7, d = true))
    print(f4(&alvo32, b = 10, c = 0, d = false))
    print(alvo32)
    print(f5(-3, b = 250, c = -300, d = 60000, e = -70000))
    mostra(f6(4000000000, b = -9000000000, c = 8000000000, d = 0.5, e = -1.25, f = true))
    print(f7(&alvo64, q = &alvof, a = -9, b = 300, c = 2.5, d = true, e = 255))
    print(f7(&alvo64, q = &alvof, a = 1, b = 1, c = -0.5, d = false, e = 0))
    print(alvo64)
    mostra(alvof)
    print(f8(P3{a = 1, b = 2, c = 3}, u = P8{a = 100, b = 1.5}, a = -4, b = 8.0, c = -1, d = 65000, e = 3.0, f = 7))
    mostra(f9(P12{a = 1, b = 2, c = 3}, u = P24{a = 10, b = 0.25, c = 30}, a = 0.75, b = -2, c = true, d = 3000000000, e = 2.5, f = 200, g = -5))
    mostra(f10(P40{a = 1, b = 2, c = 3, d = 4, e = 5.5}, a = -1, b = P1{a = -2}, c = P2{a = 300}, d = P4{a = 0.5}, e = 77, f = P5{a = 1, b = 2, c = 3, d = 4, e = 5}, g = 0.125, h = -9))
    var alvo_i: i32 = 5
    print(f11(-1, b = P5{a = 9, b = 8, c = 7, d = 6, e = 5}, c = 400, d = P16{a = 11, b = 12.0}, e = 13.0, f = P40{a = 1, b = 2, c = 3, d = 4, e = 5.0}, g = 99, h = 100.0, i = &alvo_i, j = 200, k = true))
    print(alvo_i)
    mostra(f12(-1, b = 2, c = -3, d = 4, e = -5, f = 6, g = -7, h = 8, i = 9.5, j = 10.25, k = &alvo64, l = P24{a = 1, b = 2.5, c = 3}))
    print(alvo64)
    print(f2(f1(3) as u8, b = f1(2)))
    mostra(f3(f9(P12{a = 1, b = 1, c = 1}, u = P24{a = 1, b = 1.0, c = 1}, a = 1.0, b = 1, c = false, d = 1, e = 1.0, f = 1, g = 1) as f32, b = f3(1.0, b = 1.0, c = 1), c = 3))
}
