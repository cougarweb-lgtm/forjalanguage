// getprocaddress.fj - M3 P21v-b: endereco de funcao que veio do C (GetProcAddress) vira proc por 'as proc(...)' e e chamado; saidas deterministicas (GetTickCount64 so tem o sinal conferido).

foreign {
    link "kernel32"
    proc GetModuleHandleA(nome: cstr) -> rawptr
    proc GetProcAddress(modulo: rawptr, nome: cstr) -> rawptr
    proc GetCurrentProcessId() -> u32
}

proc main() {
    let modulo = GetModuleHandleA("kernel32.dll")
    let tick = GetProcAddress(modulo, nome = "GetTickCount64") as proc() -> u64
    let pid = GetProcAddress(modulo, nome = "GetCurrentProcessId") as proc() -> u32
    let tamanho = GetProcAddress(modulo, nome = "lstrlenA") as proc(texto: cstr) -> i32
    let maximo = GetProcAddress(modulo, nome = "lstrcmpA") as proc(a: cstr, b: cstr) -> i32
    print(tick() > 0)
    print(pid() == GetCurrentProcessId())
    print(tamanho("forja"))
    print(maximo("a", b = "a"))
    print(maximo("a", b = "b") < 0)
    let bruto = tamanho as rawptr
    let de_volta = bruto as proc(texto: cstr) -> i32
    print(de_volta("quatro e mais"))
}
