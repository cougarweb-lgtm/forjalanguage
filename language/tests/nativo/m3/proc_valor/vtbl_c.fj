// vtbl_c.fj - M3 P21v-b: objeto C com tabela de funcoes no estilo COM (libs\fx_vtbl.dll). A Forja chama q.lpVtbl.<metodo>(q, ...): AddRef/Release, 6 argumentos (2 na pilha), f32, f64
// e retorno de struct de 24 B por __ret (ponteiro oculto). A contagem de objetos vivos termina em 0.

struct Desc {
    id: i32
    grande: i64
    fator: f64
}

struct Vtbl {
    add_ref: proc(self: rawptr) -> i32
    release: proc(self: rawptr) -> i32
    soma6: proc(self: rawptr, a: i32, b: i32, c: i32, d: i32, e: i32, f: i32) -> i32
    escala: proc(self: rawptr, x: f32) -> f32
    media: proc(self: rawptr, a: f64, b: f64) -> f64
    get_desc: proc(self: rawptr, ret: ^Desc) -> ^Desc
}

struct Objeto {
    lpvtbl: ^Vtbl
    refs: i32
    id: i32
}

foreign {
    link "fx_vtbl"
    proc fx_criar(k: i32) -> ^Objeto
    proc fx_vivos() -> i32
    proc fx_soma_pela_tabela(o: ^Objeto) -> i32
}

proc usar(q: ^Objeto) {
    let eu = q as rawptr
    print(q.lpvtbl.add_ref(eu))
    print(q.lpvtbl.soma6(eu, a = 1, b = 2, c = 3, d = 4, e = 5, f = 6))
    print((q.lpvtbl.escala(eu, x = 2.0) * 10.0) as int)
    print((q.lpvtbl.media(eu, a = 1.5, b = 2.5) * 100.0) as int)
    var d = Desc{ id = 0, grande = 0, fator = 0.0 }
    let r = q.lpvtbl.get_desc(eu, ret = &d)
    print(d.id)
    print(d.grande)
    print((r.fator * 100.0) as int)
    print(fx_soma_pela_tabela(q))
    print(q.lpvtbl.release(eu))
}

proc main() {
    let a = fx_criar(0)
    let b = fx_criar(2)
    print(fx_vivos())
    usar(a)
    usar(b)
    print(fx_vivos())
    print(a.lpvtbl.release(a as rawptr))
    print(b.lpvtbl.release(b as rawptr))
    print(fx_vivos())
}
