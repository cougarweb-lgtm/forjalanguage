// wndclass.fj - M3 P21v-b: WNDCLASSEXW com campo proc (lpfnWndProc) passado ao user32 (RegisterClassExW); GetClassInfoExW devolve o mesmo endereco, que a Forja chama por chamada indireta
// (d.procedimento(...)); CallWindowProcW chama o proc da Forja pelo C. Sem janela: nada aparece na tela.

struct WndClassEx {
    tamanho: u32
    estilo: u32
    procedimento: proc(janela: rawptr, mensagem: u32, wparam: u64, lparam: i64) -> i64
    extra_classe: i32
    extra_janela: i32
    instancia: rawptr
    icone: rawptr
    cursor: rawptr
    fundo: rawptr
    menu: rawptr
    classe: rawptr
    icone_pequeno: rawptr
}

foreign {
    link "user32"
    link "kernel32"
    proc GetModuleHandleW(nome: rawptr) -> rawptr
    proc RegisterClassExW(c: ^WndClassEx) -> u16
    proc GetClassInfoExW(instancia: rawptr, classe: rawptr, c: ^WndClassEx) -> i32
    proc UnregisterClassW(classe: rawptr, instancia: rawptr) -> i32
    proc CallWindowProcW(anterior: proc(h: rawptr, m: u32, w: u64, l: i64) -> i64, hwnd: rawptr, msg: u32, w: u64, l: i64) -> i64
}

proc janela_proc(janela: rawptr, mensagem: u32, wparam: u64, lparam: i64) -> i64 {
    print(mensagem)
    if mensagem == 1025 {
        return lparam * 2 + (wparam as i64)
    }
    return -1
}

proc main() {
    var nome: [12]u16 = {102, 111, 114, 106, 97, 95, 119, 110, 100, 0, 0, 0}
    let classe = &nome[0] as rawptr
    let instancia = GetModuleHandleW(none)
    var c = WndClassEx{ tamanho = 80, estilo = 8, procedimento = janela_proc, instancia = instancia,
                        menu = none, classe = classe }
    print(RegisterClassExW(&c) != 0)
    var d = WndClassEx{ tamanho = 80, procedimento = janela_proc }
    print(GetClassInfoExW(instancia, classe = classe, c = &d) != 0)
    print(d.estilo)
    print(d.procedimento(none, mensagem = 1025, wparam = 7, lparam = 9))
    print(d.procedimento(none, mensagem = 4, wparam = 1, lparam = 1))
    print(c.procedimento(none, mensagem = 1025, wparam = 1, lparam = 100))
    print(CallWindowProcW(janela_proc, hwnd = none, msg = 1025, w = 2, l = 3))
    print(UnregisterClassW(classe, instancia = instancia))
}
