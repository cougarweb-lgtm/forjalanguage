// ind_qsort.fj - M3 P21v-c: proc da Forja escolhido em tempo de execucao (let e campo de struct) e passado a foreign (o qsort do CRT, sem 'link'); o C chama o callback (trampolim fjt_)
// e o callback chama OUTRO proc por valor (chamada indireta dentro de callback chamado pelo C). Tres ordens (crescente, decrescente, pares antes) e um proc de let passado direto. Igual ao backend C.

foreign {
    proc qsort(base: rawptr, n: u64, tamanho: u64, comparar: proc(a: rawptr, b: rawptr) -> i32)
}

struct Ordem {
    nome: i32
    comparar: proc(a: rawptr, b: rawptr) -> i32
}

proc cmp_cresc(a: rawptr, b: rawptr) -> i32 {
    let x = a as ^i32
    let y = b as ^i32
    if x^ < y^ {
        return -1
    }
    if x^ > y^ {
        return 1
    }
    return 0
}

proc cmp_decresc(a: rawptr, b: rawptr) -> i32 {
    let inverso = cmp_cresc
    return inverso(b, b = a)
}

proc cmp_pares_antes(a: rawptr, b: rawptr) -> i32 {
    let x = a as ^i32
    let y = b as ^i32
    let px = x^ % 2
    let py = y^ % 2
    if px != py {
        return px - py
    }
    let base = cmp_cresc
    return base(a, b = b)
}

proc escolher(modo: i32) -> Ordem {
    if modo == 0 {
        return Ordem{nome = 0, comparar = cmp_cresc}
    }
    if modo == 1 {
        return Ordem{nome = 1, comparar = cmp_decresc}
    }
    return Ordem{nome = 2, comparar = cmp_pares_antes}
}

proc ordenar(v: ^i32, ordem: Ordem) {
    qsort(v as rawptr, n = 8, tamanho = 4, comparar = ordem.comparar)
}

proc mostrar(v: ^[8]i32) {
    var linha: i64 = 0
    for item in v^ {
        linha = linha * 100 + (item as i64)
    }
    print(linha)
}

proc main() {
    for modo in 0..<3 {
        var v: [8]i32 = {9, 4, 7, 1, 8, 2, 6, 3}
        let ordem = escolher(modo as i32)
        ordenar(&v[0], ordem = ordem)
        print(ordem.nome)
        mostrar(&v)
    }
    let direto = cmp_decresc
    var w: [8]i32 = {5, 5, 1, 9, 3, 3, 8, 0}
    qsort(&w[0] as rawptr, n = 8, tamanho = 4, comparar = direto)
    mostrar(&w)
}
