// preserva.fj - DLL Forja com um export "pesado" para libs\fx_preserva.exe (M3 P22b; bateria 10.2 e, direcao Forja exporta).
// Versao: 0.1.0
// pesado(n, x, m, y) mistura inteiros e reais em 4 posicoes (rcx xmm1 r8 xmm3), lista, map, format, sqrt e uma chamada de foreign (a UCRT): tudo o que o backend
// e o runtime fazem por tras de um export. O fx_preserva.exe enche rbx rbp rdi rsi r12-r15 e xmm6-xmm15 com sentinelas antes e confere na volta.

foreign {
    link "ucrt"
    proc labs(x: i32) -> i32
}

proc somar_raizes(n: i64, x: f64) -> f64 {
    var lista = make([dynamic]f64, alloc = heap, cap = 4)
    var total = 0.0 as f64
    for i in 0..<n {
        append(&lista, item = (i as f64) * 0.5 + x)
    }
    for v in lista {
        total = total + sqrt(v) * 3.0
    }
    delete(lista)
    return total
}

proc contar_no_mapa(n: i64, m: i64) -> i64 {
    var mapa = make(map[i64]f64, alloc = heap)
    for i in 0..<n {
        insert(&mapa, key = i, value = (i as f64) * 1.5)
    }
    let achado = get(mapa, key = m) or_else 0.0
    delete(mapa)
    return len_inteiro(achado)
}

proc len_inteiro(v: f64) -> i64 {
    let t = format(f"{v}", alloc = heap)
    let tam = len(t) as i64
    delete(t)
    return tam
}

pub export proc pesado(n: i64, x: f64, m: i64, y: f64) -> f64 {
    let a = somar_raizes(n, x = x)
    let b = contar_no_mapa(n, m = m)
    let c = labs(0 - (b as i32)) as f64
    return a + (b as f64) * y + c
}

proc main() {
}
