// realoca.fj - DLL Forja carregada FORA da base preferida por libs\fx_realoca.exe (M3 P22b; bateria 10.2 g).
// Versao: 0.1.0
// realoca_confere() roda por dentro da DLL o que mais depende de endereco do proprio modulo (texto em .rdata, lista, map de str, format, str ==) e devolve
// 0 se tudo bateu ou o numero da checagem que falhou. Nenhum endereco absoluto sai do backend x64 (o .reloc dos programas Forja so tem o bloco ABSOLUTE):
// o .reloc com ADDR64 real e a DLL de teste do teste_nativo.exe dll64, que o mesmo fx_realoca.exe carrega.

proc soma_da_lista() -> int {
    var lista = make([dynamic]int, alloc = heap, cap = 2)
    var soma = 0
    for i in 0..<100 {
        append(&lista, item = i)
    }
    for x in lista {
        soma = soma + x
    }
    delete(lista)
    return soma
}

proc valor_do_mapa(chave: str) -> int {
    var mapa = make(map[str]int, alloc = heap)
    insert(&mapa, key = "alfa", value = 1)
    insert(&mapa, key = "beta", value = 2)
    insert(&mapa, key = "gama", value = 3)
    let achado = get(mapa, key = chave) or_else 0
    delete(mapa)
    return achado
}

proc texto_formatado(n: int) -> bool {
    let t = format(f"{n}-sete", alloc = heap)
    let igual = t == "4950-sete"
    delete(t)
    return igual
}

pub export proc realoca_confere() -> int {
    if soma_da_lista() != 4950 {
        return 1
    }
    if valor_do_mapa("beta") != 2 {
        return 2
    }
    if valor_do_mapa("zeta") != 0 {
        return 3
    }
    if not texto_formatado(4950) {
        return 4
    }
    return 0
}

proc main() {
}
