// exe_host.fj - DLL Forja que IMPORTA a API que um EXECUTAVEL exporta (M3 P22b; usa o P19b): libs\fx_host.exe exporta fx_host_* e carrega esta DLL.
// Versao: 0.1.0
// O link "fx_host" acha libs\libfx_host.dll.a (import library do exe: o modulo se chama fx_host.exe); no x64 o backend le essa import library (BIB_IMPORT_GNU),
// no backend C o gcc a liga. Nos dois, o loader resolve os imports no proprio fx_host.exe, que ja esta carregado.

foreign {
    link "fx_host"
    proc fx_host_soma(a: i64, b: i64) -> i64
    proc fx_host_contar() -> i64
    proc fx_host_media(a: f64, b: f64) -> f64
    proc fx_host_diz(texto: cstr)
}

pub export proc exe_host_roda(n: i64) -> i64 {
    var acumulado: i64 = 0

    fx_host_diz("ola do exe_host")
    for i in 0..<n {
        acumulado = fx_host_soma(acumulado, b = fx_host_soma(i, b = fx_host_contar()))
    }
    return acumulado + (fx_host_media(3.0, b = 6.0) as i64)
}

proc main() {
}
