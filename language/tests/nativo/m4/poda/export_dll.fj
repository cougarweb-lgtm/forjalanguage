// export_dll.fj - M4 P24p (B07): em --modo dll as raizes sao os 'pub export proc'. soma_dobro (export) chama dobro; triplo (export) chama triplo_aux; nao_usado nao e export nem e chamado e sai da BIR.
// Carregado por ctypes em verificar_poda.py: soma_dobro(3, 4) = 14, triplo(5) = 15. 1 proc podado (nao_usado); a main vazia e a raiz do exe.

proc dobro(x: i64) -> i64 {
    return x * 2
}

proc triplo_aux(x: i64) -> i64 {
    return x * 3
}

proc nao_usado(x: i64) -> i64 {
    return dobro(x) + triplo_aux(x)
}

pub export proc soma_dobro(a: i64, b: i64) -> i64 {
    return dobro(a) + dobro(b)
}

pub export proc triplo(x: i64) -> i64 {
    return triplo_aux(x)
}

proc main() {
}
