// so_main.fj - M4 P24p (B07): a unica raiz e a main. dobra e somar_dobros sao alcancados por chamada direta; sobra_a e sobra_b nunca sao chamados e saem da BIR.
// Esperado: stdout "14" e "30"; 2 procs podados (sobra_a, sobra_b).

proc dobra(x: i32) -> i32 {
    return x * 2
}

proc somar_dobros(a: i32, b: i32) -> i32 {
    return dobra(a) + dobra(b)
}

proc sobra_a(x: i32) -> i32 {
    return x - 1
}

proc sobra_b(x: i32) -> i32 {
    return sobra_a(x) + 1
}

proc main() {
    print(somar_dobros(3, b = 4))
    print(somar_dobros(5, b = 10))
}
