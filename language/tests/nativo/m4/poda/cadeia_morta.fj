// cadeia_morta.fj - M4 P24p (B07): proc usado so por outro proc podado tambem e podado. morto_raiz chama morto_meio, que chama morto_folha, e ninguem alcancavel chama morto_raiz.
// morto_ciclo_a e morto_ciclo_b se chamam entre si (ciclo morto) e tambem saem. Esperado: stdout "7"; 5 procs podados.

proc vivo(x: i32) -> i32 {
    return x + 2
}

proc morto_folha(x: i32) -> i32 {
    return x * 100
}

proc morto_meio(x: i32) -> i32 {
    return morto_folha(x) + 1
}

proc morto_raiz(x: i32) -> i32 {
    return morto_meio(x) + vivo(x)
}

proc morto_ciclo_a(x: i32) -> i32 {
    if x <= 0 {
        return 0
    }
    return morto_ciclo_b(x - 1)
}

proc morto_ciclo_b(x: i32) -> i32 {
    return morto_ciclo_a(x)
}

proc main() {
    print(vivo(5))
}
