// teste_raiz.fj - M4 P24p (B07): em 'forja test' os procs 'test' sao raizes; ajuda_do_teste so e chamado de dentro do test e so existe nesse modo. No exe comum o test nao entra e
// ajuda_do_teste e sobra_no_exe saem (2 podados); em 'forja test' so sobra_no_exe sai (1 podado). Esperado do exe: stdout "6"; do test: "ok   soma" e "1 testes, 0 falharam".

proc ajuda_do_teste(x: i32) -> i32 {
    return x + x
}

proc sobra_no_exe(x: i32) -> i32 {
    return x - 7
}

proc seis() -> i32 {
    return 6
}

proc main() {
    print(seis())
}

test "soma" {
    expect(ajuda_do_teste(3) == seis())
}
