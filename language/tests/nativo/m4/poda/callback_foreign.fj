// callback_foreign.fj - M4 P24p (B07): proc da Forja passado a foreign (callback, trampolim fjt_) fica vivo; crescente e passado ao qsort do CRT. decrescente e ninguem o passa ou chama: sai da BIR junto
// do trampolim dele (que nem existe, ninguem toma o endereco). Esperado: 1 2 3 4 5 em stdout; 2 procs podados (decrescente, sobra).

foreign {
    proc qsort(base: rawptr, n: u64, tamanho: u64, comparar: proc(a: rawptr, b: rawptr) -> i32)
}

proc crescente(a: rawptr, b: rawptr) -> i32 {
    let x = a as ^i32
    let y = b as ^i32
    if x^ < y^ {
        return -1
    }
    if x^ > y^ {
        return 1
    }
    return 0
}

proc decrescente(a: rawptr, b: rawptr) -> i32 {
    return crescente(b, b = a)
}

proc sobra(n: i32) -> i32 {
    return n
}

proc main() {
    var v: [5]i32 = {4, 2, 5, 1, 3}
    qsort(&v[0] as rawptr, n = 5, tamanho = 4, comparar = crescente)
    for item in v {
        print(item)
    }
}
