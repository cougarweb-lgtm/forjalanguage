// proc_valor_campo.fj - M4 P24p (B07): o endereco de um proc guardado num campo de struct e chamado de forma indireta mantem o proc vivo (proc como valor, P21v). alvo_a e alvo_b so aparecem como
// valor (nunca por chamada direta); sobra nao aparece em lugar nenhum e sai. Esperado: stdout "11", "40" e "-5"; 1 proc podado (sobra).

struct Gancho {
    peso: i32
    acao: proc(x: i32) -> i32
}

proc alvo_a(x: i32) -> i32 {
    return x + 1
}

proc alvo_b(x: i32) -> i32 {
    return x * 4
}

proc sobra(x: i32) -> i32 {
    return alvo_a(x) + alvo_b(x)
}

proc aplicar(g: Gancho, x: i32) -> i32 {
    return g.acao(x)
}

proc main() {
    let a = Gancho{peso = 1, acao = alvo_a}
    let b = Gancho{peso = 2, acao = alvo_b}
    print(aplicar(a, x = 10))
    print(aplicar(b, x = 10))
    let f = alvo_a
    print(f(0 - 6))
}
