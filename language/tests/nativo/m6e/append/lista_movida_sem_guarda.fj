// lista_movida_sem_guarda.fj - M6e P93a (D-M6e-5): proc recebe ^[dynamic]int e da append; o chamador guarda ^int de &l[0] (entre procs: escapa do E0913). Dev sem guarda: o buffer velho e envenenado (0xDD) e p^ le -2459565876494606883. Release le o buffer velho (indefinido; so dev e oraculo).
proc cresce(l: ^[dynamic]int) {
    append(l, item = 9)
}

proc main() {
    var l = make([dynamic]int, alloc = heap, cap = 1)
    append(&l, item = 1)
    let p = &l[0]
    cresce(&l)
    print(p^)
    delete(l)
}
