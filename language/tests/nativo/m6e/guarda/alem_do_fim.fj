// alem_do_fim.fj - M6e P93a (--guarda-memoria, Windows): memcpy de 64 bytes a partir de um bloco de 8 (le alem do fim). Esperado: R0008 "acesso alem do fim do bloco de 8 bytes" (heap), exit 101, stdout vazio. Destino com capacidade para 64 bytes (nao estoura a pilha).
foreign {
    link "msvcrt"
    proc c_memcpy = "memcpy"(destino: rawptr, origem: rawptr, n: u64) -> rawptr
}

proc main() {
    let p = new(int, alloc = heap)
    p^ = 1
    var d = make([dynamic]int, alloc = heap, cap = 8)
    append(&d, item = 0)
    let destino = &d[0]
    _ = c_memcpy(destino as rawptr, p as rawptr, 64)
    print(d[0])
    delete(p)
    delete(d)
}
