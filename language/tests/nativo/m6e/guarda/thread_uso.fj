// thread_uso.fj - M6e P93a (--guarda-memoria, Windows): a 2a thread le um ponteiro guardado em estrutura, ja deletado pela main. Esperado: R0008 com a pilha DA THREAD (rotina), exit 101, stdout vazio.
import "std:os"

struct Caixa {
    p: ^int
}

foreign {
    link "kernel32"
    proc CreateThread(atributos: u64, pilha: u64, rotina: proc(p: rawptr) -> u32, parametro: rawptr, flags: u32, id: u64) -> u64
    proc WaitForSingleObject(alvo: u64, ms: u32) -> u32
    proc CloseHandle(alvo: u64) -> i32
}

proc rotina(p: rawptr) -> u32 {
    let q = p as ^int
    print(q^)
    return 0
}

proc main() {
    let p = new(int, alloc = heap)
    p^ = 3
    let c = Caixa{p = p}
    delete(p)
    os.multithread_on()
    let h = CreateThread(0, pilha = 0, rotina = rotina, parametro = c.p as rawptr, flags = 0, id = 0)
    _ = WaitForSingleObject(h, ms = 4294967295)
    _ = CloseHandle(h)
    delete(c.p)
}
