// guarda_ok.fj - M6e P93a: programa CORRETO (10 mil alocacoes, lista e Arena). Mesmo stdout com e sem --guarda-memoria: "10000", "9999", "42"; exit 0.
import "std:mem"

proc main() {
    var l = make([dynamic]int, alloc = heap)
    for i in 0..<10000 {
        let p = new(int, alloc = heap)
        p^ = i
        append(&l, item = p^)
        delete(p)
    }
    print(len(l))
    print(l[9999])
    let a = mem.arena_create()
    let x = new(int, alloc = a)
    x^ = 42
    print(x^)
    mem.arena_destroy(a)
    delete(l)
}
