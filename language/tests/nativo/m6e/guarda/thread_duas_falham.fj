// thread_duas_falham.fj - M6e P93k (P0-2, --guarda-memoria, Windows): as DUAS threads leem o mesmo ponteiro ja deletado e imprimem. A que perde a corrida do relato nao pode girar para sempre
// nem travar a dona. Esperado: R0008 (bloco heap), exit 101, em menos de 5 s.
import "std:os"

struct Caixa {
    p: ^int
}

foreign {
    link "kernel32"
    proc CreateThread(atributos: u64, pilha: u64, rotina: proc(p: rawptr) -> u32, parametro: rawptr, flags: u32, id: u64) -> u64
    proc WaitForSingleObject(alvo: u64, ms: u32) -> u32
    proc CloseHandle(alvo: u64) -> i32
}

proc rotina(p: rawptr) -> u32 {
    let q = p as ^int
    print(q^)
    return 0
}

proc main() {
    let p = new(int, alloc = heap)
    p^ = 3
    let c = Caixa{p = p}
    delete(p)
    os.multithread_on()
    let h1 = CreateThread(0, pilha = 0, rotina = rotina, parametro = c.p as rawptr, flags = 0, id = 0)
    let h2 = CreateThread(0, pilha = 0, rotina = rotina, parametro = c.p as rawptr, flags = 0, id = 0)
    _ = WaitForSingleObject(h1, ms = 4294967295)
    _ = WaitForSingleObject(h2, ms = 4294967295)
    _ = CloseHandle(h1)
    _ = CloseHandle(h2)
    delete(c.p)
}
