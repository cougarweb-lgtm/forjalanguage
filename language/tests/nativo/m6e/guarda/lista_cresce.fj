// lista_cresce.fj - M6e P93k (P0-1): com --guarda-memoria o crescimento de lista de heap e exato e o alvo vem do pedido: make(len = N), reserve, resize e append items = com varios
// itens terminam (antes o crescer ficava em cap 1 e o laco repetia sem fim). Mesmo stdout com e sem --guarda-memoria: 1000, 5, true, 1003, 2999, 12; exit 0.
proc main() {
    var a = make([dynamic]int, alloc = heap, len = 1000)
    a[999] = 5
    print(len(a))
    print(a[999])
    reserve(&a, 3000)
    print(cap(a) >= 3000)
    var trio: [3]int = {1, 2, 3}
    append(&a, items = trio[..])
    print(len(a))
    resize(&a, len = 3000)
    print(len(a) - 1)
    var b = make([dynamic]int, alloc = heap)
    for i in 0..<12 {
        append(&b, item = i)
    }
    print(len(b))
    delete(a)
    delete(b)
}
