// lista_movida.fj - M6e P93a (--guarda-memoria): append move SEMPRE em guarda; o ^int antigo cai na pagina proibida. Esperado: stdout "1", R0008 tipo lista, exit 101.
proc cresce(l: ^[dynamic]int) {
    append(l, item = 9)
}

proc main() {
    var l = make([dynamic]int, alloc = heap, cap = 1)
    append(&l, item = 1)
    let p = &l[0]
    print(p^)
    cresce(&l)
    print(p^)
}
