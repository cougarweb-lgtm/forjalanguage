// teste_guarda.fj - M6e P93a (--guarda-memoria, forja test): R0008 do uso depois do delete sai ANTES do R0011 do executor de testes. Esperado: exit 101 com R0008 (nao "FALHOU").
struct Caixa {
    p: ^int
}

proc main() {
    print(0)
}

test "uso depois do delete" {
    let p = new(int, alloc = heap)
    p^ = 1
    let c = Caixa{p = p}
    delete(p)
    expect(c.p^ == 1)
    delete(c.p)
}
