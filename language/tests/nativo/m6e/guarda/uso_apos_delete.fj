// uso_apos_delete.fj - M6e P93a (--guarda-memoria): leitura por ponteiro guardado em estrutura depois do delete = R0008 "uso depois do delete" (heap), exit 101, stdout vazio. `let q = p` de heap e E0317 e delete(p) zera o nome, por isso o ponteiro guardado em estrutura (campo).
struct Caixa {
    p: ^int
}

proc main() {
    let p = new(int, alloc = heap)
    p^ = 5
    let c = Caixa{p = p}
    delete(p)
    print(c.p^)
    delete(c.p)
}
