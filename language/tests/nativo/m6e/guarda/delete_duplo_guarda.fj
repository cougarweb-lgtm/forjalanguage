// delete_duplo_guarda.fj - M6e P93a (--guarda-memoria): 2o delete pelo ponteiro guardado em estrutura falha DENTRO do runtime (cabecalho sem commit). Esperado: stdout "antes", R0008 (heap), exit 101.
struct Caixa {
    p: ^int
}

proc main() {
    let p = new(int, alloc = heap)
    p^ = 1
    let c = Caixa{p = p}
    delete(p)
    print("antes")
    delete(c.p)
}
