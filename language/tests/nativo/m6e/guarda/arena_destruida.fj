// arena_destruida.fj - M6e P93a (--guarda-memoria): objeto de Arena usado depois do arena_destroy. Esperado: stdout "2", R0008 tipo arena, exit 101.
import "std:mem"

proc main() {
    let a = mem.arena_create()
    let x = new(int, alloc = a)
    x^ = 2
    print(x^)
    mem.arena_destroy(a)
    print(x^)
}
