// texto_igual.fj - M6e P93k: programa do oraculo --text-igual (D-M6e-10(2), ERRATA E6). Igual ao guarda_ok SEM append/resize/reserve: com --guarda-memoria o BIR muda o codigo dessas operacoes
// (forja_lista_crescer_alvo, P1-8); aqui so alocacao, delete, lista sem crescer e Arena, onde o .text do programa tem de ser igual byte a byte. Saida: "10000", "0", "42"; exit 0.
import "std:mem"

proc main() {
    var l = make([dynamic]int, alloc = heap)
    var soma = 0
    for i in 0..<10000 {
        let p = new(int, alloc = heap)
        p^ = i
        soma += 1
        delete(p)
    }
    print(soma)
    print(len(l))
    let a = mem.arena_create()
    let x = new(int, alloc = a)
    x^ = 42
    print(x^)
    mem.arena_destroy(a)
    delete(l)
}
