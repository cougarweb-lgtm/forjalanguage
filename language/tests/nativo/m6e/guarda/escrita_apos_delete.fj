// escrita_apos_delete.fj - M6e P93a (--guarda-memoria): escrita pelo ponteiro guardado em estrutura depois do delete = R0008 (heap), exit 101, stdout vazio.
struct Caixa {
    p: ^int
}

proc main() {
    let p = new(int, alloc = heap)
    p^ = 5
    let c = Caixa{p = p}
    delete(p)
    c.p^ = 3
    print("nao")
    delete(c.p)
}
