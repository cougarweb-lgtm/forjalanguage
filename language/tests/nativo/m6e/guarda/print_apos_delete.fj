// print_apos_delete.fj - M6e P93k (P0-2, --guarda-memoria, Windows): a falha de guarda acontece DENTRO do print (str liberado impresso) em programa com threads ligadas; o relato nao pode
// pegar a trava do stdout que o proprio print segura. Esperado: R0008 (bloco heap), exit 101, em menos de 5 s (antes: autotravamento).
import "std:os"

proc main() {
    os.multithread_on()
    let s = format(f"texto {7} liberado", alloc = heap)
    delete(s)
    print(s)
}
