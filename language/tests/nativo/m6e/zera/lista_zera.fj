// lista_zera.fj - M6e P93a' (ERRATA E1, controle): delete(l) esvazia a lista e guarda o alocador (len 0, cap 0); append depois do delete funciona (nao e R0007: so ponteiro zera). Esperado: stdout "3", "0", "0", "1", exit 0, sem R0009.
proc main() {
    var l = make([dynamic]int, alloc = heap)
    append(&l, item = 1)
    append(&l, item = 2)
    append(&l, item = 3)
    print(len(l))
    delete(l)
    print(len(l))
    print(cap(l))
    append(&l, item = 5)
    print(len(l))
    delete(l)
}
