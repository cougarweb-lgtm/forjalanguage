// delete_duplo_copia.fj - M6e P93a (D-M6e-4): R0008 de delete duplo pelo ponteiro guardado em estrutura (delete(c.p) nao zera; `let q = p` de heap e E0317). Esperado em dev: exit 101, stdout vazio, R0008 tipo heap com pilha_alocacao [aloca, main], pilha_delete [libera, main], pilha [main].
struct Caixa {
    p: ^int
}

proc aloca() -> Caixa {
    return Caixa{p = new(int, alloc = heap)}
}

proc libera(c: ^Caixa) {
    delete(c^.p)
}

proc main() {
    var c = aloca()
    c.p^ = 1
    libera(&c)
    for i in 0..<10000 {
        let r = new(int, alloc = heap)
        r^ = i
        delete(r)
    }
    delete(c.p)
}
