// custo_aloc.fj - M6e P93a' (D-M6e-10(3), ERRATA E5): gate de custo de alocacao. (1) laco de CUSTO_N new(int)+delete; (2) CUSTO_M listas de heap cap 0 que crescem ate CUSTO_ITENS itens por append e depois delete (mede o append). Checksum impresso; exit 0 e sem R0009 em dev. N e M ficam nestas constantes: medir_custo_base.py le daqui e grava no CUSTO_BASE.txt.
const CUSTO_N: int = 25000000
const CUSTO_M: int = 25000
const CUSTO_ITENS: int = 1000

proc main() {
    var soma: int = 0
    for i in 0..<CUSTO_N {
        let p = new(int, alloc = heap)
        p^ = i
        soma += p^
        delete(p)
    }
    for m in 0..<CUSTO_M {
        var l = make([dynamic]int, alloc = heap)
        for j in 0..<CUSTO_ITENS {
            append(&l, item = j + m)
        }
        soma += l[CUSTO_ITENS - 1]
        delete(l)
    }
    print(soma)
}
