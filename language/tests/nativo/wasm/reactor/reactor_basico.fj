// reactor_basico.fj - reactor: procs export que o host chama depois de instanciar o modulo (sem _start).
// soma e mul cobrem inteiros de 32 e 64 bits; media cobre f64; ler_i32 le um i32 num offset da memoria que o host escreveu; eco devolve o proprio ponteiro (offset i32).
// O proc main vazio existe so porque o semantico exige main na raiz (E0201), como no --modo dll do x64; no reactor ele nunca roda.
// Versao: 0.1.1

proc main() {
}

pub export proc soma(a: i32, b: i32) -> i32 {
    return a + b
}

pub export proc mul(a: int, b: int) -> int {
    return a * b
}

pub export proc media(a: f64, b: f64) -> f64 {
    return (a + b) / 2.0
}

pub export proc ler_i32(p: ^i32) -> i32 {
    return p^
}

pub export proc eco(p: ^i32) -> ^i32 {
    return p
}
