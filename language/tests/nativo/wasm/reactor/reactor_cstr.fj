// reactor_cstr.fj - reactor com export que devolve cstr/?cstr (0.37.0): o modulo ganha o export forja_liberar(offset i32) para o host devolver o texto.
// saudacao devolve "ola <n>"; talvez devolve none (offset 0) quando n < 0 e "n=<n>" nos demais casos; os dois vem de format_c com alloc = heap (o semantico exige o return direto).
// O proc main vazio existe so porque o semantico exige main na raiz (E0201), como no --modo dll do x64; no reactor ele nunca roda.
// Versao: 0.1.0

proc main() {
}

pub export proc saudacao(n: i32) -> cstr {
    return format_c(f"ola {n}", alloc = heap)
}

pub export proc talvez(n: i32) -> ?cstr {
    if n < 0 {
        return none
    }
    return format_c(f"n={n}", alloc = heap)
}
