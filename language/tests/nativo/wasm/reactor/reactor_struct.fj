// reactor_struct.fj - reactor com struct PLANAS por valor (parametro, retorno e sret) e o layout exportado para o host conferir.
// Layout x64 (alinhamento natural): Vec3{x, y, z: f64} tem tamanho 24 (x@0, y@8, z@16); Misto{a: u8, b: i32, c: i64, d: f32} tem tamanho 24 (a@0, b@4, c@8, d@16).
// Convencao wasm: parametro struct = i32 com offset na memoria linear; retorno = i32 sret INICIAL (o proc escreve nele, a funcao wasm devolve void); os demais parametros mantem a ordem.
// Struct aninhada e [N]T por valor ficam fora: E0901 em qualquer alvo (checagem do .h), decisao do principal.
// O proc main vazio existe so porque o semantico exige main na raiz (E0201), como no reactor_basico; no reactor ele nunca roda.
// Versao: 0.2.0

struct Vec3 {
    x: f64
    y: f64
    z: f64
}

struct Misto {
    a: u8
    b: i32
    c: i64
    d: f32
}

pub export proc tam_vec3() -> int {
    return size_of(Vec3) as int
}

pub export proc tam_misto() -> int {
    return size_of(Misto) as int
}

pub export proc off_vec3_y() -> int {
    return offset_of(Vec3.y) as int
}

pub export proc off_vec3_z() -> int {
    return offset_of(Vec3.z) as int
}

pub export proc off_misto_a() -> int {
    return offset_of(Misto.a) as int
}

pub export proc off_misto_b() -> int {
    return offset_of(Misto.b) as int
}

pub export proc off_misto_c() -> int {
    return offset_of(Misto.c) as int
}

pub export proc off_misto_d() -> int {
    return offset_of(Misto.d) as int
}

pub export proc vetor_fixo() -> Vec3 {
    return Vec3{x = 1.0, y = 2.0, z = 3.0}
}

pub export proc soma(v: Vec3) -> f64 {
    return v.x + v.y + v.z
}

pub export proc dobra(v: Vec3) -> Vec3 {
    return Vec3{x = v.x * 2.0, y = v.y * 2.0, z = v.z * 2.0}
}

pub export proc dobra_duas(v: Vec3) -> Vec3 {
    return dobra(dobra(v))
}

pub export proc mistura(k: i32, m: Misto, w: Vec3) -> Misto {
    return Misto{a = m.a + (k as u8), b = m.b + (w.x as i32), c = m.c * 2, d = m.d + 0.5}
}

pub export proc empilha(v: Vec3, n: i32) -> Vec3 {
    if n == 0 {
        return v
    }
    return empilha(dobra(v), n - 1)
}

proc main() {
}
