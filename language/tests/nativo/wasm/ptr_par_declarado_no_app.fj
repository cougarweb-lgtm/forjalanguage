// Fixture W0 do backend wasm: app que declara o par endereco_de/ponteiro_de.
// A sema aceita (foreign sem link); o backend NAO pode resolver o par fora da pasta do runtime.
// Esperado (verificar_par_ponteiro.py): `forja check` sai 0 e `forja build` recusa com X0101.
foreign {
    proc endereco_de(p: rawptr) -> uint
    proc ponteiro_de(n: uint) -> rawptr
}

proc main() {
    let n: uint = 4096
    let p = ponteiro_de(n)
    print(endereco_de(p) == n)
}
