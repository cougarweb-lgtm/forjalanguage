// 0.36.0: forja test acusa vazamento de heap por teste (dev, R0009): "vaza tres" passa nos expect mas deixa 3 blocos vivos e FALHA; os vizinhos passam.
struct Caixa {
    valor: i32 = 7
}

proc criar() -> ^Caixa {
    return new(Caixa, alloc = heap)
}

test "soma" {
    let c = criar()
    defer delete(c)
    expect(c.valor == 7)
}

test "vaza tres" {
    for i in 0..<3 {
        let c = criar()
        expect(c.valor == 7)
    }
}

test "depois" {
    let c = criar()
    defer delete(c)
    expect(c.valor == 7)
}

proc main() {
    let c = criar()
    defer delete(c)
    print(c.valor)
}
