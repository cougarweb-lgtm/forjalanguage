// 0.36.0: forja run (dev): bloco de heap vivo no fim do programa = R0009 e exit 101, depois de a saida normal sair; em release nao ha checagem (exit 0).
struct Caixa {
    valor: i32 = 7
}

proc criar() -> ^Caixa {
    return new(Caixa, alloc = heap)
}

proc main() {
    let c = criar()
    print(c.valor)
}
