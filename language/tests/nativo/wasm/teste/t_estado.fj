import "std:text"

struct Conta {
    saldo: int
}

proc depositar(c: ^Conta, valor: int) {
    c.saldo += valor
}

test "lista no heap e liberada" {
    var l = make([dynamic]int, alloc = heap, cap = 4)
    defer delete(l)
    append(&l, item = 7)
    append(&l, item = 9)
    expect(len(l) == 2)
    expect(l[1] == 9)
}

test "texto formatado" {
    let s = format(f"vida {7} x={3:03}", alloc = heap)
    defer delete(s)
    expect(s == "vida 7 x=003")
}

test "titulo com \"aspas\" e acentuação ção" {
    expect(1 + 1 == 3)
}

test "struct por ponteiro" {
    var c = Conta{saldo = 10}
    depositar(&c, 5)
    expect(c.saldo == 15)
    expect(c.saldo == 16)
}

test "conversao fora da faixa" {
    var v: i32 = 2147483647
    v += 1
    expect(v > 0)
}

test "ultimo passa" {
    expect(text.parse_int("42") or_else 0 == 42)
}

proc main() {
    print("estado")
}
