// 20 testes: o vetor de registro do executor wasm cresce acima de 16 entradas; 3 caem por expect e 2 por falha de execucao
proc quadrado(n: int) -> int {
    return n * n
}

test "t01" {
    expect(quadrado(1) == 1)
}

test "t02" {
    expect(quadrado(2) == 4)
}

test "t03" {
    expect(quadrado(3) == 10)
}

test "t04" {
    expect(quadrado(4) == 16)
}

test "t05" {
    expect(quadrado(5) == 25)
}

test "t06" {
    let a: [2]int = {1, 2}
    var i: int = 2
    i += quadrado(0)
    expect(a[i] == 1)
}

test "t07" {
    expect(quadrado(7) == 49)
}

test "t08" {
    expect(quadrado(8) == 63)
}

test "t09" {
    expect(quadrado(9) == 81)
}

test "t10" {
    expect(quadrado(10) == 100)
}

test "t11" {
    expect(quadrado(11) == 121)
}

test "t12" {
    panic("t12 caiu")
}

test "t13" {
    expect(quadrado(13) == 169)
}

test "t14" {
    expect(quadrado(14) == 196)
}

test "t15" {
    expect(quadrado(15) == 225)
}

test "t16" {
    expect(quadrado(16) == 256)
}

test "t17" {
    expect(quadrado(17) == 288)
}

test "t18" {
    expect(quadrado(18) == 324)
}

test "t19" {
    expect(quadrado(19) == 361)
}

test "t20" {
    expect(quadrado(20) == 400)
}

proc main() {
    print(quadrado(3))
}
