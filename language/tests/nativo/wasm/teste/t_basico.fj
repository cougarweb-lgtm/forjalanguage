proc dobro(n: int) -> int {
    return n * 2
}

test "soma ok" {
    expect(dobro(2) == 4)
}

test "expect falha" {
    expect(dobro(2) == 5)
    expect(dobro(3) == 7)
}

test "indice fora" {
    let a: [3]int = {1, 2, 3}
    var i: int = 5
    i += dobro(0)
    expect(a[i] == 0)
}

test "assert falha" {
    assert(dobro(1) == 3, msg = "dobro quebrou")
}

test "panic" {
    panic("boom")
}

test "depois ok" {
    expect(true)
}

proc main() {
    print(dobro(4))
}
