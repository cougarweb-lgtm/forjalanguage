// print e f"..." de f32/f64 no alvo wasm (std:wasm_real, 0.30.0): bordas do texto curto (Ryu) e da precisao exata, iguais ao x64
// Verificacao: python tests\nativo\wasm\verificar_wasm.py --modos dev,release --filtro real_bordas
proc mostrar64(v: f64) {
    print(v)
    print(f"{v:.0}|{v:.1}|{v:.3}|{v:.6}|{v:.12}|{v:.17}")
    print(f"[{v:12.2}][{v:012.3}]")
}

proc mostrar32(v: f32) {
    print(v)
    print(f"{v:.0}|{v:.2}|{v:.9}|{v:.17}")
}

proc dobro_de_bits(bits: u64) -> f64 {
    return transmute(bits, to = f64)
}

proc main() {
    mostrar64(0.0)
    mostrar64(dobro_de_bits(0x8000000000000000)) // -0
    mostrar64(1.0)
    mostrar64(-1.0)
    mostrar64(0.1)
    mostrar64(0.3)
    mostrar64(1.0 / 3.0)
    mostrar64(2.5)
    mostrar64(0.5)
    mostrar64(123456789.125)
    mostrar64(10000000000000000000000.0) // 1e22
    mostrar64(0.0000000001) // 1e-10
    mostrar64(dobro_de_bits(1)) // 5e-324, o menor subnormal
    mostrar64(dobro_de_bits(0x7FEFFFFFFFFFFFFF)) // maior finito
    mostrar64(dobro_de_bits(0x0010000000000000)) // menor normal
    mostrar64(dobro_de_bits(0x7FF0000000000000)) // inf
    mostrar64(dobro_de_bits(0xFFF0000000000000)) // -inf
    mostrar64(dobro_de_bits(0x7FF8000000000000)) // nan
    mostrar32(0.0)
    mostrar32(1.0)
    mostrar32(0.1)
    mostrar32(16777216.0)
    mostrar32(transmute(0x7F7FFFFF as u32, to = f32)) // maior f32 finito
    mostrar32(transmute(1 as u32, to = f32)) // menor subnormal f32
    mostrar32(-2.5)
}
