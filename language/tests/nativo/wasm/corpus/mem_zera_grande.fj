// mem_zera_grande.fj - array e struct de 128 B criados zerados com `{}`; a soma tem de dar 0.
// Depois de alterar um elemento, a soma e o elemento sao impressos de novo.

struct Bloco {
    d: [16]int
}

proc soma_bloco(b: ^Bloco) -> int {
    var s = 0
    for i in 0..<16 {
        s += b.d[i]
    }
    return s
}

proc main() {
    var arr: [16]int = {}
    var soma = 0
    for i in 0..<16 {
        soma += arr[i]
    }
    print(soma)
    arr[3] = 5
    var soma2 = 0
    for i in 0..<16 {
        soma2 += arr[i]
    }
    print(soma2)

    var blk = Bloco{d = {}}
    print(soma_bloco(&blk))
    blk.d[9] = 41
    print(soma_bloco(&blk))
    print(blk.d[9])
}
