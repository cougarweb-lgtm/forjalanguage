// K17 (heap_push / heap_pop): min-heap de int; pop devolve o menor; lista vazia = none (-1). Saida: 6, 1 3 4 5 7 9, -1, 0.
proc main() {
    var h = make([dynamic]int, alloc = heap)
    heap_push(&h, 5)
    heap_push(&h, 3)
    heap_push(&h, 9)
    heap_push(&h, 1)
    heap_push(&h, 7)
    heap_push(&h, 4)
    print(len(h))
    print(heap_pop(&h) or_else -1)
    print(heap_pop(&h) or_else -1)
    print(heap_pop(&h) or_else -1)
    print(heap_pop(&h) or_else -1)
    print(heap_pop(&h) or_else -1)
    print(heap_pop(&h) or_else -1)
    print(heap_pop(&h) or_else -1)
    print(len(h))
    delete(h)
}
