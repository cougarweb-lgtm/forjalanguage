// Fixture W2-M2 do backend wasm: lista de int (200000 appends, cresce varias vezes), lista pequena e lista de struct de 24 B.
// Exercita forja_lista_criar/crescer/liberar e mem_liberar do rt_wasm.fj (alocador heap). So imprime int e bool.
struct Trio {
    a: int
    b: int
    c: int
}

proc main() {
    var grande = make([dynamic]int, alloc = heap)
    defer delete(grande)
    for i in 0..<200000 {
        append(&grande, item = i)
    }
    print(len(grande))
    print(cap(grande) >= len(grande))
    var soma: int = 0
    for x in grande {
        soma += x
    }
    print(soma)
    print(grande[0] == 0)
    print(grande[199999] == 199999)

    var pequena = make([dynamic]int, alloc = heap)
    defer delete(pequena)
    for i in 0..<5 {
        append(&pequena, item = i * 3)
    }
    print(sum(pequena[..]))

    var trios = make([dynamic]Trio, alloc = heap)
    defer delete(trios)
    for i in 0..<100 {
        append(&trios, item = Trio{a = i, b = i * 2, c = i * 3})
    }
    print(len(trios))
    print(trios[99].c == 297)
    print(trios[50].b == 100)
}
