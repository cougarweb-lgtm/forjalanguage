}

proc main() {
    roda_exp_f64(88172645463325252)
    roda_exp2_f64(88172645463325253)
    roda_log_f64(88172645463325254)
    roda_log2_f64(88172645463325255)
    roda_log10_f64(88172645463325256)
    roda_exp_f32(88172645463325257)
    roda_exp2_f32(88172645463325258)
    roda_log_f32(88172645463325259)
    roda_log2_f32(88172645463325260)
    roda_log10_f32(88172645463325261)
}
