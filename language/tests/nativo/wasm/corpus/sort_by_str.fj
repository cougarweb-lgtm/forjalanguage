// K08a (sort_by): str como elemento. less compara por tamanho: os de mesmo tamanho mantem a ordem original (estavel).
proc menor_tamanho(a: ^str, b: ^str) -> bool {
    return len(a^) < len(b^)
}

proc main() {
    var palavras: [6]str = {"bbb", "a", "cc", "d", "eeee", "ff"}
    sort_by(palavras[..], less = menor_tamanho)
    for x in palavras {
        print(x)
    }
}
