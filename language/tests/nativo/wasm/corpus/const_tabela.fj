// const de array escalar no alvo wasm: o dado vai a [BASE_DADOS, ...) como BS_DADO (0.30.0) e a leitura por indice sai da memoria linear
// Verificacao: python tests\nativo\wasm\verificar_wasm.py --modos dev,release --filtro const_tabela
const PRIMOS: [8]int = {2, 3, 5, 7, 11, 13, 17, 19}
const PESOS: [4]u64 = {0x0123456789ABCDEF, 1, 0xFFFFFFFFFFFFFFFF, 40}
const FATORES: [3]f64 = {0.5, 2.25, 1000.0}
const BYTES: [5]u8 = {1, 2, 3, 250, 255}

proc soma_primos() -> int {
    var total = 0
    for i in 0..<8 {
        total += PRIMOS[i]
    }
    return total
}

proc main() {
    print(soma_primos())
    print(PESOS[0])
    print(PESOS[2])
    print(PESOS[3] + PESOS[1])
    print((FATORES[1] * FATORES[2]) as int) // print de real fica para o std:wasm_real
    var soma_bytes: int = 0
    for i in 0..<5 {
        soma_bytes += BYTES[i] as int
    }
    print(soma_bytes)
}
