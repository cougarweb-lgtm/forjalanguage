// mem_param_struct.fj - structs de 8 B e 24 B recebidas POR VALOR; a proc altera a copia local
// e o chamador nao ve. Caso de alias: f(v, &v) - a proc altera por ponteiro e o valor recebido continua o mesmo.
// Esperado: 5, 105, 5, 0, 1, 2, 3, 7, 999.

struct Par {
    a: int
}

struct Trio {
    a: int
    b: int
    c: int
}

proc muda_par(p: Par) -> int {
    var c = p
    c.a = c.a + 100
    return c.a
}

proc zera_trio(t: Trio) -> int {
    var c = t
    c.a = 0
    c.b = 0
    c.c = 0
    return c.a + c.b + c.c
}

proc alias_teste(v: Par, p: ^Par) -> int {
    p.a = 999
    return v.a
}

proc main() {
    let s = Par{a = 5}
    print(s.a)
    print(muda_par(s))
    print(s.a)

    let t = Trio{a = 1, b = 2, c = 3}
    print(zera_trio(t))
    print(t.a)
    print(t.b)
    print(t.c)

    var q = Par{a = 7}
    print(alias_teste(q, &q))
    print(q.a)
}
