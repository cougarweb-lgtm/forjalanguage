// std:math no alvo wasm (math_g5, 0.31.0): pow, em f64 e em f32, 1500 entradas de um LCG por funcao mais os valores especiais;
// imprime os BITS de cada resultado (NaN = um padrao so). wasm = x64 (musl em C) byte a byte, em dev e em release.
// GERADO por tests\nativo\wasm\math_bits\gerar_math_bits.py: nao editar a mao.
// Verificacao: python tests\nativo\wasm\verificar_wasm.py --modos dev,release --filtro math_g5
import "std:math" as math
const PASSOS: int = 1500
const ESPECIAIS64: [30]u64 = {0x0000000000000000, 0x8000000000000000, 0x7ff0000000000000, 0xfff0000000000000, 0x7ff8000000000000, 0x3ff0000000000000, 0xbff0000000000000, 0x3fe0000000000000, 0x4000000000000000, 0x4008000000000000, 0x4024000000000000, 0x7fefffffffffffff, 0x0000000000000001, 0x0010000000000000, 0x3ff921fb54442d18, 0x400921fb54442d18, 0x4415af1d78b58c40, 0x41e0000000000000, 0x43e0000000000000, 0xc3e0000000000000, 0x3c90000000000000, 0x4059000000000000, 0x40862e42fefa39ef, 0x4086232bdd7abcd2, 0xc0874910d52d3051, 0x3ff8000000000000, 0x3fd3333333333333, 0x000fffffffffffff, 0x3feffffffffffffe, 0x3ff0000000000001}
const ESPECIAIS32: [28]u32 = {0x00000000, 0x80000000, 0x7f800000, 0xff800000, 0x7fc00000, 0x3f800000, 0xbf800000, 0x3f000000, 0x40000000, 0x40400000, 0x41200000, 0x7f7fffff, 0x00000001, 0x00800000, 0x3fc90fdb, 0x40490fdb, 0x5f000000, 0xdf000000, 0x42b17218, 0x42b00000, 0xc2cff1b4, 0x42c80000, 0x3f7ffffe, 0x3f800001, 0x007fffff, 0x3e99999a, 0x4b800000, 0x33800000}

proc proximo(estado: u64) -> u64 {
    return wrapping_add(wrapping_mul(estado, 6364136223846793005), 1442695040888963407)
}

proc entrada64(estado: u64, k: int) -> f64 {
    let sel: int = k % 4
    if sel == 0 {
        return transmute(estado, to = f64)
    }
    let u: f64 = ((estado >> 11) as f64) / 9007199254740992.0
    if sel == 1 {
        return (u - 0.5) * 40.0
    }
    if sel == 2 {
        return (u - 0.5) * 2000.0
    }
    return (u - 0.5) * 4.0
}

proc entrada32(estado: u64, k: int) -> f32 {
    let sel: int = k % 4
    if sel == 0 {
        return transmute((estado >> 32) as u32, to = f32)
    }
    return entrada64(estado, k) as f32
}

proc bits64(r: f64) -> u64 {
    if r != r {
        return 0x7ff8000000000000
    }
    return transmute(r, to = u64)
}

proc bits32(r: f32) -> u32 {
    if r != r {
        return 0x7fc00000
    }
    return transmute(r, to = u32)
}

proc roda_pow_f64(estado0: u64) {
    print("pow f64")
    for e in 0..<len(ESPECIAIS64) {
        for d in 0..<len(ESPECIAIS64) {
            let x: f64 = transmute(ESPECIAIS64[e], to = f64)
            let y: f64 = transmute(ESPECIAIS64[d], to = f64)
            print(bits64(math.pow(x, y)))
        }
    }
    var estado: u64 = estado0
    for i in 0..<PASSOS {
        estado = proximo(estado)
        let x: f64 = entrada64(estado, i)
        estado = proximo(estado)
        let y: f64 = entrada64(estado, (i / 4) + 1)
        print(bits64(math.pow(x, y)))
    }
}

proc roda_pow_f32(estado0: u64) {
    print("pow f32")
    for e in 0..<len(ESPECIAIS32) {
        for d in 0..<len(ESPECIAIS32) {
            let x: f32 = transmute(ESPECIAIS32[e], to = f32)
            let y: f32 = transmute(ESPECIAIS32[d], to = f32)
            print(bits32(math.pow(x, y)))
        }
    }
    var estado: u64 = estado0
    for i in 0..<PASSOS {
        estado = proximo(estado)
        let x: f32 = entrada32(estado, i)
        estado = proximo(estado)
        let y: f32 = entrada32(estado, (i / 4) + 1)
        print(bits32(math.pow(x, y)))
    }
}

proc main() {
    roda_pow_f64(88172645463325252)
    roda_pow_f32(88172645463325253)
}
