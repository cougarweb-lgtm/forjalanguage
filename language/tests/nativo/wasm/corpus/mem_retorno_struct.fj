// mem_retorno_struct.fj - procs que devolvem struct de 8 B (1 int) e de 24 B (3 int); imprime os campos.
// Esperado: 42, 10, 11, 12, 3, 4, 5, 500.

struct Um {
    a: int
}

struct Tres {
    a: int
    b: int
    c: int
}

proc faz_um(n: int) -> Um {
    return Um{a = n * 2}
}

proc faz_tres(n: int) -> Tres {
    return Tres{a = n, b = n + 1, c = n + 2}
}

proc main() {
    let u = faz_um(21)
    print(u.a)
    let t = faz_tres(10)
    print(t.a)
    print(t.b)
    print(t.c)
    let t2 = faz_tres(3)
    print(t2.a)
    print(t2.b)
    print(t2.c)
    let t3 = faz_tres(498)
    print(t3.c)
}
