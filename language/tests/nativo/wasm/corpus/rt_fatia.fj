// rt_fatia.fj - a[lo..<hi] com limite dinamico: ok em 1..<4 e R0006 "fatia 2..<6 fora de 0..=5" (dev e release com checagem), exit 101.

proc pedaco(a: ^[5]int, lo: int, hi: int) -> int {
    let s = a^[lo..<hi]
    return len(s)
}

proc main() {
    var a: [5]int = {1, 2, 3, 4, 5}
    print(pedaco(&a, 1, 4))
    print(pedaco(&a, 0, 5))
    print(pedaco(&a, 2, 6))
}
