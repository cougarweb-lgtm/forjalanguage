// slice_from(p, len = n) no alvo wasm (0.30.0): fatia emprestada de um ponteiro; len 0 e a fatia vazia
// Verificacao: python tests\nativo\wasm\verificar_wasm.py --modos dev,release --filtro slice_from
proc soma(v: []int) -> int {
    var total = 0
    for x in v {
        total += x
    }
    return total
}

proc main() {
    var a: [4]int = {10, 20, 30, 40}
    let tres = slice_from(&a[0], len = 3)
    print(len(tres))
    print(tres[2])
    print(soma(tres))
    let vazia = slice_from(&a[0], len = 0)
    print(len(vazia))
}
