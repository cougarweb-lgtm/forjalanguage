// ov_faixas_ok.fj - contas checadas nos limites de cada classe, SEM estourar: o wasm nao pode acusar estouro falso.

proc soma8(a: i8, b: i8) -> i8 {
    return a + b
}

proc sub8(a: i8, b: i8) -> i8 {
    return a - b
}

proc mul8(a: i8, b: i8) -> i8 {
    return a * b
}

proc somau8(a: u8, b: u8) -> u8 {
    return a + b
}

proc subu8(a: u8, b: u8) -> u8 {
    return a - b
}

proc mulu8(a: u8, b: u8) -> u8 {
    return a * b
}

proc mul16(a: i16, b: i16) -> i16 {
    return a * b
}

proc soma16(a: i16, b: i16) -> i16 {
    return a + b
}

proc somau16(a: u16, b: u16) -> u16 {
    return a + b
}

proc mulu16(a: u16, b: u16) -> u16 {
    return a * b
}

proc soma32(a: i32, b: i32) -> i32 {
    return a + b
}

proc sub32(a: i32, b: i32) -> i32 {
    return a - b
}

proc mul32(a: i32, b: i32) -> i32 {
    return a * b
}

proc nega32(a: i32) -> i32 {
    return -a
}

proc somau32(a: u32, b: u32) -> u32 {
    return a + b
}

proc subu32(a: u32, b: u32) -> u32 {
    return a - b
}

proc mulu32(a: u32, b: u32) -> u32 {
    return a * b
}

proc soma64(a: int, b: int) -> int {
    return a + b
}

proc sub64(a: int, b: int) -> int {
    return a - b
}

proc mul64(a: int, b: int) -> int {
    return a * b
}

proc nega64(a: int) -> int {
    return -a
}

proc somau64(a: uint, b: uint) -> uint {
    return a + b
}

proc subu64(a: uint, b: uint) -> uint {
    return a - b
}

proc mulu64(a: uint, b: uint) -> uint {
    return a * b
}

proc main() {
    print(soma8(100, 27) as int)
    print(soma8(-100, -28) as int)
    print(sub8(-128, 0) as int)
    print(mul8(-64, 2) as int)
    print(somau8(200, 55) as int)
    print(subu8(255, 255) as int)
    print(mulu8(15, 17) as int)
    print(mul16(181, 181) as int)
    print(soma16(-32768, 0) as int)
    print(somau16(65535, 0) as int)
    print(mulu16(255, 257) as int)
    print(soma32(2147483646, 1))
    print(sub32(-2147483647, 1))
    print(mul32(46340, 46340))
    print(nega32(2147483647))
    print(somau32(4294967295, 0))
    print(subu32(4294967295, 4294967295))
    print(mulu32(65535, 65537))
    print(soma64(9223372036854775806, 1))
    print(sub64(-9223372036854775807, 1))
    print(mul64(3037000499, 3037000499))
    print(mul64(-1, 9223372036854775807))
    print(mul64(0, -9223372036854775807 - 1))
    print(mul64(-9223372036854775807 - 1, 1))
    print(mul64(1, -9223372036854775807 - 1))
    print(nega64(9223372036854775807))
    print(somau64(18446744073709551615, 0))
    print(subu64(18446744073709551615, 18446744073709551615))
    print(mulu64(4294967295, 4294967297))
}
