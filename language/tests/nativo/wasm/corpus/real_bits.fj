// print e f"..." de f32/f64 no alvo wasm (std:wasm_real, 0.30.0): 3000 padroes de bits de um LCG, impressos curtos e com precisao; wasm = x64 byte a byte
// (nan/inf caem pelo mesmo caminho; o sinal do nan nao e impresso). Verificacao: python tests\nativo\wasm\verificar_wasm.py --modos dev,release --filtro real_bits
const PASSOS: int = 3000

proc proximo(estado: u64) -> u64 {
    return wrapping_add(wrapping_mul(estado, 6364136223846793005), 1442695040888963407)
}

proc main() {
    var estado: u64 = 88172645463325252
    for _i in 0..<PASSOS {
        estado = proximo(estado)
        let v64: f64 = transmute(estado, to = f64)
        let baixo: u32 = (estado >> 32) as u32
        let v32: f32 = transmute(baixo, to = f32)
        print(f"{v64}")
        print(f"{v64:.3}|{v64:.17}")
        print(f"{v32}")
        print(f"{v32:.2}|{v32:.9}")
    }
}
