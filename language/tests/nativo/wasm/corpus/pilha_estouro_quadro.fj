// pilha_estouro_quadro.fj - array local de 1100000 int (8,8 MB) estoura a pilha sombra do wasm no prologo (R0016 antes do unreachable) e a pilha de 8 MiB do x64 (R0016 pelo driver), exit 101
// Verificacao: python tests\nativo\wasm\verificar_wasm.py --modos dev,release --filtro pilha_estouro_quadro
proc enche(n: int) -> int {
    var a: [1100000]int = {}
    a[0] = n
    return a[0]
}

proc main() {
    print(enche(5))
}
