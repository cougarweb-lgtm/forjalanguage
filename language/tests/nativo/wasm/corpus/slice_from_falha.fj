// slice_from com len negativo no alvo wasm (0.30.0): R0006 "slice_from com len -2 negativo", exit 101 (dev; no release a checagem nao existe, como no x64)
// Verificacao: python tests\nativo\wasm\verificar_wasm.py --modos dev --filtro slice_from_falha
proc fatia(p: ^int, n: int) -> int {
    let s = slice_from(p, len = n)
    return len(s)
}

proc main() {
    var a: [2]int = {1, 2}
    print(fatia(&a[0], 2))
    print(fatia(&a[0], 0 - 2))
}
