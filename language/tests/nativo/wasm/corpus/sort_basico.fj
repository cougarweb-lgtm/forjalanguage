// L-06 (IA1-L5b): sort(fatia) embutido, em ordem crescente, para inteiros (todas as larguras), reais e str. Valores repetidos, ja ordenado, ao contrario, volume pseudoaleatorio e subfatia.
proc confere_int(v: []int) -> int {
    var ruim = 0
    for i in 1..<len(v) {
        if v[i - 1] > v[i] {
            ruim += 1
        }
    }
    return ruim
}

proc main() {
    var a: [6]int = {5, 3, 9, 1, 7, 3}
    sort(a[..])
    for x in a {
        print(x)
    }

    var u8s: [5]u8 = {200, 3, 255, 0, 3}
    sort(u8s[..])
    print(u8s[0])
    print(u8s[4])
    var i8s: [5]i8 = {-3, 100, -128, 127, 0}
    sort(i8s[..])
    print(i8s[0])
    print(i8s[1])
    print(i8s[4])
    var u16s: [4]u16 = {65535, 1, 300, 2}
    sort(u16s[..])
    print(u16s[0])
    print(u16s[3])
    var i32s: [4]i32 = {-5, 5, -2000000000, 2000000000}
    sort(i32s[..])
    print(i32s[0])
    print(i32s[3])
    var u64s: [3]u64 = {18446744073709551615, 0, 1}
    sort(u64s[..])
    print(u64s[2] == 18446744073709551615)
    print(u64s[0])
    var i64s: [3]i64 = {9, -9223372036854775807, 0}
    sort(i64s[..])
    print(i64s[0])

    var f: [5]f64 = {2.5, -1.0, 0.0, 10.0, -7.25}
    sort(f[..])
    print(f[0] as int)
    print(f[1] as int)
    print(f[4] as int)
    var g: [4]f32 = {3.5, 1.5, 2.5, -0.5}
    sort(g[..])
    print(g[0] == -0.5)
    print(g[3] == 3.5)

    var s: [5]str = {"b", "abc", "ab", "", "abd"}
    sort(s[..])
    for x in s {
        print(x)
    }

    var pronto: [4]int = {1, 2, 3, 4}
    sort(pronto[..])
    print(confere_int(pronto[..]))
    var contra: [4]int = {4, 3, 2, 1}
    sort(contra[..])
    print(confere_int(contra[..]))
    var iguais: [5]int = {7, 7, 7, 7, 7}
    sort(iguais[..])
    print(iguais[2])
    var vazio: [3]int = {3, 2, 1}
    sort(vazio[1..<1])
    print(vazio[0])

    var meio: [6]int = {9, 8, 7, 6, 5, 4}
    sort(meio[1..<5])
    print(meio[0])
    print(meio[1])
    print(meio[4])
    print(meio[5])

    var l = make([dynamic]int, alloc = heap)
    var x = 12345
    for i in 0..<5000 {
        x = (x * 1103 + 12345) % 65521
        append(&l, item = x % 1000)
    }
    sort(l[..])
    print(confere_int(l[..]))
    var lc = make([dynamic]int, alloc = heap)
    for i in 0..<3000 {
        append(&lc, item = 3000 - i)
    }
    sort(lc[..])
    print(confere_int(lc[..]))
    print(lc[0])
    print(lc[2999])
    delete(l)
    delete(lc)
}
