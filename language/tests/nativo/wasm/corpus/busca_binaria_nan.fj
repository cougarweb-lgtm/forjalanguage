// K08b (binary_search): f64 com NaN no fim. 2.0 acha na posicao 1; NaN nunca e achado (lower bound 2, nao achou).
proc main() {
    let menos_um: f64 = -1.0
    let nan = sqrt(menos_um)
    var a: [3]f64 = {1.0, 2.0, nan}
    let i, ok = binary_search(a[..], value = 2.0)
    print(i)
    print(ok)
    let j, achou = binary_search(a[..], value = nan)
    print(j)
    print(achou)
}
