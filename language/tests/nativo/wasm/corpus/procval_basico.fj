// procval_basico.fj - proc como valor (0.32.0): callback inteiro, sem retorno, ponteiro, real, bool e ponteiro numa variavel de proc (o sort_by fica de fora: forja_ordenar_estavel ainda nao existe no runtime wasm).
// stdout e exit tem de bater entre x64 e wasm.
struct Contador {
    n: int
}

proc dobro(x: int) -> int {
    return x * 2
}

proc triplo(x: int) -> int {
    return x * 3
}

proc aplica(f: proc(x: int) -> int, v: int) -> int {
    return f(v)
}

proc soma_um(c: ^Contador) {
    c.n += 1
}

proc repete(f: proc(c: ^Contador), c: ^Contador, vezes: int) {
    for _i in 0..<vezes {
        f(c)
    }
}

proc metade(x: f64) -> f64 {
    return x / 2.0
}

proc usa_real(f: proc(x: f64) -> f64, v: f64) -> f64 {
    return f(v)
}

proc par(x: int) -> bool {
    return x - x / 2 * 2 == 0
}

proc filtra(f: proc(x: int) -> bool, v: int) -> int {
    if f(v) {
        return 1
    }
    return 0
}

proc antes(a: ^int, b: ^int) -> bool {
    return a^ < b^
}

proc main() {
    print(aplica(dobro, 21))
    print(aplica(triplo, 14))
    var c = Contador{n = 0}
    repete(soma_um, &c, 5)
    print(c.n)
    print(usa_real(metade, 9.0))
    print(filtra(par, 10))
    print(filtra(par, 7))
    var a = 4
    var b = 2
    a += 1
    b += 1
    print(antes(&a, &b))
    let comparar = antes
    print(comparar(&b, &a))
}
