// K08b (sort_by_key): chave f64 com NaN. A ordem e -3.0, 1.0, 2.5 e depois os NaN (so por ultimo); os dois NaN ficam na ordem original (seq 1 antes de seq 4).
struct Ponto {
    peso: f64
    seq: int
}

proc main() {
    var l = make([dynamic]Ponto, alloc = heap)
    let menos_um: f64 = -1.0
    let nan = sqrt(menos_um)
    append(&l, item = Ponto{peso = 2.5, seq = 0})
    append(&l, item = Ponto{peso = nan, seq = 1})
    append(&l, item = Ponto{peso = 1.0, seq = 2})
    append(&l, item = Ponto{peso = -3.0, seq = 3})
    append(&l, item = Ponto{peso = nan, seq = 4})
    sort_by_key(l[..], key = Ponto.peso)
    print(l[0].seq)
    print(l[1].seq)
    print(l[2].seq)
    print(l[3].seq)
    print(l[4].seq)
    delete(l)
}
