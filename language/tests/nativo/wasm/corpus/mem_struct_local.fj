// mem_struct_local.fj - struct local de 3 campos int; &s passa o endereco e a proc altera o campo pelo ponteiro.

struct Ponto {
    x: int
    y: int
    z: int
}

proc ajusta(p: ^Ponto) {
    p.y = p.x + p.z
}

proc main() {
    var s = Ponto{x = 3, y = 4, z = 5}
    ajusta(&s)
    print(s.x)
    print(s.y)
    print(s.z)
}
