// K08b (sort_by_key): chave str, byte a byte e depois o tamanho. "ana" (seq 1) antes de "ana" (seq 2) pela ordem original; "ana" antes de "anab".
struct Pessoa {
    nome: str
    seq: int
}

proc main() {
    var l = make([dynamic]Pessoa, alloc = heap)
    append(&l, item = Pessoa{nome = "bob", seq = 0})
    append(&l, item = Pessoa{nome = "ana", seq = 1})
    append(&l, item = Pessoa{nome = "carlos", seq = 2})
    append(&l, item = Pessoa{nome = "ana", seq = 3})
    append(&l, item = Pessoa{nome = "anab", seq = 4})
    sort_by_key(l[..], key = Pessoa.nome)
    print(l[0].seq)
    print(l[1].seq)
    print(l[2].seq)
    print(l[3].seq)
    print(l[4].seq)
    delete(l)
}
