// 0.36.0: tudo o que o programa aloca no heap e solta (new/delete, lista que cresce, format e to_str com delete, sort e heap_push): nenhum R0009, exit 0.
struct Caixa {
    valor: i32 = 7
    peso: i64 = 0
}

proc main() {
    let a = new(Caixa, alloc = heap)
    let b = new(Caixa, alloc = heap)
    a.peso = 5
    b.peso = 9
    print(a.valor + b.valor)
    delete(b)
    delete(a)
    var v = make([dynamic]int, alloc = heap)
    for i in 0..<40 {
        append(&v, item = 40 - i)
    }
    sort(v[..])
    print(v[0])
    print(v[39])
    delete(v)
    var h = make([dynamic]int, alloc = heap)
    heap_push(&h, 3)
    heap_push(&h, 1)
    heap_push(&h, 2)
    print(heap_pop(&h) or_else -1)
    delete(h)
    let s = format(f"{1}-{2}", alloc = heap)
    print(len(s))
    delete(s)
    var buf = make([dynamic]u8, alloc = heap)
    defer delete(buf)
    append(&buf, item = "texto")
    let t = to_str(&buf)
    print(t)
    delete(t)
}
