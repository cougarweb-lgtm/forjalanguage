// f"..." no wasm: int/uint/bool/str, largura, zeros, hexa, negativo, u64 grande, format em buffer e em heap
proc main() {
    let x: int = -42
    let u: uint = 7
    let big: uint = 18446744073709551615
    let minimo: int = -9223372036854775807 - 1
    let ok: bool = true
    let nome: str = "ana"
    print(f"int {x} uint {u} bool {ok} str {nome}")
    print(f"pad {u:03} larg [{x:5}] hex {big:x} u64 {big}")
    print(f"min {minimo} neg {x:06}|")
    var buf = make([dynamic]u8, alloc = heap)
    defer delete(buf)
    format(f"buf {x} {u} {ok}", into = &buf)
    let texto = to_str(&buf)
    defer delete(texto)
    print(f"{texto}")
    let a = format(f"alloc {nome} {minimo}", alloc = heap)
    defer delete(a)
    print(f"{a}")
}
