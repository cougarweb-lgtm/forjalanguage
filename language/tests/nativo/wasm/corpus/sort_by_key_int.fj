// K08b (sort_by_key): chave inteira, ordenacao ESTAVEL com mais de 50 elementos (passa dos blocos de 20). Chaves repetidas (i % 5): os iguais saem na ordem original.
struct Item {
    chave: int
    seq: int
}

proc confere_estavel(v: []Item) -> int {
    var ruins = 0
    for i in 1..<len(v) {
        if v[i - 1].chave > v[i].chave {
            ruins += 1
        }
        if v[i - 1].chave == v[i].chave and v[i - 1].seq > v[i].seq {
            ruins += 1
        }
    }
    return ruins
}

proc main() {
    var l = make([dynamic]Item, alloc = heap)
    for i in 0..<60 {
        append(&l, item = Item{chave = i % 5, seq = i})
    }
    sort_by_key(l[..], key = Item.chave)
    print(confere_estavel(l[..]))
    print(l[0].seq)
    print(l[11].seq)
    print(l[12].seq)
    print(l[24].seq)
    print(l[59].seq)
    print(len(l))
    delete(l)
}
