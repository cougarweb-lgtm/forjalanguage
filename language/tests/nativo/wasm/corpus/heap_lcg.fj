// K17 (heap): 300 valores pseudoaleatorios (LCG de inteiro, semente fixa) empurrados e depois retirados; saida: true (saiu ordenado), 300 (retirados) e 0 (sobrando).
proc main() {
    var h = make([dynamic]int, alloc = heap)
    var x = 12345
    for i in 0..<300 {
        x = (x * 1103515245 + 12345) % 2147483648
        heap_push(&h, (x + i) % 1000)
    }
    var ok = true
    var anterior = -1
    var quantos = 0
    for i in 0..<300 {
        let v = heap_pop(&h) or_else -1
        if v < anterior {
            ok = false
        }
        anterior = v
        quantos = quantos + 1
    }
    print(ok)
    print(quantos)
    print(len(h))
    delete(h)
}
