// procval_campo.fj - proc como valor guardado em campo de struct, em const de struct e trocado em tempo de execucao (0.32.0).
struct Acao {
    nome: str
    f: proc(x: int) -> int
}

proc soma_dez(x: int) -> int {
    return x + 10
}

proc negar(x: int) -> int {
    return 0 - x
}

proc quadrado(x: int) -> int {
    return x * x
}

const PADRAO: Acao = Acao{nome = "neg", f = negar}

proc escolhe(i: int) -> proc(x: int) -> int {
    if i == 0 {
        return soma_dez
    }
    return quadrado
}

proc main() {
    var a = Acao{nome = "dez", f = soma_dez}
    print(a.f(5))
    a.f = quadrado
    print(a.f(7))
    print(PADRAO.f(3))
    for i in 0..<2 {
        let f = escolhe(i)
        print(f(i + 4))
    }
}
