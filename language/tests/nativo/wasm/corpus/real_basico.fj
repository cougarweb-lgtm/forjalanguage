// real_basico.fj - operacoes reais (f32/f64) no alvo wasm: const, aritmetica, neg, raiz, comparacoes, conversoes.
// So imprime int/bool (print de real exige runtime ainda inexistente no wasm).

proc main() {
    let x: f64 = 2.0
    print(sqrt(x * 8.0) == 4.0)
    print(x - 0.5 == 1.5)
    print(x / 4.0 == 0.5)
    print(x + 1.0 == 3.0)
    print(-x == -2.0)
    print(x != 2.0)
    print(x >= 2.0)
    print(x <= 2.0)
    print(x > 2.0)
    print(x < 2.0)
    let n: i32 = 3
    print((n as f64) > 2.5)
    print((n as f64) < 2.5)
    let m: i8 = -3
    print((m as f64) == -3.0)
    let u: u8 = 255
    print((u as f64) == 255.0)
    let big: u64 = 10
    print((big as f64) == 10.0)
    let f: f32 = 0.5
    let g: f64 = f as f64
    print(g == 0.5)
    print(f == 0.5)
    print((f as f64) * 4.0 == 2.0)
}
