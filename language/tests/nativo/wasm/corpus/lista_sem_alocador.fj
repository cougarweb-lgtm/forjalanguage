// lista_sem_alocador.fj - 0.38.0: append numa lista de valor zero (campo [dynamic]int omitido no literal da struct) = R0007 igual ao x64, exit 101 (dev e release)
// Verificacao: python tests\nativo\wasm\verificar_wasm.py --filtro lista_sem_alocador
struct Caixa {
    id: int
    itens: [dynamic]int
}

proc main() {
    var c = Caixa{id = 1}
    print(c.id)
    append(&c.itens, item = 5)
    print(len(c.itens))
}
