// real_chamada.fj - f64/f32 como argumento, retorno e imediato: chamada, retorno com constante real, copia.

proc media(a: f64, b: f64) -> f64 {
    return (a + b) / 2.0
}

proc um_e_meio() -> f64 {
    return 1.5
}

proc escala(x: f32, fator: f32) -> f32 {
    return x * fator
}

proc maior(a: f64, b: f64) -> f64 {
    if a > b {
        return a
    }
    return b
}

proc main() {
    print(media(3.0, 5.0) == 4.0)
    print(um_e_meio() == 1.5)
    print(escala(2.0, 4.0) == 8.0)
    print(maior(media(1.0, 2.0), um_e_meio()) == 1.5)
    let c: f64 = 2.5
    let d = c
    print(d == 2.5)
}
