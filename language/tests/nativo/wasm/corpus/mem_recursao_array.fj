// mem_recursao_array.fj - proc recursivo com `var tmp: [4]int` local, profundidade 20.
// fatorial_soma(n) = 1! + 2! + ... + n!; cada chamada usa o proprio quadro (tmp).
// Esperado: 2561327494111820313 nas tres chamadas; soma 7683982482335460939; checagens true.

proc fatorial_soma(n: int) -> int {
    var tmp: [4]int = {}
    tmp[0] = n
    if n <= 1 {
        tmp[1] = 1
        return tmp[1]
    }
    tmp[1] = fatorial_soma(n - 1)
    tmp[2] = 1
    for k in 1..=tmp[0] {
        tmp[2] = tmp[2] * k
    }
    tmp[3] = tmp[1] + tmp[2]
    return tmp[3]
}

proc main() {
    let a = fatorial_soma(20)
    let b = fatorial_soma(20)
    let c = fatorial_soma(20)
    print(a)
    print(b)
    print(c)
    print(a + b + c)
    print(a == 2561327494111820313)
    print(a + b + c == 7683982482335460939)
}
