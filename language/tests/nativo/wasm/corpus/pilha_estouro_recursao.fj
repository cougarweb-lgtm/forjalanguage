// pilha_estouro_recursao.fj - recursao infinita sem slots (sem prologo): no wasm o V8 lanca RangeError de pilha de chamadas e o executor relata R0016, exit 101; no x64 o Windows mata por STATUS_STACK_OVERFLOW e o driver relata R0016, exit 101
// Verificacao: python tests\nativo\wasm\verificar_wasm.py --modos dev,release --filtro pilha_estouro_recursao
proc sem_fim(n: int) -> int {
    return sem_fim(n + 1) + 1
}

proc main() {
    print(sem_fim(0))
}
