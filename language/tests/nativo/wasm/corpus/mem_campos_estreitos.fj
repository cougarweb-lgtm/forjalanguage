// mem_campos_estreitos.fj - struct com campos i8, i16, u8, u16, i32, int; grava valores de bordas
// e imprime com `as int` (prova a extensao no load). Esperado: -1, -200, 200, 65535, -2147483647, -5.

struct Estreito {
    a: i8
    b: i16
    c: u8
    d: u16
    e: i32
    f: int
}

proc grava(p: ^Estreito) {
    p.a = -1
    p.b = -200
    p.c = 200
    p.d = 65535
    p.e = -2147483647
    p.f = -5
}

proc main() {
    var s = Estreito{a = 0, b = 0, c = 0, d = 0, e = 0, f = 0}
    grava(&s)
    print(s.a as int)
    print(s.b as int)
    print(s.c as int)
    print(s.d as int)
    print(s.e)
    print(s.f)
}
