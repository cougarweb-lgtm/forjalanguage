// mem_array_indexado.fj - array local [8]int preenchido em laco e somado; indexa com i inteiro.
// Esperado: soma dos (i*i+1) para i em 0..7 = 148; a[5] = 26; a[7] = 50.

proc main() {
    var a: [8]int = {}
    for i in 0..<8 {
        a[i] = i * i + 1
    }
    var soma = 0
    for i in 0..<8 {
        soma += a[i]
    }
    print(soma)
    print(a[5])
    print(a[7])
}
