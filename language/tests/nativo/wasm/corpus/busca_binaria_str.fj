// K08b (binary_search): fatia de str. "bob" acha na posicao 1; "zeca" nao acha e cai depois do ultimo (posicao 3).
proc main() {
    var a: [3]str = {"ana", "bob", "carlos"}
    let i, ok = binary_search(a[..], value = "bob")
    print(i)
    print(ok)
    let j, achou = binary_search(a[..], value = "zeca")
    print(j)
    print(achou)
}
