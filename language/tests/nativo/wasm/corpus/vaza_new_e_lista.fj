// 0.36.0: R0009 no wasm (dev) = o do x64. new com alloc = heap sem delete, lista que cresce por append (o bloco novo herda o ponto da alocacao original)
// e str de format com alloc = heap; o que tem delete nao aparece. Saida: o que o programa imprime, depois 3 linhas R0009 e exit 101.
struct Grifo {
    vida: i32 = 7
}

proc criar() -> ^Grifo {
    return new(Grifo, alloc = heap)
}

proc lista_que_vaza() -> [dynamic]i64 {
    var v = make([dynamic]i64, alloc = heap)
    for i in 0..<20 {
        append(&v, item = i as i64)
    }
    return v
}

proc texto_que_vaza() -> str {
    return format(f"valor {42}", alloc = heap)
}

proc main() {
    let bom = criar()
    defer delete(bom)
    let vazado = criar()
    print(vazado.vida)
    let v = lista_que_vaza()
    print(len(v))
    let s = texto_que_vaza()
    print(len(s))
}
