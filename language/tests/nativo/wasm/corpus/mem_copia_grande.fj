// mem_copia_grande.fj - struct de 104 B ([12]int = 96 B + int) copiada por `let b = a` (acima de 64 B).
// Depois da copia o original e alterado: a copia tem de continuar com os valores antigos.

struct Grande {
    v: [12]int
    tag: int
}

proc main() {
    var a = Grande{v = {}, tag = 7}
    for k in 0..<12 {
        a.v[k] = k * 3
    }
    let b = a
    a.v[0] = 100
    a.tag = 9
    print(a.v[0])
    print(b.v[0])
    print(a.tag)
    print(b.tag)
    print(a.v[11])
    print(b.v[11])
}
