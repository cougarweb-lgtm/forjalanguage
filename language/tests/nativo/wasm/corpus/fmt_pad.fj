// largura menor que o texto, zeros depois do '-', str com largura, inteiro zero
proc main() {
    let zero: int = 0
    let nome: str = "ana"
    let neg: int = -5
    let cheio: uint = 123456
    print(f"[{zero:4}] [{zero:03}] [{neg:03}] [{neg:2}] [{cheio:3}]")
    print(f"[{nome:6}] [{nome:5}] [{nome:2}]")
}
