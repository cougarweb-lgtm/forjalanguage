// real -> inteiro fora da faixa: R0002 em dev, satura em release
// Valor sem parte fracionaria de proposito: a causa do wasm mostra o inteiro truncado (sem Display de real), igual ao do x64 so quando o real e inteiro.
proc main() {
    let c: f64 = 300.0
    print(c as u8)
    print(-5.5 as u16)
}
