// real -> inteiro: dentro da faixa trunca para zero; floor
import "std:math" as math
proc par(v: f64) -> int {
    return v as int
}
proc main() {
    let a: f64 = 3.9
    let b: f64 = -3.9
    let c: f64 = 300.7
    let d: f64 = 4000000000.5
    print(a as i32)
    print(b as i32)
    print(c as u16)
    print(a as i8)
    print(d as u32)
    print(d as u64)
    print(par(-123456789012.7))
    print(math.floor(b) as i32)
    print(math.floor(a) as i16)
}
