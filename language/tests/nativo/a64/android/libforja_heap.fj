// A4.4(C): .so Forja que usa o heap do runtime a64 (alvo aarch64-linux-android, --modo dll). Sem entrada nem fim (o .so nao roda o _start):
// o heap nasce sob demanda (janela pelas dicas baixas, ou o fallback alto quando elas estao ocupadas).
// heap_soma(n) aloca uma lista no heap, junta 1..n e devolve n*(n+1)/2 (heap_soma(10) = 55).
proc main() {
}

pub export proc heap_soma(n: i32) -> i32 {
    var l = make([dynamic]int, alloc = heap)
    defer delete(l)
    for i in 1..=(n as int) {
        append(&l, item = i)
    }
    return (sum(l[..]) as i32)
}
