// A4.4(C): exe PIE Forja que chama o .so Forja libforja_heap.so (DT_NEEDED + DT_RUNPATH pelo --runpath) e tambem usa o heap do
// proprio runtime. Sai 0. Saida esperada: "55" (heap_soma(10), no .so) e "55" (soma de 1..10 no heap do PIE).
// Com FORJA_A64_JANELA_ALTA=1 no ambiente, o heap do PIE (exe, entrada le o envp) cai no fallback alto.
foreign {
    link "forja_heap"
    proc heap_soma(n: i32) -> i32
}

proc main() {
    print(heap_soma(10))
    var l = make([dynamic]int, alloc = heap)
    defer delete(l)
    for i in 1..=10 {
        append(&l, item = i)
    }
    print(sum(l[..]))
}
