// A4.4(C): exe PIE Forja que OCUPA a janela baixa do heap antes de chamar o .so (simula a ART com os 4 GiB baixos ocupados):
// mmap com MAP_FIXED_NOREPLACE em 0x4000_0000 e 0x8000_0000 (1 GiB cada) bloqueia as dicas 0x8000_0000, 0x4000_0000 e 0x2000_0000
// do .so, que cai no fallback alto (mmap sem dica). Saida esperada: "55" (heap_soma(10)) e exit 0.
foreign {
    link "forja_heap"
    proc heap_soma(n: i32) -> i32
}

foreign {
    link "c"
    proc mapear = "mmap"(endereco: uint, tamanho: uint, protecao: i32, sinais: i32, arquivo: i32, deslocamento: int) -> uint
}

const JANELA_BAIXA_1: uint = 1073741824
const JANELA_BAIXA_2: uint = 2147483648
const UM_GIB: uint = 1073741824
const PROT_RW: i32 = 3
// MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED_NOREPLACE | MAP_NORESERVE
const FLAGS_OCUPA: i32 = 1064994

proc main() {
    _ = mapear(JANELA_BAIXA_1, UM_GIB, PROT_RW, FLAGS_OCUPA, -1, 0)
    _ = mapear(JANELA_BAIXA_2, UM_GIB, PROT_RW, FLAGS_OCUPA, -1, 0)
    print(heap_soma(10))
}
