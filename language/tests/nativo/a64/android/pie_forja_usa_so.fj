// A4.3: exe PIE Forja que carrega o .so Forja libforja_ref.so (DT_NEEDED libforja_ref.so + DT_RUNPATH pelo --runpath).
// ref_logar escreve `forja: subiu` no logcat; o exe sai com o que ref_valor devolve (42) pelo _exit da libc.
foreign {
    link "forja_ref"
    proc ref_valor() -> i32
    proc ref_logar()
}

foreign {
    link "c"
    proc sair = "_exit"(codigo: i32)
}

proc main() {
    ref_logar()
    sair(ref_valor())
}
