// A4.3: exe PIE do alvo aarch64-linux-android que chama a libc do Bionic (DT_NEEDED libc.so, GOT + GLOB_DAT).
// write(1, "ola", 4) e getpid() pela libc; sai com 7 pelo _exit da libc se tudo deu certo (1 se nao).
foreign {
    link "c"
    proc escrever = "write"(fd: i32, texto: cstr, n: int) -> int
    proc pid_atual = "getpid"() -> i32
    proc sair = "_exit"(codigo: i32)
}

proc main() {
    let n = escrever(1, "ola\n", 4)
    if (n == 4) and (pid_atual() > 0) {
        sair(7)
    }
    sair(1)
}
