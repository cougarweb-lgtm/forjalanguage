// A5.2: .so de app NativeActivity (aarch64-linux-android). A NativeActivity chama app_on_create(ANativeActivity*, void*, size_t)
// no thread principal (meta-data android.app.func_name). Escreve `forja: subiu` no logcat pela liblog (GOT + GLOB_DAT, DT_NEEDED liblog.so).
// O nome do export nao comeca com forja_ (E0902); proc main() vazio exigido pelo .so.
foreign {
    link "log"
    proc log_escrever = "__android_log_write"(prioridade: i32, etiqueta: cstr, texto: cstr) -> i32
}

proc main() {
}

pub export proc app_on_create(activity: rawptr, estado: rawptr, tamanho: uint) {
    _ = log_escrever(4, "forja", "subiu")
}
