// A4.2: .so do alvo aarch64-linux-android (par do ref_main do A4.0, que carrega libref.so; o nome forja_* e reservado pelo E0902, entao
// os exports sao ref_valor e ref_logar e o verificador remonta o ref_main com esses nomes).
// ref_valor devolve 42; ref_logar escreve `forja: subiu` no logcat pela liblog (GOT + GLOB_DAT, DT_NEEDED liblog.so).
foreign {
    link "log"
    proc log_escrever = "__android_log_write"(prioridade: i32, etiqueta: cstr, texto: cstr) -> i32
}

proc main() {
}

pub export proc ref_valor() -> i32 {
    return 42
}

pub export proc ref_logar() {
    _ = log_escrever(4, "forja", "subiu")
}
