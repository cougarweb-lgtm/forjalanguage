// A1.3(i) sem runtime: o x86_64-linux (oraculo) resolve `syscall` na libc; no aarch64-linux o backend emite o mesmo svc (a64_intr.fj).
// SYS_* sao os numeros do aarch64 (asm-generic); o .esperado vem de rodar a fixture no x86_64-linux com SYS_WRITE=1 e SYS_EXIT=231.
// Prova: add/sub/mul/neg/and/or/xor/not em i32 e u32 (so wrapping_*: o `+` normal vira add_ov, que e do A1.3 iv).
foreign {
    link "c"
    proc syscall(num: int, a0: int, a1: int, a2: int, a3: int, a4: int, a5: int) -> int
}

const SYS_WRITE: int = 64
const SYS_EXIT: int = 94

proc sair(n: int) {
    _ = syscall(SYS_EXIT, n, 0, 0, 0, 0, 0)
}

proc mix(h: int, v: int) -> int {
    return wrapping_add(wrapping_mul(h, 1099511628211), v)
}

proc calc(a: i32, b: i32) -> i32 {
    var r = wrapping_mul(a, 3)
    r = wrapping_add(r, b)
    r = wrapping_sub(r, 1000)
    return r
}

proc logica(a: u32, b: u32) -> u32 {
    let x = (a & b) | (a ~ 61680)
    return ~x
}

proc main() {
    let r1 = calc(100000, -7)
    let r2 = wrapping_mul(r1, r1)
    let r3 = wrapping_sub(0, r2)
    let r4 = logica(16711935, 1044720)
    var h: int = 7
    h = mix(h, r1 as int)
    h = mix(h, r2 as int)
    h = mix(h, r3 as int)
    h = mix(h, r4 as int)
    sair(h)
}
