// A1.3(ii) sem runtime: o x86_64-linux (oraculo) resolve `syscall` na libc; no aarch64-linux o backend emite o mesmo svc (a64_intr.fj).
// SYS_* sao os numeros do aarch64 (asm-generic); o .esperado vem de rodar a fixture no x86_64-linux com SYS_WRITE=1 e SYS_EXIT=231.
// Prova: agregados por valor depois do 8o argumento (pilha): Par (8 B, valor na pilha) e Trio (24 B, ponteiro na pilha).
foreign {
    link "c"
    proc syscall(num: int, a0: int, a1: int, a2: int, a3: int, a4: int, a5: int) -> int
}

const SYS_WRITE: int = 64
const SYS_EXIT: int = 94

struct Par {
    a: i32
    b: i32
}

struct Trio {
    a: int
    b: int
    c: int
}

proc sair(n: int) {
    _ = syscall(SYS_EXIT, n, 0, 0, 0, 0, 0)
}

proc mix(h: int, v: int) -> int {
    return wrapping_add(wrapping_mul(h, 1099511628211), v)
}

proc longo(a: int, b: int, c: int, d: int, e: int, f: int, g: int, h: int, p: Par, t: Trio) -> int {
    var s = wrapping_add(a, b)
    s = wrapping_add(s, wrapping_mul(c, d))
    s = wrapping_add(s, e)
    s = wrapping_add(s, wrapping_mul(f, g))
    s = wrapping_add(s, h)
    s = wrapping_add(s, p.a as int)
    s = wrapping_add(s, wrapping_mul(p.b as int, 2))
    s = wrapping_add(s, t.c)
    return s
}

proc main() {
    let p = Par{a = 100, b = 7}
    let t = Trio{a = 1, b = 2, c = 3000}
    var h: int = 29
    h = mix(h, longo(1, 2, 3, 4, 5, 6, 7, 8, p, t))
    sair(h)
}
