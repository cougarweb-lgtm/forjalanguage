// A3.3k: ZERA_MEM acima de 64 B (forja_memset inline do a64) no meio de struct com sentinelas: o zeramento nao pode invadir os vizinhos
struct Z65 {
    pre: u8
    meio: [65]u8
    pos: u8
}
struct Z129 {
    pre: u8
    meio: [129]u8
    pos: u8
}
struct Z300 {
    pre: u8
    meio: [300]u8
    pos: u8
}

proc soma(v: []u8) -> int {
    var s: int = 0
    for x in v {
        s += x as int
    }
    return s
}

proc main() {
    var a = Z65{pre = 170, pos = 85}
    var b = Z129{pre = 170, pos = 85}
    var c = Z300{pre = 170, pos = 85}
    for i in 0..<65 {
        a.meio[i] = 255
    }
    for i in 0..<129 {
        b.meio[i] = 255
    }
    for i in 0..<300 {
        c.meio[i] = 255
    }
    print(soma(a.meio[..]))
    print(soma(b.meio[..]))
    print(soma(c.meio[..]))
    a.meio = {}
    b.meio = {}
    c.meio = {}
    print(soma(a.meio[..]))
    print(soma(b.meio[..]))
    print(soma(c.meio[..]))
    print((a.pre as int) + (a.pos as int))
    print((b.pre as int) + (b.pos as int))
    print((c.pre as int) + (c.pos as int))
    var z = Z129{pre = 1, pos = 2}
    z.meio[128] = 9
    z = Z129{}
    print((z.pre as int) + (z.pos as int) + (z.meio[128] as int))
}
