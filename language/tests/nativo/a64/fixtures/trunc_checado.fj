// A1.3(iv): TRUNC (`as` estreitador) de valores que cabem na classe de destino: 65 as u8 = 'A' e 66 as u8 = 'B' (TRUNC = mov/no-op + extensao).
// Sem estouro, sai 0. Fora da faixa o `as` difere entre dev (R0002) e release (trunca), por isso a fixture usa so valores que cabem.
// SYS_WRITE=64 e SYS_EXIT=94 (aarch64). O oraculo x86_64-linux troca por 1 e 231 (ver aritmetica_i32.fj).
// Esperado: exit=0 e stdout "AB".
foreign {
    link "c"
    proc syscall(num: int, a0: int, a1: int, a2: int, a3: int, a4: int, a5: int) -> int
    proc syscall_ptr = "syscall"(num: int, a0: int, a1: ^u8, a2: int, a3: int, a4: int, a5: int) -> int
}

const SYS_WRITE: int = 64

proc letra(c: u8) {
    var v: u8 = c
    _ = syscall_ptr(SYS_WRITE, 1, &v, 1, 0, 0, 0)
}

proc main() {
    let v: i64 = 65
    let c = v as u8
    letra(c)
    let w: i32 = 66
    letra(w as u8)
}
