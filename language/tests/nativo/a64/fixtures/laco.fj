// A1.3(i) sem runtime: o x86_64-linux (oraculo) resolve `syscall` na libc; no aarch64-linux o backend emite o mesmo svc (a64_intr.fj).
// SYS_* sao os numeros do aarch64 (asm-generic); o .esperado vem de rodar a fixture no x86_64-linux com SYS_WRITE=1 e SYS_EXIT=231.
// Prova: while com SALTA/DESVIA, lacos aninhados, break e continue (so wrapping_*: o `+=` normal vira add_ov, que e do A1.3 iv).
foreign {
    link "c"
    proc syscall(num: int, a0: int, a1: int, a2: int, a3: int, a4: int, a5: int) -> int
}

const SYS_WRITE: int = 64
const SYS_EXIT: int = 94

proc sair(n: int) {
    _ = syscall(SYS_EXIT, n, 0, 0, 0, 0, 0)
}

proc mix(h: int, v: int) -> int {
    return wrapping_add(wrapping_mul(h, 1099511628211), v)
}

proc soma_ate(n: int) -> int {
    var i: int = 0
    var s: int = 0
    while i < n {
        s = wrapping_add(s, i)
        i = wrapping_add(i, 1)
    }
    return s
}

proc tabuada(n: int) -> int {
    var h: int = 0
    var i: int = 1
    while i <= n {
        var j: int = 1
        while j <= n {
            if j == 5 {
                j = wrapping_add(j, 1)
                continue
            }
            if wrapping_mul(i, j) > 40 {
                break
            }
            h = mix(h, wrapping_mul(i, j))
            j = wrapping_add(j, 1)
        }
        i = wrapping_add(i, 1)
    }
    return h
}

proc main() {
    var h: int = 9
    h = mix(h, soma_ate(100))
    h = mix(h, soma_ate(0))
    h = mix(h, tabuada(9))
    sair(h)
}
