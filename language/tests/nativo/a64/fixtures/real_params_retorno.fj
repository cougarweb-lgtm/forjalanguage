// A1.3(iii): reais como argumento e retorno em v0-v7 (convencao Forja-A64: NGRN e NSRN independentes). Mistura inteiros e reais na mesma chamada.
// Cada conferencia imprime S (ok) ou N. Esperado: exit=0 e stdout "SSSSS" (5 conferencias).
foreign {
    link "c"
    proc syscall(num: int, a0: int, a1: int, a2: int, a3: int, a4: int, a5: int) -> int
    proc syscall_ptr = "syscall"(num: int, a0: int, a1: ^u8, a2: int, a3: int, a4: int, a5: int) -> int
}

const SYS_WRITE: int = 64

proc letra(c: u8) {
    var v: u8 = c
    _ = syscall_ptr(SYS_WRITE, 1, &v, 1, 0, 0, 0)
}

proc checar(ok: bool) {
    if ok {
        letra(83)
    } else {
        letra(78)
    }
}

proc mistura(n: int, x: f64, m: int, y: f32, z: f64) -> f64 {
    return x + (n as f64) + (m as f64) + (y as f64) + z
}

proc metade(x: f32) -> f32 {
    return x / 2.0
}

proc dobro(x: f64) -> f64 {
    return mistura(0, x, 0, 0.0, x - x) * 2.0
}

proc repassa(x: f64, n: int) -> f64 {
    return dobro(x) + (n as f64)
}

proc main() {
    checar(mistura(1, 0.5, 2, 0.25, 4.0) == 7.75)
    checar(metade(3.0) == 1.5)
    checar(dobro(1.25) == 2.5)
    checar(repassa(1.25, 4) == 6.5)
    let r: f64 = mistura(-1, 10.0, -2, -0.5, 0.5)
    checar(r == 7.0)
}
