// A1.3(iv): SELECIONA inteiro (cmp + csel; o otimizador transforma o `if` que so atribui em selecao). menor(7, 3) = 3 e menor(2, 5) = 2 (sinal e sem sinal);
// maior(-4, 9) = 9 (com sinal: -4 < 9). Imprime os digitos 3, 2 e 9 e sai 0.
// SYS_WRITE=64 e SYS_EXIT=94 (aarch64). O oraculo x86_64-linux troca por 1 e 231 (ver aritmetica_i32.fj).
// Esperado: exit=0 e stdout "329".
foreign {
    link "c"
    proc syscall(num: int, a0: int, a1: int, a2: int, a3: int, a4: int, a5: int) -> int
    proc syscall_ptr = "syscall"(num: int, a0: int, a1: ^u8, a2: int, a3: int, a4: int, a5: int) -> int
}

const SYS_WRITE: int = 64

proc letra(c: u8) {
    var v: u8 = c
    _ = syscall_ptr(SYS_WRITE, 1, &v, 1, 0, 0, 0)
}

proc menor(a: i32, b: i32) -> i32 {
    var r: i32 = b
    if a < b {
        r = a
    }
    return r
}

proc maior(a: i32, b: i32) -> i32 {
    var r: i32 = a
    if a < b {
        r = b
    }
    return r
}

proc main() {
    let x = menor(7, 3)
    letra(((48 + x) as u8))
    let y = menor(2, 5)
    letra(((48 + y) as u8))
    let z = maior(-4, 9)
    letra(((48 + z) as u8))
}
