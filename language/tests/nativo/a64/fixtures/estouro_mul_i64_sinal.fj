// A1.3(iv): MUL_OV com sinal em I64 (smulh + comparacao da parte alta com o sinal do baixo). 3037000499 * 3037000499 = 9223372030926249001 cabe (imprime O);
// 3037000500 * 3037000500 = 9223372037000250000 passa de 2^63 - 1 e estoura: R0002, exit 101.
// SYS_WRITE=64 e SYS_EXIT=94 (aarch64). O oraculo x86_64-linux troca por 1 e 231 (ver aritmetica_i32.fj).
// Esperado: exit=101 e stdout "O".
foreign {
    link "c"
    proc syscall(num: int, a0: int, a1: int, a2: int, a3: int, a4: int, a5: int) -> int
    proc syscall_ptr = "syscall"(num: int, a0: int, a1: ^u8, a2: int, a3: int, a4: int, a5: int) -> int
}

const SYS_WRITE: int = 64

proc letra(c: u8) {
    var v: u8 = c
    _ = syscall_ptr(SYS_WRITE, 1, &v, 1, 0, 0, 0)
}

proc main() {
    let a: i64 = 3037000499
    let c = a * a
    if c == 0 {
        letra(78)
    }
    letra(79)
    let b: i64 = 3037000500
    let r = b * b
    if r == 0 {
        letra(78)
    }
}
