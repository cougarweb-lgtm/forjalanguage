// A3.3k: COPIA_MEM acima de 64 B (forja_memcpy inline do a64) em tamanhos de borda: 65, 72, 129, 952 B (cauda impar e multiplo de 16 + cauda)
struct B65 {
    v: [65]u8
}
struct B72 {
    v: [72]u8
}
struct B129 {
    v: [129]u8
}
struct B952 {
    v: [119]int
}

proc soma65(g: B65) -> int {
    var s: int = 0
    for i in 0..<65 {
        s += (g.v[i] as int) * (i + 1)
    }
    return s
}

proc soma72(g: B72) -> int {
    var s: int = 0
    for i in 0..<72 {
        s += (g.v[i] as int) * (i + 1)
    }
    return s
}

proc soma129(g: B129) -> int {
    var s: int = 0
    for i in 0..<129 {
        s += (g.v[i] as int) * (i + 1)
    }
    return s
}

proc soma952(g: B952) -> int {
    var s: int = 0
    for i in 0..<119 {
        s += g.v[i] * (i + 1)
    }
    return s
}

proc main() {
    var a = B65{}
    var b = B72{}
    var c = B129{}
    var d = B952{}
    for i in 0..<65 {
        a.v[i] = ((i * 7 + 3) % 251) as u8
    }
    for i in 0..<72 {
        b.v[i] = ((i * 11 + 5) % 251) as u8
    }
    for i in 0..<129 {
        c.v[i] = ((i * 13 + 1) % 251) as u8
    }
    for i in 0..<119 {
        d.v[i] = i * 1000003 - 7
    }
    let a2 = a
    let b2 = b
    let c2 = c
    let d2 = d
    a.v[0] = 255
    d.v[118] = 0
    print(soma65(a2))
    print(soma72(b2))
    print(soma129(c2))
    print(soma952(d2))
    print(soma65(a) - soma65(a2))
    print(a2.v[64] as int)
    print(c2.v[128] as int)
    print(d2.v[118])
}
