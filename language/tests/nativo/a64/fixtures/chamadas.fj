// A1.3(i) sem runtime: o x86_64-linux (oraculo) resolve `syscall` na libc; no aarch64-linux o backend emite o mesmo svc (a64_intr.fj).
// SYS_* sao os numeros do aarch64 (asm-generic); o .esperado vem de rodar a fixture no x86_64-linux com SYS_WRITE=1 e SYS_EXIT=231.
// Prova: chamadas encadeadas, parametros de larguras mistas (i8/i16/i32/i64) e retorno por x0.
foreign {
    link "c"
    proc syscall(num: int, a0: int, a1: int, a2: int, a3: int, a4: int, a5: int) -> int
}

const SYS_WRITE: int = 64
const SYS_EXIT: int = 94

proc sair(n: int) {
    _ = syscall(SYS_EXIT, n, 0, 0, 0, 0, 0)
}

proc mix(h: int, v: int) -> int {
    return wrapping_add(wrapping_mul(h, 1099511628211), v)
}

proc misto(a: i8, b: i16, c: i32, d: i64) -> int {
    var r = mix(1, a as int)
    r = mix(r, b as int)
    r = mix(r, c as int)
    r = mix(r, d)
    return r
}

proc dobro(x: int) -> int {
    return wrapping_mul(x, 2)
}

proc triplo_do_dobro(x: int) -> int {
    return wrapping_mul(dobro(x), 3)
}

proc soma3(a: int, b: int, c: int) -> int {
    return wrapping_add(wrapping_add(a, wrapping_mul(b, 10)), wrapping_mul(c, 100))
}

proc main() {
    var h: int = 5
    h = mix(h, misto(-3, -300, -70000, -5000000000))
    h = mix(h, triplo_do_dobro(7))
    h = mix(h, soma3(triplo_do_dobro(1), dobro(2), soma3(1, 2, 3)))
    sair(h)
}
