// A1.3(i) sem runtime: o x86_64-linux (oraculo) resolve `syscall` na libc; no aarch64-linux o backend emite o mesmo svc (a64_intr.fj).
// SYS_* sao os numeros do aarch64 (asm-generic); o .esperado vem de rodar a fixture no x86_64-linux com SYS_WRITE=1 e SYS_EXIT=231.
// Prova: div/rem com e sem sinal (sdiv/udiv + msub), larguras i8/u8/i32/u32/i64, dividendos negativos (divisor literal: sem bloco de guarda).
foreign {
    link "c"
    proc syscall(num: int, a0: int, a1: int, a2: int, a3: int, a4: int, a5: int) -> int
}

const SYS_WRITE: int = 64
const SYS_EXIT: int = 94

proc sair(n: int) {
    _ = syscall(SYS_EXIT, n, 0, 0, 0, 0, 0)
}

proc mix(h: int, v: int) -> int {
    return wrapping_add(wrapping_mul(h, 1099511628211), v)
}

proc d32(a: i32) -> int {
    return mix(mix(0, (a / 7) as int), (a % 7) as int)
}

proc d32n(a: i32) -> int {
    return mix(mix(0, (a / -3) as int), (a % -3) as int)
}

proc u32d(a: u32) -> int {
    return mix(mix(0, (a / 10) as int), (a % 10) as int)
}

proc d64(a: i64) -> int {
    return mix(mix(0, a / 1000003), a % 1000003)
}

proc d8(a: i8) -> int {
    return mix(mix(0, (a / 5) as int), (a % 5) as int)
}

proc u8d(a: u8) -> int {
    return mix(mix(0, (a / 7) as int), (a % 7) as int)
}

proc main() {
    var h: int = 13
    h = mix(h, d32(-100))
    h = mix(h, d32(100))
    h = mix(h, d32n(-100))
    h = mix(h, d32n(100))
    h = mix(h, u32d(4000000000))
    h = mix(h, d64(-1234567890123))
    h = mix(h, d64(9876543210987))
    h = mix(h, d8(-128))
    h = mix(h, d8(127))
    h = mix(h, u8d(255))
    sair(h)
}
