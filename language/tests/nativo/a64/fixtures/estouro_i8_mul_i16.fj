// A1.3(iv): MUL_OV em I8 e I16 (produto em w + confere a faixa). I8: 11 * 11 = 121 cabe (imprime O); 11 * 12 = 132 passa de 127 e estoura: R0002, exit 101.
// I16 (sem sinal): 255 * 257 = 65535 cabe (imprime P). Em release o estouro faz wrap (ver `_release.esperado`).
// SYS_WRITE=64 e SYS_EXIT=94 (aarch64). O oraculo x86_64-linux troca por 1 e 231 (ver aritmetica_i32.fj).
// Esperado: exit=101 e stdout "OP".
foreign {
    link "c"
    proc syscall(num: int, a0: int, a1: int, a2: int, a3: int, a4: int, a5: int) -> int
    proc syscall_ptr = "syscall"(num: int, a0: int, a1: ^u8, a2: int, a3: int, a4: int, a5: int) -> int
}

const SYS_WRITE: int = 64

proc letra(c: u8) {
    var v: u8 = c
    _ = syscall_ptr(SYS_WRITE, 1, &v, 1, 0, 0, 0)
}

proc main() {
    let a: i8 = 11
    let c = a * a
    if c == 0 {
        letra(78)
    }
    letra(79)
    let w: u16 = 255
    let z: u16 = 257
    let q = w * z
    if q == 0 {
        letra(78)
    }
    letra(80)
    let b: i8 = 12
    let r = a * b
    if r == 0 {
        letra(78)
    }
}
