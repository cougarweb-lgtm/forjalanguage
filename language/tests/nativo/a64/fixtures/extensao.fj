// A1.3(i) sem runtime: o x86_64-linux (oraculo) resolve `syscall` na libc; no aarch64-linux o backend emite o mesmo svc (a64_intr.fj).
// SYS_* sao os numeros do aarch64 (asm-generic); o .esperado vem de rodar a fixture no x86_64-linux com SYS_WRITE=1 e SYS_EXIT=231.
// Prova: EXT_S/EXT_Z (sxtb sxth sxtw uxtb uxth mov w,w) ao alargar i8/u8/i16/u16/i32/u32 para i64, com bits altos sujos vindos de wrapping_* estreito.
foreign {
    link "c"
    proc syscall(num: int, a0: int, a1: int, a2: int, a3: int, a4: int, a5: int) -> int
}

const SYS_WRITE: int = 64
const SYS_EXIT: int = 94

proc sair(n: int) {
    _ = syscall(SYS_EXIT, n, 0, 0, 0, 0, 0)
}

proc mix(h: int, v: int) -> int {
    return wrapping_add(wrapping_mul(h, 1099511628211), v)
}

proc e8(a: i8, b: i8) -> int {
    let s = wrapping_add(a, b)
    return mix(0, s as int)
}

proc eu8(a: u8, b: u8) -> int {
    let s = wrapping_add(a, b)
    return mix(0, s as int)
}

proc e16(a: i16, b: i16) -> int {
    let s = wrapping_mul(a, b)
    return mix(0, s as int)
}

proc eu16(a: u16, b: u16) -> int {
    let s = wrapping_mul(a, b)
    return mix(0, s as int)
}

proc e32(a: i32, b: i32) -> int {
    let s = wrapping_sub(a, b)
    return mix(0, s as int)
}

proc eu32(a: u32, b: u32) -> int {
    let s = wrapping_sub(a, b)
    return mix(0, s as int)
}

proc main() {
    var h: int = 23
    h = mix(h, e8(100, 100))
    h = mix(h, e8(-100, -100))
    h = mix(h, eu8(200, 100))
    h = mix(h, e16(300, 300))
    h = mix(h, e16(-300, 300))
    h = mix(h, eu16(300, 300))
    h = mix(h, e32(-2147483647, 10))
    h = mix(h, eu32(1, 2))
    sair(h)
}
