// A2.2(d): sort, sort_by com less = proc e sum sobre fatia de lista dinamica
proc antes(a: ^int, b: ^int) -> bool {
    return a^ < b^
}

proc main() {
    var l = make([dynamic]int, alloc = heap)
    defer delete(l)
    append(&l, item = 3)
    append(&l, item = 1)
    append(&l, item = 2)
    sort(l[..])
    print(l[0] * 100 + l[1] * 10 + l[2])
    sort_by(l[..], less = antes)
    print(sum(l[..]))
}
