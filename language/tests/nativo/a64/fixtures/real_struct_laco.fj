// A1.3(iii): reais em struct (carrega e grava de campo f64/f32 no slot agregado) e em laco (acumulador real em vreg). Cada conferencia imprime S (ok) ou N.
// Esperado: exit=0 e stdout "SSSSS" (5 conferencias).
foreign {
    link "c"
    proc syscall(num: int, a0: int, a1: int, a2: int, a3: int, a4: int, a5: int) -> int
    proc syscall_ptr = "syscall"(num: int, a0: int, a1: ^u8, a2: int, a3: int, a4: int, a5: int) -> int
}

const SYS_WRITE: int = 64

proc letra(c: u8) {
    var v: u8 = c
    _ = syscall_ptr(SYS_WRITE, 1, &v, 1, 0, 0, 0)
}

proc checar(ok: bool) {
    if ok {
        letra(83)
    } else {
        letra(78)
    }
}

struct Ponto {
    x: f64
    y: f32
    n: i32
}

proc avanca(p: ^Ponto, dx: f64) {
    p^.x = p^.x + dx
}

proc main() {
    var p = Ponto{x = 1.25, y = 2.5, n = 3}
    checar(p.x == 1.25 as f64)
    checar(p.y == 2.5)
    avanca(&p, 1.0)
    checar(p.x == 2.25 as f64)
    p.y = p.y * 2.0
    checar(p.y == 5.0)
    var soma: f64 = 0.0
    for i in 0..<10 {
        soma = soma + (i as f64)
    }
    checar(soma == 45.0 as f64)
}
