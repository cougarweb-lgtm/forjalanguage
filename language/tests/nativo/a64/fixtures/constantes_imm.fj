// A1.3(i) sem runtime: o x86_64-linux (oraculo) resolve `syscall` na libc; no aarch64-linux o backend emite o mesmo svc (a64_intr.fj).
// SYS_* sao os numeros do aarch64 (asm-generic); o .esperado vem de rodar a fixture no x86_64-linux com SYS_WRITE=1 e SYS_EXIT=231.
// Prova: CONST de 32/64 bits em todas as formas do mov_imm (so MOVZ, so MOVN, MOVZ+MOVK, 4 meias, negativos) comparadas com igualdade.
foreign {
    link "c"
    proc syscall(num: int, a0: int, a1: int, a2: int, a3: int, a4: int, a5: int) -> int
}

const SYS_WRITE: int = 64
const SYS_EXIT: int = 94

proc sair(n: int) {
    _ = syscall(SYS_EXIT, n, 0, 0, 0, 0, 0)
}

proc mix(h: int, v: int) -> int {
    return wrapping_add(wrapping_mul(h, 1099511628211), v)
}

proc ident(x: int) -> int {
    return x
}

proc ident32(x: i32) -> i32 {
    return x
}

proc confere(x: int, esperado: int, peso: int) -> int {
    if x == esperado {
        return mix(peso, 1)
    }
    return mix(0, 2)
}

proc main() {
    var h: int = 37
    h = mix(h, ident(0))
    h = mix(h, ident(1))
    h = mix(h, ident(65535))
    h = mix(h, ident(65536))
    h = mix(h, ident(-1))
    h = mix(h, ident(-65536))
    h = mix(h, ident(-65537))
    h = mix(h, ident(305419896))
    h = mix(h, ident(81985529216486895))
    h = mix(h, ident(-81985529216486895))
    h = mix(h, ident(9223372036854775807))
    h = mix(h, ident(-9223372036854775807))
    h = mix(h, ident32(-2147483647) as int)
    h = mix(h, ident32(2147483647) as int)
    h = mix(h, confere(ident(281474976710656), 281474976710656, 3))
    h = mix(h, confere(ident(-4294967296), -4294967296, 5))
    sair(h)
}
