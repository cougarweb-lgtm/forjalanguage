// A2.2(d): new com alloc = heap e delete so no ramo que nao roda: em dev o rastro do heap relata R0009 no fim do run (x64 e a64); em release nao checa
struct Bala {
    dano: int = 1
}

proc main() {
    var b = new(Bala, alloc = heap)
    b.dano = 5
    if b.dano > 100 {
        delete(b)
    }
    print(b.dano)
}
