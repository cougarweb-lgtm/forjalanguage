// A1.3(ii) sem runtime: o x86_64-linux (oraculo) resolve `syscall` na libc; no aarch64-linux o backend emite o mesmo svc (a64_intr.fj).
// SYS_* sao os numeros do aarch64 (asm-generic); o .esperado vem de rodar a fixture no x86_64-linux com SYS_WRITE=1 e SYS_EXIT=231.
// Prova: struct aninhado (Caixa com dois Par) por valor e por buffer de retorno; campos de struct em slot (CARREGA/GRAVA/COPIA_MEM).
foreign {
    link "c"
    proc syscall(num: int, a0: int, a1: int, a2: int, a3: int, a4: int, a5: int) -> int
}

const SYS_WRITE: int = 64
const SYS_EXIT: int = 94

struct Par {
    a: i32
    b: i32
}

struct Caixa {
    p: Par
    n: int
    t: Par
}

proc sair(n: int) {
    _ = syscall(SYS_EXIT, n, 0, 0, 0, 0, 0)
}

proc mix(h: int, v: int) -> int {
    return wrapping_add(wrapping_mul(h, 1099511628211), v)
}

proc inverte(c: Caixa) -> Caixa {
    var r = c
    r.p = c.t
    r.t = c.p
    r.n = wrapping_add(c.n, 1000)
    return r
}

proc main() {
    let c = Caixa{p = Par{a = 1, b = 2}, n = 30, t = Par{a = 3, b = 4}}
    let r = inverte(c)
    var h: int = 29
    h = mix(h, r.p.a as int)
    h = mix(h, r.p.b as int)
    h = mix(h, r.n)
    h = mix(h, r.t.a as int)
    h = mix(h, r.t.b as int)
    h = mix(h, c.n)
    sair(h)
}
