// A1.3(i) sem runtime: o x86_64-linux (oraculo) resolve `syscall` na libc; no aarch64-linux o backend emite o mesmo svc (a64_intr.fj).
// SYS_* sao os numeros do aarch64 (asm-generic); o .esperado vem de rodar a fixture no x86_64-linux com SYS_WRITE=1 e SYS_EXIT=231.
// Prova: END_SLOT + CARREGA + GRAVA de 8/16/32/64 bits (locais com o endereco tomado) e escrita de texto de 1 byte por write (sem dados em .rdata).
foreign {
    link "c"
    proc syscall(num: int, a0: int, a1: int, a2: int, a3: int, a4: int, a5: int) -> int
    proc syscall_ptr = "syscall"(num: int, a0: int, a1: ^u8, a2: int, a3: int, a4: int, a5: int) -> int
}

const SYS_WRITE: int = 64
const SYS_EXIT: int = 94

proc sair(n: int) {
    _ = syscall(SYS_EXIT, n, 0, 0, 0, 0, 0)
}

proc mix(h: int, v: int) -> int {
    return wrapping_add(wrapping_mul(h, 1099511628211), v)
}

proc letra(c: u8) {
    var v: u8 = c
    _ = syscall_ptr(SYS_WRITE, 1, &v, 1, 0, 0, 0)
}

proc grava8(p: ^u8, x: u8) {
    p^ = x
}

proc grava16(p: ^u16, x: u16) {
    p^ = x
}

proc grava32(p: ^i32, x: i32) {
    p^ = x
}

proc grava64(p: ^i64, x: i64) {
    p^ = x
}

proc main() {
    var a: u8 = 1
    var b: u16 = 2
    var c: i32 = 3
    var d: i64 = 4
    grava8(&a, 250)
    grava16(&b, 65000)
    grava32(&c, -2000000000)
    grava64(&d, -9000000000000000000)
    var h: int = 29
    h = mix(h, a as int)
    h = mix(h, b as int)
    h = mix(h, c as int)
    h = mix(h, d)
    letra(79)
    letra(75)
    letra(10)
    sair(h)
}
