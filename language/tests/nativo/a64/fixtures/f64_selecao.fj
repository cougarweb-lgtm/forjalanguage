// A1.3(iii): SELECIONA real (fcmp + fcsel). menor_f64 e maior_f64 com if que so atribui viram selecao (o otimizador). NaN em a: a < b e falso, entao vale b.
// Cada conferencia imprime S (ok) ou N. Esperado: exit=0 e stdout "SSSSSS".
foreign {
    link "c"
    proc syscall(num: int, a0: int, a1: int, a2: int, a3: int, a4: int, a5: int) -> int
    proc syscall_ptr = "syscall"(num: int, a0: int, a1: ^u8, a2: int, a3: int, a4: int, a5: int) -> int
}

const SYS_WRITE: int = 64

proc letra(c: u8) {
    var v: u8 = c
    _ = syscall_ptr(SYS_WRITE, 1, &v, 1, 0, 0, 0)
}

proc checar(ok: bool) {
    if ok {
        letra(83)
    } else {
        letra(78)
    }
}

proc menor_f64(a: f64, b: f64) -> f64 {
    var r: f64 = b
    if a < b {
        r = a
    }
    return r
}

proc maior_f64(a: f64, b: f64) -> f64 {
    var r: f64 = a
    if a < b {
        r = b
    }
    return r
}

proc main() {
    let um: f64 = 1.0
    let dois: f64 = 2.0
    let zero: f64 = 0.0
    let ndn: f64 = zero / zero
    checar(menor_f64(dois, um) == um)
    checar(menor_f64(um, dois) == um)
    checar(maior_f64(dois, um) == dois)
    checar(maior_f64(um, dois) == dois)
    checar(menor_f64(ndn, um) == um)
    checar(maior_f64(um, ndn) == um)
}
