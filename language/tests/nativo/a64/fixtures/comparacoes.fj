// A1.3(i) sem runtime: o x86_64-linux (oraculo) resolve `syscall` na libc; no aarch64-linux o backend emite o mesmo svc (a64_intr.fj).
// SYS_* sao os numeros do aarch64 (asm-generic); o .esperado vem de rodar a fixture no x86_64-linux com SYS_WRITE=1 e SYS_EXIT=231.
// Prova: as 10 condicoes inteiras (eq ne lt le gt ge com sinal; lo ls hi hs sem sinal) em i8/i32/i64 e u8/u32/u64, estendendo i8 antes do cmp.
foreign {
    link "c"
    proc syscall(num: int, a0: int, a1: int, a2: int, a3: int, a4: int, a5: int) -> int
}

const SYS_WRITE: int = 64
const SYS_EXIT: int = 94

proc sair(n: int) {
    _ = syscall(SYS_EXIT, n, 0, 0, 0, 0, 0)
}

proc mix(h: int, v: int) -> int {
    return wrapping_add(wrapping_mul(h, 1099511628211), v)
}

proc bit(c: bool, posicao: int) -> int {
    if c {
        return wrapping_mul(1, posicao)
    }
    return 0
}

proc cmp_i8(a: i8, b: i8) -> int {
    var r: int = 0
    r = mix(r, bit(a == b, 1))
    r = mix(r, bit(a != b, 2))
    r = mix(r, bit(a < b, 3))
    r = mix(r, bit(a <= b, 4))
    r = mix(r, bit(a > b, 5))
    r = mix(r, bit(a >= b, 6))
    return r
}

proc cmp_i32(a: i32, b: i32) -> int {
    var r: int = 0
    r = mix(r, bit(a == b, 1))
    r = mix(r, bit(a != b, 2))
    r = mix(r, bit(a < b, 3))
    r = mix(r, bit(a <= b, 4))
    r = mix(r, bit(a > b, 5))
    r = mix(r, bit(a >= b, 6))
    return r
}

proc cmp_i64(a: i64, b: i64) -> int {
    var r: int = 0
    r = mix(r, bit(a < b, 3))
    r = mix(r, bit(a <= b, 4))
    r = mix(r, bit(a > b, 5))
    r = mix(r, bit(a >= b, 6))
    return r
}

proc cmp_u8(a: u8, b: u8) -> int {
    var r: int = 0
    r = mix(r, bit(a < b, 1))
    r = mix(r, bit(a <= b, 2))
    r = mix(r, bit(a > b, 3))
    r = mix(r, bit(a >= b, 4))
    return r
}

proc cmp_u32(a: u32, b: u32) -> int {
    var r: int = 0
    r = mix(r, bit(a < b, 1))
    r = mix(r, bit(a <= b, 2))
    r = mix(r, bit(a > b, 3))
    r = mix(r, bit(a >= b, 4))
    return r
}

proc cmp_u64(a: u64, b: u64) -> int {
    var r: int = 0
    r = mix(r, bit(a < b, 1))
    r = mix(r, bit(a <= b, 2))
    r = mix(r, bit(a > b, 3))
    r = mix(r, bit(a >= b, 4))
    return r
}

proc main() {
    var h: int = 19
    h = mix(h, cmp_i8(-1, 1))
    h = mix(h, cmp_i8(100, -100))
    h = mix(h, cmp_i8(7, 7))
    h = mix(h, cmp_i32(-1, 1))
    h = mix(h, cmp_i32(2147483647, -2147483647))
    h = mix(h, cmp_i64(-1, 1))
    h = mix(h, cmp_i64(9223372036854775807, -5))
    h = mix(h, cmp_u8(255, 1))
    h = mix(h, cmp_u8(3, 3))
    h = mix(h, cmp_u32(4000000000, 5))
    h = mix(h, cmp_u64(18446744073709551615, 1))
    h = mix(h, cmp_u64(1, 18446744073709551615))
    sair(h)
}
