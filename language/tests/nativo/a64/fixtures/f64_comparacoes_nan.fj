// A1.3(iii): comparacoes f64 com NaN, infinito e -0.0. NaN da falso em == < <= > >= e verdadeiro em !=; -0.0 == 0.0.
// Cada conferencia imprime S (ok) ou N. Esperado: exit=0 e stdout "SSSSSSSSSSSSSSSS" (16 conferencias).
foreign {
    link "c"
    proc syscall(num: int, a0: int, a1: int, a2: int, a3: int, a4: int, a5: int) -> int
    proc syscall_ptr = "syscall"(num: int, a0: int, a1: ^u8, a2: int, a3: int, a4: int, a5: int) -> int
}

const SYS_WRITE: int = 64

proc letra(c: u8) {
    var v: u8 = c
    _ = syscall_ptr(SYS_WRITE, 1, &v, 1, 0, 0, 0)
}

proc checar(ok: bool) {
    if ok {
        letra(83)
    } else {
        letra(78)
    }
}

proc main() {
    let zero: f64 = 0.0
    let ndn: f64 = zero / zero
    let inf: f64 = 1.0 / zero
    let menos_inf: f64 = -1.0 / zero
    let um: f64 = 1.0
    let menos_zero: f64 = -zero
    checar(not (ndn == ndn))
    checar(ndn != ndn)
    checar(not (ndn < um))
    checar(not (ndn <= um))
    checar(not (ndn > um))
    checar(not (ndn >= um))
    checar(not (um < ndn))
    checar(not (um > ndn))
    checar(inf > um)
    checar(menos_inf < -um)
    checar(inf >= inf)
    checar(inf != menos_inf)
    checar(menos_zero == zero)
    checar(not (menos_zero < zero))
    checar(menos_zero <= zero)
    checar(zero >= menos_zero)
}
