// A2.2(e): COPIA_MEM e ZERA_MEM acima de 64 B (320 B) vao ao runtime (memcpy/memset do rt_a64); prova de correcao, nao de desempenho
proc main() {
    var a: [40]int = {}
    for i in 0..<40 {
        a[i] = i * 3
    }
    var b = a
    b[0] = 99
    var s: int = 0
    for i in 0..<40 {
        s += b[i]
    }
    print(s)
    print(a[0] + a[39])
}
