// A1.3(i) sem runtime: o x86_64-linux (oraculo) resolve `syscall` na libc; no aarch64-linux o backend emite o mesmo svc (a64_intr.fj).
// SYS_* sao os numeros do aarch64 (asm-generic); o .esperado vem de rodar a fixture no x86_64-linux com SYS_WRITE=1 e SYS_EXIT=231.
// Prova: recursao (quadro por chamada, x29/x30 salvos e restaurados) e recursao mutua; fib(20) = 6765.
foreign {
    link "c"
    proc syscall(num: int, a0: int, a1: int, a2: int, a3: int, a4: int, a5: int) -> int
}

const SYS_WRITE: int = 64
const SYS_EXIT: int = 94

proc sair(n: int) {
    _ = syscall(SYS_EXIT, n, 0, 0, 0, 0, 0)
}

proc fib(n: int) -> int {
    if n < 2 {
        return n
    }
    return wrapping_add(fib(wrapping_sub(n, 1)), fib(wrapping_sub(n, 2)))
}

proc par(n: int) -> bool {
    if n == 0 {
        return true
    }
    return impar(wrapping_sub(n, 1))
}

proc impar(n: int) -> bool {
    if n == 0 {
        return false
    }
    return par(wrapping_sub(n, 1))
}

proc main() {
    var r: int = fib(20)
    if par(10) {
        r = wrapping_add(r, 1000)
    }
    if impar(7) {
        r = wrapping_add(r, 100000)
    }
    sair(r)
}
