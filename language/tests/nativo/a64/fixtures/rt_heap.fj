// A2.2(d): heap sobre a janela mmap (new, make, append com realocacao, format com alloc = heap) com delete explicito; sem vazamento.
struct Bala {
    dano: int = 1
}

proc main() {
    let b = new(Bala, alloc = heap)
    defer delete(b)
    var l = make([dynamic]int, alloc = heap, cap = 4)
    defer delete(l)
    append(&l, item = 7)
    append(&l, item = 9)
    append(&l, item = 11)
    append(&l, item = 13)
    append(&l, item = 15)
    print(b.dano + l[0] + len(l))
    let s = format(f"vida {7} x={3:03}", alloc = heap)
    defer delete(s)
    print(s)
}
