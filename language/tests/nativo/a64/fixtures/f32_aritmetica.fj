// A1.3(iii): aritmetica f32 (fadd/fsub/fmul/fdiv/fneg/fsqrt) com valores exatos em binario. Cada conferencia imprime S (ok) ou N.
// SYS_WRITE=64 (aarch64). O oraculo x86_64-linux troca por 1 (ver aritmetica_i32.fj). Esperado: exit=0 e stdout "SSSSSS".
foreign {
    link "c"
    proc syscall(num: int, a0: int, a1: int, a2: int, a3: int, a4: int, a5: int) -> int
    proc syscall_ptr = "syscall"(num: int, a0: int, a1: ^u8, a2: int, a3: int, a4: int, a5: int) -> int
}

const SYS_WRITE: int = 64

proc letra(c: u8) {
    var v: u8 = c
    _ = syscall_ptr(SYS_WRITE, 1, &v, 1, 0, 0, 0)
}

proc checar(ok: bool) {
    if ok {
        letra(83)
    } else {
        letra(78)
    }
}

proc main() {
    let x: f32 = 1.5
    let y: f32 = 2.25
    let soma: f32 = 3.75
    let dif: f32 = 0.75
    let prod: f32 = 3.375
    let meio: f32 = 1.5
    checar(x + y == soma)
    checar(y - x == dif)
    checar(x * y == prod)
    checar(y / x == meio)
    checar(-x == -1.5)
    checar(sqrt(y) == meio)
}
