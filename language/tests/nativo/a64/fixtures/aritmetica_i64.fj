// A1.3(i) sem runtime: o x86_64-linux (oraculo) resolve `syscall` na libc; no aarch64-linux o backend emite o mesmo svc (a64_intr.fj).
// SYS_* sao os numeros do aarch64 (asm-generic); o .esperado vem de rodar a fixture no x86_64-linux com SYS_WRITE=1 e SYS_EXIT=231.
// Prova: aritmetica e logica de 64 bits com constantes de varias meias-palavras (mov_imm MOVZ/MOVN/MOVK).
foreign {
    link "c"
    proc syscall(num: int, a0: int, a1: int, a2: int, a3: int, a4: int, a5: int) -> int
}

const SYS_WRITE: int = 64
const SYS_EXIT: int = 94

proc sair(n: int) {
    _ = syscall(SYS_EXIT, n, 0, 0, 0, 0, 0)
}

proc mix(h: int, v: int) -> int {
    return wrapping_add(wrapping_mul(h, 1099511628211), v)
}

proc f(a: i64, b: i64) -> i64 {
    var r = wrapping_mul(a, 19088743)
    r = wrapping_add(r, b)
    r = wrapping_sub(r, 140737488355327)
    return r
}

proc g(a: u64, b: u64) -> u64 {
    let x = (a & 18374966859414961920) | (b ~ 1311768467463790320)
    return ~x
}

proc main() {
    let r1 = f(123456789012, -42)
    let r2 = f(-5, 9223372036854775807)
    let r3 = g(1234605616436508552, 72057594037927935)
    var h: int = 3
    h = mix(h, r1)
    h = mix(h, r2)
    h = mix(h, transmute(r3, to = int))
    h = mix(h, -65536)
    h = mix(h, 4294967296)
    sair(h)
}
