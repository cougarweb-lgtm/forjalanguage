// A1.3(iii): comparacoes f32 com NaN e selecao f32 (fcmp/cset com condicoes ordenadas; fcsel de 32 bits). Cada conferencia imprime S (ok) ou N.
// Esperado: exit=0 e stdout "SSSSSSSSSSSS" (12 conferencias).
foreign {
    link "c"
    proc syscall(num: int, a0: int, a1: int, a2: int, a3: int, a4: int, a5: int) -> int
    proc syscall_ptr = "syscall"(num: int, a0: int, a1: ^u8, a2: int, a3: int, a4: int, a5: int) -> int
}

const SYS_WRITE: int = 64

proc letra(c: u8) {
    var v: u8 = c
    _ = syscall_ptr(SYS_WRITE, 1, &v, 1, 0, 0, 0)
}

proc checar(ok: bool) {
    if ok {
        letra(83)
    } else {
        letra(78)
    }
}

proc menor_f32(a: f32, b: f32) -> f32 {
    var r: f32 = b
    if a < b {
        r = a
    }
    return r
}

proc maior_f32(a: f32, b: f32) -> f32 {
    var r: f32 = a
    if a < b {
        r = b
    }
    return r
}

proc main() {
    let zero: f32 = 0.0
    let ndn: f32 = zero / zero
    let um: f32 = 1.0
    let dois: f32 = 2.0
    checar(not (ndn == um))
    checar(ndn != um)
    checar(not (ndn < um))
    checar(not (ndn <= um))
    checar(not (ndn > um))
    checar(not (ndn >= um))
    checar(um < dois)
    checar(um <= um)
    checar(dois > um)
    checar(dois >= dois)
    checar(menor_f32(dois, um) == um)
    checar(maior_f32(um, ndn) == um)
}
