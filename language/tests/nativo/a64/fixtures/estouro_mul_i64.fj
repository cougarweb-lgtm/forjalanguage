// A1.3(iv): MUL_OV com sinal e sem sinal em I64 (smulh/umulh + comparacao). 4294967296 * 2147483647 cabe em i64 (imprime O);
// 4294967296 * 4294967296 = 2^64 estoura em u64 (sem sinal, umulh; nada mais e impresso, exit 101 em dev; em release faz wrap, ver `_release.esperado`).
// SYS_WRITE=64 e SYS_EXIT=94 (aarch64). O oraculo x86_64-linux troca por 1 e 231 (ver aritmetica_i32.fj).
// Esperado: exit=101 e stdout "O".
foreign {
    link "c"
    proc syscall(num: int, a0: int, a1: int, a2: int, a3: int, a4: int, a5: int) -> int
    proc syscall_ptr = "syscall"(num: int, a0: int, a1: ^u8, a2: int, a3: int, a4: int, a5: int) -> int
}

const SYS_WRITE: int = 64

proc letra(c: u8) {
    var v: u8 = c
    _ = syscall_ptr(SYS_WRITE, 1, &v, 1, 0, 0, 0)
}

proc main() {
    let a: i64 = 4294967296
    let b: i64 = 2147483647
    let c = a * b
    if c == 0 {
        letra(78)
    }
    letra(79)
    let u: u64 = 4294967296
    let w: u64 = 4294967296
    let r = u * w
    if r == 0 {
        letra(78)
    }
}
