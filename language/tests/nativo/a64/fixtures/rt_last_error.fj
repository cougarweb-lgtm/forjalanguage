// J1d: std:os.last_error e error_text: abrir arquivo que nao existe grava o errno (ENOENT = 2) e o texto do errno em ingles
import "std:file"
import "std:os"

proc main() {
    switch r in file.open("/nao_existe_forja/arquivo.txt", mode = file.OpenMode.read) {
    case file.File:
        print(0)
    case file.FileError:
        print(os.last_error())
        let texto = os.error_text(os.last_error(), alloc = heap)
        print(texto)
        delete(texto)
    }
}
