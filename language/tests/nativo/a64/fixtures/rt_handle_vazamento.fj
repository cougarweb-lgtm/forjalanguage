// J1c: arquivo aberto e nunca fechado = R0009 de handle no fim do programa em dev (exit 101); release nao checa (exit 0).
// /dev/null so serve para abrir o handle (sem efeito no disco).
import "std:file"

proc main() {
    switch r in file.open("/dev/null", mode = file.OpenMode.read) {
    case file.File:
        print(1)
    case file.FileError:
        print(0)
    }
}
