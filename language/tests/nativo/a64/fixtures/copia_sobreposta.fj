// A3.3k: lista de structs de 72 B com insert_at/ordered_remove: copia sobreposta (memmove) cai no caminho LENTO do a64
struct Reg {
    chave: int
    resto: [8]int
}

proc novo(k: int) -> Reg {
    var r = Reg{chave = k}
    for i in 0..<8 {
        r.resto[i] = k * 10 + i
    }
    return r
}

proc main() {
    var l = make([dynamic]Reg, alloc = heap)
    defer delete(l)
    for k in 0..<12 {
        append(&l, item = novo(k))
    }
    insert_at(&l, i = 3, item = novo(100))
    insert_at(&l, i = 0, item = novo(200))
    ordered_remove(&l, i = 5)
    ordered_remove(&l, i = 0)
    var s: int = 0
    for i, r in l {
        s += (i + 1) * r.chave + r.resto[7]
    }
    print(len(l))
    print(s)
    print(l[3].chave)
    print(l[3].resto[7])
}
