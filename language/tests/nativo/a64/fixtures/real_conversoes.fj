// A1.3(iii): conversoes int -> real (scvtf/ucvtf, com sinal e sem sinal, i8 estendido antes) e f32 <-> f64 (fcvt). Cada conferencia imprime S (ok) ou N.
// Esperado: exit=0 e stdout "SSSSSSSSSS" (10 conferencias).
foreign {
    link "c"
    proc syscall(num: int, a0: int, a1: int, a2: int, a3: int, a4: int, a5: int) -> int
    proc syscall_ptr = "syscall"(num: int, a0: int, a1: ^u8, a2: int, a3: int, a4: int, a5: int) -> int
}

const SYS_WRITE: int = 64

proc letra(c: u8) {
    var v: u8 = c
    _ = syscall_ptr(SYS_WRITE, 1, &v, 1, 0, 0, 0)
}

proc checar(ok: bool) {
    if ok {
        letra(83)
    } else {
        letra(78)
    }
}

proc converte_i32(v: i32) -> f64 {
    return v as f64
}

proc converte_i8(v: i8) -> f32 {
    return v as f32
}

proc main() {
    let negativo: i32 = -3
    let grande: u32 = 4000000000
    let pequeno: i8 = -7
    let sem_sinal: u8 = 255
    let bits_altos: i64 = 16777217
    let um_f64: f64 = 1.0
    checar(converte_i32(negativo) == -3.0 as f64)
    checar((grande as f64) == 4000000000.0 as f64)
    checar(converte_i8(pequeno) == -7.0)
    checar((sem_sinal as f32) == 255.0)
    checar((bits_altos as f32) == 16777216.0)
    let meio: f32 = 0.5
    let tres: f64 = 3.0
    checar((meio as f64) == 0.5 as f64)
    checar((tres as f32) == 3.0)
    let precisa: f64 = 16777217.0
    checar((precisa as f32) == 16777216.0)
    checar(((grande as f64) as f32) == 4000000000.0)
    checar((((sem_sinal as f64) as f32) as f64) == um_f64 * 255.0 as f64)
}
