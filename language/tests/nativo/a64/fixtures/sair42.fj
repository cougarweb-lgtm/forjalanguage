// A1.2 criou esta fixture para o gerador provisorio (main vazio, exit 42 fixo); no A1.3(i) o backend gera o programa de verdade,
// entao ela sai com 42 pelo svc de exit_group. O x86_64-linux (oraculo) resolve `syscall` na libc com SYS_EXIT=231 (ver aritmetica_i32.fj).
// Esperado: exit=42 e nada no stdout.
foreign {
    link "c"
    proc syscall(num: int, a0: int, a1: int, a2: int, a3: int, a4: int, a5: int) -> int
}

const SYS_WRITE: int = 64
const SYS_EXIT: int = 94

proc main() {
    _ = syscall(SYS_EXIT, 42, 0, 0, 0, 0, 0)
}
