// A1.3(i) sem runtime: o x86_64-linux (oraculo) resolve `syscall` na libc; no aarch64-linux o backend emite o mesmo svc (a64_intr.fj).
// SYS_* sao os numeros do aarch64 (asm-generic); o .esperado vem de rodar a fixture no x86_64-linux com SYS_WRITE=1 e SYS_EXIT=231.
// Prova: switch sobre enum (cadeia de CMP/DESVIA na BIR), com todos os casos e com default.
foreign {
    link "c"
    proc syscall(num: int, a0: int, a1: int, a2: int, a3: int, a4: int, a5: int) -> int
}

const SYS_WRITE: int = 64
const SYS_EXIT: int = 94

proc sair(n: int) {
    _ = syscall(SYS_EXIT, n, 0, 0, 0, 0, 0)
}

proc mix(h: int, v: int) -> int {
    return wrapping_add(wrapping_mul(h, 1099511628211), v)
}

enum Cor {
    verde
    azul
    rubro
}

proc so_azul(c: Cor) -> int {
    switch c {
    case Cor.azul:
        return mix(100, 1)
    default:
        return mix(999, 2)
    }
    return 0
}

proc valor_da_cor(c: Cor) -> int {
    switch c {
    case Cor.verde:
        return 11
    case Cor.azul:
        return 22
    case Cor.rubro:
        return 33
    }
    return 0
}

proc main() {
    var h: int = 31
    h = mix(h, so_azul(Cor.azul))
    h = mix(h, so_azul(Cor.verde))
    h = mix(h, so_azul(Cor.rubro))
    h = mix(h, valor_da_cor(Cor.verde))
    h = mix(h, valor_da_cor(Cor.azul))
    h = mix(h, valor_da_cor(Cor.rubro))
    sair(h)
}
