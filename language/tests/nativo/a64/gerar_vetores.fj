// mascara de w bits (0..64)
proc a64_mascara(w: u32) -> u64 {
    if w >= 64 {
        return 18446744073709551615
    }
    return (1 as u64 << (w as u64)) - 1
}

// OR dos campos (mascarados) nas posicoes do layout lay
proc a64_campos_em_bits(lay: int, c: ^A64Campos) -> u32 {
    var acc: u32 = 0
    var k: int = 0
    let n = A64_LAY_ARGS[lay] as int
    while k < n {
        let w = A64_LAY_LARG[lay][k]
        let s = A64_LAY_DESLOC[lay][k]
        let campo = (c.v[k] & a64_mascara(w)) << (s as u64)
        acc = acc | (campo as u32)
        k += 1
    }
    return acc
}

// palavra da forma: base | campos. Layout com espelho (BITF) copia o sf para o bit do N.
pub proc a64_codificar(forma: u32, c: ^A64Campos) -> u32 {
    let lay = A64_FORMA_LAY[forma as int] as int
    var palavra: u32 = A64_FORMA_BASE[forma as int]
    palavra = palavra | a64_campos_em_bits(lay, c)
    let espelho = A64_LAY_ESPELHO[lay] as u64
    if espelho != 0 {
        palavra = palavra | (((c.v[0] & 1) << espelho) as u32)
    }
    return palavra
}

// ADR/ADRP: separa o imm21 (bytes ou paginas) em immlo (2 bits, bit 29) e immhi (19 bits, bit 5)
pub proc a64_cod_adr(forma: u32, imm21: i64, rd: u32) -> u32 {
    var c = A64Campos{v = {0, 0, 0, 0, 0, 0, 0, 0}}
    var positivo = imm21
    if imm21 < 0 {
        positivo = imm21 + 2097152
    }
    let bruto = positivo as u64
    c.v[0] = bruto & 3
    c.v[1] = (bruto >> 2) & 524287
    c.v[2] = rd as u64
    return a64_codificar(forma, &c)
}

// contagem de bits 1 de v
proc a64_popcount(v: u64) -> u32 {
    var x = v
    var n: u32 = 0
    while x != 0 {
        n += (x & 1) as u32
        x = x >> 1
    }
    return n
}

// tamanho do menor elemento (2..bits, potencia de 2) que, repetido, reconstroi valor
proc a64_replica(el: u64, e: u32, bits: u32) -> u64 {
    var r: u64 = 0
    var i: u32 = 0
    while i < bits {
        r = r | (el << (i as u64))
        i += e
    }
    return r
}

proc a64_tamanho_elemento(valor: u64, bits: u32) -> u32 {
    var e: u32 = 2
    while e < bits {
        if a64_replica(valor & a64_mascara(e), e, bits) == valor {
            return e
        }
        e = e * 2
    }
    return bits
}

// bit mais baixo do unico bloco de 1s do elemento (circular dentro de e bits); -1 se nao for um bloco unico
proc a64_inicio_bloco(el: u64, e: u32) -> int {
    var achados: int = 0
    var inicio: int = -1
    var i: u32 = 0
    while i < e {
        let atual = (el >> (i as u64)) & 1
        let antes = (i + e - 1) % e
        let anterior = (el >> (antes as u64)) & 1
        if (atual == 1) and (anterior == 0) {
            achados += 1
            inicio = i as int
        }
        i += 1
    }
    if achados != 1 {
        return -1
    }
    return inicio
}

// valor e imediato logico de bits (32 ou 64)? Se sim, grava N/immr/imms (ARM ARM DecodeBitMasks ao contrario).
// LIMITE: 5 parametros, assinatura do contrato §2.3 (os tres campos saem por ponteiro).
pub proc a64_bitmask(valor: u64, bits: u32, n: ^u32, immr: ^u32, imms: ^u32) -> bool {
    if (bits != 32) and (bits != 64) {
        return false
    }
    if (bits == 32) and ((valor >> 32) != 0) {
        return false
    }
    if (valor == 0) or (valor == a64_mascara(bits)) {
        return false
    }
    let e = a64_tamanho_elemento(valor, bits)
    let el = valor & a64_mascara(e)
    let uns = a64_popcount(el)
    let p = a64_inicio_bloco(el, e)
    if (p < 0) or (uns == e) {
        return false
    }
    var rot: u32 = 0
    if p > 0 {
        rot = e - (p as u32)
    }
    let s = uns - 1
    if e == 64 {
        n^ = 1
        imms^ = s
    } else {
        n^ = 0
        imms^ = 64 - 2 * e + s
    }
    immr^ = rot
    return true
}

// meia-palavra i (16 bits) de valor
proc a64_meia(valor: u64, i: int) -> u64 {
    return (valor >> ((i as u64) * 16)) & 65535
}

proc a64_conta_meias(valor: u64, meias: int, alvo: u64) -> int {
    var n: int = 0
    var i: int = 0
    while i < meias {
        if a64_meia(valor, i) == alvo {
            n += 1
        }
        i += 1
    }
    return n
}

// palavra MOVZ/MOVN/MOVK: sf (x), hw (0..3), imm16 e rd
proc a64_palavra_movw(forma: u32, x: bool, hw: int, imm16: u64, rd: u32) -> u32 {
    var c = A64Campos{v = {0, 0, 0, 0, 0, 0, 0, 0}}
    if x {
        c.v[0] = 1
    }
    c.v[1] = hw as u64
    c.v[2] = imm16
    c.v[3] = rd as u64
    return a64_codificar(forma, &c)
}

// materializa valor em destino: MOVN quando ha mais meias 0xFFFF que 0x0000, senao MOVZ; MOVK nas demais.
// Grava as palavras em saida e devolve quantas (1..4). x=false: 32 bits (sf=0), so as duas meias baixas.
pub proc a64_mov_imm(destino: u32, valor: u64, x: bool, saida: ^[4]u32) -> u32 {
    var meias: int = 2
    if x {
        meias = 4
    }
    var forma: u32 = A64F_MOVZ
    var fundo: u64 = 0
    if a64_conta_meias(valor, meias, 65535) > a64_conta_meias(valor, meias, 0) {
        forma = A64F_MOVN
        fundo = 65535
    }
    var n: int = 0
    var i: int = 0
    while i < meias {
        let h = a64_meia(valor, i)
        if h != fundo {
            var forma_w: u32 = A64F_MOVK
            var imm: u64 = h
            if n == 0 {
                forma_w = forma
                if fundo == 65535 {
                    imm = 65535 - h
                }
            }
            saida^[n] = a64_palavra_movw(forma_w, x, i, imm, destino)
            n += 1
        }
        i += 1
    }
    if n == 0 {
        saida^[0] = a64_palavra_movw(forma, x, 0, 0, destino)
        n = 1
    }
    return n as u32
}

// VFPExpandImm (ARM ARM): imm8 -> bits de f32 (dupla = false) ou f64 (dupla = true)
proc a64_vfp_expandir(imm8: u32, dupla: bool) -> u64 {
    let a = ((imm8 >> 7) & 1) as u64
    let b = ((imm8 >> 6) & 1) as u64
    let cd = ((imm8 >> 4) & 3) as u64
    let efgh = (imm8 & 15) as u64
    if dupla {
        let expo = ((1 - b) << 10) | ((b * 255) << 2) | cd
        return (a << 63) | (expo << 52) | (efgh << 48)
    }
    let expo32 = ((1 - b) << 7) | ((b * 31) << 2) | cd
    return (a << 31) | (expo32 << 23) | (efgh << 19)
}

// procura imm8 (0..255) cuja expansao e `bits` (f32: 32 bits baixos). Verdadeiro = representavel; grava imm8.
pub proc a64_fmov_imm8(bits: u64, dupla: bool, imm8: ^u32) -> bool {
    var alvo = bits
    if not dupla {
        alvo = bits & 4294967295
    }
    var i: u32 = 0
    while i < 256 {
        if a64_vfp_expandir(i, dupla) == alvo {
            imm8^ = i
            return true
        }
        i += 1
    }
    return false
}

// ==== GERADOR (so neste arquivo) ====

const GER_ALEAT: int = 200
const GER_MOV_ALEAT: int = 2000
const GER_Q_ALEAT: int = 600
const GER_A_ALEAT: int = 500

pub struct Gerador {
    est: u64
}

// xorshift64: sequencia determinista (semente fixa no main)
proc prox(g: ^Gerador) -> u64 {
    var x = g.est
    x = x ~ (x << 13)
    x = x ~ (x >> 7)
    x = x ~ (x << 17)
    g.est = x
    return x
}

proc sorteia(g: ^Gerador, w: u32) -> u64 {
    return prox(g) & a64_mascara(w)
}

// valor de borda k (0 = zero, 1 = um, 2 = maximo, 3 = maximo-1, 4 = bit alto) para um campo de w bits (w >= 1)
proc borda(k: u64, w: u32) -> u64 {
    let m = a64_mascara(w)
    if k == 0 {
        return 0
    }
    if k == 1 {
        return 1 & m
    }
    if k == 2 {
        return m
    }
    if k == 3 {
        return m - 1
    }
    return (1 as u64 << ((w - 1) as u64)) & m
}

// sorteia todos os campos do layout lay
proc sorteia_campos(g: ^Gerador, lay: int, c: ^A64Campos) {
    var k: int = 0
    let n = A64_LAY_ARGS[lay] as int
    while k < n {
        c.v[k] = sorteia(g, A64_LAY_LARG[lay][k])
        k += 1
    }
}

// restricoes para a palavra sair valida (o encoder so mascara): sf=0 pede imediatos de 5 bits, cond 0..13 etc.
proc arruma_campos(lay: int, c: ^A64Campos) {
    let sf = c.v[0]
    if (lay == A64L_LOGI) and (sf == 0) {
        c.v[1] = 0
        c.v[2] = c.v[2] & 31
        c.v[3] = c.v[3] & 31
    }
    if (lay == A64L_BITF) and (sf == 0) {
        c.v[1] = c.v[1] & 31
        c.v[2] = c.v[2] & 31
    }
    if (lay == A64L_ADDR) {
        c.v[1] = c.v[1] % 3
        if sf == 0 {
            c.v[3] = c.v[3] & 31
        }
    }
    if (lay == A64L_LOGR) and (sf == 0) {
        c.v[4] = c.v[4] & 31
    }
    if (lay == A64L_MOVW) and (sf == 0) {
        c.v[1] = c.v[1] & 1
    }
    if lay == A64L_CSEL {
        c.v[2] = c.v[2] % 14
    }
    if lay == A64L_BCOND {
        c.v[1] = c.v[1] % 14
    }
    if (lay == A64L_FCMP) and (c.v[3] == 1) {
        c.v[1] = 0
    }
    if lay == A64L_ADDX {
        c.v[3] = c.v[3] % 5
    }
}

// imprime uma linha F: forma, campos e palavra do encoder
proc emite_forma(forma: u32, c: ^A64Campos, saida: ^[dynamic]u8) {
    let lay = A64_FORMA_LAY[forma as int] as int
    arruma_campos(lay, c)
    format(f"F {forma}", into = saida)
    var k: int = 0
    while k < (A64_LAY_ARGS[lay] as int) {
        let valor = c.v[k]
        format(f" {valor}", into = saida)
        k += 1
    }
    let palavra = a64_codificar(forma, c)
    format(f" {palavra}", into = saida)
    append(saida, item = "\n")
}

// grade de bordas por campo (um campo por vez, os outros sorteados) mais GER_ALEAT vetores sorteados
proc gera_forma(g: ^Gerador, forma: u32, saida: ^[dynamic]u8) {
    let lay = A64_FORMA_LAY[forma as int] as int
    let n = A64_LAY_ARGS[lay] as int
    var c = A64Campos{v = {0, 0, 0, 0, 0, 0, 0, 0}}
    var rep: int = 0
    while rep < GER_ALEAT {
        sorteia_campos(g, lay, &c)
        emite_forma(forma, &c, saida)
        rep += 1
    }
    var k: int = 0
    while k < n {
        var e: u64 = 0
        while e < 5 {
            sorteia_campos(g, lay, &c)
            c.v[k] = borda(e, A64_LAY_LARG[lay][k])
            emite_forma(forma, &c, saida)
            e += 1
        }
        k += 1
    }
}

// decodifica (N, immr, imms) como DecodeBitMasks da ARM ARM (independente do encoder); 0 = triplo reservado
proc decodifica_mascara(n: u64, immr: u64, imms: u64) -> u64 {
    let cod = (n << 6) | ((~imms) & 63)
    var b: u32 = 6
    while ((cod >> (b as u64)) & 1) == 0 {
        if b == 0 {
            return 0
        }
        b -= 1
    }
    let esize = (1 as u64) << (b as u64)
    let niveis = esize - 1
    let s = imms & niveis
    if s == niveis {
        return 0
    }
    let r = immr & niveis
    let el = (1 as u64 << (s + 1)) - 1
    var rot = el
    if r != 0 {
        rot = ((el >> r) | (el << (esize - r))) & a64_mascara(esize as u32)
    }
    return a64_replica(rot, esize as u32, 64)
}

// AND imm para cada (N, immr, imms) valido (V = valor decodificado) e para valores sorteados
proc gera_bitmask(g: ^Gerador, saida: ^[dynamic]u8) {
    var nn: u64 = 0
    while nn < 2 {
        var ir: u64 = 0
        while ir < 64 {
            var is: u64 = 0
            while is < 64 {
                let v = decodifica_mascara(nn, ir, is)
                if v != 0 {
                    emite_mascara(g, v, saida)
                }
                is += 1
            }
            ir += 1
        }
        nn += 1
    }
    var i: int = 0
    while i < GER_ALEAT * 10 {
        emite_mascara(g, prox(g), saida)
        i += 1
    }
}

// uma linha M: sf=1 com bits=64; quando o valor cabe em 32 bits, tambem uma linha sf=0 (bits=32)
proc emite_mascara(g: ^Gerador, valor: u64, saida: ^[dynamic]u8) {
    var n: u32 = 0
    var immr: u32 = 0
    var imms: u32 = 0
    let rn = sorteia(g, 5) as u32
    let rd = sorteia(g, 5) as u32
    var palavra: u32 = 0
    let ok = a64_bitmask(valor, 64, &n, &immr, &imms)
    if ok {
        var c = A64Campos{v = {1, n as u64, immr as u64, imms as u64, rn as u64, rd as u64, 0, 0}}
        palavra = a64_codificar(A64F_AND_IMM, &c)
    }
    var flag: u32 = 0
    if ok {
        flag = 1
    }
    format(f"M 1 {rn} {rd} {valor} {flag} {palavra}", into = saida)
    append(saida, item = "\n")
    if (valor >> 32) == 0 {
        let ok32 = a64_bitmask(valor, 32, &n, &immr, &imms)
        var palavra32: u32 = 0
        if ok32 {
            var c32 = A64Campos{v = {0, n as u64, immr as u64, imms as u64, rn as u64, rd as u64, 0, 0}}
            palavra32 = a64_codificar(A64F_AND_IMM, &c32)
        }
        var flag32: u32 = 0
        if ok32 {
            flag32 = 1
        }
        format(f"M 0 {rn} {rd} {valor} {flag32} {palavra32}", into = saida)
        append(saida, item = "\n")
    }
}

// mov_imm: valores de borda e sorteados (x = 64 bits quando i e par; senao 32)
proc gera_mov_imm(g: ^Gerador, saida: ^[dynamic]u8) {
    let bordas: [8]u64 = {0, 1, 65535, 65536, 4294967295, 18446744073709551615, 9223372036854775808, 305419896}
    var i: int = 0
    while i < GER_MOV_ALEAT + 8 {
        var v: u64 = prox(g)
        if i < 8 {
            v = bordas[i]
        } else if (i % 3) == 1 {
            v = v & prox(g)
        } else if (i % 3) == 2 {
            v = v | prox(g)
        }
        let x = (i % 2) == 0
        if not x {
            v = v & 4294967295
        }
        let rd = sorteia(g, 5) as u32
        var palavras: [4]u32 = {0, 0, 0, 0}
        let n = a64_mov_imm(rd, v, x, &palavras)
        var sfx: u32 = 0
        if x {
            sfx = 1
        }
        format(f"W {sfx} {rd} {v} {n}", into = saida)
        var k: u32 = 0
        while k < n {
            format(f" {palavras[k as int]}", into = saida)
            k += 1
        }
        append(saida, item = "\n")
        i += 1
    }
}

// fmov_imm8: todas as 256 expansoes (f32 e f64) e bits sorteados; a64_fmov_imm8 diz se cabe
proc gera_fmov_imm8(g: ^Gerador, saida: ^[dynamic]u8) {
    var dupla: u64 = 0
    while dupla < 2 {
        let eh_dupla = dupla == 1
        var i: u32 = 0
        while i < 256 {
            emite_fmov(dupla, a64_vfp_expandir(i, eh_dupla), saida)
            i += 1
        }
        var r: int = 0
        while r < GER_Q_ALEAT {
            var bits = prox(g)
            if not eh_dupla {
                bits = bits & 4294967295
            }
            emite_fmov(dupla, bits, saida)
            r += 1
        }
        dupla += 1
    }
}

proc emite_fmov(dupla: u64, bits: u64, saida: ^[dynamic]u8) {
    var imm8: u32 = 0
    let ok = a64_fmov_imm8(bits, dupla == 1, &imm8)
    var flag: u32 = 0
    if ok {
        flag = 1
    }
    format(f"Q {dupla} {bits} {flag} {imm8}", into = saida)
    append(saida, item = "\n")
}

// ADR e ADRP com imm21 sorteado (com sinal) e rd sorteado
proc gera_adr(g: ^Gerador, saida: ^[dynamic]u8) {
    var r: int = 0
    while r < GER_A_ALEAT {
        var forma: u32 = A64F_ADR
        if (r % 2) == 1 {
            forma = A64F_ADRP
        }
        let imm21 = (sorteia(g, 21) as i64) - 1048576
        let rd = sorteia(g, 5) as u32
        let palavra = a64_cod_adr(forma, imm21, rd)
        format(f"A {forma} {imm21} {rd} {palavra}", into = saida)
        append(saida, item = "\n")
        r += 1
    }
}

proc main() {
    var g = Gerador{est = 88172645463325252}
    var saida = make([dynamic]u8, alloc = heap, cap = 1048576)
    defer delete(saida)
    var f: u32 = 0
    while f < A64_FORMAS_QTD {
        gera_forma(&g, f, &saida)
        f += 1
    }
    gera_bitmask(&g, &saida)
    gera_mov_imm(&g, &saida)
    gera_fmov_imm8(&g, &saida)
    gera_adr(&g, &saida)
    os.write_stdout(saida[..])
}
