// zlib_crc.fj - M6c P84: prova do D0655(b) nos 2 alvos: crc32 de "abc" = 0x352441C2 (891568578) e compressao ida e volta pelo vendor:compression.
// Versao: 0.1.0 | Changelog: 0.1.0 - P81: primeira versao (fixture nova; falha hoje: compression.fj/zlib.fj usam u32 e nao c_ulong).
// Verificacao: python tests\nativo\m6c\verificar_m6c.py --forja <forja.exe> --grupo clong --alvo ambos
// Esperado nos 2 alvos: stdout "891568578", "3", "97" (uma linha cada), exit 0.

import "vendor:compression/compression"
import "vendor:compression/zlib" as zl

proc main() {
    var dados: [3]u8 = {97, 98, 99}
    print(zl.crc32(0, &dados[0], 3) as u32)
    var comp: [64]u8 = {}
    switch n in compression.compress(dados[..], dst = comp[..], level = 9) {
    case i64:
        var volta: [3]u8 = {}
        switch m in compression.decompress(comp[0..<(n as int)], dst = volta[..]) {
        case i64:
            print(m)
            print(volta[0] as int)
        case compression.ZlibError:
            print("erro")
        }
    case compression.ZlibError:
        print("erro")
    }
}
