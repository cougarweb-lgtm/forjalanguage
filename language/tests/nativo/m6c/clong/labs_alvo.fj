// labs_alvo.fj - M6c P82: labs de c_long (apelido por alvo) com o cast de volta para int: 7 nos dois alvos.
// Versao: 0.1.0 | Changelog: 0.1.0 - P81: primeira versao (fixture nova; falha hoje: c_long nao existe).
// Verificacao: python tests\nativo\m6c\verificar_m6c.py --forja <forja.exe> --grupo clong --alvo ambos
// Esperado: windows e linux stdout "7", exit 0 (tabela no labs_alvo.esperado).
// Sem 'link': labs e da libc padrao dos 2 alvos (como ok_foreign.fj).

foreign {
    proc labs(n: c_long) -> c_long
}

proc main() {
    print(labs(-7 as c_long) as int)
}
