// strtoul_grande.fj - M6c P82: strtoul devolve c_ulong; "4294967296" cabe em u64 mas nao em c_ulong no Windows (LLP64): o valor satura em 4294967295.
// Versao: 0.1.0 | Changelog: 0.1.0 - P81: primeira versao (fixture nova; falha hoje: c_ulong nao existe).
// Verificacao: python tests\nativo\m6c\verificar_m6c.py --forja <forja.exe> --grupo clong --alvo ambos
// Esperado: windows stdout "4294967295", linux stdout "4294967296", exit 0 (tabela no strtoul_grande.esperado).

foreign {
    proc strtoul(s: cstr, fim: rawptr, base: i32) -> c_ulong
}

proc main() {
    print(strtoul("4294967296", none, 10) as u64)
}
