// gzheader_layout.fj - M6c P84: layout de zl.GzHeaderS (gz_header do zlib.h): tamanho e offsets do campo time (c_ulong = uLong) e do xflags depois dele.
// Versao: 0.1.0 | Changelog: 0.1.0 - P81: primeira versao (fixture nova; falha hoje: c_ulong nao existe no zlib.fj de hoje, que usa u32).
// Verificacao: python tests\nativo\m6c\verificar_m6c.py --forja <forja.exe> --grupo clong --alvo ambos
// Numeros do gabarito (gcc do MinGW e gcc do alpine, lidos em P81 com o zlib.h vendorizado; ver tests\nativo\m6c\CENSO.txt):
//   windows: size 72, offset(time) 4, offset(xflags) 8
//   linux:   size 80, offset(time) 8, offset(xflags) 16

import "vendor:compression/zlib" as zl

proc main() {
    print(size_of(zl.GzHeaderS))
    print(offset_of(zl.GzHeaderS.time))
    print(offset_of(zl.GzHeaderS.xflags))
}
