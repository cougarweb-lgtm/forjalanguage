// handle_threads.fj - M6c P88: 6 threads (std:thread) abrem e fecham cada um o seu malloc: a lista de handles e sob trava (D0657); 20 de 20 sem R0009.
// Versao: 0.1.0 | Changelog: 0.1.0 - P81: primeira versao (fixture nova; falha hoje: 'creates' ainda nao existe).
// Verificacao: python tests\nativo\m6c\verificar_m6c.py --forja <forja.exe> --grupo handle --alvo ambos --repetir 20
// Esperado: stdout "6", stderr sem R0009, exit 0 nos 2 alvos, em todas as rodadas.
import "std:thread"

const FIOS: int = 6

foreign {
    proc c_malloc = "malloc"(n: u64) -> rawptr creates
    proc c_free = "free"(p: rawptr) destroys p
}

proc filha(p: rawptr) -> u32 {
    let bloco = c_malloc(32)
    c_free(bloco)
    return 0
}

proc main() {
    var rs: [6]int = {}
    var fios: [6]thread.Thread = {}
    for k in 0..<FIOS {
        switch t in thread.spawn(filha, &rs[k] as rawptr) {
        case thread.Thread:
            fios[k] = t
        case thread.ThreadError:
            print("FALHA thread")
            return
        }
    }
    for k in 0..<FIOS {
        _ = thread.join(fios[k])
    }
    print(FIOS)
}
