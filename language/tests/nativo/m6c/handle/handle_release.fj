// handle_release.fj - M6c P88: abre e fecha dois mallocs; em --release o rastreio nao existe: exit 0, stdout "9", e nenhum simbolo forja_handle_* no exe.
// Versao: 0.1.0 | Changelog: 0.1.0 - P81: primeira versao (fixture nova; falha hoje: 'creates' ainda nao existe).
// Verificacao: python tests\nativo\m6c\verificar_m6c.py --forja <forja.exe> --grupo handle --alvo ambos
// Esperado dev: stdout "9", exit 0. Esperado --release (windows): stdout "9", exit 0, nenhum simbolo "forja_handle_" no exe.

foreign {
    proc c_malloc = "malloc"(n: u64) -> rawptr creates
    proc c_free = "free"(p: rawptr) destroys p
}

proc main() {
    let p = c_malloc(16)
    c_free(p)
    let q = c_malloc(8)
    c_free(q)
    print(9)
}
