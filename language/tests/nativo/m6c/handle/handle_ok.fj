// handle_ok.fj - M6c P88: malloc com 'creates' e free com 'destroys' no mesmo proc = nenhum R0009, exit 0.
// Versao: 0.1.0 | Changelog: 0.1.0 - P81: primeira versao (fixture nova; falha hoje: 'creates' ainda nao existe).
// Verificacao: python tests\nativo\m6c\verificar_m6c.py --forja <forja.exe> --grupo handle --alvo ambos
// Esperado: stdout "5", stderr sem linha R0009, exit 0 nos 2 alvos.

foreign {
    proc c_malloc = "malloc"(n: u64) -> rawptr creates
    proc c_free = "free"(p: rawptr) destroys p
}

proc main() {
    let p = c_malloc(16)
    c_free(p)
    print(5)
}
