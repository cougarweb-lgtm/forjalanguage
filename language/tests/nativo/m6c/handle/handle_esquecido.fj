// handle_esquecido.fj - M6c P88: malloc declarado com 'creates' e devolvido por abrir_recurso (return entrega) e nunca liberado = R0009 "tipo":"handle", "kind":"malloc", pilha [abrir_recurso, main], exit 101.
// Versao: 0.1.0 | Changelog: 0.1.0 - P81: primeira versao (fixture nova; falha hoje: 'creates' ainda nao existe).
// Verificacao: python tests\nativo\m6c\verificar_m6c.py --forja <forja.exe> --grupo handle --alvo ambos
// Esperado: stdout "3", exit 101 nos 2 alvos (tabela no handle_esquecido.esperado). Sem 'link': malloc da libc padrao.

foreign {
    proc c_malloc = "malloc"(n: u64) -> rawptr creates
}

proc abrir_recurso() -> rawptr {
    let p = c_malloc(16)
    return p
}

proc main() {
    _ = abrir_recurso()
    print(3)
}
