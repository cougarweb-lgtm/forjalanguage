// sqlite_esquecido.fj - M6c P90: sqlite3_open com 'creates pp_db' (clausula de vendor/db/sqlite3.fj regenerada) e sem sqlite3_close = R0009 "tipo":"handle", "kind":"sqlite3_open", pilha [abre, main], exit 101.
// Versao: 0.2.0 | Changelog: 0.2.0 - P90: o handle sai por abre() (return entrega; E0317 estatico em main nao deixaria chegar ao R0009); pilha [abre, main]. 0.1.0 - P81: primeira versao (fixture nova; falha hoje: vendor/db/sqlite3.fj ainda sem clausula).
// Verificacao: python tests\nativo\m6c\verificar_m6c.py --forja <forja.exe> --grupo handle --alvo ambos
// Esperado: stdout "1", exit 101 nos 2 alvos (tabela no sqlite_esquecido.esperado).

import "vendor:db/sqlite3" as sq

proc abre() -> ?^sq.Sqlite3 {
    var db: ?^sq.Sqlite3 = none
    _ = sq.sqlite3_open(":memory:", pp_db = &db)
    return db
}

proc main() {
    _ = abre()
    print(1)
}
