// cjson_takes.fj - M6c P90: o item entregue ao objeto por 'takes item' sai da lista de vivos; cJSON_Delete do objeto libera tudo: 0 vivos, nenhum R0009, exit 0.
// Versao: 0.1.0 | Changelog: 0.1.0 - P81: primeira versao (fixture nova; falha hoje: vendor/json/cjson.fj ainda sem clausula).
// Verificacao: python tests\nativo\m6c\verificar_m6c.py --forja <forja.exe> --grupo handle --alvo ambos
// Esperado: stdout "1", stderr vazio, exit 0 nos 2 alvos.

import "vendor:json/cjson" as cj

proc main() {
    let obj = cj.cJSON_CreateObject()
    let item = cj.cJSON_CreateNumber(3.0)
    _ = cj.cJSON_AddItemToObject(obj, "n", item)
    cj.cJSON_Delete(obj)
    print(1)
}
