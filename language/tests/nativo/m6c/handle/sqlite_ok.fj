// sqlite_ok.fj - M6c P90: sqlite3_open com 'creates pp_db' seguido de sqlite3_close = nenhum R0009, exit 0.
// Versao: 0.1.0 | Changelog: 0.1.0 - P81: primeira versao (fixture nova; falha hoje: vendor/db/sqlite3.fj ainda sem clausula).
// Verificacao: python tests\nativo\m6c\verificar_m6c.py --forja <forja.exe> --grupo handle --alvo ambos
// Esperado: stdout "2", stderr vazio, exit 0 nos 2 alvos.

import "vendor:db/sqlite3" as sq

proc main() {
    var db: ?^sq.Sqlite3 = none
    _ = sq.sqlite3_open(":memory:", pp_db = &db)
    _ = sq.sqlite3_close(db)
    print(2)
}
