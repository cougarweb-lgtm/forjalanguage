// handle_fopen_none.fj - M6c P88: fopen de arquivo inexistente devolve NULL: o nascimento ignora o nulo, o if == none dispensa o fclose; sem R0009, exit 0.
// Versao: 0.1.0 | Changelog: 0.1.0 - P81: primeira versao (fixture nova; falha hoje: 'creates' ainda nao existe).
// Verificacao: python tests\nativo\m6c\verificar_m6c.py --forja <forja.exe> --grupo handle --alvo ambos
// Esperado: stdout "0", exit 0 nos 2 alvos (o arquivo nao existe; o caminho do fclose nunca roda).

foreign {
    opaque Arq
    proc fopen_c = "fopen"(caminho: cstr, modo: cstr) -> ?^Arq creates
    proc fclose_c = "fclose"(f: ?^Arq) -> i32 destroys f
}

proc main() {
    let f = fopen_c("nao_existe_m6c.txt", "r")
    if f == none {
        print(0)
        return
    }
    _ = fclose_c(f)
    print(5)
}
