// handle_desconhecido.fj - M6c P88: ponteiro vindo de malloc SEM clausula (nao rastreado) e liberado por free com 'destroys': solta de desconhecido = silencio, nenhum R0008, exit 0.
// Versao: 0.1.0 | Changelog: 0.1.0 - P81: primeira versao (fixture nova; falha hoje: 'creates' ainda nao existe).
// Verificacao: python tests\nativo\m6c\verificar_m6c.py --forja <forja.exe> --grupo handle --alvo ambos
// Esperado: stdout "1", stderr vazio, exit 0 nos 2 alvos.

foreign {
    proc c_malloc_sem_clausula = "malloc"(n: u64) -> rawptr
    proc c_free = "free"(p: rawptr) destroys p
}

proc pega() -> rawptr {
    return c_malloc_sem_clausula(16)
}

proc main() {
    let p = pega()
    c_free(p)
    print(1)
}
