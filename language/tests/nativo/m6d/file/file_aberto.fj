// file_aberto.fj - M6d P92a: File aberto e nao fechado (std:file com posse, D-M6d-9): R0009 handle kind forja_fs_abrir, forma_certa file.close.
// Versao: 0.1.0 | Changelog: 0.1.0 - P92a: primeira versao (falha hoje: std:file sem clausula creates/destroys, P92f).
// Esperado (2 alvos, dev): stdout "aberto"; R0009 handle com forma_certa "feche com file.close(&f)"; exit 101. Release: exit 0.
// Verificacao: python tests\nativo\m6d\verificar_m6d.py --grupo file --alvo ambos

import "std:file" as fs

proc abre_sem_fechar() {
    switch r in fs.open("m6d_aberto.txt", mode = fs.OpenMode.create) {
    case fs.File:
        print("aberto")
    case fs.FileError:
        print(r == fs.FileError.not_found)
    }
}

proc main() {
    abre_sem_fechar()
}
