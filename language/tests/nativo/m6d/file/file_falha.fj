// file_falha.fj - M6d P92a: open de arquivo inexistente devolve FileError, nao cria handle: nenhuma linha R0009, exit 0.
// Versao: 0.1.0 | Changelog: 0.1.0 - P92a: primeira versao (falha hoje: std:file sem clausula creates/destroys, P92f).
// Esperado (2 alvos): stdout "true", 0 linhas, exit 0.
// Verificacao: python tests\nativo\m6d\verificar_m6d.py --grupo file --alvo ambos

import "std:file" as fs

proc main() {
    switch r in fs.open("arquivo_que_nao_existe_m6d.txt", mode = fs.OpenMode.read) {
    case fs.File:
        print("aberto")
    case fs.FileError:
        print(r == fs.FileError.not_found)
    }
}
