// file_ok.fj - M6d P92a: File aberto e fechado com file.close(&f): nenhuma linha R0009, exit 0.
// Versao: 0.1.0 | Changelog: 0.1.0 - P92a: primeira versao (falha hoje: std:file sem clausula creates/destroys, P92f).
// Esperado (2 alvos): stdout "aberto", 0 linhas, exit 0.
// Verificacao: python tests\nativo\m6d\verificar_m6d.py --grupo file --alvo ambos

import "std:file" as fs

proc main() {
    switch r in fs.open("m6d_ok.txt", mode = fs.OpenMode.create) {
    case fs.File:
        print("aberto")
        var f = r
        fs.close(&f)
    case fs.FileError:
        print(r == fs.FileError.not_found)
    }
}
