// file_read_all.fj - M6d P92a: read_all devolve lista DONA (delete no case), sem handle: nenhuma linha R0009, exit 0.
// Versao: 0.1.0 | Changelog: 0.1.0 - P92a: primeira versao (falha hoje: std:file sem clausula creates/destroys, P92f).
// Esperado (2 alvos): stdout "falhou", 0 linhas, exit 0.
// Verificacao: python tests\nativo\m6d\verificar_m6d.py --grupo file --alvo ambos

import "std:file" as fs

proc main() {
    switch d in fs.read_all("nao_existe_m6d.bin", alloc = heap) {
    case [dynamic]u8:
        print(len(d))
        delete(d)
    case fs.FileError:
        print("falhou")
    }
}
