    _ = lt_vaza(10)
    _ = lt_vaza(11)
    _ = lt_vaza(12)
    _ = lt_vaza(13)
    _ = lt_vaza(14)
    _ = lt_vaza(15)
    _ = lt_vaza(16)
    _ = lt_vaza(17)
    _ = lt_vaza(18)
    _ = lt_vaza(19)
    _ = lt_vaza(20)
    print("ok")
}
