// lib_ok.fj - M6d P92a: cria/libera, calloc, realloc, strdup liberados dentro da lib teste_a. Nada vaza.
// Versao: 0.1.0 | Changelog: 0.1.0 - P92a: primeira versao (falha hoje: sem contabilidade por lib).
// Esperado (2 alvos): stdout "ok", 0 linhas R0009, exit 0.
// Verificacao: python tests\nativo\m6d\verificar_m6d.py --grupo lib --alvo ambos

foreign {
    link "teste_a"
    proc lt_cria(n: u64) -> rawptr
    proc lt_libera(p: rawptr)
    proc lt_calloc(n: u64, m: u64) -> rawptr
    proc lt_cresce(p: rawptr, n: u64) -> rawptr
    proc lt_texto(s: cstr) -> rawptr
}

proc main() {
    let a = lt_cria(64)
    let b = lt_calloc(4, 8)
    let c = lt_cresce(a, 128)
    lt_libera(c)
    lt_libera(b)
    let t = lt_texto("forja")
    lt_libera(t)
    print("ok")
}
