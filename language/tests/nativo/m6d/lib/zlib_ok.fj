// zlib_ok.fj - M6d P92a: inflateInit_ seguido de inflateEnd: 0 vivos, nenhuma linha R0009.
// Versao: 0.2.0 | Changelog: 0.2.0 - P92d: usa o ZStreamS do vendor (tamanho certo por alvo; ver zlib_vaza.fj). 0.1.0 - P92a: primeira versao.
// Esperado (2 alvos): stdout "ok", 0 linhas, exit 0.
// Verificacao: python tests\nativo\m6d\verificar_m6d.py --grupo lib --alvo ambos

import "vendor:compression/zlib" as zl

proc main() {
    var fluxo = zl.ZStreamS{}
    _ = zl.inflateInit_(&fluxo, "1.2.13", size_of(zl.ZStreamS) as i32)
    _ = zl.inflateEnd(&fluxo)
    print("ok")
}
