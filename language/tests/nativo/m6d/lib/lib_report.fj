// lib_report.fj - M6d P92d: report_since com "libs" (vivos AGORA por lib estatica): snapshot, lt_cria(100) em teste_a, report_since, lt_libera; sem vazamento.
// Versao: 0.1.0 | Changelog: 0.1.0 - P92d: primeira versao (errata D-M6d-8b: o foreign NAO declara ends; o "global": true e do fim_global, P92e).
// Esperado (2 alvos): stdout "ok"; linha mem_report no stderr com "libs": [{"lib": "teste_a", "blocos": 1, "bytes": 100, "global": false}]; 0 linhas R0009; exit 0.
// Verificacao: python tests\nativo\m6d\verificar_m6d.py --grupo lib --alvo ambos
import "std:mem"

foreign {
    link "teste_a"
    proc lt_cria(n: u64) -> rawptr
    proc lt_libera(p: rawptr)
}

proc main() {
    var s = mem.snapshot()
    let p = lt_cria(100)
    mem.report_since(&s)
    lt_libera(p)
    print("ok")
}
