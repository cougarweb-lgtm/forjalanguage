// lib_thread.fj - M6d P92a: a lib cria thread do SO que faz 20 pares malloc/free e nao deixa sobra. Thread que o runtime nao conhece.
// Versao: 0.1.0 | Changelog: 0.1.0 - P92a: primeira versao (falha hoje: sem contabilidade por lib e sem rt_fio_ou_nulo).
// Esperado (2 alvos, repetir 20 vezes): stdout "ok", 0 linhas R0009, exit 0 (20/20). R0009 falso = PARA.
// Verificacao: python tests\nativo\m6d\verificar_m6d.py --grupo lib --alvo ambos --repetir 20

foreign {
    link "teste_a"
    proc lt_thread_aloca(k: u64, sobra: u64)
}

proc main() {
    lt_thread_aloca(20, 0)
    print("ok")
}
