// lib_duas.fj - M6d P92a: teste_a e teste_b vazam (uma alocacao cada). Dois slots, na ordem dos 'link'.
// Versao: 0.1.0 | Changelog: 0.1.0 - P92a: primeira versao (falha hoje: sem contabilidade por lib).
// Esperado (dev, 2 alvos): stdout "ok"; 2 linhas R0009 "tipo":"lib" (teste_a 100 bytes, teste_b 50 bytes); exit 101.
// Verificacao: python tests\nativo\m6d\verificar_m6d.py --grupo lib --alvo ambos

foreign {
    link "teste_a"
    proc lt_vaza(n: u64) -> rawptr
}

foreign {
    link "teste_b"
    proc lt_b_vaza(n: u64) -> rawptr
}

proc main() {
    _ = lt_vaza(100)
    _ = lt_b_vaza(50)
    print("ok")
}
