// zlib_vaza.fj - M6d P92a: inflateInit_ sem inflateEnd na lib z. O bloco e o calloc(1, sizeof(inflate_state)) do zlib.
// Versao: 0.2.0 | Changelog: 0.2.0 - P92d: usa o ZStreamS do vendor (c_ulong: 88 B no Windows, 112 no Linux); com fluxo[112] fixo o zlib devolvia Z_VERSION_ERROR no Windows e nao alocava.
//                              0.1.0 - P92a: primeira versao.
// Esperado (2 alvos): R0009 lib "z" arquivo_lib "libz.a" bytes == oraculo\esperado_<alvo>.txt (windows 7168, linux 7176); exit 101.
// Verificacao: python tests\nativo\m6d\verificar_m6d.py --grupo lib --alvo ambos

import "vendor:compression/zlib" as zl

proc main() {
    var fluxo = zl.ZStreamS{}
    _ = zl.inflateInit_(&fluxo, "1.2.13", size_of(zl.ZStreamS) as i32)
    print("ok")
}
