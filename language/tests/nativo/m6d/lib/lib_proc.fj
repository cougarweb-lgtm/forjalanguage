// lib_proc.fj - M6d P92a: vaza dentro de um proc abre(): a pilha do grupo tem [abre, main].
// Versao: 0.1.0 | Changelog: 0.1.0 - P92a: primeira versao (falha hoje: sem contabilidade por lib).
// Esperado (dev, 2 alvos): stdout "ok"; R0009 lib teste_a com pilha [abre, main]; exit 101.
// Verificacao: python tests\nativo\m6d\verificar_m6d.py --grupo lib --alvo ambos

foreign {
    link "teste_a"
    proc lt_vaza(n: u64) -> rawptr
}

proc abre() {
    _ = lt_vaza(16)
}

proc main() {
    abre()
    print("ok")
}
