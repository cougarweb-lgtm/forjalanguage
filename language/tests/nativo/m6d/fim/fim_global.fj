// fim_global.fj - M6d P92a: lt_global_init sem lt_global_fim, e a lib DECLARA ends. Sobra "global": nenhuma linha, exit 0.
// Versao: 0.2.0 | Changelog: 0.2.0 - P92e: snapshot + report_since para conferir "global": true no mem_report.
//                            0.1.0 - P92a: primeira versao (falha hoje: clausula ends ainda nao existe, P92b).
// Esperado (2 alvos): stdout "ok", 0 linhas R0009, exit 0; report_since com "libs": [{"lib": "teste_a", "blocos": 1, "bytes": 64, "global": true}].
// Verificacao: python tests\nativo\m6d\verificar_m6d.py --grupo fim --alvo ambos
import "std:mem"

foreign {
    link "teste_a"
    proc lt_global_init()
    proc lt_global_fim() ends
}

proc main() {
    var s = mem.snapshot()
    lt_global_init()
    mem.report_since(&s)
    print("ok")
}
