// fim_reabre.fj - M6d P92a: fim e depois init de novo sem fim: a lib volta a "global" (sobra sem linha), exit 0.
// Versao: 0.1.0 | Changelog: 0.1.0 - P92a: primeira versao (falha hoje: clausula ends ainda nao existe, P92b).
// Esperado (2 alvos): stdout "ok", 0 linhas, exit 0.
// Verificacao: python tests\nativo\m6d\verificar_m6d.py --grupo fim --alvo ambos

foreign {
    link "teste_a"
    proc lt_global_init()
    proc lt_global_fim() ends
}

proc main() {
    lt_global_init()
    lt_global_fim()
    lt_global_init()
    print("ok")
}
