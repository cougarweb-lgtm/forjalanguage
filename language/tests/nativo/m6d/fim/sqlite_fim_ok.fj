// sqlite_fim_ok.fj - M6d P92a: open + close + shutdown do sqlite3: 0 vivos, nenhuma linha R0009, exit 0 (aceite sem bytes: R-M6d-7).
// Versao: 0.1.0 | Changelog: 0.1.0 - P92a: primeira versao (falha hoje: clausula ends ainda nao existe, P92b).
// Esperado (2 alvos): stdout "ok", 0 linhas, exit 0.
// Verificacao: python tests\nativo\m6d\verificar_m6d.py --grupo fim --alvo ambos

foreign {
    link "sqlite3"
    proc sqlite3_open(nome: cstr, db: ^rawptr) -> i32
    proc sqlite3_close(db: rawptr) -> i32
    proc sqlite3_shutdown() -> i32 ends
}

proc main() {
    var h: [1]rawptr = {}
    _ = sqlite3_open(":memory:", &h[0])
    _ = sqlite3_close(h[0])
    _ = sqlite3_shutdown()
    print("ok")
}
