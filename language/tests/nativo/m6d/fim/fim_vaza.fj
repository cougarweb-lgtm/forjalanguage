// fim_vaza.fj - M6d P92a: init + lt_vaza + fim: o fim nao solta o vazamento. R0009 lib teste_a, exit 101.
// Versao: 0.2.0 | Changelog: 0.2.0 - P92e: lt_vaza ANTES do fim (alocar depois do fim reabre a lib, D-M6d-7: e indistinguivel de lt_global_init no runtime; ver fim_reabre).
//                            0.1.0 - P92a: primeira versao (falha hoje: clausula ends ainda nao existe, P92b).
// Esperado (2 alvos): stdout "ok", R0009 "tipo":"lib" "lib":"teste_a" bytes 100, exit 101.
// Verificacao: python tests\nativo\m6d\verificar_m6d.py --grupo fim --alvo ambos

foreign {
    link "teste_a"
    proc lt_global_init()
    proc lt_global_fim() ends
    proc lt_vaza(n: u64) -> rawptr
}

proc main() {
    lt_global_init()
    _ = lt_vaza(100)
    lt_global_fim()
    print("ok")
}
