// tls_main.fj - M5c-b P61: so a principal (sem std:thread). O musl inicializa o bloco TLS do main a partir do PT_TLS (AT_PHDR): os valores iniciais
// (0, 1000, 0, 2000, 0) tem de estar la e a principal grava e le o proprio. Saida: "main inicio ok" e "main set ok". Versao: 0.1.0 - M5c-b P61: primeira versao.
foreign {
    link "tls"
    proc tlst_ler(k: i32) -> i32
    proc tlst_gravar(k: i32, v: i32)
}

proc main() {
    if tlst_ler(0) == 0 and tlst_ler(1) == 1000 and tlst_ler(2) == 0 and tlst_ler(3) == 2000 and tlst_ler(4) == 0 {
        print("main inicio ok")
    } else {
        print("main inicio ERRO")
    }
    tlst_gravar(0, 42)
    tlst_gravar(1, 43)
    tlst_gravar(2, 44)
    tlst_gravar(3, 45)
    tlst_gravar(4, 46)
    if tlst_ler(0) == 42 and tlst_ler(1) == 43 and tlst_ler(2) == 44 and tlst_ler(3) == 45 and tlst_ler(4) == 46 {
        print("main set ok")
    } else {
        print("main set ERRO")
    }
}
