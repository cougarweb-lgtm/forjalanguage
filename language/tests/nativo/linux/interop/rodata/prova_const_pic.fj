// prova_const_pic.fj - M5b P37d: a mesma prova com libconst_pic.a (-fPIC: tabelas de ponteiros em .data.rel.ro e acessos pelo GOT, GOTPCRELX).

foreign {
    link "const_pic"
    proc cst_tabela_de(i: i32) -> i32
    proc cst_real(x: f64) -> f64
    proc cst_float(x: f32) -> f64
    proc cst_neg(x: f64) -> f64
    proc cst_switch(k: i32) -> i32
    proc cst_nome_len(i: i32) -> i32
    proc cst_texto_len() -> i32
    proc cst_global(d: i32) -> i32
    proc cst_bss(i: i32, v: i32) -> i32
}

proc main() {
    print(cst_tabela_de(3))
    print(cst_tabela_de(7))
    print(cst_tabela_de(9))
    print(cst_real(2.0) as i32)
    print(cst_float(3.0) as i32)
    print(cst_neg(4.0) as i32)
    print(cst_switch(0))
    print(cst_switch(3))
    print(cst_switch(7))
    print(cst_switch(9))
    print(cst_nome_len(2))
    print(cst_texto_len())
    print(cst_global(3))
    print(cst_global(2))
    print(cst_bss(4, 77))
}
