// prova_ms.fj - M5b P36/P37: libms.a (ELF, convencao SysV padrao do gcc) ligada pelo ligador ELF e chamada pela ABI SysV no alvo x86_64-linux (sem escotilha).
// O construtor (.init_array) nao e executado no P36 (quem roda e o musl, P39): o esperado nao depende dele.

foreign {
    link "ms"
    proc ms_soma(a: i32, b: i32) -> i32
    proc ms_troca_global(v: i32) -> i32
}

proc main() {
    print(ms_soma(2, 3))
    print(ms_troca_global(9))
    print(ms_troca_global(1))
}
