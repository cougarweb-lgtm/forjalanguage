// prova_ms_pic.fj - M5b P36: a mesma prova com libms_pic.a (-fPIC: acessos a ms_global pelo GOT, GOTPCRELX). Roda com FORJA_TESTE_FOREIGN_MS_LINUX=1 (escotilha, P37 apaga).

foreign {
    link "ms_pic"
    proc ms_soma(a: i32, b: i32) -> i32
    proc ms_troca_global(v: i32) -> i32
}

proc main() {
    print(ms_soma(2, 3))
    print(ms_troca_global(9))
    print(ms_troca_global(1))
}
