// negativo_membro_elf.fj - M5b P36: libms.a e um arquivo ELF (feito para o alvo Linux). No alvo Windows a lib nao e achada como import library e a Forja recusa com X0102 ("biblioteca do 'link' nao encontrada").
// O X0105 previsto no P36 nao sai: o ELF nao passa na busca de bibliotecas do Windows. Fora por desenho (divergencias_aceitas.json, P37c); o alvo Linux compila e roda este programa.
// Verificacao: forja build negativo_membro_elf.fj -o %TEMP%\negativo.exe  (exit 1, X0102); nao e um exe Windows.
// Versao: 0.1.1 - M5b P37c: cabecalho corrigido para o X0102 observado (o X0105 previsto no 0.1.0 nao sai).

foreign {
    link "ms"
    proc ms_soma(a: i32, b: i32) -> i32
}

proc main() {
    print(ms_soma(2, 3))
}
