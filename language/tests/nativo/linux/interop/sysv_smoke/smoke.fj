// smoke.fj - M5b P37: ABI SysV no call site do foreign (libsmoke.a, smoke.c). Saida esperada em smoke.esperado.

struct PAB {
    a: i32 = 0
    b: f64 = 0.0
}

struct P12 {
    a: i32 = 0
    b: i32 = 0
    c: i32 = 0
}

struct P24 {
    x: f64 = 0.0
    y: f64 = 0.0
    z: f64 = 0.0
}

foreign {
    link "smoke"
    proc sv_mistura(p: PAB) -> PAB
    proc sv_f(a: f32, b: f64, c: i32) -> f64
    proc sv_grande(p: P24) -> P24
    proc sv_soma12(p: P12) -> i32
    proc sv_dobra12(p: P12) -> P12
}

proc main() {
    let r = sv_mistura(PAB{a = 4, b = 1.5})
    print(r.a)
    print(r.b as i32)
    let x: f64 = 2.0
    print(sv_f(1.5, x, 3) as i32)
    let g = sv_grande(P24{x = 1.0, y = 1.0, z = 1.0})
    print((g.x + g.y + g.z) as i32)
    print(sv_soma12(P12{a = 1, b = 2, c = 3}))
    let d = sv_dobra12(P12{a = 1, b = 2, c = 3})
    print(d.a + d.b + d.c)
}
