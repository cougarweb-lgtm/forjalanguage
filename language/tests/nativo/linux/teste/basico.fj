// basico.fj - M5 P29b: o executor de testes do alvo Linux com expect. Um expect que passa; um que falha (o teste segue e conta como falho); dois que falham no mesmo teste
// (o texto relata os dois, o --json guarda so o 1o); um teste que passa depois da falha. Saida igual a do forja test no Windows (texto e --json).
// Linhas-chave: stdout "ok   passa" "FALHOU expect falha" "FALHOU dois falham" "ok   passa de novo" "4 testes, 2 falharam"; stderr 3 linhas "  expect falhou: ..."; exit 1.

proc main() {
    print(0)
}

test "passa" {
    expect(1 + 1 == 2)
}

test "expect falha" {
    expect(1 + 1 == 3)
}

test "dois falham" {
    expect(2 == 3)
    expect(4 == 5)
}

test "passa de novo" {
    expect(3 == 3)
}
