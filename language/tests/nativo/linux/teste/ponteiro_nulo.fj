// ponteiro_nulo.fj - M5 P29b: a escrita por um ponteiro nulo que escapou do R0005 (o 'as ^^i32' sobre o endereco de um u64 zerado entrega um ^i32 nulo sem checar) derruba o
// processador (SIGSEGV no Linux) e o executor responde R0011 com o titulo, marca o teste como falho e roda o seguinte. Igual ao Windows (acesso a memoria invalida).
// Linhas-chave: stdout "ok   antes" "FALHOU escreve em nulo" "ok   depois" "3 testes, 1 falharam"; stderr R0011; exit 1.

proc escrever_no_nulo() {
    var bits: u64 = 0
    let pp = (&bits as rawptr) as ^^i32
    let p = pp^
    p^ = 7
}

proc main() {
    print(0)
}

test "antes" {
    expect(1 == 1)
}

test "escreve em nulo" {
    escrever_no_nulo()
    expect(2 == 2)
}

test "depois" {
    expect(3 == 3)
}
