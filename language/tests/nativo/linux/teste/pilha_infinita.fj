// pilha_infinita.fj - M5 P29b: recursao infinita dentro de um teste = estouro da pilha principal. No Linux o SIGSEGV chega ao tratador PELA PILHA ALTERNATIVA (sigaltstack, 64 KiB:
// sem ela o tratador nao teria onde rodar) e o teste vira R0011 como qualquer queda; os testes de antes e de depois rodam. DIFERENCA DE SO (so_linux): no Windows o estouro e
// EXCEPTION_STACK_OVERFLOW, que o tratador nao reconhece (so acesso e instrucao ilegal): o processo cai. O esperado do Linux e o desta fixture, nao o do Windows.
// A 2a recursao infinita prova que o tratador e a pilha alternativa seguem armados depois da 1a queda.
// Linhas-chave: stdout "ok   antes" "FALHOU pilha sem fundo" "ok   depois" "FALHOU pilha sem fundo de novo" "ok   fim" "5 testes, 2 falharam"; stderr 2 linhas R0011 "acesso a memoria invalida"; exit 1.

proc afundar(n: i64) -> i64 {
    return afundar(n + 1) + 1
}

proc main() {
    print(0)
}

test "antes" {
    expect(1 == 1)
}

test "pilha sem fundo" {
    expect(afundar(0) == 1)
}

test "depois" {
    expect(2 == 2)
}

test "pilha sem fundo de novo" {
    expect(afundar(5) == 1)
}

test "fim" {
    expect(3 == 3)
}
