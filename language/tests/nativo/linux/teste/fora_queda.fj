// fora_queda.fj - M5 P29b: FORA do executor de testes nao ha tratador (D-M5-5): o programa normal (forja build, nao forja test) que le por ponteiro nulo cai com o sinal 11 do
// kernel, como o mesmo programa em C do oraculo (musl). Sem print antes da queda: o stdout do runtime nativo fica no buffer e se perde na queda (o do C-musl sai por linha), diferenca de buffer e nao de sinal.
// Linhas-chave: stdout vazio; sinal 11 (exit 139 no shell, que ainda escreve "Segmentation fault" no stderr).

proc ler_do_nulo() -> i32 {
    var bits: u64 = 0
    let pp = (&bits as rawptr) as ^^i32
    let p = pp^
    return p^
}

proc main() {
    print(ler_do_nulo())
}
