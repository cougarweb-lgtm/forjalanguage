// duas_quedas.fj - M5 P29b: duas quedas SEGUIDAS no mesmo executor (leitura e escrita por ponteiro nulo): cada uma vira R0011 do proprio teste, o sinal e desbloqueado antes do
// salto (sem isso a 2a queda mataria o processo) e os testes vizinhos rodam. Com o filtro "queda" so os dois que caem rodam (2 filtrados). Igual ao Windows.
// Linhas-chave: stdout "ok   antes" "FALHOU queda de leitura" "FALHOU queda de escrita" "ok   depois" "4 testes, 2 falharam"; stderr 2 linhas R0011; exit 1.

proc ler_do_nulo() -> i32 {
    var bits: u64 = 0
    let pp = (&bits as rawptr) as ^^i32
    let p = pp^
    return p^
}

proc escrever_no_nulo() {
    var bits: u64 = 0
    let pp = (&bits as rawptr) as ^^i32
    let p = pp^
    p^ = 9
}

proc main() {
    print(0)
}

test "antes" {
    expect(1 == 1)
}

test "queda de leitura" {
    expect(ler_do_nulo() == 1)
}

test "queda de escrita" {
    escrever_no_nulo()
}

test "depois" {
    expect(2 == 2)
}
