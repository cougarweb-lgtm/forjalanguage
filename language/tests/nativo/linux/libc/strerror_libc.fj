// strerror_libc.fj - 0.44.0: std:os.error_text no Linux (tabela embutida, errno 1..131) contra strerror do musl (libc.a) para n = 1..133.
// strerror fora da tabela devolve "No error information", que a Forja conta como "" (vazio). Saida esperada: vazia (sem divergencia).
// Imprime a 1a divergencia (n, texto da Forja, texto do musl) e sai 1. Versao: 0.1.0 - primeira versao (prova do error_text do runtime Linux).

import "std:os"

foreign {
    link "c"
    proc c_strerror = "strerror"(n: i32) -> cstr
}

proc main() {
    for n in 1..=133 {
        let forja = os.error_text(n, alloc = heap)
        let musl = c_strerror(n as i32) as str
        var esperado = musl
        if musl == "No error information" {
            esperado = ""
        }
        if not (forja == esperado) {
            print("divergencia")
            print(n)
            print(forja)
            print(esperado)
            delete(forja)
            os.exit(1)
        }
        delete(forja)
    }
}
