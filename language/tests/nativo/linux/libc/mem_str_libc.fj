// mem_str_libc.fj - M5b P39-B2 (D0654 itens 6 e 7): strlen, malloc/free, strtod e getenv da libc (musl) sob um programa Forja com foreign no alvo linux.
// Saida em mem_str_libc.esperado; exit 0. Versao: 0.2.0 - M5b P39-B2: strtod com ?^u8 (nulo = none); saida como inteiro (print nao aceita real).

foreign {
    link "c"
    proc c_strlen = "strlen"(s: cstr) -> u64
    proc c_malloc = "malloc"(n: u64) -> rawptr
    proc c_free = "free"(p: rawptr)
    proc c_strtod = "strtod"(s: cstr, fim: ?^u8) -> f64
    proc c_getenv = "getenv"(nome: cstr) -> ?cstr
}

proc main() {
    print(c_strlen("ola"))
    let p = c_malloc(16)
    c_free(p)
    let d = c_strtod("2.5", none)
    print((d * 2.0) as int)
    if c_getenv("FORJA_NAO_EXISTE_P39B2") == none {
        print("ausente")
    }
}
