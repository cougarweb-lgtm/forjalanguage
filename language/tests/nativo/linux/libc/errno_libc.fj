// errno_libc.fj - M5b P39-B3 (c): errno do musl lido por __errno_location (foreign). fopen de arquivo inexistente da ENOENT (2);
// strtol com estouro da ERANGE (34) e devolve i64 max. Saida em errno_libc.esperado. Versao: 0.1.0 - M5b P39-B3: primeira versao.

foreign {
    link "c"
    proc c_errno_loc = "__errno_location"() -> ^i32
    proc c_fopen = "fopen"(caminho: cstr, modo: cstr) -> ?^u8
    proc c_strtol = "strtol"(s: cstr, fim: ?^u8, base: i32) -> i64
}

proc main() {
    let f = c_fopen("nao_existe_p39b3.txt", "r")
    let e1 = c_errno_loc()
    if f == none {
        print(e1^)
    }
    e1^ = 0
    let v = c_strtol("99999999999999999999999", none, 10)
    let e2 = c_errno_loc()
    print(e2^)
    print(v == 9223372036854775807)
}
