// qsort_callback_libc.fj - M5b P39-B3 (b): qsort do musl chama o comparador Forja (proc passado como ponteiro fjt_ SysV, D0652).
// Ordena decrescente para provar que o comparador da Forja e quem manda. Saida em qsort_callback_libc.esperado.
// Versao: 0.1.0 - M5b P39-B3: primeira versao.

foreign {
    link "c"
    proc c_qsort = "qsort"(base: rawptr, n: u64, tamanho: u64, comparar: proc(a: rawptr, b: rawptr) -> i32)
}

proc decrescente(a: rawptr, b: rawptr) -> i32 {
    let x = a as ^i32
    let y = b as ^i32
    if x^ > y^ {
        return -1
    }
    if x^ < y^ {
        return 1
    }
    return 0
}

proc main() {
    var v: [5]i32 = {3, 9, 1, 7, 5}
    c_qsort(&v[0] as rawptr, n = 5, tamanho = 4, comparar = decrescente)
    print(v[0])
    print(v[1])
    print(v[2])
    print(v[3])
    print(v[4])
}
