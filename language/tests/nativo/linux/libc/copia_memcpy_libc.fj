// copia_memcpy_libc.fj - M5b P39-B3 (a): copia de struct acima de BIR_COPIA_MEM_MAX (64 B) chama forja_memcpy (runtime Forja, no ELF);
// memcpy e strlen do musl entram por foreign. O verificar_libc confere por readelf/nm no ELF: 1 memcpy (musl) e 1 forja_memcpy.
// Saida em copia_memcpy_libc.esperado. Versao: 0.1.0 - M5b P39-B3: primeira versao.

foreign {
    link "c"
    proc c_strlen = "strlen"(s: cstr) -> u64
    proc c_memcpy = "memcpy"(destino: rawptr, origem: rawptr, n: u64) -> rawptr
}

struct Grande {
    a: i64 = 1
    v: [16]i64 = {}
}

proc main() {
    let g = Grande{a = 7}
    var b = g
    b.v[15] = 9
    print(b.a + b.v[15])
    print(c_strlen("ola"))
    var dst: Grande = Grande{}
    _ = c_memcpy(&dst as rawptr, &b as rawptr, 136)
    print(dst.a * 10 + dst.v[15])
}
