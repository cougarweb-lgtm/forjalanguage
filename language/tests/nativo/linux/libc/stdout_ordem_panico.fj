// stdout_ordem_panico.fj - M5b P39-B2 (D0654 item 5): print da Forja e putchar do C saem na ordem no mesmo FILE stdout do musl; o panic
// descarrega o stdout e sai com 101 (R0003 no stderr). Saida em stdout_ordem_panico.esperado; codigo 101.
// Versao: 0.1.0 - M5b P39-B2: primeira versao.

foreign {
    link "c"
    proc c_putchar = "putchar"(c: i32) -> i32
}

proc main() {
    print("A")
    _ = c_putchar(66)
    print("C")
    panic("fim do programa")
}
