// panico_cb.fj - M5b P38b: panic DENTRO de um callback SysV. O C (cbm_chama_panico) chama o stub fjt_; o proc da Forja da assert falso: sai com o
// codigo de execucao 101 e o R0003 no stderr, sem SIGSEGV (o stub nao e BirFuncao). Saida e codigo em panico_cb.esperado / panico_cb.codigo.
// Versao: 0.1.0 - M5b P38b: primeira versao.

foreign {
    link "cb_misto"
    proc cbm_chama_panico(cb: proc(n: i64) -> i64) -> i64
}

proc cai(n: i64) -> i64 {
    print(n)
    assert(n > 10, msg = "dentro do callback")
    return n
}

proc main() {
    print(cbm_chama_panico(cai))
}
