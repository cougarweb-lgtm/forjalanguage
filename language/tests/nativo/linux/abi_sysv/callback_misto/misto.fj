// misto.fj - M5b P38b: valor de proc no alvo linux. O mesmo ponteiro (o stub SysV fjt_) e chamado pela PROPRIA Forja (CHAMA_IND, SysV) e pelo C (cbm_chama*), com 3 e com 8
// argumentos (os 2 ultimos de 8 na pilha); o C devolve o ponteiro e a Forja o chama; um ponteiro de funcao C genuino (cbm_fn_c) tambem e chamado por valor de proc.
// Saida em misto.esperado. Versao: 0.1.0 - M5b P38b: primeira versao.

foreign {
    link "cb_misto"
    proc cbm_chama(cb: proc(a: i32, b: f64, c: i64) -> f64, a: i32, b: f64, c: i64) -> f64
    proc cbm_chama8(cb: proc(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64, h: i64) -> i64) -> i64
    proc cbm_devolve(cb: proc(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64, h: i64) -> i64) -> proc(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64, h: i64) -> i64
    proc cbm_fn_c() -> proc(a: i64, b: i64) -> i64
}

proc media(a: i32, b: f64, c: i64) -> f64 {
    return (a as f64) + b + (c as f64)
}

proc ponderada(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64, h: i64) -> i64 {
    return a + 2 * b + 3 * c + 4 * d + 5 * e + 6 * f + 7 * g + 8 * h
}

proc main() {
    let p: proc(a: i32, b: f64, c: i64) -> f64 = media
    let q: proc(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64, h: i64) -> i64 = ponderada
    print((p(1, b = 2.5, c = 3) * 4.0) as i64)
    print((cbm_chama(p, a = 4, b = 0.5, c = 6) * 4.0) as i64)
    print(q(1, b = 1, c = 1, d = 1, e = 1, f = 1, g = 1, h = 1))
    print(cbm_chama8(q))
    let r = cbm_devolve(q)
    print(r(8, b = 7, c = 6, d = 5, e = 4, f = 3, g = 2, h = 1))
    let s = cbm_fn_c()
    print(s(7, b = 8))
}
