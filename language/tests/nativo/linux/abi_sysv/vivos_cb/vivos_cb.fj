// vivos_cb.fj - M5b P38-0: valores vivos atravessando um callback SysV. vvc_chama_cb (lib vivos_cb, vivos_cb.c) chama cbv com a ABI
// SysV e confere rbx/rbp/r12-r15 na volta; cbv chama de volta vvc_alinhamento (foreign SysV, reentrancia SysV -> Forja -> SysV).
// cbv usa 12 inteiros e 12 reais locais, vivos depois da chamada de volta. Saida: vivos_cb.esperado (oraculo C: oraculo_vivos_cb.c).
// Versao: 0.1.0 - M5b P38-0: primeira versao.

foreign {
    link "vivos_cb"
    proc vvc_alinhamento() -> i64
    proc vvc_chama_cb(cb: proc(a: i64, b: i64) -> i64, a: i64, b: i64, mism: ^i64) -> i64
}

proc cbv(a: i64, b: i64) -> i64 {
    let x1: i64 = a + 1
    let x2: i64 = a + 2
    let x3: i64 = a + 3
    let x4: i64 = a + 4
    let x5: i64 = a + 5
    let x6: i64 = a + 6
    let x7: i64 = a + 7
    let x8: i64 = a + 8
    let x9: i64 = a + 9
    let x10: i64 = a + 10
    let x11: i64 = a + 11
    let x12: i64 = a + 12
    let f1: f64 = 0.25
    let f2: f64 = 0.5
    let f3: f64 = 0.75
    let f4: f64 = 1.0
    let f5: f64 = 1.25
    let f6: f64 = 1.5
    let f7: f64 = 1.75
    let f8: f64 = 2.0
    let f9: f64 = 2.25
    let f10: f64 = 2.5
    let f11: f64 = 2.75
    let f12: f64 = 3.0
    let al = vvc_alinhamento()
    print(al)
    print(x1 + x2 + x3 + x4 + x5 + x6 + x7 + x8 + x9 + x10 + x11 + x12 + b)
    print(((f1 + f2 + f3 + f4 + f5 + f6 + f7 + f8 + f9 + f10 + f11 + f12) * 4.0) as i64)
    return x1 + x2 + x3 + x4 + x5 + x6 + x7 + x8 + x9 + x10 + x11 + x12 + b + al
}

proc main() {
    var mism: i64 = 0
    let i1: i64 = 1
    let i2: i64 = 2
    let i3: i64 = 3
    let i4: i64 = 4
    let i5: i64 = 5
    let i6: i64 = 6
    let i7: i64 = 7
    let i8: i64 = 8
    let i9: i64 = 9
    let i10: i64 = 10
    let i11: i64 = 11
    let i12: i64 = 12
    let f1: f64 = 0.25
    let f2: f64 = 0.5
    let f3: f64 = 0.75
    let f4: f64 = 1.0
    let f5: f64 = 1.25
    let f6: f64 = 1.5
    let f7: f64 = 1.75
    let f8: f64 = 2.0
    let f9: f64 = 2.25
    let f10: f64 = 2.5
    let f11: f64 = 2.75
    let f12: f64 = 3.0
    let r = vvc_chama_cb(cbv, a = 3, b = 4, mism = &mism)
    print(mism)
    print(r)
    print(i1 + i2 + i3 + i4 + i5 + i6 + i7 + i8 + i9 + i10 + i11 + i12)
    print(((f1 + f2 + f3 + f4 + f5 + f6 + f7 + f8 + f9 + f10 + f11 + f12) * 4.0) as i64)
}
