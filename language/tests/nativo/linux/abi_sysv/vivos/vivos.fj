// vivos.fj - M5b P37c: valores vivos atravessando 3 chamadas SysV seguidas. A lib vivos/vendor/linux/libvivos.a (vivos.c) destroi rsi, rdi
// e xmm6-xmm15 em cada chamada; os 12 inteiros e os 12 reais de main() seguem vivos depois das 3 chamadas e entram nas somas.
// Saida: vivos.esperado (conta feita a mao: f_k = k * 0.25; soma dos f = 19.5; g1 = 0.75; r1 = 3; r2 = 7).
// Versao: 0.1.0 - M5b P37c: primeira versao.

foreign {
    link "vivos"
    proc vv_clob_i(a: i64, b: i64) -> i64
    proc vv_clob_f(a: f64, b: f64) -> f64
}

proc main() {
    let i1: i64 = 1
    let i2: i64 = 2
    let i3: i64 = 3
    let i4: i64 = 4
    let i5: i64 = 5
    let i6: i64 = 6
    let i7: i64 = 7
    let i8: i64 = 8
    let i9: i64 = 9
    let i10: i64 = 10
    let i11: i64 = 11
    let i12: i64 = 12
    let f1: f64 = 0.25
    let f2: f64 = 0.5
    let f3: f64 = 0.75
    let f4: f64 = 1.0
    let f5: f64 = 1.25
    let f6: f64 = 1.5
    let f7: f64 = 1.75
    let f8: f64 = 2.0
    let f9: f64 = 2.25
    let f10: f64 = 2.5
    let f11: f64 = 2.75
    let f12: f64 = 3.0
    let r1 = vv_clob_i(i1, i2)
    let g1 = vv_clob_f(f1, f2)
    let r2 = vv_clob_i(i3, i4)
    print(i1 + i2 + i3 + i4 + i5 + i6 + i7 + i8 + i9 + i10 + i11 + i12)
    print(r1 + r2)
    print(((f1 + f2 + f3 + f4 + f5 + f6 + f7 + f8 + f9 + f10 + f11 + f12) * 4.0) as i64)
    print((g1 * 4.0) as i64)
    print(i1 + i2 + i3 + i4 + i5 + i6 + i7 + i8 + i9 + i10 + i11 + i12 + r1 + r2)
    print((((f1 + f2 + f3 + f4 + f5 + f6 + f7 + f8 + f9 + f10 + f11 + f12) + g1) * 4.0) as i64)
}
