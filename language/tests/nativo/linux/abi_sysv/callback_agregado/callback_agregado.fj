// callback_agregado.fj - M5b P38c: callback SysV com agregado por valor no alvo linux. A Forja passa procs com struct de 24 B (MEMORY nos dois sentidos),
// 12 B (SSE+SSE), 16 B (SSE+INTEGER) e 8 B (INTEGER); o C chama cada um e recebe o retorno, que mexe. cba_reentra chama um proc que chama o C de novo
// com agregado (reentrancia). Saida em callback_agregado.esperado (conferida pelo oraculo_agregado.c). Versao: 0.1.0 - M5b P38c: primeira versao.

struct S24 {
    a: i64
    b: f64
    c: i64
}

struct S12 {
    x: f32
    y: f32
    z: f32
}

struct S16 {
    d: f64
    l: i64
}

struct S8 {
    i: i32
    f: f32
}

foreign {
    link "cb_agregado"
    proc cba_chama24(cb: proc(s: S24, k: i64) -> S24, s: S24, k: i64) -> S24
    proc cba_chama12(cb: proc(s: S12) -> S12, s: S12) -> S12
    proc cba_chama16(cb: proc(s: S16, k: i64) -> S16, s: S16, k: i64) -> S16
    proc cba_chama8(cb: proc(s: S8, t: i64) -> S8, s: S8, t: i64) -> S8
    proc cba_reentra(cb: proc(n: i64) -> i64, n: i64) -> i64
}

proc cb24(s: S24, k: i64) -> S24 {
    return S24{a = s.a + k, b = s.b * 2.0, c = s.c - k}
}

proc cb12(v: S12) -> S12 {
    return S12{x = v.x + 1.0, y = v.y * 2.0, z = v.z - 0.5}
}

proc cb16(s: S16, k: i64) -> S16 {
    return S16{d = s.d + 0.25, l = s.l * k}
}

proc cb8(s: S8, t: i64) -> S8 {
    return S8{i = s.i + (t as i32), f = s.f * 3.0}
}

proc cb_nivel(n: i64) -> i64 {
    let r = cba_chama24(cb24, S24{a = n, b = 1.5, c = 2}, n)
    return r.a
}

proc main() {
    let r24 = cba_chama24(cb24, S24{a = 1, b = 2.5, c = 3}, 4)
    print(r24.a)
    print((r24.b * 10.0) as i64)
    print(r24.c)
    let r12 = cba_chama12(cb12, S12{x = 1.5, y = 2.0, z = 4.0})
    print((r12.x * 10.0) as i64)
    print((r12.y * 10.0) as i64)
    print((r12.z * 10.0) as i64)
    let r16 = cba_chama16(cb16, S16{d = 1.5, l = 7}, 3)
    print((r16.d * 100.0) as i64)
    print(r16.l)
    let r8 = cba_chama8(cb8, S8{i = 10, f = 1.5}, 5)
    print(r8.i as i64)
    print((r8.f * 10.0) as i64)
    print(cba_reentra(cb_nivel, 6))
}
