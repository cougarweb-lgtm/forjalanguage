// std:process no Linux (M5 P28b-2) - erros tipados do spawn: sem "/" procura no PATH (not_found); com "/" tenta direto (not_found); pasta como programa (EACCES = permission_denied);
// cwd que nao existe (chdir do filho falha = io, como o ERROR_DIRECTORY do Windows); entradas recusadas antes do fork (invalid_input).
// Equivalente Windows: std\process\testes.fj "programa que nao existe e not_found" e "entrada invalida e recusada".
import "std:process" as pr

proc erro_texto(e: pr.ProcessError) -> str {
    var t: str = "io"
    switch e {
    case pr.ProcessError.not_found:
        t = "not_found"
    case pr.ProcessError.permission_denied:
        t = "permission_denied"
    case pr.ProcessError.invalid_input:
        t = "invalid_input"
    case pr.ProcessError.timeout:
        t = "timeout"
    case pr.ProcessError.io:
        t = "io"
    }
    return t
}

// Roda o comando e imprime o rotulo e o erro tipado (ou "ok" com o codigo).
proc tentar(rotulo: str, cmd: pr.Command) {
    switch r in pr.run(cmd, alloc = heap) {
    case pr.Output:
        print(f"{rotulo} ok code={r.code}")
        delete(r.stdout)
        delete(r.stderr)
    case pr.ProcessError:
        print(f"{rotulo} {erro_texto(r)}")
    }
}

proc main() {
    tentar("sem barra", pr.Command{program = "forja_programa_que_nao_existe_p28b2", args = {}, env = {}, cwd = "", timeout_ms = 0})
    tentar("com barra", pr.Command{program = "/nao/existe/programa", args = {}, env = {}, cwd = "", timeout_ms = 0})
    tentar("pasta", pr.Command{program = "/tmp", args = {}, env = {}, cwd = "", timeout_ms = 0})
    tentar("cwd ruim", pr.Command{program = "/bin/sh", args = {}, env = {}, cwd = "/nao/existe", timeout_ms = 0})
    tentar("vazio", pr.Command{program = "", args = {}, env = {}, cwd = "", timeout_ms = 0})
    tentar("bat", pr.Command{program = "x.bat", args = {}, env = {}, cwd = "", timeout_ms = 0})
    var sem_igual: [1]str = {"SEM_IGUAL"}
    tentar("env sem igual", pr.Command{program = "/bin/sh", args = {}, env = sem_igual[..], cwd = "", timeout_ms = 0})
}
