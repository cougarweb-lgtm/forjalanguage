// std:process no Linux (M5 P28b-2) - env que SUBSTITUI o ambiente do pai (so FJ_X e FJ_Y chegam; HOME some; o valor guarda o '='), env vazio que herda (FJ_HER vem de env_cwd.env) e cwd = /tmp.
// Equivalente Windows: std\process\testes.fj "env substitui o ambiente e cwd muda a pasta".
import "std:process" as pr

// Roda /bin/sh -c <script> e imprime o rotulo e o stdout (ou "erro").
proc rodar(rotulo: str, script: str, env: []str, cwd: str) {
    var args: [2]str = {"-c", script}
    let cmd = pr.Command{program = "/bin/sh", args = args[..], env = env, cwd = cwd, timeout_ms = 0}
    switch r in pr.run(cmd, alloc = heap) {
    case pr.Output:
        let saida = from_bytes(r.stdout[..], alloc = heap)
        print(f"{rotulo} code={r.code} <{saida}>")
        delete(saida)
        delete(r.stdout)
        delete(r.stderr)
    case pr.ProcessError:
        print(f"{rotulo} erro")
    }
}

proc main() {
    var env: [2]str = {"FJ_X=valor", "FJ_Y=a=b"}
    rodar("substitui", "echo $FJ_X $FJ_Y ${HOME-semhome} ${FJ_HER-semher}", env[..], "")
    rodar("herda", "echo ${FJ_HER-semher}", {}, "")
    rodar("cwd", "pwd", {}, "/tmp")
}
