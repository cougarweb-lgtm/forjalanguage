// std:process no Linux (M5 P28b-2) - timeout_ms mata o filho (e o grupo dele) com SIGKILL, devolve o que ja saiu e marca timed_out; o codigo e 128 + 9 (o Windows da 1).
// Equivalente Windows: std\process\testes.fj "timeout mata o filho e a arvore e marca timed_out".
import "std:os" as sys
import "std:process" as pr

proc main() {
    var args: [2]str = {"-c", "echo antes; sleep 30; echo depois"}
    let inicio = sys.time_ns()
    let cmd = pr.Command{program = "/bin/sh", args = args[..], env = {}, cwd = "", timeout_ms = 300}
    switch r in pr.run(cmd, alloc = heap) {
    case pr.Output:
        let saida = from_bytes(r.stdout[..], alloc = heap)
        let saida_ok = saida == "antes\n"
        let rapido = (sys.time_ns() - inicio) / 1000000 < 5000
        print(f"timed_out={r.timed_out} code={r.code} stdout ok={saida_ok}")
        print(f"rapido={rapido}")
        delete(saida)
        delete(r.stdout)
        delete(r.stderr)
    case pr.ProcessError:
        print("erro")
    }
}
