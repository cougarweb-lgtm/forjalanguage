// std:process no Linux (M5 P28b-2) - o programa sem "/" (sh) e achado pelo PATH VIVO do pai, mesmo com o ambiente do filho substituido (sem PATH); os argumentos chegam como a linha
// (o ambiente sem PATH nao prova nada pelo eco: o ash recoloca um PATH padrao; vale ter achado o sh e o A=1 chegar) com aspas do Windows os descreve (espaco, vazio, aspa e barra no fim), divididos pelo rt_linha.c.
// Equivalente Windows: std\process\testes.fj "aspas da linha de comando seguem o CommandLineToArgvW" (la so a linha montada; aqui o argv que o filho recebe).
import "std:process" as pr

proc rodar(rotulo: str, args: []str, env: []str) {
    let cmd = pr.Command{program = "sh", args = args, env = env, cwd = "", timeout_ms = 0}
    switch r in pr.run(cmd, alloc = heap) {
    case pr.Output:
        let saida = from_bytes(r.stdout[..], alloc = heap)
        print(f"{rotulo} code={r.code}")
        print(saida)
        delete(saida)
        delete(r.stdout)
        delete(r.stderr)
    case pr.ProcessError:
        print(f"{rotulo} erro")
    }
}

proc main() {
    var a1: [2]str = {"-c", "echo viapath"}
    rodar("path", a1[..], {})
    var env: [1]str = {"A=1"}
    var a2: [2]str = {"-c", "echo $A ${HOME-semhome}"}
    rodar("env sem PATH", a2[..], env[..])
    var a3: [7]str = {"-c", "for a in \"$@\"; do echo \"[$a]\"; done", "x", "a b", "", "q\"r", "c\\"}
    rodar("argv", a3[..], {})
}
