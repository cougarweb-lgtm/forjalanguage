// std:process no Linux (M5 P28b-2) - run devolve codigo, stdout e stderr separados: o filho (/bin/sh) escreve nos dois canais e sai com 3.
// Equivalente Windows: std\process\testes.fj "run devolve codigo, stdout e stderr separados" (cmd.exe, com CRLF).
import "std:process" as pr

proc main() {
    var args: [2]str = {"-c", "echo ola; echo erro 1>&2; exit 3"}
    let cmd = pr.Command{program = "/bin/sh", args = args[..], env = {}, cwd = "", timeout_ms = 0}
    switch r in pr.run(cmd, alloc = heap) {
    case pr.Output:
        let saida = from_bytes(r.stdout[..], alloc = heap)
        let erro = from_bytes(r.stderr[..], alloc = heap)
        print(f"code={r.code} timed_out={r.timed_out}")
        let saida_ok = saida == "ola\n"
        let erro_ok = erro == "erro\n"
        print(f"stdout ok={saida_ok} stderr ok={erro_ok}")
        delete(saida)
        delete(erro)
        delete(r.stdout)
        delete(r.stderr)
    case pr.ProcessError:
        print("erro")
    }
}
