// std:process no Linux (M5 P28b-2) - 30 mil linhas no stdout (318890 bytes, mais que os 64 KiB do pipe): o pai tem de ler enquanto o filho escreve, sem travar.
// Equivalente Windows: std\process\testes.fj "saida maior que o pipe nao trava".
import "std:process" as pr

proc main() {
    var args: [2]str = {"-c", "i=0; while [ $i -lt 30000 ]; do echo linha$i; i=$((i+1)); done"}
    let cmd = pr.Command{program = "/bin/sh", args = args[..], env = {}, cwd = "", timeout_ms = 0}
    switch r in pr.run(cmd, alloc = heap) {
    case pr.Output:
        let n = len(r.stdout)
        let fim = from_bytes(r.stdout[n - 11..<n], alloc = heap)
        print(f"code={r.code} bytes={n} stderr={len(r.stderr)} timed_out={r.timed_out}")
        let fim_ok = fim == "linha29999\n"
        print(f"fim ok={fim_ok}")
        delete(fim)
        delete(r.stdout)
        delete(r.stderr)
    case pr.ProcessError:
        print("erro")
    }
}
