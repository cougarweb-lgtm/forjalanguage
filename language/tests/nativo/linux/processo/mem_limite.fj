// std:process no Linux (M5 P28b-2b) - Command.mem_limit_bytes: o filho roda com RLIMIT_AS (setrlimit 160 antes do execve). O dd pede um buffer de 256 MiB: com limite de 128 MiB ele falha (codigo != 0), com 1 GiB ou sem limite (0) ele passa.
// O pai nao e afetado: a falha vem como Output.code do filho (dd: "memory exhausted", exit 1), nunca como panic nem timeout.
// Equivalente Windows: std\process\testes.fj "mem_limit_bytes estoura o limite do filho sem derrubar o pai" (Job com ProcessMemoryLimit).
import "std:process" as pr

const MIB: u64 = 1048576

// Roda o dd com buffer de 256 MiB sob o limite dado; devolve "code=<n> timed_out=<b>".
proc rodar_dd(limite: u64) {
    var args: [2]str = {"-c", "dd if=/dev/zero of=/dev/null bs=256M count=1 2>/dev/null"}
    let cmd = pr.Command{program = "/bin/sh", args = args[..], env = {}, cwd = "", timeout_ms = 20000, mem_limit_bytes = limite}
    switch r in pr.run(cmd, alloc = heap) {
    case pr.Output:
        print(f"limite {limite / MIB} MiB: passou={r.code == 0} timed_out={r.timed_out}")
        delete(r.stdout)
        delete(r.stderr)
    case pr.ProcessError:
        print("erro")
    }
}

proc main() {
    rodar_dd(128 * MIB)
    rodar_dd(1024 * MIB)
    rodar_dd(0)
    print("pai vivo")
}
