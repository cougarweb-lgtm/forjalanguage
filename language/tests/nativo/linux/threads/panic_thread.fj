// panic_thread.fj (Linux) - M5c-b P57 (D-R7): panic dentro de threads criadas por foreign pthread_create (nao e a principal). Duas threads panicam ao mesmo tempo; o main espera.
// Esperado: EXATAMENTE 1 relatorio R0003 no stderr e exit 101 (nunca longjmp). os.multithread_on() liga o flag ANTES do pthread_create.
// Verificacao: python -I verificar_threads_linux.py --forja <forja.exe>
import "std:os"

foreign {
    link "c"
    proc pthread_create(tid: rawptr, atributos: u64, rotina: proc(p: rawptr) -> rawptr, parametro: rawptr) -> i32
    proc pthread_join(tid: u64, retorno: u64) -> i32
}

proc rotina(p: rawptr) -> rawptr {
    let v = new(int, alloc = heap)
    defer delete(v)
    v^ = 7
    panic("panic fora do main")
    return p
}

proc main() {
    let c = new(int, alloc = heap)
    defer delete(c)
    var a: u64 = 0
    var b: u64 = 0
    os.multithread_on()
    _ = pthread_create(&a as rawptr, atributos = 0, rotina = rotina, parametro = c as rawptr)
    _ = pthread_create(&b as rawptr, atributos = 0, rotina = rotina, parametro = c as rawptr)
    _ = pthread_join(a, retorno = 0)
    _ = pthread_join(b, retorno = 0)
    print("main: nao devia chegar aqui")
}
