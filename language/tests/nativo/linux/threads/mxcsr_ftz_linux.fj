// mxcsr_ftz_linux.fj - M5c-b P58: gemea Linux de tests\nativo\m5c\thread\mxcsr_ftz.fj (a original usa _controlfp do msvcrt, que nao existe no Linux).
// Mesma propriedade: FTZ ligado na principal tem de valer na filha (MXCSR herdado da criadora). Saida: "FTZ filha OK". So muda como o FTZ e ligado e lido: helper C minimo
// (mxcsr_helper_linux.c, lib vendor/linux/libmxcsr_linux.a, construir_mxcsr.sh). Versao: 0.1.0 - M5c-b P58: primeira versao.
import "std:thread"

foreign {
    link "mxcsr_linux"
    proc mxcsr_t_ler() -> u32
    proc mxcsr_t_ligar_ftz()
}

struct Resultado {
    modo: u32 = 0
}

proc filha(p: rawptr) -> u32 {
    let r = p as ^Resultado
    r.modo = mxcsr_t_ler()
    return 0
}

proc main() {
    mxcsr_t_ligar_ftz()
    var r = Resultado{}
    switch t in thread.spawn(filha, &r as rawptr) {
    case thread.Thread:
        _ = thread.join(t)
        if (r.modo & 0x8000) != 0 {
            print("FTZ filha OK")
        } else {
            print("FTZ filha FALHOU")
        }
    case thread.ThreadError:
        print("falhou")
    }
}
