// threads_pilha.fj (Linux) - M5c-b P63: a pilha da thread do std:thread e de 1 MiB no Linux (como no Windows). A filha recursa >= 256 KiB de quadros (1024 niveis de 256 bytes de local)
// e imprime "pilha OK 1024"; com a pilha padrao do musl (~128 KiB) isso dava SIGSEGV. Saida esperada: "pilha OK 1024", exit 0.
// Verificacao: python -I verificar_threads_linux.py --forja <forja.exe>
import "std:thread"

const NIVEIS: int = 1024

struct Resultado {
    fundo: int = 0
}

// Cada nivel guarda 256 bytes no quadro e usa um byte dele depois da chamada, para o compilador nao descartar o array.
proc descer(n: int, acumulado: int) -> int {
    var bloco: [256]u8 = {}
    bloco[n % 256] = (n % 251) as u8
    if n == 0 {
        return acumulado
    }
    let r = descer(n - 1, acumulado + 1)
    return r + (bloco[n % 256] as int) - (n % 251)
}

proc filha(p: rawptr) -> u32 {
    let r = p as ^Resultado
    r.fundo = descer(NIVEIS, 0)
    return 0
}

proc main() {
    var r = Resultado{}
    switch t in thread.spawn(filha, &r as rawptr) {
    case thread.Thread:
        _ = thread.join(t)
    case thread.ThreadError:
        print("FALHA thread")
        return
    }
    print(f"pilha OK {r.fundo}")
}
