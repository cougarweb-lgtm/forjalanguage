cwd barra=true nao_vazio=true
abs </x/./y/../z//> -> </x/z>
abs </..> -> </>
abs </> -> </>
abs <//a///b/> -> </a/b>
abs </a/b/../../../..> -> </>
abs </ação/./é> -> </ação/é>
abs relativo = cwd + /k/m: true
exe igual a args[0]: true barra=true
unset TMPDIR ok
temp sem TMPDIR -> </tmp>
set TMPDIR /var/tmp ok
temp /var/tmp -> </var/tmp>
set TMPDIR /var/tmp/ ok
temp /var/tmp/ -> </var/tmp>
set TMPDIR // ok
temp // -> </>
set TMPDIR vazio ok
temp vazio -> </tmp>
env FJ_ANTES=<antes> (5)
env FJ_OUTRA=<outra> (5)
set FJ_ANTES ok
env FJ_ANTES=<depois> (6)
env FJ_OUTRA=<outra> (5)
set FJ_NOVA ok
env FJ_NOVA=<n1> (2)
set FJ_NOVA vazio ok
env FJ_NOVA=<> (0)
set FJ_NOVA acento ok
env FJ_NOVA=<ação> (6)
unset FJ_NOVA ok
env FJ_NOVA=none
unset FJ_NOVA de novo ok
unset FJ_ANTES ok
env FJ_ANTES=none
env FJ_OUTRA=<outra> (5)
set nome vazio invalid_input
set nome com igual invalid_input
unset nome vazio invalid_input
env FJ_V0=<v> (1)
env FJ_V49=<v> (1)
env FJ_V25=none
env FJ_OUTRA=<outra> (5)
muitas erros=0
random a ok
random b ok
random distintos=true nao_zeros_muitos=true
random vazio ok
random 1 byte ok
random 3000000 ok
random grande nao_zeros=true ultimo_trecho_cheio=true
