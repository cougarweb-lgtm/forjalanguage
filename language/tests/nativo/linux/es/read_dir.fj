// std:file no Linux (M5 P28b-1) - read_dir numa pasta de /tmp ($D; arg 1 = @D@/lista) com 1500 arquivos (passa de um bloco de 32 KiB do getdents64). Logica em dir_comum.fj.
import "std:os" as sys
import "dir_comum"

proc main() {
    let a = sys.args()
    if len(a) != 2 {
        print("uso: pasta")
        sys.exit(2)
    }
    dir_comum.executar(a[1], 1500)
}
