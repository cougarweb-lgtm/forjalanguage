// K1: leitura de stdin com linha maior que o bloco (byte pendente do read_line) na mesma execucao de Arena, mapa e lista.
// Antes da correcao o byte pendente do stdin e a tabela de handles do alocador dividiam o mesmo slot do estado do runtime do a64.
// A entrada vem de stdin_alocador.entrada (a mesma de stdin.fj).
import "std:os" as sys
import "std:mem"

struct Ponto {
    x: int
    y: int
}

proc main() {
    let a = mem.arena_create()
    defer mem.arena_destroy(a)
    var m = make(map[int]int, alloc = heap)
    defer delete(m)
    var l = make([dynamic]int, alloc = heap)
    defer delete(l)
    let antes = new(Ponto, alloc = a)
    antes.x = 7
    antes.y = 11
    var n: int = 0
    var acabou = false
    while not acabou {
        switch r in sys.read_line(alloc = heap) {
        case str:
            n += 1
            let p = new(Ponto, alloc = a)
            p.x = len(r)
            p.y = n
            insert(&m, key = n, value = len(r))
            append(&l, item = len(r) + n)
            delete(r)
        case sys.InputError:
            acabou = true
        }
    }
    let depois = new(Ponto, alloc = a)
    depois.x = antes.x + antes.y
    print(f"linhas={n} mapa={len(m)} lista={len(l)}")
    print(f"antes={antes.x},{antes.y} depois={depois.x}")
    print(f"soma={sum(l[..])} linha5={get(m, key = 5) or_else -1}")
}
