// std:os no Linux (M5 P28b-1) - entrada padrao por read_all_stdin: 200000 bytes binarios (com NUL, CR e LF) em varias leituras de 64 KiB. A entrada vem de stdin_tudo.entrada.
import "std:os" as sys

proc main() {
    switch r in sys.read_all_stdin(alloc = heap) {
    case [dynamic]u8:
        var soma: int = 0
        var lfs: int = 0
        for b in r[..] {
            soma += b as int
            if b == 10 {
                lfs += 1
            }
        }
        print(f"bytes={len(r)} lf={lfs} soma={soma}")
        delete(r)
    case sys.InputError:
        print("erro")
    }
}
