// std:os no Linux (M5 P28b-1) - entrada padrao por read_line: LF, CRLF, linha vazia, UTF-8, linha de 5000 bytes (maior que o bloco de 4096 do read_line) e ultima linha sem LF.
// A entrada vem de stdin.entrada (o wsl_lote a liga ao stdin do programa).
import "std:os" as sys

proc main() {
    var n: int = 0
    var total: int = 0
    var acabou = false
    while not acabou {
        switch r in sys.read_line(alloc = heap) {
        case str:
            n += 1
            total += len(r)
            if len(r) <= 20 {
                print(f"linha {n} ({len(r)}) <{r}>")
            } else {
                print(f"linha {n} ({len(r)}) comeca={r[0]} termina={r[len(r) - 1]}")
            }
            delete(r)
        case sys.InputError:
            if r == sys.InputError.end {
                print("fim")
            } else {
                print("erro")
            }
            acabou = true
        }
    }
    print(f"linhas={n} bytes={total}")
}
