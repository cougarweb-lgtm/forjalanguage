// std:os no Linux (M5 P28b-2b) - write_stderr e print_stderr escrevem em stderr (fd 2) sem CRLF e sem buffer; o stdout sai separado. O .stderr ao lado traz o que o stderr tem de conter.
// Equivalente Windows: std\os\testes.fj "write_stderr e print_stderr" (o mesmo programa nos dois backends do Windows).
import "std:os"

proc main() {
    print("antes")
    os.print_stderr("erro 1")
    var bytes: [3]u8 = {111, 107, 10}
    os.write_stderr(bytes[..])
    var vazio: [1]u8 = {0}
    os.write_stderr(vazio[0..<0])
    print("depois")
}
