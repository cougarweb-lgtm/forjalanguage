// std:os no Linux (M5 P28b-2b) - peak_memory() devolve o pico (getrusage ru_maxrss * 1024) do proprio processo: positivo, multiplo de 1024 e nao cai depois de tocar 8 MiB.
// Equivalente Windows: std\os\testes.fj "peak_memory" (PeakWorkingSetSize).
import "std:os"

proc main() {
    let antes = os.peak_memory() or_else 0
    var bloco = make([dynamic]u8, alloc = heap, len = 8388608)
    for i in 0..<8388608 {
        bloco[i] = (i % 251) as u8
    }
    let depois = os.peak_memory() or_else 0
    print(f"antes positivo={antes > 0}")
    print(f"multiplo de 1024={antes % 1024 == 0}")
    print(f"depois >= antes + 8 MiB / 2={depois >= antes + 4194304}")
    print(bloco[8388607])
    delete(bloco)
}
