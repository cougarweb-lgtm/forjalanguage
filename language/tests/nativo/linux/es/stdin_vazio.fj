// std:os no Linux (M5 P28b-1) - entrada padrao vazia (/dev/null, sem .entrada): read_line = end e read_all_stdin = lista vazia (nao e erro).
import "std:os" as sys

proc main() {
    switch r in sys.read_line(alloc = heap) {
    case str:
        print(f"linha inesperada ({len(r)})")
        delete(r)
    case sys.InputError:
        if r == sys.InputError.end {
            print("read_line: end")
        } else {
            print("read_line: erro")
        }
    }
    switch d in sys.read_all_stdin(alloc = heap) {
    case [dynamic]u8:
        print(f"read_all_stdin: {len(d)} bytes")
        delete(d)
    case sys.InputError:
        print("read_all_stdin: erro")
    }
}
