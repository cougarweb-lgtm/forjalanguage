// std:file no Linux (M5 P28b-1) - read_dir numa pasta do Windows vista pelo WSL (/mnt/c, 9p; arg 1 = @T@/forja_es_lista, @T@ = a pasta temporaria do Windows). Logica em dir_comum.fj.
import "std:os" as sys
import "dir_comum"

proc main() {
    let a = sys.args()
    if len(a) != 2 {
        print("uso: pasta")
        sys.exit(2)
    }
    dir_comum.executar(a[1], 60)
}
