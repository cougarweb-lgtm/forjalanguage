// M5 P28 prova: grava 1 MiB num arquivo da pasta args[1], le de volta e confere; arquivo inexistente sai por exit(3).
import "std:os" as sys
import "std:file" as fs

const TAMANHO: int = 1048576

proc main() {
    let a = sys.args()
    if len(a) != 2 {
        print("uso: pasta")
        sys.exit(2)
    }
    let caminho = format(f"{a[1]}/prova.bin", alloc = heap)
    defer delete(caminho)
    var dados = make([dynamic]u8, alloc = heap, cap = TAMANHO)
    defer delete(dados)
    for i in 0..<TAMANHO {
        append(&dados, item = ((i * 7 + i / 256) % 256) as u8)
    }
    let erro = fs.write_all(caminho, data = dados[..])
    if erro != none {
        print("erro de escrita")
        sys.exit(4)
    }
    switch lido in fs.read_all(caminho, alloc = heap) {
    case [dynamic]u8:
        var iguais = len(lido) == len(dados)
        var soma = 0
        for i in 0..<len(lido) {
            soma += lido[i] as int
            if iguais and lido[i] != dados[i] {
                iguais = false
            }
        }
        print(f"n={len(lido)} iguais={iguais} soma={soma}")
        delete(lido)
    case fs.FileError:
        print("erro de leitura")
        sys.exit(5)
    }
    let ausente = format(f"{a[1]}/nao_existe.bin", alloc = heap)
    defer delete(ausente)
    switch x in fs.read_all(ausente, alloc = heap) {
    case [dynamic]u8:
        print("inesperado")
        delete(x)
    case fs.FileError:
        print("inexistente")
        sys.exit(3)
    }
}
