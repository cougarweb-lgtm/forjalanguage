// M5 P28 prova: f-string, format, acentos e emoji (bytes UTF-8), reais, map e lista.
proc main() {
    let nome = "Grifo"
    let n = 42
    let h: u64 = 255
    print(f"{nome} tem {n} de vida; hex={h:x} largura={7:04}")
    let s = format(f"ação ç ã é {n}", alloc = heap)
    defer delete(s)
    print(s)
    print(len(s))
    print("emoji: 😀 e acentos: áéíóú")
    print(len("😀"))
    let x: f64 = 1.0 / 3.0
    let y: f32 = 2.5
    print(f"{x} {y} {x:.3} {y:.1}")
    var m = make(map[str]int, alloc = heap)
    defer delete(m)
    insert(&m, key = "um", value = 1)
    insert(&m, key = "dois", value = 2)
    print(get(m, key = "um") or_else -1)
    print(get(m, key = "dois") or_else -1)
    print(get(m, key = "tres") or_else -1)
    var l = make([dynamic]int, alloc = heap, cap = 2)
    defer delete(l)
    for i in 1..=5 {
        append(&l, item = i * i)
    }
    var total = 0
    for v in l {
        total += v
    }
    print(f"len={len(l)} total={total}")
}
