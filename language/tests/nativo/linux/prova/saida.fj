// M5 P28 prova: args ecoados (de args[1] em diante), variavel de ambiente FORJA_PROVA e exit(7).
import "std:os" as sys

proc main() {
    let a = sys.args()
    print(f"n={len(a)}")
    for i, s in a {
        if i > 0 {
            print(f"[{i}] ({len(s)}) {s}")
        }
    }
    switch v in sys.env("FORJA_PROVA") {
    case str:
        print(f"FORJA_PROVA=<{v}>")
    case none:
        print("FORJA_PROVA=none")
    }
    sys.exit(7)
}
