// M5 P28 prova: laco com faixa fechada; soma e quantidade de pares de 0 a 100, depois cada valor impresso.
proc main() {
    var soma: int = 0
    var pares: int = 0
    for i in 0..=100 {
        soma += i
        if i % 2 == 0 {
            pares += 1
        }
    }
    print(f"soma={soma} pares={pares}")
    for i in 0..=100 {
        print(i)
    }
}
