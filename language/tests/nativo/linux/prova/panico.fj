// M5 P28 prova: indice fora da lista. Em dev e R0006 (exit 101) e o v[k] nem imprime; em release o indice so e checado com --checagem sim (o runner passa --checagem sim; sem ela v[k] * 0 imprimiria 0) e o assert final da R0003 (exit 101).
import "std:os" as sys

proc main() {
    let v: [3]int = {1, 2, 3}
    var i = 0
    while i < 3 {
        print(v[i])
        i += 1
    }
    let k = len(sys.args()) + 2
    print(v[k] * 0)
    assert(k < 3, msg = "fim")
}
