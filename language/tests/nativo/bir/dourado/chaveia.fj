// chaveia.fj - fonte do dourado chaveia.bir: switch de enum com valores explicitos e padrao (cadeia CMP + DESVIA), break de laco dentro do switch, panic em caso.

enum Modo {
    a = 0,
    b = 5,
    c = 9
}

proc numero(m: Modo) -> i32 {
    var r: i32 = 100
    switch m {
    case Modo.b:
        r = 5
    case Modo.c:
        r = 9
    default:
        r = 0
    }
    return r
}

proc main() {
    var m = Modo.a
    for i in 0..<5 {
        switch m {
        case Modo.c:
            break
        default:
            print(numero(m))
        }
        if i == 0 {
            m = Modo.b
        } else {
            m = Modo.c
        }
    }
    if numero(m) != 9 {
        panic("modo inesperado")
    }
}
