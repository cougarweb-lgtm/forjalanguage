// formato.fj - dourado da BIR do P15b: f"..." que imprime, format (str) e format_c (cstr) com alocador heap, frame e Arena; inteiro com sinal e sem sinal (hexa), bool, str, cstr, f32 (alargado a f64) e f64.

import "std:mem"

proc main() {
    let n: i32 = -42
    let u: u8 = 200
    let x: f32 = 2.5
    let y: f64 = 0.1
    let c: cstr = "ponte"
    print(f"n={n:05} u={u:x} {true} {x:.2} {y} {c:8}")
    let s = format(f"s{n}", alloc = heap)
    print(s)
    delete(s)
    let t = format_c(f"t{u}", alloc = frame)
    print(t)
    let a = mem.arena_create(64)
    let r = format(f"r={n}", alloc = a)
    print(len(r))
    mem.arena_destroy(a)
    frame_reset()
}
