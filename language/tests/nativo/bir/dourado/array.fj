// array.fj - dourado do BIR de arrays e fatias (P13b): literal de [N]T, elemento (CARREGA) com indice conferido em dev, endereco de elemento, fatia (forja_fatia_confere), len de fatia, slice_from e array de struct.

struct Par {
    a: i32
    b: i32
}

proc soma(s: []int) -> int {
    var total = 0
    for i in 0..<len(s) {
        total += s[i]
    }
    return total
}

proc main() {
    var a: [4]int = {10, 20, 30, 40}
    a[1] = 25
    let i = 2
    print(a[i])
    let s = a[1..<3]
    print(soma(s))
    var ps: [2]Par = {Par{a = 1, b = 2}, Par{a = 3, b = 4}}
    ps[1].b = 9
    print(ps[1].b)
    var v: [3]i32 = {7, 8, 9}
    let p = &v[0]
    let t = slice_from(p, len = 3)
    print(t[2])
}
