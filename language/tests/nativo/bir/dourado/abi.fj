// abi.fj - fonte do dourado abi.bir: struct por valor (8 B no registrador, 12 B por ponteiro), copia privada do argumento e retorno de 12 B pelo endereco de destino.

struct Par {
    a: i32
    b: i32
}

struct Trio {
    a: i32
    b: i32
    c: i32
}

proc soma(p: Par, t: Trio) -> Trio {
    return Trio{a = p.a + t.a, b = p.b + t.b, c = t.c}
}

proc primeiro(p: Par) -> i32 {
    return p.a
}

proc main() {
    let r = soma(Par{a = 1, b = 2}, t = Trio{a = 3, b = 4, c = 5})
    print(r.a)
    print(r.b)
    print(r.c)
    print(primeiro(Par{a = 9, b = 8}))
}
