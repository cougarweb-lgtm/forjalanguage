// struct.fj - fonte do dourado struct.bir: struct local em slot (padding u8/i64), campo, copia por COPIA_MEM, &x e p^, faixa de campo em dev.

struct Peca {
    marca: u8
    peso: i64
    vida: i32 in 0..=100 = 100
}

proc main() {
    let a = Peca{marca = 7, peso = 40}
    var b = a
    b.peso = b.peso + 2
    var n: int = 1
    let p = &n
    p^ = p^ + b.marca as int
    print(a.peso)
    print(b.peso)
    print(n)
}
