// texto.fj - dourado do BIR de str e cstr (P13a): literal (END_SIMBOLO + len gravado no slot), print, == e !=, 'cstr as str', len, parametro e retorno por valor.

proc eco(s: str) -> str {
    return s
}

proc main() {
    let a: str = "ola"
    let c: cstr = "mundo"
    let b = c as str
    print(eco(a))
    print(a == b)
    print(a != "ola")
    print(len(b))
}
