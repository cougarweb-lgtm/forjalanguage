// resultado.fj - fonte do dourado resultado.bir: T ! E com valor escalar e struct, try, or_else, switch com ligacao, assert e main -> ! E (R0004 em forja_programa).

enum Erro { a, b }

struct Medida {
    quant: int
    peso: i32
}

proc achar(n: i32) -> i32 ! Erro {
    if n < 0 {
        return Erro.b
    }
    return n * 3
}

proc medir(n: i32) -> Medida ! Erro {
    let v = try achar(n)
    return Medida{quant = 1, peso = v}
}

proc main() -> ! Erro {
    print(achar(2) or_else -1)
    switch m in medir(4) {
    case Medida:
        print(m.peso)
    case Erro:
        print("erro")
    }
    let um = achar(1) or_else 0
    assert(um == 3, msg = "achar(1) vale 3")
    let x = try achar(-1)
    print(x)
}
