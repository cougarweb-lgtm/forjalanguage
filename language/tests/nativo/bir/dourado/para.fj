// para.fj - fonte do dourado para.bir: um 'for' exclusivo com continue (vai ao passo) e break (vai ao fim).

proc main() {
    var total = 0
    for i in 0..<5 {
        if i == 1 {
            continue
        }
        if i == 4 {
            break
        }
        total += i
    }
    print(total)
}
