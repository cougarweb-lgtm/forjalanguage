// memoria.fj - dourado do P14b: new no heap e no frame, lista no frame (make, append com crescimento, indice conferido, fatia, len, delete), frame_reset e Pool (delete em = pool).
import "std:mem"

proc main() {
    let p = new(int, alloc = heap)
    p^ = 3
    print(p^)
    delete(p)
    let q = new(i32, alloc = frame)
    q^ = 4
    var l = make([dynamic]int, alloc = frame, cap = 1)
    append(&l, item = 7)
    append(&l, item = 8)
    print(l[1] + len(l))
    let s = l[0..<2]
    print(len(s))
    delete(l)
    frame_reset()
    let pool = mem.pool_create()
    let r = new(int, alloc = pool)
    r^ = 1
    print(r^)
    delete(r, alloc = pool)
    mem.pool_destroy(pool)
}
