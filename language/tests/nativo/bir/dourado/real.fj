// real.fj - fonte do dourado real.bir: f32 e f64 em local, parametro e retorno, conta, negacao, comparacao e conversoes (int <-> real, f64 <-> f32).

proc soma(a: f32, b: f32) -> f32 {
    return a + b
}

proc mistura(n: i32, x: f64) -> f64 {
    let y: f32 = 1.5
    if x < (y as f64) {
        return -x
    }
    return x * (n as f64)
}

proc main() {
    print(soma(0.5, b = 0.25) as int)
    print(mistura(3, x = 2.0) as i32)
}
