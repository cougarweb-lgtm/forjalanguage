// opcional.fj - dourado da BIR do P15a: ?i32 (embrulha, none, or_else), ?^T e ?cstr (o ponteiro), ?T em parametro, tupla (retorno multiplo), union (embrulha e switch com ligacao) e switch de ?T.

struct Grifo {
    vida: i32 = 100
}

union Alvo {
    ^Grifo,
    i32
}

proc achar(n: i32) -> ?i32 {
    if n > 0 {
        return n
    }
    return none
}

proc dobro(v: ?i32) -> i32 {
    return (v or_else 0) * 2
}

proc par(n: i32) -> (a: i32, b: bool) {
    return n, n > 0
}

proc pesa(a: Alvo) -> i32 {
    switch x in a {
    case ^Grifo:
        return x.vida
    case i32:
        return x
    }
    return 0
}

proc nome(p: ?^Grifo, c: ?cstr) -> i32 {
    var total: i32 = 0
    switch g in p {
    case ^Grifo:
        total = g.vida
    case none:
        total = -1
    }
    if c != none {
        total += 1
    }
    return total
}

proc main() {
    var g = Grifo{vida = 7}
    let a, ok = par(3)
    print(dobro(achar(a)))
    print(ok)
    switch v in achar(0) {
    case i32:
        print(v)
    case none:
        print("none")
    }
    print(pesa(&g))
    print(pesa(5 as i32))
    print(nome(&g, c = "x"))
    print(nome(none, c = none))
}
