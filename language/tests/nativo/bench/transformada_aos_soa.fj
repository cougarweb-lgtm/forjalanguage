// transformada_aos_soa.fj - bench O0c (estilo jogo): o mesmo tick de transformacao de 4096 vetores de 3 inteiros, em AoS (array de struct) e em SoA (soa[..]); as duas formas tem de dar o mesmo resultado. Resumo: somas de checagem das duas formas e quantos vetores batem.

const QTD: int = 4096
const PASSOS: int = 4000
const MODULO: int = 1000003

struct Vetor {
    x: int = 0
    y: int = 0
    z: int = 0
}

proc transformar_aos(v: ^[4096]Vetor, passo: int) {
    for i in 0..<QTD {
        v^[i].x = (v^[i].x * 3 + v^[i].y + passo) % MODULO
        v^[i].y = (v^[i].y * 5 + v^[i].z + passo) % MODULO
        v^[i].z = (v^[i].z * 7 + v^[i].x + passo) % MODULO
    }
}

proc transformar_soa(v: ^soa[4096]Vetor, passo: int) {
    for i in 0..<QTD {
        v^[i].x = (v^[i].x * 3 + v^[i].y + passo) % MODULO
        v^[i].y = (v^[i].y * 5 + v^[i].z + passo) % MODULO
        v^[i].z = (v^[i].z * 7 + v^[i].x + passo) % MODULO
    }
}

proc main() {
    var forma_aos: [4096]Vetor = {}
    var forma_soa: soa[4096]Vetor = {}
    var estado = 7
    for i in 0..<QTD {
        estado = (estado * 1103515245 + 12345) % 2147483648
        let x = (estado / 65536) % MODULO
        estado = (estado * 1103515245 + 12345) % 2147483648
        let y = (estado / 65536) % MODULO
        estado = (estado * 1103515245 + 12345) % 2147483648
        let z = (estado / 65536) % MODULO
        forma_aos[i] = Vetor{x = x, y = y, z = z}
        forma_soa[i] = Vetor{x = x, y = y, z = z}
    }
    for passo in 0..<PASSOS {
        transformar_aos(&forma_aos, passo)
        transformar_soa(&forma_soa, passo)
    }
    var soma_aos = 0
    var soma_soa = 0
    var iguais = 0
    for i in 0..<QTD {
        soma_aos = (soma_aos + forma_aos[i].x + forma_aos[i].y * 3 + forma_aos[i].z * 7) % MODULO
        soma_soa = (soma_soa + forma_soa[i].x + forma_soa[i].y * 3 + forma_soa[i].z * 7) % MODULO
        if forma_aos[i].x == forma_soa[i].x and forma_aos[i].y == forma_soa[i].y and forma_aos[i].z == forma_soa[i].z {
            iguais += 1
        }
    }
    print(soma_aos)
    print(soma_soa)
    print(iguais)
}
