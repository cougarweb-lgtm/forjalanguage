// aabb_raio.fj - bench O0c (estilo jogo): teste raio x caixa (AABB) em lote, metodo dos slabs em inteiro com escala 1024 (sem float, resultado exato). Gera caixas e raios por LCG fixo e conta acertos. Resumo: total de acertos e soma dos indices acertados.

const CAIXAS: int = 512
const RAIOS: int = 24000
const ESCALA: int = 1024
const MODULO: int = 1000003

struct Caixa {
    minx: int = 0
    miny: int = 0
    minz: int = 0
    maxx: int = 0
    maxy: int = 0
    maxz: int = 0
}

struct Raio {
    ox: int = 0
    oy: int = 0
    oz: int = 0
    dx: int = 1
    dy: int = 1
    dz: int = 1
}

proc menor(a: int, b: int) -> int {
    if a < b {
        return a
    }
    return b
}

proc maior(a: int, b: int) -> int {
    if a > b {
        return a
    }
    return b
}

proc acerta(c: Caixa, r: Raio) -> bool {
    let tx1 = (c.minx - r.ox) * ESCALA / r.dx
    let tx2 = (c.maxx - r.ox) * ESCALA / r.dx
    let ty1 = (c.miny - r.oy) * ESCALA / r.dy
    let ty2 = (c.maxy - r.oy) * ESCALA / r.dy
    let tz1 = (c.minz - r.oz) * ESCALA / r.dz
    let tz2 = (c.maxz - r.oz) * ESCALA / r.dz
    let entrada = maior(maior(menor(tx1, tx2), menor(ty1, ty2)), menor(tz1, tz2))
    let saida = menor(menor(maior(tx1, tx2), maior(ty1, ty2)), maior(tz1, tz2))
    return entrada <= saida and saida >= 0
}

proc proximo(estado: int) -> int {
    return (estado * 1103515245 + 12345) % 2147483648
}

proc main() {
    var caixas: [512]Caixa = {}
    var estado = 5
    for i in 0..<CAIXAS {
        estado = proximo(estado)
        let cx = (estado / 65536) % 2001 - 1000
        estado = proximo(estado)
        let cy = (estado / 65536) % 2001 - 1000
        estado = proximo(estado)
        let cz = (estado / 65536) % 2001 - 1000
        estado = proximo(estado)
        let meia = (estado / 65536) % 60 + 1
        caixas[i] = Caixa{minx = cx - meia, miny = cy - meia, minz = cz - meia, maxx = cx + meia, maxy = cy + meia, maxz = cz + meia}
    }
    var acertos = 0
    var soma_indices = 0
    for n in 0..<RAIOS {
        estado = proximo(estado)
        let ox = (estado / 65536) % 2401 - 1200
        estado = proximo(estado)
        let oy = (estado / 65536) % 2401 - 1200
        estado = proximo(estado)
        let oz = (estado / 65536) % 2401 - 1200
        estado = proximo(estado)
        var dx = (estado / 65536) % 7 - 3
        estado = proximo(estado)
        var dy = (estado / 65536) % 7 - 3
        estado = proximo(estado)
        var dz = (estado / 65536) % 7 - 3
        if dx == 0 {
            dx = 1
        }
        if dy == 0 {
            dy = 1
        }
        if dz == 0 {
            dz = 1
        }
        let raio = Raio{ox = ox, oy = oy, oz = oz, dx = dx, dy = dy, dz = dz}
        for i in 0..<CAIXAS {
            if acerta(caixas[i], raio) {
                acertos += 1
                soma_indices = (soma_indices + i + n) % MODULO
            }
        }
    }
    print(acertos)
    print(soma_indices)
}
