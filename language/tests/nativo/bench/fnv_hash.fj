// fnv_hash.fj - bench O0c (estilo jogo): hash FNV-1a de 64 bits sobre um buffer de bytes u8 (texto de jogo), encadeando o hash de uma rodada na seguinte. O xor da Forja e o `~` binario (`a ~ b`, so em sem sinal). Resumo: prova contra o vetor conhecido FNV-1a("a"), hash final e o ultimo byte do buffer.

const TAMANHO: int = 4096
const RODADAS: int = 80000
const BASE_FNV: u64 = 0xcbf29ce484222325
const PRIMO_FNV: u64 = 0x100000001b3

proc fnv1a(dados: []u8, semente: u64) -> u64 {
    var h = semente
    for i in 0..<len(dados) {
        h = h ~ (dados[i] as u64)
        h = wrapping_mul(h, PRIMO_FNV)
    }
    return h
}

proc main() {
    var letra: [1]u8 = {97}
    print(fnv1a(letra[..], BASE_FNV) == 0xaf63dc4c8601ec8c)
    var buffer: [4096]u8 = {}
    var estado = 13
    for i in 0..<TAMANHO {
        estado = (estado * 1103515245 + 12345) % 2147483648
        buffer[i] = ((estado / 65536) % 256) as u8
    }
    var h = BASE_FNV
    for rodada in 0..<RODADAS {
        h = fnv1a(buffer[..], h)
        buffer[rodada % TAMANHO] = (h % 256) as u8
    }
    print(h)
    print(buffer[TAMANHO - 1] as int)
}
