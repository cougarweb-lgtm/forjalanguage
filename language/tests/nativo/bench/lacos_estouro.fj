// lacos_estouro.fj - bench P18 (2b): lacos de int aninhados com +, - e * checados contra estouro (a aritmetica nunca estoura: mede o custo da checagem). Resumo: soma e ultimo x.

proc passo(x: int, i: int) -> int {
    return (x * 1103 + i) % 1000003
}

proc main() {
    var acc = 0
    var x = 1
    for j in 0..<40000 {
        for i in 0..<2500 {
            x = passo(x, i = i)
            acc = acc + x * 3 - (i % 7)
        }
        acc = acc % 1000000007
    }
    print(acc)
    print(x)
}
