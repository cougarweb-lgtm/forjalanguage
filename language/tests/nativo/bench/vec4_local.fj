// vec4_local.fj - bench S4a (slp): Vec4 local (16 B) somado e escalado por procs que o inline traz para o laco; o sroa escalariza os slots, entao o slp nao pode vetorizar as gravacoes por campo (regressao de 8,5x medida em D0707). Resumo: bits dos 4 campos e do total.

struct Vec4 {
    x: f32 = 0.0
    y: f32 = 0.0
    z: f32 = 0.0
    w: f32 = 0.0
}

proc bits(v: f32) -> int {
    return transmute(v, to = u32) as int
}

proc soma(a: Vec4, b: Vec4) -> Vec4 {
    var r = Vec4{}
    r.x = a.x + b.x
    r.y = a.y + b.y
    r.z = a.z + b.z
    r.w = a.w + b.w
    return r
}

proc escala(a: Vec4, s: f32) -> Vec4 {
    var r = Vec4{}
    r.x = a.x * s
    r.y = a.y * s
    r.z = a.z * s
    r.w = a.w * s
    return r
}

proc main() {
    var acc = Vec4{x = 1.0, y = 2.0, z = 3.0, w = 4.0}
    let passo = Vec4{x = 0.001, y = 0.002, z = 0.003, w = 0.004}
    var total: f32 = 0.0
    for i in 0..<300000000 {
        let t = soma(acc, passo)
        acc = escala(t, 0.999)
        total = total + acc.x * 0.5 + acc.w * 0.25
    }
    print(bits(acc.x))
    print(bits(acc.y))
    print(bits(acc.z))
    print(bits(acc.w))
    print(bits(total))
}
