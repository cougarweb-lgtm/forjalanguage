// getter_vec3.fj - bench O0c (estilo jogo): struct Vec3 de 3 inteiros passada e retornada por valor num laco quente, com getters por campo. Resumo: acumulador de checagem e as 3 coordenadas finais de p.

const N: int = 6000000
const MODULO: int = 1000003

struct Vec3 {
    x: int = 0
    y: int = 0
    z: int = 0
}

proc criar_vec3(x: int, y: int, z: int) -> Vec3 {
    return Vec3{x = x, y = y, z = z}
}

proc somar(a: Vec3, b: Vec3) -> Vec3 {
    return Vec3{x = (a.x + b.x) % MODULO, y = (a.y + b.y) % MODULO, z = (a.z + b.z) % MODULO}
}

proc escalar(v: Vec3, k: int) -> Vec3 {
    return Vec3{x = (v.x * k) % MODULO, y = (v.y * k) % MODULO, z = (v.z * k) % MODULO}
}

proc produto_escalar(a: Vec3, b: Vec3) -> int {
    return (a.x * b.x + a.y * b.y + a.z * b.z) % MODULO
}

proc get_x(v: Vec3) -> int {
    return v.x
}

proc get_y(v: Vec3) -> int {
    return v.y
}

proc get_z(v: Vec3) -> int {
    return v.z
}

proc main() {
    var p = criar_vec3(1, 2, 3)
    var v = criar_vec3(5, 7, 11)
    var acc = 0
    for i in 0..<N {
        let fator = i % 7 + 1
        p = somar(p, escalar(v, fator))
        v = somar(escalar(v, 3), criar_vec3(i % MODULO, i * 2 % MODULO, i * 3 % MODULO))
        acc = (acc + produto_escalar(p, v) + get_x(p) + get_y(p) + get_z(p)) % MODULO
    }
    print(acc)
    print(get_x(p))
    print(get_y(p))
    print(get_z(p))
}
