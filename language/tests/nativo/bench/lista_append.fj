// lista_append.fj - bench P18 (2b): append em [dynamic]int no heap (crescimento por dobra), leitura por indice, escrita e for de colecao, varias rodadas com delete. Resumo: soma, ultimo item e len.

proc main() {
    var soma = 0
    var ultimo = 0
    var tamanho = 0
    for rodada in 0..<200 {
        var l = make([dynamic]int, alloc = heap)
        for i in 0..<250000 {
            append(&l, item = i * 3 + rodada)
        }
        for i in 0..<250000 {
            l[i] = l[i] + 1
        }
        for x in l {
            soma = (soma + x) % 1000000007
        }
        ultimo = l[249999]
        tamanho = len(l)
        delete(l)
    }
    print(soma)
    print(ultimo)
    print(tamanho)
}
