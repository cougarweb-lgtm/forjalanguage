// formato_texto.fj - bench P18 (2b): format(f"...", em = frame) em laco (int, largura, hex, bool e f64 com casas), sem imprimir dentro do laco; o frame volta a cada volta. Resumo: soma dos tamanhos e o ultimo texto.

proc main() {
    var total = 0
    var ultimo = ""
    for i in 0..<900000 {
        let par = i % 2 == 0
        let meio: f64 = (i as f64) / 8.0
        let s = format(f"item {i:6} par={par} meio={meio:.3} hex={i as u32:x}", alloc = frame)
        total += len(s)
        if i == 899999 {
            ultimo = s
            print(ultimo)
        }
        frame_reset()
    }
    print(total)
}
