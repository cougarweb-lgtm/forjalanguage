// particulas_soa.fj - bench P18 (2b): soa[1024]Particula, passos que leem e gravam colunas (f32 e int) com reflexao nas bordas. Resumo: soma das posicoes x 1000 truncada e a soma dos rebotes.

struct Particula {
    x: f32 = 0.0
    v: f32 = 0.0
    rebotes: int = 0
}

proc avancar(a: ^soa[1024]Particula, dt: f32) {
    for i in 0..<1024 {
        let nx = a^[i].x + a^[i].v * dt
        if nx > 100.0 {
            a^[i].x = 200.0 - nx
            a^[i].v = -a^[i].v
            a^[i].rebotes += 1
        } else if nx < 0.0 {
            a^[i].x = -nx
            a^[i].v = -a^[i].v
            a^[i].rebotes += 1
        } else {
            a^[i].x = nx
        }
    }
}

proc main() {
    var a: soa[1024]Particula = {}
    for i in 0..<1024 {
        a[i].x = ((i % 100) as f32) + 0.5
        a[i].v = ((i % 17) as f32) * 0.75 - 4.0
    }
    for passo in 0..<120000 {
        avancar(&a, dt = 0.0625)
    }
    var soma: f64 = 0.0
    var rebotes = 0
    for i in 0..<1024 {
        soma = soma + (a[i].x as f64)
        rebotes += a[i].rebotes
    }
    print((soma * 1000.0) as int)
    print(rebotes)
}
