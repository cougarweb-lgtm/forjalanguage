// soma_i32.fj - bench SIMD S0 (estilo jogo): soma de reducao de 65536 inteiros i32 por LCG fixo, com wrap (wrapping_add, a Forja define o estouro como volta). Resumo: soma total de cada rodada (wrap) somada em i32 e o total.

const PASSOS: int = 300

proc proximo(estado: int) -> int {
    return (estado * 1103515245 + 12345) % 2147483648
}

proc soma(v: []i32) -> i32 {
    var acc: i32 = 0
    for i in 0..<len(v) {
        acc = wrapping_add(acc, v[i])
    }
    return acc
}

proc main() {
    var v = make([dynamic]i32, alloc = heap, cap = 65536)
    defer delete(v)
    var estado = 23
    for i in 0..<65536 {
        estado = proximo(estado)
        append(&v, item = ((estado % 2000000) as i32) - 1000000)
    }
    var total: i32 = 0
    for passo in 0..<PASSOS {
        total = wrapping_add(total, soma(v[..]))
        v[passo] = wrapping_add(v[passo], 7)
    }
    print(total)
    print(soma(v[..]))
}
