// particulas_f32.fj - bench SIMD S0 (estilo jogo): integra posicao e velocidade de 65536 particulas com colisao simples por if/else (rebote nas bordas 0 e 100), so colunas f32 de um soa. Resumo: soma das posicoes e das velocidades (truncadas x 1000).

const QTD: int = 65536
const PASSOS: int = 500

struct Particula {
    x: f32 = 0.0
    v: f32 = 0.0
}

proc avancar(a: ^soa[65536]Particula, dt: f32) {
    for i in 0..<65536 {
        let nx = a^[i].x + a^[i].v * dt
        if nx > 100.0 {
            a^[i].x = 200.0 - nx
            a^[i].v = -a^[i].v
        } else if nx < 0.0 {
            a^[i].x = -nx
            a^[i].v = -a^[i].v
        } else {
            a^[i].x = nx
        }
    }
}

proc main() {
    var a: soa[65536]Particula = {}
    for i in 0..<QTD {
        a[i].x = ((i % 100) as f32) + 0.5
        a[i].v = ((i % 17) as f32) * 0.75 - 4.0
    }
    for passo in 0..<PASSOS {
        avancar(&a, dt = 0.0625)
    }
    var soma_x: f64 = 0.0
    var soma_v: f64 = 0.0
    for i in 0..<QTD {
        soma_x = soma_x + (a[i].x as f64)
        soma_v = soma_v + (a[i].v as f64)
    }
    print((soma_x * 1000.0) as int)
    print((soma_v * 1000.0) as int)
}
