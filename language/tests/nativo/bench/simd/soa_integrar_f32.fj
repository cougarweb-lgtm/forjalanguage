// soa_integrar_f32.fj - bench SIMD S0 (estilo jogo): integra x += vx*dt nos 3 eixos sobre colunas f32 de um soa, sem if no corpo. Resumo: soma de x, y e z (truncada x 1000).

const QTD: int = 32768
const PASSOS: int = 1000

struct Particula {
    x: f32 = 0.0
    y: f32 = 0.0
    z: f32 = 0.0
    vx: f32 = 0.0
    vy: f32 = 0.0
    vz: f32 = 0.0
}

proc proximo(estado: int) -> int {
    return (estado * 1103515245 + 12345) % 2147483648
}

proc componente(estado: int) -> f32 {
    return (((estado / 65536) % 2000) as f32) * 0.0005 - 0.5
}

proc integrar(a: ^soa[32768]Particula, dt: f32) {
    for i in 0..<32768 {
        a^[i].x = a^[i].x + a^[i].vx * dt
        a^[i].y = a^[i].y + a^[i].vy * dt
        a^[i].z = a^[i].z + a^[i].vz * dt
    }
}

proc main() {
    var a: soa[32768]Particula = {}
    var estado = 7
    for i in 0..<QTD {
        estado = proximo(estado)
        a[i].vx = componente(estado)
        estado = proximo(estado)
        a[i].vy = componente(estado)
        estado = proximo(estado)
        a[i].vz = componente(estado)
        a[i].x = (i % 97) as f32
        a[i].y = (i % 53) as f32
        a[i].z = (i % 31) as f32
    }
    for passo in 0..<PASSOS {
        integrar(&a, dt = 0.001)
    }
    var soma_x: f64 = 0.0
    var soma_y: f64 = 0.0
    var soma_z: f64 = 0.0
    for i in 0..<QTD {
        soma_x = soma_x + (a[i].x as f64)
        soma_y = soma_y + (a[i].y as f64)
        soma_z = soma_z + (a[i].z as f64)
    }
    print((soma_x * 1000.0) as int)
    print((soma_y * 1000.0) as int)
    print((soma_z * 1000.0) as int)
}
