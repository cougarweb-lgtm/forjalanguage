// conta_i32.fj - bench SIMD S0 (estilo jogo): conta os elementos de 65536 i32 (LCG fixo) maiores que um limite, com if/contador no laco, por 300 rodadas de limite variavel. Resumo: total das contagens e a contagem da ultima rodada.

const PASSOS: int = 300

proc proximo(estado: int) -> int {
    return (estado * 1103515245 + 12345) % 2147483648
}

proc conta_acima(v: []i32, limite: i32) -> int {
    var n = 0
    for i in 0..<len(v) {
        if v[i] > limite {
            n += 1
        }
    }
    return n
}

proc main() {
    var v = make([dynamic]i32, alloc = heap, cap = 65536)
    defer delete(v)
    var estado = 41
    for i in 0..<65536 {
        estado = proximo(estado)
        append(&v, item = ((estado % 2000000) as i32) - 1000000)
    }
    var total = 0
    var ultima = 0
    for passo in 0..<PASSOS {
        ultima = conta_acima(v[..], limite = ((passo * 6000) as i32) - 900000)
        total += ultima
    }
    print(total)
    print(ultima)
}
