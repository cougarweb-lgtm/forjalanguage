// transforma_vec4.fj - bench SIMD S0 (estilo jogo): multiplica 65536 vetores de 4 f32 (buffer plano, passo 4) por uma matriz 4x4 constante de rotacao em dois planos, sem if no corpo. Resumo: soma de todas as componentes (truncada x 1000) e a da primeira componente de cada quarto.

const PASSOS: int = 200

proc proximo(estado: int) -> int {
    return (estado * 1103515245 + 12345) % 2147483648
}

proc componente(estado: int) -> f32 {
    return (((estado / 65536) % 2000) as f32) * 0.0005 - 0.5
}

proc transforma(m: matrix[4, 4]f32, v: ^[dynamic]f32) {
    for i in 0..<65536 {
        let b = i * 4
        let x0 = v^[b]
        let x1 = v^[b + 1]
        let x2 = v^[b + 2]
        let x3 = v^[b + 3]
        v^[b] = m[0, 0] * x0 + m[0, 1] * x1 + m[0, 2] * x2 + m[0, 3] * x3
        v^[b + 1] = m[1, 0] * x0 + m[1, 1] * x1 + m[1, 2] * x2 + m[1, 3] * x3
        v^[b + 2] = m[2, 0] * x0 + m[2, 1] * x1 + m[2, 2] * x2 + m[2, 3] * x3
        v^[b + 3] = m[3, 0] * x0 + m[3, 1] * x1 + m[3, 2] * x2 + m[3, 3] * x3
    }
}

proc main() {
    let m: matrix[4, 4]f32 = {0.995, -0.0998, 0.0, 0.0, 0.0998, 0.995, 0.0, 0.0, 0.0, 0.0, 0.995, -0.0998, 0.0, 0.0, 0.0998, 0.995}
    var v = make([dynamic]f32, alloc = heap, cap = 262144)
    defer delete(v)
    var estado = 11
    for i in 0..<262144 {
        estado = proximo(estado)
        append(&v, item = componente(estado))
    }
    for passo in 0..<PASSOS {
        transforma(m, &v)
    }
    var soma: f64 = 0.0
    var primeiras: f64 = 0.0
    for i in 0..<65536 {
        let b = i * 4
        primeiras = primeiras + (v[b] as f64)
        soma = soma + (v[b] as f64) + (v[b + 1] as f64) + (v[b + 2] as f64) + (v[b + 3] as f64)
    }
    print((soma * 1000.0) as int)
    print((primeiras * 1000.0) as int)
}
