// mapa_insere_acha.fj - bench P18 (2b): map[int]int no heap, insercoes com rehash, buscas (acertos e erros), troca de valor e remocoes. Resumo: len, soma dos achados e acertos.

proc main() {
    var m = make(map[int]int, alloc = heap, cap = 16)
    defer delete(m)
    var achados = 0
    var soma = 0
    for rodada in 0..<20 {
        for i in 0..<100000 {
            insert(&m, key = i * 13 + rodada, value = i + rodada)
        }
        for i in 0..<200000 {
            let v = get(m, key = i * 7 + rodada) or_else -1
            if v >= 0 {
                achados += 1
                soma = (soma + v) % 1000000007
            }
        }
        for i in 0..<50000 {
            remove(&m, key = i * 26 + rodada)
        }
    }
    print(len(m))
    print(soma)
    print(achados)
}
