// matmul.fj - bench O0c (estilo jogo): multiplicacao de matrizes 48x48 de int em arrays planos, laco aninhado de 3 niveis; cada rodada usa o resultado da anterior. Resumo: soma de todas as celulas (mod) e as duas ultimas celulas da matriz final.

const LADO: int = 48
const TAMANHO: int = 2304
const MODULO: int = 1000003
const RODADAS: int = 2000

proc preencher(m: ^[2304]int, semente: int) {
    var estado = semente
    for i in 0..<TAMANHO {
        estado = (estado * 1103515245 + 12345) % 2147483648
        m^[i] = (estado / 65536) % 101
    }
}

proc multiplicar(a: ^[2304]int, b: ^[2304]int, c: ^[2304]int) {
    for i in 0..<LADO {
        for j in 0..<LADO {
            var soma = 0
            for k in 0..<LADO {
                soma += a^[i * LADO + k] * b^[k * LADO + j]
            }
            c^[i * LADO + j] = soma % MODULO
        }
    }
}

proc main() {
    var a: [2304]int = {}
    var b: [2304]int = {}
    var c: [2304]int = {}
    preencher(&a, semente = 3)
    preencher(&b, semente = 11)
    var soma_total = 0
    for rodada in 0..<RODADAS {
        multiplicar(&a, &b, &c)
        for i in 0..<TAMANHO {
            a[i] = (c[i] + rodada) % 101
            soma_total = (soma_total + c[i]) % MODULO
        }
    }
    print(soma_total)
    print(c[0])
    print(c[TAMANHO - 1])
}
