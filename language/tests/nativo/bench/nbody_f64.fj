// nbody_f64.fj - bench P18 (2b): 5 corpos em f64 (struct em array), forcas aos pares com raiz quadrada por Newton. Resumo: energia cinetica e posicao x do corpo 0, x 1e6 truncados.

struct Corpo {
    x: f64 = 0.0
    y: f64 = 0.0
    z: f64 = 0.0
    vx: f64 = 0.0
    vy: f64 = 0.0
    vz: f64 = 0.0
    m: f64 = 1.0
}

proc raiz(v: f64) -> f64 {
    var r = (v + 1.0) * 0.5
    for k in 0..<6 {
        r = (r + v / r) * 0.5
    }
    return r
}

proc avancar(c: ^[5]Corpo, dt: f64) {
    for i in 0..<5 {
        for j in (i + 1)..<5 {
            let dx = c^[i].x - c^[j].x
            let dy = c^[i].y - c^[j].y
            let dz = c^[i].z - c^[j].z
            let d2 = dx * dx + dy * dy + dz * dz + 0.01
            let d = raiz(d2)
            let mag = dt / (d2 * d)
            c^[i].vx = c^[i].vx - dx * c^[j].m * mag
            c^[i].vy = c^[i].vy - dy * c^[j].m * mag
            c^[i].vz = c^[i].vz - dz * c^[j].m * mag
            c^[j].vx = c^[j].vx + dx * c^[i].m * mag
            c^[j].vy = c^[j].vy + dy * c^[i].m * mag
            c^[j].vz = c^[j].vz + dz * c^[i].m * mag
        }
    }
    for i in 0..<5 {
        c^[i].x = c^[i].x + dt * c^[i].vx
        c^[i].y = c^[i].y + dt * c^[i].vy
        c^[i].z = c^[i].z + dt * c^[i].vz
    }
}

proc energia(c: ^[5]Corpo) -> f64 {
    var e: f64 = 0.0
    for i in 0..<5 {
        e = e + 0.5 * c^[i].m * (c^[i].vx * c^[i].vx + c^[i].vy * c^[i].vy + c^[i].vz * c^[i].vz)
    }
    return e
}

proc main() {
    var c: [5]Corpo = {}
    c[0] = Corpo{x = 0.0, y = 0.0, z = 0.0, vx = 0.0, vy = 0.0, vz = 0.0, m = 40.0}
    c[1] = Corpo{x = 4.8, y = -1.1, z = -0.1, vx = 0.6, vy = 2.8, vz = -0.02, m = 0.9}
    c[2] = Corpo{x = 8.3, y = 4.1, z = -0.4, vx = -1.0, vy = 1.8, vz = 0.008, m = 0.28}
    c[3] = Corpo{x = 12.8, y = -15.1, z = -0.22, vx = 1.08, vy = 0.86, vz = -0.01, m = 0.04}
    c[4] = Corpo{x = 15.4, y = -25.9, z = 0.18, vx = 0.97, vy = 0.59, vz = -0.03, m = 0.05}
    for passo in 0..<400000 {
        avancar(&c, dt = 0.001)
    }
    print((energia(&c) * 1000000.0) as int)
    print((c[0].x * 1000000.0) as int)
}
