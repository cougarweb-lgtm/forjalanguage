// ordenacao.fj - bench O0c (estilo jogo): sort, sort_by e heap sobre [dynamic]int de valores pseudo-aleatorios por LCG fixo; confere a ordem e a soma. Resumo: pares fora de ordem (deve ser 0), soma e extremos de cada forma.

const QTD: int = 60000
const RODADAS: int = 10
const MODULO: int = 1000003

proc maior_primeiro(a: ^int, b: ^int) -> bool {
    return a^ > b^
}

proc proximo(estado: int) -> int {
    return (estado * 1103515245 + 12345) % 2147483648
}

proc conta_fora_de_ordem(l: []int) -> int {
    var fora = 0
    for i in 0..<len(l) - 1 {
        if l[i] > l[i + 1] {
            fora += 1
        }
    }
    return fora
}

proc conta_fora_de_ordem_desc(l: []int) -> int {
    var fora = 0
    for i in 0..<len(l) - 1 {
        if l[i] < l[i + 1] {
            fora += 1
        }
    }
    return fora
}

proc main() {
    var l = make([dynamic]int, alloc = heap)
    defer delete(l)
    var h = make([dynamic]int, alloc = heap)
    defer delete(h)
    var estado = 99
    var fora_sort = 0
    var fora_sort_by = 0
    var fora_heap = 0
    var soma_total = 0
    for rodada in 0..<RODADAS {
        clear(&l)
        for i in 0..<QTD {
            estado = proximo(estado)
            append(&l, item = (estado / 65536) % MODULO)
        }
        sort(l[..])
        fora_sort += conta_fora_de_ordem(l[..])
        soma_total = (soma_total + sum(l[..])) % MODULO
        sort_by(l[..], less = maior_primeiro)
        fora_sort_by += conta_fora_de_ordem_desc(l[..])
        soma_total = (soma_total + l[0] + l[QTD - 1]) % MODULO
        clear(&h)
        for i in 0..<QTD {
            heap_push(&h, l[i])
        }
        var anterior = -1
        for i in 0..<QTD {
            let topo = heap_pop(&h) or_else 0
            if topo < anterior {
                fora_heap += 1
            }
            anterior = topo
        }
        soma_total = (soma_total + rodada) % MODULO
    }
    print(fora_sort)
    print(fora_sort_by)
    print(fora_heap)
    print(soma_total)
}
