// v1.11 L12a (A04): conta elemento a elemento em [N]T inteiro (i32, int, u8) nos dois backends; divisao por zero da 0 por elemento.
proc main() {
    let v: [2]i32 = {7, 9}
    let zero: i32 = 0
    let div = v / zero
    let meio = v / 2
    let menos = -v
    print(f"{div[0]} {div[1]} {meio[0]} {meio[1]} {menos[0]} {menos[1]}")
    let bytes: [3]u8 = {10, 20, 30}
    let tres = bytes * 3 + bytes
    print(f"{tres[0]} {tres[1]} {tres[2]}")
    let largos: [2]int = {10000000000, 3}
    let soma = largos + largos
    let resto = soma - largos * 2
    print(f"{soma[0]} {soma[1]} {resto[0]} {resto[1]}")
}
