// v1.11 L12b (A04): swizzle nos dois backends: v.x, v.x =, &v.x, v.x +=, v.zyx, v.xx, c.bgra, em f32, i32 e u8; o indice e constante provado (sem R0006).
proc cria() -> [3]f32 {
    print("cria")
    return {1.0, 2.0, 3.0}
}

proc main() {
    var v: [3]f32 = {1.5, 2.5, 3.5}
    v.x = 4.0
    v.y += 0.5
    v.z = v.z - 1.0
    let p = &v.x
    p^ = 9.0
    let invertido = v.zyx
    let repetido = v.xx
    print(f"{v.x} {v.y} {v.z} {invertido[0]} {invertido[1]} {invertido[2]} {repetido[1]}")
    let c = cria().zyx
    print(f"{c[0]} {c[1]} {c[2]}")
    var cor: [4]f32 = {0.25, 0.5, 0.75, 1.0}
    cor.a = 0.5
    let bgra = cor.bgra
    print(f"{bgra[0]} {bgra[1]} {bgra[2]} {bgra[3]}")
    var inteiros: [4]i32 = {10, 20, 30, 40}
    inteiros.w -= 1
    let wz = inteiros.wz
    print(f"{wz[0]} {wz[1]} {inteiros.x}")
    var bytes: [2]u8 = {200, 7}
    bytes.y += 1
    let yx = bytes.yx
    print(f"{yx[0]} {yx[1]}")
}
