// v1.11 L12a (A04): conta elemento a elemento em [N]T de f32 e de unidade nos dois backends: + - * / entre arrays, por escalar, -a, += e -=.
unit Metros: f32

proc main() {
    let a: [3]f32 = {1.5, 2.5, 4.0}
    let b: [3]f32 = {0.5, 0.5, 2.0}
    let s = a + b
    let p = a * b
    let q = a / b
    let r = 2 * a - b
    let n = -a
    print(f"{s[0]} {s[1]} {s[2]} {p[0]} {p[1]} {p[2]} {q[0]} {q[1]} {q[2]} {r[2]} {n[1]}")
    let d: [2]Metros = {1.5, 2.5}
    let e = d * 2.0 + d
    print(f"{e[0]} {e[1]}")
    var acumulado: [3]f32 = {0.0, 0.0, 0.0}
    acumulado += a * 0.5
    acumulado -= b
    let medio: [3]f32 = (acumulado + a) / 2.0
    print(f"{acumulado[0]} {acumulado[1]} {acumulado[2]} {medio[0]} {medio[2]}")
}
