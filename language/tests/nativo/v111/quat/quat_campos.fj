// v1.11 L14a (A05): campos x, y, z, w de quat que leem e gravam (var, campo de struct, ponteiro) e quat dentro de struct, nos dois backends.
struct Corpo {
    giro: quat
    massa: f32
}

proc gira_x(p: ^quat, graus: f32) {
    p^.x = p^.x + graus
}

proc main() {
    var q = quat{y = 2.0, w = 1.0}
    q.x = 5.0
    q.z = q.x * 2.0
    gira_x(&q, graus = 0.5)
    print(f"{q.x} {q.y} {q.z} {q.w}")
    var c = Corpo{giro = conj(q), massa = 2.0}
    c.giro.w = c.giro.w + c.massa
    c.giro = c.giro * c.massa
    print(f"{c.giro.x} {c.giro.y} {c.giro.z} {c.giro.w} {c.massa}")
    let lista: [2]quat = {quat{x = 1.0}, quat{y = 2.0}}
    let soma = lista[0] + lista[1]
    print(f"{soma.x} {soma.y} {soma.z} {soma.w}")
}
