// v1.11 L14a (A05): quat nos dois backends: literal (campo omitido = 0.0), q + r, q - r, -q, q * k, k * q, conj(q), quat em parametro e retorno.
proc dobro(q: quat) -> quat {
    return q * 2.0
}

proc main() {
    let identidade = quat{w = 1.0}
    let q = quat{x = 1.0, y = 2.0, z = 3.0, w = 4.0}
    let r = quat{x = 0.5, y = 0.25, z = 0.125, w = 0.0625}
    let s = q + r
    let d = q - r
    let n = -q
    let k: f32 = 3.0
    let a = q * k
    let b = 0.5 * q
    let c = conj(q)
    print(f"{s.x} {s.y} {s.z} {s.w} {d.x} {d.y} {d.z} {d.w}")
    print(f"{n.x} {n.y} {n.z} {n.w} {a.x} {a.y} {a.z} {a.w}")
    print(f"{b.x} {b.y} {b.z} {b.w} {c.x} {c.y} {c.z} {c.w}")
    let e = dobro(r) + identidade
    print(f"{e.x} {e.y} {e.z} {e.w}")
}
