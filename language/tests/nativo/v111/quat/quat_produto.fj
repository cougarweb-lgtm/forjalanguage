// v1.11 L14b (A05): q * r (Hamilton, QuaternionMultiply do raymath) e abs(q) nos dois backends: i*j = k, identidade, conj(q) * q, associatividade e a norma (bits).
proc bits(x: f32) -> u32 {
    return transmute(x, to = u32)
}

proc mostra(nome: str, q: quat) {
    print(f"{nome} {q.x} {q.y} {q.z} {q.w}")
}

proc compoe(a: quat, b: quat) -> quat {
    return a * b
}

proc main() {
    let um = quat{w = 1.0}
    let i = quat{x = 1.0}
    let j = quat{y = 1.0}
    let k = quat{z = 1.0}
    mostra("i*j", q = i * j)
    mostra("j*i", q = j * i)
    mostra("j*k", q = j * k)
    mostra("k*i", q = k * i)
    mostra("i*i", q = i * i)
    let q = quat{x = 1.0, y = 2.0, z = 3.0, w = 4.0}
    let r = quat{x = 0.5, y = 0.25, z = 0.125, w = 0.0625}
    mostra("1*q", q = um * q)
    mostra("q*1", q = q * um)
    mostra("q*r", q = compoe(q, b = r))
    mostra("r*q", q = r * q)
    mostra("(q*r)*i", q = (q * r) * i)
    mostra("q*(r*i)", q = q * (r * i))
    mostra("conj*q", q = conj(q) * q)
    print(abs(q) * abs(q) > 29.99)
    let tres_quatro = quat{x = 3.0, y = 4.0}
    let zero = quat{}
    print(f"{bits(abs(um))} {bits(abs(tres_quatro))} {bits(abs(zero))} {bits(abs(q))} {bits(abs(-q))}")
    let a = q * r + conj(r)
    print(f"{bits(a.x)} {bits(a.y)} {bits(a.z)} {bits(a.w)}")
}
