// modos: teste
// queda_ponteiro.fj - L16b: o teste do meio le por um ponteiro nulo que escapou do R0005 (o 'as ^^i32' sobre o endereco de um u64 zerado entrega um ^i32 nulo sem checar):
// a leitura derruba o processador (acesso a memoria invalida) e o executor responde R0011 com o titulo, marca o teste como falho e roda o seguinte.
// Linhas-chave: stdout "ok   antes" "FALHOU ponteiro nulo" "ok   depois" "3 testes, 1 falharam"; stderr R0011 "o teste \"ponteiro nulo\" causou uma excecao do processador: acesso a memoria invalida"; exit 1.

proc main() {
    print(0)
}

test "antes" {
    expect(1 == 1)
}

test "ponteiro nulo" {
    var bits: u64 = 0
    let pp = (&bits as rawptr) as ^^i32
    let p = pp^
    expect(p^ == 1)
}

test "depois" {
    expect(2 == 2)
}
