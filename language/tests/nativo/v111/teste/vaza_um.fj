// modos: teste
// vaza_um.fj - L16b: 1 de 3 testes deixa um bloco de heap vivo (o criar entrega o new e o teste nao o libera): em dev o teste "vaza" FALHOU com a linha R0009 do new
// (linha 11); os vizinhos passam e o fim do programa nao repete o R0009 (o rastreador esqueceu o bloco).
// Linhas-chave: stdout "ok   limpo" "FALHOU vaza" "ok   depois" "3 testes, 1 falharam"; stderr R0009 "vazamento: 1 blocos (4 bytes) alocados aqui seguem vivos no fim do teste"; exit 1.

struct Caixa {
    valor: i32 = 7
}

proc criar() -> ^Caixa {
    return new(Caixa, alloc = heap)
}

proc main() {
    print(0)
}

test "limpo" {
    let c = criar()
    expect(c.valor == 7)
    delete(c)
}

test "vaza" {
    let c = criar()
    expect(c.valor == 7)
}

test "depois" {
    let c = criar()
    delete(c)
    expect(1 == 1)
}
