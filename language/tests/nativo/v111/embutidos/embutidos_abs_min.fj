// modos: dev
// v1.11 L13 (A13): abs do menor inteiro trava em dev com R0002 "subtracao" (0 - x pelo SUB checado); em release da o proprio minimo, indefinido aqui.
proc minimo() -> i32 {
    return -2147483647 - 1
}

proc main() {
    print(abs(-5))
    let m = minimo()
    print(m)
    print(abs(m))
}
