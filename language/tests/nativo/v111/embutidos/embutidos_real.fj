// v1.11 L13 (A13): min, max, clamp e abs de f32 e f64 nos dois backends, com NaN, inf e -0.0 (os bits dizem o resultado exato), unidade e [3]f32 por elemento.
unit Metros: f32

proc bits(x: f32) -> u32 {
    return transmute(x, to = u32)
}

proc bits64(x: f64) -> u64 {
    return transmute(x, to = u64)
}

proc main() {
    let zero: f32 = 0.0
    let um: f32 = 1.0
    let nan = zero / zero
    let inf = um / zero
    let neg0 = -zero
    print(f"{bits(min(neg0, b = zero))} {bits(min(zero, b = neg0))} {bits(max(neg0, b = zero))} {bits(max(zero, b = neg0))}")
    print(f"{bits(min(inf, b = um))} {bits(max(-inf, b = um))} {bits(abs(-inf))} {bits(abs(neg0))} {bits(abs(-um))}")
    let n1 = min(nan, b = um)
    let n2 = min(um, b = nan)
    let n3 = max(nan, b = um)
    let n4 = max(um, b = nan)
    let n5 = clamp(nan, lo = zero, hi = um)
    let n6 = abs(nan)
    print(n1 != n1)
    print(n2 == um)
    print(n3 != n3)
    print(n4 == um)
    print(n5 != n5)
    print(n6 != n6)
    print(bits(n6) < 2147483648)
    print(f"{bits(clamp(um, lo = nan, hi = nan))} {bits(clamp(inf, lo = zero, hi = um))} {bits(clamp(-inf, lo = zero, hi = um))}")

    let d0: f64 = 0.0
    let d1: f64 = 1.0
    let dneg0 = -d0
    let dinf = d1 / d0
    print(f"{bits64(min(dneg0, b = d0))} {bits64(max(d0, b = dneg0))} {bits64(abs(dneg0))} {bits64(abs(-dinf))} {bits64(clamp(d1 + d1, lo = d0, hi = d1))}")

    let dist: Metros = 12.5
    let lim = min(dist, b = 10.0)
    let alto = max(dist, b = 20.0)
    let mod = abs(-dist)
    let preso = clamp(dist, lo = 0.0, hi = 11.0)
    print(f"{lim} {alto} {mod} {preso}")

    let v: [3]f32 = {-1.5, 2.5, 9.0}
    let w: [3]f32 = {0.0, 3.0, 4.0}
    let ve = min(v, b = w)
    let vm = max(v, b = w)
    let vc = clamp(v, lo = ve, hi = vm)
    print(f"{ve[0]} {ve[1]} {ve[2]} {vm[0]} {vm[1]} {vm[2]} {vc[0]} {vc[1]} {vc[2]}")
}
