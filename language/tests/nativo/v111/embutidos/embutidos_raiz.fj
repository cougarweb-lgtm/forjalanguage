// v1.11 L13 (A13): sqrt de f32 e de f64 nos dois backends (sqrtss/sqrtsd contra __builtin_sqrt): valores de execucao, denormal, -1 (NaN), inf e -0.0. Os bits dizem o resultado exato.
proc bits(x: f32) -> u32 {
    return transmute(x, to = u32)
}

proc bits64(x: f64) -> u64 {
    return transmute(x, to = u64)
}

proc main() {
    var passo: f32 = 0.0
    for i in 0..<8 {
        let r = sqrt(passo)
        print(f"{passo} {r} {bits(r)}")
        passo += 2.25
    }
    let zero: f32 = 0.0
    let um: f32 = 1.0
    let menor_bit: u32 = 1
    let pequeno = transmute(menor_bit, to = f32)
    let inf = um / zero
    print(f"{bits(sqrt(pequeno))} {bits(sqrt(inf))} {bits(sqrt(-zero))}")
    let nan = sqrt(-um)
    print(nan != nan)

    var q: f64 = 1.0
    for i in 0..<6 {
        print(f"{bits64(sqrt(q))}")
        q = q * 3.0
    }
    let d0: f64 = 0.0
    let d1: f64 = 1.0
    let dnan = sqrt(-d1)
    print(dnan != dnan)
    print(f"{bits64(sqrt(-d0))} {bits64(sqrt(d1 / d0))}")
    let hipotenusa = sqrt(3.0 * 3.0 + 4.0 * 4.0)
    print(hipotenusa as int)
}
