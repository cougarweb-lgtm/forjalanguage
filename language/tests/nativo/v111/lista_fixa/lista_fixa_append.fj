// v1.11 L15b (A08, E0335): lista fixa [dynamic, N]T nos dois backends: append ate cheio, copia independente, for nas 3 formas, fatia e len.
proc main() {
    var cheia: [dynamic, 4]i32 = {}
    append(&cheia, item = 1)
    append(&cheia, item = 2)
    append(&cheia, item = 3)
    append(&cheia, item = 4)
    print(f"{len(cheia)} {cheia[0]} {cheia[3]}")

    var parcial: [dynamic, 4]i32 = {}
    append(&parcial, item = 5)
    append(&parcial, item = 6)
    let copia = parcial
    append(&parcial, item = 7)
    print(f"{len(copia)} {len(parcial)} {copia[1]} {parcial[2]}")
    parcial = {}
    print(f"{len(parcial)} {len(copia)}")

    var soma = 0
    for x in cheia {
        soma += x as int
    }
    for &x in cheia {
        x^ = x^ * 3
    }
    for i, x in cheia {
        print(f"{i}:{x}")
    }
    print(soma)

    let fatia = cheia[1..<3]
    print(f"{len(fatia)} {fatia[0]}")
    let todos = cheia[..]
    print(len(todos))

    var pesos: [dynamic, 3]f32 = {}
    append(&pesos, item = 0.5)
    append(&pesos, item = -1.25)
    print(f"{len(pesos)} {pesos[1]}")
}
