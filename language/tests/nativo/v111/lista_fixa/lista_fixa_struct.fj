// v1.11 L15b (A08, E0335): lista fixa dentro de struct ([dynamic, 8]i32 como campo), copia de struct com lista, passagem por ponteiro e retorno por valor.
struct Grupo {
    ids: [dynamic, 8]i32
    nome: int
}

proc encher(n: int) -> [dynamic, 4]i32 {
    var saida: [dynamic, 4]i32 = {}
    for i in 0..<n {
        append(&saida, item = (i as i32) * 7)
    }
    return saida
}

proc somar(l: ^[dynamic, 8]i32) -> int {
    var total = 0
    for x in l {
        total += x as int
    }
    return total
}

proc main() {
    var grupo = Grupo{nome = 7}
    append(&grupo.ids, item = 5)
    append(&grupo.ids, item = 6)
    print(f"{grupo.nome} {len(grupo.ids)} {grupo.ids[1]}")

    var outro = grupo
    append(&outro.ids, item = 9)
    print(f"{len(grupo.ids)} {len(outro.ids)} {somar(&outro.ids)}")

    let feitos = encher(3)
    print(f"{len(feitos)} {feitos[0]} {feitos[2]}")
    var quatro = encher(3)
    append(&quatro, item = 1)
    print(len(quatro))
}
