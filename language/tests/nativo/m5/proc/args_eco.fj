// std:os - args(): imprime a quantidade e, de args[1] em diante, o indice, o tamanho em bytes (UTF-8) e o texto. args[0] (o caminho do exe) muda por exe e nao e impresso.
import "std:os" as sys

proc main() {
    let a = sys.args()
    print(f"n={len(a)}")
    for i, s in a {
        if i > 0 {
            print(f"[{i}] ({len(s)}) {s}")
        }
    }
}
