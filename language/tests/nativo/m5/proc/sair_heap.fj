// std:os - exit com bloco de heap vivo: em dev o fim normal do programa daria R0009 (vazamento); exit nao roda o relatorio, sai limpo com o codigo 4.
import "std:os" as sys

proc criar() -> ^int {
    let p = new(int, alloc = heap)
    return p
}

proc main() {
    let p = criar()
    p^ = 5
    print(p^)
    sys.exit(4)
}
