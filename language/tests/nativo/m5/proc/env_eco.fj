// std:os - env(): cada argumento (de args[1] em diante) e o nome de uma variavel; imprime nome, valor e tamanho em bytes, ou none se nao existe.
import "std:os" as sys

proc main() {
    let a = sys.args()
    for i, nome in a {
        if i > 0 {
            let v = sys.env(nome)
            switch x in v {
            case str:
                print(f"{nome}=<{x}> ({len(x)})")
            case none:
                print(f"{nome}=none")
            }
        }
    }
}
