// std:arquivo - erros. S3 P5b-1: FileError ganha already_exists, is_directory, not_directory, not_empty, closed e unsupported (um caso cada, para o switch continuar exaustivo). Uso: erros r <caminho> (read_all) ou erros w <caminho> (write_all de 3 bytes). Imprime "<resultado> <bytes lidos>": ok, not_found, no_permission ou other.
import "std:os" as sys
import "std:file" as fs

proc descrever(erro: ?fs.FileError) -> str {
    var texto: str = "ok"
    switch e in erro {
    case fs.FileError:
        switch e {
        case fs.FileError.not_found:
            texto = "not_found"
        case fs.FileError.no_permission:
            texto = "no_permission"
        case fs.FileError.other:
            texto = "other"
        case fs.FileError.already_exists:
            texto = "already_exists"
        case fs.FileError.is_directory:
            texto = "is_directory"
        case fs.FileError.not_directory:
            texto = "not_directory"
        case fs.FileError.not_empty:
            texto = "not_empty"
        case fs.FileError.closed:
            texto = "closed"
        case fs.FileError.unsupported:
            texto = "unsupported"
        case fs.FileError.locked:
            texto = "locked"
        }
    case none:
        texto = "ok"
    }
    return texto
}

proc main() {
    let a = sys.args()
    if len(a) != 3 {
        print("uso: r|w caminho")
        sys.exit(2)
    }
    if a[1] == "r" {
        switch dados in fs.read_all(a[2], alloc = heap) {
        case [dynamic]u8:
            print(f"ok {len(dados)}")
            delete(dados)
        case fs.FileError:
            print(f"{descrever(dados)} 0")
        }
    } else {
        var tres: [3]u8 = {1, 2, 3}
        let erro = fs.write_all(a[2], data = tres[..])
        print(f"{descrever(erro)} 0")
    }
}
