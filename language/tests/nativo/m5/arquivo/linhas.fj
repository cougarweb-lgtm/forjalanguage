// std:file.read_lines (IA1-L6, L-07) - imprime o numero de linhas do arquivo e cada linha entre colchetes; "erro" se nao abriu. LF e CRLF fecham a linha; a ultima sem fim de linha vale.
import "std:os" as sys
import "std:file" as fs

proc main() {
    let a = sys.args()
    switch r in fs.read_lines(a[1], alloc = heap) {
    case fs.Lines:
        print(len(r.items))
        for linha in r.items {
            print(f"[{linha}]")
        }
        delete(r.items)
        delete(r.data)
    case fs.FileError:
        print("erro")
    }
}
