// std:arquivo - copia entrada -> saida por read_all/write_all, le a saida de volta e confere byte a byte. Imprime o tamanho lido e se as duas listas sao iguais.
import "std:os" as sys
import "std:file" as fs

proc ler_ou_sair(caminho: str) -> [dynamic]u8 {
    switch dados in fs.read_all(caminho, alloc = heap) {
    case [dynamic]u8:
        return dados
    case fs.FileError:
        print("erro de leitura")
        sys.exit(3)
    }
    return make([dynamic]u8, alloc = heap)
}

proc main() {
    let a = sys.args()
    if len(a) != 3 {
        print("uso: entrada saida")
        sys.exit(2)
    }
    var entrada = ler_ou_sair(a[1])
    let erro = fs.write_all(a[2], data = entrada[..])
    if erro != none {
        print("erro de escrita")
        sys.exit(4)
    }
    var saida = ler_ou_sair(a[2])
    var iguais = len(entrada) == len(saida)
    if iguais {
        for i in 0..<len(entrada) {
            if entrada[i] != saida[i] {
                iguais = false
                break
            }
        }
    }
    print(f"n={len(saida)} iguais={iguais}")
    delete(entrada)
    delete(saida)
}
