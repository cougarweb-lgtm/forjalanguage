// std:arquivo - posse: read_all devolve a lista dona; esquecer o delete e R0009 em dev (exit 101) e passa em release (nao rastreia).
import "std:os" as sys
import "std:file" as fs

proc main() {
    let a = sys.args()
    if len(a) != 2 {
        print("uso: caminho")
        sys.exit(2)
    }
    switch dados in fs.read_all(a[1], alloc = heap) {
    case [dynamic]u8:
        print(f"n={len(dados)}")
    case fs.FileError:
        print("erro de leitura")
    }
}
