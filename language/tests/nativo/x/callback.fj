// callback.fj - proc da Forja passado a foreign (qsort) fica fora do backend nativo (X0001, marco M2): o X0001 aponta a chamada.

foreign {
    proc qsort(base: rawptr, n: u64, tamanho: u64, comparar: proc(a: rawptr, b: rawptr) -> i32)
}

proc igual(a: rawptr, b: rawptr) -> i32 {
    return 0
}

proc main() {
    var v: [2]i32 = {2, 1}
    qsort(&v[0] as rawptr, n = 2, tamanho = 4, comparar = igual)
}
