// foreign_x0105.fj - 'link' que acha uma import library de 32 bits (fx_lib32.lib ao lado deste arquivo): X0105 "biblioteca de 32 bits".
// fx_lib32.lib e artefato versionado, gerado com o dlltool para i386 (so cabecalhos; nao tem DLL nem codigo):
//   dlltool -m i386 --as-flags=--32 -d fx_lib32.def -D fx_lib32.dll -l fx_lib32.lib      (fx_lib32.def: "LIBRARY fx_lib32.dll" / "EXPORTS" / "    fx_soma")
// sha256 de fx_lib32.lib: c9047e656084d0e4c9e261f88764d1115a919a8afa416818dcacac5bc321dd7e

foreign {
    link "fx_lib32"
    proc fx_soma(a: i32, b: i32) -> i32
}

proc main() {
    print(fx_soma(1, b = 2))
}
