// resultado.fj - T ! E com or_else: ate o M2 P11b era X0001 no backend nativo; desde o P12a o x64 roda e imprime 6 (o verificar_cli confere x64 igual ao C).

enum Erro { zero }

proc dividir(a: int, b: int) -> int ! Erro {
    if b == 0 {
        return Erro.zero
    }
    return a + b
}

proc main() {
    print(dividir(4, b = 2) or_else -1)
}
