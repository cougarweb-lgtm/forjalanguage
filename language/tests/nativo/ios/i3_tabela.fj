// I3: tabelas const com texto e proc (ponteiros absolutos que o ligador do Mach-O precisa traduzir em rebase) + os.error_text do errno.
import "std:os"

const NOMES: [3]str = {"zero", "um", "dois"}

proc dobro(x: int) -> int {
    return x * 2
}

proc triplo(x: int) -> int {
    return x * 3
}

struct Op {
    f: proc(x: int) -> int
}

const OPS: [2]Op = {Op{f = dobro}, Op{f = triplo}}

proc main() {
    var total: int = 0
    for i in 0..<2 {
        total += OPS[i].f(i + 5)
    }
    print(f"{NOMES[2]} {total}")
    let t = os.error_text(2, alloc = heap)
    defer delete(t)
    print(t)
}
