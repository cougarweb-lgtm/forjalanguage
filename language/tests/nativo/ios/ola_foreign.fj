// I2: write(1, "ola\n", 4) e exit pela libSystem; sai com 7 se o write devolveu 4 (o stdout "ola" e o exit 7 sao o esperado).
foreign {
    link "c"
    proc escrever = "write"(fd: i32, texto: cstr, n: int) -> int
    proc sair = "exit"(codigo: i32)
}

proc main() {
    let n = escrever(1, "ola\n", 4)
    if n == 4 {
        sair(7)
    }
    sair(1)
}
