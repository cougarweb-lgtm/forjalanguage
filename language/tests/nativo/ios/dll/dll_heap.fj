// I5: dylib iOS que usa o heap do runtime (carga preguicosa, sem entrada). heap_soma(n) = n*(n+1)/2 (heap_soma(10) = 55); heap_mapa(n) conta chaves distintas de um map no heap (heap_mapa(7) = 7).
proc main() {
}

pub export proc heap_soma(n: i32) -> i32 {
    var l = make([dynamic]int, alloc = heap)
    defer delete(l)
    for i in 1..=(n as int) {
        append(&l, item = i)
    }
    return (sum(l[..]) as i32)
}

pub export proc heap_mapa(n: i32) -> i32 {
    var m = make(map[int]int, alloc = heap)
    defer delete(m)
    for i in 0..<(n as int) {
        insert(&m, key = i * 3, value = i)
        insert(&m, key = i * 3, value = i + 1)
    }
    return (len(m) as i32)
}
