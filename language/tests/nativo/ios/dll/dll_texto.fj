// I5: dylib iOS que devolve cstr: ola_texto(n) = "ola 7 x=007" para n = 7 (o host libera com forja_liberar); tamanho_texto(n) devolve o strlen esperado sem alocar (11 para n = 7).
proc main() {
}

pub export proc ola_texto(n: i32) -> cstr {
    return format_c(f"ola {n} x={n:03}", alloc = heap)
}

pub export proc tamanho_texto(n: i32) -> i32 {
    return 10 + (n / 10) * 0 + 1
}
