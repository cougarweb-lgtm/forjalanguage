// I5: dylib iOS so com aritmetica (sem heap). soma(a,b) = a+b; fatorial(n) = n! em i64 (fatorial(10) = 3628800); contar(n) soma 1..n por laco (contar(100) = 5050).
proc main() {
}

pub export proc soma(a: i32, b: i32) -> i32 {
    return a + b
}

pub export proc fatorial(n: i32) -> i64 {
    var r: i64 = 1
    for i in 1..=(n as i64) {
        r = r * i
    }
    return r
}

pub export proc contar(n: i32) -> i32 {
    var s: i32 = 0
    for i in 1..=n {
        s += i
    }
    return s
}
