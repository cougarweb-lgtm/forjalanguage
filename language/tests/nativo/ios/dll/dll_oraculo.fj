// I5: ORACULO dos dylibs iOS (dll_aritmetica, dll_heap, dll_texto): os mesmos procs como funcoes comuns, chamados por um main que imprime no formato do host.c do CI.
// Compilar para x86_64-linux e rodar no WSL (alpine-build): a saida e o .esperado.stdout dos 3 casos (aritmetica, heap, texto).
proc soma(a: i32, b: i32) -> i32 {
    return a + b
}

proc fatorial(n: i32) -> i64 {
    var r: i64 = 1
    for i in 1..=(n as i64) {
        r = r * i
    }
    return r
}

proc contar(n: i32) -> i32 {
    var s: i32 = 0
    for i in 1..=n {
        s += i
    }
    return s
}

proc heap_soma(n: i32) -> i32 {
    var l = make([dynamic]int, alloc = heap)
    defer delete(l)
    for i in 1..=(n as int) {
        append(&l, item = i)
    }
    return (sum(l[..]) as i32)
}

proc heap_mapa(n: i32) -> i32 {
    var m = make(map[int]int, alloc = heap)
    defer delete(m)
    for i in 0..<(n as int) {
        insert(&m, key = i * 3, value = i)
        insert(&m, key = i * 3, value = i + 1)
    }
    return (len(m) as i32)
}

proc ola_texto(n: i32) -> cstr {
    return format_c(f"ola {n} x={n:03}", alloc = heap)
}

proc tamanho_texto(n: i32) -> i32 {
    return 10 + (n / 10) * 0 + 1
}

proc main() {
    print("== aritmetica")
    print(f"soma(2,3)={soma(2, 3)}")
    print(f"soma(-7,10)={soma(-7, 10)}")
    print(f"fatorial(10)={fatorial(10)}")
    print(f"contar(100)={contar(100)}")
    print("== heap")
    print(f"heap_soma(10)={heap_soma(10)}")
    print(f"heap_soma(1000)={heap_soma(1000)}")
    print(f"heap_mapa(7)={heap_mapa(7)}")
    print("== texto")
    let t = ola_texto(7)
    print(f"ola_texto(7)={t as str}")
    print(f"tamanho_texto(7)={tamanho_texto(7)}")
    delete(t)
}
