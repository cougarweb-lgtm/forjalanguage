// I3: std:file no iOS (openat/write/read/fstat/close/unlinkat da libSystem): grava e le um arquivo na pasta temporaria (TMPDIR ou /tmp).
import "std:os"
import "std:file"

proc main() {
    let pasta = os.env("TMPDIR") or_else "/tmp"
    let caminho = format(f"{pasta}/forja_i3_arquivo.txt", alloc = heap)
    defer delete(caminho)
    let texto: str = "ola arquivo\nsegunda linha\n"
    let falha = file.write_all(caminho, data = as_bytes(texto))
    if falha != none {
        print("falha ao gravar")
        os.exit(2)
    }
    switch r in file.read_all(caminho, alloc = heap) {
    case [dynamic]u8:
        print(len(r))
        let texto_lido = from_bytes(r[..], alloc = heap)
        print(texto_lido)
        delete(texto_lido)
        delete(r)
    case file.FileError:
        print("falha ao ler")
        os.exit(3)
    }
}
