// I3: heap (new/make/append/delete) e texto formatado no runtime a64 do iOS (mmap pela libSystem).
struct Bala {
    dano: int = 3
}

proc main() {
    let b = new(Bala, alloc = heap)
    defer delete(b)
    var l = make([dynamic]int, alloc = heap, cap = 2)
    defer delete(l)
    for i in 0..<1000 {
        append(&l, item = i)
    }
    let s = format(f"soma={sum(l[..])} dano={b.dano} n={len(l)}", alloc = heap)
    defer delete(s)
    print(s)
}
