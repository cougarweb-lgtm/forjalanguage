// minidump_3niveis.fj - P78 (M6b): main -> nivel2 -> nivel3 -> Sleep (kernel32, por foreign).
// O verificar_pdb.py --modo minidump congela o processo dentro do Sleep e anda a pilha .fj (StackWalk64).
// Esperado (topo = quem chama o Sleep): minidump_3niveis.esperado.
// Build: forja build --simbolos sim --debug-code linhas,json <este.fj> -o <tmp>\x.exe

foreign {
    link "kernel32"
    proc c_sleep = "Sleep"(ms: u32)
}

proc nivel3(a: int) -> int {
    print(a)
    c_sleep(60000 as u32)
    return a
}

proc nivel2(a: int) -> int {
    return nivel3(a + 1)
}

proc main() {
    print(nivel2(1))
}
