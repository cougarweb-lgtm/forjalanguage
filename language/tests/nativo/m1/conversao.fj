// conversao.fj - conversoes checadas entre i32, int e uint dentro da faixa do destino.

proc main() {
    let a: int = 300
    let b: i32 = a as i32
    let c: uint = a as uint
    let d: int = b as int
    let e: i32 = c as i32
    print(b)
    print(c)
    print(d + 1)
    print(e - 1)
    let g: i32 = -7
    let h: int = g as int
    print(h)
    print((h * 2) as i32)
    let u: uint = 4294967295
    print(u as int)
}
