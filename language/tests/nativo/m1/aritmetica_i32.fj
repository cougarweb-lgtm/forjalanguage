// aritmetica_i32.fj - soma, subtracao, multiplicacao e negacao em i32, dentro da faixa.

proc main() {
    let a: i32 = 2000000000
    let b: i32 = -1000
    print(a + b)
    print(a - b)
    print(b * 2000)
    print(-b)
    var acc: i32 = 0
    acc += a
    acc -= 1
    acc = acc * 1
    print(acc)
    print(-2147483647)
}
