// lacos.fj - for exclusivo e inclusivo, o limite superior de i32 sem estouro, while, break e continue aninhados.

proc main() {
    var total = 0
    for i in 0..<5 {
        total += i
    }
    print(total)

    var cont = 0
    for i in 2147483645..=2147483647 {
        print(i)
        cont += 1
    }
    print(cont)

    var ate_o_topo = 0
    for i in 0..=2147483647 {
        if i == 3 {
            break
        }
        ate_o_topo += 1
    }
    print(ate_o_topo)

    var mistura = 0
    for i in 0..<4 {
        for j in 0..<4 {
            if j == 2 {
                continue
            }
            if j == 3 {
                break
            }
            mistura += i * 10 + j
        }
    }
    print(mistura)

    var n = 0
    var pares = 0
    while n < 10 {
        n += 1
        if n == 4 {
            continue
        }
        if n == 7 {
            break
        }
        pares += n
    }
    print(n)
    print(pares)

    let topo: i32 = 2147483647
    var k: i32 = topo - 2
    var voltas = 0
    while k < topo {
        k += 1
        voltas += 1
    }
    print(k)
    print(voltas)
}
