// aritmetica_i64.fj - soma, subtracao, multiplicacao e negacao em int (64 bits), sem estouro.

proc main() {
    let a: int = 1000000007
    let b: int = -42
    print(a + b)
    print(a - b)
    print(b * 3)
    print(-a)
    print(a * 2 + b * 5 - 7)
    var acc: int = 0
    acc += a
    acc -= 100
    acc = acc * 4
    print(acc)
    print(4000000000 * 1000)
}
