// chamadas.fj - procs com 6 e 8 parametros, argumentos nomeados, retorno vazio e fib(25) recursivo.

proc soma6(a: int, b: int, c: int, d: int, e: int, f: int) -> int {
    return a + b + c + d + e + f
}

proc soma8(a: i32, b: i32, c: i32, d: i32, e: i32, f: i32, g: i32, h: i32) -> i32 {
    return a + b + c + d + e + f + g + h
}

proc mostra(x: int, marca: bool) {
    if marca {
        print(x)
    }
    return
}

proc fib(n: int) -> int {
    if n < 2 {
        return n
    }
    return fib(n - 1) + fib(n - 2)
}

proc main() {
    print(soma6(1, b = 2, c = 3, d = 4, e = 5, f = 6))
    print(soma6(1, b = 2, c = 3, d = 4, e = 5, f = 60))
    print(soma8(1, b = 2, c = 3, d = 4, e = 5, f = 6, g = 7, h = 8))
    print(soma8(10, b = 20, c = 30, d = 40, e = 50, f = 60, g = 70, h = 80))
    mostra(99, marca = true)
    mostra(0, marca = false)
    print(fib(25))
}
