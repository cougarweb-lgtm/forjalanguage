// bool.fj - e, ou, nao e comparacoes que produzem bool.

proc main() {
    let t: bool = true
    let f: bool = false
    print(t)
    print(f)
    print(t and f)
    print(t or f)
    print(not t)
    print(not f and t)
    print((3 < 4) and (5 >= 5))
    print((2 == 3) or (1 != 1))
    print(not (7 <= 6))
    print(f or not f)
}
