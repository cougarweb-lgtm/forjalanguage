// uint.fj - inteiro sem sinal no limite superior de 64 bits e operacoes dentro da faixa.

proc main() {
    let m: uint = 18446744073709551615
    let z: uint = 0
    print(m)
    print(m - 1)
    print(z + 5)
    print(m == 18446744073709551615)
    print(m > z)
    print(z < 1)
    var k: uint = 10
    k = k * 3
    k -= 4
    print(k)
}
