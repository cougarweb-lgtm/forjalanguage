// Oraculo de Display (P3 do marco Ryu): gera N f64 e N f32 pelo splitmix64 (semente 20261116) e imprime print(f"{x}") de cada valor finito.
// Um unico gerador: os f64 saem primeiro; os f32 continuam o mesmo fluxo depois do ultimo f64. Nao finitos (expoente todo 1) sao pulados sem contar.
// O esperado vem de conferir_display.py (numpy.format_float_positional, unique=True, trim='-').
const N: int = 1000000
const SEMENTE: u64 = 20261116
const GAMA: u64 = 0x9E3779B97F4A7C15
const MULT1: u64 = 0xBF58476D1CE4E5B9
const MULT2: u64 = 0x94D049BB133111EB

struct Gerador {
    estado: u64
}

proc proximo(g: ^Gerador) -> u64 {
    g.estado = wrapping_add(g.estado, b = GAMA)
    var z = g.estado
    z = (z ~ (z >> 30))
    z = wrapping_mul(z, b = MULT1)
    z = (z ~ (z >> 27))
    z = wrapping_mul(z, b = MULT2)
    z = (z ~ (z >> 31))
    return z
}

proc main() {
    var g = Gerador{estado = SEMENTE}
    var n = 0
    while n < N {
        let z = proximo(&g)
        if ((z >> 52) & 0x7FF) == 0x7FF {
            continue
        }
        let x = transmute(z, to = f64)
        print(f"{x}")
        n += 1
    }
    var m = 0
    while m < N {
        let z = proximo(&g)
        let bits = (z & 0xFFFFFFFF) as u32
        if ((bits >> 23) & 0xFF) == 0xFF {
            continue
        }
        let y = transmute(bits, to = f32)
        print(f"{y}")
        m += 1
    }
}
