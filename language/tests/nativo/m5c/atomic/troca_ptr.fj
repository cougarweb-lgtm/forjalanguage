// troca_ptr.fj - M5 P50: store, load, exchange, add, sub e cas em AtomicI32, e exchange, load, store e cas em AtomicPtr. Saida esperada: "troca OK".
import "std:atomic"

struct Dado {
    n: int = 0
}

proc main() {
    var a = atomic.AtomicI32{}
    atomic.store_i32(&a, 5, atomic.Ordem.release)
    let lido = atomic.load_i32(&a, atomic.Ordem.acquire)
    let antigo = atomic.exchange_i32(&a, 9, atomic.Ordem.seq_cst)
    let somado = atomic.add_i32(&a, 3, atomic.Ordem.seq_cst)
    let subtraido = atomic.sub_i32(&a, 2, atomic.Ordem.seq_cst)
    let trocou = atomic.cas_i32(&a, 10, 20, atomic.Ordem.seq_cst)
    let nao_trocou = atomic.cas_i32(&a, 10, 30, atomic.Ordem.seq_cst)
    let final = atomic.load_i32(&a, atomic.Ordem.seq_cst)

    var d1 = Dado{n = 1}
    var d2 = Dado{n = 2}
    var p = atomic.AtomicPtr{}
    atomic.store_ptr(&p, &d1 as rawptr, atomic.Ordem.release)
    let ponteiro_lido = atomic.load_ptr(&p, atomic.Ordem.acquire) as ^Dado
    let velho = atomic.exchange_ptr(&p, &d2 as rawptr, atomic.Ordem.seq_cst) as ^Dado
    let ptr_trocou = atomic.cas_ptr(&p, &d2 as rawptr, &d1 as rawptr, atomic.Ordem.seq_cst)
    let ptr_nao = atomic.cas_ptr(&p, &d2 as rawptr, &d2 as rawptr, atomic.Ordem.seq_cst)
    let ponteiro_final = atomic.load_ptr(&p, atomic.Ordem.seq_cst) as ^Dado

    if lido == 5 and antigo == 5 and somado == 9 and subtraido == 12 and trocou and not nao_trocou and final == 20 {
        if ponteiro_lido.n == 1 and velho.n == 1 and ptr_trocou and not ptr_nao and ponteiro_final.n == 1 {
            print("troca OK")
        } else {
            print("troca de ponteiro errada")
        }
    } else {
        print("troca errada")
    }
}
