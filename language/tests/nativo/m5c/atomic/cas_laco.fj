// cas_laco.fj - M5 P50: incremento por cas em laco, 6 threads x 100000, tem de dar exatamente 600000; cas com valor errado devolve false e nao muda. Saida esperada: "cas OK".
import "std:thread"
import "std:atomic"

struct Compartilhado {
    c: atomic.AtomicI64
}

proc incrementar(c: ^atomic.AtomicI64) {
    var feito = false
    while not feito {
        let v = atomic.load_i64(c, atomic.Ordem.seq_cst)
        feito = atomic.cas_i64(c, v, v + 1, atomic.Ordem.seq_cst)
    }
}

proc trabalhador(p: rawptr) -> u32 {
    let g = p as ^Compartilhado
    for _k in 0..<100000 {
        incrementar(&g.c)
    }
    return 0
}

proc main() {
    var s = Compartilhado{}
    let errado = atomic.cas_i64(&s.c, 7, 9, atomic.Ordem.seq_cst)
    let intacto = atomic.load_i64(&s.c, atomic.Ordem.seq_cst)
    var filhas = make([dynamic]thread.Thread, alloc = heap, cap = 6)
    defer delete(filhas)
    for _k in 0..<6 {
        switch t in thread.spawn(trabalhador, &s as rawptr) {
        case thread.Thread:
            append(&filhas, item = t)
        case thread.ThreadError:
            print("falhou")
        }
    }
    for t in filhas {
        _ = thread.join(t)
    }
    let total = atomic.load_i64(&s.c, atomic.Ordem.seq_cst)
    if not errado and intacto == 0 and total == 600000 {
        print("cas OK")
    } else {
        print("cas errado")
    }
}
