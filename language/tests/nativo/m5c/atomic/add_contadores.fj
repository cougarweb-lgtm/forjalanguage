// add_contadores.fj - M5 P50: 6 threads x 1000000 add(1) em AtomicI64, AtomicI32 e AtomicU64 tem de dar exatamente 6000000 cada. Saida esperada: "add OK".
import "std:thread"
import "std:atomic"

struct Contadores {
    i64c: atomic.AtomicI64
    i32c: atomic.AtomicI32
    u64c: atomic.AtomicU64
}

proc trabalhador(p: rawptr) -> u32 {
    let g = p as ^Contadores
    for _k in 0..<1000000 {
        _ = atomic.add_i64(&g.i64c, 1, atomic.Ordem.seq_cst)
        _ = atomic.add_i32(&g.i32c, 1, atomic.Ordem.seq_cst)
        _ = atomic.add_u64(&g.u64c, 1, atomic.Ordem.seq_cst)
    }
    return 0
}

proc main() {
    var s = Contadores{}
    var filhas = make([dynamic]thread.Thread, alloc = heap, cap = 6)
    defer delete(filhas)
    for _k in 0..<6 {
        switch t in thread.spawn(trabalhador, &s as rawptr) {
        case thread.Thread:
            append(&filhas, item = t)
        case thread.ThreadError:
            print("falhou")
        }
    }
    for t in filhas {
        _ = thread.join(t)
    }
    let a = atomic.load_i64(&s.i64c, atomic.Ordem.seq_cst)
    let b = atomic.load_i32(&s.i32c, atomic.Ordem.seq_cst)
    let c = atomic.load_u64(&s.u64c, atomic.Ordem.seq_cst)
    if a == 6000000 and b == 6000000 and c == 6000000 {
        print("add OK")
    } else {
        print("add errado")
    }
}
