// Fixture do std:net UDP (M5 P53): erros tipados. Porta em uso, endereco invalido (abc, porta 99999, vazio), close duplo e uso depois de close = fechado (nunca crash).
// Saida esperada: "porta_em_uso OK", "endereco OK", "fechado OK".
import "std:net" as net

proc abrir(addr: str) -> net.UdpSocket {
    switch r in net.udp_bind(addr) {
    case net.UdpSocket:
        return r
    case net.NetError:
        return net.UdpSocket{h = 0}
    }
    return net.UdpSocket{h = 0}
}

proc erro_do_bind(addr: str) -> bool {
    switch r in net.udp_bind(addr) {
    case net.UdpSocket:
        return false
    case net.NetError:
        return r == net.NetError.endereco_invalido
    }
    return false
}

// Segundo bind na mesma porta do primeiro socket: tem de dar porta_em_uso. ende = endereco do primeiro (emprestado).
proc bind_repetido(ende: str) {
    switch r in net.udp_bind(ende) {
    case net.UdpSocket:
        print("FALHA porta_em_uso: segundo bind passou")
    case net.NetError:
        if r == net.NetError.porta_em_uso {
            print("porta_em_uso OK")
        } else {
            print("FALHA porta_em_uso: outro erro")
        }
    }
}

proc main() {
    var primeiro = abrir("127.0.0.1:0")
    if primeiro.h == 0 {
        print("FALHA abrir")
        return
    }
    switch ende in net.udp_local_addr(&primeiro, heap) {
    case str:
        bind_repetido(ende)
        delete(ende)
    case net.NetError:
        print("FALHA endereco local")
    }
    if erro_do_bind("abc") and erro_do_bind("1.2.3.4:99999") and erro_do_bind("") {
        print("endereco OK")
    } else {
        print("FALHA endereco")
    }
    _ = net.udp_close(&primeiro)
    let segundo = net.udp_close(&primeiro) or_else net.NetError.endereco_invalido
    if segundo == net.NetError.fechado {
        print("fechado OK")
    } else {
        print("FALHA fechado: close duplo nao deu fechado")
    }
}
