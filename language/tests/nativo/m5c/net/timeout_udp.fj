// Fixture do std:net UDP (M5 P53): recv_from com timeout de 100 ms sem trafego devolve timeout em ~100 ms (medido com std:time); timeout_ms = 0 volta ja.
// Saida esperada: "timeout 100 OK ms=<n>" e "zero OK ms=<n>".
import "std:net" as net
import "std:time" as tempo

proc abrir(addr: str) -> net.UdpSocket {
    switch r in net.udp_bind(addr) {
    case net.UdpSocket:
        return r
    case net.NetError:
        return net.UdpSocket{h = 0}
    }
    return net.UdpSocket{h = 0}
}

// Espera timeout_ms e devolve (em ms) quanto durou, ou -1 se o resultado nao foi timeout.
proc medir_timeout(s: ^net.UdpSocket, timeout_ms: i32) -> int {
    var buf: [16]u8 = {}
    let sw = tempo.stopwatch_start()
    switch r in net.udp_recv_from(s, buf[..], timeout_ms, heap) {
    case net.UdpRecebido:
        delete(r.de)
        return -1
    case net.NetError:
        if r != net.NetError.timeout {
            return -1
        }
    }
    return tempo.ns_to_ms(tempo.elapsed_ns(sw))
}

proc main() {
    var s = abrir("127.0.0.1:0")
    if s.h == 0 {
        print("FALHA abrir")
        return
    }
    let longo = medir_timeout(&s, 100)
    if longo >= 80 and longo <= 1000 {
        print(f"timeout 100 OK ms={longo}")
    } else {
        print(f"FALHA timeout ms={longo}")
    }
    let zero = medir_timeout(&s, 0)
    if zero >= 0 and zero < 80 {
        print(f"zero OK ms={zero}")
    } else {
        print(f"FALHA zero ms={zero}")
    }
    _ = net.udp_close(&s)
}
