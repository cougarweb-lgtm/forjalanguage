// cond_tempo.fj - M5 P49: wait_ms expira sem sinal (false, depois de ~200 ms) e acorda com sinal (true). Saida esperada: "expira OK" e "acorda OK".
import "std:thread"
import "std:sync"
import "std:os"

struct Cena {
    m: sync.Mutex
    c: sync.Cond
}

proc sinalizar(p: rawptr) -> u32 {
    let s = p as ^Cena
    sync.lock(&s.m)
    sync.signal(&s.c)
    sync.unlock(&s.m)
    return 0
}

proc main() {
    var s = Cena{}
    sync.lock(&s.m)
    let t0 = os.wall_time_ns()
    let expirou = sync.wait_ms(&s.c, &s.m, 200)
    let decorrido = os.wall_time_ns() - t0
    sync.unlock(&s.m)
    if not expirou and decorrido >= 150000000 and decorrido < 5000000000 {
        print("expira OK")
    } else {
        print("expira FALHOU")
    }

    sync.lock(&s.m)
    let filha = thread.spawn(sinalizar, &s as rawptr)
    let acordou = sync.wait_ms(&s.c, &s.m, 10000)
    sync.unlock(&s.m)
    switch t in filha {
    case thread.Thread:
        _ = thread.join(t)
    case thread.ThreadError:
        print("falhou")
    }
    if acordou {
        print("acorda OK")
    } else {
        print("acorda FALHOU")
    }
}
