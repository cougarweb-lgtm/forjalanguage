// try_lock.fj - M5 P49: try_lock de outra thread falha enquanto a principal tem o Mutex; depois de soltar, a principal trava. Saida esperada: "try_lock OK".
import "std:thread"
import "std:sync"

struct Cena {
    m: sync.Mutex
    tentou: bool = false
    conseguiu: bool = true
}

proc tentar(p: rawptr) -> u32 {
    let s = p as ^Cena
    s.conseguiu = sync.try_lock(&s.m)
    if s.conseguiu {
        sync.unlock(&s.m)
    }
    s.tentou = true
    return 0
}

proc main() {
    var s = Cena{}
    sync.lock(&s.m)
    let filha = thread.spawn(tentar, &s as rawptr)
    switch t in filha {
    case thread.Thread:
        _ = thread.join(t)
    case thread.ThreadError:
        print("falhou")
    }
    sync.unlock(&s.m)
    let depois = sync.try_lock(&s.m)
    if depois {
        sync.unlock(&s.m)
    }
    if s.tentou and not s.conseguiu and depois {
        print("try_lock OK")
    } else {
        print("try_lock FALHOU")
    }
}
