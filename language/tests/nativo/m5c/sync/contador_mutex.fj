// contador_mutex.fj - M5 P49: 6 threads x 100000 incrementos sob Mutex tem de dar exatamente 600000. Saida esperada: "600000 OK".
import "std:thread"
import "std:sync"

struct Compartilhado {
    m: sync.Mutex
    contador: int = 0
}

proc trabalhador(p: rawptr) -> u32 {
    let g = p as ^Compartilhado
    for _k in 0..<100000 {
        sync.lock(&g.m)
        g.contador += 1
        sync.unlock(&g.m)
    }
    return 0
}

proc main() {
    var s = Compartilhado{}
    var filhas = make([dynamic]thread.Thread, alloc = heap, cap = 6)
    defer delete(filhas)
    for _k in 0..<6 {
        switch t in thread.spawn(trabalhador, &s as rawptr) {
        case thread.Thread:
            append(&filhas, item = t)
        case thread.ThreadError:
            print("falhou")
        }
    }
    for t in filhas {
        _ = thread.join(t)
    }
    if s.contador == 600000 {
        print("600000 OK")
    } else {
        print("contador errado")
    }
}
