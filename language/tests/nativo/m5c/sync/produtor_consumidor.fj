// produtor_consumidor.fj - M5 P49: 100000 itens passam por um slot com 2 Cond; a soma tem de bater (sem perda). Saida esperada: "5000050000 OK".
import "std:thread"
import "std:sync"

struct Canal {
    m: sync.Mutex
    cheio_cv: sync.Cond
    vazio_cv: sync.Cond
    cheio: bool = false
    item: int = 0
    soma: int = 0
}

proc produtor(p: rawptr) -> u32 {
    let c = p as ^Canal
    for i in 1..=100000 {
        sync.lock(&c.m)
        while c.cheio {
            sync.wait(&c.vazio_cv, &c.m)
        }
        c.item = i
        c.cheio = true
        sync.signal(&c.cheio_cv)
        sync.unlock(&c.m)
    }
    return 0
}

proc consumidor(p: rawptr) -> u32 {
    let c = p as ^Canal
    for _k in 0..<100000 {
        sync.lock(&c.m)
        while not c.cheio {
            sync.wait(&c.cheio_cv, &c.m)
        }
        c.soma += c.item
        c.cheio = false
        sync.signal(&c.vazio_cv)
        sync.unlock(&c.m)
    }
    return 0
}

proc main() {
    var c = Canal{}
    let pr = thread.spawn(produtor, &c as rawptr)
    let co = thread.spawn(consumidor, &c as rawptr)
    switch t in pr {
    case thread.Thread:
        _ = thread.join(t)
    case thread.ThreadError:
        print("falhou")
    }
    switch t in co {
    case thread.Thread:
        _ = thread.join(t)
    case thread.ThreadError:
        print("falhou")
    }
    if c.soma == 5000050000 {
        print("5000050000 OK")
    } else {
        print("soma errada")
    }
}
