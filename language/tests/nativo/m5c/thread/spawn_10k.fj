// spawn_10k.fj - M5 P47: 10 mil spawn/join sequenciais; cada filha escreve na propria Carga (rawptr) e o contador da principal confere (saida: "10000 OK").
import "std:thread"

struct Carga {
    marca: int = 0
}

proc filha(p: rawptr) -> u32 {
    let c = p as ^Carga
    c.marca = 7
    return 0
}

proc main() {
    var contador = 0
    var soma = 0
    for k in 0..<10000 {
        var c = Carga{}
        switch t in thread.spawn(filha, &c as rawptr) {
        case thread.Thread:
            _ = thread.join(t)
            contador += 1
            soma += c.marca
        case thread.ThreadError:
            print("falhou")
        }
    }
    if contador == 10000 and soma == 70000 {
        print("10000 OK")
    } else {
        print("ERRO")
    }
}
