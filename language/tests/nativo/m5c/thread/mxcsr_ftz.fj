// mxcsr_ftz.fj - M5 P47: FTZ/DAZ ligados na principal (_controlfp do msvcrt) tem de valer na filha (MXCSR herdado da criadora). Saida: "FTZ filha OK".
import "std:thread"

foreign {
    link "msvcrt"
    proc _controlfp(novo: u32, mascara: u32) -> u32
}

struct Resultado {
    modo: u32 = 0
}

proc filha(p: rawptr) -> u32 {
    let r = p as ^Resultado
    r.modo = _controlfp(0, 0)
    return 0
}

proc main() {
    _ = _controlfp(0x01000000, 0x03000000)
    var r = Resultado{}
    switch t in thread.spawn(filha, &r as rawptr) {
    case thread.Thread:
        _ = thread.join(t)
        if (r.modo & 0x01000000) != 0 {
            print("FTZ filha OK")
        } else {
            print("FTZ filha FALHOU")
        }
    case thread.ThreadError:
        print("falhou")
    }
}
