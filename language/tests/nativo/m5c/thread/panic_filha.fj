// panic_filha.fj - M5 P47: panic dentro da filha = 1 relatorio e exit 101 (rt_fio.c, P45). Saida esperada: exit 101 e nada depois do panic.
import "std:thread"

proc filha(p: rawptr) -> u32 {
    panic("filha em panico")
    return 0
}

proc main() {
    var z = 0
    switch t in thread.spawn(filha, &z as rawptr) {
    case thread.Thread:
        _ = thread.join(t)
        print("nao devia chegar aqui")
    case thread.ThreadError:
        print("falhou")
    }
}
