// panic_tarefa.fj - M5 P51: panic dentro de uma tarefa do Group = o processo sai com exit 101 (sem captura, sem linha de sucesso).
// Versao: 0.1.0. Changelog: 0.1.0 - M5 P51: fixture de panic numa tarefa (saida esperada: rc 101).
import "std:async" as asy

proc quebra(q: rawptr) -> u32 {
    panic("tarefa quebrou")
    return 0
}

proc main() {
    switch p in asy.pool_new(2) {
    case ^asy.Pool:
        let g = asy.group_new(p)
        asy.group_spawn(g, quebra, p as rawptr)
        asy.group_wait(g)
        asy.pool_close(p)
        delete(p)
    case asy.AsyncError:
        print("falhou")
    }
}
