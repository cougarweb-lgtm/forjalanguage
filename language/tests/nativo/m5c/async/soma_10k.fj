// soma_10k.fj - M5 P51: 10 mil tarefas num Group; cada tarefa grava o proprio indice no seu Pedido (heap) e a soma sai em ordem fixa (saida: "soma OK 49995000").
// Versao: 0.1.0. Changelog: 0.1.0 - M5 P51: fixture de soma exata com N workers (N = 1o argumento depois de --).
// Verificacao: forja run soma_10k.fj -- 1  e  forja run soma_10k.fj -- 6 (mesma saida).
import "std:async" as asy
import "std:os"
import "std:text"

struct Pedido {
    indice: int = 0
    saida: int = 0
}

proc marca(q: rawptr) -> u32 {
    let d = q as ^Pedido
    d.saida = d.indice
    return 0
}

proc soma_com(p: ^asy.Pool) {
    var lista = make([dynamic]^Pedido, alloc = heap, cap = 10000)
    let g = asy.group_new(p)
    for i in 0..<10000 {
        let d = new(Pedido, alloc = heap)
        d.indice = i
        append(&lista, item = d)
        asy.group_spawn(g, marca, d as rawptr)
    }
    asy.group_wait(g)
    var soma = 0
    for d in lista {
        soma += d.saida
    }
    if soma == 49995000 {
        print("soma OK 49995000")
    } else {
        print("soma ERRADA")
    }
    for d in lista {
        delete(d)
    }
    delete(lista)
}

proc main() {
    let workers = text.parse_int(os.args()[1]) or_else 1
    switch p in asy.pool_new(workers) {
    case ^asy.Pool:
        soma_com(p)
        asy.pool_close(p)
        delete(p)
    case asy.AsyncError:
        print("falhou")
    }
}
