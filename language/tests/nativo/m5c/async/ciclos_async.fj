// ciclos_asy.fj - M5 P51: 200 ciclos pool_new / group / pool_close / delete (metade sem tarefa). Sem travar e sem R0009 no dev (saida: "ciclos OK").
// Versao: 0.1.0. Changelog: 0.1.0 - M5 P51: prova de que o pool nao vaza thread nem memoria em 200 ciclos.
import "std:async" as asy

proc nada(q: rawptr) -> u32 {
    return 0
}

proc ciclo_vazio(n: int) {
    switch p in asy.pool_new(n) {
    case ^asy.Pool:
        asy.pool_close(p)
        delete(p)
    case asy.AsyncError:
        print("falhou")
    }
}

proc ciclo_com_tarefas(n: int) {
    switch p in asy.pool_new(n) {
    case ^asy.Pool:
        let g = asy.group_new(p)
        for k in 0..<3 {
            asy.group_spawn(g, nada, p as rawptr)
        }
        asy.group_wait(g)
        asy.pool_close(p)
        delete(p)
    case asy.AsyncError:
        print("falhou")
    }
}

proc main() {
    for c in 0..<200 {
        if c % 2 == 0 {
            ciclo_vazio(4)
        } else {
            ciclo_com_tarefas(4)
        }
    }
    print("ciclos OK")
}
