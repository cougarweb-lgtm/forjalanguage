// tipos_todos.fj - universo da prova de layout (verificar_layout.py, build --modo c --prova-layout).
// Um tipo de cada classe composta que o backend C gera: cada um aparece como local, parametro ou retorno,
// para entrar no universo da prova por valor.

enum Erro {
    falhou
}

enum Cor5 { c0, c1, c2, c3, c4 }

enum Cor20 {
    m00, m01, m02, m03, m04, m05, m06, m07, m08, m09,
    m10, m11, m12, m13, m14, m15, m16, m17, m18, m19
}

enum Cor40 {
    a00, a01, a02, a03, a04, a05, a06, a07, a08, a09,
    a10, a11, a12, a13, a14, a15, a16, a17, a18, a19,
    a20, a21, a22, a23, a24, a25, a26, a27, a28, a29,
    a30, a31, a32, a33, a34, a35, a36, a37, a38, a39
}

enum Cor60 {
    b00, b01, b02, b03, b04, b05, b06, b07, b08, b09,
    b10, b11, b12, b13, b14, b15, b16, b17, b18, b19,
    b20, b21, b22, b23, b24, b25, b26, b27, b28, b29,
    b30, b31, b32, b33, b34, b35, b36, b37, b38, b39,
    b40, b41, b42, b43, b44, b45, b46, b47, b48, b49,
    b50, b51, b52, b53, b54, b55, b56, b57, b58, b59
}

// struct com padding: u8, i64 e u8 (7 B de folga antes do int e depois do ultimo u8)
struct Padding {
    a: u8 = 0
    b: int = 0
    c: u8 = 0
}

// struct aninhada: a struct Padding entra por valor no campo p
struct Aninhada {
    p: Padding = Padding{}
    f: f64 = 0.0
}

union Valor { i32, str, Padding }

union Mistura { Aninhada, f64 }

proc com_valor(n: int) -> int ! Erro {
    if n < 0 {
        return Erro.falhou
    }
    return n
}

proc sem_valor(n: int) -> ! Erro {
    if n < 0 {
        return Erro.falhou
    }
    return
}

proc par(n: int) -> (a: int, b: u8) {
    return n, 1
}

proc par_padding() -> (p: Padding, ok: bool) {
    return Padding{}, true
}

// fatia de struct: o elemento Padding entra por valor no corpo do laco
proc soma_fatia(xs: []Padding) -> int {
    var t = 0
    for x in xs {
        t += x.b
    }
    return t
}

proc main() {
    let p = Padding{}
    let _an = Aninhada{}
    let _v: Valor = "x"
    let _mi: Mistura = 1.5 as f64
    let _ou: ?u8 = 3
    let _of: ?f64 = 1.5
    let _r = com_valor(1)
    let _s = sem_valor(1)
    let a, b = par(1)
    let _pp, _ok = par_padding()
    let arr: [3]Padding = {}
    var l = make([dynamic]Padding, alloc = heap)
    defer delete(l)
    append(&l, item = p)
    let sf: soa[3]Padding = {}
    var sd = make(soa[dynamic]Padding, alloc = heap)
    defer delete(sd)
    let _m3: matrix[3, 3]f32 = {}
    let _m4: matrix[4, 4]f64 = {}
    var mp = make(map[str]int, alloc = heap)
    defer delete(mp)
    insert(&mp, key = "a", value = 1)
    let _b5: bit_set[Cor5] = {}
    let _b20: bit_set[Cor20] = {}
    let _b40: bit_set[Cor40] = {}
    let _b60: bit_set[Cor60] = {}
    let _c: Cor5 = Cor5.c0
    let t: str = "x"
    print(soma_fatia(l[..]))
    print(a + b as int)
    print(len(arr) + len(sf) + len(t))
}
