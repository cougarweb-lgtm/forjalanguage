// perfil_panico.fj - M8 P3, caso 4: panic no meio de c (cadeia a > b > c). Esperado: exit 101, os 3 quadros fechados e os 2 arquivos gravados. Contagens em perfil_panico.esperado.
proc c(n: int) -> int {
    var s = 0
    for i in 0..<n {
        s = s + i
    }
    panic("panic de proposito no meio de c")
    return s
}

proc b(n: int) -> int {
    return c(n) + 1
}

proc a(n: int) -> int {
    return b(n) + 1
}

proc main() {
    print(a(4))
}
