// perfil_saida.fj - M8 P3, caso 5: os.exit(3) no meio de c (cadeia a > b > c). Esperado: exit 3, os 3 quadros fechados e os 2 arquivos gravados. Contagens em perfil_saida.esperado.
import "std:os"

proc c(n: int) -> int {
    var s = 0
    for i in 0..<n {
        s = s + i
    }
    os.exit(3)
    return s
}

proc b(n: int) -> int {
    return c(n) + 1
}

proc a(n: int) -> int {
    return b(n) + 1
}

proc main() {
    print(a(4))
}
