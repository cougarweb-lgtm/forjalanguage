// perfil_cadeia.fj - M8 P3, caso 2: a > b > c com laco. b roda 2 vezes e chama c 5 vezes em cada uma (10 de c). Contagens em perfil_cadeia.esperado.
proc c(n: int) -> int {
    return n * 2
}

proc b(n: int) -> int {
    var s = 0
    for i in 0..<n {
        s = s + c(i)
    }
    return s
}

proc a(n: int) -> int {
    return b(n) + b(n)
}

proc main() {
    print(a(5))
}
