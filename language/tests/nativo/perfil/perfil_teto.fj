// perfil_teto.fj - M8 P3, caso 7: 2 M de chamadas de folha estouram o teto de 1.048.576 eventos. O agregado continua completo; o JSON e truncado. Contagens em perfil_teto.esperado.
proc folha(x: int) -> int {
    return x + 1
}

proc main() {
    var t = 0
    for i in 0..<2000000 {
        t = folha(t)
    }
    print(t)
}
