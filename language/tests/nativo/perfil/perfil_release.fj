// perfil_release.fj - M8 P3, caso 6: em --release a folha pequena pequena() e inlinada e some do perfil; com --sem-otim inline ela volta com 1000 chamadas. Contagens em perfil_release.esperado (linha pequena = so com --sem-otim inline).
proc pequena(x: int) -> int {
    return x + 1
}

proc pesada(n: int) -> int {
    var s = 0
    for i in 0..<n {
        s = s + i * i
    }
    return s
}

proc main() {
    var t = 0
    for i in 0..<1000 {
        t = pequena(t)
    }
    print(t)
    print(pesada(1000))
}
