// perfil_fios.fj - M8 P3, caso 3: 2 std:thread rodam pai, que chama filho 50 vezes. Contagens em perfil_fios.esperado: pai 2, filho 100, main 1.
import "std:thread"

proc filho(i: int) -> int {
    return i + 1
}

proc pai(q: rawptr) -> u32 {
    var s = 0
    for i in 0..<50 {
        s = s + filho(i)
    }
    return 0
}

proc main() {
    var r = 0
    var t1 = thread.Thread{}
    var t2 = thread.Thread{}
    switch t in thread.spawn(pai, &r as rawptr) {
    case thread.Thread:
        t1 = t
    case thread.ThreadError:
        print("FALHA thread 1")
    }
    switch t in thread.spawn(pai, &r as rawptr) {
    case thread.Thread:
        t2 = t
    case thread.ThreadError:
        print("FALHA thread 2")
    }
    _ = thread.join(t1)
    _ = thread.join(t2)
    print("fios ok")
}
