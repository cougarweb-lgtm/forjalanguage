// perfil_custo.fj - M8 P3, caso 8 (medicao, sem portao): fib recursivo de 30 em --release, para medir o custo do --perfil. Saida esperada: 832040.
proc fib_rec(n: int) -> int {
    if n < 2 {
        return n
    }
    return fib_rec(n - 1) + fib_rec(n - 2)
}

proc main() {
    print(fib_rec(30))
}
