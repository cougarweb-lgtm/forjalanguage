// delete_duplo.fj - M6 P70 (D-M6-15a): delete duplo depois de 10 mil alocacoes intermediarias. Sem quarentena o heap reaproveita o bloco e a marca MORTA some; com ela o 2o delete
// e R0008 em toda execucao. Esperado: stdout "10000", stderr R0008 ("ja passou por delete"), exit 101. Verificacao: python -I ..\verificar_mem.py --forja <forja.exe>
// M6e P93b: delete(p) zera o nome p; o duplo vai por ponteiro guardado em estrutura (delete(c.p) nao zera).
struct Caixa {
    p: ^int
}

proc main() {
    let c = Caixa{p = new(int, alloc = heap)}
    c.p^ = 1
    delete(c.p)
    var soma: int = 0
    for i in 0..<10000 {
        let q = new(int, alloc = heap)
        q^ = i
        soma += 1
        delete(q)
    }
    print(soma)
    delete(c.p)
}
