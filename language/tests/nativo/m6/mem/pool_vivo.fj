// pool_vivo.fj - M6 P70: Pool criado e nunca destruido. Dev acusa R0009 com "tipo":"pool", os bytes dos blocos e a pilha da criacao; exit 101.
// Verificacao: python -I ..\verificar_mem.py --forja <forja.exe>
import "std:mem"

struct Bala {
    dano: int = 1
}

proc montar() -> int {
    let p = mem.pool_create()
    let b = new(Bala, alloc = p)
    return b.dano
}

proc main() {
    print(montar())
}
