// release_handle.fj - M6 P71b: em --release track_handle e untrack_handle SOMEM (como assert com NDEBUG em C): sem rastreio, sem relatorio, e o untrack de handle desconhecido (que em dev seria R0008) nao existe.
// Esperado em --release (x64 windows e linux, e backend c no windows): stdout "9", nenhuma linha no stderr, exit 0. So roda em release.
// Verificacao: python -I ..\verificar_mem.py --forja <forja.exe> --fixture release_handle
import "std:mem"

proc main() {
    let b = new(int, alloc = heap)
    defer delete(b)
    mem.track_handle("falso", b as rawptr)
    mem.untrack_handle(b as rawptr)
    mem.untrack_handle(b as rawptr)
    mem.track_handle("esquecido", b as rawptr)
    print(9)
}
