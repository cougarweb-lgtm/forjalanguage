// handle_e_heap.fj - M6 P71b: um bloco de heap vazado E um handle esquecido no mesmo programa: o fim relata as 2 linhas R0009 (heap com "tipo": "runtime", depois "tipo": "handle").
// Esperado em dev: stdout "4"; stderr com 2 linhas R0009 (heap, handle "socket"); exit 101.
// Verificacao: python -I ..\verificar_mem.py --forja <forja.exe> --fixture handle_e_heap
import "std:mem"

proc criar() -> ^int {
    let b = new(int, alloc = heap)
    b^ = 4
    return b
}

proc main() {
    let vazado = criar()
    let outro = new(int, alloc = heap)
    defer delete(outro)
    mem.track_handle("socket", outro as rawptr)
    print(vazado^)
}
