// vazamento_por_tick.fj - M6 P71a: 100 ticks; cada tick aloca 2 blocos, libera o 2o e VAZA o 1o (so os ticks pares, 50 vazados, 8 bytes cada, em vaza_par); um bloco anterior ao snapshot tambem fica vivo.
// report_since depois do snapshot tem de mostrar SO os nascidos depois dele: 50 blocos / 400 bytes no local de vaza_par e nada do bloco de antes.
// Esperado: stdout "100"; stderr com 1 linha {"tipo": "mem_report"} (novos_blocos 50, novos_bytes 400; o grupo de vaza_par com 50 blocos e 400 bytes, pilha vaza_par, tick, main); depois o R0009 do fim (blocos vivos) com exit 101.
// Verificacao: python -I ..\verificar_mem.py --forja <forja.exe> --fixture vazamento_por_tick
import "std:mem"

proc vaza_par(i: int) -> ^int {
    let b = new(int, alloc = heap)
    b^ = i
    return b
}

proc temporario(i: int) {
    let t = new(int, alloc = heap)
    defer delete(t)
    t^ = i
}

proc tick(i: int) {
    temporario(i)
    if i % 2 == 0 {
        let _v = vaza_par(i)
    }
}

proc main() {
    let _antes = vaza_par(-1)
    var s = mem.snapshot()
    for i in 0..<100 {
        tick(i)
    }
    mem.report_since(&s)
    print(100)
}
