// handle_desconhecido.fj - M6 P71b: untrack_handle de um handle que nunca foi registrado = R0008.
// Esperado em dev: stdout "1" (antes do erro); stderr com 1 linha R0008 ("untrack_handle"), pilha com untrack_handle e main; exit 101.
// Verificacao: python -I ..\verificar_mem.py --forja <forja.exe> --fixture handle_desconhecido
import "std:mem"

proc main() {
    let b = new(int, alloc = heap)
    defer delete(b)
    print(1)
    mem.untrack_handle(b as rawptr)
    print(2)
}
