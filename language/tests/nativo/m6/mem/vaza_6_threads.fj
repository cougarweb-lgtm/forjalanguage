// vaza_6_threads.fj - M6 P70: 6 threads (std:thread) vazam 1 bloco cada no mesmo ponto (o ponteiro fica na struct da thread, sem delete). Dev acusa UMA linha R0009 com
// 6 blocos (agrupados por arquivo:linha), exit 101, sem SIGSEGV na captura da pilha de dentro da thread. Verificacao: python -I ..\verificar_mem.py --forja <forja.exe>
import "std:thread"

const FIOS: int = 6

struct Resultado {
    bloco: ^int
}

proc filha(p: rawptr) -> u32 {
    let r = p as ^Resultado
    r.bloco = new(int, alloc = heap)
    r.bloco^ = 1
    return 0
}

proc main() {
    var rs: [6]Resultado = {}
    var fios: [6]thread.Thread = {}
    for k in 0..<FIOS {
        switch t in thread.spawn(filha, &rs[k] as rawptr) {
        case thread.Thread:
            fios[k] = t
        case thread.ThreadError:
            print("FALHA thread")
            return
        }
    }
    for k in 0..<FIOS {
        _ = thread.join(fios[k])
    }
    print(FIOS)
}
