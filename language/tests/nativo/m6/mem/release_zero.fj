// release_zero.fj - M6 P71a: em --release as chamadas snapshot()/report_since() somem (custo zero) e o MemSnapshot que sobra nasce ZERADO (nunca lixo da pilha).
// Esperado em --release (x64, linux e c): stdout "0", "0", "0" (serie, vivos, bytes), nenhuma linha no stderr, exit 0. So roda em release (em dev os contadores sao reais).
// Verificacao: python -I ..\verificar_mem.py --forja <forja.exe> --fixture release_zero
import "std:mem"

proc suja_pilha(n: int) -> int {
    var lixo: [64]int = {}
    for i in 0..<64 {
        lixo[i] = n + i + 7
    }
    return lixo[63]
}

proc main() {
    _ = suja_pilha(1000)
    var s = mem.snapshot()
    mem.report_since(&s)
    print(s.serie)
    print(s.vivos)
    print(s.bytes)
}
