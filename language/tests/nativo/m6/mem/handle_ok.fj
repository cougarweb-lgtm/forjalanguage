// handle_ok.fj - M6 P71b: track_handle seguido de untrack_handle = nenhum R0009. O "handle" e um bloco de heap da Forja so para ter um endereco (o rastreador de handles nao liga para a origem).
// Esperado em dev: stdout "5", stderr vazio, exit 0. Registrar de novo o mesmo handle so atualiza o kind (nao e erro).
// Verificacao: python -I ..\verificar_mem.py --forja <forja.exe> --fixture handle_ok
import "std:mem"

proc main() {
    let b = new(int, alloc = heap)
    mem.track_handle("falso", b as rawptr)
    mem.track_handle("falso_2", b as rawptr)
    mem.untrack_handle(b as rawptr)
    delete(b)
    print(5)
}
