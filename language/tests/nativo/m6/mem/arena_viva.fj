// arena_viva.fj - M6 P70: Arena criada e nunca destruida. Dev acusa R0009 com "tipo":"arena", os bytes dos blocos e a pilha da criacao; exit 101.
// Verificacao: python -I ..\verificar_mem.py --forja <forja.exe>
import "std:mem"

struct Bala {
    dano: int = 1
}

proc montar() -> int {
    let a = mem.arena_create()
    let b = new(Bala, alloc = a)
    return b.dano
}

proc main() {
    print(montar())
}
