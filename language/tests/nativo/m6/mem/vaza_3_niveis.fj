// vaza_3_niveis.fj - M6 P70: vazamento em proc de 3 niveis (main -> nivel_a -> nivel_b). O R0009 de dev tem de trazer a pilha .fj de 3 quadros (nivel_b, nivel_a, main).
// Esperado: stdout "7"; stderr com 1 linha R0009 e "pilha" com 3 quadros; exit 101. Verificacao: python -I ..\verificar_mem.py --forja <forja.exe>
proc nivel_b(x: int) -> ^int {
    let b = new(int, alloc = heap)
    b^ = x
    return b
}

proc nivel_a(x: int) -> ^int {
    return nivel_b(x + 1)
}

proc main() {
    let v = nivel_a(6)
    print(v^)
}
