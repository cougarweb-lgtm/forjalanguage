// handle_esquecido_linux.fj - M6 P71b: o mesmo de handle_esquecido_win.fj com o malloc do musl (link "c") no alvo linux.
// Esperado em dev (Linux): stdout "3"; stderr com 1 linha R0009 "tipo": "handle", "kind": "malloc", pilha com track_handle, abrir_recurso e main; exit 101.
// Verificacao: python -I ..\verificar_mem.py --forja <forja.exe> --fixture handle_esquecido
import "std:mem"

foreign {
    link "c"
    proc c_malloc = "malloc"(n: u64) -> rawptr
}

proc abrir_recurso() -> rawptr {
    let p = c_malloc(16)
    mem.track_handle("malloc", p)
    return p
}

proc main() {
    _ = abrir_recurso()
    print(3)
}
