// struct_padding.fj - u8, i64, u8 deixam bytes de padding: copia e campos continuam certos (24 bytes, alinhamento 8).

struct Pad {
    a: u8
    b: i64
    c: u8
}

struct Pad3 {
    a: u8
    b: u16
    c: u8
}

proc main() {
    let p = Pad{a = 255, b = -9000000000, c = 1}
    print(p.a)
    print(p.b)
    print(p.c)
    var q = p
    q.a = 2
    q.b = q.b * 2
    print(p.a)
    print(p.b)
    print(q.a)
    print(q.b)
    print(q.c)
    var t = Pad3{a = 1, b = 60000, c = 3}
    let u = t
    t.b = 5
    print(u.a)
    print(u.b)
    print(u.c)
    print(t.b)
}
