// copia_struct.fj - atribuicao de struct copia: mudar a copia nao muda o original, e vice-versa.

struct Cx {
    n: i32
    v: f32
    t: bool
}

proc main() {
    var a = Cx{n = 1, v = 2.5, t = true}
    var b = a
    b.n = 10
    b.v = 7.5
    b.t = false
    print(a.n)
    print((a.v * 10.0) as int)
    print(a.t)
    print(b.n)
    print((b.v * 10.0) as int)
    print(b.t)
    a.n = 20
    print(a.n)
    print(b.n)
    b = a
    a.n = 30
    print(b.n)
    print(a.n)
    var i: i32 = 0
    while i < 3 {
        var c = a
        c.n = c.n + i
        a.n = c.n
        i += 1
    }
    print(a.n)
}
