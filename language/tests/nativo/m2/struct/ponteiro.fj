// ponteiro.fj - &x, p^ de escalar e de struct, p^ = v, p.campo += 1 por ^Struct e ponteiro de ponteiro.

struct Grifo {
    vida: i32
    forca: int
}

proc main() {
    var x: int = 5
    let p = &x
    print(p^)
    p^ = p^ + 2
    print(x)
    x = 40
    print(p^)
    var g = Grifo{vida = 10, forca = 3}
    let q = &g
    q.vida += 1
    q.forca = q.forca * 5
    print(g.vida)
    print(g.forca)
    print(q.vida)
    let c = q^
    q.vida = 99
    print(c.vida)
    print(g.vida)
    q^ = Grifo{vida = 1, forca = 2}
    print(g.vida)
    print(g.forca)
    var y: int = 1
    var r = &y
    let rr = &r
    rr^^ = 42
    print(y)
    var z: int = 9
    rr^ = &z
    print(r^)
}
