// faixa_excl.fj - faixa exclusiva 0..<10 recebe 10. Dev R0001 "valor 10 fora da faixa 0..<10 do campo 'pos'"; release imprime 10.

struct Slot {
    pos: i32 in 0..<10 = 0
}

proc main() {
    var s = Slot{pos = 9}
    print(s.pos)
    s.pos = 0
    print(s.pos)
    let k: i32 = 10
    s.pos = k
    print(s.pos)
}
