// faixa.fj - campo com faixa: 101 em 0..=100. Dev R0001 "valor 101 fora da faixa 0..=100 do campo 'vida'"; release segue e imprime 101.

struct Grifo {
    vida: i32 in 0..=100 = 100
    nome: i32 = 1
}

proc main() {
    var g = Grifo{vida = 50}
    print(g.vida)
    g.vida = 100
    print(g.vida)
    let n: i32 = 101
    g.vida = n
    print(g.vida)
}
