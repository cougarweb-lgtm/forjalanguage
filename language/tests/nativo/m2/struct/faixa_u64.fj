// faixa_u64.fj - campo uint com faixa: o maior uint em 0..=100. Dev R0001 com %llu "valor 18446744073709551615 fora da faixa 0..=100 do campo 'n'"; release imprime o valor.

struct Caixa {
    n: uint in 0..=100 = 5
}

proc main() {
    let x: uint = 18446744073709551615
    var c = Caixa{n = 100}
    print(c.n)
    c.n = x
    print(c.n)
}
