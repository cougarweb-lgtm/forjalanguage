// struct_local.fj - struct local: literal, leitura de campo, atribuicao de campo, struct zerada e campos de varias larguras.

struct Ponto {
    x: int
    y: int
}

struct Misto {
    a: i32
    b: bool
    c: f32
    d: u8
    e: i16
    f: f64
}

proc main() {
    var p = Ponto{x = 3, y = 4}
    print(p.x + p.y)
    p.x = 10
    print(p.x)
    p.y += 5
    print(p.y)
    let z = Ponto{}
    print(z.x)
    print(z.y)
    var m = Misto{a = -5, b = true, c = 1.5, d = 200, e = -300, f = 2.25}
    print(m.a)
    print(m.b)
    print((m.c * 2.0) as int)
    print(m.d)
    print(m.e)
    print((m.f * 4.0) as int)
    m.b = false
    m.d = 7
    m.e = m.e - 1
    print(m.b)
    print(m.d)
    print(m.e)
    let q = Misto{}
    print(q.a)
    print(q.b)
    print(q.d)
}
