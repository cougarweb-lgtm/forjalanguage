// endereco_escalar.fj - &x passado a um proc que incrementa 1000 vezes e ponteiro para var i32 local.

proc incrementar(p: ^int, vezes: int) {
    var i = 0
    while i < vezes {
        p^ = p^ + 1
        i += 1
    }
}

proc main() {
    var x: int = 0
    incrementar(&x, vezes = 1000)
    print(x)
    incrementar(&x, vezes = 1000)
    print(x)
    var y: i32 = 7
    let py = &y
    py^ = py^ * 3
    print(y)
}
