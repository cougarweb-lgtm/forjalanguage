// transmute.fj - bits de f32, f64 e inteiros: 1.0 f32 -> u32 "1065353216"; i64 <-> f64. A Forja so deixa transmute entre numericos (struct nao entra).

proc main() {
    let f: f32 = 1.0
    print(transmute(f, to = u32))
    let g: f64 = 1.0
    let bits = transmute(g, to = uint)
    print(bits)
    let volta = transmute(bits, to = f64)
    print((volta * 3.0) as int)
    let m: u32 = 4294967295
    print(transmute(m, to = i32))
    let n: i64 = -2
    print(transmute(n, to = u64))
    let ida: u32 = transmute(f, to = u32)
    let f2: f32 = transmute(ida, to = f32)
    print(f2 as int)
    let h: i16 = -1
    print(transmute(h, to = u16))
    let k: u8 = 200
    print(transmute(k, to = i8))
}
