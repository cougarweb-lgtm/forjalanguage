// struct_aninhada.fj - struct dentro de struct por valor: leitura, gravacao em campo aninhado e copia do campo inteiro.

struct Ponto {
    x: int
    y: int
}

struct Linha {
    a: Ponto
    id: i32
    b: Ponto
}

proc main() {
    var l = Linha{a = Ponto{x = 1, y = 2}, id = 7, b = Ponto{x = 30, y = 40}}
    print(l.a.x)
    print(l.a.y)
    print(l.id)
    print(l.b.x)
    print(l.b.y)
    l.b.y = 41
    l.a.x += 100
    print(l.a.x)
    print(l.b.y)
    let c = l.b
    l.b.x = 99
    print(c.x)
    print(c.y)
    print(l.b.x)
    l.a = c
    print(l.a.x)
    print(l.a.y)
    var m = l
    m.a.x = 5
    print(l.a.x)
    print(m.a.x)
    print(m.id)
}
