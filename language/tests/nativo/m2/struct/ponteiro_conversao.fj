// ponteiro_conversao.fj - ?^T none as ^T: dev R0005 "conversao 'as' para ponteiro nao nulo: ponteiro nulo"; release nao confere e nao deferencia.

struct Grifo {
    vida: i32 = 0
}

proc main() {
    var g = Grifo{vida = 7}
    var p: ?^Grifo = none
    print(p == none)
    p = &g
    let q = p as ^Grifo
    print(q.vida)
    p = none
    print(1)
    let _r = p as ^Grifo
    print(2)
}
