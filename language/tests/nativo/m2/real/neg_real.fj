// neg_real.fj - negacao de real: zero com sinal (visto por 1/x), NaN, infinito e a mascara de sinal.

proc sinal64(x: f64) {
    print(1.0 / x > 0.0)
}

proc sinal32(x: f32) {
    print(1.0 / x > 0.0)
}

proc main() {
    let a: f64 = 0.0
    let b: f32 = 0.0
    sinal64(a)
    sinal64(-a)
    sinal32(b)
    sinal32(-b)
    sinal64(-(-a))
    let n: f64 = a / a
    print(-n == -n)
    print((-(-2.5)) as int)
    print((-2.5) as int)
    print(-(1.0 / a) < 0.0)
    let c: f32 = -0.0
    sinal32(c)
}
