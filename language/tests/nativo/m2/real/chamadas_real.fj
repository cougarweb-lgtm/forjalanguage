// chamadas_real.fj - parametros misturados (inteiro e real por POSICAO), 5o+ na pilha, retorno real, aninhamento.

proc mistura(a: i32, b: f64, c: f32, d: i64, e: f64, f: i32, g: f32) -> f64 {
    return (a as f64) + b + (c as f64) + (d as f64) + e + (f as f64) + (g as f64)
}

proc dobra(x: f32) -> f32 {
    return x * 2.0
}

proc cadeia(x: f64) -> f64 {
    return (dobra(x as f32) as f64) + 1.0
}

proc main() {
    print((mistura(1, b = 2.5, c = 0.5, d = 4, e = 0.25, f = 6, g = 0.125) * 1000.0) as int)
    print((dobra(1.25) * 1000.0) as int)
    print((cadeia(3.5) * 1000.0) as int)
    print((cadeia(cadeia(0.1)) * 100000000.0) as int)
}
