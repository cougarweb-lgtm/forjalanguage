// nan_inf.fj - 0/0 e x/0 em variavel: NaN e infinitos passam pelas contas; lidos por comparacao.

proc classe64(x: f64) {
    print(x == x)
    print(x > 1000000000000000000.0)
    print(x < -1000000000000000000.0)
}

proc classe32(x: f32) {
    print(x == x)
    print(x > 1000000000000000000.0)
    print(x < -1000000000000000000.0)
}

proc main() {
    let z: f64 = 0.0
    let u: f64 = 1.0
    classe64(u / z)
    classe64(-u / z)
    classe64(z / z)
    classe64((u / z) - (u / z))
    classe64((u / z) + 1.0)
    let y: f32 = 0.0
    classe32(1.0 / y)
    classe32(y / y)
    classe32(-(1.0 / y))
}
