// conv_int_real.fj - inteiro -> f32/f64 (com sinal e sem sinal): exato em f64, arredondado em f32; lido por real -> int.

proc main() {
    let a: i32 = -7
    let b: i64 = 9007199254740993
    let c: i8 = -128
    let d: u8 = 255
    let e: i16 = -32768
    let f: u16 = 65535
    let g: u32 = 4000000000
    let h: i32 = 16777217
    print((a as f64) as int)
    print((a as f32) as int)
    print((b as f64) as int)
    print(((b as f32) as f64) as int)
    print((c as f32) as int)
    print((d as f64) as int)
    print((e as f64) as int)
    print((f as f32) as int)
    print((g as f64) as int)
    print(((g as f32) as f64) as int)
    print(((h as f32) as f64) as int)
    print((h as f64) as int)
}
