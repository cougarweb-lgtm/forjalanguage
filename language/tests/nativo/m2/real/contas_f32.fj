// contas_f32.fj - + - * / e negacao em f32: arredondamento a cada operacao, sem FMA; lido por f32 -> f64 -> int.

proc ver(x: f32) {
    print((x as f64 * 100000000000000000.0) as int)
}

proc media(a: f32, b: f32, c: f32) -> f32 {
    return (a + b + c) / 3.0
}

proc main() {
    let a: f32 = 0.1
    let b: f32 = 0.2
    ver(a + b)
    ver(a * b)
    ver(a - b)
    ver(a / b)
    ver(-a)
    ver(media(1.0, b = 2.0, c = 4.0))
    ver(media(0.1, b = 0.2, c = 0.4))
    let g: f32 = 16777216.0
    print((g + 1.0) as int)
    print((g * 3.0 - g) as int)
    var s: f32 = 0.0
    var k = 0
    while k < 10 {
        s = s + 0.1
        k = k + 1
    }
    ver(s)
    ver(1.0 / 3.0)
}
