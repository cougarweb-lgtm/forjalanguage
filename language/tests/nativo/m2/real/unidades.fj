// unidades.fj - unit sobre f32: conta no tipo certo, soma, divisao entre unidades e comparacao.

unit Metros: f32
unit Segundos: f32
unit MetrosPorSegundo = Metros/Segundos

proc velocidade(d: Metros, t: Segundos) -> MetrosPorSegundo {
    return d / t
}

proc main() {
    let d1: Metros = 10.0
    let d2: Metros = 5.5
    print(((d1 + d2) as f64 * 10.0) as int)
    let t: Segundos = 4.0
    let v: MetrosPorSegundo = velocidade(d1, t = t)
    print((v as f64 * 1000.0) as int)
    let d3: Metros = v * t
    print((d3 as f64 * 1000.0) as int)
    print(d1 > d2)
    print(d1 == d2)
}
