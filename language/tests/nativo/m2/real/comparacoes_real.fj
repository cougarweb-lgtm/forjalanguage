// comparacoes_real.fj - == != < <= > >= em f32 e f64, com NaN (toda comparacao falha, exceto !=).

proc main() {
    let a: f64 = 1.5
    let b: f64 = 2.5
    var n: f64 = 0.0
    n = n / n
    print(a == b)
    print(a != b)
    print(a < b)
    print(a <= b)
    print(a > b)
    print(a >= b)
    print(a == a)
    print(n == n)
    print(n != n)
    print(n < a)
    print(n <= a)
    print(n > a)
    print(n >= a)
    print(a != n)
    let x: f32 = 0.1
    let y: f32 = 0.1
    print(x == y)
    print(x < y)
    print(x <= y)
    print(x >= y)
    var m: f32 = 0.0
    m = m / m
    print(m == m)
    print(m != m)
    print(m < x)
    print(m >= x)
    if a < b {
        print(1)
    }
    if n < a {
        print(2)
    } else {
        print(3)
    }
    if n != n {
        print(4)
    }
}
