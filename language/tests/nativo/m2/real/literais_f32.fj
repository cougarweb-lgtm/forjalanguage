// literais_f32.fj - literais f32 (strtof do texto %.9g do double) em local, temporario, parametro e retorno; lidos por f32 -> f64 -> int.

proc ver(x: f32) {
    print((x as f64 * 100000000000000000.0) as int)
}

proc devolve(a: f32) -> f32 {
    return a
}

proc main() {
    let a: f32 = 1.5
    let b: f32 = 0.1
    let c: f32 = 16777217.0
    let d: f32 = 0.3
    let e: f32 = 3.14159265
    let f: f32 = 0.000001
    ver(a)
    ver(b)
    ver(c)
    ver(d)
    ver(e)
    ver(f)
    ver(devolve(0.3))
    ver(devolve(-2.25))
    ver(devolve(0.1) + 0.2)
    let grande: f32 = 340282350000000000000000000000000000000.0
    print(grande > 340282340000000000000000000000000000000.0)
    print(grande == 340282346638528859811704183484516925440.0)
}
