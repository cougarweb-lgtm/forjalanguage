// f64_f32.fj - f32 <-> f64: alargar e exato, estreitar arredonda para o mais proximo; lido por real * 1e17 -> int.

proc main() {
    let a: f32 = 0.1
    let b: f64 = a as f64
    print((b * 100000000000000000.0) as int)
    let c: f64 = 0.1
    let d: f32 = c as f32
    print((d as f64 * 100000000000000000.0) as int)
    let e: f64 = 1000000000000000000000000000000000000000.0
    let f: f32 = e as f32
    print(f > 340282350000000000000000000000000000000.0)
    let g: f64 = 0.00000000000000000000000000000000000000000000000001
    let h: f32 = g as f32
    print(h == 0.0)
    let i: f64 = 16777217.0
    print((i as f32) as int)
    print(b == c)
    print(d == a)
}
