// conv_real_sem_sinal.fj - uint e u64 -> real (sequencia do gcc para o bit alto) e real -> u64; lido por comparacao e por real -> int.

proc main() {
    let a: u64 = 18446744073709551615
    let b: u64 = 9223372036854775808
    let c: u64 = 12345
    let d: uint = 18446744073709550000
    print((a as f64) > 18446744073709551000.0)
    print((a as f32) == 18446744073709551616.0)
    print((b as f64) == 9223372036854775808.0)
    print((c as f64) as int)
    print((c as f32) as int)
    print((d as f64) > 18446744073709549000.0)
    print((d as f64) < 18446744073709551616.0)
    let e: f64 = 18446744073709549568.0
    print(e as u64)
    let f: f64 = 9223372036854775808.0
    print(f as u64)
}
