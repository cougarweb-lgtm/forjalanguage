// conv_real_int.fj - real -> inteiro que cabe: trunca para zero, f32 e f64, varias larguras.

proc main() {
    let a: f64 = 3.9
    let b: f64 = -3.9
    let c: f32 = 255.5
    let d: f32 = -128.9
    let e: f64 = 4294967295.9
    let f: f64 = 9007199254740992.0
    let z: f64 = -0.5
    print(a as i32)
    print(b as i32)
    print(c as u8)
    print(d as i8)
    print(e as u32)
    print(f as i64)
    print(z as i32)
    print(a as int)
    print(c as u16)
    print(e as uint)
    print(d as i16)
    print(b as i8)
    print(c as i32)
}
