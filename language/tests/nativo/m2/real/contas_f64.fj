// contas_f64.fj - + - * / e negacao em f64, em varios parametros (xmm e pilha); lido por f64 * 1e17 -> int.

proc ver(x: f64) {
    print((x * 100000000000000000.0) as int)
}

proc soma6(a: f64, b: f64, c: f64, d: f64, e: f64, f: f64) -> f64 {
    return a + b + c + d + e + f
}

proc main() {
    let a: f64 = 0.1
    let b: f64 = 0.2
    ver(a + b)
    ver(a * b)
    ver(a - b)
    ver(a / b)
    ver(-a)
    ver(1.0 / 3.0)
    ver(soma6(0.1, b = 0.2, c = 0.3, d = 0.4, e = 0.5, f = 0.6))
    let t: f64 = 2.0
    ver(t * t * t)
    ver(0.1 + 0.2 + 0.3)
    ver(0.3 + 0.2 + 0.1)
}
