// struct_por_valor.fj - struct como parametro: tamanhos 1, 2, 3, 4, 5, 6, 7, 8, 12, 16, 24 e 40 bytes nas posicoes 1..6 (o 5o e o 6o na pilha), misturados a int e f32; a copia e do chamado.

struct S1 {
    a: u8
}

struct S2 {
    a: u16
}

struct S3 {
    a: u8
    b: u8
    c: u8
}

struct S4 {
    a: i32
}

struct S5 {
    a: u8
    b: u8
    c: u8
    d: u8
    e: u8
}

struct S6 {
    a: u8
    b: u8
    c: u8
    d: u8
    e: u8
    f: u8
}

struct S7 {
    a: u8
    b: u8
    c: u8
    d: u8
    e: u8
    f: u8
    g: u8
}

struct S8 {
    a: int
}

struct S12 {
    a: i32
    b: i32
    c: i32
}

struct S16 {
    a: int
    b: int
}

struct S24 {
    a: int
    b: int
    c: int
}

struct S40 {
    a: int
    b: int
    c: int
    d: int
    e: int
}

proc soma1(x: S1) -> int {
    return x.a as int
}

proc soma2(x: S2) -> int {
    return x.a as int
}

proc soma3(x: S3) -> int {
    return (x.a as int) + (x.b as int) * 10 + (x.c as int) * 100
}

proc soma4(x: S4) -> int {
    return x.a as int
}

proc soma5(x: S5) -> int {
    return (x.a as int) + (x.b as int) * 10 + (x.c as int) * 100 + (x.d as int) * 1000 + (x.e as int) * 10000
}

proc soma6(x: S6) -> int {
    return (x.a as int) + (x.b as int) * 10 + (x.c as int) * 100 + (x.d as int) * 1000 + (x.e as int) * 10000 + (x.f as int) * 100000
}

proc soma7(x: S7) -> int {
    return (x.a as int) + (x.b as int) * 10 + (x.c as int) * 100 + (x.d as int) * 1000 + (x.e as int) * 10000 + (x.f as int) * 100000 + (x.g as int) * 1000000
}

proc soma8(x: S8) -> int {
    return x.a
}

proc soma12(x: S12) -> int {
    return (x.a as int) + (x.b as int) * 10 + (x.c as int) * 100
}

proc soma16(x: S16) -> int {
    return x.a + x.b * 10
}

proc soma24(x: S24) -> int {
    return x.a + x.b * 10 + x.c * 100
}

proc soma40(x: S40) -> int {
    return x.a + x.b * 10 + x.c * 100 + x.d * 1000 + x.e * 10000
}

proc seis(a: S3, b: S12, c: S1, d: S16, e: S5, g: S40) -> int {
    print(soma3(a))
    print(soma12(b))
    print(soma1(c))
    print(soma16(d))
    print(soma5(e))
    print(soma40(g))
    return soma3(a) + soma12(b) + soma1(c) + soma16(d) + soma5(e) + soma40(g)
}

proc mistura(n: int, v: S8, f: f32, w: S4, t: S2, u: S6) -> int {
    print(n)
    print(soma8(v))
    print((f * 100.0) as int)
    print(soma4(w))
    print(soma2(t))
    print(soma6(u))
    return n + soma8(v) + soma4(w) + soma2(t) + soma6(u)
}

proc altera(x: S12) -> int {
    var y = x
    y.a = 1000
    y.c = y.a + y.b
    return soma12(y) + soma12(x)
}

proc altera_pequena(x: S4) -> int {
    var y = x
    y.a = y.a * 3
    return soma4(y) + soma4(x)
}

proc encaminha(x: S24, y: S7) -> int {
    return soma24(x) + soma7(y)
}

proc main() {
    let s1 = S1{a = 200}
    let s2 = S2{a = 60000}
    let s3 = S3{a = 1, b = 2, c = 3}
    let s4 = S4{a = -7}
    let s5 = S5{a = 1, b = 2, c = 3, d = 4, e = 5}
    let s6 = S6{a = 9, b = 8, c = 7, d = 6, e = 5, f = 4}
    let s7 = S7{a = 1, b = 1, c = 1, d = 1, e = 1, f = 1, g = 1}
    let s8 = S8{a = -9000000000}
    let s12 = S12{a = 5, b = 6, c = 7}
    let s16 = S16{a = 11, b = 12}
    let s24 = S24{a = 21, b = 22, c = 23}
    let s40 = S40{a = 1, b = 2, c = 3, d = 4, e = 5}
    print(soma1(s1))
    print(soma2(s2))
    print(soma3(s3))
    print(soma4(s4))
    print(soma5(s5))
    print(soma6(s6))
    print(soma7(s7))
    print(soma8(s8))
    print(soma12(s12))
    print(soma16(s16))
    print(soma24(s24))
    print(soma40(s40))
    print(seis(s3, b = s12, c = s1, d = s16, e = s5, g = s40))
    print(mistura(42, v = s8, f = 1.25, w = s4, t = s2, u = s6))
    print(altera(s12))
    print(s12.a)
    print(s12.c)
    print(altera_pequena(s4))
    print(s4.a)
    print(encaminha(s24, y = s7))
}
