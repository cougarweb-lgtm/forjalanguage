// corpus_amostra.fj - copia dos 6 procs do 1o grupo do corpus_200000 (f0, s0, w0, m0, d0, p0, com a struct E0 e as units) com o main do mesmo grupo; o corpus em si nao e tocado.

unit Metros: f32
unit Segundos: f32
unit MetrosPorSegundo = Metros/Segundos

proc f0(a: int, b: int = 4, c: int = 29) -> int {
    var r = a * b + c
    if r > 1447 {
        r = r - 1447
    } else {
        r = r + 23
    }
    return r
}

proc s0(n: int, passo: int = 2) -> int {
    var acc = 0
    for i in 0..<n {
        acc += i * passo
        if acc > 499 {
            acc -= 499
        }
    }
    return acc
}

proc w0(limite: int, inc: int = 5) -> int {
    var x = 0
    var passos = 0
    while x < limite {
        x += inc
        passos += 1
    }
    return passos
}

struct E0 {
    vida: i32 in 0..=100 = 48
    x: int = 0
    y: int = 6
}

proc m0(e: ^E0, passos: int) {
    e.x += passos * e.y
    e.vida -= 5
}

proc d0(v: MetrosPorSegundo, dt: Segundos = 0.75) -> Metros {
    return v * dt
}

proc p0(n: int, m: int = 5) -> bool {
    return n % m == 0 and n > 25
}

proc main() {
    print(f0(12, b = 4, c = 88))
    print(s0(17, passo = 3))
    print(w0(66, inc = 7))
    var e0 = E0{y = 3}
    m0(&e0, passos = 17)
    m0(&e0, passos = 21)
    print(e0.x)
    print(e0.vida)
    let dist0: Metros = d0(2.0, dt = 1.75)
    print(dist0 as int)
    print(p0(400, m = 2))
}
