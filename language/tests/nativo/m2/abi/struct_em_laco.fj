// struct_em_laco.fj - 1e5 chamadas com copia de struct por valor (pequena em registrador, media por ponteiro) acumulando; o estado volta e vai por valor.

struct Estado {
    acc: int
    passo: int
    marca: int
}

struct Pequeno {
    a: i32
    b: i32
}

proc avanca(e: Estado) -> Estado {
    var r = e
    r.acc = e.acc + e.passo
    r.marca = (e.marca + 1) % 7
    return r
}

proc mistura(p: Pequeno, k: i32) -> Pequeno {
    return Pequeno{a = p.b, b = (p.a + k) % 1000}
}

proc main() {
    var e = Estado{acc = 0, passo = 3, marca = 0}
    var p = Pequeno{a = 1, b = 2}
    for i in 0..<100000 {
        e = avanca(e)
        p = mistura(p, k = (i % 10) as i32)
    }
    print(e.acc)
    print(e.marca)
    print(p.a)
    print(p.b)
}
