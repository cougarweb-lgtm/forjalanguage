// struct_f32.fj - Vector2 (8 B) e Vector3 (12 B) de f32 por valor, como nas libs 3D: struct de reais vai no registrador INTEIRO (8 B) ou por ponteiro (12 B), nunca em xmm.

struct Vec2 {
    x: f32
    y: f32
}

struct Vec3 {
    x: f32
    y: f32
    z: f32
}

proc soma2(a: Vec2, b: Vec2) -> Vec2 {
    return Vec2{x = a.x + b.x, y = a.y + b.y}
}

proc soma3(a: Vec3, b: Vec3) -> Vec3 {
    return Vec3{x = a.x + b.x, y = a.y + b.y, z = a.z + b.z}
}

proc escala3(v: Vec3, k: f32) -> Vec3 {
    return Vec3{x = v.x * k, y = v.y * k, z = v.z * k}
}

proc escala2(k: f32, v: Vec2) -> Vec2 {
    return Vec2{x = v.x * k, y = v.y * k}
}

proc dot3(a: Vec3, b: Vec3) -> f32 {
    return a.x * b.x + a.y * b.y + a.z * b.z
}

proc mostra2(v: Vec2) {
    print((v.x * 100.0) as int)
    print((v.y * 100.0) as int)
}

proc mostra3(v: Vec3) {
    print((v.x * 100.0) as int)
    print((v.y * 100.0) as int)
    print((v.z * 100.0) as int)
}

proc main() {
    let a = Vec2{x = 1.5, y = -2.25}
    let b = Vec2{x = 0.5, y = 4.0}
    mostra2(soma2(a, b = b))
    mostra2(escala2(2.0, v = soma2(a, b = b)))
    let p = Vec3{x = 1.0, y = 2.0, z = 3.0}
    let q = Vec3{x = -0.5, y = 0.25, z = 10.0}
    mostra3(soma3(p, b = q))
    mostra3(escala3(soma3(p, b = q), k = 0.5))
    print((dot3(p, b = q) * 100.0) as int)
    print((dot3(escala3(p, k = 2.0), b = escala3(q, k = 3.0)) * 100.0) as int)
}
