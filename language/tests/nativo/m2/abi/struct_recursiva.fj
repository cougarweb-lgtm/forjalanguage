// struct_recursiva.fj - retorno grande (40 B, ponteiro oculto) em recursao de 20 niveis, e struct de 24 B como parametro e retorno ao mesmo tempo.

struct Acum {
    soma: int
    produto: int
    minimo: int
    maximo: int
    passos: int
}

struct Par3 {
    a: int
    b: int
    c: int
}

proc acumula(n: int) -> Acum {
    if n == 0 {
        return Acum{soma = 0, produto = 1, minimo = 1000, maximo = -1000, passos = 0}
    }
    let r = acumula(n - 1)
    var s = r
    s.soma = r.soma + n
    s.produto = r.produto * n
    if n < s.minimo {
        s.minimo = n
    }
    if n > s.maximo {
        s.maximo = n
    }
    s.passos = r.passos + 1
    return s
}

proc gira(p: Par3, n: int) -> Par3 {
    if n == 0 {
        return p
    }
    return gira(Par3{a = p.b, b = p.c, c = p.a + 1}, n = n - 1)
}

proc main() {
    let r = acumula(20)
    print(r.soma)
    print(r.produto)
    print(r.minimo)
    print(r.maximo)
    print(r.passos)
    let g = gira(Par3{a = 1, b = 2, c = 3}, n = 20)
    print(g.a)
    print(g.b)
    print(g.c)
}
