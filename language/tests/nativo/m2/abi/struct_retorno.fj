// struct_retorno.fj - struct como retorno: 1, 2, 3, 4, 8 (em RAX ou por ponteiro oculto), 12, 16 e 40 bytes, encadeado f(g(x)), descartado e dentro de expressoes.

struct R1 {
    a: u8
}

struct R3 {
    a: u8
    b: u8
    c: u8
}

struct R4 {
    a: i32
}

struct R8 {
    a: i32
    b: i32
}

struct R12 {
    a: i32
    b: i32
    c: i32
}

struct R16 {
    a: int
    b: int
}

struct R40 {
    a: int
    b: int
    c: int
    d: int
    e: int
}

proc faz1(n: int) -> R1 {
    return R1{a = (n % 200) as u8}
}

proc faz3(n: int) -> R3 {
    return R3{a = n as u8, b = (n + 1) as u8, c = (n + 2) as u8}
}

proc faz4(n: int) -> R4 {
    return R4{a = (n * 1000) as i32}
}

proc faz8(n: int) -> R8 {
    return R8{a = n as i32, b = -(n as i32)}
}

proc faz12(n: int) -> R12 {
    return R12{a = n as i32, b = (n * 2) as i32, c = (n * 3) as i32}
}

proc faz16(n: int) -> R16 {
    return R16{a = n, b = n * n}
}

proc faz40(n: int) -> R40 {
    return R40{a = n, b = n + 1, c = n + 2, d = n + 3, e = n + 4}
}

proc dobra12(x: R12) -> R12 {
    return R12{a = x.a * 2, b = x.b * 2, c = x.c * 2}
}

proc soma40(x: R40) -> R40 {
    return R40{a = x.a + 1, b = x.b + 1, c = x.c + 1, d = x.d + 1, e = x.e + 1}
}

proc repassa16(x: R16) -> R16 {
    return x
}

proc repassa3(x: R3) -> R3 {
    var y = x
    y.b = 99
    return y
}

proc main() {
    let a = faz1(250)
    print(a.a)
    let b = faz3(7)
    print(b.a)
    print(b.b)
    print(b.c)
    let c = faz4(5)
    print(c.a)
    let d = faz8(9)
    print(d.a)
    print(d.b)
    let e = faz12(4)
    print(e.a)
    print(e.b)
    print(e.c)
    let f = faz16(12)
    print(f.a)
    print(f.b)
    let g = faz40(100)
    print(g.a)
    print(g.b)
    print(g.c)
    print(g.d)
    print(g.e)
    let h = dobra12(dobra12(faz12(3)))
    print(h.a)
    print(h.b)
    print(h.c)
    let i = soma40(soma40(faz40(1)))
    print(i.a)
    print(i.e)
    let j = repassa16(faz16(5))
    print(j.a + j.b)
    let k = repassa3(b)
    print(k.a)
    print(k.b)
    print(b.b)
    _ = faz40(1)
    _ = faz12(2)
    print(faz12(8).c + faz12(9).b)
    var m = faz12(1)
    m = faz12(50)
    print(m.c)
}
