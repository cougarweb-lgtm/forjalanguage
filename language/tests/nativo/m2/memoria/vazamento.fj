// vazamento.fj - dois blocos de heap sem delete (um terceiro e liberado): dev acusa R0009 no fim (exit 101, stdout anterior preservado); release sai com 0 sem relatar.

struct Grifo {
    vida: i32 = 7
    x: int = 0
}

proc criar(x: int) -> ^Grifo {
    let g = new(Grifo, alloc = heap)
    g.vida = 7
    g.x = x
    return g
}

proc main() {
    let a = criar(5)
    let b = criar(6)
    let c = criar(7)
    delete(c)
    print(a.x + b.x)
}
