// modos: dev
// pool_r0008.fj - devolver ao Pool um bloco que nasceu em outro Pool falha R0008 em dev; em release nao confere.
import "std:mem"

proc main() {
    let a = mem.pool_create()
    let b = mem.pool_create()
    let p = new(int, alloc = a)
    p^ = 1
    print(p^)
    delete(p, alloc = b)
    print(2)
}
