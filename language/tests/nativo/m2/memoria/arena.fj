// arena.fj - Arena (std:mem) dentro do proc: new em varios blocos, arena_used, arena_reset e arena_destroy.
import "std:mem"

struct Grifo {
    vida: i32 = 100
    x: int = 0
}

proc preencher(a: mem.Arena) -> int {
    var total = 0
    for i in 0..<10 {
        let g = new(Grifo, alloc = a)
        g.x = i
        g.vida = 100
        total += g.x + g.vida as int
    }
    return total
}

proc main() {
    let a = mem.arena_create(64)
    print(preencher(a))
    print(mem.arena_used(a) > 0)
    mem.arena_reset(a)
    print(mem.arena_used(a))
    print(preencher(a))
    mem.arena_destroy(a)
}
