// pool.fj - Pool (std:mem): new em Pool, pool_live, delete(em = pool) e reaproveitamento do bloco devolvido.
import "std:mem"

struct Grifo {
    vida: i32 = 100
    x: int = 0
}

proc main() {
    let p = mem.pool_create()
    let q = new(Grifo, alloc = p)
    q.vida = 55
    let r = new(Grifo, alloc = p)
    r.vida = 77
    print(mem.pool_live(p))
    delete(q, alloc = p)
    print(mem.pool_live(p))
    print(r.vida)
    delete(r, alloc = p)
    print(mem.pool_live(p))
    mem.pool_destroy(p)
}
