// lista_fatia.fj - fatia de lista ([lo..<hi], [lo..=hi], [..]) passada a proc que recebe []T, len da fatia e for de colecao.

proc total(v: []int) -> int {
    var t = 0
    for x in v {
        t += x
    }
    return t
}

proc main() {
    var l = make([dynamic]int, alloc = heap, cap = 2)
    for i in 1..=6 {
        append(&l, item = i * 10)
    }
    let s = l[1..<4]
    print(len(s))
    print(s[0])
    print(total(s))
    let t = l[2..=5]
    print(len(t))
    print(total(t))
    let u = l[..]
    print(len(u))
    print(total(u))
    delete(l)
}
