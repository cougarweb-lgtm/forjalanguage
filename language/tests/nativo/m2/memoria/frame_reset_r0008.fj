// modos: dev
// frame_reset_r0008.fj - lista do frame usada depois do frame_reset falha R0008 em dev; em release o conteudo e indefinido.

proc main() {
    var l = make([dynamic]int, alloc = frame, cap = 4)
    append(&l, item = 7)
    print(l[0])
    frame_reset()
    print(1)
    print(l[0])
    print(2)
}
