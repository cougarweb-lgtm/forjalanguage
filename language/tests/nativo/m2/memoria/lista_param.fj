// lista_param.fj - ^[dynamic]T em proc: append, len, indice, for de colecao e delete pelo ponteiro; lista de struct.

struct Bala {
    vida: i32 = 100
    x: int = 0
}

proc encher(l: ^[dynamic]int, n: int) {
    for i in 0..<n {
        append(l, item = i * i)
    }
}

proc somar(l: ^[dynamic]int) -> int {
    var s = 0
    for v in l {
        s += v
    }
    return s
}

proc disparar(balas: ^[dynamic]Bala, x: int) {
    append(balas, item = Bala{x = x})
}

proc main() {
    var q = make([dynamic]int, alloc = heap)
    encher(&q, n = 20)
    print(len(q))
    print(q[19])
    print(somar(&q))
    let p = &q
    print(p[3])
    print(len(p))
    delete(p^)
    print(len(q))
    var balas = make([dynamic]Bala, alloc = heap)
    disparar(&balas, x = 3)
    disparar(&balas, x = 4)
    balas[1].vida -= 40
    print(balas[1].vida)
    print(balas[0].x + balas[1].x)
    delete(balas)
}
