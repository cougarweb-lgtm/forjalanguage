// modos: dev
// liberar_duplo.fj - delete duas vezes no mesmo bloco falha R0008 em dev; em release e comportamento indefinido.
// M6e P93b: delete(p) zera o nome p, entao o duplo vai por ponteiro guardado em estrutura (delete(c.p) nao zera).

struct Caixa {
    p: ^int
}

proc main() {
    let c = Caixa{p = new(int, alloc = heap)}
    c.p^ = 3
    print(c.p^)
    delete(c.p)
    print(1)
    delete(c.p)
    print(2)
}
