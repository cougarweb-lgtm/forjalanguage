// lista_append.fj - 1000 anexos no heap (cap 0 -> 8 -> 16 -> ...), indice, escrita por indice, soma, for de colecao e delete (a lista volta a len 0).

proc main() {
    var l = make([dynamic]int, alloc = heap)
    for i in 0..<1000 {
        append(&l, item = i * 3)
    }
    print(len(l))
    print(l[0])
    print(l[999])
    l[500] = -1
    l[501] += 2
    print(l[500] + l[501])
    var soma = 0
    for x in l {
        soma += x
    }
    print(soma)
    var m = make([dynamic]u8, alloc = heap, cap = 2)
    append(&m, item = 200)
    append(&m, item = 55)
    append(&m, item = 1)
    print(len(m))
    print(m[0] + m[1])
    delete(m)
    print(len(m))
    delete(l)
    print(len(l))
}
