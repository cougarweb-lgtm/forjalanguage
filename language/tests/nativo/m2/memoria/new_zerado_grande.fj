// new_zerado_grande.fj - new([N]T) sem valor inicial: N >= 1024 zera o bloco no proprio IR_ALOCA (IR_ALOCA_ZERADO) e nao passa pela pilha; abaixo disso segue o caminho antigo.
// [1400000]f32 = 5,3 MiB estourava a reserva de 2 MiB da pilha do x64 (0xC00000FD).

proc somar_real(p: ^[1400000]f32) -> f32 {
    var soma: f32 = 0.0
    for i in 0..<1400000 {
        soma += p[i]
    }
    return soma
}

proc contar_diferentes_de_zero(p: ^[1024]int) -> int {
    var n: int = 0
    for i in 0..<1024 {
        if p[i] != 0 {
            n += 1
        }
    }
    return n
}

proc main() {
    let grande = new([1400000]f32, alloc = heap)
    print(somar_real(grande) as int)
    grande[0] = 1.5
    grande[1399999] = 2.5
    print((somar_real(grande) * 2.0) as int)
    delete(grande)

    let limite = new([1024]int, alloc = heap)
    print(contar_diferentes_de_zero(limite))
    limite[0] = 9
    limite[1023] = -4
    print(contar_diferentes_de_zero(limite))
    print(limite[1023])
    delete(limite)

    let pequeno = new([4]int, alloc = heap)
    print(pequeno[0] + pequeno[3])
    delete(pequeno)
}
