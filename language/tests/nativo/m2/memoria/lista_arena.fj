// lista_arena.fj - lista e new numa Arena (std:mem): cresce pela Arena, delete da lista da Arena e arena_destroy no fim.
import "std:mem"

proc main() {
    let a = mem.arena_create(64)
    var l = make([dynamic]int, alloc = a)
    for i in 0..<20 {
        append(&l, item = i * 2)
    }
    print(len(l))
    print(l[19])
    let p = new(int, alloc = a)
    p^ = l[3] + 1
    print(p^)
    delete(l)
    print(len(l))
    mem.arena_destroy(a)
}
