// frame.fj - new no frame em varios quadros: frame_reset volta o topo a zero; delete de bloco do frame nao faz nada.

proc main() {
    var quadro = 0
    while quadro < 3 {
        let p = new(int, alloc = frame)
        p^ = quadro * 100
        let q = new(i32, alloc = frame)
        q^ = (quadro + 1) as i32
        print(p^)
        print(q^)
        delete(p)
        frame_reset()
        quadro += 1
    }
}
