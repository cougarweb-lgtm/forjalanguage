// lista_frame.fj - lista no frame (com cap 1, cresce pelo frame), lida antes do frame_reset; o quadro seguinte cria outra.

proc main() {
    var quadro = 0
    while quadro < 3 {
        var l = make([dynamic]int, alloc = frame, cap = 1)
        for i in 0..<5 {
            append(&l, item = i + quadro)
        }
        print(l[4])
        print(len(l))
        delete(l)
        frame_reset()
        quadro += 1
    }
}
