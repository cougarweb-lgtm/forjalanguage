// new_heap.fj - new no heap (int, struct), uso pelo ponteiro, delete e new de novo; nada vaza.

struct Grifo {
    vida: i32 = 100
    x: int = 0
}

proc main() {
    let p = new(int, alloc = heap)
    p^ = 41
    p^ += 1
    print(p^)
    delete(p)
    let g = new(Grifo, alloc = heap)
    g.x = 7
    g.vida -= 25
    print(g.x)
    print(g.vida)
    delete(g)
    let q = new(i32, alloc = heap)
    q^ = -9
    print(q^)
    delete(q)
}
