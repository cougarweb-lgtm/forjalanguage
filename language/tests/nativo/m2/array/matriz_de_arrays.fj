// matriz_de_arrays.fj - [4][4]i32: array de arrays (elemento agregado de 16 B), escrita em duas camadas, copia de linha e soma por dois for.

proc main() {
    var m: [4][4]i32 = {}
    for i in 0..<4 {
        for j in 0..<4 {
            m[i][j] = (i * 10 + j) as i32
        }
    }
    print(m[0][0])
    print(m[1][2])
    print(m[3][3])
    let linha = m[2]
    m[2][0] = 99
    print(linha[0])
    print(m[2][0])
    var soma: int = 0
    for i in 0..<4 {
        for j in 0..<4 {
            soma += m[i][j] as int
        }
    }
    print(soma)
    let pronta: [2][3]int = {{1, 2, 3}, {4, 5, 6}}
    print(pronta[1][2] + pronta[0][0])
}
