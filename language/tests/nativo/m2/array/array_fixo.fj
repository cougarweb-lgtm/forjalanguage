// array_fixo.fj - [N]T por valor: literal, zero, leitura, escrita direta e por ^[N]T, len e for de colecao.

proc encher(p: ^[5]int, base: int) {
    for i in 0..<5 {
        p[i] = base + i * 2
    }
}

proc main() {
    var a: [4]int = {10, 20, 30, 40}
    print(a[0])
    a[1] = 25
    a[2] += 5
    print(a[1] + a[2])
    print(len(a))
    let z: [3]i32 = {}
    print(z[2])
    let b: [2]u8 = {255, 7}
    print(b[0])
    print(b[1])
    let i = 3
    print(a[i])
    var c: [5]int = {}
    encher(&c, base = 100)
    var soma: int = 0
    for x in c {
        soma += x
    }
    print(soma)
    for x in a {
        print(x)
    }
    let flags: [3]bool = {true, false, true}
    print(flags[0])
    print(flags[1])
    let reais: [2]f32 = {1.5, 2.25}
    print((reais[1] * 4.0) as int)
    let curtos: [3]i16 = {-1, 2, 300}
    print(curtos[0])
    print(curtos[2])
    let copia = a
    a[0] = 99
    print(copia[0])
    print(a[0])
}
