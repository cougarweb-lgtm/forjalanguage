// modos: dev
// fatia_fora.fj - a[2..<5] num array de 3 falha R0006 em dev ("fatia 2..<5 fora de 0..=3"); em release a fatia sai sem conferir.

proc main() {
    var a: [3]int = {1, 2, 3}
    let fim = 5
    print(a[0])
    let ok = a[1..<3]
    print(len(ok))
    let s = a[2..<fim]
    print(len(s))
}
