// array_grande.fj - [600000]u8 local: quadro maior que 512 KiB (UWOP_ALLOC_LARGE com sondagem de paginas), preenchido por ^[N]T e somado.

const TAMANHO: int = 600000

proc preencher(p: ^[600000]u8) {
    for i in 0..<TAMANHO {
        p[i] = (i % 251) as u8
    }
}

proc somar(p: ^[600000]u8) -> int {
    var total: int = 0
    for i in 0..<TAMANHO {
        total += p[i] as int
    }
    return total
}

proc main() {
    var grande: [600000]u8 = {}
    print(somar(&grande))
    preencher(&grande)
    print(somar(&grande))
    print(grande[0])
    print(grande[599999])
    grande[12345] = 200
    print(grande[12345])
}
