// fatia_vazia.fj - fatia vazia ({} e a[k..<k]), len 0, for sobre fatia vazia e a fatia inclusiva de um elemento.

proc soma(s: []int) -> int {
    var total = 0
    for x in s {
        total += x
    }
    return total
}

proc main() {
    var a: [3]int = {7, 8, 9}
    let fv: []int = {}
    print(len(fv))
    print(soma(fv))
    let vazia = a[2..<2]
    print(len(vazia))
    print(soma(vazia))
    let fim = a[3..<3]
    print(len(fim))
    let um = a[1..=1]
    print(len(um))
    print(um[0])
}
