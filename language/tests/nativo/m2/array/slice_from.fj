// slice_from.fj - slice_from(p, len = n) sobre um vetor da propria Forja (^T do primeiro elemento): fatia emprestada, len int, i32 e u32, e ?^T nulo com len 0.

proc soma(v: []i32) -> int {
    var total: int = 0
    for x in v {
        total = total + x as int
    }
    return total
}

proc main() {
    var a: [5]i32 = {10, 20, 30, 40, 50}
    let p = &a[0]
    let v = slice_from(p, len = 5)
    print(len(v))
    print(soma(v))
    v[1] = 25
    print(a[1])
    let meio = v[1..<4]
    print(len(meio))
    print(meio[2])
    let n: i32 = 3
    let w = slice_from(p, len = n)
    print(len(w))
    print(w[2])
    let m: u32 = 4
    let x = slice_from(p, len = m)
    print(len(x))
    print(x[3])
    let nulo: ?^i32 = none
    let vazio = slice_from(nulo, len = 0)
    print(len(vazio))
    let opcional: ?^i32 = p
    let o = slice_from(opcional, len = 2)
    print(o[1])
}
