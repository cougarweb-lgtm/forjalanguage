// array_struct.fj - [3]struct: literal, campo por indice, copia de elemento, & de elemento, struct com array dentro.

struct Grifo {
    vida: i32 = 10
    pos: [3]i32 = {0, 0, 0}
}

proc empurrar(g: ^Grifo, passo: i32) {
    g.pos[0] += passo
}

proc main() {
    var bando: [3]Grifo = {Grifo{}, Grifo{vida = 50}, Grifo{}}
    bando[1].vida -= 20
    bando[2].pos[2] = 9
    print(bando[1].vida)
    print(bando[2].pos[2])
    empurrar(&bando[0], passo = 4)
    print(bando[0].pos[0])
    let p = &bando[2]
    p.vida = 1
    print(bando[2].vida)
    let c = bando[2]
    print(c.pos[2])
    var g = Grifo{}
    g.pos[1] = 5
    empurrar(&g, passo = 7)
    print(g.pos[0])
    print(g.pos[1])
    var total: int = 0
    for k in 0..<3 {
        total += bando[k].vida as int
    }
    print(total)
    for item in bando {
        print(item.vida)
    }
}
