// fatia.fj - []T: a[..], a[lo..<hi], a[lo..=hi], fatia de fatia, escrita pela fatia (visao, nao copia), len, parametro, retorno e for de colecao.

proc somar(s: []int) -> int {
    var total = 0
    for i in 0..<len(s) {
        total += s[i]
    }
    return total
}

proc cauda(s: []int) -> []int {
    return s[1..<len(s)]
}

proc main() {
    var a: [6]int = {1, 2, 3, 4, 5, 6}
    let tudo = a[..]
    print(len(tudo))
    print(somar(tudo))
    let meio = a[1..<4]
    print(len(meio))
    print(somar(meio))
    print(somar(a[3..=5]))
    let sub = meio[1..<3]
    print(sub[0])
    sub[1] = 40
    print(a[3])
    let c = cauda(tudo)
    print(len(c))
    print(c[0])
    var soma = 0
    for x in meio {
        soma += x
    }
    print(soma)
    let p = &a
    let q = p[2..<5]
    q[0] = 30
    print(a[2])
    var bytes: [4]u8 = {1, 2, 3, 4}
    let bs = bytes[1..=2]
    print(bs[0])
    print(bs[1])
    print(len(bs))
}
