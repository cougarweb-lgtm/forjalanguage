// array_param.fj - [N]T por valor de 24 B (copia privada do chamado), retorno de array e ^[N]T.

proc dobrar(v: [3]int) -> [3]int {
    var r = v
    for k in 0..<3 {
        r[k] = v[k] * 2
    }
    return r
}

proc zerar_primeiro(v: [3]int) {
    var copia = v
    copia[0] = 0
    print(copia[0])
}

proc alterar(v: [3]int) -> int {
    var w = v
    w[1] = 77
    return w[1]
}

proc somar(p: ^[3]int) -> int {
    return p[0] + p[1] + p[2]
}

proc marcar(p: ^[3]int) {
    p[2] = 5
}

proc minusculo(v: [2]u8) -> u8 {
    return v[0] + v[1]
}

proc main() {
    var a: [3]int = {1, 2, 3}
    var b = a
    b[0] = 9
    print(a[0])
    print(b[0])
    let d = dobrar(a)
    print(d[2])
    zerar_primeiro(a)
    print(a[0])
    print(dobrar(a)[1])
    print(alterar(a))
    print(a[1])
    print(somar(&a))
    marcar(&a)
    print(a[2])
    print(somar(&a))
    print(minusculo({100, 55}))
}
