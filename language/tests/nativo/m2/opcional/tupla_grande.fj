// tupla_grande.fj - tupla de 40 B (5 x int) por ponteiro oculto: retorno, repasse, em laco, com struct e ?T dentro, e como valor descartado. Linhas-chave: "15", "120", "70".

struct Par {
    a: int
    b: int
}

proc cinco(n: int) -> (a: int, b: int, c: int, d: int, e: int) {
    return n, n + 1, n + 2, n + 3, n + 4
}

proc misto(n: int) -> (p: Par, o: ?int, t: str, f: f32) {
    if n > 0 {
        return Par{a = n, b = n * 2}, n, "cheio", 1.5
    }
    return Par{}, none, "vazio", 0.25
}

proc repassa(n: int) -> (a: int, b: int, c: int, d: int, e: int) {
    return cinco(n * 10)
}

proc main() {
    let a, b, c, d, e = cinco(1)
    print(a + b + c + d + e)
    let x, _, _, _, v = repassa(3)
    print(x)
    print(v)
    var soma: int = 0
    for i in 0..<4 {
        let p, q, r, s, t = cinco(i)
        soma += p + q + r + s + t
    }
    print(soma)
    let par, op, texto, real = misto(7)
    print(par.a)
    print(par.b)
    print(op or_else -1)
    print(texto)
    print((real * 100.0) as int)
    let par0, op0, texto0, real0 = misto(0)
    print(par0.a)
    print(op0 == none)
    print(texto0)
    print((real0 * 100.0) as int)
    let _, _, meio, _, _ = cinco(30)
    print(meio)
}
