// tupla.fj - retorno multiplo de 2 e 3 valores (int, f32, str, bool, ?enum), let multiplo, `_`, encadeado f(g(x)), repassado por return e tupla de 24 B por ponteiro oculto. Linhas-chave: "3", "2.5", "meio", "0".

enum ErroDiv { por_zero }

proc dividir(a: int, b: int) -> (q: int, r: int) {
    return a / b, a % b
}

proc dividir_seguro(a: int, b: int) -> (q: int, erro: ?ErroDiv) {
    if b == 0 {
        return 0, ErroDiv.por_zero
    }
    return a / b, none
}

proc media(a: f32, b: f32) -> (soma: f32, meio: f32) {
    return a + b, (a + b) / 2.0
}

proc ler(n: int) -> (id: int, escala: f32, nome: str) {
    if n == 0 {
        return 0, 0.5, "zero"
    }
    return n, 2.5, "meio"
}

proc tres_bytes(n: i32) -> (a: u8, b: bool, c: u8) {
    let v: u8 = 7
    return v, n > 0, v + 1
}

proc repassa(a: int) -> (q: int, r: int) {
    defer print(100)
    return dividir(a, b = 3)
}

proc main() {
    let q, r = dividir(17, b = 5)
    print(q)
    print(r)
    var x, _ = dividir(9, b = 2)
    x += 1
    print(x)
    let v, e = dividir_seguro(1, b = 0)
    print(v)
    switch e {
    case ErroDiv:
        print(1)
    case none:
        print(2)
    }
    let w, e2 = dividir_seguro(8, b = 2)
    print(w)
    print(e2 == none)
    let s, m = media(1.5, b = 3.5)
    print(s as int)
    print((m * 10.0) as int)
    let id, escala, nome = ler(4)
    print(id)
    print((escala * 10.0) as int)
    print(nome)
    let id0, escala0, nome0 = ler(0)
    print(id0)
    print((escala0 * 10.0) as int)
    print(nome0)
    let a, b, c = tres_bytes(1)
    print(a)
    print(b)
    print(c)
    let a2, b2, _ = tres_bytes(0)
    print(a2)
    print(b2)
    let p, k = repassa(10)
    print(p + k)
    var soma: int = 0
    for i in 1..<5 {
        let d, resto = dividir(i * 10, b = 3)
        soma += d + resto
    }
    print(soma)
}
