// opcional_escalar.fj - ?i32, ?f64 e ?u8 (2 B: o ?T pequeno cruza a ABI nos proprios bytes) em retorno, parametro, local, none, or_else, == none, array e switch com ligacao. Linhas-chave: "42", "7", "2.5", "200".

proc achar_i32(n: i32) -> ?i32 {
    if n > 0 {
        return n * 2
    }
    return none
}

proc achar_f64(n: i32) -> ?f64 {
    if n > 0 {
        return 2.5
    }
    return none
}

proc achar_u8(n: i32) -> ?u8 {
    let v: u8 = 200
    if n > 0 {
        return v
    }
    return none
}

proc repassa_u8(v: ?u8) -> ?u8 {
    return v
}

proc valor_ou_menos_um(v: ?i32) -> i32 {
    return v or_else -1
}

proc soma_ate(n: i32) -> ?i32 {
    var total: ?i32 = none
    for i in 1..=n {
        total = (total or_else 0) + i
    }
    return total
}

proc main() {
    let a = achar_i32(21)
    let b = achar_i32(0)
    print(a or_else 0)
    print(b or_else 7)
    print(a != none)
    print(b == none)
    print(valor_ou_menos_um(a))
    print(valor_ou_menos_um(b))
    print(valor_ou_menos_um(5))
    switch v in a {
    case i32:
        print(v + 1)
    case none:
        print(0)
    }
    switch b {
    case i32:
        print(1)
    case none:
        print(2)
    }
    let f = achar_f64(1)
    let g = achar_f64(0)
    print(((f or_else 0.0) * 10.0) as int)
    print(((g or_else 1.5) * 10.0) as int)
    switch x in f {
    case f64:
        print((x * 20.0) as int)
    case none:
        print(0)
    }
    let u = achar_u8(1)
    let w = achar_u8(0)
    print(u or_else 0)
    print(w == none)
    print(repassa_u8(u) or_else 1)
    print(repassa_u8(w) or_else 1)
    print(repassa_u8(none) == none)
    let lista: [3]?i32 = {1, none, 3}
    var soma: i32 = 0
    for item in lista {
        soma += item or_else 10
    }
    print(soma)
    print(soma_ate(4) or_else 0)
    print(soma_ate(0) == none)
}
