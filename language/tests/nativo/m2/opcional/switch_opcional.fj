// switch_opcional.fj - switch de ?T e ?^T: ligacao mutavel por copia, &r da ligacao, default, break e continue dentro do caso, switch aninhado e em laco. Linhas-chave: "21", "default", "100".

struct Medida {
    quant: int
    peso: int
}

proc achar(n: int) -> ?int {
    if n < 0 {
        return none
    }
    return n * 3
}

proc medir(n: int) -> ?Medida {
    if n == 0 {
        return none
    }
    return Medida{quant = n, peso = n * 100}
}

proc incrementa(p: ^int) {
    p^ = p^ + 1
}

proc main() {
    switch r in achar(7) {
    case int:
        print(r)
    case none:
        print(-1)
    }
    switch r in achar(-7) {
    case int:
        print(r)
    case none:
        print("none")
    }
    switch achar(-1) {
    case none:
        print("default")
    default:
        print("outro")
    }
    switch achar(1) {
    case none:
        print("default")
    default:
        print("tem")
    }
    switch r in achar(5) {
    case int:
        var q = r
        incrementa(&q)
        incrementa(&q)
        print(q)
        print(r)
    case none:
        print(-1)
    }
    switch m in medir(7) {
    case Medida:
        print(m.quant)
        print(m.peso)
    case none:
        print("sem")
    }
    switch m in medir(0) {
    case Medida:
        print(0)
    case none:
        print("sem")
    }
    var soma: int = 0
    for i in -3..<9 {
        switch r in achar(i) {
        case int:
            soma = soma + r
        case none:
            continue
        }
        if soma > 50 {
            break
        }
    }
    print(soma)
    var total: int = 0
    for i in 0..<5 {
        switch m in medir(i) {
        case Medida:
            total = total + m.peso
            if m.quant == 3 {
                break
            }
        case none:
            total = total + 1
        }
    }
    print(total)
    var g = Medida{quant = 1, peso = 2}
    var p: ?^Medida = &g
    for k in 0..<3 {
        switch v in p {
        case ^Medida:
            v.peso = v.peso + 10
            print(v.peso)
            if k == 1 {
                p = none
            }
        case none:
            print(100)
        }
    }
    switch a in achar(2) {
    case int:
        switch b in achar(a) {
        case int:
            print(a + b)
        case none:
            print(0)
        }
    case none:
        print(0)
    }
}
