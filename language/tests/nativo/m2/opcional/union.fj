// union.fj - union com struct, i32, ^T e str: embrulha (a variante no offset do layout), switch com e sem ligacao, default, por valor em parametro/retorno/array/lista e variante agregada. Linhas-chave: "12", "pedra", "circulo".

struct Circulo {
    raio: f32 = 1.0
}

struct Retangulo {
    largura: f32 = 1.0
    altura: f32 = 1.0
}

struct Grifo {
    vida: i32 = 100
}

union Forma {
    Circulo,
    Retangulo,
    i32
}

union Alvo {
    ^Grifo,
    str,
    int
}

proc area(f: Forma) -> f32 {
    var a: f32 = 0.0
    switch c in f {
    case Circulo:
        a = c.raio * c.raio * 3.0
    case Retangulo:
        a = c.largura * c.altura
    case i32:
        a = 0.5
    }
    return a
}

proc nome(f: Forma) -> str {
    var n = "?"
    switch f {
    case Circulo:
        n = "circulo"
    default:
        n = "outro"
    }
    return n
}

proc fazer(tipo: i32) -> Forma {
    if tipo == 0 {
        return Circulo{raio = 2.0}
    }
    if tipo == 1 {
        return Retangulo{largura = 3.0, altura = 4.0}
    }
    return tipo as i32
}

proc descrever(a: Alvo) {
    switch x in a {
    case ^Grifo:
        x.vida -= 1
        print(x.vida)
    case str:
        print(x)
    case int:
        print(x * 2)
    }
}

proc main() {
    let a: Forma = Circulo{raio = 2.0}
    var b: Forma = Retangulo{largura = 3.0, altura = 5.0}
    print(area(a) as i32)
    print(area(b) as i32)
    print(nome(a))
    print(nome(b))
    b = 9 as i32
    print(area(b) as i32)
    switch n in b {
    case i32:
        print(n)
    default:
        print(0)
    }
    print(area(fazer(0)) as i32)
    print(area(fazer(1)) as i32)
    print(area(fazer(2)) as i32)
    let formas: [3]Forma = {Circulo{}, Retangulo{}, 5 as i32}
    var total: f32 = 0.0
    for x in formas {
        total += area(x)
    }
    print(total as i32)
    var g = Grifo{}
    descrever(&g)
    descrever(&g)
    descrever("pedra")
    descrever(21 as int)
    print(g.vida)
    var lista = make([dynamic]Alvo, alloc = heap)
    append(&lista, item = &g)
    append(&lista, item = "arvore")
    append(&lista, item = 6 as int)
    for item in lista {
        descrever(item)
    }
    delete(lista)
}
