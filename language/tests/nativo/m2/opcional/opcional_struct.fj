// opcional_struct.fj - ?Struct (24 B: tem + struct), ?str, struct com campo ?i32, ?T de struct em parametro, retorno, array e switch com ligacao struct. Linhas-chave: "40", "pedra", "-1".

struct Grifo {
    vida: i32 = 100
    forca: int = 7
    nome: i32 = 3
}

struct Registro {
    id: i32
    nota: ?i32
}

proc criar(vida: i32) -> ?Grifo {
    if vida < 0 {
        return none
    }
    return Grifo{vida = vida}
}

proc melhor(a: ?Grifo, b: Grifo) -> Grifo {
    return a or_else b
}

proc texto(vivo: bool) -> ?str {
    if vivo {
        return "pedra"
    }
    return none
}

proc nota_de(r: Registro) -> i32 {
    return r.nota or_else -1
}

proc main() {
    let a = criar(40)
    let b = criar(-5)
    switch g in a {
    case Grifo:
        print(g.vida)
        print(g.forca)
    case none:
        print(0)
    }
    switch g in b {
    case Grifo:
        print(g.vida)
    case none:
        print("sem grifo")
    }
    print(melhor(a, b = Grifo{}).vida)
    print(melhor(b, b = Grifo{vida = 9}).vida)
    print(melhor(none, b = Grifo{vida = 8}).vida)
    print(melhor(Grifo{vida = 7}, b = Grifo{}).vida)
    let t = texto(true)
    let u = texto(false)
    switch s in t {
    case str:
        print(s)
    case none:
        print("nada")
    }
    print(u == none)
    print((t or_else "x") == "pedra")
    var r = Registro{id = 1, nota = 90}
    print(nota_de(r))
    r.nota = none
    print(nota_de(r))
    r.nota = 5
    print(nota_de(r))
    let vazio = Registro{id = 2}
    print(vazio.nota == none)
    let lista: [3]?Grifo = {Grifo{vida = 1}, none, Grifo{vida = 3}}
    var soma: i32 = 0
    for item in lista {
        switch x in item {
        case Grifo:
            soma += x.vida
        case none:
            soma += 100
        }
    }
    print(soma)
}
