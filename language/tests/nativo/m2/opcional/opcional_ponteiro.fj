// opcional_ponteiro.fj - ?^T e ?cstr (o proprio ponteiro, nulo = none) em parametro, retorno, local, campo de struct, switch com ligacao, or_else e print de cstr. Linhas-chave: "grifo 40", "sem grifo", "pedra".

struct Grifo {
    vida: i32 = 100
}

struct Ninho {
    dono: ?^Grifo
    nome: ?cstr
}

proc achar(g: ^Grifo, quer: bool) -> ?^Grifo {
    if quer {
        return g
    }
    return none
}

proc rotulo(quer: bool) -> ?cstr {
    if quer {
        return "pedra"
    }
    return none
}

proc descrever(p: ?^Grifo) {
    switch g in p {
    case ^Grifo:
        print(g.vida)
    case none:
        print("sem grifo")
    }
}

proc nome_ou(n: ?cstr, padrao: cstr) -> cstr {
    return n or_else padrao
}

proc main() {
    var g = Grifo{vida = 40}
    let p = achar(&g, quer = true)
    let q = achar(&g, quer = false)
    descrever(p)
    descrever(q)
    print(p != none)
    print(q == none)
    let h = q or_else &g
    h.vida = h.vida + 1
    print(g.vida)
    let a = rotulo(true)
    let b = rotulo(false)
    print(a != none)
    print(b == none)
    switch t in a {
    case cstr:
        print(t)
    case none:
        print("nada")
    }
    switch t in b {
    case cstr:
        print(t)
    case none:
        print("nada")
    }
    print(nome_ou(a, padrao = "outro"))
    print(nome_ou(b, padrao = "outro"))
    var n = Ninho{dono = &g, nome = "ninho"}
    switch d in n.dono {
    case ^Grifo:
        print(d.vida)
    case none:
        print(0)
    }
    n.dono = none
    n.nome = none
    print(n.dono == none)
    print(n.nome == none)
    let vazio = Ninho{}
    print(vazio.dono == none)
    print(vazio.nome == none)
}
