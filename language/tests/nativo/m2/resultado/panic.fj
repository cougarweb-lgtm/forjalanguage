// panic.fj - panic("...") dentro de um proc chamado em laco: R0003 "parei na volta 2" nos dois modos, exit 101. Linhas-chave: stdout "0" "1" "2", stderr R0003.

proc volta(i: int) {
    print(i)
    if i == 2 {
        panic("parei na volta 2")
    }
}

proc main() {
    for i in 0..<5 {
        volta(i)
    }
    print(99)
}
