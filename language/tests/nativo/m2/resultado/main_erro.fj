// main_erro.fj - main -> ! E que devolve o 2o membro do enum: stderr R0004 "main devolveu o erro de indice 1", exit 1. Linhas-chave: stdout "7" e "8", exit 1.

enum Erro { primeiro, segundo }

proc prepara(n: i32) -> i32 ! Erro {
    if n > 5 {
        return Erro.segundo
    }
    return n
}

proc main() -> ! Erro {
    print(7)
    let a = try prepara(3)
    print(a + 5)
    let b = try prepara(9)
    print(b)
}
