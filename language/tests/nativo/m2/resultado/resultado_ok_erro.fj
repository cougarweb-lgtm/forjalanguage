// resultado_ok_erro.fj - T ! E com T escalar (i32, int, bool, u8, f32) e struct: ok e erro, lidos por switch, or_else e variavel local. Linhas-chave: "5", "-1", "3" (erro invalido), "1000000000000".

enum Erro { vazio, grande, invalido }

struct Ponto {
    x: i32
    y: i32
    z: int
}

proc metade(n: i32) -> i32 ! Erro {
    if n < 0 {
        return Erro.invalido
    }
    if n > 1000 {
        return Erro.grande
    }
    return n / 2
}

proc dobro(n: int) -> int ! Erro {
    if n == 0 {
        return Erro.vazio
    }
    return n * 2
}

proc par(n: i32) -> bool ! Erro {
    if n < 0 {
        return Erro.invalido
    }
    return n % 2 == 0
}

proc byte(n: i32) -> u8 ! Erro {
    if n > 255 {
        return Erro.grande
    }
    return n as u8
}

proc fracao(n: i32) -> f32 ! Erro {
    if n == 0 {
        return Erro.vazio
    }
    return 1.0 / (n as f32)
}

proc ponto(n: i32) -> Ponto ! Erro {
    if n == 0 {
        return Erro.vazio
    }
    return Ponto{x = n, y = n * 2, z = 1000000000000}
}

proc nome_do_erro(e: Erro) -> i32 {
    switch e {
    case Erro.vazio:
        return 1
    case Erro.grande:
        return 2
    case Erro.invalido:
        return 3
    }
    return 0
}

proc main() {
    print(metade(10) or_else -1)
    print(metade(-4) or_else -1)
    print(metade(5000) or_else -2)
    print(dobro(21) or_else 0)
    print(dobro(0) or_else 77)
    print(par(8) or_else false)
    print(par(-1) or_else true)
    print(byte(200) or_else 9)
    print(byte(256) or_else 9)
    let f4 = fracao(4) or_else 0.5
    let f0 = fracao(0) or_else 0.5
    print((f4 * 100.0) as int)
    print((f0 * 100.0) as int)

    switch r in metade(10) {
    case i32:
        print(r)
    case Erro:
        print("bad")
    }
    switch r in metade(-10) {
    case i32:
        print(r)
    case Erro:
        print(nome_do_erro(r))
    }
    switch p in ponto(3) {
    case Ponto:
        print(p.x)
        print(p.y)
        print(p.z)
    case Erro:
        print("bad")
    }
    switch p in ponto(0) {
    case Ponto:
        print(p.x)
    case Erro:
        print(nome_do_erro(p))
    }
    let guardado = ponto(1) or_else Ponto{x = 0, y = 0, z = 0}
    print(guardado.y)
    let vazio = ponto(0) or_else Ponto{x = -1, y = -2, z = -3}
    print(vazio.z)
}
