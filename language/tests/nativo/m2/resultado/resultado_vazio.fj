// resultado_vazio.fj - "! E" sem T (so a flag e o erro): validacao devolvida por valor, try como comando, switch com case Erro e default. Linhas-chave: "ok 5", "falhou 2".

enum Erro { negativo, grande, zero }

proc validar(n: i32) -> ! Erro {
    if n < 0 {
        return Erro.negativo
    }
    if n > 100 {
        return Erro.grande
    }
    if n == 0 {
        return Erro.zero
    }
}

proc usar(n: i32) -> ! Erro {
    try validar(n)
    print(n)
}

proc codigo(r: i32) -> i32 {
    return r + 1
}

proc main() {
    switch usar(5) {
    case Erro:
        print(0)
    default:
        print(1)
    }
    switch usar(-5) {
    case Erro:
        print(2)
    default:
        print(3)
    }
    switch e in validar(500) {
    case Erro:
        switch e {
        case Erro.negativo:
            print(10)
        case Erro.grande:
            print(11)
        case Erro.zero:
            print(12)
        }
    default:
        print(13)
    }
    switch validar(0) {
    case Erro:
        print(codigo(41))
    default:
        print(0)
    }
    print("ok 5")
}
