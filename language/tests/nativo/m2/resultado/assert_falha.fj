// assert_falha.fj - assert que passa e assert que falha: R0003 "n devia valer 4" nos dois modos (dev e release), exit 101. Linhas-chave: stdout "1" e "2", stderr R0003.

proc main() {
    let n: i32 = 3
    print(1)
    assert(n == 3, msg = "n vale 3")
    assert(n > 0)
    print(2)
    assert(n == 4, msg = "n devia valer 4")
    print(3)
}
