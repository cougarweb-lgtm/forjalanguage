// panic_em_switch.fj - panic e assert dentro de casos de switch (enum e resultado); no lugar do expect_fora_teste do contrato, que o front-end recusa (E0801: expect so existe em test).
// Dev e release: R0003 "caso proibido: 3" (exit 101). Linhas-chave: stdout "10", "20", "30", stderr R0003.

enum Erro { ruim, pior }

proc teste(n: i32) -> i32 ! Erro {
    if n == 2 {
        return Erro.ruim
    }
    if n == 3 {
        return Erro.pior
    }
    return n * 10
}

proc main() {
    for i in 1..<5 {
        switch r in teste(i as i32) {
        case i32:
            print(r)
            assert(r > 0, msg = "valor positivo")
        case Erro:
            switch r {
            case Erro.ruim:
                print(20)
            case Erro.pior:
                print(30)
                panic("caso proibido: 3")
            }
        }
    }
    print(99)
}
