// try.fj - try repassa o erro em 3 niveis (i32, struct e bool) e o valor segue adiante. Linhas-chave: "40" (3 niveis ok), "7" (erro do fundo), "8" (meio), "9" (topo), "99".

enum Erro { fundo, meio, topo }

struct Par {
    a: i32
    b: i32
}

proc nivel3(n: i32) -> i32 ! Erro {
    if n == 3 {
        return Erro.fundo
    }
    return n * 10
}

proc nivel2(n: i32) -> i32 ! Erro {
    let v = try nivel3(n)
    if v == 20 {
        return Erro.meio
    }
    return v + 10
}

proc nivel1(n: i32) -> i32 ! Erro {
    let v = try nivel2(n)
    if v == 110 {
        return Erro.topo
    }
    return v * 2
}

proc par_de(n: i32) -> Par ! Erro {
    let v = try nivel1(n)
    return Par{a = v, b = v + 1}
}

proc soma(n: i32) -> i32 ! Erro {
    let p = try par_de(n)
    let q = try par_de(n + 1)
    return p.a + q.b
}

proc mostra_erro(e: Erro) {
    switch e {
    case Erro.fundo:
        print(7)
    case Erro.meio:
        print(8)
    case Erro.topo:
        print(9)
    }
}

proc main() {
    switch x in nivel1(1) {
    case i32:
        print(x)
    case Erro:
        mostra_erro(x)
    }
    switch x in nivel1(3) {
    case i32:
        print(x)
    case Erro:
        mostra_erro(x)
    }
    switch x in nivel1(2) {
    case i32:
        print(x)
    case Erro:
        mostra_erro(x)
    }
    switch x in nivel1(10) {
    case i32:
        print(x)
    case Erro:
        mostra_erro(x)
    }
    switch x in soma(0) {
    case i32:
        print(x)
    case Erro:
        mostra_erro(x)
    }
    switch x in soma(2) {
    case i32:
        print(x)
    case Erro:
        mostra_erro(x)
    }
    switch x in soma(5) {
    case i32:
        print(x)
    case Erro:
        mostra_erro(x)
    }
    print(99)
}
