// or_else.fj - or_else em laco, com padrao calculado, struct e encadeado em duas chamadas. Linhas-chave: "-1" (padrao), "15", "5" e "6" (struct de padrao).

enum Erro { negativo, impar }

struct Caixa {
    largura: int
    altura: int
}

proc metade(n: int) -> int ! Erro {
    if n < 0 {
        return Erro.negativo
    }
    if n % 2 == 1 {
        return Erro.impar
    }
    return n / 2
}

proc caixa(n: int) -> Caixa ! Erro {
    let m = try metade(n)
    return Caixa{largura = m, altura = m + 1}
}

proc main() {
    var total: int = 0
    for i in -2..<7 {
        let v = metade(i) or_else -1
        print(v)
        total = total + v
    }
    print(total)
    let padrao: int = 15
    print(metade(3) or_else padrao)
    print(metade(metade(60) or_else 0) or_else 0)
    let c = caixa(8) or_else Caixa{largura = 0, altura = 0}
    print(c.largura)
    print(c.altura)
    let d = caixa(9) or_else Caixa{largura = 5, altura = 6}
    print(d.largura)
    print(d.altura)
}
