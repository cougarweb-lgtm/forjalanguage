// switch_enum.fj - switch de enum com valores explicitos (0, 5, 9, 200), com padrao e sem; membro lido de parametro, de local e de campo. Linhas-chave: "5" (membro b), "100" (padrao).

enum Modo {
    a = 0,
    b = 5,
    c = 9,
    d = 200
}

enum Cor { vermelho, verde, azul }

struct Estado {
    modo: Modo
    cor: Cor
}

proc modo_num(m: Modo) -> i32 {
    switch m {
    case Modo.a:
        return 1
    case Modo.b:
        return 5
    case Modo.c:
        return 9
    case Modo.d:
        return 200
    }
    return -1
}

proc com_padrao(m: Modo) -> i32 {
    var r: i32 = 100
    switch m {
    case Modo.b:
        r = 5
    case Modo.d:
        r = 2
    default:
        r = 100
    }
    return r
}

proc cor_num(c: Cor) -> i32 {
    var r: i32 = 0
    switch c {
    default:
        r = 7
    case Cor.azul:
        r = 3
    case Cor.verde:
        r = 2
    }
    return r
}

proc main() {
    print(modo_num(Modo.a))
    print(modo_num(Modo.b))
    print(modo_num(Modo.c))
    print(modo_num(Modo.d))
    print(com_padrao(Modo.a))
    print(com_padrao(Modo.b))
    print(com_padrao(Modo.c))
    print(com_padrao(Modo.d))
    print(cor_num(Cor.vermelho))
    print(cor_num(Cor.verde))
    print(cor_num(Cor.azul))
    var e = Estado{modo = Modo.c, cor = Cor.verde}
    print(modo_num(e.modo))
    print(cor_num(e.cor))
    e.modo = Modo.d
    e.cor = Cor.azul
    print(modo_num(e.modo))
    print(cor_num(e.cor))
    var m = Modo.a
    var soma: i32 = 0
    for i in 0..<4 {
        soma = soma + modo_num(m)
        if i == 0 {
            m = Modo.b
        } else {
            m = Modo.c
        }
    }
    print(soma)
}
