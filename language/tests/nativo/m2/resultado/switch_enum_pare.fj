// switch_enum_pare.fj - break dentro do switch num laco sai do LACO (nao do switch); continue dentro do switch volta ao topo. Linhas-chave: "3" (voltas), "5" (soma), "4" (k ao sair do while), "8".

enum Passo { segue, pula, para }

proc passo_de(i: int) -> Passo {
    if i == 1 {
        return Passo.pula
    }
    if i == 4 {
        return Passo.para
    }
    return Passo.segue
}

proc main() {
    var voltas: int = 0
    var soma: int = 0
    for i in 0..<10 {
        switch passo_de(i) {
        case Passo.segue:
            soma = soma + i
        case Passo.pula:
            continue
        case Passo.para:
            break
        }
        voltas = voltas + 1
    }
    print(voltas)
    print(soma)
    var k: int = 0
    while true {
        k = k + 1
        switch passo_de(k) {
        case Passo.para:
            break
        default:
            soma = soma + 1
        }
    }
    print(k)
    print(soma)
}
