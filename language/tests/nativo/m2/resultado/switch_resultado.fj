// switch_resultado.fj - ligacao r nos dois casos (valor escalar, valor struct, erro), r mutavel por copia, & de r, break dentro do switch num laco. Linhas-chave: "21", "erro 1", "700".

enum Erro { a, b }

struct Medida {
    quant: int
    peso: int
    nome: i32
}

proc achar(n: int) -> int ! Erro {
    if n < 0 {
        return Erro.b
    }
    return n * 3
}

proc medir(n: int) -> Medida ! Erro {
    if n == 0 {
        return Erro.a
    }
    return Medida{quant = n, peso = n * 100, nome = 4}
}

proc incrementa(p: ^int) {
    p^ = p^ + 1
}

proc main() {
    switch r in achar(7) {
    case int:
        print(r)
    case Erro:
        print(-1)
    }
    switch r in achar(-7) {
    case int:
        print(r)
    case Erro:
        print("erro 1")
    }
    switch m in medir(7) {
    case Medida:
        print(m.quant)
        print(m.peso)
        print(m.nome)
    case Erro:
        print("erro")
    }
    switch m in medir(0) {
    case Medida:
        print(0)
    case Erro:
        print("erro a")
    }
    switch r in achar(5) {
    case int:
        var q = r
        incrementa(&q)
        print(q)
        incrementa(&q)
        print(q)
    case Erro:
        print(-1)
    }
    var soma: int = 0
    for i in -3..<9 {
        switch r in achar(i) {
        case int:
            soma = soma + r
        case Erro:
            continue
        }
        if soma > 50 {
            break
        }
    }
    print(soma)
    var total: int = 0
    for i in 0..<4 {
        switch m in medir(i) {
        case Medida:
            total = total + m.peso
            if m.quant == 3 {
                break
            }
        case Erro:
            total = total + 1
        }
    }
    print(total)
}
