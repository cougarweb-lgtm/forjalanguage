// cstr_para_str.fj - 'cstr as str': strlen do cstr (o literal de cstr e um endereco de texto com NUL); o str resultante imprime, compara e mede.

const GLOBAL: cstr = "constante"

proc tamanho_de(c: cstr) -> int {
    return len(c as str)
}

proc main() {
    let c: cstr = "ola cstr"
    let s = c as str
    print(s)
    print(len(s))
    print(s == "ola cstr")
    print(tamanho_de(c))
    print(tamanho_de("abc"))
    print(GLOBAL as str)
    print(len(GLOBAL as str))
}
