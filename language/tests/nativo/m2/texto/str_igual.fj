// str_igual.fj - == e != de str comparam CONTEUDO e tamanho (nunca o ponteiro): textos iguais em lugares diferentes, prefixo, vazio == vazio.

proc eh_igual(a: str, b: str) -> bool {
    return a == b
}

proc main() {
    let a: str = "forja"
    let b: str = "forja"
    let c: str = "forjado"
    let vazio1: str = ""
    let vazio2: str = ""
    print(a == b)
    print(a != b)
    print(a == c)
    print(a != c)
    print(c == a)
    print(vazio1 == vazio2)
    print(vazio1 != vazio2)
    print(a == vazio1)
    print(a == "forja")
    print("forja" != a)
    print(eh_igual(a, b = "forja"))
    print(eh_igual(a, b = "Forja"))
    if a == b and a != c {
        print("condicao composta")
    }
}
