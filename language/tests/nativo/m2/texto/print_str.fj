// print_str.fj - o x\print_str.fj (str local e print) agora roda no x64: texto, acento, vazio e str vinda de funcao.

proc saudacao() -> str {
    return "Ola, Forja"
}

proc main() {
    let nome: str = "Forja"
    print(nome)
    print("Atenção: ç ã é")
    print(saudacao())
    let outro = saudacao()
    print(outro)
    print(len(outro))
}
