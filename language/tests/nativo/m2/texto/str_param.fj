// str_param.fj - str como parametro, retorno, campo de struct e atribuicao (copia de 16 B): o str viaja como agregado.

struct Pessoa {
    nome: str
    idade: int
}

proc ecoa(s: str) -> str {
    return s
}

proc escolhe(a: str, b: str, primeiro: bool) -> str {
    if primeiro {
        return a
    }
    return b
}

proc rotulo(p: Pessoa) -> str {
    return p.nome
}

proc main() {
    let p = Pessoa{nome = "Ana", idade = 30}
    print(rotulo(p))
    print(len(p.nome))
    print(ecoa("eco"))
    print(escolhe("um", b = "dois", primeiro = true))
    print(escolhe("um", b = "dois", primeiro = false))
    var v: str = "inicio"
    print(v)
    v = ecoa("depois")
    print(v)
    v = p.nome
    print(v)
    print(v == "Ana")
    var q = Pessoa{nome = "Beto", idade = 7}
    q.nome = "Carla"
    print(q.nome)
    print(p.nome)
}
