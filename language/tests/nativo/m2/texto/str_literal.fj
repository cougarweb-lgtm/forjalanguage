// str_literal.fj - literal de str no backend nativo: print, len em BYTES de UTF-8 (2 letras acentuadas contam 2 bytes cada) e literal repetido em laco.

proc main() {
    let nome: str = "Forja"
    let acento: str = "ação"
    let vazio: str = ""
    print(nome)
    print(len(nome))
    print(acento)
    print(len(acento))
    print(len(vazio))
    print("literal direto")
    print(len("tres"))
    for i in 0..<3 {
        let l: str = "volta"
        print(l)
        print(len(l) + i)
    }
}
