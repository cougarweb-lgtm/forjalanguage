// str_vazia.fj - str vazia: print sai so a quebra de linha, len 0, igualdade, passagem por valor e struct com str sem valor (zerada).

struct Rotulo {
    texto: str
    n: int
}

proc tamanho(s: str) -> int {
    return len(s)
}

proc main() {
    let e: str = ""
    print(e)
    print(len(e))
    print(e == "")
    print(e != "x")
    print(tamanho(e))
    print(tamanho(""))
    let r: Rotulo = Rotulo{texto = "", n = 3}
    print(r.texto)
    print(len(r.texto))
    print(r.n)
    print("fim")
}
