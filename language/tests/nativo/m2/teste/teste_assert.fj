// modos: teste
// teste_assert.fj - assert falso dentro do 2o teste: R0003 "n devia valer 4" em stderr, "FALHOU assert" e o 3o teste roda; o expect do 1o passa.
// Linhas-chave: stdout "ok   passa" "FALHOU assert" "ok   fim" "3 testes, 1 falharam"; stderr R0003; exit 1.

proc main() {
    print(0)
}

test "passa" {
    let n: i32 = 3
    assert(n == 3, msg = "n vale 3")
    expect(n == 3)
}

test "assert" {
    let n: i32 = 3
    assert(n == 4, msg = "n devia valer 4")
    print(n)
}

test "fim" {
    expect(true)
}
