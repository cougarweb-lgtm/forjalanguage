// modos: teste
// teste_estouro.fj - i8 127 + 1 dentro de um teste: R0002 "soma i8" em stderr (dev), "FALHOU estoura" e o teste seguinte roda.
// Linhas-chave: stdout "-100" "FALHOU estoura" "ok   depois" "2 testes, 1 falharam"; stderr R0002; exit 1.

proc soma(a: i8, b: i8) -> i8 {
    return a + b
}

proc main() {
    print(soma(1, b = 2))
}

test "estoura" {
    print(soma(-100, b = 0))
    print(soma(127, b = 1))
    print(3)
}

test "depois" {
    expect(soma(1, b = 2) == 3)
}
