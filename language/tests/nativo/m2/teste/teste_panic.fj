// modos: teste
// teste_panic.fj - panic dentro do 1o teste: R0003 em stderr, "FALHOU primeiro" e os outros dois testes rodam. O print antes do panic sai.
// Linhas-chave: stdout "1" "FALHOU primeiro" "ok   segundo" "ok   terceiro" "3 testes, 1 falharam"; stderr R0003 "deu ruim"; exit 1.

proc main() {
    print(0)
}

test "primeiro" {
    print(1)
    panic("deu ruim")
    print(2)
}

test "segundo" {
    expect(1 + 1 == 2)
}

test "terceiro" {
    expect(5 > 4)
}
