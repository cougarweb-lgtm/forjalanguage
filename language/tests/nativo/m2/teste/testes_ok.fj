// modos: teste
// testes_ok.fj - tres testes que passam, um deles com laco e proc auxiliar. Linhas-chave: stdout "ok   a" "ok   b: soma com laco" "7" (print do teste c) "ok   c", "3 testes, 0 falharam", exit 0.

proc soma_ate(n: int) -> int {
    var soma = 0
    for i in 1..=n {
        soma += i
    }
    return soma
}

proc main() {
    print(soma_ate(3))
}

test "a" {
    expect(1 + 1 == 2)
}

test "b: soma com laco" {
    expect(soma_ate(10) == 55)
    expect(soma_ate(0) == 0)
}

test "c" {
    let x: i32 = 7
    expect(x > 6)
    print(x)
}
