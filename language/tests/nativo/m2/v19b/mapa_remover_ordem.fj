// mapa_remover_ordem.fj - a ordem densa depois de remover: o ultimo par ocupa o lugar do removido (swap-remove), remocao do primeiro, do meio e do ultimo, reinsercao no fim, chaves int e str; a ordem sai por for k, v in m e tem de bater com o backend C.

proc listar(m: ^map[int]int) {
    var linha = 0
    for k, v in m^ {
        print(f"{linha}: {k}={v}")
        linha += 1
    }
}

proc main() {
    var m = make(map[int]int, alloc = heap)
    defer delete(m)
    for i in 0..<12 {
        insert(&m, key = 100 + i, value = i)
    }
    listar(&m)
    remove(&m, key = 100)
    print("-- sem 100")
    listar(&m)
    remove(&m, key = 105)
    print("-- sem 105")
    listar(&m)
    remove(&m, key = 111)
    print("-- sem 111 (o ultimo)")
    listar(&m)
    insert(&m, key = 105, value = 55)
    insert(&m, key = 500, value = 5)
    print("-- com 105 e 500")
    listar(&m)
    for i in 0..<12 {
        remove(&m, key = 100 + i)
    }
    print("-- esvaziando")
    listar(&m)
    print(len(m))

    var s = make(map[str]int, alloc = heap)
    defer delete(s)
    insert(&s, key = "a", value = 1)
    insert(&s, key = "bb", value = 2)
    insert(&s, key = "ccc", value = 3)
    insert(&s, key = "dddd", value = 4)
    insert(&s, key = "eeeee", value = 5)
    remove(&s, key = "bb")
    remove(&s, key = "a")
    insert(&s, key = "f", value = 6)
    for k, v in s {
        print(f"{k}={v}")
    }
}
