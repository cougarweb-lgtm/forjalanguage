// mapa_int.fj - map com chave inteira de 1, 4 e 8 bytes e bool, valor escalar: insert (novo e existente), get com or_else, has, remove, len, cresce de cap 4 por 1000 insercoes (rehash), remocoes em ordem diferente e a chave que volta.

proc main() {
    var m = make(map[int]int, alloc = heap, cap = 4)
    defer delete(m)
    for i in 0..<1000 {
        insert(&m, key = i * 7, value = i)
    }
    print(len(m))
    print(get(m, key = 7) or_else -1)
    print(get(m, key = 6993) or_else -1)
    print(get(m, key = 8) or_else -1)
    insert(&m, key = 7, value = 777)
    print(get(m, key = 7) or_else -1)
    print(len(m))
    for i in 0..<500 {
        remove(&m, key = i * 14)
    }
    print(len(m))
    print(has(m, key = 14))
    print(has(m, key = 7))
    print(has(m, key = 7000))
    var soma = 0
    for i in 0..<1000 {
        soma += get(m, key = i * 7) or_else 0
    }
    print(soma)
    insert(&m, key = 14, value = 1)
    print(get(m, key = 14) or_else -1)
    print(len(m))
    remove(&m, key = 123456)
    print(len(m))
    insert(&m, key = -5, value = 55)
    print(get(m, key = -5) or_else 0)

    var pequeno = make(map[u8]i32, alloc = heap)
    defer delete(pequeno)
    let a: u8 = 200
    let b: u8 = 255
    insert(&pequeno, key = a, value = 10)
    insert(&pequeno, key = b, value = 20)
    insert(&pequeno, key = 0 as u8, value = 30)
    print(get(pequeno, key = a) or_else 0)
    print(get(pequeno, key = b) or_else 0)
    print(get(pequeno, key = 0 as u8) or_else 0)
    print(has(pequeno, key = 1 as u8))
    print(len(pequeno))

    var medio = make(map[i32]f64, alloc = heap)
    defer delete(medio)
    for i in 0..<20 {
        let k = i as i32 - 10
        insert(&medio, key = k, value = 0.5 * (i as f64))
    }
    let h: i32 = -10
    let valor = get(medio, key = h) or_else 9.0
    print(f"{valor}")
    let ausente = get(medio, key = 100 as i32) or_else 9.0
    print(f"{ausente}")
    print(len(medio))

    var logico = make(map[bool]int, alloc = heap)
    defer delete(logico)
    insert(&logico, key = true, value = 1)
    insert(&logico, key = false, value = 2)
    insert(&logico, key = true, value = 3)
    print(get(logico, key = true) or_else 0)
    print(get(logico, key = false) or_else 0)
    print(len(logico))
}
