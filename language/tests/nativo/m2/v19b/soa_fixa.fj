// soa_fixa.fj - soa[N]S com campos de classes diferentes (f32, int, bool, str e i8): elemento inteiro (gather), campo, grava (scatter), &a[i].campo, a coluna como fatia, len, soa por ponteiro e por valor.

struct Particula {
    x: f32 = 0.5
    n: int = 7
    ativa: bool = true
    nome: str = "livre"
    tag: i8 = -3
}

proc somar(xs: []f32) -> f32 {
    var total: f32 = 0.0
    for x in xs {
        total += x
    }
    return total
}

proc contar(ns: []int) -> int {
    var t = 0
    for n in ns {
        t += n
    }
    return t
}

proc ativar(a: ^soa[5]Particula, i: int) {
    a^[i].ativa = true
    a^[i].n += 100
}

proc mostrar(a: soa[5]Particula) {
    for i in 0..<5 {
        let p = a[i]
        print(f"{i} x={p.x} n={p.n} ativa={p.ativa} nome={p.nome} tag={p.tag}")
    }
}

proc main() {
    var a: soa[5]Particula = {}
    a[0] = Particula{}
    a[1] = Particula{x = 2.25, n = 11, ativa = false, nome = "um", tag = 5}
    a[2] = Particula{x = -1.5, n = -4, nome = "dois", tag = -128}
    a[3].x = 9.75
    a[3].nome = "tres"
    a[4].n = 40
    a[4].ativa = false
    print(f"{a[1].x}")
    print(a[1].n)
    print(a[1].nome)
    print(a[2].tag)
    let e = a[2]
    print(e.nome)
    print(e.n)
    let q = &a[4].n
    q^ = q^ + 2
    print(a[4].n)
    ativar(&a, i = 4)
    ativar(&a, i = 1)
    mostrar(a)
    print(contar(a.n))
    let s = somar(a.x)
    print(f"{s}")
    print(len(a))
    a[0] = a[3]
    print(a[0].nome)
    var c = 0
    for i, item in a {
        if item.ativa {
            c += i
        }
    }
    print(c)
}
