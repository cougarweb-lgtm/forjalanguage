// modos: dev
// mapa_frame_r0008.fj - map no frame usado depois do frame_reset(): dev falha com R0008 ("lista do frame usada depois do frame_reset() ...", saida 101) no get; release nao confere (indefinido, por isso so dev). Linha-chave: R0008.

proc main() {
    var m = make(map[int]int, alloc = frame, cap = 4)
    insert(&m, key = 1, value = 10)
    insert(&m, key = 2, value = 20)
    print(get(m, key = 2) or_else 0)
    frame_reset()
    print(get(m, key = 1) or_else 0)
    print("nao chega")
}
