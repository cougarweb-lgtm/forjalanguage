// mapa_ponteiro.fj - get_ptr: o ponteiro para o valor dentro do map (escrita direta, struct por campo), nulo quando a chave nao existe (or_else com reserva); o map por ponteiro (^map) em proc; len(^map).

struct Placar {
    pontos: int = 0
    nivel: i32 = 1
}

proc dobrar(m: ^map[int]int, chave: int) {
    var reserva = 0
    let p = get_ptr(m, key = chave) or_else &reserva
    p^ = p^ * 2
}

proc somar(m: ^map[int]int) -> int {
    var t = 0
    for k, v in m^ {
        t += k + v
    }
    return t + len(m^)
}

proc main() {
    var m = make(map[int]int, alloc = heap)
    defer delete(m)
    insert(&m, key = 1, value = 100)
    insert(&m, key = 2, value = 200)
    var reserva = 0
    let p = get_ptr(&m, key = 1) or_else &reserva
    p^ = p^ / 2
    print(get(m, key = 1) or_else 0)
    let q = get_ptr(&m, key = 2) or_else &reserva
    q^ += 5
    print(get(m, key = 2) or_else 0)
    let r = get_ptr(&m, key = 9) or_else &reserva
    r^ = 77
    print(reserva)
    print(get(m, key = 9) or_else -1)
    dobrar(&m, chave = 2)
    dobrar(&m, chave = 40)
    print(get(m, key = 2) or_else 0)
    print(somar(&m))

    var placar = make(map[int]Placar, alloc = heap)
    defer delete(placar)
    insert(&placar, key = 1, value = Placar{pontos = 10})
    insert(&placar, key = 2, value = Placar{})
    var sobra = Placar{}
    let s = get_ptr(&placar, key = 1) or_else &sobra
    s.pontos += 5
    s.nivel = 4
    let t = get_ptr(&placar, key = 2) or_else &sobra
    t.pontos = 1
    let v = get(placar, key = 1) or_else Placar{}
    print(v.pontos)
    print(v.nivel)
    let w = get(placar, key = 2) or_else Placar{}
    print(w.pontos)
    print(w.nivel)
    print(sobra.pontos)
}
