// mapa_str.fj - map[str]V: a chave vale por CONTEUDO (literal e str montada por format em outro endereco batem), prefixos sao chaves diferentes, a chave vazia existe, insert troca o valor, remove e cresce. O map guarda o ponteiro do texto da chave (nao copia os bytes): as chaves montadas vivem no frame ate o fim.

proc main() {
    var m = make(map[str]int, alloc = heap)
    defer delete(m)
    insert(&m, key = "ouro", value = 10)
    insert(&m, key = "prata", value = 5)
    insert(&m, key = "", value = 99)
    insert(&m, key = "ou", value = 1)
    insert(&m, key = "ouro ", value = 2)
    print(len(m))
    let r = "r"
    let k = format(f"ou{r}o", alloc = heap)
    print(len(k))
    print(get(m, key = k) or_else -1)
    delete(k)
    let montada = format(f"{1}{2}", alloc = heap)
    insert(&m, key = "12", value = 12)
    print(get(m, key = montada) or_else -1)
    delete(montada)
    print(get(m, key = "ouro") or_else -1)
    print(get(m, key = "ou") or_else -1)
    print(get(m, key = "") or_else -1)
    print(get(m, key = "oiro") or_else -1)
    insert(&m, key = "ouro", value = 11)
    print(get(m, key = "ouro") or_else -1)
    remove(&m, key = "prata")
    print(has(m, key = "prata"))
    print(len(m))
    for i in 0..<300 {
        let chave = format(f"item{i}", alloc = frame)
        insert(&m, key = chave, value = i * 3)
    }
    print(len(m))
    var soma = 0
    for i in 0..<300 {
        let chave = format(f"item{i}", alloc = heap)
        soma += get(m, key = chave) or_else 0
        delete(chave)
    }
    print(soma)
    print(get(m, key = "item299") or_else -1)
    print(has(m, key = "item300"))
    frame_reset()
}
