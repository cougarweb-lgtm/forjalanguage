// modos: dev
// soa_indice_fora.fj - a[i] com i >= len numa soa[dynamic]: dev confere a epoca e o indice (R0006 "indice 5 fora de 0..<3" na linha do acesso, saida 101); release nao confere (indefinido, por isso so dev). Linha-chave: "indice 5 fora de 0..<3".

struct Ponto {
    x: int = 0
    y: int = 0
}

proc main() {
    var a = make(soa[dynamic]Ponto, alloc = heap)
    defer delete(a)
    for i in 0..<3 {
        append(&a, item = Ponto{x = i, y = i + 10})
    }
    print(a[2].y)
    let i = 5
    print(a[i].x)
    print("nao chega")
}
