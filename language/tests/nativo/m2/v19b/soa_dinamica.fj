// soa_dinamica.fj - soa[dynamic]S no heap e no frame: make com cap 0 e 3, append de 1000 itens (cresce 0 -> 8 -> 16 ...), colunas depois do crescimento, gather (a[i]) e scatter (a[i] = ...), campo por endereco, len e delete.

struct Ponto {
    x: int = 0
    y: int = 0
    peso: f64 = 0.5
    ok: bool = false
}

proc soma(xs: []int) -> int {
    var t = 0
    for x in xs {
        t += x
    }
    return t
}

proc main() {
    var a = make(soa[dynamic]Ponto, alloc = heap)
    defer delete(a)
    print(len(a))
    for i in 0..<1000 {
        append(&a, item = Ponto{x = i, y = i * 2, peso = 1.25, ok = i % 3 == 0})
    }
    print(len(a))
    print(soma(a.x))
    print(soma(a.y))
    let p = a[999]
    print(p.x)
    print(p.y)
    print(p.ok)
    a[10] = Ponto{x = -1, y = -2, peso = 3.5, ok = true}
    a[11] = a[500]
    print(a[10].x)
    print(a[11].y)
    a[11].peso += 1.0
    print(f"{a[11].peso}")
    let r = &a[12].y
    r^ = 12345
    print(a[12].y)
    print(soma(a.y))
    var b = make(soa[dynamic]Ponto, alloc = heap, cap = 3)
    defer delete(b)
    print(len(b))
    append(&b, item = a[7])
    append(&b, item = a[8])
    append(&b, item = a[9])
    append(&b, item = a[10])
    print(len(b))
    print(b[3].x)
    print(soma(b.y))
    var f = make(soa[dynamic]Ponto, alloc = frame, cap = 2)
    for i in 0..<40 {
        append(&f, item = Ponto{x = i})
    }
    print(len(f))
    print(soma(f.x))
    frame_reset()
}
