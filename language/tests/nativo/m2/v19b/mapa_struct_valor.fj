// mapa_struct_valor.fj - map com valor struct (?V como struct {tem; v}), valor str (16 B) e valor cstr (?cstr em nicho): get devolve a copia do valor ou none; or_else com struct; troca de valor; remove.

struct Loja {
    preco: i32 = 3
    estoque: int = 0
    nome: str = "vazia"
    peso: f64 = 1.5
}

proc main() {
    var lojas = make(map[int]Loja, alloc = heap)
    defer delete(lojas)
    insert(&lojas, key = 1, value = Loja{preco = 10, estoque = 5, nome = "norte", peso = 2.5})
    insert(&lojas, key = 2, value = Loja{preco = 20, nome = "sul"})
    insert(&lojas, key = 3, value = Loja{})
    let a = get(lojas, key = 1) or_else Loja{}
    print(f"{a.preco} {a.estoque} {a.nome} {a.peso}")
    let b = get(lojas, key = 2) or_else Loja{}
    print(f"{b.preco} {b.estoque} {b.nome} {b.peso}")
    let c = get(lojas, key = 99) or_else Loja{preco = -1, nome = "ausente"}
    print(f"{c.preco} {c.estoque} {c.nome} {c.peso}")
    insert(&lojas, key = 1, value = Loja{preco = 11, nome = "norte2"})
    let d = get(lojas, key = 1) or_else Loja{}
    print(f"{d.preco} {d.nome}")
    switch achado in get(lojas, key = 3) {
    case Loja:
        print(achado.nome)
    case none:
        print("nenhuma")
    }
    switch achado in get(lojas, key = 4) {
    case Loja:
        print(achado.nome)
    case none:
        print("nenhuma")
    }
    remove(&lojas, key = 1)
    print(len(lojas))

    var nomes = make(map[int]str, alloc = heap)
    defer delete(nomes)
    insert(&nomes, key = 5, value = "cinco")
    insert(&nomes, key = 6, value = "seis")
    print(get(nomes, key = 5) or_else "?")
    print(get(nomes, key = 7) or_else "?")
    print(len(nomes))

    var textos = make(map[int]cstr, alloc = heap)
    defer delete(textos)
    let amarelo: cstr = "amarelo"
    insert(&textos, key = 1, value = amarelo)
    let achado = get(textos, key = 1)
    print(achado == none)
    let faltou = get(textos, key = 2)
    print(faltou == none)
}
