// mapa_iteracao.fj - for k, v in m e for k, &v in m: ordem densa (de insercao) com chave int e str, escrita pelo ponteiro do valor, 200 chaves (cresce varias vezes) e a soma conferida; map no escopo (em = escopo).

proc main() {
    var m = make(map[int]int, alloc = heap)
    defer delete(m)
    for i in 0..<200 {
        insert(&m, key = i * 37 % 211, value = i)
    }
    print(len(m))
    var n = 0
    var soma = 0
    for k, v in m {
        if n < 8 {
            print(f"{n}: {k}={v}")
        }
        soma += k * 2 + v
        n += 1
    }
    print(n)
    print(soma)
    for k, &v in m {
        v^ = v^ * 10 + k
    }
    var total = 0
    for k, v in m {
        total += v
    }
    print(total)
    print(get(m, key = 37) or_else -1)

    var textos = make(map[str]int, alloc = scope)
    insert(&textos, key = "z", value = 26)
    insert(&textos, key = "a", value = 1)
    insert(&textos, key = "m", value = 13)
    insert(&textos, key = "zz", value = 52)
    for k, v in textos {
        print(k)
        print(v)
    }
    for k, &v in textos {
        v^ = v^ + len(k)
    }
    print(get(textos, key = "zz") or_else 0)
    print(get(textos, key = "a") or_else 0)
}
