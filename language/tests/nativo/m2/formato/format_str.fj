// format_str.fj - format(f"...", em = heap|frame) -> str: devolvido de proc, medido com len, guardado em lista e liberado com delete.
proc rotulo(n: int) -> str {
    return format(f"item-{n:03}", alloc = heap)
}

proc main() {
    let a = rotulo(7)
    print(a)
    print(len(a))
    delete(a)
    let b = format(f"{2.5:.1}x", alloc = frame)
    print(b)
    print(len(b))
    var nomes = make([dynamic]str, alloc = heap)
    for i in 0..<5 {
        append(&nomes, item = format(f"n{i}-{i * i:4}", alloc = heap))
    }
    for s in nomes {
        print(s)
    }
    print(len(nomes[4]))
    for i in 0..<5 {
        delete(nomes[i])
    }
    delete(nomes)
    let vazio = format(f"", alloc = frame)
    print(len(vazio))
    frame_reset()
}
