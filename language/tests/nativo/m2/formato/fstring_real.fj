// fstring_real.fj - f"..." de f32 e f64: sem precisao (%.9g / %.17g), .0, .2, .30, largura, nan, inf e -0.0.
proc nao_numero64() -> f64 {
    let z: f64 = 0.0
    return z / z
}

proc nao_numero32() -> f32 {
    let z: f32 = 0.0
    return z / z
}

proc main() {
    let a: f32 = 2.5
    let b: f32 = 0.1
    let c: f32 = 16777216.0
    let d: f32 = 0.000015
    print(f"{a} {b} {c} {d}")
    let x: f64 = 0.1
    let y: f64 = 123456789.123456789
    var z: f64 = 1.0
    for k in 0..<300 {
        z = z * 10.0
    }
    let w: f64 = 0.00000025
    print(f"{x} {y} {z} {w}")
    print(f"{a:.0} {a:.2} {b:.2} {b:.17} {a:10.1}|")
    print(f"{x:.0} {x:.2} {y:.2} {x:.17} {y:012.3}|")
    print(f"{z:.0}")
    let h: f64 = 0.5
    let i: f64 = 1.5
    let j: f64 = 2.5
    print(f"{h:.0} {i:.0} {j:.0}")
    let zero32: f32 = 0.0
    let zero64: f64 = 0.0
    let neg32: f32 = -zero32
    let neg64: f64 = -zero64
    print(f"{zero32} {neg32} {zero64} {neg64} {neg32:.2} {neg64:.2} {neg64:08.1}")
    let n32 = nao_numero32()
    let n64 = nao_numero64()
    print(f"{n32} {n64} {n32:.3} {n64:.3} {n64:8}|")
    let inf64: f64 = 1.0 / zero64
    let inf32: f32 = 1.0 / zero32
    print(f"{inf64} {-inf64} {inf32} {-inf32} {inf64:.2} {-inf32:.2} {inf64:08}|")
    let grande: f64 = 10000000000000000000.0
    print(f"{grande} {grande:.1} {-grande:.1}")
}
