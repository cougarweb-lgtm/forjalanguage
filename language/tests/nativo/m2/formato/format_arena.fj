// format_arena.fj - format e format_c com em = <Arena> (alocador por handle): varios textos na mesma Arena, uso e reinicio.
import "std:mem"

proc main() {
    let a = mem.arena_create(64)
    let s = format(f"soma={1 + 2}", alloc = a)
    print(s)
    let t = format(f"x{40 + 2:6}y", alloc = a)
    print(t)
    let c = format_c(f"cstr {7:03}", alloc = a)
    print(c)
    let total = len(s) + len(t)
    print(total)
    print(mem.arena_used(a) > 0)
    mem.arena_reset(a)
    print(mem.arena_used(a))
    let u = format(f"depois do reset {total}", alloc = a)
    print(u)
    mem.arena_destroy(a)
}
