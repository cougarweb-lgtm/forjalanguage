// print_fstring_laco.fj - print(f"...") em laco de 1000 voltas: o buffer unico e reutilizado (forja_fmt_inicio zera o len) e a soma confere o conteudo.
proc main() {
    var soma = 0
    for i in 0..<1000 {
        let par = i % 2 == 0
        let meio: f64 = (i as f64) / 4.0
        print(f"volta {i:4} par={par} meio={meio:.2} hex={i as u32:x}")
        soma += i
    }
    print(f"soma={soma}")
}
