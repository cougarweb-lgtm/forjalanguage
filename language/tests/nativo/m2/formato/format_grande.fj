// format_grande.fj - texto formatado maior que 256 bytes (buffer cresce 256 -> 512 -> 1024), com 50 partes, e depois um texto curto no mesmo buffer.
proc main() {
    let a: i32 = 1234567
    let b: u8 = 255
    let nome = "grifo-de-bico-longo"
    let c: cstr = "ponte-de-pedra"
    let s = format(f"{a:10}|{b:x}|{nome:24}|{c:20}|{a:012}|{b:08x}|{nome}|{a}|{b}|{c}|{a:10}|{b:x}|{nome:24}|{c:20}|{a:012}|{b:08x}|{nome}|{a}|{b}|{c}|{a:10}|{b:x}|{nome:24}|{c:20}|{a:012}|{b:08x}|{nome}|{a}|{b}|{c}|{a:10}|{b:x}|{nome:24}|{c:20}|{a:012}|{b:08x}|{nome}|{a}|{b}|{c}|{a:10}|{b:x}|{nome:24}|{c:20}|{a:012}|{b:08x}|{nome}|{a}|{b}|{c}", alloc = heap)
    print(len(s))
    print(s)
    delete(s)
    let t = format(f"curto {a}", alloc = heap)
    print(len(t))
    print(t)
    delete(t)
    let u = format(f"{a:255}{a:255}{a:255}{a:255}{a:255}{a:255}{a:255}{a:255}{a:255}{a:255}", alloc = heap)
    print(len(u))
    delete(u)
}
