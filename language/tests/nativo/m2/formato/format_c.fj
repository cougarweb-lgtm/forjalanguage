// format_c.fj - format_c(f"...", em = frame|heap) -> cstr terminado em NUL: cstr no frame, cstr no heap, vazia, e a cstr de volta como str.
proc main() {
    let k: u8 = 200
    let c = format_c(f"id={k:x}", alloc = heap)
    print(c)
    let n = len(c as str)
    print(n)
    delete(c)
    let f = format_c(f"frame {k:5}|{3.5:.2}", alloc = frame)
    print(f)
    print(len(f as str))
    let v = format_c(f"", alloc = frame)
    print(len(v as str))
    let cc: cstr = "ponte"
    let g = format_c(f"[{cc:8}] [{true}] [{-7:04}]", alloc = frame)
    print(g)
    frame_reset()
}
