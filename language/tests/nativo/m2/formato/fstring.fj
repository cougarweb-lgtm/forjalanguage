// fstring.fj - print(f"...") de inteiros de todas as larguras, hexa, bool, str, cstr, largura, zeros e negativo com zeros.
struct Grifo {
    nome: str = "Bico"
    vida: i32 = 100
}

proc main() {
    let a: i8 = -5
    let b: i16 = 300
    let c: i32 = -70000
    let d: int = 123456789012
    let e: u8 = 200
    let f: u16 = 65535
    let g: u32 = 4000000000
    let h: uint = 12345678901234567
    print(f"{a} {b} {c} {d} {e} {f} {g} {h}")
    print(f"[{e:x}] [{f:x}] [{g:x}] [{h:x}] [{e:08x}] [{g:12x}]")
    let zero: u8 = 0
    print(f"[{zero:x}] [{zero}] [{zero:3}]")
    let neg = -42
    print(f"[{neg:5}] [{neg:05}] [{neg:2}]")
    print(f"[{a:4}] [{a:04}] [{c:012}] [{d:15}]")
    let min = -9223372036854775807 - 1
    print(f"{min} [{min:25}] [{min:025}]")
    print(f"[{true}] [{false}] [{true:8}] [{false:8}]")
    let g1 = Grifo{}
    let c1: cstr = "ponte"
    print(f"Vida: {g1.vida} de {g1.nome}")
    print(f"[{g1.nome:8}] [{c1:8}] [{c1}] [{g1.nome:2}]")
    print(f"{{chave}} {1 + 2} e {a + 1}")
    print(f"")
    print(f"so texto")
    let dentro = "dentro"
    print(f"tab\tz {dentro} fim")
}
