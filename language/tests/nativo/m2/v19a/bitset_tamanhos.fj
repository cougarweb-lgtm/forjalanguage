proc cinco() {
    var s: bit_set[Cinco] = {}
    insert(&s, key = Cinco.m00)
    insert(&s, key = Cinco.m02)
    insert(&s, key = Cinco.m04)
    print(len(s))
    print(has(s, key = Cinco.m04))
    print(has(s, key = Cinco.m03))
    remove(&s, key = Cinco.m02)
    let t: bit_set[Cinco] = {Cinco.m00, Cinco.m01}
    let d = s - t
    print(len(d))
    let u = s | t
    print(len(u))
    let i = s & t
    print(len(i))
    print(s == t)
    print(s != t)
    let k = Cinco.m03
    let v: bit_set[Cinco] = {k, Cinco.m00}
    print(has(v, key = k))
    var n = 0
    for item in u {
        n += 1
        if item == Cinco.m04 {
            print(4)
        }
    }
    print(n)
}

proc vinte() {
    var s: bit_set[Vinte] = {Vinte.m19}
    insert(&s, key = Vinte.m00)
    insert(&s, key = Vinte.m10)
    print(len(s))
    print(has(s, key = Vinte.m19))
    print(has(s, key = Vinte.m18))
    remove(&s, key = Vinte.m10)
    let t: bit_set[Vinte] = {Vinte.m00, Vinte.m17}
    let d = s - t
    print(len(d))
    let u = s | t
    print(len(u))
    print(len(s & t))
    print(s == t)
    let k = Vinte.m17
    let v = u - t
    print(has(v, key = k))
    var n = 0
    for item in u {
        n += 1
        if item == Vinte.m19 {
            print(19)
        }
    }
    print(n)
}

proc quarenta() {
    var s: bit_set[Quarenta] = {}
    insert(&s, key = Quarenta.m00)
    insert(&s, key = Quarenta.m31)
    insert(&s, key = Quarenta.m32)
    insert(&s, key = Quarenta.m39)
    print(len(s))
    print(has(s, key = Quarenta.m32))
    print(has(s, key = Quarenta.m33))
    remove(&s, key = Quarenta.m31)
    let t: bit_set[Quarenta] = {Quarenta.m00, Quarenta.m33, Quarenta.m39}
    let d = s - t
    print(len(d))
    let u = s | t
    print(len(u))
    print(len(s & t))
    print(s != t)
    var n = 0
    for item in u {
        n += 1
        if item == Quarenta.m39 {
            print(39)
        }
    }
    print(n)
}

proc sessenta() {
    var s: bit_set[Sessenta] = {}
    insert(&s, key = Sessenta.m00)
    insert(&s, key = Sessenta.m33)
    insert(&s, key = Sessenta.m59)
    print(len(s))
    print(has(s, key = Sessenta.m59))
    print(has(s, key = Sessenta.m58))
    remove(&s, key = Sessenta.m33)
    let t: bit_set[Sessenta] = {Sessenta.m00, Sessenta.m10, Sessenta.m58}
    let d = s - t
    print(len(d))
    let u = s | t
    print(len(u))
    print(len(s & t))
    print(s == t)
    print(s != t)
    let k = Sessenta.m59
    let v: bit_set[Sessenta] = {k, Sessenta.m00}
    print(has(v, key = k))
    var n = 0
    for item in u {
        n += 1
        if item == Sessenta.m58 {
            print(58)
        }
    }
    print(n)
}

