// bitset_param.fj - bit_set por valor em parametro e retorno, por ponteiro (^bit_set insere e remove), em campo de struct, em array e em literal com variavel; copia nao se liga ao original. Linhas-chave: "3", "true", "7".

enum Poder {
    fogo
    gelo
    raio
    vento
    terra
    luz
    sombra
    agua
    ar
}

struct Mago {
    nome: str = "x"
    dons: bit_set[Poder] = {}
    nivel: i32 = 1
}

proc contar(s: bit_set[Poder]) -> int {
    return len(s)
}

proc somar(a: bit_set[Poder], b: bit_set[Poder]) -> bit_set[Poder] {
    return a | b
}

proc dar(s: ^bit_set[Poder], p: Poder) {
    insert(s, key = p)
}

proc tirar(s: ^bit_set[Poder], p: Poder) {
    remove(s, key = p)
}

proc tem_dom(m: Mago, p: Poder) -> bool {
    return has(m.dons, key = p)
}

proc main() {
    var a: bit_set[Poder] = {Poder.fogo, Poder.raio}
    let b: bit_set[Poder] = {Poder.raio, Poder.agua}
    print(contar(a))
    let c = somar(a, b = b)
    print(contar(c))
    dar(&a, p = Poder.ar)
    print(contar(a))
    print(has(a, key = Poder.ar))
    tirar(&a, p = Poder.fogo)
    print(has(a, key = Poder.fogo))
    print(contar(c))
    var m = Mago{nome = "mara", dons = c, nivel = 3}
    print(tem_dom(m, p = Poder.agua))
    print(tem_dom(m, p = Poder.gelo))
    insert(&m.dons, key = Poder.gelo)
    print(tem_dom(m, p = Poder.gelo))
    print(contar(m.dons))
    print(m.nivel)
    var grupo: [3]bit_set[Poder] = {a, b, c}
    insert(&grupo[1], key = Poder.sombra)
    print(contar(grupo[0]))
    print(contar(grupo[1]))
    print(contar(grupo[2]))
    let copia = m.dons
    remove(&m.dons, key = Poder.agua)
    print(contar(copia))
    print(contar(m.dons))
    print(copia == m.dons)
    let p = Poder.vento
    let q = Poder.luz
    let v: bit_set[Poder] = {p, q, Poder.terra}
    print(contar(v))
    print(contar(v - copia))
    print(contar(v & copia))
    var total = 0
    for i in 0..<3 {
        total += contar(grupo[i])
    }
    print(total)
    for x in v {
        if x == Poder.luz {
            print(7)
        }
    }
}
