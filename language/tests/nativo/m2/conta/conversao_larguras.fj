// conversao_larguras.fj - 'as' entre inteiros de todas as larguras: os pares puros (sempre cabem) e os checados cujo valor cabe.

proc de_i8(v: i8) {
    print(v as i16)
    print(v as i32)
    print(v as int)
    print(v as u8)
    print(v as i8)
}

proc de_u8(v: u8) {
    print(v as u16)
    print(v as u32)
    print(v as uint)
    print(v as i16)
    print(v as i32)
    print(v as int)
}

proc de_i16(v: i16) {
    print(v as i32)
    print(v as int)
    print(v as i8)
    print(v as u16)
}

proc de_u16(v: u16) {
    print(v as u32)
    print(v as uint)
    print(v as i32)
    print(v as int)
    print(v as u8)
    print(v as i16)
}

proc de_i32(v: i32) {
    print(v as int)
    print(v as i16)
    print(v as i8)
    print(v as u32)
    print(v as uint)
    print(v as u8)
}

proc de_u32(v: u32) {
    print(v as uint)
    print(v as int)
    print(v as i32)
    print(v as u16)
    print(v as u8)
}

proc de_int(v: int) {
    print(v as i32)
    print(v as i16)
    print(v as i8)
    print(v as uint)
    print(v as u32)
    print(v as u16)
    print(v as u8)
}

proc de_uint(v: uint) {
    print(v as int)
    print(v as u32)
    print(v as i32)
    print(v as u16)
    print(v as i16)
    print(v as u8)
    print(v as i8)
}

proc main() {
    de_i8(100)
    de_u8(100)
    de_u8(200)
    de_i16(100)
    de_i16(30000)
    de_u16(100)
    de_u16(30000)
    de_i32(100)
    de_i32(30000)
    de_i32(2000000000)
    de_u32(100)
    de_u32(30000)
    de_u32(2000000000)
    de_int(100)
    de_int(30000)
    de_int(2000000000)
    de_uint(100)
    de_uint(30000)
    de_uint(2000000000)
}
