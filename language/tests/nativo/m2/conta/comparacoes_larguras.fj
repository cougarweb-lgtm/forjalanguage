// comparacoes_larguras.fj - comparacoes de i8 i16 u8 u16 u32 (operandos alargados por movsx/movzx): u8 200 > 100, i8 -1 < 1, u32 4000000000 > 1, iguais e diferentes.

proc cmp_i8(a: i8, b: i8) {
    print(a < b)
    print(a <= b)
    print(a > b)
    print(a >= b)
    print(a == b)
    print(a != b)
}

proc cmp_i16(a: i16, b: i16) {
    print(a < b)
    print(a >= b)
    print(a == b)
    print(a != b)
}

proc cmp_u8(a: u8, b: u8) {
    print(a < b)
    print(a <= b)
    print(a > b)
    print(a >= b)
    print(a == b)
    print(a != b)
}

proc cmp_u16(a: u16, b: u16) {
    print(a < b)
    print(a > b)
    print(a == b)
}

proc cmp_u32(a: u32, b: u32) {
    print(a < b)
    print(a > b)
    print(a == b)
    print(a != b)
}

proc imediatos(a: i8, b: u8, c: u32) {
    print(a < 0)
    print(a > -100)
    print(b > 128)
    print(b == 255)
    print(c > 2147483647)
    print(c == 4000000000)
}

proc main() {
    cmp_i8(-1, b = 1)
    cmp_i8(1, b = -1)
    cmp_i8(-128, b = 127)
    cmp_i8(5, b = 5)
    cmp_i16(-1, b = 1)
    cmp_i16(-32768, b = 32767)
    cmp_i16(7, b = 7)
    cmp_u8(200, b = 100)
    cmp_u8(100, b = 200)
    cmp_u8(255, b = 255)
    cmp_u16(65535, b = 1)
    cmp_u16(1, b = 65535)
    cmp_u16(300, b = 300)
    cmp_u32(4000000000, b = 1)
    cmp_u32(1, b = 4000000000)
    cmp_u32(4294967295, b = 4294967295)
    imediatos(-1, b = 255, c = 4000000000)
    imediatos(-128, b = 0, c = 5)
    imediatos(127, b = 129, c = 2147483647)
}
