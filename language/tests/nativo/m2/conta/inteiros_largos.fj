// inteiros_largos.fj - bordas de i8 i16 u8 u16 u32 por parametro, retorno, variavel local e print (127, -128, 255, 65535, 4294967295).

proc ecoa_i8(v: i8) -> i8 {
    return v
}

proc ecoa_i16(v: i16) -> i16 {
    return v
}

proc ecoa_u8(v: u8) -> u8 {
    return v
}

proc ecoa_u16(v: u16) -> u16 {
    return v
}

proc ecoa_u32(v: u32) -> u32 {
    return v
}

proc mistura(a: i8, b: i16, c: u8, d: u16, e: u32) -> u32 {
    print(a)
    print(b)
    return e - (c as u32)
}

proc main() {
    print(ecoa_i8(127))
    print(ecoa_i8(-128))
    print(ecoa_i16(32767))
    print(ecoa_i16(-32768))
    print(ecoa_u8(255))
    print(ecoa_u16(65535))
    print(ecoa_u32(4294967295))
    print(ecoa_u32(2147483648))
    var a: i8 = -128
    var b: u16 = 65535
    var c: u32 = 4294967295
    print(a)
    print(b)
    print(c)
    a = 127
    b = 0
    c = 0
    print(a)
    print(b)
    print(c)
    print(mistura(-1, b = -2, c = 3, d = 4, e = 4294967295))
}
