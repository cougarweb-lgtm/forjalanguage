// deslocamento.fj - << e >> sem sinal: 0, largura-1, largura (devolve 0) e 200 (devolve 0), com o contador vindo de variavel e de imediato.

proc esq8(a: u8, n: u8) -> u8 {
    return a << n
}

proc dir8(a: u8, n: u8) -> u8 {
    return a >> n
}

proc esq16(a: u16, n: u16) -> u16 {
    return a << n
}

proc dir16(a: u16, n: u16) -> u16 {
    return a >> n
}

proc esq32(a: u32, n: u32) -> u32 {
    return a << n
}

proc dir32(a: u32, n: u32) -> u32 {
    return a >> n
}

proc esq64(a: uint, n: uint) -> uint {
    return a << n
}

proc dir64(a: uint, n: uint) -> uint {
    return a >> n
}

proc contadores(n: u8) {
    var k: u8 = 0
    while k < 12 {
        print(esq8(129, n = k))
        print(dir8(129, n = k))
        k += 1
    }
    print(esq8(1, n = n))
}

proc main() {
    print(esq8(255, n = 0))
    print(esq8(255, n = 7))
    print(esq8(255, n = 8))
    print(esq8(255, n = 200))
    print(dir8(255, n = 7))
    print(dir8(255, n = 8))
    print(dir8(255, n = 200))
    print(esq16(65535, n = 15))
    print(esq16(65535, n = 16))
    print(dir16(65535, n = 15))
    print(dir16(65535, n = 16))
    print(esq32(4294967295, n = 0))
    print(esq32(4294967295, n = 31))
    print(esq32(4294967295, n = 32))
    print(dir32(4294967295, n = 31))
    print(dir32(4294967295, n = 32))
    print(dir32(4294967295, n = 200))
    print(esq64(18446744073709551615, n = 63))
    print(esq64(18446744073709551615, n = 64))
    print(dir64(18446744073709551615, n = 63))
    print(dir64(18446744073709551615, n = 64))
    print(dir64(18446744073709551615, n = 1000))
    contadores(3)
    contadores(8)
    let x: u32 = 1
    print(x << 4)
    print(x << 31)
    print(x << 32)
    print(x << 200)
    let y: uint = 1
    print(y << 63)
    print(y << 64)
    let z: u16 = 65535
    print(z >> 1)
    print(z << 16)
}
