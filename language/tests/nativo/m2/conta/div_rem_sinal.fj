// div_rem_sinal.fj - divisao e resto com sinal em i8 i16 i32 int: -7/2 = -3, -7%2 = -1, 7%-2 = 1, divisor 0 devolve 0 e -128 % -1 = 0 em i8 (divisor -1 que nao falha).

proc d32(a: i32, b: i32) -> i32 {
    return a / b
}

proc r32(a: i32, b: i32) -> i32 {
    return a % b
}

proc d64(a: int, b: int) -> int {
    return a / b
}

proc r64(a: int, b: int) -> int {
    return a % b
}

proc d16(a: i16, b: i16) -> i16 {
    return a / b
}

proc r16(a: i16, b: i16) -> i16 {
    return a % b
}

proc d8(a: i8, b: i8) -> i8 {
    return a / b
}

proc r8(a: i8, b: i8) -> i8 {
    return a % b
}

proc imediatos(a: i32, b: int, c: i8) {
    print(a / 3)
    print(a % 3)
    print(a / 0)
    print(a % 0)
    print(a / -1)
    print(a % -1)
    print(b / 7)
    print(b % -7)
    print(b / -1)
    print(c / -3)
    print(c % -3)
    print(c / -1)
    print(c % -1)
}

proc main() {
    print(d32(-7, b = 2))
    print(r32(-7, b = 2))
    print(r32(7, b = -2))
    print(d32(7, b = -2))
    print(d32(5, b = 0))
    print(r32(5, b = 0))
    print(d32(-2147483647, b = -1))
    print(r32(-2147483647, b = -1))
    print(d32(-2147483648, b = 1))
    print(d64(-7, b = 2))
    print(r64(-7, b = 2))
    print(r64(7, b = -2))
    print(d64(5, b = 0))
    print(r64(5, b = 0))
    print(d64(-9223372036854775807, b = -1))
    print(r64(-9223372036854775807, b = -1))
    print(d16(-32767, b = -1))
    print(r16(-32768, b = -1))
    print(d16(-32768, b = 2))
    print(r16(-7, b = 2))
    print(d16(9, b = 0))
    print(d8(-7, b = 2))
    print(r8(-7, b = 2))
    print(r8(7, b = -2))
    print(d8(-127, b = -1))
    print(r8(-128, b = -1))
    print(d8(-128, b = 1))
    print(d8(4, b = 0))
    print(r8(4, b = 0))
    imediatos(-2147483647, b = -9223372036854775807, c = -127)
    imediatos(100, b = 100, c = 100)
}
