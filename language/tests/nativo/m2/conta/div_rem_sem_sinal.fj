// div_rem_sem_sinal.fj - divisao e resto sem sinal: 18446744073709551615/3 = 6148914691236517205 e divisor 0 devolve 0, em u8 u16 u32 uint, por vreg e por imediato.

proc dq(a: uint, b: uint) -> uint {
    return a / b
}

proc rq(a: uint, b: uint) -> uint {
    return a % b
}

proc d32(a: u32, b: u32) -> u32 {
    return a / b
}

proc r32(a: u32, b: u32) -> u32 {
    return a % b
}

proc d16(a: u16, b: u16) -> u16 {
    return a / b
}

proc r16(a: u16, b: u16) -> u16 {
    return a % b
}

proc d8(a: u8, b: u8) -> u8 {
    return a / b
}

proc r8(a: u8, b: u8) -> u8 {
    return a % b
}

proc imediatos(a: u32, b: uint, c: u8) {
    print(a / 10)
    print(a % 10)
    print(a / 0)
    print(a % 0)
    print(b / 3)
    print(b % 1000)
    print(c / 7)
    print(c % 7)
    print(c / 255)
    print(c % 255)
}

proc main() {
    print(dq(18446744073709551615, b = 3))
    print(rq(18446744073709551615, b = 10))
    print(dq(18446744073709551615, b = 0))
    print(rq(18446744073709551615, b = 0))
    print(d32(4294967295, b = 2))
    print(r32(4294967295, b = 1000))
    print(d32(4294967295, b = 0))
    print(d16(65535, b = 256))
    print(r16(65535, b = 255))
    print(d16(65535, b = 0))
    print(d8(255, b = 16))
    print(r8(255, b = 16))
    print(d8(255, b = 0))
    print(r8(255, b = 0))
    imediatos(4294967295, b = 18446744073709551615, c = 255)
    imediatos(7, b = 7, c = 7)
}
