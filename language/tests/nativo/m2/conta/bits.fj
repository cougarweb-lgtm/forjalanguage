// bits.fj - & | ~(xor) e ~(not) em u8 u16 u32 uint, por vreg e por imediato (bits so existem em tipo sem sinal): ~ de u8 0 = 255.

proc bits_u8(a: u8, b: u8) {
    print(a & b)
    print(a | b)
    print(a ~ b)
    print(~a)
    print(a & 15)
    print(a ~ 255)
    print(a | 128)
}

proc bits_u16(a: u16, b: u16) {
    print(a & b)
    print(a | b)
    print(a ~ b)
    print(~a)
    print(a & 255)
}

proc bits_u32(a: u32, b: u32) {
    print(a & b)
    print(a | b)
    print(a ~ b)
    print(~a)
    print(a ~ 4294967295)
}

proc bits_u64(a: uint, b: uint) {
    print(a & b)
    print(a | b)
    print(a ~ b)
    print(~a)
}

proc main() {
    bits_u8(0, b = 255)
    bits_u8(170, b = 15)
    bits_u16(0, b = 65535)
    bits_u16(43690, b = 255)
    bits_u32(0, b = 4294967295)
    bits_u32(4026531840, b = 252645135)
    bits_u64(0, b = 18446744073709551615)
    bits_u64(18446744073709551615, b = 252645135)
}
