struct Ponto {
    x: int
    y: int = 2
}

struct Caixa {
    largura: int = 4
    altura: int = 5
    origem: int = 0
}

proc area(c: ^Caixa) -> int {
    return c.largura * c.altura
}

proc main() {
    let p = Ponto{x = 3}
    print(p.x + p.y)
    var c = Caixa{altura = 10}
    print(area(&c))
    c.largura = 6
    print(area(&c))
}
