struct Heroi {
    vida: i32 in 0..=100 = 100
    ouro: int
    forte: bool = true
    nivel: int = 1
}

proc main() {
    let h = Heroi{}
    print(h.vida)
    print(h.ouro)
    print(h.forte)
    print(h.nivel)
    var k = Heroi{ouro = 7, forte = false}
    k.nivel += 2
    print(k.ouro)
    print(k.forte)
    print(k.nivel)
}
