unit Metros: f32
unit Segundos: f32
unit MetrosPorSegundo = Metros/Segundos

struct Corpo {
    velocidade: MetrosPorSegundo = 8.0
    posicao: Metros = 0.0
}

proc mover(c: ^Corpo, dt: Segundos) {
    c.posicao += c.velocidade * dt
}

proc main() {
    var c = Corpo{velocidade = 10.0}
    mover(&c, dt = 0.5)
    mover(&c, dt = 0.25)
    print(c.posicao as int)
    var d = Corpo{}
    mover(&d, dt = 1.0)
    print(d.posicao as int)
}
