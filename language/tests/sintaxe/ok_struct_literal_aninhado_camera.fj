struct Vector3 {
    x: f32
    y: f32
    z: f32
}

struct Camera3D {
    position: Vector3
    target: Vector3
    fovy: i32
}

proc main() {
    let cam = Camera3D{
        position = Vector3{
            x = 1.0,
            y = 2.0,
            z = 3.0,
        },
        target = Vector3{x = 0.0, y = 0.0, z = 0.0},
        fovy = 45,
    }
    print(cam.fovy)
}
