proc main() {
    var a: [3]int = {1, 2, 3}
    for x in a {
        print(x)
    }
    for &x in a {
        x^ = 0
    }
    for i, x in a {
        print(i + x)
    }
    for i, &x in a[1..<3] {
        x^ = i
    }
    for i in 0..<3 {
        print(i)
    }
    for i in 0..=2 {
        print(i)
    }
    for i in 0..<len(a) {
        print(a[i])
    }
}
