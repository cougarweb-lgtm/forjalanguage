import "std:mem"
import "jogo/fisica"
import "jogo/fisica_lenta" as lenta

proc mover(c: ^fisica.Corpo, a: mem.Arena) -> fisica.Corpo ! fisica.ErroFisica {
    let g = new(fisica.Corpo, alloc = scope)
    let k = lenta.passo(c, dt = fisica.DT)
    switch fisica.cor_de(k) {
    case fisica.Cor.azul:
        print(1)
    default:
        print(2)
    }
    return fisica.Corpo{massa = k}
}

