enum Direcao { cima, baixo }

enum ErroCarga { falhou }

struct Malha {
    v: i32 = 0
}

proc usar(m: i32) {
    print(m)
}

proc carregar() -> Malha ! ErroCarga {
    return Malha{v = 1}
}

proc main() {
    let d = Direcao.cima
    switch d {
    case Direcao.cima:
        print(1)
    case Direcao.baixo:
        print(2)
    default:
        print(3)
    }
    switch r in carregar() {
    case Malha: usar(1)
    case ErroCarga:
        print(0)
        switch d {
        case Direcao.cima: print(5)
        default: print(6)
        }
    }
    switch d {
    }
}
