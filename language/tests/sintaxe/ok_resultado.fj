enum ErroCarga { nao_encontrado, corrompido }

struct Malha {
    vertices: i32 = 0
}

const MALHA_CUBO: Malha = Malha{vertices = 8}

proc carregar(caminho: i32) -> Malha ! ErroCarga {
    if caminho == 0 {
        return ErroCarga.nao_encontrado
    }
    return Malha{vertices = 4}
}

proc validar(n: i32) -> ! ErroCarga {
    if n < 0 {
        return ErroCarga.corrompido
    }
}

proc usar() -> Malha ! ErroCarga {
    let a = try carregar(1)
    let b = carregar(2) or_else MALHA_CUBO
    let c = carregar(3) or_else carregar(4) or_else MALHA_CUBO
    let d = try carregar(5) or_else MALHA_CUBO
    let e = try validar(1)
    return b
}

proc main() -> ! ErroCarga {
    let m = try usar()
    print(m.vertices)
}
