struct Grifo {
    vida: i32 = 100
    dono: ?^Grifo
    par: ^^i32
}

proc usa(p: ^Grifo, q: ?^Grifo, r: rawptr) -> ^Grifo {
    var pp: ^^i32 = none
    let a = p^.vida
    let b = p^
    pp^^ = 1
    d.a.b = 1
    p^.vida += 2
    let c = r as ^Grifo
    let e = p as ?^Grifo
    let f: ?^Grifo = none
    return p
}
