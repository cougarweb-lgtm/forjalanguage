union Valor { i32, str, ^Grifo }

union Forma {
    Circulo,
    Retangulo
    [3]int,
}

proc dividir(a: int, b: int) -> (q: int, r: int) {
    return a / b, a % b
}

proc ler() -> (dados: [dynamic]u8, erro: ?ErroIo) ! ErroIo {
    return g()
}

proc main() {
    let q, r = dividir(7, b = 2)
    var a, _ = dividir(9, b = 2)
    switch v in x {
    case ^Grifo:
        print(1)
    case [3]int:
        print(2)
    case ?i32:
        print(3)
    case none:
        print(4)
    case Direcao.cima:
        print(5)
    default:
        print(6)
    }
}
