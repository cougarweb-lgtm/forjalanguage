struct Grifo {
    vida: i32
    pos: [3]i32
}

proc f() -> [3]int {
    return {1, 2, 3}
}

proc main() {
    var a: [4]int = {}
    var b: [2]int = {1, 2}
    var m: [2][1]int = {{1}, {2}}
    var i = 1
    var j = 0
    var p: ^[3]int = &a
    var x = a[i]
    x = m[i][j]
    let s = a[1..<2]
    let t = a[0..=1]
    let u = a[..]
    let v = f()[0]
    let w = p^[0]
    let q = &a[i]
    var g: [2]Grifo = {Grifo{}, Grifo{vida = 2}}
    g[i].vida += 1
    a[1..<3][0] = 4
    defer a[0] = 1
    b[j] -= 2
}
