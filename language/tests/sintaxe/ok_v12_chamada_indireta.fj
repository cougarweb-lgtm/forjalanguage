struct Vtbl {
    soma: proc(self: rawptr, a: i32, b: i32) -> i32
    solta: proc(self: rawptr)
}

struct Objeto {
    vtbl: ^Vtbl
}

proc usar(q: ^Objeto) {
    q.vtbl.solta(q)
    let r = q.vtbl.soma(q, a = 1, b = 2)
    let s = escolher()(q, a = 3, b = 4)
    let t = (q.vtbl.soma)(q, a = 5, b = 6)
    defer q.vtbl.solta(q)
    print(r + s + t)
}
