const N: int = 4

struct Grifo {
    vida: i32
    pos: [3]i32
    amigos: []^Grifo
}

struct Bando {
    notas: [N]f32
    nomes: []u8
    ponta: ?^[2]int
}

proc ler(a: [3]int, b: []u8, c: ^[4]int, d: [2][3]int, e: ?^[2]int) -> [N]f32 {
    let x: [3]int = ler(a, b, c, d, e)
    let y: []u8 = ler(a, b, c, d, e)
    let z: ^[4]int = ler(a, b, c, d, e)
    let w: [2][3]int = ler(a, b, c, d, e)
    return x
}

proc fatiar(g: []^Grifo) -> []u8 {
    return g
}
