    fecha: proc()
}

proc aplicar(f: proc(x: i32, y: i32) -> i32, a: i32) -> i32 {
    return f(a, y = 2)
}

proc escolher() -> proc(x: i32) -> i32 {
    return dobrar
}

proc main() {
    let g: proc(x: i32) -> i32 = dobrar
    let h = g as rawptr as proc(n: i32) -> i32
