proc main() {
    var n = 0
    while true {
        n += 1
        if n < 3 {
            continue
        }
        if n > 10 {
            break
        }
    }
    for i in 0..<10 {
        if i == 5 {
            break
        } else if i == 2 {
            continue
        }
    }
    for j in 0..=3 {
        continue
    }
    print(n)
}
