// ok_foreign_ends.fj - M6d P92a: clausula `ends` sem parametro no foreign (4a palavra, mesma posicao das de posse). Deve passar no parser.
// Versao: 0.1.0 | Changelog: 0.1.0 - P92a: primeira versao (falha hoje: ends ainda nao existe, P92b).
// Esperado: forja check sem diagnostico, exit 0.

foreign {
    link "sqlite3"
    proc sqlite3_shutdown() -> i32 ends
}

proc main() {
    _ = sqlite3_shutdown()
    print("ok")
}
