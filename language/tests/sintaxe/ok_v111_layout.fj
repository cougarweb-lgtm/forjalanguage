// v1.11 L9 (A12): size_of(T) e align_of(T) levam um tipo; offset_of(Struct.campo); static_assert no topo e como comando.
struct Vertice {
    x: f32
    y: f32
    uv: f32
}

const TAM: int = size_of(Vertice)

static_assert(size_of(Vertice) == 12, msg = "Vertice tem 12 bytes")
static_assert(align_of([3]f32) == 4 and offset_of(Vertice.uv) == 8)

proc main() {
    static_assert(size_of(^Vertice) == 8)
    static_assert(size_of([]Vertice) == 16, msg = "fatia")
    print(size_of(?^Vertice))
    print(TAM)
}
