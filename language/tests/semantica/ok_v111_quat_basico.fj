// v1.11 L14a (A05): o tipo embutido quat {x, y, z, w: f32}: literal (campo omitido = 0.0), campos que leem e gravam, q + r, q - r, -q, q * k, k * q (k: f32) e conj(q).
// Em foreign o quat atravessa por valor como struct de 4 f32.
foreign {
    link "raylib"
    proc QuaternionNormalize(q: quat) -> quat
}

struct Corpo {
    giro: quat
    massa: f32
}

proc dobro(q: quat) -> quat {
    return q * 2.0
}

proc main() {
    let identidade = quat{w = 1.0}
    var q = quat{x = 1.0, y = 2.0, z = 3.0, w = 4.0}
    let r = quat{x = 0.5, y = 0.25}
    let soma = q + r
    let diferenca = q - r
    let oposto = -q
    let k: f32 = 3.0
    let escalado = q * k
    let escalado_antes = 0.5 * q
    let conjugado = conj(q)
    q.x = soma.y + identidade.w
    let c = Corpo{giro = conjugado, massa = 2.0}
    let e = dobro(c.giro) + diferenca - oposto
    print(f"{escalado.x} {escalado_antes.w} {e.z} {q.x}")
}
