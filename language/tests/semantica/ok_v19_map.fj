enum Item {
    espada
    escudo
}

struct Loja {
    preco: i32 = 3
}

proc soma(m: ^map[str]int) -> int {
    var total = 0
    for k, v in m^ {
        total += v + len(k)
    }
    return total
}

proc main() {
    var m = make(map[str]int, alloc = heap, cap = 4)
    defer delete(m)
    insert(&m, key = "ouro", value = 10)
    insert(&m, key = "prata", value = 5)
    let o = get(m, key = "ouro") or_else 0
    if has(m, key = "prata") {
        remove(&m, key = "prata")
    }
    var reserva = 0
    let p = get_ptr(&m, key = "ouro") or_else &reserva
    p^ += 1
    var precos = make(map[Item]Loja, alloc = scope)
    insert(&precos, key = Item.escudo, value = Loja{})
    for k, &v in m {
        v^ += len(k)
    }
    print(o + soma(&m) + len(precos))
}
