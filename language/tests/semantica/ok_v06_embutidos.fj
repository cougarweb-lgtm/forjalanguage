// V-06 = B nos embutidos: assert(cond, "msg"), append(&l, item), transmute(x, tipo) e make(tipo, em) tambem aceitam o argumento posicional.
proc main() {
    assert(1 + 1 == 2, "a conta fecha")
    assert(1 + 1 == 2, msg = "a conta fecha de novo")
    var l = make([dynamic]int, heap)
    append(&l, 7)
    append(&l, item = 8)
    print(len(l))
    let f: f32 = 1.5
    let bits: u32 = transmute(f, u32)
    print(bits as int)
    delete(l)
}
