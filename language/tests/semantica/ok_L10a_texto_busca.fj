// L10a: os usos validos da familia de busca, corte e cursores de std:text: ?int com or_else, vistas devolvidas por trim e cut, retorno multiplo de cut, cursor por endereco de var str, classes de byte.
import "std:text" as tx

proc tem_chave(linha: str) -> bool {
    let antes, depois, achou = tx.cut(tx.trim(linha), sep = "=")
    return achou and len(antes) > 0 and len(depois) >= 0
}

proc main() {
    let s = "  chave=valor  "
    let a = tx.str_contains(s, sub = "=")
    let b = tx.str_index_of(s, sub = "=") or_else -1
    let c = tx.str_last_index_of(s, sub = "e") or_else -1
    let d = tx.index_byte(s, b = 61) or_else -1
    let e = tx.index_any(s, set = "=:") or_else -1
    let f = tx.starts_with(s, prefix = "  ") and tx.ends_with(s, suffix = "  ")
    let g = tx.str_count(s, sub = "a")
    let h = tx.trim_prefix(tx.trim_left(s), prefix = "chave")
    let i = tx.trim_chars(tx.trim_suffix(s, suffix = "  "), set = " c")
    print(f"{a} {b} {c} {d} {e} {f} {g} [{h}] [{i}] {tem_chave(s)}")
    var resto = "l1\nl2"
    while true {
        let linha = tx.next_line(&resto)
        if linha == none {
            break
        }
        print(linha or_else "")
    }
    var campos = "x,y"
    let campo = tx.next_field(&campos, sep = ",")
    print(campo or_else "")
    print(tx.is_digit(55) and tx.is_alpha(65) and tx.is_alnum(97) and tx.is_space(32) and tx.is_upper(65) and tx.is_lower(97) and tx.is_hex_digit(70) and tx.is_print(126))
}
