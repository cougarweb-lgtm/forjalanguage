// v1.11 L9 (A12): static_assert no topo do arquivo confere const, literal, bool e contas na compilacao.
const LARGURA: int = 64
const LADO: int = 8

static_assert(LARGURA == LADO * 8, msg = "largura e 8 lados")
static_assert(not (LARGURA < LADO))
static_assert(true)
static_assert(LARGURA - LADO > 0 and LADO != 0, msg = "contas entre const")

proc main() {
    print(LARGURA)
}
