// ok_handle_saida.fj - M6c P87: 'creates banco' com parametro de saida: &db e o local dono; defer fecha. Sem erro.
// Esperado: 'forja check' sai 0 sem saida. Hoje: falha (a clausula ainda nao existe).
foreign {
    opaque Db
    proc sqlite3_open(nome: cstr, banco: ^?^Db) -> i32 creates banco
    proc sqlite3_close(b: ?^Db) destroys b
}

proc main() {
    var db: ?^Db = none
    let codigo = sqlite3_open("x.db", banco = &db)
    defer sqlite3_close(db)
    print(codigo)
}
