// v1.11 L12a (A04): [N]T de numero faz conta elemento a elemento: a + b, a - b, a * b, a / b, a * k, k * a, a / k, -a, += e -=.
// Cada elemento segue a regra do escalar: inteiro com o tipo do elemento, literal adota T, unidade confere por elemento.
unit Metros: f32
unit Segundos: f32
unit MetrosPorSegundo = Metros / Segundos

proc main() {
    let a: [3]f32 = {1.0, 2.0, 3.0}
    let b: [3]f32 = {4.0, 5.0, 6.0}
    let soma = a + b
    let produto: [3]f32 = a * b
    let metade: [3]f32 = (a + b) / 2.0
    let dobro = 2 * a
    let oposto = -a
    var pos: [3]f32 = {0.0, 0.0, 0.0}
    pos += a * 0.5
    pos -= b
    let inteiros: [2]i32 = {7, 9}
    let dez = inteiros * 10 / 3
    let bytes: [2]u8 = {1, 2}
    let mais = bytes + bytes
    let d: [2]Metros = {1.0, 2.0}
    let t: [2]Segundos = {2.0, 4.0}
    let v: [2]MetrosPorSegundo = d / t
    print(f"{soma[0]} {produto[1]} {metade[2]} {dobro[0]} {oposto[1]} {pos[2]} {dez[0]} {mais[1]} {v[0]}")
}
