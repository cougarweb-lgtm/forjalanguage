// v1.11 L12b (A04): em [2]T, [3]T e [4]T as letras x y z w (ou r g b a) sao os elementos 0..3. Uma letra le e grava (v.x, &v.x, v.x += e);
// (a linguagem ainda nao tem *= nem /=)
// 2 a 4 letras montam um [k]T novo (v.xy, v.zyx, v.xx, cor.bgra).
unit Metros: f32

proc main() {
    var v: [3]f32 = {1.0, 2.0, 3.0}
    v.x = 4.0
    v.y += 0.5
    v.z = v.z - 9.8 * 0.1
    let px = &v.x
    px^ = 7.0
    let xy = v.xy
    let invertido: [3]f32 = v.zyx
    let repetido = v.xx
    var cor: [4]f32 = {0.1, 0.2, 0.3, 1.0}
    cor.a = 0.5
    let bgr = cor.bgr
    let rb: [2]f32 = cor.rb
    let inteiros: [4]i32 = {1, 2, 3, 4}
    let dois: [2]i32 = inteiros.wz
    var par: [2]i32 = {5, 6}
    par.y += 2
    let d: [2]Metros = {1.0, 2.0}
    let primeiro: Metros = d.x
    print(f"{xy[0]} {invertido[2]} {repetido[1]} {bgr[0]} {rb[1]} {dois[0]} {par.y} {primeiro} {v.x} {cor.a}")
}
