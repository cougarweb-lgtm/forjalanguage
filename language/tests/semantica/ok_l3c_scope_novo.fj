// L3c: alloc = scope (forma nova de em = escopo): solta no fim do bloco; a saida e a de ok_l3c_scope_antigo.fj.
struct Grifo {
    vida: i32 = 5
}

proc usar(g: ^Grifo) -> int {
    return g.vida as int
}

proc main() {
    let g = new(Grifo, alloc = scope)
    print(usar(g))
    var l = make([dynamic]int, alloc = scope, cap = 2)
    append(&l, item = 1)
    let s = format(f"n={len(l)}", alloc = scope)
    print(s)
    if len(l) > 0 {
        let t = format_c(f"t{1}", alloc = scope)
        print(t)
    }
}
