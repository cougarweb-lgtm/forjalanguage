// 0.45.0: N aliases do mesmo simbolo C no mesmo modulo, com tipos diferentes de mesma ABI (ponteiro = inteiro de 64 bits).
foreign {
    link "msvcrt"
    proc strlen(s: cstr) -> uint
    proc tam_ptr = "strlen"(s: ^u8) -> uint
    proc tam_raw = "strlen"(s: rawptr) -> u64
    proc tam_int = "strlen"(s: u64) -> u64
    proc tam_opt = "strlen"(s: ?cstr) -> int
}

proc main() {
    let c: cstr = "forja"
    let p = c as rawptr
    print(strlen(c))
    print(tam_raw(p))
    print(tam_opt(c))
    print(tam_ptr(p as ^u8))
    print(tam_int(transmute(p, to = u64)))
}
