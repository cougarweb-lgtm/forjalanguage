// ok_curto_and_or: cadeias and/or, aninhados, valor booleano usado depois e chamada de efeito no 2o operando (passe curto; semantica do curto-circuito).

proc sinal(n: int, v: bool) -> bool {
    print(n)
    return v
}

proc eh_branco(c: u8) -> bool {
    return c == 32 or c == 9 or c == 10 or c == 13 or c == 12
}

proc aninhado(a: int, b: int, c: int) -> int {
    if (a > 0 and (b > 0 or c > 0)) or (not (a > 5) and b == c) {
        return 1
    }
    return 0
}

proc guarda(a: int, b: int) -> int {
    let ok: bool = a > 0 and b > 0
    var r: int = 0
    if ok {
        r = 10
    }
    if ok or a == -1 {
        r += 1
    }
    return r
}

proc e_ou(a: bool, b: bool, c: bool) -> int {
    if (a and sinal(1, b)) or sinal(2, c) {
        return 1
    }
    return 0
}

proc main() {
    var brancos: int = 0
    for c in 0..<64 {
        if eh_branco(c as u8) {
            brancos += 1
        }
    }
    print(brancos)
    var soma: int = 0
    for a in -1..<8 {
        for b in -1..<3 {
            for c in -1..<3 {
                soma += aninhado(a, b, c)
            }
        }
    }
    print(soma)
    print(guarda(1, 1))
    print(guarda(1, 0))
    print(guarda(-1, -1))
    print(e_ou(false, false, false))
    print(e_ou(true, true, false))
}
