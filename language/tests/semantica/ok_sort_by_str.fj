// K08a (sort_by): str como elemento; o comparador recebe ^str (ponteiro, nunca str por valor), entao nao cruza a fronteira C.
proc menor_tamanho(a: ^str, b: ^str) -> bool {
    return len(a^) < len(b^)
}

proc main() {
    var palavras: [3]str = {"abc", "a", "ab"}
    sort_by(palavras[..], less = menor_tamanho)
}
