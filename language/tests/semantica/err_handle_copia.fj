// err_handle_copia.fj - M6c P87: 'let g = f' copia o handle = E0317 (dois donos) na expressao 'f' do let. O defer ja cobre f, so o copia e recusado.
// Esperado: 'forja check' sai 1 com E0317 na linha 12, coluna do 'f' de 'let g = f'. Hoje: falha de outro codigo.
foreign {
    opaque Arq
    proc fopen_c(caminho: cstr, modo: cstr) -> ?^Arq creates
    proc fclose_c(f: ?^Arq) -> i32 destroys f
}

proc main() {
    let f = fopen_c("a.txt", "r")
    defer fclose_c(f)
    let g = f
    print(1)
}
