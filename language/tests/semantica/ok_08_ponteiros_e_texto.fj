const NOME: str = "Forja"
const RAIZ: cstr = "raiz"

struct Grifo {
    vida: i32 = 100
}

struct Dono {
    alvo: ^Grifo
}

struct No {
    valor: i32 = 0
    prox: ?^No
}

proc zera(p: ^i32) {
    p^ = 0
}

proc tem(p: ?^Grifo) -> bool {
    return p != none
}

proc main() {
    var x: i32 = 5
    let p = &x
    p^ = 7
    p^ += 1
    var y: int = 1
    var q = &y
    let pp = &q
    pp^^ = 42
    var g = Grifo{}
    let h = &g
    h.vida = 3
    h^.vida = 4
    let copia = h^
    var g2 = Grifo{}
    let d = Dono{alvo = &g2}
    d.alvo.vida = 50
    let a: ?^Grifo = &g
    let b: ?^Grifo = none
    if a != none {
        let c = a as ^Grifo
        c.vida = 1
    }
    print(b == none)
    print(tem(&g))
    print(tem(none))
    let r = &g as rawptr
    let _v = r as ^Grifo
    let nada: rawptr = none
    print(r != nada)
    print(nada == none)
    zera(&x)
    print(copia.vida)
    print(x)
    var s = "Grifo"
    let ps = &s
    let t: str = NOME
    let c: cstr = "abc"
    print(s)
    print(c)
    print(RAIZ)
    print(len(s) + len(ps^))
    print(s == "Grifo")
    print(s != t)
    print((c as str) == "abc")
    let cr = c as rawptr
    print(cr == none)
    assert(x == 0, msg = c)
    assert(x == 0)
    assert(x == 0, msg = "msg")
}
