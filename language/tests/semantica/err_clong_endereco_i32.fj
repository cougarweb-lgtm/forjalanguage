// err_clong_endereco_i32.fj - M6c P91b: &n de um c_long para destino ^i32 = E0342 (so ^c_long recebe).
// Esperado: 'forja check' sai 1 com E0342 na linha 13, coluna do 'n' de '&n' (var p: ^i32 = &n).
foreign {
    proc labs(n: c_long) -> c_long
}

proc usar(p: ^i32) {
    p^ = 1
}

proc main() {
    var n = 5 as c_long
    var p: ^i32 = &n
    p^ = 1
    usar(&n)
}
