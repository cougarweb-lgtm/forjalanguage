// L10c: os usos validos de decode, encode, rune_count, valid_utf8, next_rune, from_rune, pad_left, pad_right, center e str_reverse de std:text.
import "std:text" as tx

proc main() {
    let runa, tamanho = tx.decode("ção", at = 0)
    var buf = make([dynamic]u8, alloc = heap)
    defer delete(buf)
    tx.encode(runa, &buf)
    let codificada = to_str(&buf)
    defer delete(codificada)
    var resto = "ação"
    let proxima = tx.next_rune(&resto) or_else 0
    let sozinha = tx.from_rune(proxima, alloc = heap)
    defer delete(sozinha)
    let esquerda = tx.pad_left("7", 3, fill = 48, alloc = heap)
    defer delete(esquerda)
    let direita = tx.pad_right("ab", 5, alloc = heap)
    defer delete(direita)
    let meio = tx.center("é", 4, fill = 183, alloc = heap)
    defer delete(meio)
    let invertido = tx.str_reverse(meio, alloc = heap)
    defer delete(invertido)
    print(f"{tamanho} {codificada} {tx.rune_count(codificada)} {tx.valid_utf8(codificada)} {sozinha} {esquerda} {direita} {meio} {invertido}")
}
