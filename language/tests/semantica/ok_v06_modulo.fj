// V-06 = B em proc de modulo: o 1o argumento nomeado e o 2o posicional passam a valer.
import "std:mem" as mem

proc main() {
    let a = mem.arena_create(4096)
    let b = mem.arena_create(block_size = 8192)
    print(mem.arena_used(a))
    print(mem.arena_used(a = b))
    mem.arena_destroy(a)
    mem.arena_destroy(b)
}
