enum ErroCarga { nao_encontrado, corrompido }

struct Malha {
    vertices: i32 = 0
}

const MALHA_CUBO: Malha = Malha{vertices = 8}

proc carregar(id: i32) -> Malha ! ErroCarga {
    if id == 0 {
        return ErroCarga.nao_encontrado
    }
    return Malha{vertices = 4}
}

proc contar(id: i32) -> int ! ErroCarga {
    if id < 0 {
        return ErroCarga.corrompido
    }
    return 7
}

proc validar(id: i32) -> ! ErroCarga {
    if id < 0 {
        return ErroCarga.corrompido
    }
}

proc somar(a: i32, b: i32) -> int ! ErroCarga {
    let x = try contar(a)
    let y = contar(b) or_else 0
    return x + y
}

proc repassar(a: i32) -> int ! ErroCarga {
    return contar(a)
}

proc main() {
    let _r = somar(1, b = 2)
    let v = somar(3, b = 4) or_else 0
    print(v)
    let m = carregar(0) or_else MALHA_CUBO
    print(m.vertices)
    let s = repassar(5) or_else 1
    print(s)
}
