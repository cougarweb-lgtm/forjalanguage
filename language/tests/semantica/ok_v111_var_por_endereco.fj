// v1.11 L10a: var passada por & (inteira ou parte), fatiada, percorrida com for &item ou alterada por append e var de verdade: sem E0707.
struct Caixa {
    dentro: i32 = 0
}

proc zera(p: ^i32) {
    p^ = 0
}

proc zera_caixa(p: ^Caixa) {
    p.dentro = 0
}

proc main() {
    var v: i32 = 5
    zera(&v)
    var c = Caixa{}
    zera_caixa(&c)
    var a: [3]i32 = {1, 2, 3}
    for &item in a {
        item^ = item^ + 1
    }
    var b: [3]i32 = {1, 2, 3}
    let f = b[..]
    var l = make([dynamic]int, alloc = heap, cap = 4)
    append(&l, item = 4)
    print(v + c.dentro + a[0] + len(f) as i32 + len(l) as i32)
    delete(l)
}
