// L11c (S3 P5b-1): handle de arquivo do std:file - open, write_str, write, seek, tell, read, flush, close e append_str. Fixture de semantica (so forja check): a saida real e a de tests\nativo\s3\handle\verificar_handle.py.
import "std:file" as file

proc ler_posicao(caminho: str) -> int ! file.FileError {
    var f = try file.open(caminho, mode = file.OpenMode.read)
    defer file.close(&f)
    var bloco: [4]u8 = {0, 0, 0, 0}
    let lidos = try file.read(&f, into = bloco[..])
    let pos = try file.seek(&f, 2, from = file.SeekFrom.start)
    let atual = try file.tell(&f)
    return lidos + (pos as int) + (atual as int)
}

proc gravar_texto(caminho: str) -> ?file.FileError {
    var resultado: ?file.FileError = none
    switch aberto in file.open(caminho, mode = file.OpenMode.write) {
    case file.File:
        var f = aberto
        resultado = file.write_str(&f, "abcdef")
        let descarga = file.flush(&f)
        file.close(&f)
        if descarga != none {
            resultado = descarga
        }
    case file.FileError:
        resultado = file.FileError.closed
    }
    return resultado
}

proc main() {
    let _antes = file.remove_file("l11c_handle.bin")
    switch r in ler_posicao("l11c_handle.bin") {
    case int:
        print(r)
    case file.FileError:
        print("erro")
    }
    let erro = gravar_texto("l11c_handle.bin")
    if erro == none {
        print("ok")
    }
    let anexado = file.append_str("l11c_handle.bin", "xyz")
    if anexado == none {
        print("anexado")
    }
    let _depois = file.remove_file("l11c_handle.bin")
}
