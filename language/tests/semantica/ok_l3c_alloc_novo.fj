// L3c: o rotulo alloc (forma nova de em) em new, make, format e format_c, com heap e frame; a saida e a mesma de ok_l3c_alloc_antigo.fj.
struct Grifo {
    vida: i32 = 5
}

proc main() {
    let g = new(Grifo, alloc = heap)
    defer delete(g)
    print(g.vida as int)
    var l = make([dynamic]int, alloc = heap, cap = 2)
    defer delete(l)
    append(&l, item = 7)
    print(l[0])
    let s = format(f"n={len(l)}", alloc = heap)
    defer delete(s)
    print(s)
    let c = format_c(f"c{len(l)}", alloc = heap)
    defer delete(c)
    print(c)
    let t = new(int, alloc = frame)
    t^ = 9
    print(t^)
    frame_reset()
}
