// IA1-L8: a raiz e dois modulos declaram o mesmo proc, struct, enum e const; cada nome vale no seu modulo e o qualificador escolhe o outro.
import "mods/l8_a"
import "mods/l8_b"

const LIMITE: int = 99

enum Modo { unico }

struct Config {
    raiz: bool = true
}

proc somar(a: int, b: int) -> int {
    return a * b
}

proc main() {
    let ca = l8_a.Config{nivel = 3}
    let cb = l8_b.Config{peso = 7}
    let cr = Config{}
    let ma: l8_a.Modo = l8_a.modo_padrao()
    let mb: l8_b.Modo = l8_b.Modo.forte
    let mr = Modo.unico
    print(l8_a.somar(1, 2) + l8_b.somar(1, 2) + somar(2, 3))
    print(l8_a.LIMITE + l8_b.LIMITE + LIMITE)
    print(ca.nivel + cb.peso)
    if ma == l8_a.Modo.rapido and mb == l8_b.Modo.forte and mr == Modo.unico and cr.raiz {
        print(1)
    }
}
