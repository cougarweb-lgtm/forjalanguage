// ok_handle_defer.fj - M6c P87: handle criado por 'creates' e fechado por 'defer' logo depois do let. Sem erro.
// Esperado: 'forja check' sai 0 sem saida. Hoje: falha (a clausula creates/destroys ainda nao existe).
foreign {
    opaque Arq
    proc fopen_c(caminho: cstr, modo: cstr) -> ?^Arq creates
    proc fclose_c(f: ?^Arq) destroys f
}

proc main() {
    let f = fopen_c("a.txt", "r")
    defer fclose_c(f)
    print(1)
}
