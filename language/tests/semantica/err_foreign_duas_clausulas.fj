// err_foreign_duas_clausulas.fj - M6c P85: no maximo uma clausula por proc foreign; a 2a palavra (takes) = E0912.
// Esperado: 'forja check' e 'forja ast' saem 1 com E0912 em linha 5, coluna do 'takes'. Hoje: E0101.
foreign {
    opaque Arq
    proc copiar_c(origem: ?^Arq, destino: ?^Arq) -> i32 destroys origem takes destino
}

proc main() {
    print(1)
}
