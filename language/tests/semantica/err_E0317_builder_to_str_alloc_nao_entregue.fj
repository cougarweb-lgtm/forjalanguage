// IA1-B01: a str de to_str de builder do alocador do chamador (alloc) e dona dessa memoria; guardada e nao entregue ao fim do bloco: E0317.
proc monta(n: int, alloc: Allocator) -> int {
    var buf = make([dynamic]u8, alloc = alloc, cap = 8)
    append(&buf, item = "x")
    let s = to_str(&buf)
    delete(buf)
    return n + len(s)
}

proc main() {
    print(monta(1, alloc = heap))
}
