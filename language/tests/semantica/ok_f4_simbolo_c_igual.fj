// F4: o mesmo simbolo C em 2 modulos e na raiz, com assinatura identica (com e sem alias), vale.
import "mods/f4_proto_a"
import "mods/f4_proto_c"

foreign {
    link "kernel32"
    proc pid_raiz = "GetCurrentProcessId"() -> u32
}

proc main() {
    print(f4_proto_a.pid_a() == f4_proto_c.pid_c())
    print(pid_raiz() == f4_proto_a.pid_a())
}
