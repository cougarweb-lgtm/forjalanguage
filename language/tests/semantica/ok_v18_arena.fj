import "std:mem"

struct Grifo {
    vida: i32 = 1
}

proc main() {
    var a = mem.arena_create(1024)
    let g = new(Grifo, alloc = a)
    var l = make([dynamic]int, alloc = a, cap = 4)
    append(&l, item = g.vida as int)
    let s = format(f"v={l[0]}", alloc = a)
    print(s)
    delete(l)
    let pa = &a
    let h = new(int, alloc = pa)
    h^ = 2
    let p = mem.pool_create()
    let q = new(Grifo, alloc = p)
    delete(q, alloc = p)
    mem.arena_reset(a)
    mem.arena_destroy(a)
    mem.pool_destroy(p)
}
