// IA1-B01: to_str de builder em frame e valido: a str herda a origem do frame (sem delete, sem E0317) e frame_reset a libera.
proc monta() -> str {
    var buf = make([dynamic]u8, alloc = frame, cap = 8)
    append(&buf, item = "texto")
    return to_str(&buf)
}

proc main() {
    let s = monta()
    print(s)
    frame_reset()
}
