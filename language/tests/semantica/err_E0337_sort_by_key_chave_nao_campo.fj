// K08b: sort_by_key com chave que nao e campo da struct do elemento (aqui e outra struct). E0337.
struct Item {
    chave: int
    seq: int
}

struct Outra {
    chave: int
}

proc main() {
    var l = make([dynamic]Item, alloc = heap)
    append(&l, item = Item{chave = 1, seq = 1})
    sort_by_key(l[..], key = Outra.chave)
    delete(l)
}
