// L9d: index_of/contains/count pedem elemento comparavel (inteiro, real, bool, str ou enum): struct nao tem ==.
struct Ponto {
    x: int
    y: int
}

proc main() {
    var l = make([dynamic]Ponto, alloc = heap)
    defer delete(l)
    append(&l, item = Ponto{x = 1, y = 2})
    print(contains(l, Ponto{x = 1, y = 2}))
}
