// L10f: std:fmt, dinheiro e leitura - uso correto: fixed/money (texto dono com delete; scale, symbol, accounting e code nomeados), write_fixed/write_money no builder, parse_* tratados por try, or_else e switch, o `at` (?^int) e ParseError.
import "std:fmt" as fmt

proc ler_conta(texto: str) -> int ! fmt.ParseError {
    let cents = try fmt.parse_money(texto, loc = fmt.PT_BR)
    return cents
}

proc main() {
    let a: str = fmt.fixed(122334, loc = fmt.PT_BR, alloc = heap)
    defer delete(a)
    let b: str = fmt.fixed(5899, fmt.EN_US, scale = 3, alloc = heap)
    defer delete(b)
    let c: str = fmt.money(122334, loc = fmt.PT_BR, alloc = heap)
    defer delete(c)
    let d: str = fmt.money(-122334, loc = fmt.DE_DE, scale = 2, symbol = true, accounting = true, code = "USD", alloc = heap)
    defer delete(d)
    var buf = make([dynamic]u8, alloc = heap, cap = 32)
    defer delete(buf)
    fmt.write_fixed(7, buf = &buf, loc = fmt.ISO, scale = 0)
    fmt.write_money(7, buf = &buf, loc = fmt.FR_FR, symbol = false)
    var onde = -1
    let n = fmt.parse_number("1.234,5", loc = fmt.PT_BR) or_else 0.0
    let i = fmt.parse_integer("1.234", loc = fmt.PT_BR, at = &onde) or_else 0
    let f = fmt.parse_fixed("1.223,3", loc = fmt.PT_BR, scale = 2) or_else 0
    let p = fmt.parse_percent("12,5%", loc = fmt.PT_BR) or_else 0.0
    let m = ler_conta("R$ 1,00") or_else 0
    switch r in fmt.parse_money("(R$ 1,00)", loc = fmt.PT_BR, scale = 2, at = &onde) {
    case int:
        print(f"{r}")
    case fmt.ParseError:
        print(f"{r == fmt.ParseError.grouping} {onde}")
    }
    print(f"{a} {b} {c} {d} {len(buf)} {n} {i} {f} {p} {m}")
}
