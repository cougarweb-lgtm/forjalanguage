// v1.11 L13 (A13): sqrt embutido so de f32 ou f64 sem unidade; um literal sozinho vira f32 (sqrt(4.0), sqrt(2)). O resultado tem o tipo do argumento.
proc main() {
    let x: f32 = 16.0
    let y: f64 = 2.0
    let r = sqrt(x)
    let s = sqrt(y)
    let t = sqrt(4.0)
    let u = sqrt(2)
    let h = sqrt(x * x + 9.0)
    print(f"{r} {s} {t} {u} {h}")
}
