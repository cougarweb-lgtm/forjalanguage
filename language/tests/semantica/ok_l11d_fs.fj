// L11d (S3 P6, D8): sistema de arquivos do std:file - exists, is_file, is_dir, stat, remove_file, rename, copy_file, make_dir, remove_dir e read_dir. Fixture de semantica (so forja check): a saida real e a de tests\nativo\s3\fs\verificar_fs.py.
import "std:file" as file

proc consultar(caminho: str) -> int {
    var total = 0
    if file.exists(caminho) {
        total += 1
    }
    if file.is_file(caminho) {
        total += 2
    }
    if file.is_dir(caminho) {
        total += 4
    }
    return total
}

proc ler_tamanho(caminho: str) -> i64 ! file.FileError {
    let info = try file.stat(caminho)
    return info.size + info.mtime_ns
}

proc contar_itens(caminho: str) -> int ! file.FileError {
    var lista = try file.read_dir(caminho, alloc = heap)
    defer delete(lista.items)
    defer delete(lista.data)
    return len(lista.items)
}

proc arrumar(origem: str, destino: str) -> ?file.FileError {
    var resultado: ?file.FileError = none
    resultado = file.copy_file(origem, destino)
    if resultado != none {
        return resultado
    }
    resultado = file.rename(destino, origem)
    if resultado != none {
        return resultado
    }
    return file.remove_file(origem)
}

proc pastas(caminho: str) -> ?file.FileError {
    let criada = file.make_dir(caminho, all = true)
    if criada != none {
        return criada
    }
    return file.remove_dir(caminho, all = true)
}

proc main() {
    print(consultar("x"))
    switch n in contar_itens("x") {
    case int:
        print(n)
    case file.FileError:
        print("erro")
    }
    switch t in ler_tamanho("x") {
    case i64:
        print(t > 0)
    case file.FileError:
        print("erro")
    }
    if arrumar("a", "b") != none {
        print("erro")
    }
    if pastas("p") != none {
        print("erro")
    }
}
