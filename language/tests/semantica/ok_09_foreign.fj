unit Metros: f32

enum Codigo { sucesso, falha }

struct Divisao {
    quot: i32 = 0
    rem: i32 = 0
}

foreign {
    link "m"
    proc c_sqrt = "sqrt"(x: f64) -> f64
    proc fabsf(x: f32) -> f32
    proc tipos_inteiros(a: i8, b: i16, c: i64, d: u8, e: u16, f: u32, g: u64, h: uint, i: int) -> u32
    proc inverte(b: bool) -> bool
    proc para_metros(m: Metros) -> Metros
    proc estado(c: Codigo) -> Codigo
    proc getenv(nome: cstr) -> cstr
    proc preencher(destino: ^Divisao, n: i32 = 1) -> ?^Divisao
    proc memset(destino: rawptr, valor: i32, n: u64) -> rawptr
    proc div(numerador: i32, denominador: i32) -> Divisao
    proc dividir_por_valor(d: Divisao) -> i32
    proc puts(texto: cstr) -> i32
    proc InitWindow(largura: i32, altura: i32, titulo: cstr)
}

foreign {
    link "m"
    link "m"
}

foreign {
    proc labs(n: i32) -> i32
}

test "foreign dentro de test" {
    expect(labs(-1) == 1)
}

pub export proc raiz(x: f64) -> f64 {
    return c_sqrt(x)
}

proc main() {
    let r = c_sqrt(4.0)
    let d = div(7, denominador = 2)
    var base = Divisao{}
    let p = preencher(&base)
    _ = preencher(&base, n = 3)
    let c: cstr = "oi"
    print(puts("oi"))
    print(puts(c))
    InitWindow(800, altura = 600, titulo = "Janela")
    print(r > 1.0)
    print(d.quot)
    print(p == none)
    print(estado(Codigo.sucesso) == Codigo.falha)
}
