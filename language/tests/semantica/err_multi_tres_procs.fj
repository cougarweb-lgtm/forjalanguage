// L7: tres procs com um erro cada saem em tres linhas na ordem do fonte; o 2o erro do mesmo proc nao entra (um erro por declaracao).
proc um() {
    let a: i32 = true
    let b: bool = 1
    print(a)
}

proc dois() {
    print(nome_solto)
}

proc tres() -> i32 {
    let c: f32 = true
    return 0
}

proc main() {
    um()
    dois()
    tres()
}
