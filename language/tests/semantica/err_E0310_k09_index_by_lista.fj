// K09 (index_by): colecao errada. Lista dona nao entra direto: use l[..], como no sort_by. E0310.
struct Item {
    chave: int
}

proc chave_cinco(a: ^Item) -> bool {
    return a.chave == 5
}

proc main() {
    var l = make([dynamic]Item, alloc = heap)
    let i, ok = index_by(l, pred = chave_cinco)
    print(i)
    delete(l)
}
