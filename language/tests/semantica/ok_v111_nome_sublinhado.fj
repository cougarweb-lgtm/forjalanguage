// v1.11 L10a-bis: nome com '_' na frente e mais algum caractere (_r, _v, _t) isenta o E0708: let, var e elemento de tupla.
proc dividir(a: int, b: int) -> (q: int, r: int) {
    return a / b, a % b
}

proc dobro(n: i32) -> i32 {
    return n * 2
}

proc main() {
    let _r = dobro(3)
    var _v = 1
    _v = 2
    let q, _t = dividir(7, b = 2)
    print(q)
}
