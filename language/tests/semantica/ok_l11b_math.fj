// S3 P3 (L11b-1): std:math com f64, f32, literal, constantes e procs puros. Saida: uma linha por print.
import "std:math" as math

proc main() {
    let x32: f32 = 2.5
    let x64: f64 = 2.5
    print(math.floor(2.7) as int)
    print(math.pow(x32, y = 2.0) as int)
    print(math.pow(x64, y = 2.0) as int)
    print(math.hypot(3.0, 4.0) as int)
    print(math.is_nan(math.nan_f32()))
    print(math.is_finite(math.inf_f32()))
    print(math.is_inf(math.inf()))
    print(math.PI as int)
    print(math.lerp(0.0, 10.0, 0.5) as int)
    print(math.lerp(x32, 10.0, 0.5) as int)
    print(math.deg_to_rad(180.0) > 3.14)
    print(math.sign(-x32) as int)
}
