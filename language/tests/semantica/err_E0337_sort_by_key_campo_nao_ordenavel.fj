// K08b: sort_by_key com campo bool como chave. bool nao e ordenavel pelo runtime: E0337.
struct Item {
    ativo: bool
    seq: int
}

proc main() {
    var l = make([dynamic]Item, alloc = heap)
    append(&l, item = Item{ativo = true, seq = 1})
    sort_by_key(l[..], key = Item.ativo)
    delete(l)
}
