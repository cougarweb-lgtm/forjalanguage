// V-06 = B: o argumento e posicional (na ordem dos parametros) OU nomeado; nunca posicional depois de nomeado.
proc area(w: int, h: int = 2, e: int = 1) -> int {
    return w * h * e
}

proc soma(a: int, b: int) -> int {
    return a + b
}

proc main() {
    print(area(3, 2, 5))
    print(area(3, 2))
    print(area(3, e = 5))
    print(area(3, h = 4, e = 5))
    print(area(w = 3, h = 4))
    print(area(w = 3))
    print(soma(1, 2))
    print(soma(a = 1, b = 2))
    print(soma(1, b = 2))
    let f: proc(p: int, q: int) -> int = soma
    print(f(4, 5))
    print(f(4, q = 5))
}
