// K08c (dedup): lista var de int e de enum (comparaveis com ==); dedup sem retorno. Saida: 2 e 3.
enum Cor { verde, azul, amarelo }

proc main() {
    var l = make([dynamic]int, alloc = heap)
    defer delete(l)
    append(&l, item = 1)
    append(&l, item = 1)
    append(&l, item = 2)
    dedup(&l)
    print(len(l))
    var c = make([dynamic]Cor, alloc = heap)
    defer delete(c)
    append(&c, item = Cor.verde)
    append(&c, item = Cor.verde)
    append(&c, item = Cor.azul)
    append(&c, item = Cor.verde)
    dedup(&c)
    print(len(c))
}
