enum Cor {
    vermelho
    verde
    azul
}

proc conta(s: bit_set[Cor]) -> int {
    return len(s)
}

proc main() {
    var s: bit_set[Cor] = {Cor.verde}
    insert(&s, key = Cor.azul)
    remove(&s, key = Cor.verde)
    let t: bit_set[Cor] = {Cor.vermelho, Cor.azul}
    let u = s | t
    let d = t - s
    if has(u, key = Cor.vermelho) and s != t {
        print(conta(u))
    }
    for c in d {
        print(c == Cor.vermelho)
    }
}
