proc achar(n: int) -> ?int {
    if n > 0 {
        return n * 2
    }
    return none
}

proc main() {
    let a = achar(3)
    let b = achar(0)
    print(a or_else 0)
    print(b or_else 7)
    switch v in a {
    case int:
        print(v + 1)
    case none:
        print(0)
    }
    switch b {
    case none:
        print(1)
    default:
        print(2)
    }
    print(a != none)
    print(b == none)
    var c: ?i32 = none
    print(c == none)
    c = 5
    print(c or_else 0)
    let d: ?cstr = none
    print(d == none)
    let e: ?cstr = "Grifo"
    switch t in e {
    case cstr:
        print(t)
    case none:
        print("nada")
    }
}
