enum Direcao { cima, baixo, esquerda, direita }

const PADRAO: Direcao = Direcao.baixo

struct Nave {
    rumo: Direcao = Direcao.cima
    vida: i32 = 3
}

proc oposta(d: Direcao) -> Direcao {
    if d == Direcao.cima {
        return Direcao.baixo
    }
    return Direcao.cima
}

proc main() {
    var n = Nave{rumo = PADRAO}
    n.rumo = oposta(n.rumo)
    if n.rumo != Direcao.baixo {
        print(0)
    }
    print(n.vida)
}
