// K08a (sort_by): less por nome de proc e por variavel local de tipo proc; os dois aceitos.
struct Item {
    chave: int
    seq: int
}

proc por_chave(a: ^Item, b: ^Item) -> bool {
    return a.chave < b.chave
}

proc main() {
    var l = make([dynamic]Item, alloc = heap)
    append(&l, item = Item{chave = 2, seq = 1})
    append(&l, item = Item{chave = 1, seq = 2})
    sort_by(l[..], less = por_chave)
    let outro = por_chave
    sort_by(l[..], less = outro)
    delete(l)
}
