// K08a (sort_by): struct como elemento; o comparador recebe ^Struct.
struct Ponto {
    x: int
    y: int
}

proc menor_x(a: ^Ponto, b: ^Ponto) -> bool {
    return a.x < b.x
}

proc main() {
    var pontos: [2]Ponto = {Ponto{x = 2, y = 0}, Ponto{x = 1, y = 0}}
    sort_by(pontos[..], less = menor_x)
}
