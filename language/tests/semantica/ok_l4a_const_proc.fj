const N: i32 = 3
struct Par {
    nome: i32
    a: Acao
    b: Acao
}
struct Acao {
    id: i32
    f: proc(x: i32) -> i32
    peso: i32 = 5
}
const TAB: [N]Acao = {Acao{id = 1, f = dobra}, Acao{id = 2, f = tripla, peso = 7}, Acao{id = 3, f = soma10}}
const UNICO: Par = Par{nome = 9, a = Acao{id = 4, f = tripla}, b = Acao{id = 5, f = dobra}}
const FN: proc(x: i32) -> i32 = soma10
const COM_BASE: i32 = 40
proc soma10(x: i32) -> i32 {
    return x + 10
}
proc dobra(x: i32) -> i32 {
    return x * 2
}
proc tripla(x: i32) -> i32 {
    return x * 3
}
proc main() {
    var s: i32 = 0
    for i in 0..<N {
        let a = TAB[i]
        s += a.f(a.id) * a.peso
    }
    print(s)
    let u = UNICO
    print(u.a.f(u.nome) + u.b.f(u.nome))
    let g = FN
    print(g(COM_BASE))
    print(TAB[1].f(10))
}
