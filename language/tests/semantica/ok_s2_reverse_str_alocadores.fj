// S2a: reverse(str, alloc = A) devolve str nova no alocador dado (heap com delete, frame); reverse de lista continua sem alloc.
proc main() {
    let r = reverse("abc", alloc = heap)
    print(r)
    delete(r)
    let f = reverse("xyz", alloc = frame)
    print(f)
    var xs: [3]int = {1, 2, 3}
    reverse(xs)
    print(xs[0])
}
