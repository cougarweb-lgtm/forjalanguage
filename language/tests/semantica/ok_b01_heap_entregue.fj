struct Grifo {
    vida: i32 = 5
}

struct Ninho {
    dono: ?^Grifo = none
}

proc rotulo(n: int, alloc: Allocator) -> str {
    return format(f"item-{n}", alloc = alloc)
}

proc grifo(alloc: Allocator) -> ^Grifo {
    let g = new(Grifo, alloc = alloc)
    return g
}

proc lista(n: int, alloc: Allocator) -> [dynamic]int {
    var l = make([dynamic]int, alloc = alloc)
    append(&l, item = n)
    return l
}

proc quantos(n: int, alloc: Allocator) -> int {
    return n
}

proc soltar(g: ^Grifo) {
    delete(g)
}

proc entregar(n: ^Ninho) {
    let g = grifo(alloc = heap)
    n.dono = g
}

proc limpar(n: ^Ninho) {
    switch d in n.dono {
    case ^Grifo:
        delete(d)
    case none:
        print(0)
    }
}

proc devolver() -> str {
    let t = rotulo(2, alloc = heap)
    return t
}

proc main() {
    let a = rotulo(1, alloc = heap)
    print(a)
    delete(a)
    let b = rotulo(3, alloc = heap)
    defer delete(b)
    print(b)
    let c = devolver()
    print(c)
    delete(c)
    var n = Ninho{}
    entregar(&n)
    limpar(&n)
    let g = grifo(alloc = heap)
    soltar(g)
    var l = lista(4, alloc = heap)
    delete(l)
    let k = quantos(5, alloc = heap)
    print(k)
    let f = rotulo(6, alloc = frame)
    print(f)
    frame_reset()
}
