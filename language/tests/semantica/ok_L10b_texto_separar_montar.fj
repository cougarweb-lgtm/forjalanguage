// L10b: os usos validos de split_lines, fields, split_n, split_any (listas dono de vistas), replace, replace_n, replace_table (struct Replacement), repeat e concat de std:text.
import "std:text" as tx

proc conta_linhas(texto: str) -> int {
    var linhas = tx.split_lines(texto, alloc = heap)
    defer delete(linhas)
    return len(linhas)
}

proc main() {
    print(conta_linhas("a\r\nb\n"))
    var campos = tx.fields("  um  dois ", alloc = heap)
    defer delete(campos)
    var partes = tx.split_n("a,b,c", sep = ",", n = 2, alloc = heap)
    defer delete(partes)
    var varios = tx.split_any("a,b;c", set = ",;", alloc = heap)
    defer delete(varios)
    print(len(campos) + len(partes) + len(varios))
    let trocado = tx.replace("aaa", old = "aa", new = "X", alloc = heap)
    defer delete(trocado)
    let primeiro = tx.replace_n("aaa", old = "a", new = "b", n = 1, alloc = heap)
    defer delete(primeiro)
    var pares: [2]tx.Replacement = {tx.Replacement{old = "a", new = "b"}, tx.Replacement{old = "b", new = "c"}}
    let tabela = tx.replace_table("abc", pairs = pares[..], alloc = heap)
    defer delete(tabela)
    let repetido = tx.repeat("ab", n = 3, alloc = heap)
    defer delete(repetido)
    var pecas: [3]str = {"x", "y", "z"}
    let junto = tx.concat(pecas[..], alloc = heap)
    defer delete(junto)
    print(f"{trocado} {primeiro} {tabela} {repetido} {junto}")
}
