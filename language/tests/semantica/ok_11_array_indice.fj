const N: int = 3
const TRES: [3]int = {1, 2, 3}
const POS: int = 1

struct Grifo {
    vida: i32 = 10
    notas: [3]i32 = {1, 2, 3}
    zeros: [N]u8
    amigos: []i32
}

struct Bando {
    alvos: [2]^Grifo
    talvez: [2]?^Grifo
}

proc devolver() -> [3]int {
    return {7, 8, 9}
}

proc somar(v: [3]int, k: int = 0) -> int {
    return v[0] + v[1] + v[2] + k
}

proc tamanho(p: ^[4]int, s: []int) -> int {
    return len(p) + len(s)
}

proc main() {
    var a: [3]int = {1, 2, 3}
    a = {4, 5, 6}
    let z: [3]i32 = {}
    let b: [2]u8 = {255, 7}
    let m: [2][3]int = {{1, 2, 3}, {4, 5, 6}}
    let g = Grifo{notas = {9, 8, 7}, zeros = {1, 2, 3}}
    let h = Grifo{zeros = {}}
    let vazia: []i32 = {}
    var g1 = Grifo{zeros = {}}
    var g2 = Grifo{zeros = {}}
    let p: [2]^Grifo = {&g1, &g2}
    let q: [2]?^Grifo = {}
    let i8v: i8 = 1
    let u8v: u8 = 2
    let uv: uint = 0
    let iv: int = 1
    let r = devolver()
    var quatro: [4]int = {}
    let s = somar({1, 2, 3}, k = 2)
    print(a[i8v])
    print(a[u8v])
    print(a[uv])
    print(a[iv])
    print(a[POS])
    print(a[-0])
    print(m[1][2])
    print(z[2] == z[1])
    print(b[0])
    print(g.notas[1])
    print(devolver()[2])
    print(TRES[2])
    print(len(a))
    print(len(r))
    print(len(m[0]))
    print(len(vazia))
    print(len(h.amigos))
    print(len(&quatro))
    print(tamanho(&quatro, s = vazia2()))
    print(s)
    print(p[0].vida)
    print(q[1] == none)
}

proc vazia2() -> []int {
    return {}
}
