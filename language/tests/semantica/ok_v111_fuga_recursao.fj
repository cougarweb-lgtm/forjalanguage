proc contar(p: ^i32, n: i32) -> i32 {
    if n == 0 {
        return p^
    }
    return contar(p, n = n - 1)
}

proc par(a: ^i32, n: i32) -> i32 {
    if n == 0 {
        return a^
    }
    return impar(a, n = n - 1)
}

proc impar(a: ^i32, n: i32) -> i32 {
    return par(a, n = n)
}

proc main() {
    var x: i32 = 3
    let r = contar(&x, n = 4)
    let s = par(&x, n = 2)
    print(r + s)
}
