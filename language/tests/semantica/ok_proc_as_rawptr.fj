// 'x as proc(...)' de rawptr, ^T e ?^T (endereco que vem do C) e 'f as rawptr'; so f e g sao chamados (h e i vem de dados: so a conversao).
foreign {
    proc GetModuleHandleA(nome: cstr) -> rawptr
    proc GetProcAddress(modulo: rawptr, nome: cstr) -> rawptr
}

proc tick(self: rawptr) -> u64 {
    return 7
}

proc main() {
    let modulo = GetModuleHandleA("kernel32.dll")
    let endereco = GetProcAddress(modulo, nome = "GetTickCount64")
    let f = endereco as proc(self: rawptr) -> u64
    let g = tick as proc(self: rawptr) -> u64
    let bruto = f as rawptr
    var n: i32 = 4
    let p: ?^i32 = &n
    let h = p as proc(x: i32)
    let i = &n as proc(y: i32)
    let _h = h
    let _i = i
    print(f(bruto) > 0)
    print(g(bruto))
    print(g as rawptr == tick as rawptr)
}
