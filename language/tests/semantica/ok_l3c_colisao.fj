// L3c: identificadores do usuario que colidem com as formas novas (alloc, to, scope, file) e com as antigas (em, para): a troca e so no que o compilador resolve (rotulo de embutido,
// valor do alloc), nunca no nome do usuario. 'scope' e uma Arena do usuario, entao alloc = scope usa a variavel e nao a palavra.
import "std:mem"

proc somar(alloc: int, to: int, scope: int, file: int) -> int {
    return alloc + to + scope + file
}

proc multiplicar(em: int, para: int) -> int {
    return em * para
}

proc com_arena() -> int {
    let scope = mem.arena_create(1024)
    let g = new(int, alloc = scope)
    g^ = 8
    let resultado = g^
    mem.arena_destroy(scope)
    return resultado
}

proc main() {
    let alloc = 1
    let to = 2
    let file = 4
    print(somar(alloc = alloc, to = to, scope = 3, file = file))
    print(multiplicar(em = 5, para = 6))
    print(com_arena())
}
