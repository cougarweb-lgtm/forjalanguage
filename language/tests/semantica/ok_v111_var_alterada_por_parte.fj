// v1.11 L10a: var alterada por parte (c.x = , a[i] = , x += ) e var de verdade: sem E0707.
struct Ponto {
    x: i32 = 0
    y: i32 = 0
}

proc main() {
    var c = Ponto{}
    c.x = 1
    var a: [3]i32 = {1, 2, 3}
    a[1] = 9
    var n: i32 = 0
    n += 2
    print(c.x + c.y + a[0] + a[1] + n)
}
