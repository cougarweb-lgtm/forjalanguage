import "std:text"

enum Erro {
    falhou
}

proc f(p: []str, alloc: Allocator) -> str ! Erro {
    return text.join(p, ",", alloc = alloc)
}

proc g(p: []str) -> int ! Erro {
    let s = try f(p, alloc = heap)
    defer delete(s)
    return len(s)
}

proc h(p: []str, alloc: Allocator) -> str ! Erro {
    let s = try f(p, alloc = alloc)
    return s
}

proc main() {
}
