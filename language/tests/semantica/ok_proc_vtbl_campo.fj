// proc como campo de struct e chamada obj.campo(...): o padrao do COM (q.lpVtbl.Release(q)).
struct Vtbl {
    soma: proc(self: rawptr, a: i32, b: i32) -> i32
    solta: proc(self: rawptr)
    escala: proc(self: rawptr, f: f32) -> f64
}

struct Objeto {
    vtbl: ^Vtbl
    contagem: i32
}

proc somar(self: rawptr, a: i32, b: i32) -> i32 {
    return a + b
}

proc soltar(self: rawptr) {
}

proc escalar(self: rawptr, f: f32) -> f64 {
    return 1.5
}

proc usar(q: ^Objeto) {
    let eu = q as rawptr
    q.vtbl.solta(eu)
    let r = q.vtbl.soma(eu, a = 1, b = 2)
    let e = q.vtbl.escala(eu, f = 2.0)
    defer q.vtbl.solta(eu)
    print(r)
    print(e as i32)
}

proc main() {
    var tabela = Vtbl{soma = somar, solta = soltar, escala = escalar}
    var o = Objeto{vtbl = &tabela, contagem = 0}
    usar(&o)
}
