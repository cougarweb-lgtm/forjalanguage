struct Particula {
    x: f32 = 0.0
    vx: f32 = 1.0
    vida: i32 = 10
}

proc soma(xs: []f32) -> f32 {
    var total: f32 = 0.0
    for x in xs {
        total += x
    }
    return total
}

proc main() {
    var a: soa[8]Particula = {}
    a[2] = Particula{x = 3.0, vida = 7}
    a[2].x += a[2].vx
    let p = a[2]
    let q = &a[2].vida
    q^ = q^ + 1
    var b = make(soa[dynamic]Particula, alloc = heap)
    defer delete(b)
    append(&b, item = p)
    for i, item in a {
        if i == 2 {
            print(item.vida)
        }
    }
    print(len(b))
    let s = soma(a.x)
    print(f"{s}")
}
