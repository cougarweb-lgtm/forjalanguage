// L8: struct com campo de tipo inexistente fica envenenada: os usos dela (parametro, literal, campo, let tipado; 3 deles em 2 procs) nao geram linha. So o campo sai.
struct Gama {
    x: i32
    y: Fantasma
}

proc soma(g: Gama) -> i32 {
    let h = Gama{x = 1}
    return g.x + h.x
}

proc mostra() {
    let k: Gama = Gama{x = 2}
    print(k.x)
}

proc main() {
    mostra()
}
