// 0.45.0: transmute aceita so rawptr <-> inteiro de 64 bits (u64/i64/int/uint): handle de C guardado como numero e devolvido.
struct V {
    x: int
}

proc main() {
    var v = V{x = 99}
    let r = &v as rawptr
    let n = transmute(r, to = u64)
    let r2 = transmute(n, to = rawptr)
    let p = r2 as ^V
    p.x += 1
    print(v.x)
    print(transmute(r2, to = int) == (n as int))
    print(transmute(r2, to = i64) == (n as i64))
}
