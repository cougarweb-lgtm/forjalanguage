foreign {
    link "msvcrt"
    proc c_calloc = "calloc"(n: u64, tamanho: u64) -> ?^i32
    proc c_free = "free"(p: rawptr)
}

proc main() {
    let p = c_calloc(4, tamanho = 4)
    let n: i32 = 4
    let v = slice_from(p, len = n)
    let w = slice_from(p, len = 2)
    let sem_sinal: u32 = 3
    let z = slice_from(p, len = sem_sinal)
    var soma: int = 0
    for x in v[..] {
        soma = soma + x as int
    }
    print(soma + len(w) + len(z))
    c_free(p as rawptr)
}
