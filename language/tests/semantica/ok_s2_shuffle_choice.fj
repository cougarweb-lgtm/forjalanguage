// S2b (shuffle e choice): colecoes validas (array var, lista var, fatia) com ^rand.Rng por endereco e como parametro de proc. Saida deterministica: true e 7.
import "std:rand" as rand

proc escolhe(s: []int, rng: ^rand.Rng) -> ?int {
    return choice(s, rng = rng)
}

proc main() {
    var r = rand.seed(42)
    var arr: [4]int = {1, 2, 3, 4}
    shuffle(arr, rng = &r)
    var l = make([dynamic]int, alloc = heap)
    defer delete(l)
    append(&l, item = 7)
    shuffle(l, rng = &r)
    let e = choice(l, rng = &r) or_else 0
    let opc = escolhe(arr[..], rng = &r)
    switch v in opc {
    case int: print(v >= 1 and v <= 4)
    case none: print(false)
    }
    print(e)
}
