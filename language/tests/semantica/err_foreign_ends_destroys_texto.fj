// err_foreign_ends_destroys_texto.fj - M6d P93h: 'ends destroys f' = 2 clausulas de posse = E0912 com o texto "no maximo uma clausula de posse por proc foreign" (nao o de 'ends <nome>').
// Esperado: 'forja check' sai 1 com E0912 em linha 5, coluna do 'destroys'.
foreign {
    opaque Arq
    proc fechar_c(f: ?^Arq) ends destroys f
}

proc main() {
    print(1)
}
