// err_handle_saida_viva.fj - M6c P91b: 'creates banco' em um local que ainda guarda um handle aberto = E0317 de reatribuicao (o handle antigo vazaria).
// Esperado: 'forja check' sai 1 com E0317 na linha 12, coluna do 'db' do segundo '&db'.
foreign {
    opaque Db
    proc sqlite3_open(nome: cstr, banco: ^?^Db) -> i32 creates banco
    proc sqlite3_close(b: ?^Db) destroys b
}

proc main() {
    var db: ?^Db = none
    let a = sqlite3_open("x.db", banco = &db)
    let b = sqlite3_open("y.db", banco = &db)
    defer sqlite3_close(db)
    print(a + b)
}
