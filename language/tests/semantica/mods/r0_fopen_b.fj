// R0 [D-REDE-1]: fopen com o opaco ArquivoB (este modulo); o modulo r0_fopen_a da o mesmo simbolo C com o opaco ArquivoA.
foreign {
    link "msvcrt"
    opaque ArquivoB
    proc fopen_b = "fopen"(caminho: cstr, modo: cstr) -> ?^ArquivoB
    proc fclose_b = "fclose"(arquivo: ?^ArquivoB) -> i32
}

pub proc abre_e_fecha_b() -> i32 {
    let aberto = fopen_b("nao_existe_r0_b.bin", modo = "rb")
    switch b in aberto {
    case ^ArquivoB:
        return fclose_b(b)
    case none:
        return -1
    }
    return -1
}
