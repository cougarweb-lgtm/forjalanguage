// Modulo das fixtures IA1-L8 (ok_l8_modulos_homonimos, err_E0301_l8_config_misturado, err_E1003_l8_nome_so_do_modulo): os nomes de topo repetem os de l8_b e os da raiz.
pub const LIMITE: int = 10

pub enum Modo { rapido, lento }

pub struct Config {
    ativo: bool = true
    nivel: int = 1
}

pub proc somar(a: int, b: int) -> int {
    return a + b
}

pub proc modo_padrao() -> Modo {
    return Modo.rapido
}
