import "mods/cores"

pub const LADO: int = 3

pub struct Ponto2 {
    x: int = 0
    y: int = 0
}

struct Interno {
    v: int = 0
}

pub proc area(p: Ponto2) -> int {
    return p.x * p.y
}

proc segredo() -> int {
    return LADO
}

pub proc cor_padrao() -> cores.Cor {
    return cores.Cor.azul
}

pub proc soma(a: int, b: int) -> int {
    return a + b + segredo() - LADO
}

test "area de dois" {
    expect(area(Ponto2{x = 1, y = 2}) == 2)
}
