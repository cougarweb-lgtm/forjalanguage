// R0 [D-REDE-1]: fopen com o opaco ArquivoA (este modulo); o modulo r0_fopen_b da o mesmo simbolo C com o opaco ArquivoB.
foreign {
    link "msvcrt"
    opaque ArquivoA
    proc fopen_a = "fopen"(caminho: cstr, modo: cstr) -> ?^ArquivoA
    proc fclose_a = "fclose"(arquivo: ?^ArquivoA) -> i32
}

pub proc abre_e_fecha_a() -> i32 {
    let aberto = fopen_a("nao_existe_r0_a.bin", modo = "rb")
    switch a in aberto {
    case ^ArquivoA:
        return fclose_a(a)
    case none:
        return -1
    }
    return -1
}
