// Modulo das fixtures IA1-L8 (ok_l8_modulos_homonimos, err_E0301_l8_config_misturado): os nomes de topo repetem os de l8_a e os da raiz, com outro conteudo.
pub const LIMITE: int = 20

pub enum Modo { forte, fraco, medio }

pub struct Config {
    peso: int = 5
}

pub proc somar(a: int, b: int) -> int {
    return a + b + LIMITE
}
