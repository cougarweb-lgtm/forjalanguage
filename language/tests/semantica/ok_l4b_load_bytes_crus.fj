// L4b (#load binario): o arquivo ok_l4b_load_bytes_crus.bin tem 261 bytes (0x00..0xFF e 5C 6E 78 30 22). Os bytes chegam iguais: 0x5C 'n' nao vira quebra de linha.
proc main() {
    let dados = #load("ok_l4b_load_bytes_crus.bin")
    let v = as_bytes(dados)
    var soma: u64 = 0
    var barras: int = 0
    for x in v {
        soma += x as u64
        if x == 92 {
            barras += 1
        }
    }
    print(len(dados))
    print(soma)
    print(barras)
    print(v[256])
    print(v[257])
}
