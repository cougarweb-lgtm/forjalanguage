// L8: 2 erros independentes (assinatura de ruim e corpo de dois) e 1 cascata calada: a expressao com a chamada de ruim em um laco e numa conta nao gera linha.
proc ruim(n: Fantasma) -> i32 {
    return 1
}

proc um() -> i32 {
    let a = ruim(1) + 2 * ruim(2)
    if ruim(3) > a {
        return a
    }
    return ruim(4) - 1
}

proc dois() {
    print(nome_solto)
}

proc main() {
    print(um())
    dois()
}
