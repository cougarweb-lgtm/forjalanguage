proc escala(m: matrix[2, 2]f32, k: f32) -> matrix[2, 2]f32 {
    return m * k
}

proc main() {
    var a: matrix[2, 2]f32 = {1.0, 2.0, 3.0, 4.0}
    let b: matrix[2, 3]f32 = {1.0, 0.0, 2.0, 0.0, 1.0, 3.0}
    let c = a * b
    let v: [3]f32 = {1.0, 1.0, 1.0}
    let w = c * v
    let t = transpose(b)
    a[0, 1] = 5.0
    let p = &a[1, 0]
    p^ = 2.0 * p^
    let n = -escala(a, k = 2.0) + a
    let x = w[1] + t[2, 0] + n[1, 1] + c[0, 2]
    print(f"{x}")
}
