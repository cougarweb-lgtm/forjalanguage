struct Caixa {
    c: i32 = 0
}

proc mesmo(p: ^i32) -> ^i32 {
    return p
}

proc campo(p: ^Caixa) -> ^i32 {
    return &p.c
}

proc resto(s: []int) -> []int {
    return s[1..<len(s)]
}

proc main() {
    var a: i32 = 1
    var caixa = Caixa{}
    var v: [3]int = {1, 2, 3}
    _ = mesmo(&a)
    _ = campo(&caixa)
    _ = resto(v[..])
}
