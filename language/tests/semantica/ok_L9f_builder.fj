// L9f: o builder de texto em todos os usos validos: append de str e de byte, format(into =), builder recebido como ^[dynamic]u8, to_str guardado e devolvido por proc.
proc escreve(buf: ^[dynamic]u8, n: int) {
    format(f"<{n}>", into = buf)
    append(buf, item = "!")
}

proc monta() -> str {
    var buf = make([dynamic]u8, alloc = heap)
    defer delete(buf)
    append(&buf, item = "a")
    append(&buf, item = 98)
    escreve(&buf, 3)
    return to_str(&buf)
}

proc main() {
    let s = monta()
    print(s)
    delete(s)
}
