// L10e: std:fmt - uso correto: Rounding, Locale constante (campos lidos de fora), number/integer/percent (texto dono com delete), write_* no builder, find_locale (?Locale), locale posicional ou nomeado.
import "std:fmt" as fmt

proc main() {
    let regiao: fmt.Locale = fmt.PT_BR
    let separador: str = regiao.decimal_sep
    let modo: fmt.Rounding = fmt.Rounding.half_even
    let a: str = fmt.number(1234.5, loc = regiao, alloc = heap)
    defer delete(a)
    let b: str = fmt.number(2.5, fmt.EN_US, decimals = 0, rounding = modo, alloc = heap)
    defer delete(b)
    let c: str = fmt.integer(1234567, loc = fmt.DE_DE, alloc = heap)
    defer delete(c)
    let d: str = fmt.percent(0.125, loc = fmt.FR_FR, decimals = 1, rounding = fmt.Rounding.down, alloc = heap)
    defer delete(d)
    var buf = make([dynamic]u8, alloc = heap, cap = 32)
    defer delete(buf)
    fmt.write_number(1.5, buf = &buf, loc = fmt.ISO)
    fmt.write_integer(7, buf = &buf, loc = fmt.ES_ES)
    fmt.write_percent(0.5, buf = &buf, loc = fmt.IT_IT, decimals = 2, rounding = fmt.Rounding.up)
    let achada = fmt.find_locale("pt-PT") or_else fmt.ISO
    let todas: [9]fmt.Locale = fmt.LOCALES
    print(f"{separador} {a} {b} {c} {d} {achada.tag} {todas[8].tag} {fmt.EN_GB.months_long[10]} {len(buf)}")
}
