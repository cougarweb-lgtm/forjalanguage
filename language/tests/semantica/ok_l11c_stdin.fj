// L11c (S3 P5b-2): entrada padrao do std:os - read_line e read_all_stdin com InputError. Fixture de semantica: a saida real e a de tests\nativo\s3\stdin\verificar_stdin.py; o esperado vale com stdin vazio (forja run < NUL).
import "std:os" as os

proc main() {
    switch linha in os.read_line(alloc = heap) {
    case str:
        print(f"linha {linha}")
        delete(linha)
    case os.InputError:
        print("fim")
    }
    switch dados in os.read_all_stdin(alloc = heap) {
    case [dynamic]u8:
        print(len(dados))
        delete(dados)
    case os.InputError:
        print("erro")
    }
}
