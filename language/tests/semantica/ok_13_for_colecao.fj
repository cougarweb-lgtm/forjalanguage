struct Bala {
    vida: i32 = 3
}

proc gerar() -> [3]int {
    return {7, 8, 9}
}

proc soma_ptr(p: ^[3]int) -> int {
    var total = 0
    for x in p {
        total += x
    }
    for &x in p {
        x^ = x^ + 1
    }
    return total
}

proc soma_fatia(s: []int) -> int {
    var total = 0
    for i, &x in s {
        x^ = x^ + i
    }
    for i, x in s {
        total += x + i
    }
    return total
}

proc main() {
    var a: [3]int = {1, 2, 3}
    let w: [3]int = {5, 20, 7}
    let s = a[..]
    var soma = 0
    for x in a {
        soma += x
    }
    for x in w {
        soma += x
    }
    for &x in a {
        x^ = x^ * 10
    }
    for i, x in a {
        if i == 1 {
            continue
        }
        if i == 2 {
            break
        }
        soma += x
    }
    for &x in s {
        x^ += 1
    }
    for i, &x in s {
        x^ = i
    }
    for x in gerar() {
        print(x)
    }
    for x in w {
        defer print(x)
        if x > 10 {
            break
        }
    }
    var m: [2][2]int = {{1, 2}, {3, 4}}
    for linha in m {
        for v in linha {
            soma += v
        }
    }
    for &linha in m {
        for &v in linha {
            v^ = 0
        }
    }
    var balas: [2]Bala = {Bala{}, Bala{vida = 1}}
    for &b in balas {
        b.vida -= 1
    }
    for i, b in balas {
        let k: int = i
        print(b.vida + 1)
        print(k)
    }
    print(soma_ptr(&a) + soma_fatia(s))
    for i in 0..<3 {
        print(i)
    }
}
