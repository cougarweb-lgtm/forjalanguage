// ok_handle_takes.fj - M6c P87: 'takes item' entrega o handle ao objeto da lib (cJSON_AddItemToObject-like); obj so empresta e o defer fecha. Sem erro.
// Esperado: 'forja check' sai 0 sem saida. Hoje: falha (a clausula ainda nao existe).
foreign {
    opaque Json
    proc cJSON_CreateObject() -> ?^Json creates
    proc cJSON_AddItemToObject(obj: ?^Json, nome: cstr, item: ?^Json) -> i32 takes item
    proc cJSON_Delete(obj: ?^Json) destroys obj
}

proc main() {
    let obj = cJSON_CreateObject()
    let item = cJSON_CreateObject()
    _ = cJSON_AddItemToObject(obj, "k", item)
    defer cJSON_Delete(obj)
    print(1)
}
