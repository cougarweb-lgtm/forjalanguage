// v1.11 L1 (K2/A15): literal inteiro vira real sozinho no contexto real quando exato.
unit Metros: f32

struct Ponto {
    x: f32
    y: f32
}

proc dobro(v: f32) -> f32 {
    return v * 2
}

proc um() -> f64 {
    return 1
}

proc main() {
    let a: f32 = 1
    var b: f64 = 2
    b = b + 3
    let c: [3]f32 = {1, 2, 3}
    let p = Ponto{x = 1, y = -2}
    let d: Metros = 1
    let g: f32 = 16777216
    let h: f64 = 9007199254740992
    let soma = a * 2 + 1 - 0.5
    if a > 0 and b != 3 {
        print(f"{dobro(4)} {um()} {c[2]} {p.y} {d} {g} {h} {soma}")
    }
}
