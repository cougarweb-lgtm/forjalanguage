// K08a (sort_by): o comparador tem um parametro so; a assinatura pedida e proc (^Item, ^Item) -> bool. E0907.
struct Item {
    chave: int
    seq: int
}

proc so_um(a: ^Item) -> bool {
    return a.chave > 0
}

proc main() {
    var l = make([dynamic]Item, alloc = heap)
    append(&l, item = Item{chave = 1, seq = 1})
    sort_by(l[..], less = so_um)
    delete(l)
}
