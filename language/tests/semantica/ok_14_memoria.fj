struct Bando {
    nomes: [dynamic]int
    vida: i32 = 1
}

proc criar(n: int) -> [dynamic]int {
    var l = make([dynamic]int, alloc = heap, cap = n)
    append(&l, item = n)
    return l
}

proc somar(s: []int) -> int {
    var total = 0
    for x in s {
        total += x
    }
    return total
}

proc crescer(p: ^[dynamic]int) {
    append(p, item = 9)
    p[0] = len(p)
    let q = &p[0]
    q^ = q^ + 1
    let parte = p[0..<1]
    print(parte[0] + somar(p[..]))
    for x in p {
        print(x)
    }
    for &x in p {
        x^ = x^ + 1
    }
    for i, x in p {
        print(i + x)
    }
    for i, &x in p {
        x^ = i
    }
}

proc soltar(p: ^[dynamic]int) {
    delete(p^)
}

proc main() {
    var l = make([dynamic]int, alloc = heap)
    append(&l, item = 1)
    l[0] = 5
    print(l[0] + len(l))
    for x in l {
        print(x)
    }
    for &x in l {
        x^ = x^ + 1
    }
    for i, x in l {
        print(i + x)
    }
    for i, &x in l {
        x^ = i
    }
    let fatia = l[..]
    print(somar(fatia) + somar(l[0..=0]))
    crescer(&l)

    var grade = make([dynamic][dynamic]int, alloc = heap)
    append(&grade, item = criar(2))
    for &linha in grade {
        append(linha, item = 3)
        print(len(linha))
    }

    var bando = Bando{}
    append(&bando.nomes, item = 1)
    let outro = Bando{nomes = make([dynamic]int, alloc = heap, cap = 2)}
    print(len(bando.nomes) + len(outro.nomes) + bando.vida as int)

    let pb = new(Bando, alloc = heap)
    let pa = new([4]int, alloc = heap)
    let pn = new(?^Bando, alloc = heap)
    let pi = new(int, alloc = frame)
    let frame = 3
    let pf = new(int, alloc = frame)
    pi^ = frame
    pf^ = pi^
    let q: ?^Bando = new(Bando, alloc = heap)
    delete(pb)
    delete(pa)
    delete(pn)
    delete(q)
    delete(pi)
    frame_reset()

    soltar(&l)
    l = make([dynamic]int, alloc = heap)
    delete(l)
    delete(grade)
}
