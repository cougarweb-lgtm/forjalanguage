// K09 (count_by): pred com dois parametros. A assinatura do pred e proc (^T) -> bool. E0907.
struct Item {
    chave: int
}

proc dois(a: ^Item, b: ^Item) -> bool {
    return a.chave == b.chave
}

proc main() {
    var l = make([dynamic]Item, alloc = heap)
    print(count_by(l[..], pred = dois))
    delete(l)
}
