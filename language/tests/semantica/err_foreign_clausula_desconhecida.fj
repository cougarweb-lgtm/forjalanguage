// err_foreign_clausula_desconhecida.fj - M6c P85: palavra depois da assinatura que nao e creates/destroys/takes = E0912 na palavra 'gets'.
// Esperado: 'forja check' e 'forja ast' saem 1 com E0912 em linha 5, coluna do 'gets'. Hoje: E0101 (a palavra nao e reconhecida).
foreign {
    opaque Arq
    proc fclose_c(f: ?^Arq) -> i32 gets f
}

proc main() {
    print(1)
}
