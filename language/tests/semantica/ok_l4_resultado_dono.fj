enum Erro {
    falhou
}

proc criar(n: int) -> [dynamic]int ! Erro {
    if n < 0 {
        return Erro.falhou
    }
    var l = make([dynamic]int, alloc = heap)
    append(&l, item = n)
    return l
}

proc repassar(n: int) -> [dynamic]int ! Erro {
    var l = try criar(n)
    append(&l, item = n + 1)
    return l
}

proc main() {
    switch l in repassar(3) {
    case [dynamic]int:
        print(len(l))
        delete(l)
    case Erro:
        print("erro")
    }
}
