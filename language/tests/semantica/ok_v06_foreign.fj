// V-06 = B em proc foreign: posicional, nomeado e misto chamam a mesma funcao C.
foreign {
    link "msvcrt"
    proc c_calloc = "calloc"(n: u64, tamanho: u64) -> ?^i32
    proc c_free = "free"(p: rawptr)
}

proc somar(valores: []i32) -> int {
    var soma: int = 0
    for x in valores {
        soma = soma + x as int
    }
    return soma
}

proc main() {
    let n: i32 = 4
    let p = c_calloc(4, 4)
    var v = slice_from(p, n)
    for i in 0..<len(v) {
        v[i] = (i + 1) as i32
    }
    print(somar(v[..]))
    let q = c_calloc(n = 2, tamanho = 4)
    var w = slice_from(q, len = 2)
    w[0] = 5
    w[1] = 6
    print(somar(w[..]))
    c_free(p as rawptr)
    c_free(q as rawptr)
}
