// err_handle_return_vivo.fj - M6c P87: 'return' com handle vivo (ainda sem defer) = E0317 na saida; o defer depois do if cobre o caminho feliz.
// Esperado: 'forja check' sai 1 com E0317 na linha 12, coluna do 'return 1'. forma_certa: "defer fclose_c(f) logo depois do let". Hoje: falha de outro codigo.
foreign {
    opaque Arq
    proc fopen_c(caminho: cstr, modo: cstr) -> ?^Arq creates
    proc fclose_c(f: ?^Arq) -> i32 destroys f
}

proc abre_e_volta(debug: bool) -> i32 {
    let f = fopen_c("a.txt", "r")
    if debug {
        return 1
    }
    defer fclose_c(f)
    return 0
}

proc main() {
    print(abre_e_volta(false))
}
