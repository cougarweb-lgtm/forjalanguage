// L10h: DateStyle tem short, long e full; um estilo que nao existe (tiny) e erro.
import "std:fmt" as fmt
import "std:time" as tm

proc main() {
    let dt = tm.DateTime{year = 2000, month = 2, day = 29}
    let texto = fmt.format_date(dt, loc = fmt.PT_BR, style = fmt.DateStyle.tiny, alloc = heap)
    delete(texto)
}
