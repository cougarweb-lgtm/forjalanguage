// err_handle_saida_sem_local.fj - M6c P87: 'creates p' com &g.arq (campo, nao local) = E0912 "o handle criado vai para um local: &h" no argumento.
// Esperado: 'forja check' sai 1 com E0912 na linha 15, coluna do '&g.arq'. Hoje: falha de outro codigo (clausula nao existe).
foreign {
    opaque Arq
    proc fopen_em(caminho: cstr, saida: ^?^Arq) -> i32 creates saida
    proc fclose_c(f: ?^Arq) -> i32 destroys f
}

pub struct Guarda {
    arq: ?^Arq
}

proc main() {
    var g = Guarda{arq = none}
    _ = fopen_em("a.txt", saida = &g.arq)
    print(1)
}
