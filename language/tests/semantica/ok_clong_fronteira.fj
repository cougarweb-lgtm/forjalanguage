// ok_clong_fronteira.fj - M6c P83: c_long/c_ulong nas posicoes de fronteira (as, argumento de foreign, &x para ^c_ulong, let declarado, campo de struct). Sem erro nos 2 alvos.
// Esperado: 'forja check' sai 0 sem saida, com --target windows e com --target x86_64-linux; 'forja build' liga nos 2 alvos (labs e strtoul sao da libc padrao).
// Nao e para rodar: o strtoul grava o ponteiro de fim em 'fim' (8 bytes) e aqui 'fim' e declarado ?^c_ulong so para provar o '&u' na fronteira.
// Versao: 0.2.0 | Changelog: 0.2.0 - P83 (Q9): get_ul (sem corpo em lib nenhuma) trocado por strtoul da libc, como as fixtures do P82; 0.1.0 - P81: primeira versao.
foreign {
    proc labs(n: c_long) -> c_long
    proc strtoul(s: cstr, fim: ?^c_ulong, base: i32) -> c_ulong
}

pub struct Espelho {
    tempo: c_long
}

proc main() {
    let n = -7 as c_long
    print(labs(n) as int)
    var u: c_ulong = 0
    let r = strtoul("12", &u, 10)
    print(r as u64)
    let e = Espelho{tempo = 5 as c_long}
    print(e.tempo as int)
}
