const N: int = 4
const M: int = 2

struct Grifo {
    vida: i32
    notas: [N]f32
    bytes: [M][N]u8
    amigos: []Grifo
    ponteiros: []^Grifo
    proximo: ?^[2]int
}

struct Cesto {
    itens: [TAMANHO]int
}

const TAMANHO: int = 3

proc passar(a: [3]int, b: []u8, c: ^[4]int, d: [2][3]int, e: [N]f32) -> [3]int {
    return a
}

proc devolver(b: []u8) -> []u8 {
    return b
}

proc nao_chamado(g: Grifo, p: ^[N]int) -> ^[N]int {
    return p
}

proc main() {
