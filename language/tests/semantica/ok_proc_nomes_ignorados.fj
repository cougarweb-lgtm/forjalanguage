// A compatibilidade entre tipos proc ignora os nomes dos parametros; os argumentos nomeados usam os nomes do TIPO da variavel.
proc soma(x: i32, y: i32) -> i32 {
    return x + y
}

proc main() {
    let a: proc(p: i32, q: i32) -> i32 = soma
    let b: proc(m: i32, n: i32) -> i32 = a
    print(a(1, q = 2))
    print(b(1, n = 2))
}
