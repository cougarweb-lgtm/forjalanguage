proc dobro(x: u16) -> u16 {
    return x * 2
}

proc main() {
    let a: i8 = -5
    let b: u8 = 200
    let c: u32 = 4000000000
    let d: uint = 9
    let e: f64 = 1.5
    let m: u32 = 1 << 31
    let n: u32 = (c & m) | 1
    print(dobro(300))
    print((b as i16) + (a as i16))
    print(n)
    print(d)
    print(transmute(e, to = uint))
    print((e * 2.0) as int)
}
