// ok_handle_entrega_campo.fj - M6c P87: handle entregue a um campo de struct na saida (return Struct{campo = h}) = entrega, sem E0317. Sem erro.
// Esperado: 'forja check' sai 0 sem saida. Hoje: falha (a clausula ainda nao existe).
foreign {
    opaque Arq
    proc fopen_c(caminho: cstr, modo: cstr) -> ?^Arq creates
}

pub struct Abertura {
    arq: ?^Arq
}

proc abrir_campo() -> Abertura {
    let f = fopen_c("a.txt", "r")
    return Abertura{arq = f}
}

proc main() {
    let _a = abrir_campo()
    print(1)
}
