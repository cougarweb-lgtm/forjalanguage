// v1.11 L13 (A13): min, max, clamp e abs embutidos. min/max/clamp pedem valores do MESMO tipo numerico (inteiro, real, unidade, [N]T por elemento);
// um literal sozinho adota o tipo do outro argumento. abs: inteiro com sinal ou real (a unidade fica).
unit Metros: f32

const LIMITE: i32 = 100

proc main() {
    let a: i32 = 7
    let b: i32 = -3
    let menor = min(a, b = b)
    let maior = max(a, b = 3)
    let preso = clamp(a, lo = 0, hi = LIMITE)
    let modulo = abs(b)
    let pequeno: i8 = -100
    let pm = abs(pequeno)
    let sem_sinal: u8 = 200
    let su = min(sem_sinal, b = 100)
    let f: f32 = 2.5
    let g = max(f, b = 1)
    let h = abs(f)
    let longo: f64 = -1.5
    let hl = abs(longo)
    let d: Metros = 3.0
    let md = min(d, b = 4.0)
    let ad = abs(d)
    let v: [3]f32 = {1.0, 2.0, 3.0}
    let w: [3]f32 = {2.0, 2.0, 2.0}
    let pe = min(v, b = w)
    let te = max(v, b = w)
    let pr = clamp(v, lo = w, hi = w)
    let tudo = clamp(1, lo = 0, hi = 5)
    print(f"{menor} {maior} {preso} {modulo} {pm} {su} {g} {h} {hl} {md} {ad} {pe[0]} {te[0]} {pr[0]} {tudo}")
}
