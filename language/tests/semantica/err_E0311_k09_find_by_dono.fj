// K09 (find_by): o elemento e dono de memoria (lista dentro da struct). find_by copiaria o dono: E0311.
struct Caixa {
    itens: [dynamic]int
}

proc tem_item(c: ^Caixa) -> bool {
    return len(c.itens) > 0
}

proc main() {
    var l = make([dynamic]Caixa, alloc = heap)
    let achado = find_by(l[..], pred = tem_item)
    delete(l)
}
