// IA1-L9a/L9b: as formas validas dos embutidos de aritmetica com volta e de bits (a semantica aceita; a execucao esta em tests\lowering\217..220).
import "std:os" as os

proc main() {
    let a: u8 = 250
    let b: u8 = 10
    let c: i64 = 9
    let d: u64 = 1
    print(wrapping_add(a, b = b))
    print(wrapping_sub(a, 7))
    print(saturating_mul(c, b = 3))
    let v, estourou = overflowing_add(a, b = b)
    print(v)
    print(estourou)
    let talvez = checked_sub(a, b = b)
    print(talvez or_else 0)
    print(talvez == none)
    print(rotate_left(a, n = 3))
    print(rotate_right(d, n = c))
    print(count_ones(a) + leading_zeros(c) + trailing_zeros(d))
    print(byte_swap(a))
    print(mul_hi_u64(d, b = d))
    print(os.TARGET)
    print(os.ARCH)
}
