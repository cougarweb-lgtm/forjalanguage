// L9e: os embutidos novos aceitos pela semantica (nomeados e posicionais; lista, array e fatia; map e ^map).
proc total(m: ^map[str]int) -> int {
    var v = values(m, alloc = heap)
    defer delete(v)
    return sum(v)
}

proc main() {
    var l = make([dynamic]int, alloc = heap, cap = 2)
    defer delete(l)
    append(&l, item = 4)
    let a: [2]f32 = {1.5, 2.5}
    print(min_of(l) or_else 0)
    print(max_of(a) or_else 0.0)
    print(sum(l[..]))
    print(avg(a))
    var m = make(map[int]str, alloc = heap)
    defer delete(m)
    insert(&m, key = 1, value = "x")
    var k = keys(m, alloc = heap)
    defer delete(k)
    var v = values(m, alloc = heap)
    defer delete(v)
    clear(&m)
    var p = make(map[str]int, alloc = heap)
    defer delete(p)
    print(total(&p))
    let s = "abc"
    let c = clone(s, alloc = heap)
    delete(c)
    let b = as_bytes(s)
    let d = from_bytes(b, alloc = heap)
    delete(d)
    var raw = make([dynamic]u8, alloc = heap, cap = 1)
    defer delete(raw)
    let e = from_bytes(raw, alloc = heap)
    delete(e)
}
