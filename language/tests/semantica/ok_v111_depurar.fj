// v1.11 L11 (C13): {x:?} vale para escalar, unidade, enum, struct (recursivo) e [N]T desses.
unit Metros: f32

enum Cor {
    vermelho
    verde
}

struct Ponto {
    x: i32
    y: i32
}

struct Ator {
    nome: str
    pos: Ponto
    cor: Cor
    vivo: bool
    alcance: Metros
    rastro: [3]Ponto
}

proc main() {
    let ator = Ator{
        nome = "Bico",
        pos = Ponto{x = 1, y = 2},
        cor = Cor.verde,
        vivo = true,
        alcance = 2.5,
        rastro = {Ponto{x = 0, y = 0}, Ponto{x = 1, y = 1}, Ponto{x = 2, y = 2}},
    }
    let n = 7
    let c: cstr = "ponte"
    print(f"{ator:?} {ator.pos:?} {ator.rastro:?} {ator.cor:?} {ator.alcance:?} {n:?} {c:?} {ator.nome:?} {true:?}")
}
