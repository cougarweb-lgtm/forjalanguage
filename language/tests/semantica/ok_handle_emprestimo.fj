// ok_handle_emprestimo.fj - M6c P87: handle passado a proc sem clausula (foreign e Forja) = emprestimo, nao entrega; o defer ainda fecha. Sem erro.
// Esperado: 'forja check' sai 0 sem saida. Hoje: falha (a clausula ainda nao existe).
foreign {
    opaque Arq
    proc fopen_c(caminho: cstr, modo: cstr) -> ?^Arq creates
    proc fclose_c(f: ?^Arq) destroys f
    proc fread_c(f: ?^Arq, n: i32) -> i32
}

proc ler_um(f: ?^Arq) -> i32 {
    return 0
}

proc main() {
    let f = fopen_c("a.txt", "r")
    _ = fread_c(f, 1)
    _ = ler_um(f)
    defer fclose_c(f)
    print(1)
}
