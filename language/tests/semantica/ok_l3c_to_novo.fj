// L3c: transmute(x, to = T) (forma nova de para = T), nomeado e posicional; a saida e a de ok_l3c_to_antigo.fj.
proc main() {
    let f: f32 = 1.5
    let bits: u32 = transmute(f, to = u32)
    print(bits as int)
    let volta = transmute(bits, to = f32)
    print(volta as int)
    let pos: u32 = transmute(f, u32)
    print(pos as int)
}
