// err_clong_export.fj - M6c P83: c_long em 'pub export proc' = E0342 (o simbolo C sairia com tipo que depende do alvo).
// Esperado: 'forja check' sai 1 com E0342 na linha 3, coluna do 'c_long' do parametro. Hoje: falha de outro codigo.
pub export proc dobro(n: c_long) -> int {
    return (n as int) * 2
}

proc main() {
    print(1)
}
