proc rotulo(n: int) -> str {
    return format(f"item-{n:03}", alloc = heap)
}

proc main() {
    let a = rotulo(7)
    print(a)
    print(len(a))
    delete(a)
    let b = format(f"{2.5:.1}x", alloc = frame)
    print(b)
    let k: u8 = 200
    let c = format_c(f"id={k:x}", alloc = heap)
    print(c)
    delete(c)
    var nomes = make([dynamic]str, alloc = heap)
    for i in 0..<3 {
        append(&nomes, item = format(f"n{i}", alloc = frame))
    }
    for s in nomes {
        print(s)
    }
    print(len(nomes[2]))
    delete(nomes)
    frame_reset()
}
