// L10d2: std:path - uso correto de todo o modulo (predicados, fatias sem dono, texto dono com delete, tupla do split).
import "std:path" as path

proc main() {
    let p = "dir/sub/arquivo.tar.gz"
    let absoluto: bool = path.is_abs(p)
    let nome: str = path.base(p)
    let pasta: str = path.dir(p)
    let extensao: str = path.ext(p)
    let miolo: str = path.stem(p)
    let antes, depois = path.split(p)
    let separador: u8 = path.sep()
    let limpo = path.clean("a//b/../c", alloc = heap)
    defer delete(limpo)
    var partes: [2]str = {"a", "b"}
    let junto = path.join(partes[..], alloc = heap)
    defer delete(junto)
    let junto2 = path.join2("a", b = "b", alloc = heap)
    defer delete(junto2)
    let relativo = path.rel("a/b", target = "a/c", alloc = heap)
    defer delete(relativo)
    let trocado = path.with_ext(p, ext = ".zip", alloc = heap)
    defer delete(trocado)
    let tem: bool = path.has_ext(p, ext = ".gz")
    print(f"{absoluto} {nome} {pasta} {extensao} {miolo} {antes} {depois} {separador} {tem}")
    print(f"{limpo} {junto} {junto2} {relativo} {trocado}")
}
