// err_clong_proc_forja.fj - M6c P83: parametro c_long em proc Forja = E0342 (c_long so cruza a fronteira do foreign).
// Esperado: 'forja check' sai 1 com E0342 na linha 3, coluna do 'c_long' do parametro. Hoje: falha de outro codigo.
proc dobro(n: c_long) -> int {
    return (n as int) * 2
}

proc main() {
    print(1)
}
