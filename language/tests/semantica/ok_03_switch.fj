enum Cor { vermelho, verde }

enum Erro { falhou }

proc achar(n: i32) -> int ! Erro {
    if n == 0 {
        return Erro.falhou
    }
    return 5
}

proc codigo_da(c: Cor) -> i32 {
    switch c {
    case Cor.vermelho:
        return 1
    case Cor.verde:
        return 2
    }
    return 0
}

proc main() {
    print(codigo_da(Cor.verde))
    switch r in achar(1) {
    case int:
        print(r)
    case Erro:
        print(0)
    }
    switch achar(0) {
    case Erro:
        print(1)
    default:
        print(2)
    }
    switch c in Cor.verde {
    default:
        print(3)
    }
}
