// L3c: import "std:file" e o qualificador file. (formas novas de std:arquivo e arquivo.); roda no cwd, o arquivo nao existe; a saida e a de ok_l3c_file_antigo.fj.
import "std:file"

proc descrever(erro: ?file.FileError) -> str {
    var texto: str = "ok"
    switch e in erro {
    case file.FileError:
        switch e {
        case file.FileError.not_found:
            texto = "not_found"
        case file.FileError.no_permission:
            texto = "no_permission"
        case file.FileError.other:
            texto = "other"
        case file.FileError.already_exists:
            texto = "already_exists"
        case file.FileError.is_directory:
            texto = "is_directory"
        case file.FileError.not_directory:
            texto = "not_directory"
        case file.FileError.not_empty:
            texto = "not_empty"
        case file.FileError.closed:
            texto = "closed"
        case file.FileError.unsupported:
            texto = "unsupported"
        case file.FileError.locked:
            texto = "locked"
        }
    case none:
        texto = "ok"
    }
    return texto
}

proc main() {
    switch dados in file.read_all("l3c_nao_existe.bin", alloc = heap) {
    case [dynamic]u8:
        print("ok")
        print(len(dados))
        delete(dados)
    case file.FileError:
        print(descrever(dados))
        print(0)
    }
}
