// L9c/L9d: os embutidos de lista com argumento posicional e nomeado (old, new, n, alloc, value, i, item, cap, len).
proc main() {
    var l = make([dynamic]int, alloc = heap, cap = 2)
    defer delete(l)
    reserve(&l, cap = 8)
    append(&l, item = 3)
    append(&l, item = 4)
    insert_at(&l, i = 0, item = 9)
    replace_value(l, old = 9, new = 8, n = 1)
    print(index_of(l, value = 8) or_else -1)
    print(last_index_of(l, 4) or_else -1)
    print(contains(l, value = 3))
    print(count(l, value = 4))
    swap(l, i = 0, j = 2)
    reverse(l)
    var c = clone(l, alloc = heap)
    defer delete(c)
    print(copy(dst = c, src = l[0..<2]))
    fill(c, value = 1)
    truncate(&l, len = 2)
    print(len(l))
    print(remove_value(&l, value = 4))
    ordered_remove(&l, i = 0)
    unordered_remove(&l, 0)
    print(pop(&l) or_else -1)
    clear(&l)
    print(cap(l) >= 8)
}
