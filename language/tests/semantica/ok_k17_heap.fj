// K17 (heap): heap_push e heap_pop de int (min-heap) e heap_push_by / heap_pop_by com proc de less. Saida: 1 e 9.
struct Item {
    chave: int
    seq: int
}

proc maior_chave(a: ^Item, b: ^Item) -> bool {
    return a.chave > b.chave
}

proc main() {
    var h = make([dynamic]int, alloc = heap)
    defer delete(h)
    heap_push(&h, 4)
    heap_push(&h, 1)
    print(heap_pop(&h) or_else -1)
    var g = make([dynamic]Item, alloc = heap)
    defer delete(g)
    heap_push_by(&g, Item{chave = 2, seq = 1}, less = maior_chave)
    heap_push_by(&g, Item{chave = 9, seq = 2}, less = maior_chave)
    let top = heap_pop_by(&g, less = maior_chave) or_else Item{chave = -1, seq = 0}
    print(top.chave)
}
