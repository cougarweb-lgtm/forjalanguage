// K17 (Assess): heap_pop_by em lista de ponteiros devolve ?^T (como pop e choice), nao ?(^T). Saida: 3.
proc menor_valor(a: ^^i32, b: ^^i32) -> bool {
    return a^^ < b^^
}

proc main() {
    var x: i32 = 3
    var y: i32 = 8
    var l = make([dynamic]^i32, alloc = heap)
    defer delete(l)
    heap_push_by(&l, &y, less = menor_valor)
    heap_push_by(&l, &x, less = menor_valor)
    let topo: ?^i32 = heap_pop_by(&l, less = menor_valor)
    switch p in topo {
    case ^i32:
        print(p^)
    case none:
        print(-1)
    }
}
