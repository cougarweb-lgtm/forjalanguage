// IA1-B01: a str de to_str de builder do alocador do chamador (alloc) nao se libera com delete (a memoria pode ser de Arena): E0310.
proc monta(n: int, alloc: Allocator) -> int {
    var buf = make([dynamic]u8, alloc = alloc, cap = 8)
    append(&buf, item = "x")
    let s = to_str(&buf)
    delete(buf)
    delete(s)
    return n
}

proc main() {
    print(monta(1, alloc = heap))
}
