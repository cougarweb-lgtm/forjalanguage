// err_foreign_ends_com_nome.fj - M6d P92a: `ends p` (com parametro) e E0912 novo: "ends nao leva parametro: o proc encerra a lib inteira".
// Versao: 0.1.0 | Changelog: 0.1.0 - P92a: primeira versao (falha hoje: E0912 ainda nao existe, P92b).
// Esperado: forja check -> E0912 na linha 7 (exit 1).

foreign {
    link "sqlite3"
    proc sqlite3_shutdown(p: i32) -> i32 ends p
}

proc main() {
    print("ok")
}
