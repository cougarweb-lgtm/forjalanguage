struct Grifo {
    vida: i32 = 5
}

struct Ninho {
    dono: ?^Grifo = none
}

proc criar() -> ^Grifo {
    let g = new(Grifo, alloc = heap)
    return g
}

proc guardar(n: ^Ninho) {
    let g = new(Grifo, alloc = heap)
    n.dono = g
}

proc soltar(g: ^Grifo) {
    delete(g)
}

proc main() {
    let a = new(Grifo, alloc = heap)
    defer delete(a)
    var l = make([dynamic]int, alloc = heap)
    append(&l, item = 1)
    let p = &l
    print(len(p))
    let b = criar()
    delete(b)
    var n = Ninho{}
    guardar(&n)
    var s = format(f"x{1}", alloc = heap)
    print(s)
    delete(s)
    s = format(f"y{2}", alloc = heap)
    print(s)
    delete(s)
    let c = new(Grifo, alloc = heap)
    soltar(c)
}
