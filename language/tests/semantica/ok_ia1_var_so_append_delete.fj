// IA1-b04 (achado C.4 do contrato IA1): var de lista cuja unica mudanca e append(&l, ...) ou so delete(l) nao e E0707 (append e delete alteram o dono). Regressao: check exit 0, sem saida.
proc main() {
    var lista = make([dynamic]int, alloc = heap, cap = 4)
    append(&lista, item = 4)
    print(len(lista) as i32)
    delete(lista)
    var vazia = make([dynamic]int, alloc = heap, cap = 2)
    delete(vazia)
}
