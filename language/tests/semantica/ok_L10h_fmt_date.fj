// L10h: std:fmt, datas, horas e duracao por regiao - uso correto: format_* (texto dono: delete) e write_* no builder, padrao livre com o erro tratado (try, or_else, switch), leitura com `at` e estilos.
import "std:fmt" as fmt
import "std:time" as tm

proc ler(texto: str) -> tm.DateTime ! fmt.DateError {
    let dt = try fmt.parse_date(texto, loc = fmt.PT_BR, style = fmt.DateStyle.long)
    return dt
}

proc main() {
    let dt = tm.DateTime{year = 2000, month = 2, day = 29, hour = 13, minute = 5, second = 9}
    let a = fmt.format_date(dt, loc = fmt.PT_BR, alloc = heap)
    defer delete(a)
    let b = fmt.format_time(dt, loc = fmt.EN_US, seconds = true, alloc = heap)
    defer delete(b)
    let c = fmt.format_datetime(dt, loc = fmt.DE_DE, style = fmt.DateStyle.full, seconds = true, alloc = heap)
    defer delete(c)
    let d = fmt.format_pattern(dt, "dd/MM/yyyy", loc = fmt.ISO, alloc = heap) or_else "?"
    var buf = make([dynamic]u8, alloc = heap, cap = 64)
    defer delete(buf)
    fmt.write_date(dt, buf = &buf, loc = fmt.FR_FR, style = fmt.DateStyle.long)
    fmt.write_time(dt, buf = &buf, loc = fmt.ES_ES)
    fmt.write_datetime(dt, buf = &buf, loc = fmt.IT_IT)
    fmt.write_duration(3903250000000, buf = &buf, loc = fmt.PT_BR)
    switch fmt.write_pattern(dt, "yyyy", buf = &buf, loc = fmt.PT_BR) {
    case fmt.DateError:
        print("padrao ruim")
    default:
    }
    var pos = -1
    let lido = fmt.parse_pattern("29/02/2000", "dd/MM/yyyy", loc = fmt.PT_BR, at = &pos) or_else dt
    let hora = fmt.parse_time("1:05 PM", loc = fmt.EN_US) or_else dt
    let quando = ler("29 de fevereiro de 2000") or_else dt
    let duracao = fmt.format_duration(-1500000000, loc = fmt.PT_BR, alloc = heap)
    defer delete(duracao)
    print(f"{a} {b} {c} {d} {len(buf)} {lido.year} {hora.hour} {quando.day} {pos} {duracao}")
}
