// ok_handle_none.fj - M6c P87: 'if f == none' com return dentro do then dispensa o handle (fopen que falhou nao tem o que fechar). Sem erro.
// Esperado: 'forja check' sai 0 sem saida. Hoje: falha (a clausula ainda nao existe).
foreign {
    opaque Arq
    proc fopen_c(caminho: cstr, modo: cstr) -> ?^Arq creates
    proc fclose_c(f: ?^Arq) destroys f
}

proc main() {
    let f = fopen_c("nao_existe.txt", "r")
    if f == none {
        return
    }
    defer fclose_c(f)
    print(1)
}
