// L3c: em = escopo (forma antiga de alloc = scope) vale em silencio; a saida e a de ok_l3c_scope_novo.fj.
struct Grifo {
    vida: i32 = 5
}

proc usar(g: ^Grifo) -> int {
    return g.vida as int
}

proc main() {
    let g = new(Grifo, em = escopo)
    print(usar(g))
    var l = make([dynamic]int, em = escopo, cap = 2)
    append(&l, item = 1)
    let s = format(f"n={len(l)}", em = escopo)
    print(s)
    if len(l) > 0 {
        let t = format_c(f"t{1}", em = escopo)
        print(t)
    }
}
