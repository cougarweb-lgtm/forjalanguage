// K08a (sort_by): colecao errada. Lista sem l[..] nao e fatia: E0310 como no sort.
struct Item {
    chave: int
    seq: int
}

proc por_chave(a: ^Item, b: ^Item) -> bool {
    return a.chave < b.chave
}

proc main() {
    var l = make([dynamic]Item, alloc = heap)
    append(&l, item = Item{chave = 1, seq = 1})
    sort_by(l, less = por_chave)
    delete(l)
}
