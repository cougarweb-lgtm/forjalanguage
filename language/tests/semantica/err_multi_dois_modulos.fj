// L7: um erro no modulo importado e um na raiz saem em duas linhas, o modulo importado primeiro (ordem do driver: dependencias antes da raiz).
import "mods/multi_erro"

proc triplo(n: i32) -> i32 {
    let y: bool = n
    return n * 3
}

proc main() {
    print(multi_erro.dobro(2))
    print(triplo(2))
}
