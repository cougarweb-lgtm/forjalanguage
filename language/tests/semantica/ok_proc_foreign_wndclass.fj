// struct com campo proc passada a foreign (WNDCLASSA, layout real do Win64): o literal traz o proc (V_PROC no IR_STRUCT).
foreign {
    link "user32"
    proc RegisterClassA(c: ^WndClass) -> u16
}

struct WndClass {
    estilo: u32
    procedimento: proc(janela: rawptr, mensagem: u32, wparam: u64, lparam: i64) -> i64
    extra_classe: i32
    extra_janela: i32
    instancia: rawptr
    icone: rawptr
    cursor: rawptr
    fundo: rawptr
    menu: ?cstr
    classe: cstr
}

proc janela_proc(janela: rawptr, mensagem: u32, wparam: u64, lparam: i64) -> i64 {
    return 0
}

proc main() {
    var c = WndClass{procedimento = janela_proc, menu = none, classe = "forja_ok_proc"}
    let atom = RegisterClassA(&c)
    print(atom != 0)
}
