// IA1-B01: a str de to_str de builder em Arena nao se libera com delete (so arena_destroy): E0310.
import "std:mem"

proc main() {
    let a = mem.arena_create(64)
    var buf = make([dynamic]u8, alloc = a, cap = 8)
    append(&buf, item = "x")
    let s = to_str(&buf)
    delete(s)
    mem.arena_destroy(a)
}
