// L10b2: os usos validos de to_upper, to_lower, equal_fold, compare, parse_bool, parse_int_base, parse_uint e parse_uint_base de std:text.
import "std:text" as tx

proc main() {
    let alto = tx.to_upper("abc", alloc = heap)
    defer delete(alto)
    let baixo = tx.to_lower(alto, alloc = heap)
    defer delete(baixo)
    print(f"{alto} {baixo} {tx.equal_fold(alto, baixo)} {tx.compare(alto, baixo)}")
    let verdade = tx.parse_bool("true") or_else false
    let numero = tx.parse_int_base("-0x7f", base = 0) or_else 0
    let sem_sinal = tx.parse_uint("42") or_else 0
    let hexa = tx.parse_uint_base("ff", base = 16) or_else 0
    switch r in tx.parse_int_base("zz", base = 36) {
    case int:
        print(r)
    case tx.ParseError:
        print("erro")
    }
    print(f"{verdade} {numero} {sem_sinal} {hexa}")
}
