// err_handle_esquecido.fj - M6c P87: handle criado e nunca fechado nem entregue = E0317 no 'f' do let; forma_certa "defer fclose_c(f) logo depois do let".
// Esperado: 'forja check' sai 1 com E0317 na linha 10, coluna do 'f'. Hoje: falha de outro codigo.
foreign {
    opaque Arq
    proc fopen_c(caminho: cstr, modo: cstr) -> ?^Arq creates
    proc fclose_c(f: ?^Arq) -> i32 destroys f
}

proc main() {
    let f = fopen_c("a.txt", "r")
    print(1)
}
