// L8: proc com tipo inexistente na assinatura fica envenenado: as 2 chamadas (em 2 procs) valem TIPO_VENENO e nao geram linha, nem o corpo dele. So o parametro sai.
proc dobro(n: Fantasma) -> i32 {
    return n * 2
}

proc um() {
    let a = dobro(3)
    print(a)
}

proc dois() {
    print(dobro(4) + 1)
}

proc main() {
    um()
    dois()
}
