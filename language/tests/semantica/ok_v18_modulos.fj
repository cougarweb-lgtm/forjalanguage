import "mods/geo"
import "mods/cores"

proc main() {
    let p = geo.Ponto2{x = 2, y = geo.LADO}
    print(geo.area(p))
    print(geo.soma(1, b = 2))
    let c: cores.Cor = geo.cor_padrao()
    cores.mostrar(c)
    switch c {
    case cores.Cor.vermelho:
        print(0)
    case cores.Cor.azul:
        print(9)
    }
}
