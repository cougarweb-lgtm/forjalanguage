foreign {
    proc qsort(base: rawptr, n: u64, tamanho: u64, comparar: proc(a: rawptr, b: rawptr) -> i32)
}

proc comparar_i32(a: rawptr, b: rawptr) -> i32 {
    let x = a as ^i32
    let y = b as ^i32
    if x^ < y^ {
        return -1
    }
    if x^ > y^ {
        return 1
    }
    return 0
}

proc main() {
    var v: [3]i32 = {3, 1, 2}
    qsort(&v[0] as rawptr, n = 3, tamanho = 4, comparar = comparar_i32)
    print(v[0])
}
