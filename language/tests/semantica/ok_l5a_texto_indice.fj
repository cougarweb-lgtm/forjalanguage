// L-02 (IA1-L5a): str indexavel por byte (s[i] e u8) e fatiavel (s[lo..<hi] e str emprestado); print de real e eprint.
proc primeiro_byte(s: str) -> u8 {
    return s[0]
}

proc resto(s: str) -> str {
    return s[1..<len(s)]
}

proc main() {
    let s = "ola"
    let b: u8 = primeiro_byte(s)
    let t: str = resto(s)
    let todo: str = s[..]
    let por_inteiro: u8 = s[len(s) - 1]
    print(b)
    print(t)
    print(todo)
    print(por_inteiro)
    print(1.5)
    eprint(f"b = {b}")
}
