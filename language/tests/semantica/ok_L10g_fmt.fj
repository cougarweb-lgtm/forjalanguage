// L10g: std:fmt, conta de dinheiro, compacto e bytes - uso correto: mul_div_round com rounding obrigatorio e o erro tratado (or_else, try, switch), split_even e allocate (listas donas: delete), compact e bytes (forma dona e write_*).
import "std:fmt" as fmt

proc imposto(base: int) -> int ! fmt.MoneyError {
    let valor = try fmt.mul_div_round(base, 1075, 10000, rounding = fmt.Rounding.half_even)
    return valor
}

proc main() {
    let a = fmt.mul_div_round(5, 1, 2, rounding = fmt.Rounding.half_up) or_else 0
    let b = imposto(2500) or_else -1
    switch r in fmt.mul_div_round(9223372036854775807, 2, 1, rounding = fmt.Rounding.down) {
    case int:
        print(f"{r}")
    case fmt.MoneyError:
        print(f"{r == fmt.MoneyError.overflow}")
    }
    var partes = fmt.split_even(100, 3, alloc = heap)
    defer delete(partes)
    var pesos: [3]int = {1, 2, 3}
    var cotas = fmt.allocate(100, pesos[..], alloc = heap)
    defer delete(cotas)
    let c: str = fmt.compact(1234.5, loc = fmt.PT_BR, alloc = heap)
    defer delete(c)
    let d: str = fmt.bytes(1536, fmt.EN_US, binary = false, alloc = heap)
    defer delete(d)
    var buf = make([dynamic]u8, alloc = heap, cap = 32)
    defer delete(buf)
    fmt.write_compact(999950.0, buf = &buf, loc = fmt.DE_DE)
    fmt.write_bytes(-1048575, buf = &buf, loc = fmt.FR_FR)
    print(f"{a} {b} {partes[0]} {cotas[2]} {c} {d} {len(buf)}")
}
