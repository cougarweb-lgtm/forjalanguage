// ok_handle_int_zero.fj - M6d P92a: handle de tipo INTEIRO (u64) com guarda `if h == 0` (P92b: guarda para handle inteiro). Deve passar na semantica.
// Versao: 0.1.0 | Changelog: 0.1.0 - P92a: primeira versao (falha hoje: guarda h == 0 ainda nao existe, P92b).
// Esperado: forja check sem diagnostico, exit 0.

foreign {
    link "teste_a"
    proc lt_cria_inteiro(n: u64) -> u64 creates
    proc lt_fecha_inteiro(h: u64) destroys h
}

proc main() {
    let h = lt_cria_inteiro(8)
    if h == 0 {
        print("falhou")
        return
    }
    lt_fecha_inteiro(h)
    print("ok")
}
