// err_foreign_ends_e_destroys.fj - M6d P92a: clausula `ends` e `destroys` no MESMO proc: a clausula e UNICA por proc (exclusiva).
// Versao: 0.1.0 | Changelog: 0.1.0 - P92a: primeira versao (falha hoje: ends ainda nao existe, P92b). CODIGO DE ERRO A CONFIRMAR no P92b.
// Esperado: forja check com diagnostico de clausula dupla (codigo a confirmar), exit 1.

foreign {
    link "sqlite3"
    proc sqlite3_shutdown(p: rawptr) -> i32 destroys p ends
}

proc main() {
    print("ok")
}
