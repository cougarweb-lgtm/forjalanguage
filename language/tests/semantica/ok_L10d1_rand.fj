// L10d1: std:rand - uso correto de todo o modulo (semente, geradores com endereco, faixas, permutacao dona).
import "std:rand" as rand

proc main() {
    var rng = rand.seed(42)
    var relogio = rand.seed_from_clock()
    let a = rand.next_u64(&rng)
    let b = rand.next_u32(&rng)
    let c = rand.next_float(&rng)
    let _do_relogio = rand.next_bool(&relogio)
    let d = rand.next_bool(&rng)
    let e = rand.below(&rng, n = 10)
    let f = rand.int_range(&rng, min = -3, max = 3)
    let g = rand.float_range(&rng, min = 0.5, max = 1.5)
    var p = rand.perm(&rng, n = 8, alloc = heap)
    defer delete(p)
    print(f"{a} {b} {c} {d} {e} {f} {g} {len(p)}")
}
