// K08b (sort_by_key): fatia de struct com chave de campo inteiro, f64 e str. Deve passar a semantica.
struct Item {
    chave: int
    peso: f64
    nome: str
}

proc main() {
    var l = make([dynamic]Item, alloc = heap)
    append(&l, item = Item{chave = 2, peso = 1.5, nome = "b"})
    sort_by_key(l[..], key = Item.chave)
    sort_by_key(l[..], key = Item.peso)
    sort_by_key(l[..], key = Item.nome)
    delete(l)
}
