// v1.11 L15a (A08, E0335): [dynamic, N]T e uma lista de capacidade fixa dentro do proprio valor (sem alocador, sem delete). Nasce de {}, tem len, l[i], &l[i], l[..],
// for, for &item, for i, item e append(&l, item = x); e valor (copia ao atribuir, passar e devolver) e aceita N literal ou const.
struct Bala {
    x: int
    vivo: bool
}

struct Frota {
    balas: [dynamic, 4]Bala
    nome: int
}

const CAPACIDADE: int = 3

proc somar(l: ^[dynamic, 8]int) -> int {
    var soma = 0
    for v in l {
        soma += v
    }
    return soma
}

proc copiar(l: [dynamic, CAPACIDADE]int) -> [dynamic, CAPACIDADE]int {
    return l
}

proc main() {
    var balas: [dynamic, 4]Bala = {}
    append(&balas, item = Bala{x = 10, vivo = true})
    append(&balas, item = Bala{x = 20, vivo = false})
    balas[0].x = 11
    let p = &balas[1]
    p.x = 21
    for b in balas {
        print(b.x)
    }
    for &b in balas {
        b.x += 1
    }
    for i, b in balas {
        print(i)
        print(b.x)
    }
    var salva = balas
    balas = {}
    print(len(balas))
    print(len(salva))
    let visao = salva[..]
    print(len(visao))
    var frota = Frota{nome = 3}
    append(&frota.balas, item = Bala{x = 5, vivo = true})
    print(frota.balas[0].x)
    var inteiros: [dynamic, CAPACIDADE]int = {}
    append(&inteiros, item = 1)
    let outra = copiar(inteiros)
    print(len(outra))
    var oito: [dynamic, 8]int = {}
    append(&oito, item = 4)
    print(somar(&oito))
    var grade: [2][dynamic, 3]int = {}
    append(&grade[1], item = 6)
    print(grade[1][0])
}
