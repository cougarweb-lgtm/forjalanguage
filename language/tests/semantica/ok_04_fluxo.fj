struct Contador {
    n: int = 0
}

proc incrementar(c: ^Contador) {
    c.n += 1
}

proc somar_pares(limite: int) -> int {
    var total = 0
    var i = 0
    while i < limite {
        i += 1
        if i % 2 == 1 {
            continue
        }
        if i > 100 {
            break
        }
        total += i
    }
    return total
}

proc main() {
    var c = Contador{}
    defer incrementar(&c)
    defer c.n = 0
    assert(c.n == 0, msg = "contador comeca em zero")
    for k in 0..<3 {
        if k == 1 {
            continue
        }
        print(k)
    }
    print(somar_pares(10))
    if c.n > 100 {
        panic("impossivel")
    }
}

test "somar_pares soma os pares" {
    expect(somar_pares(10) == 30)
}

test "contador incrementa" {
    var c = Contador{}
    incrementar(&c)
    expect(c.n == 1)
    assert(c.n == 1)
}
