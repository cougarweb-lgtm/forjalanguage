proc texto_de(n: int, alloc: Allocator) -> str {
    return format(f"n={n}", alloc = alloc)
}

proc ponteiro_de(alloc: Allocator) -> ^int {
    let p = new(int, alloc = alloc)
    return p
}

proc lista_de(alloc: Allocator) -> [dynamic]int {
    var l = make([dynamic]int, alloc = alloc)
    append(&l, item = 1)
    return l
}

proc copia_de(src: []int, alloc: Allocator) -> [dynamic]int {
    let c = clone(src, alloc = alloc)
    return c
}

proc texto_c_de(n: int, alloc: Allocator) -> cstr {
    return format_c(f"c{n}", alloc = alloc)
}

proc lista_temporaria(alloc: Allocator) -> int {
    var t = make([dynamic]int, alloc = alloc)
    append(&t, item = 7)
    let n = len(t)
    delete(t)
    return n
}

proc main() {
    print(1)
}
