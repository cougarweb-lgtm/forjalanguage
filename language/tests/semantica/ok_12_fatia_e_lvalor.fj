struct Grifo {
    vida: i32 = 10
    pos: [3]i32 = {0, 0, 0}
    alvos: []i32
}

proc somar(s: []int) -> int {
    s[0] = 5
    s[1] += 2
    return s[0] + s[1]
}

proc primeiro(p: ^[4]int) -> ^int {
    return &p[0]
}

proc cauda(s: []int) -> []int {
    return s[1..<2]
}

proc inteira(s: []int) -> []int {
    return s
}

proc empurrar(g: ^Grifo, passo: i32) {
    g.pos[0] += passo
}

proc main() {
    var a: [4]int = {1, 2, 3, 4}
    let t = a[..]
    let u = a[1..<3]
    let v = a[0..=1]
    let w = t[1..<2]
    let p = &a
    let y = p[1..<3]
    let z = y[..]
    t[0] = 9
    u[1] += 1
    t[1..<3][0] = 4
    let q = &a[2]
    let r = &t[0]
    q^ = 7
    var g = Grifo{}
    let pg = &g
    pg.pos[1] = 4
    pg.pos[2] += 1
    let c = &g.vida
    let d = &pg.pos[1]
    g.pos[0] = 3
    empurrar(&g, passo = 2)
    var bando: [2]Grifo = {Grifo{}, Grifo{vida = 50}}
    bando[0].vida += 1
    bando[1].pos[2] = 9
    let e = &bando[1]
    e.vida = 1
    print(somar(t))
    print(len(v) + len(w) + len(z) + len(cauda(t)) + len(inteira(t)))
    print(primeiro(&a)^ + r^)
    print(c^ + d^)
    print(a[0..=3][1])
    print(bando[0].vida)
}
