// ok_handle_struct_valor.fj - M6c P87: handle como struct por valor (creates no retorno, destroys no parametro) com as mesmas regras de posse. Sem erro.
// Esperado: 'forja check' sai 0 sem saida. Hoje: falha (a clausula ainda nao existe).
foreign {
    proc abrir_id() -> Id creates
    proc fechar_id(id: Id) destroys id
}

pub struct Id {
    valor: u64
}

proc main() {
    let id = abrir_id()
    defer fechar_id(id)
    print(1)
}
