// err_handle_proc_forja_fecha.fj - M6c P87: handle entregue a proc Forja SEM clausula (emprestimo) que o fecha por fora: o chamador ve E0317 no 'f' do let (R-M6c-3, falso positivo aceito ate o G3).
// Esperado: 'forja check' sai 1 com E0317 na linha 14, coluna do 'f'. forma_certa: "feche no proc que abriu ou guarde-o num campo". Hoje: falha de outro codigo.
foreign {
    opaque Arq
    proc fopen_c(caminho: cstr, modo: cstr) -> ?^Arq creates
    proc fclose_c(f: ?^Arq) -> i32 destroys f
}

proc fecha_por_outro(f: ?^Arq) {
    _ = fclose_c(f)
}

proc main() {
    let f = fopen_c("a.txt", "r")
    fecha_por_outro(f)
}
