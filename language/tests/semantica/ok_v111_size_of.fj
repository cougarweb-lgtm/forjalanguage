// v1.11 L9 (A12): size_of, align_of e offset_of dao o layout do C como int constante; static_assert confere na compilacao.
unit Metros: f32

struct Vertice {
    x: f32
    y: f32
    uv: f32
}

struct Folga {
    a: i8
    b: i32
    c: i8
}

struct Mistura {
    flag: bool
    peso: f64
    nome: str
}

const TAM_VERTICE: int = size_of(Vertice)

static_assert(size_of(i8) == 1, msg = "i8 tem 1 byte")
static_assert(size_of(i32) == 4)
static_assert(size_of(int) == 8)
static_assert(size_of(f64) == 8)
static_assert(size_of(bool) == 1)
static_assert(size_of(str) == 16)
static_assert(size_of(^Vertice) == 8)
static_assert(size_of([]Vertice) == 16)
static_assert(size_of([3]f32) == 12)
static_assert(size_of(Metros) == 4)
static_assert(size_of(Folga) == 12)
static_assert(align_of(Folga) == 4)
static_assert(offset_of(Folga.a) == 0)
static_assert(offset_of(Folga.b) == 4)
static_assert(offset_of(Folga.c) == 8)
static_assert(offset_of(Mistura.peso) == 8 and offset_of(Mistura.nome) == 16)
static_assert(TAM_VERTICE == 12 and align_of(f64) == 8)

proc main() {
    print(size_of(Folga))
    print(offset_of(Mistura.peso) + size_of(Metros))
    let v = Vertice{x = 1, y = 2, uv = 3}
    let f = Folga{a = 1, b = 2, c = 3}
    let m = Mistura{flag = true, peso = 1.5, nome = "m"}
    var tri: [3]f32 = {1, 2, 3}
    let fatia = tri[..]
    print(v.uv as int + f.b as int + f.c as int)
    print(m.peso as int + fatia[1] as int)
    print(m.nome)
}
