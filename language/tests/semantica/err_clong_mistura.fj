// err_clong_mistura.fj - M6c P83: c_long lido fora da fronteira (let r: i32 = labs(x)) = E0342 com forma_certa "labs(x) as i32".
// Esperado: 'forja check' sai 1 com E0342 na linha 9, coluna do 'labs(x)'. Hoje: falha de outro codigo (c_long nao existe).
foreign {
    proc labs(n: c_long) -> c_long
}

proc main() {
    let x = -7 as c_long
    let r: i32 = labs(x)
    print(r)
}
