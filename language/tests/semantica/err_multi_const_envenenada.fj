// L8: const com erro fica envenenada: o uso em expressao, em let e como N de array (assinatura de proc) nao gera linha. So o init da const sai.
const LIMITE: i32 = true

proc um() -> i32 {
    let a: i32 = LIMITE
    return a + LIMITE * 2
}

proc dois(v: [LIMITE]i32) -> i32 {
    return v[0]
}

proc main() {
    print(um())
}
