// texto.fj - modulo da fixture 2 de 'forja editar' (tests\editar): procs de texto sem dependencia de outro modulo.

// Cerca o texto de colchetes.
pub proc moldura(s: str) -> str {
    if s == "" {
        return "vazio"
    }
    return s
}

// Quantas casas decimais tem o numero.
pub proc casas(n: i32) -> i32 {
    var total = 1
    var resto = n
    while resto >= 10 {
        resto = resto / 10
        total += 1
    }
    return total as i32
}

pub struct Marca {
    simbolo: i32 = 45
}
