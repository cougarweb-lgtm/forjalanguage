// main.fj - fixture 2 de 'forja editar' (tests\editar): o main e tres modulos (calc/aritmetica, calc/formas, util/texto) para inserir, remover e mover declaracoes.

import "calc/aritmetica" as ar
import "calc/formas" as fo
import "util/texto" as tx

const PASSOS: i32 = 3

// Resumo de um retangulo: area mais um.
proc resumo(r: fo.Retangulo) -> i32 {
    return fo.area(r) + ar.somar(0, b = 1)
}

proc rotulo(par: ar.Par) -> i32 {
    return ar.somar_par(par)
}

proc soma_resumos(a: fo.Retangulo, b: fo.Retangulo) -> i32 {
    return resumo(a) + resumo(b)
}

// Casas de um numero; sem uso.
proc legenda(n: i32) -> i32 {
    return tx.casas(n)
}

proc main() {
    let r = fo.Retangulo{largura = 3, altura = 4, cor = fo.Cor.verde}
    print(f"resumo {resumo(r)} perimetro {fo.perimetro(r)}")
    print(ar.dobrar(60))
    print(ar.triplicar(7))
    print(rotulo(ar.Par{esq = 2, dir = 5}))
    print(fo.codigo_da_cor(fo.Cor.azul))
    print(soma_resumos(r, b = r))
    print(ar.LIMITE)
}

test "somar" {
    expect(ar.somar(2, b = 3) == 5)
}

test "area" {
    expect(fo.area(fo.Retangulo{largura = 2, altura = 5}) == 10)
}
