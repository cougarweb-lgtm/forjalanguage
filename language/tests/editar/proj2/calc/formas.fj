// formas.fj - modulo da fixture 2 de 'forja editar' (tests\editar): enum, struct e procs que usam o modulo de aritmetica por apelido.

import "calc/aritmetica" as ar

pub enum Cor { vermelho, verde, azul }

pub struct Retangulo {
    largura: i32
    altura: i32
    cor: Cor = Cor.vermelho
}

// Ponto no plano; sem uso.
pub struct Ponto {
    x: i32 = 0
    y: i32 = 0
}

// Area do retangulo.
pub proc area(r: Retangulo) -> i32 {
    return ar.somar(0, b = r.largura * r.altura)
}

// Perimetro do retangulo.
pub proc perimetro(r: Retangulo) -> i32 {
    return ar.dobrar(r.largura + r.altura)
}

// Dobro da area; sem uso.
pub proc dobro_area(r: Retangulo) -> i32 {
    return ar.somar(area(r), b = area(r))
}

// Valor numerico da cor.
pub proc codigo_da_cor(c: Cor) -> i32 {
    if c == Cor.verde {
        return 2
    }
    if c == Cor.azul {
        return 3
    }
    return 1
}

// Sem uso.
proc sobra(r: Retangulo) -> i32 {
    return r.altura
}
