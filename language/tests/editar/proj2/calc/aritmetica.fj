// aritmetica.fj - modulo da fixture 2 de 'forja editar' (tests\editar): procs, const e struct que os outros modulos usam por apelido.

pub const LIMITE: i32 = 100

// Piso do limite; sem uso.
pub const MINIMO: i32 = 0

// Soma dois inteiros.
pub proc somar(a: i32, b: i32) -> i32 {
    return a + b
}

// Dobra o valor sem passar do limite.
pub proc dobrar(n: i32) -> i32 {
    return limitar(n * 2)
}

// Triplica o valor; so o main usa.
pub proc triplicar(n: i32) -> i32 {
    return n * 3
}

proc limitar(n: i32) -> i32 {
    if n > LIMITE {
        return LIMITE
    }
    return n
}

// Ninguem usa esta.
pub proc obsoleta(n: i32) -> i32 {
    return n - 1
}

// Modo de calculo; sem uso.
pub enum Modo { rapido, lento }

pub struct Par {
    esq: i32 = 0
    dir: i32 = 0
}

pub proc somar_par(p: Par) -> i32 {
    return somar(p.esq, b = p.dir)
}
