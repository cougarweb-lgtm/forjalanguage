// conta.fj - modulo da fixture de 'forja editar' (tests\editar): procs publicos com parametros padrao, chamados com argumento nomeado pelo main.
pub proc dobro(n: i32) -> i32 {
    return n * 2
}

pub proc acumular(inicio: i32, passo: i32 = 1, vezes: i32 = 3) -> i32 {
    var total = inicio
    for i in 0..<vezes {
        total += passo
    }
    return total
}
