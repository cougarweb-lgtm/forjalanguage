// main.fj - fixture de 'forja editar' (tests\editar): o main e tres modulos (geo/vetor, geo/forma, util/conta). O nome somar_vetor aparece aqui num comentario e numa string
// de proposito: renomear o proc nao pode mexer neles.
import "geo/vetor" as vet
import "geo/forma" as fm
import "util/conta" as ct

enum Faixa { baixa, media, alta }

struct Placar {
    pontos: i32 = 0
    rodadas: i32 = 0
}

proc faixa_de(total: i32) -> Faixa {
    if total > 20 {
        return Faixa.alta
    }
    if total > 10 {
        return Faixa.media
    }
    return Faixa.baixa
}

proc nota_da_faixa(f: Faixa) -> i32 {
    if f == Faixa.alta {
        return 3
    }
    if f == Faixa.media {
        return 2
    }
    return 1
}

proc atualizar(p: Placar, ganho: i32) -> Placar {
    let novos = p.pontos + ganho
    return Placar{pontos = novos, rodadas = p.rodadas + 1}
}

proc main() {
    var placar = Placar{}
    for i in 0..<4 {
        placar = atualizar(placar, ganho = ct.dobro(i as i32) + 3)
    }
    let a = vet.Vetor{ex = 1.5, ey = 2.0}
    let b = vet.Vetor{ex = 0.5, ey = 1.0}
    let soma = vet.somar_vetor(a, b = b)
    let forma = fm.Forma{tipo = fm.Tipo.quadrado, centro = soma, peso = 2}
    print(f"placar {placar.pontos} em {placar.rodadas}")
    print(nota_da_faixa(faixa_de(placar.pontos)))
    print(fm.area_aprox(forma))
    print(ct.acumular(5, passo = 2, vezes = ct.dobro(2)))
    print("somar_vetor fica como texto")
    print(f"{vet.comprimento_quadrado(soma)}")
    let escalado = ct.dobro(vet.ESCALA)
    print(escalado)
}

test "acumular" {
    expect(ct.acumular(1) == 4)
}
