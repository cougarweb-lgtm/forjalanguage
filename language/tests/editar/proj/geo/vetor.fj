// vetor.fj - modulo da fixture de 'forja editar' (tests\editar): struct, const e procs publicos que os outros modulos usam por apelido.
pub struct Vetor {
    ex: f32 = 0.0
    ey: f32 = 0.0
}

pub const ESCALA: i32 = 3

pub proc somar_vetor(a: Vetor, b: Vetor) -> Vetor {
    return Vetor{ex = a.ex + b.ex, ey = a.ey + b.ey}
}

pub proc comprimento_quadrado(v: Vetor) -> f32 {
    return v.ex * v.ex + v.ey * v.ey
}
