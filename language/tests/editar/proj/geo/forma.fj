// forma.fj - modulo da fixture de 'forja editar' (tests\editar): enum e struct publicos, e um proc que le o enum e um campo do vetor de outro modulo.
import "geo/vetor" as vet

pub enum Tipo { circulo, quadrado, linha }

pub struct Forma {
    tipo: Tipo = Tipo.circulo
    centro: vet.Vetor
    peso: i32 = 1
}

pub proc area_aprox(f: Forma) -> i32 {
    var base: i32 = 1
    if f.tipo == Tipo.quadrado {
        base = 4
    }
    if f.tipo == Tipo.circulo {
        base = 3
    }
    let extra = f.centro.ex as i32
    return base * f.peso + extra
}
