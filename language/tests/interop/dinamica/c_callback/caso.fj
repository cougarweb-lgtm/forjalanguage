// caso.fj - P19i-a, caso c_callback. Versao: 0.1.0 (0.1.0: primeira versao, M3 P19i-a).
// Callbacks: qsort do CRT com proc da Forja; cb_ordenar (DLL) com user_data que conta as comparacoes; cb_somar_visitas com callback que
// chama de volta uma funcao da DLL (cb_peso); callback registrado numa chamada e disparado em outra.
// Verificacao: python -I ..\..\..\verificar_interop.py --forja <copia> --backend c --pasta dinamica --caso c_callback

foreign {
    link "cback"
    proc cb_ordenar(base: rawptr, n: u64, tamanho: u64, comparar: proc(a: rawptr, b: rawptr, ctx: rawptr) -> i32, user_data: rawptr)
    proc cb_somar_visitas(n: i32, visitar: proc(item: i32, ctx: rawptr) -> i32, user_data: rawptr) -> i32
    proc cb_registrar(visitar: proc(item: i32, ctx: rawptr) -> i32, user_data: rawptr)
    proc cb_disparar(valor: i32) -> i32
    proc cb_peso(item: i32) -> i32
}

foreign {
    proc qsort(base: rawptr, n: u64, tamanho: u64, comparar: proc(a: rawptr, b: rawptr) -> i32)
}

struct Contagem {
    chamadas: i32 = 0
    soma: i32 = 0
}

proc crescente(a: rawptr, b: rawptr) -> i32 {
    let x = a as ^i32
    let y = b as ^i32
    if x^ < y^ {
        return -1
    }
    if x^ > y^ {
        return 1
    }
    return 0
}

proc decrescente_contando(a: rawptr, b: rawptr, ctx: rawptr) -> i32 {
    let c = ctx as ^Contagem
    c^.chamadas += 1
    let x = a as ^i32
    let y = b as ^i32
    if x^ > y^ {
        return -1
    }
    if x^ < y^ {
        return 1
    }
    return 0
}

proc visita_pesada(item: i32, ctx: rawptr) -> i32 {
    let c = ctx as ^Contagem
    c^.chamadas += 1
    c^.soma += item
    return cb_peso(item)
}

proc visita_dobro(item: i32, ctx: rawptr) -> i32 {
    let c = ctx as ^Contagem
    c^.soma += item * 2
    return item * 2
}

proc mostrar(v: [5]i32) {
    print(f"{v[0]} {v[1]} {v[2]} {v[3]} {v[4]}")
}

proc main() {
    var v: [5]i32 = {4, 2, 5, 1, 3}
    qsort(&v[0] as rawptr, n = 5, tamanho = 4, comparar = crescente)
    mostrar(v)

    var c = Contagem{}
    cb_ordenar(&v[0] as rawptr, n = 5, tamanho = 4, comparar = decrescente_contando, user_data = &c as rawptr)
    mostrar(v)
    print(c.chamadas)

    var visitas = Contagem{}
    print(cb_somar_visitas(4, visitar = visita_pesada, user_data = &visitas as rawptr))
    print(visitas.chamadas)
    print(visitas.soma)

    var guardado = Contagem{}
    print(cb_disparar(7))
    cb_registrar(visita_dobro, user_data = &guardado as rawptr)
    print(cb_disparar(7))
    print(cb_disparar(10))
    print(guardado.soma)
}
