// caso.fj - P19i-a, caso c_import_msvc. Versao: 0.1.0 (0.1.0: primeira versao, M3 P19i-a).
// Liga pela import library CURTA do MSVC (python313.lib, de C:\Program Files\Python313\libs, copiada para a pasta de trabalho por externos.txt):
// Py_GetVersion() devolve o texto da versao ("3.13.x ..."); strncmp (CRT) confere o prefixo "3.13". A python313.dll entra so no PATH do run (caminho.txt).
// Se o Python 3.13 nao existir na maquina, troque os caminhos de externos.txt/caminho.txt e o link/prefixo daqui pela versao instalada.
// Verificacao: python -I ..\..\..\verificar_interop.py --forja <copia> --backend c --pasta dinamica --caso c_import_msvc

foreign {
    link "python313"
    proc Py_GetVersion() -> cstr
}

foreign {
    proc strncmp(a: cstr, b: cstr, n: u64) -> i32
}

proc main() {
    let versao = Py_GetVersion()
    if strncmp(versao, b = "3.13", n = 4) == 0 {
        print("prefixo 3.13")
    } else {
        print("prefixo diferente de 3.13")
    }
    print(len(versao as str) > 4)
}
