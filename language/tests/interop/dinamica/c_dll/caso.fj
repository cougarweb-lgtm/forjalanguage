// caso.fj - P19i-a, caso c_dll. Versao: 0.1.0 (0.1.0: primeira versao, M3 P19i-a).
// DLL de C (cdll.dll): escalares, ponteiro de saida, buffer do chamador, cstr entrando e saindo, enum, estado dentro da DLL.
// Verificacao: python -I ..\..\..\verificar_interop.py --forja <copia> --backend c --pasta dinamica --caso c_dll

foreign {
    link "cdll"
    proc cd_soma(a: i32, b: i32) -> i32
    proc cd_mul64(a: i64, b: i64) -> i64
    proc cd_media(a: f64, b: f64) -> f64
    proc cd_inverte_bits(v: u8) -> u8
    proc cd_divide(a: i32, b: i32, quociente: ^i32, resto: ^i32) -> i32
    proc cd_preenche(destino: ^i32, n: i32) -> i64
    proc cd_tamanho(texto: cstr) -> i32
    proc cd_nome_da_cor(cor: i32) -> ?cstr
    proc cd_contar(passo: i32) -> i32
    proc cd_zerar()
}

proc main() {
    print(cd_soma(40, b = 2))
    print(cd_mul64(3000000000, b = 7))
    print((cd_media(1.0, b = 2.0) * 100.0) as int)
    print(cd_inverte_bits(15))

    var q: i32 = -1
    var r: i32 = -1
    print(cd_divide(17, b = 5, quociente = &q, resto = &r))
    print(q)
    print(r)
    print(cd_divide(17, b = 0, quociente = &q, resto = &r))
    print(q)

    var buf: [4]i32 = {0, 0, 0, 0}
    print(cd_preenche(&buf[0], n = 4))
    print(buf[3])

    print(cd_tamanho("interop"))
    print(cd_nome_da_cor(0) or_else "?")
    print(cd_nome_da_cor(5) or_else "?")
    print(cd_nome_da_cor(2) or_else "sem cor")

    print(cd_contar(3))
    print(cd_contar(4))
    cd_zerar()
    print(cd_contar(1))
}
