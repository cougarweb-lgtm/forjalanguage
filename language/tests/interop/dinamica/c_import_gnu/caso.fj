// caso.fj - P19i-a, caso c_import_gnu. Versao: 0.1.0 (0.1.0: primeira versao, M3 P19i-a).
// Liga pela import library GNU (libgnuimp.dll.a, gerada pelo dlltool). A gnuimp.dll NAO esta na pasta de busca (-L): fica em dll\ e so entra no PATH do run.
// Verificacao: python -I ..\..\..\verificar_interop.py --forja <copia> --backend c --pasta dinamica --caso c_import_gnu

foreign {
    link "gnuimp"
    proc gi_soma3(a: i32, b: i32, c: i32) -> i32
    proc gi_fatorial(n: u32) -> u64
    proc gi_hipotenusa2(a: f64, b: f64) -> f64
    proc gi_nome() -> cstr
}

proc main() {
    print(gi_soma3(1, b = 20, c = 300))
    print(gi_fatorial(20))
    print((gi_hipotenusa2(3.0, b = 4.0) * 10.0) as int)
    print(gi_nome())
}
