// caso.fj - P19i-a, caso mariadb_implib. Versao: 0.1.0 (0.1.0: primeira versao, M3 P19i-a).
// Liga pela import library GNU de terceiros (vendor\libmariadb.dll.a, MariaDB Connector/C 3.4.11, LGPL-2.1; a bateria copia a .dll.a e a DLL
// conferindo o sha256 de artefatos.sha256). So build + chamadas que nao precisam de servidor: mysql_get_client_info e mysql_get_client_version.
// Verificacao: python -I ..\..\..\verificar_interop.py --forja <copia> --backend c --pasta dinamica --caso mariadb_implib

foreign {
    link "mariadb"
    proc mysql_get_client_info() -> ?cstr
    proc mysql_get_client_version() -> u32
}

foreign {
    proc strncmp(a: cstr, b: cstr, n: u64) -> i32
}

proc main() {
    let info = mysql_get_client_info() or_else "?"
    print(strncmp(info, b = "3.4.11", n = 6))
    print(mysql_get_client_version() >= 30400)
}
