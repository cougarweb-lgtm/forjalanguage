// caso_excecao.fj - P19i-a, caso cpp_wrapper_dll (programa extra). Versao: 0.1.0 (0.1.0: primeira versao, M3 P19i-a).
// Desempilhar de pilha vazia lanca std::underflow_error em C++: o wrapper converte para R0010 (exit 101) em vez de deixar a excecao cruzar para a Forja.
// Verificacao: python -I ..\..\..\verificar_interop.py --forja <copia> --backend c --pasta dinamica --caso cpp_wrapper_dll

import "pilha"

proc main() {
    let p = pilha.interop_cpp_Pilha_new(2)
    pilha.interop_cpp_Pilha_empilhar(p, valor = 7)
    print(pilha.interop_cpp_Pilha_desempilhar(p))
    print(pilha.interop_cpp_Pilha_desempilhar(p))
    print(99)
}
