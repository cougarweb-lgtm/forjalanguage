// caso.fj - P19i-a, caso cpp_wrapper_dll. Versao: 0.1.0 (0.1.0: primeira versao, M3 P19i-a).
// Classe C++ (pilha.hpp) por wrapper C gerado pelo 'forja ligar --cpp' (pilha.fj + pilha_c.cpp, compilados em pilha.dll): construtor, metodos e destrutor
// (a contagem de destruicoes da DLL prova que o destrutor rodou). A excecao C++ vira R0010 em caso_excecao.fj.
// Verificacao: python -I ..\..\..\verificar_interop.py --forja <copia> --backend c --pasta dinamica --caso cpp_wrapper_dll

import "pilha"

proc main() {
    let p = pilha.interop_cpp_Pilha_new(4)
    pilha.interop_cpp_Pilha_empilhar(p, valor = 10)
    pilha.interop_cpp_Pilha_empilhar(p, valor = 20)
    pilha.interop_cpp_Pilha_empilhar(p, valor = 30)
    print(pilha.interop_cpp_Pilha_tamanho(p))
    print(pilha.interop_cpp_Pilha_desempilhar(p))
    print(pilha.interop_cpp_Pilha_desempilhar(p))
    print(pilha.interop_cpp_Pilha_tamanho(p))
    print(pilha.interop_cpp_destruidas())
    pilha.interop_cpp_Pilha_delete(p)
    print(pilha.interop_cpp_destruidas())
}
