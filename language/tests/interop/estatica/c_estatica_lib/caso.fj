// caso.fj - P19i-b, caso c_estatica_lib. Versao: 0.1.0 (0.1.0: primeira versao, M3 P19i-b).
// Lib estatica GNU com a extensao .lib (estlib.lib, link "estlib"): o tipo vem do conteudo "!<arch>", nao do nome (Q28).
// Verificacao: python -I ..\..\verificar_interop.py --forja <copia> --backend c --pasta estatica --caso c_estatica_lib

foreign {
    link "estlib"
    proc el_potencia(base: i64, exp: i32, saida: ^i64) -> i32
    proc el_xor(dados: ^u8, n: i32) -> u8
    proc el_inverter(dados: ^u8, n: i32)
    proc el_media(valores: ^f64, n: i32) -> f64
}

proc main() {
    var r: i64 = -1
    print(el_potencia(2, exp = 62, saida = &r))
    print(r)
    print(el_potencia(3, exp = 20, saida = &r))
    print(r)
    print(el_potencia(-2, exp = 3, saida = &r))
    print(r)
    print(el_potencia(5, exp = 0, saida = &r))
    print(r)
    print(el_potencia(2, exp = -1, saida = &r))
    print(r)

    var a: [5]u8 = {1, 2, 3, 4, 5}
    print(el_xor(&a[0], n = 5))
    var b: [3]u8 = {255, 15, 240}
    print(el_xor(&b[0], n = 3))
    var c: [2]u8 = {165, 90}
    print(el_xor(&c[0], n = 2))

    el_inverter(&a[0], n = 5)
    for x in a {
        print(x)
    }

    var m: [3]f64 = {1.0, 2.0, 4.5}
    print((el_media(&m[0], n = 3) * 100.0) as int)
    print((el_media(&m[0], n = 0) * 100.0) as int)
}
