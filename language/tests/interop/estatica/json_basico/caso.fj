// caso.fj - P19i-b, caso json_basico. Versao: 0.1.0 (0.1.0: primeira versao, M3 P19i-b; copia adaptada de language\exemplos_libs\json_basico.fj).
// std:json sobre cJSON 1.7.19 (MIT), ligado ESTATICAMENTE por vendor\libcjson.a (a bateria copia a .a conferindo o sha256 de artefatos.sha256).
// Verificacao: python -I ..\..\verificar_interop.py --forja <copia> --backend c --pasta estatica --caso json_basico

import "vendor:json/json"

proc ler_e_remontar() -> ! json.JsonError {
    let doc = try json.parse("{\"nome\": \"leao\", \"vida\": 120, \"ativo\": true, \"pos\": {\"x\": 1.5, \"y\": -2}, \"clipes\": [\"idle\", \"walk\", \"run\"]}")
    defer json.close(doc)

    let nome = try json.field_text(doc, name = "nome")
    let vida = try json.field_int(doc, name = "vida")
    let ativo = try json.field_bool(doc, name = "ativo")
    print(f"nome={nome} vida={vida} ativo={ativo}")

    let pos = try json.field(doc, name = "pos")
    let x = try json.field_number(pos, name = "x")
    let y = try json.field_int(pos, name = "y")
    print(f"x={x} y={y}")

    let clipes = try json.field(doc, name = "clipes")
    let total = json.size(clipes)
    print(f"clipes={total}")
    for i in 0..<total {
        let c = try json.item(clipes, index = i)
        let t = try json.text(c)
        print(f"  [{i}] {t}")
    }

    let saida = try json.new_object()
    defer json.close(saida)
    try json.set_text(saida, name = "modelo", value = "aguia")
    try json.set_number(saida, name = "total", value = 3.0)
    try json.set_bool(saida, name = "ok", value = true)
    try json.set_null(saida, name = "extra")
    let lista = try json.set_list(saida, name = "nomes")
    try json.push_text(lista, value = "a")
    try json.push_text(lista, value = "b")
    let filho = try json.set_object(saida, name = "filho")
    try json.set_number(filho, name = "n", value = 7.0)

    let compacto = try json.dump(saida, pretty = false)
    defer delete(compacto)
    print(compacto)
    let bonito = try json.dump(saida, pretty = true)
    defer delete(bonito)
    print(bonito)
}

proc main() -> ! json.JsonError {
    try ler_e_remontar()
}
