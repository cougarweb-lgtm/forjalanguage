// caso.fj - P19i-b, caso c_estatica_a. Versao: 0.1.0 (0.1.0: primeira versao, M3 P19i-b).
// Lib ESTATICA de C (libest.a, 2 membros .o): inteiros, buffer do chamador, struct por valor e por ponteiro, hash, texto e estado dentro da lib.
// O .exe leva a lib dentro (sem DLL). Verificacao: python -I ..\..\verificar_interop.py --forja <copia> --backend c --pasta estatica --caso c_estatica_a

struct EstPonto {
    x: i32
    y: i32
}

foreign {
    link "est"
    proc est_fatorial(n: i32) -> i64
    proc est_mdc(a: i32, b: i32) -> i32
    proc est_ordena(v: ^i32, n: i32)
    proc est_fnv1a(texto: cstr) -> u32
    proc est_distancia2(a: EstPonto, b: EstPonto) -> i64
    proc est_ponto_mover(p: ^EstPonto, dx: i32, dy: i32)
    proc est_vogais(texto: cstr) -> i32
    proc est_maiuscula(texto: cstr) -> ?cstr
    proc est_registrar(valor: i32) -> i32
    proc est_maximo() -> i32
    proc est_limpar()
}

proc main() {
    print(est_fatorial(10))
    print(est_fatorial(20))
    print(est_fatorial(21))
    print(est_fatorial(-3))

    print(est_mdc(84, b = 36))
    print(est_mdc(-48, b = 18))
    print(est_mdc(17, b = 5))

    var v: [7]i32 = {9, -3, 7, 0, 5, 5, -8}
    est_ordena(&v[0], n = 7)
    for x in v {
        print(x)
    }

    print(est_fnv1a(""))
    print(est_fnv1a("a"))
    print(est_fnv1a("foobar"))

    print(est_distancia2(EstPonto{x = 1, y = 2}, b = EstPonto{x = 4, y = 6}))
    print(est_distancia2(EstPonto{x = 100000, y = 0}, b = EstPonto{x = -100000, y = 0}))
    var p = EstPonto{x = 10, y = 20}
    est_ponto_mover(&p, dx = -3, dy = 5)
    print(p.x)
    print(p.y)

    print(est_vogais("Engine Forja"))
    print(est_vogais(""))
    print(est_maiuscula("forja 3d") or_else "?")
    print(est_maiuscula("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa") or_else "?")
    print(est_vogais(est_maiuscula("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa") or_else ""))

    print(est_maximo())
    print(est_registrar(5))
    print(est_registrar(-2))
    print(est_registrar(12))
    print(est_maximo())
    est_limpar()
    print(est_maximo())
    print(est_registrar(-7))
    print(est_maximo())
}
