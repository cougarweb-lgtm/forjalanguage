foreign {
    link "d1"
    proc r1(n: i32)
}

foreign {
    link "d2"
    proc r2(n: i32)
    proc longa()
}

foreign {
    link "d3"
    proc r3(n: i32)
}

proc main() {
    for i in 0..<3 {
        let n = i as i32
        r1(n)
        r2(n)
        r3(n)
        print(f"app i={n}")
    }
    longa()
    r1(9)
    print("app fim")
}
