struct No {
    v: i32
    prox: ?^No
}

proc neg(p: ^No, a: []i32) -> i32 {
    let x = -p^.v
    let y = a[1..<2]
    let z = a[0] - -1
    if x == -1 {
        return -1
    }
    return x - 1
}

proc main() {
    var n = No{v = 1, prox = none}
    let p = &n
    let w = p^.v
    var o: ?^No = none
    o = &n
}
