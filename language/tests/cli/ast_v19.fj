enum Cor {
    a
    b
}

struct P {
    x: f32 = 0.0
}

proc main() {
    var m: map[str]int = make(map[str]int, alloc = scope)
    let s: bit_set[Cor] = {Cor.a}
    var d: soa[dynamic]P = make(soa[dynamic]P, alloc = scope)
    let t: matrix[4, 4]f32 = {}
    let e = t[1, 2]
    insert(&m, key = "x", value = len(s))
    append(&d, item = P{x = e})
}
