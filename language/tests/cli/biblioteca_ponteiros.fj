struct Vec3 {
    x: f32
    y: f32
    z: f32
}

struct Par {
    a: i32
    b: i32
}

struct Grifo {
    vida: i32
}

pub export proc incrementar(p: ^i32) {
    p^ += 1
}

pub export proc soma_vec(v: Vec3) -> f32 {
    return v.x + v.y + v.z
}

pub export proc escala(v: Vec3, k: f32) -> Vec3 {
    return Vec3{x = v.x * k, y = v.y * k, z = v.z * k}
}

pub export proc criar_par(a: i32, b: i32) -> Par {
    return Par{a = a, b = b}
}

pub export proc tamanho(c: cstr) -> int {
    return len(c as str)
}

pub export proc ler_opcional(p: ?^i32) -> i32 {
    if p == none {
        return -1
    }
    let q = p as ^i32
    return q^
}

pub export proc ferir(g: ^Grifo, dano: i32) {
    g.vida -= dano
}

pub export proc id_bruto(r: rawptr) -> rawptr {
    return r
}

proc main() {
    print(tamanho("Grifo"))
}
