proc pega(v: []int, i: int) -> int {
    return v[i]
}

test "primeiro falha" {
    var a: [2]int = {1, 2}
    expect(pega(a[..], i = 5) == 1)
}

test "meio passa" {
    expect(1 == 1)
}

test "segundo falha" {
    var a: [2]int = {1, 2}
    expect(pega(a[..], i = 6) == 1)
}

proc main() {
    print(1)
}
