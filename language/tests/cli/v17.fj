union Valor { i32, str }

proc par(n: int) -> (a: int, b: int) {
    return n, n + 1
}

proc main() {
    let o: ?int = 3
    let v: Valor = "x"
    let a, b = par(1)
    let s = format(f"{a}-{b}", alloc = heap)
    print(f"{o or_else 0} {s}")
    delete(s)
    switch t in v {
    case i32:
        print(t)
    case str:
        print(t)
    }
}
