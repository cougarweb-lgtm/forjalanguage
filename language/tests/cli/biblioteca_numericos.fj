pub export proc soma_u8(a: u8, b: u8) -> u8 {
    return a + b
}

pub export proc soma_i16(a: i16, b: i16) -> i16 {
    return a + b
}

pub export proc mascara_baixa(v: u32, bits: u32) -> u32 {
    let um: u32 = 1
    return v & ((um << bits) - 1)
}

pub export proc maior_uint(a: uint, b: uint) -> uint {
    if a > b {
        return a
    }
    return b
}

pub export proc media(a: f64, b: f64) -> f64 {
    return (a + b) / 2.0
}

pub export proc passo_i8(v: i8) -> i8 {
    return v + 1
}

proc main() {
    print(soma_u8(1, b = 2))
}
