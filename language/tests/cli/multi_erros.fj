// L7: tres procs com um erro cada (check devolve 3 linhas; --max-erros 1 devolve 1).
proc primeiro() {
    let a: i32 = true
    print(a)
}

proc segundo() {
    print(nao_existe)
}

proc terceiro() -> i32 {
    let b: bool = 1
    return 0
}

proc main() {
    primeiro()
    segundo()
    terceiro()
}
