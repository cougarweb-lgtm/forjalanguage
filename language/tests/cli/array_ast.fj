const N: int = 2

proc somar(s: []int, c: [N]int) -> int {
    var total = 0
    for i in 0..<len(s) {
        total += s[i]
    }
    return total + c[0]
}

proc main() {
    var a: [3]int = {1, 2, 3}
    let b: [N]int = {4, 5}
    let t = a[1..<2]
    let u = a[..]
    print(somar(u, c = b) + t[0])
    for i, &x in a {
        x^ = x^ + i
    }
}
