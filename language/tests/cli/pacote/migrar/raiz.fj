// L1b: a raiz tem uma forma antiga (o rotulo em = heap de new) e importa um pacote de pasta; o migrar troca so a raiz e o texto migrado ainda compila com o pacote.
import "pk"

struct Grifo {
    vida: i32 = 5
}

proc main() {
    let g = new(Grifo, em = heap)
    defer delete(g)
    print(g.vida as int)
    print(pk.um())
}
