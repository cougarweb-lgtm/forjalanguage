import "util"

// Ponto: o par de coordenadas do pacote
pub struct Ponto {
    x: int = 0
    y: int = 0
}

// soma as duas coordenadas
pub proc soma(p: Ponto) -> int {
    return p.x + p.y
}

// dobra a soma usando o pacote util
pub proc soma_dobrada(p: Ponto) -> int {
    return util.dobro(soma(p))
}

test "soma do pacote" {
    expect(soma(Ponto{x = 1, y = 2}) == 3)
}
