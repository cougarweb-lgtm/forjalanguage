// Imprime quantos argumentos o programa recebeu e cada um entre colchetes (forja run app.fj -- a "b c").
// Le o argv por std:os.args (o exe x64 nao leva o msvcrt; a posicao 0 e o proprio programa).
import "std:os"

proc main() {
    let argumentos = os.args()
    var i = 1

    print(len(argumentos) - 1)
    while i < len(argumentos) {
        print(f"[{argumentos[i]}]")
        i += 1
    }
}
