struct Grifo {
    vida: i32 = 100
}

pub export proc soma_ate(n: i32) -> i64 {
    var l = make([dynamic]i64, alloc = heap)
    for i in 0..<n {
        append(&l, item = i as i64)
    }
    var total: i64 = 0
    for x in l {
        total += x
    }
    delete(l)
    return total
}

pub export proc novo_grifo() -> ^Grifo {
    return new(Grifo, alloc = heap)
}

pub export proc vida_de(g: ^Grifo) -> i32 {
    return g.vida
}

pub export proc soltar(g: ^Grifo) {
    delete(g)
}

proc main() {
    print(soma_ate(10))
}
