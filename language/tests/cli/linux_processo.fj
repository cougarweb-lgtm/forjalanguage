// Fixture do cli (M5 P28b-1/P28b-2): usa std:process. No x86_64-linux o build LIGA (P28b-2: rt_linux_es.o define forja_processo_*); no Windows compila e roda (cmd.exe).
import "std:process"

proc main() {
    var args: [1]str = {"/c"}
    let cmd = process.Command{program = "cmd.exe", args = args[..], env = {}, cwd = "", timeout_ms = 0}
    switch p in process.spawn(cmd) {
    case process.Process:
        process.close(p)
        print("ok")
    case process.ProcessError:
        print("erro")
    }
}
