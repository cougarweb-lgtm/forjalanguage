// proc em let/var, parametro e retorno; chamada de local proc f(x), argumento nomeado pelos nomes do TIPO.
proc dobrar(valor: i32) -> i32 {
    return valor * 2
}

proc somar(a: i32, b: i32) -> i32 {
    return a + b
}

proc aplicar(f: proc(x: i32) -> i32, n: i32) -> i32 {
    return f(n)
}

proc combinar(g: proc(a: i32, b: i32) -> i32) -> i32 {
    return g(1, b = 2)
}

proc escolher(dobro: bool) -> proc(x: i32) -> i32 {
    return dobrar
}

proc main() {
    let h = dobrar
    var k: proc(x: i32) -> i32 = dobrar
    k = escolher(true)
    print(aplicar(h, n = 4))
    print(aplicar(k, n = 5))
    print(combinar(somar))
    print(escolher(false)(7))
}
