struct Ponto {
    x: i32
    y: i32
}

enum Modo {
    lento
    rapido
}

pub export proc dobrar(v: f32) -> f32 {
    return v * 2.0
}

pub export proc eh_rapido(m: Modo) -> bool {
    return m == Modo.rapido
}

pub export proc soma_ponto(p: ^Ponto) -> i32 {
    return p.x + p.y
}

pub export proc ola() {
    print(1)
}

proc main() {
    ola()
}
