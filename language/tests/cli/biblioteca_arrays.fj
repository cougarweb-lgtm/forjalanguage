pub export proc soma_quadrados(n: i32) -> i64 {
    var a: [8]i64 = {}
    for i in 0..<8 {
        a[i] = (i * i) as i64
    }
    var total: i64 = 0
    for x in a {
        total += x
    }
    return total
}

pub export proc pega(i: i32) -> i32 {
    let a: [3]i32 = {1, 2, 3}
    return a[i]
}

proc main() {
    print(soma_quadrados(8))
    print(pega(1))
}
