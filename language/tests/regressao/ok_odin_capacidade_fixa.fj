// v1.11 L15b (F04 do Odin): capacidade fixa [dynamic, N] com N constante, len, append dentro de laco que respeita a capacidade, valor passado e devolvido e lista dentro de lista.
const LIMITE: int = 5

proc tamanho(l: [dynamic, LIMITE]int) -> int {
    return len(l)
}

proc main() {
    var fila: [dynamic, LIMITE]int = {}
    for i in 0..<LIMITE + 2 {
        if len(fila) < LIMITE {
            append(&fila, item = i)
        }
    }
    let copia = fila
    print(tamanho(copia))
    var pares: [2][dynamic, 3]int = {}
    append(&pares[0], item = 1)
    append(&pares[1], item = 2)
    print(len(pares[0]) + len(pares[1]))
}
