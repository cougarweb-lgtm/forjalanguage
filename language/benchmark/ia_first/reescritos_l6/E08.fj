// E08 reescrito sem foreign msvcrt (IA1-L6, L-07): atoll da libc vira text.parse_int; mesma saida e mesmo codigo de saida do original (tarefas\E\E08\esperado.json).
import "std:os"
import "std:text"

proc main() {
    let a = os.args()
    let n = text.parse_int(a[1]) or_else 0
    var fizzbuzz: int = 0
    for i in 1..=n {
        if i % 15 == 0 {
            print("FizzBuzz")
            fizzbuzz += 1
        } else if i % 3 == 0 {
            print("Fizz")
        } else if i % 5 == 0 {
            print("Buzz")
        } else {
            print(i)
        }
    }
    os.exit(fizzbuzz)
}
