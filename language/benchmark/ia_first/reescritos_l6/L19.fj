// L19 reescrito sem foreign msvcrt (IA1-L6, L-07): exit da libc vira os.exit; mesma saida e mesmo codigo de saida do original (referencias\forja\L\L19\gabarito.json).
import "std:os"

proc validar(n: int) {
    if n > 3 {
        print("limite")
        os.exit(3)
    }
}

proc main() {
    for i in 1..=10 {
        validar(i)
        print(i)
    }
    print(100)
}
