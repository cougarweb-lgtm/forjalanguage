// E10 reescrito sem foreign msvcrt (IA1-L6, L-07): atoll da libc vira text.parse_int; mesma saida do original (tarefas\E\E10\esperado.json).
import "std:os"
import "std:text"

proc main() {
    let a = os.args()
    let ma = text.parse_int(a[1]) or_else 0
    let mb = text.parse_int(a[2]) or_else 0
    let mc = text.parse_int(a[3]) or_else 0
    let md = text.parse_int(a[4]) or_else 0
    let x = text.parse_int(a[5]) or_else 0
    let y = text.parse_int(a[6]) or_else 0
    print(f"{ma * x + mb * y} {mc * x + md * y}")
}
