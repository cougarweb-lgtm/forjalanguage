// Migrar: com 'as' o apelido nao muda, so o caminho do import (std:arquivo -> std:file). O comentario com std:arquivo e arquivo.read_all fica como esta.
import "std:arquivo" as fs

proc main() {
    switch dados in fs.read_all("migrar_nao_existe.bin") {
    case [dynamic]u8:
        print("ok")
        print(len(dados))
        delete(dados)
    case fs.FileError:
        print("erro")
    }
}
