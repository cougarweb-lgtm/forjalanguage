// L3c: import "std:arquivo" e o qualificador arquivo. (formas antigas) valem em silencio; roda no cwd, o arquivo nao existe; a saida e a de ok_l3c_file_novo.fj.
import "std:arquivo"

proc descrever(erro: ?arquivo.FileError) -> str {
    var texto: str = "ok"
    switch e in erro {
    case arquivo.FileError:
        switch e {
        case arquivo.FileError.not_found:
            texto = "not_found"
        case arquivo.FileError.no_permission:
            texto = "no_permission"
        case arquivo.FileError.other:
            texto = "other"
        case arquivo.FileError.already_exists:
            texto = "already_exists"
        case arquivo.FileError.is_directory:
            texto = "is_directory"
        case arquivo.FileError.not_directory:
            texto = "not_directory"
        case arquivo.FileError.not_empty:
            texto = "not_empty"
        case arquivo.FileError.closed:
            texto = "closed"
        case arquivo.FileError.unsupported:
            texto = "unsupported"
        case arquivo.FileError.locked:
            texto = "locked"
        }
    case none:
        texto = "ok"
    }
    return texto
}

proc main() {
    switch dados in arquivo.read_all("l3c_nao_existe.bin") {
    case [dynamic]u8:
        print("ok")
        print(len(dados))
        delete(dados)
    case arquivo.FileError:
        print(descrever(dados))
        print(0)
    }
}
