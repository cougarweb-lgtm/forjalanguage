// L3c2: std:compressao pelo caminho ANTIGO (import vendor:compressao/compressao e qualificador compressao.); a saida e a de compression_novo.fj. Precisa de vendor\ ao lado.
import "vendor:compressao/compressao"

const TAMANHO: int = 512

proc preencher(buffer: []u8) {
    for i in 0..<len(buffer) {
        buffer[i] = ((i % 8) + 65) as u8
    }
}

proc principal() -> ! compressao.ErroZlib {
    var original: [512]u8 = {}
    preencher(original[..])
    var pequeno: [600]u8 = {}
    let comprimidos = try compressao.comprimir(original[..], destino = pequeno[..], nivel = 9)
    print(f"original {TAMANHO} bytes -> comprimido {comprimidos} bytes")

    var volta: [512]u8 = {}
    let restaurados = try compressao.descomprimir(pequeno[0..<(comprimidos as int)], destino = volta[..])
    print(f"restaurados {restaurados} bytes")

    var iguais = true
    for i in 0..<TAMANHO {
        if volta[i] != original[i] {
            iguais = false
        }
    }
    print(f"conteudo igual: {iguais}")
    print(f"crc32 original {compressao.crc(original[..], anterior = 0)} volta {compressao.crc(volta[..], anterior = 0)}")
}

proc main() {
    print(f"zlib {compressao.versao()}")
    switch r in principal() {
    case compressao.ErroZlib:
        print("erro inesperado")
    default:
        print("ok")
    }

    var original: [512]u8 = {}
    preencher(original[..])
    var minusculo: [4]u8 = {}
    switch r in compressao.comprimir(original[..], destino = minusculo[..], nivel = 6) {
    case i64:
        print("inesperado")
    case compressao.ErroZlib:
        print(f"erro tratado: destino pequeno demais ({r == compressao.ErroZlib.destino_pequeno})")
    }

    var lixo: [16]u8 = {}
    var saida: [64]u8 = {}
    switch r in compressao.descomprimir(lixo[..], destino = saida[..]) {
    case i64:
        print("inesperado")
    case compressao.ErroZlib:
        print(f"erro tratado: dados invalidos ({r == compressao.ErroZlib.dados_invalidos})")
    }
}
