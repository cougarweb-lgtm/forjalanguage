// B01d: chamada sem alloc dentro de defer, switch e or_else, e dentro de proc que ja tem alloc (recursao com alloc = alloc fica como esta; a chamada sem alloc ali recebe alloc = heap).
enum Erro { falhou }

proc soma(n: int, alloc: Allocator) -> int {
    var l = make([dynamic]int, alloc = alloc)
    append(&l, item = n)
    let r = l[0] + 1
    delete(l)
    return r
}

proc mostrar(n: int, alloc: Allocator) {
    print(soma(n, alloc = alloc))
}

proc achar(n: int, alloc: Allocator) -> int ! Erro {
    if n == 0 {
        return Erro.falhou
    }
    return soma(n, alloc = alloc)
}

proc contar(n: int, alloc: Allocator) -> int {
    if n == 0 {
        return 0
    }
    return soma(n) + contar(n - 1, alloc = alloc)
}

proc main() {
    defer mostrar(1)
    print(achar(0) or_else soma(40))
    print(achar(2) or_else 0)
    switch r in achar(3) {
    case int:
        print(soma(r))
    case Erro:
        print(0)
    }
    switch achar(0) {
    case Erro:
        print(contar(2))
    default:
        print(contar(3, alloc = heap))
    }
}
