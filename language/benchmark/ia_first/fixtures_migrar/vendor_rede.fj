// L3c2: pacote vendor\rede pelo caminho ANTIGO (import vendor:rede/rede e qualificador rede.; so check: nao usa a rede). O compilador le como vendor:net/net; o check e o de rede_novo.fj. Precisa de vendor\ ao lado.
import "vendor:rede/rede"

proc nome_do_erro(e: rede.ErroRede) -> str {
    if e == rede.ErroRede.url_invalida {
        return "url_invalida"
    }
    return "outro"
}

proc main() {
    print(f"libcurl: {rede.versao() as str} {nome_do_erro(rede.ErroRede.sem_resolver)}")
}
