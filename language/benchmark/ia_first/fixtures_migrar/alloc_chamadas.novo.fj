// B01d: o migrar insere ", alloc = heap" (ou "alloc = heap" sem argumentos) em toda chamada de proc com alloc: Allocator que nao o traz; o que ja tem alloc e o proc sem Allocator nao mudam.
struct Par {
    a: int
    b: int
}

proc soma(n: int, alloc: Allocator) -> int {
    var l = make([dynamic]int, alloc = alloc)
    append(&l, item = n)
    let r = l[0] + 1
    delete(l)
    return r
}

proc dois(a: int, b: int, alloc: Allocator) -> int {
    return soma(a, alloc = alloc) + soma(b, alloc = alloc)
}

proc nome(alloc: Allocator) -> str {
    return format(f"ola", alloc = alloc)
}

proc puro(n: int) -> int {
    return n * 2
}

proc main() {
    let t = nome(alloc = heap)
    print(t)
    delete(t)
    let u = nome (alloc = heap ) // zero argumentos, com espaco e comentario
    delete(u)
    print(soma(1, alloc = heap))
    print(dois(2, 3, alloc = heap))
    print(soma(soma(4, alloc = heap), alloc = heap))
    print(soma(5, alloc = heap))
    print(soma(6, alloc = frame))
    print(dois(7, 8, heap))
    print(puro(soma(9, alloc = heap)))
    print(soma(10, alloc = heap, ))
    let p = Par{
        a = soma(11, alloc = heap),
        b = dois(12, 13, alloc = heap),
    }
    print(p.a + p.b)
    frame_reset()
}
