// L3c2: pacote vendor\banco_servidor pelo caminho ANTIGO (so check: nao conecta a nada). O compilador le como vendor:db_server/...; o resultado do check e o de servidor_novo.fj. Precisa de vendor\ ao lado.
import "vendor:banco_servidor/mariadb" as my
import "vendor:banco_servidor/libpq" as pq

proc main() {
    print(f"mariadb {(my.mysql_get_client_version() as uint) > 0} libpq {pq.PQlibVersion() > 0}")
}
