// L3c: a forma antiga e a nova valem juntas, ate no mesmo programa: em com scope, alloc com escopo, para e to; a saida e a de ok_l3c_scope_novo.fj mais as linhas do transmute.
struct Grifo {
    vida: i32 = 5
}

proc main() {
    let g = new(Grifo, em = scope)
    let h = new(Grifo, alloc = escopo)
    print(g.vida as int + h.vida as int)
    let f: f32 = 1.5
    let a: u32 = transmute(f, to = u32)
    let b: u32 = transmute(f, para = u32)
    print(a as int)
    print(b as int)
}
