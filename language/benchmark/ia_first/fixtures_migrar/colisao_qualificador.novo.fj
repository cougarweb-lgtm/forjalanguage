// Migrar: 'file' ja e nome do usuario, entao std:arquivo -> std:file (e arquivo. -> file.) nao pode andar: estado revisao, o import e os usos ficam como estao.
// O resto do arquivo (em = heap -> alloc = heap) anda normalmente.
import "std:arquivo"

struct Grifo {
    vida: i32 = 5
}

proc main() {
    let file = 7
    let g = new(Grifo, alloc = heap)
    defer delete(g)
    switch dados in arquivo.read_all("migrar_nao_existe.bin", alloc = heap) {
    case [dynamic]u8:
        print("ok")
        delete(dados)
    case arquivo.FileError:
        print("erro")
    }
    print(file + g.vida as int)
}
