// L3c3: std:json pelos nomes ANTIGOS em portugues (abrir, fechar, campo, tamanho, ErroJson, TipoJson, nome =, bonito =...); a saida e a de ok_json_novo.fj (a forma antiga vira a nova na leitura). Precisa de vendor\ ao lado.
import "vendor:json/json"

proc nome_do_erro(e: json.JsonError) -> str {
    switch e {
    case json.JsonError.invalid:
        return "invalid"
    case json.JsonError.missing:
        return "missing"
    case json.JsonError.wrong_type:
        return "wrong_type"
    case json.JsonError.file:
        return "file"
    case json.JsonError.out_of_memory:
        return "out_of_memory"
    case json.JsonError.invalid_path:
        return "invalid_path"
    }
    return "?"
}

proc nome_do_tipo(k: json.JsonKind) -> str {
    switch k {
    case json.JsonKind.null:
        return "null"
    case json.JsonKind.boolean:
        return "boolean"
    case json.JsonKind.number:
        return "number"
    case json.JsonKind.text:
        return "text"
    case json.JsonKind.list:
        return "list"
    case json.JsonKind.object:
        return "object"
    case json.JsonKind.outro:
        return "outro"
    }
    return "?"
}

proc ler() -> ! json.JsonError {
    let doc = try json.parse("{\"nome\": \"leao\", \"vida\": 120, \"ativo\": true, \"peso\": 190.5, \"nada\": null, \"lista\": [1, 2, 3], \"pos\": {\"x\": 1.5}}")
    defer json.close(doc)
    print(f"tipo do doc {nome_do_tipo(json.kind(doc))} tamanho {json.size(doc)}")
    let tem = json.has_field(doc, name = "nome")
    let nao_tem = json.has_field(doc, name = "zzz")
    print(f"tem nome {tem} tem zzz {nao_tem}")
    let texto = try json.field_text(doc, name = "nome")
    let inteiro = try json.field_int(doc, name = "vida")
    let flag = try json.field_bool(doc, name = "ativo")
    let real = try json.field_number(doc, name = "peso")
    print(f"{texto} {inteiro} {flag} {real as int}")
    let vida = try json.field(doc, name = "vida")
    let vida_i = try json.integer(vida)
    let vida_n = try json.number(vida)
    print(f"vida: {nome_do_tipo(json.kind(vida))} inteiro {vida_i} numero {vida_n as int}")
    let ativo = try json.field(doc, name = "ativo")
    let ativo_b = try json.boolean(ativo)
    print(f"ativo: {nome_do_tipo(json.kind(ativo))} {ativo_b}")
    let nome = try json.field(doc, name = "nome")
    let nome_t = try json.text(nome)
    print(f"nome: {nome_do_tipo(json.kind(nome))} {nome_t}")
    let nada = try json.field(doc, name = "nada")
    print(f"nada: {nome_do_tipo(json.kind(nada))}")
    let lista = try json.field(doc, name = "lista")
    let item1 = try json.item(lista, index = 1)
    let item1_i = try json.integer(item1)
    print(f"lista: {nome_do_tipo(json.kind(lista))} tamanho {json.size(lista)} item1 {item1_i}")
    let pos = try json.field(doc, name = "pos")
    let chave0 = try json.key(pos, index = 0)
    print(f"pos: {nome_do_tipo(json.kind(pos))} chave0 {chave0}")
}

proc escrever() -> ! json.JsonError {
    let saida = try json.new_object()
    defer json.close(saida)
    try json.set_text(saida, name = "modelo", value = "aguia")
    try json.set_number(saida, name = "total", value = 3.0)
    try json.set_bool(saida, name = "ok", value = true)
    try json.set_null(saida, name = "extra")
    let nomes = try json.set_list(saida, name = "nomes")
    try json.push_text(nomes, value = "a")
    try json.push_number(nomes, value = 2.0)
    let filho = try json.push_object(nomes)
    try json.set_number(filho, name = "n", value = 7.0)
    let outro = try json.set_object(saida, name = "filho")
    try json.set_bool(outro, name = "f", value = false)
    let raiz = try json.new_list()
    defer json.close(raiz)
    try json.push_text(raiz, value = "z")
    let compacto = try json.dump(saida, pretty = false)
    defer delete(compacto)
    print(compacto)
    let bonito = try json.dump(raiz, pretty = true)
    defer delete(bonito)
    print(bonito)
}

proc erros() {
    switch r in json.parse("{") {
    case json.Json:
        print("inesperado")
    case json.JsonError:
        print(f"parse: {nome_do_erro(r)} {r == json.JsonError.invalid}")
    }
    switch r in json.parse_str(text = "[1,") {
    case json.Json:
        print("inesperado")
    case json.JsonError:
        print(f"parse_str: {nome_do_erro(r)}")
    }
    switch r in json.parse_file(path = "arquivo_que_nao_existe.json") {
    case json.Json:
        print("inesperado")
    case json.JsonError:
        print(f"parse_file: {nome_do_erro(r)} {r == json.JsonError.file}")
    }
    let doc = json.parse_str("{\"a\": 1}") or_else json.Json{no = none, dono = false}
    defer json.close(doc)
    switch r in json.field(doc, name = "b") {
    case json.Json:
        print("inesperado")
    case json.JsonError:
        print(f"field: {nome_do_erro(r)} {r == json.JsonError.missing}")
    }
    switch r in json.field_text(doc, name = "a") {
    case str:
        print("inesperado")
    case json.JsonError:
        print(f"field_text: {nome_do_erro(r)} {r == json.JsonError.wrong_type}")
    }
    switch r in json.set_text(doc, name = "k", value = "v") {
    case json.JsonError:
        print("set_text falhou")
    default:
        print("set_text ok")
    }
    print(nome_do_erro(json.JsonError.out_of_memory))
}

proc main() {
    switch r in ler() {
    case json.JsonError:
        print(f"ler: {nome_do_erro(r)}")
    default:
        print("ler ok")
    }
    switch r in escrever() {
    case json.JsonError:
        print(f"escrever: {nome_do_erro(r)}")
    default:
        print("escrever ok")
    }
    erros()
}
