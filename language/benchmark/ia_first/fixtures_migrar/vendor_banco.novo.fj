// L3c: vendor:banco com as formas ANTIGAS (banco.abrir, banco.executar, banco.ErroBanco): valem em silencio e a saida e a de banco_novo.fj. Precisa de vendor\ ao lado.
import "vendor:db/db"

proc principal(bd: db.Db) -> ! db.DbError {
    try db.exec(bd, sql = "CREATE TABLE t(id INTEGER PRIMARY KEY, nome TEXT)")
    try db.exec(bd, sql = "INSERT INTO t(nome) VALUES ('a')")
}

proc main() {
    switch aberto in db.open(":memory:") {
    case db.Db:
        switch r in principal(aberto) {
        case db.DbError:
            print("erro inesperado")
        default:
            print("ok")
        }
        switch r in db.exec(aberto, sql = "SELEC 1") {
        case db.DbError:
            print("erro tratado")
        default:
            print("inesperado")
        }
        db.close(aberto)
    case db.DbError:
        print("nao abriu")
    }
}
