// L3c: o rotulo em (forma antiga de alloc) em new, make, format e format_c, com heap e frame; vale em silencio e a saida e a de ok_l3c_alloc_novo.fj.
struct Grifo {
    vida: i32 = 5
}

proc main() {
    let g = new(Grifo, em = heap)
    defer delete(g)
    print(g.vida as int)
    var l = make([dynamic]int, em = heap, cap = 2)
    defer delete(l)
    append(&l, item = 7)
    print(l[0])
    let s = format(f"n={len(l)}", em = heap)
    defer delete(s)
    print(s)
    let c = format_c(f"c{len(l)}", em = heap)
    defer delete(c)
    print(c)
    let t = new(int, em = frame)
    t^ = 9
    print(t^)
    frame_reset()
}
