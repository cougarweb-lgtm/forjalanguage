// prog.fj 0.1.0 (11/11/2026) - ponto de entrada do projeto P do benchmark IA FIRST (conjunto P). Cola minima: chama um proc de cada modulo.
// Os modulos vieram de engine\forja (motor\), language\vendor (vendor\) e language\exemplos_libs (demos\), sem mudar a logica deles.
// Verificar: forja check prog.fj  &&  forja run prog.fj  &&  forja test teste_mundo.fj
import "motor/mundo" as mundo
import "motor/mundo_tick" as tick
import "motor/camera" as cam
import "demos/json_demo" as json_demo
import "demos/fisica2d_demo" as fisica_demo
import "demos/compressao_demo" as compressao_demo
import "vendor:json/json"
import "vendor:gltf/cgltf" as gl

proc simular_mundo() {
    var m = mundo.mundo_novo(4)
    defer mundo.mundo_destruir(&m)
    let a = mundo.mundo_criar(&m, tipo = mundo.TipoEntidade.ator)
    let p = mundo.mundo_criar(&m, tipo = mundo.TipoEntidade.projetil)
    print(f"entidades vivas={mundo.mundo_contar(&m)} atores={mundo.mundo_contar_tipo(&m, tipo = mundo.TipoEntidade.ator)}")
    print(f"projetil vivo={mundo.mundo_viva(&m, e = p)} ator vivo={mundo.mundo_viva(&m, e = a)}")
    let tile = mundo.tile_de_posicao({1.0, 0.25, 0.5}, nivel = 2)
    print(f"tile face={tile.face} nivel={tile.nivel}")
}

proc simular_tempo() {
    var r = tick.relogio_novo()
    let ticks = tick.relogio_acumular(&r, dt_ns = 50000000)
    print(f"ticks={ticks} hz={tick.TICK_HZ} teto={tick.TICK_MAX_POR_QUADRO}")
    print(f"quadro da camera em bytes={cam.CAM_BYTES_QUADRO}")
}

proc conferir_gltf() {
    let r = gl.CgltfResult.success
    print(f"cgltf sucesso={r == gl.CgltfResult.success}")
}

proc main() -> ! json.JsonError {
    simular_mundo()
    simular_tempo()
    conferir_gltf()
    compressao_demo.demo_compressao()
    fisica_demo.demo_fisica2d()
    try json_demo.demo_json()
}
