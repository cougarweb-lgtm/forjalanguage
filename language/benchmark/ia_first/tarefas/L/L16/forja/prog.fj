proc contar_bits(n: u32) -> int {
    var x = n
    var c = 0
    while x != 0 {
        c += (x & 1) as int
        x = x >> 1
    }
    return c
}

proc main() {
    print(contar_bits(0xB7))
    print(contar_bits(255))
    let m: u32 = 0xF0
    print(((m >> 4) & 0x3) as int)
    print((m | 0x0F) as int)
}
