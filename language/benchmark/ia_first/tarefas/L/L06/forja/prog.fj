enum Estado { parado, andando, correndo }

proc velocidade(e: Estado) -> int {
    switch e {
    case Estado.parado:
        return 0
    case Estado.andando:
        return 5
    case Estado.correndo:
        return 12
    }
    return -1
}

proc proximo(e: Estado) -> Estado {
    switch e {
    case Estado.parado:
        return Estado.andando
    case Estado.andando:
        return Estado.correndo
    case Estado.correndo:
        return Estado.parado
    }
    return Estado.parado
}

proc main() {
    var e = Estado.parado
    var total = 0
    for i in 0..<5 {
        let v = velocidade(e)
        print(v)
        total += v
        e = proximo(e)
    }
    print(total)
}
