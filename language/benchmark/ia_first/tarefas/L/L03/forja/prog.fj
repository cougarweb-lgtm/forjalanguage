struct Ponto {
    x: int = 0
    y: int = 0
}

proc mover_copia(p: Ponto) -> int {
    var q = p
    q.x += 20
    return q.x
}

proc mover(p: ^Ponto) {
    p.x += 5
}

proc main() {
    var a = Ponto{x = 1, y = 2}
    let r = mover_copia(a)
    mover(&a)
    mover(&a)
    print(r)
    print(a.x)
    print(a.y)
}
