pub struct GzHeaderS {
    text: i32
    time: u32
    xflags: i32
    os: i32
    extra: ?^u8
    extra_len: u32
    extra_max: u32
    name: ?^u8
    name_max: u32
    comment: ?^u8
    comm_max: u32
    hcrc: i32
    done: i32
}

pub struct GzFileS {
    have: u32
    next: ?^u8
    pos: i64
}

