    parent: ?^CgltfNode
    children: ?^?^CgltfNode
    children_count: u64
    skin: ?^CgltfSkin
    mesh: ?^CgltfMesh
    camera: ?^CgltfCamera
    light: ?^CgltfLight
    weights: ?^f32
    weights_count: u64
    has_translation: i32
    has_rotation: i32
    has_scale: i32
    has_matrix: i32
    translation: [3]f32
    rotation: [4]f32
    scale: [3]f32
    matrix: [16]f32
    extras: CgltfExtras
    has_mesh_gpu_instancing: i32
    mesh_gpu_instancing: CgltfMeshGpuInstancing
