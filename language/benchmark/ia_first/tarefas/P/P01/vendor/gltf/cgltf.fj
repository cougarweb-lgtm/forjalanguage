}

pub struct CgltfCameraOrthographic {
    xmag: f32
    ymag: f32
    zfar: f32
    znear: f32
    extras: CgltfExtras
}

pub struct CgltfCameraData {
    armazenamento: [6]u64
}

pub struct CgltfCamera {
    name: rawptr
    type: CgltfCameraType
