    attenuation_distance: f32
}

pub struct CgltfSheen {
    sheen_color_texture: CgltfTextureView
    sheen_color_factor: [3]f32
    sheen_roughness_texture: CgltfTextureView
    sheen_roughness_factor: f32
}

