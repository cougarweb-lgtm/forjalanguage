    extras: CgltfExtras
    extensions_count: u64
    extensions: ?^CgltfExtension
}

pub struct CgltfMaterialVariant {
    name: rawptr
    extras: CgltfExtras
}

pub struct CgltfAsset {
    copyright: rawptr
    generator: rawptr
    version: rawptr
    min_version: rawptr
    extras: CgltfExtras
    extensions_count: u64
    extensions: ?^CgltfExtension
}

pub struct CgltfData {
    file_type: CgltfFileType
    file_data: rawptr
    asset: CgltfAsset
    meshes: ?^CgltfMesh
    meshes_count: u64
    materials: ?^CgltfMaterial
    materials_count: u64
    accessors: ?^CgltfAccessor
    accessors_count: u64
    buffer_views: ?^CgltfBufferView
    buffer_views_count: u64
    buffers: ?^CgltfBuffer
    buffers_count: u64
    images: ?^CgltfImage
    images_count: u64
    textures: ?^CgltfTexture
    textures_count: u64
    samplers: ?^CgltfSampler
    samplers_count: u64
    skins: ?^CgltfSkin
    skins_count: u64
    cameras: ?^CgltfCamera
    cameras_count: u64
    lights: ?^CgltfLight
    lights_count: u64
    nodes: ?^CgltfNode
    nodes_count: u64
    scenes: ?^CgltfScene
    scenes_count: u64
    scene: ?^CgltfScene
    animations: ?^CgltfAnimation
    animations_count: u64
    variants: ?^CgltfMaterialVariant
    variants_count: u64
    extras: CgltfExtras
    data_extensions_count: u64
    data_extensions: ?^CgltfExtension
    extensions_used: ?^?^i8
    extensions_used_count: u64
    extensions_required: ?^?^i8
    extensions_required_count: u64
    json: rawptr
    json_size: u64
    bin: rawptr
    bin_size: u64
    memory: CgltfMemoryOptions
    file: CgltfFileOptions
}

pub foreign {
    link "cgltf"
    proc cgltf_parse(options: ?^CgltfOptions, data: rawptr, size: u64, out_data: ?^?^CgltfData) -> CgltfResult
    proc cgltf_parse_file(options: ?^CgltfOptions, path: cstr, out_data: ?^?^CgltfData) -> CgltfResult
    proc cgltf_load_buffers(options: ?^CgltfOptions, data: ?^CgltfData, gltf_path: cstr) -> CgltfResult
    proc cgltf_load_buffer_base64(options: ?^CgltfOptions, size: u64, base64: cstr, out_data: ?^rawptr) -> CgltfResult
    proc cgltf_decode_string(string: ?^i8) -> u64
    proc cgltf_decode_uri(uri: ?^i8) -> u64
    proc cgltf_validate(data: ?^CgltfData) -> CgltfResult
    proc cgltf_free(data: ?^CgltfData)
    proc cgltf_node_transform_local(node: ?^CgltfNode, out_matrix: ?^f32)
    proc cgltf_node_transform_world(node: ?^CgltfNode, out_matrix: ?^f32)
    proc cgltf_buffer_view_data(view: ?^CgltfBufferView) -> ?^u8
    proc cgltf_find_accessor(prim: ?^CgltfPrimitive, type: CgltfAttributeType, index: i32) -> ?^CgltfAccessor
    proc cgltf_accessor_read_float(accessor: ?^CgltfAccessor, index: u64, out: ?^f32, element_size: u64) -> i32
    proc cgltf_accessor_read_uint(accessor: ?^CgltfAccessor, index: u64, out: ?^u32, element_size: u64) -> i32
    proc cgltf_accessor_read_index(accessor: ?^CgltfAccessor, index: u64) -> u64
    proc cgltf_num_components(type: CgltfType) -> u64
    proc cgltf_component_size(component_type: CgltfComponentType) -> u64
    proc cgltf_calc_size(type: CgltfType, component_type: CgltfComponentType) -> u64
    proc cgltf_accessor_unpack_floats(accessor: ?^CgltfAccessor, out: ?^f32, float_count: u64) -> u64
    proc cgltf_accessor_unpack_indices(accessor: ?^CgltfAccessor, out: rawptr, out_component_size: u64, index_count: u64) -> u64
    proc cgltf_copy_extras_json(data: ?^CgltfData, extras: ?^CgltfExtras, dest: ?^i8, dest_size: ?^u64) -> CgltfResult
    proc cgltf_mesh_index(data: ?^CgltfData, object: ?^CgltfMesh) -> u64
    proc cgltf_material_index(data: ?^CgltfData, object: ?^CgltfMaterial) -> u64
    proc cgltf_accessor_index(data: ?^CgltfData, object: ?^CgltfAccessor) -> u64
    proc cgltf_buffer_view_index(data: ?^CgltfData, object: ?^CgltfBufferView) -> u64
    proc cgltf_buffer_index(data: ?^CgltfData, object: ?^CgltfBuffer) -> u64
    proc cgltf_image_index(data: ?^CgltfData, object: ?^CgltfImage) -> u64
    proc cgltf_texture_index(data: ?^CgltfData, object: ?^CgltfTexture) -> u64
    proc cgltf_sampler_index(data: ?^CgltfData, object: ?^CgltfSampler) -> u64
    proc cgltf_skin_index(data: ?^CgltfData, object: ?^CgltfSkin) -> u64
    proc cgltf_camera_index(data: ?^CgltfData, object: ?^CgltfCamera) -> u64
    proc cgltf_light_index(data: ?^CgltfData, object: ?^CgltfLight) -> u64
    proc cgltf_node_index(data: ?^CgltfData, object: ?^CgltfNode) -> u64
    proc cgltf_scene_index(data: ?^CgltfData, object: ?^CgltfScene) -> u64
    proc cgltf_animation_index(data: ?^CgltfData, object: ?^CgltfAnimation) -> u64
    proc cgltf_animation_sampler_index(animation: ?^CgltfAnimation, object: ?^CgltfAnimationSampler) -> u64
    proc cgltf_animation_channel_index(animation: ?^CgltfAnimation, object: ?^CgltfAnimationChannel) -> u64
}

pub proc cgltf_camera_data_perspective(u: ^CgltfCameraData) -> ^CgltfCameraPerspective {
    return (u as rawptr) as ^CgltfCameraPerspective
}

pub proc cgltf_camera_data_orthographic(u: ^CgltfCameraData) -> ^CgltfCameraOrthographic {
    return (u as rawptr) as ^CgltfCameraOrthographic
}
