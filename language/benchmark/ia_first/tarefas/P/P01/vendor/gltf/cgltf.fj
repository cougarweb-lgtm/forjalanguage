// gerados: 106 (procs 37, tipos 67, consts 0, acessos 2); recusados: 0

pub enum CgltfFileType {
    invalid
    gltf
    glb
    max_enum
}

pub enum CgltfResult {
    success
    data_too_short
    unknown_format
    invalid_json
    invalid_gltf
    invalid_options
    file_not_found
    io_error
    out_of_memory
    legacy_gltf
    max_enum
}

pub enum CgltfBufferViewType {
    invalid
    indices
    vertices
    max_enum
}

pub enum CgltfAttributeType {
    invalid
    position
    normal
    tangent
    texcoord
    color
    joints
    weights
    custom
    max_enum
}

pub enum CgltfComponentType {
    invalid
    r_8
    r_8u
    r_16
    r_16u
    r_32u
    r_32f
    max_enum
}

pub enum CgltfType {
    invalid
    scalar
    vec2
    vec3
    vec4
    mat2
    mat3
    mat4
    max_enum
}

pub enum CgltfPrimitiveType {
    invalid
    points
    lines
    line_loop
    line_strip
    triangles
    triangle_strip
    triangle_fan
    max_enum
}

pub enum CgltfAlphaMode {
    opaque
    mask
    blend
    max_enum
}

pub enum CgltfAnimationPathType {
    invalid
    translation
    rotation
    scale
    weights
    max_enum
}

pub enum CgltfInterpolationType {
    linear
    step
    cubic_spline
    max_enum
}

pub enum CgltfCameraType {
    invalid
    perspective
    orthographic
    max_enum
}

pub enum CgltfLightType {
    invalid
    directional
    point
    spot
    max_enum
}

pub enum CgltfDataFreeMethod {
    cgltf_data_free_method_none
    cgltf_data_free_method_file_release
    cgltf_data_free_method_memory_free
    cgltf_data_free_method_max_enum
}

pub enum CgltfMeshoptCompressionMode {
    invalid
    attributes
    triangles
    indices
    max_enum
}

pub enum CgltfMeshoptCompressionFilter {
    cgltf_meshopt_compression_filter_none
    cgltf_meshopt_compression_filter_octahedral
    cgltf_meshopt_compression_filter_quaternion
    cgltf_meshopt_compression_filter_exponential
    cgltf_meshopt_compression_filter_max_enum
}

pub enum CgltfFilterType {
    undefined = 0
    nearest = 9728
    linear = 9729
    nearest_mipmap_nearest = 9984
    linear_mipmap_nearest = 9985
    nearest_mipmap_linear = 9986
    linear_mipmap_linear = 9987
}

pub enum CgltfWrapMode {
    clamp_to_edge = 33071
    mirrored_repeat = 33648
    repeat = 10497
}

pub struct CgltfMemoryOptions {
    alloc_func: rawptr
    free_func: rawptr
    user_data: rawptr
}

pub struct CgltfFileOptions {
    read: rawptr
    release: rawptr
    user_data: rawptr
}

pub struct CgltfOptions {
    type: CgltfFileType
    json_token_count: u64
    memory: CgltfMemoryOptions
    file: CgltfFileOptions
}

pub struct CgltfExtras {
    start_offset: u64
    end_offset: u64
    data: rawptr
}

pub struct CgltfExtension {
    name: rawptr
    data: rawptr
}

pub struct CgltfBuffer {
    name: rawptr
    size: u64
    uri: rawptr
    data: rawptr
    data_free_method: CgltfDataFreeMethod
    extras: CgltfExtras
    extensions_count: u64
    extensions: ?^CgltfExtension
}

pub struct CgltfMeshoptCompression {
    buffer: ?^CgltfBuffer
    offset: u64
    size: u64
    stride: u64
    count: u64
    mode: CgltfMeshoptCompressionMode
    filter: CgltfMeshoptCompressionFilter
}

pub struct CgltfBufferView {
    name: rawptr
    buffer: ?^CgltfBuffer
    offset: u64
    size: u64
    stride: u64
    type: CgltfBufferViewType
    data: rawptr
    has_meshopt_compression: i32
    meshopt_compression: CgltfMeshoptCompression
    extras: CgltfExtras
    extensions_count: u64
    extensions: ?^CgltfExtension
}

pub struct CgltfAccessorSparse {
    count: u64
    indices_buffer_view: ?^CgltfBufferView
    indices_byte_offset: u64
    indices_component_type: CgltfComponentType
    values_buffer_view: ?^CgltfBufferView
    values_byte_offset: u64
}

pub struct CgltfAccessor {
    name: rawptr
    component_type: CgltfComponentType
    normalized: i32
    type: CgltfType
    offset: u64
    count: u64
    stride: u64
    buffer_view: ?^CgltfBufferView
    has_min: i32
    min: [16]f32
    has_max: i32
    max: [16]f32
    is_sparse: i32
    sparse: CgltfAccessorSparse
    extras: CgltfExtras
    extensions_count: u64
    extensions: ?^CgltfExtension
}

pub struct CgltfAttribute {
    name: rawptr
    type: CgltfAttributeType
    index: i32
    data: ?^CgltfAccessor
}

pub struct CgltfImage {
    name: rawptr
    uri: rawptr
    buffer_view: ?^CgltfBufferView
    mime_type: rawptr
    extras: CgltfExtras
    extensions_count: u64
    extensions: ?^CgltfExtension
}

pub struct CgltfSampler {
    name: rawptr
    mag_filter: CgltfFilterType
    min_filter: CgltfFilterType
    wrap_s: CgltfWrapMode
    wrap_t: CgltfWrapMode
    extras: CgltfExtras
    extensions_count: u64
    extensions: ?^CgltfExtension
}

pub struct CgltfTexture {
    name: rawptr
    image: ?^CgltfImage
    sampler: ?^CgltfSampler
    has_basisu: i32
    basisu_image: ?^CgltfImage
    has_webp: i32
    webp_image: ?^CgltfImage
    extras: CgltfExtras
    extensions_count: u64
    extensions: ?^CgltfExtension
}

pub struct CgltfTextureTransform {
    offset: [2]f32
    rotation: f32
    scale: [2]f32
    has_texcoord: i32
    texcoord: i32
}

pub struct CgltfTextureView {
    texture: ?^CgltfTexture
    texcoord: i32
    scale: f32
    has_transform: i32
    transform: CgltfTextureTransform
}

