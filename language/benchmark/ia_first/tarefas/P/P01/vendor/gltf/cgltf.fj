    iridescence_factor: f32
    iridescence_texture: CgltfTextureView
    iridescence_ior: f32
    iridescence_thickness_min: f32
    iridescence_thickness_max: f32
    iridescence_thickness_texture: CgltfTextureView
}

pub struct CgltfDiffuseTransmission {
    diffuse_transmission_texture: CgltfTextureView
    diffuse_transmission_factor: f32
    diffuse_transmission_color_factor: [3]f32
    diffuse_transmission_color_texture: CgltfTextureView
}

pub struct CgltfAnisotropy {
    anisotropy_strength: f32
    anisotropy_rotation: f32
    anisotropy_texture: CgltfTextureView
}

pub struct CgltfDispersion {
    dispersion: f32
}

pub struct CgltfMaterial {
    name: rawptr
    has_pbr_metallic_roughness: i32
    has_pbr_specular_glossiness: i32
    has_clearcoat: i32
    has_transmission: i32
    has_volume: i32
    has_ior: i32
    has_specular: i32
    has_sheen: i32
    has_emissive_strength: i32
    has_iridescence: i32
    has_diffuse_transmission: i32
    has_anisotropy: i32
    has_dispersion: i32
    pbr_metallic_roughness: CgltfPbrMetallicRoughness
    pbr_specular_glossiness: CgltfPbrSpecularGlossiness
    clearcoat: CgltfClearcoat
    ior: CgltfIor
    specular: CgltfSpecular
    sheen: CgltfSheen
    transmission: CgltfTransmission
    volume: CgltfVolume
    emissive_strength: CgltfEmissiveStrength
    iridescence: CgltfIridescence
    diffuse_transmission: CgltfDiffuseTransmission
    anisotropy: CgltfAnisotropy
    dispersion: CgltfDispersion
    normal_texture: CgltfTextureView
    occlusion_texture: CgltfTextureView
    emissive_texture: CgltfTextureView
    emissive_factor: [3]f32
    alpha_mode: CgltfAlphaMode
    alpha_cutoff: f32
    double_sided: i32
    unlit: i32
    extras: CgltfExtras
    extensions_count: u64
    extensions: ?^CgltfExtension
}

