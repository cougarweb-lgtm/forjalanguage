// teste_interpolacao.fj 0.1.0 (10/11/2026) - testes de unidade do M0-c: colunas transf_a/transf_b, interpolacao (lerp de pos/escala, nlerp de rot), relogio_alfa e entidade vencida.
// Roda por `forja test` (sem janela nem GPU). O proc main so existe porque o forja test exige um programa.
// Changelog: 0.1.0 - M0-c da trilha M0 (engine:mundo).
// Verificar: $env:FORJA_ENGINE='C:\ENGINE_GAME3D\engine'; & "$env:TEMP\forja_f2_fim\forja.exe" test C:\ENGINE_GAME3D\testes_mundo\teste_interpolacao.fj
import "motor/mundo" as mundo
import "motor/mundo_tick" as tick

const TI_TOL: f32 = 0.000001
const TI_SEN_45: f32 = 0.70710678
const TI_SEN_22: f32 = 0.38268343
const TI_COS_22: f32 = 0.92387953

proc main() {
    print(0)
}

proc perto(a: f32, b: f32) -> bool {
    return abs(a - b) <= TI_TOL
}

proc quat_perto(a: quat, b: quat) -> bool {
    return perto(a.x, b = b.x) and perto(a.y, b = b.y) and perto(a.z, b = b.z) and perto(a.w, b = b.w)
}

proc quat_unitario(q: quat) -> bool {
    return perto(sqrt(q.x * q.x + q.y * q.y + q.z * q.z + q.w * q.w), b = 1.0)
}

// Rotacao de 90 graus em Y.
proc giro_y90() -> quat {
    return quat{y = TI_SEN_45, w = TI_SEN_45}
}

proc transf(pos: [3]f64, rot: quat, escala: [3]f32) -> mundo.Transformacao {
    return mundo.Transformacao{pos = pos, rot = rot, escala = escala}
}

// A = identidade com pos {0,0,0}, escala 1; B = pos {10,20,-30}, giro_y90, escala {3,5,7}.
proc par_ab() -> (a: mundo.Transformacao, b: mundo.Transformacao) {
    let a = mundo.transformacao_identidade()
    let b = transf({10.0, 20.0, -30.0}, rot = giro_y90(), escala = {3.0, 5.0, 7.0})
    return a, b
}

test "interpolacao: alfa 0 e 1 devolvem A e B, alfa 0.5 o meio (pos e escala exatos)" {
    let a, b = par_ab()
    let t0 = mundo.transformacao_lerp(a, b = b, alfa = 0.0)
    let t1 = mundo.transformacao_lerp(a, b = b, alfa = 1.0)
    let tm = mundo.transformacao_lerp(a, b = b, alfa = 0.5)
    expect(t0.pos[0] == 0.0 and t0.pos[1] == 0.0 and t0.pos[2] == 0.0)
    expect(t1.pos[0] == 10.0 and t1.pos[1] == 20.0 and t1.pos[2] == -30.0)
    expect(tm.pos[0] == 5.0 and tm.pos[1] == 10.0 and tm.pos[2] == -15.0)
    expect(t0.escala[0] == 1.0 and t1.escala[2] == 7.0)
    expect(tm.escala[0] == 2.0 and tm.escala[1] == 3.0 and tm.escala[2] == 4.0)
}

test "interpolacao: nlerp da rotacao, resultado unitario e 45 graus no meio" {
    let a, b = par_ab()
    let r0 = mundo.transformacao_lerp(a, b = b, alfa = 0.0).rot
    let r1 = mundo.transformacao_lerp(a, b = b, alfa = 1.0).rot
    let rm = mundo.transformacao_lerp(a, b = b, alfa = 0.5).rot
    expect(quat_perto(r0, b = a.rot) and quat_perto(r1, b = b.rot))
    expect(quat_perto(rm, b = quat{y = TI_SEN_22, w = TI_COS_22}))
    expect(quat_unitario(r0) and quat_unitario(r1) and quat_unitario(rm))
}

test "interpolacao: caminho curto (b e -b dao a mesma rotacao) e quat nao unitario sai unitario" {
    let a = mundo.transformacao_identidade()
    let b1 = transf({0.0, 0.0, 0.0}, rot = giro_y90(), escala = {1.0, 1.0, 1.0})
    let b2 = transf({0.0, 0.0, 0.0}, rot = -giro_y90(), escala = {1.0, 1.0, 1.0})
    let r1 = mundo.transformacao_lerp(a, b = b1, alfa = 0.3).rot
    let r2 = mundo.transformacao_lerp(a, b = b2, alfa = 0.3).rot
    expect(quat_perto(r1, b = r2))
    let c = transf({0.0, 0.0, 0.0}, rot = quat{y = 3.0, w = 4.0}, escala = {1.0, 1.0, 1.0})
    expect(quat_unitario(mundo.transformacao_lerp(a, b = c, alfa = 0.7).rot))
    expect(quat_unitario(mundo.rotacao_normalizar(quat{x = 1.0, y = 2.0, z = 3.0, w = 4.0})))
    expect(quat_perto(mundo.rotacao_normalizar(quat{}), b = quat{w = 1.0}))
}

test "interpolacao: alfa fora de [0, 1] e preso" {
    let a, b = par_ab()
    let abaixo = mundo.transformacao_lerp(a, b = b, alfa = -0.5)
    let acima = mundo.transformacao_lerp(a, b = b, alfa = 1.5)
    expect(abaixo.pos[0] == 0.0 and acima.pos[0] == 10.0)
}

test "colunas A/B: criada e A = B = identidade; definir grava os dois; avancar empurra B para A" {
    var m = mundo.mundo_novo(4)
    defer mundo.mundo_destruir(&m)
    let e = mundo.mundo_criar(&m, tipo = mundo.TipoEntidade.ator)
    let nasc = mundo.mundo_transf(&m, e = e) or_else transf({9.0, 9.0, 9.0}, rot = quat{}, escala = {0.0, 0.0, 0.0})
    expect(nasc.pos[0] == 0.0 and nasc.escala[1] == 1.0 and nasc.rot.w == 1.0)
    let t1 = transf({1.0, 2.0, 3.0}, rot = giro_y90(), escala = {2.0, 2.0, 2.0})
    let t2 = transf({4.0, 5.0, 6.0}, rot = quat{w = 1.0}, escala = {1.0, 1.0, 1.0})
    expect(mundo.mundo_definir_transf(&m, e = e, t = t1) or_else false)
    expect((mundo.mundo_transf_anterior(&m, e = e) or_else t2).pos[0] == 1.0)
    expect((mundo.mundo_transf(&m, e = e) or_else t2).pos[0] == 1.0)
    expect(mundo.mundo_avancar_transf(&m, e = e, t = t2) or_else false)
    expect((mundo.mundo_transf_anterior(&m, e = e) or_else t2).pos[2] == 3.0)
    expect((mundo.mundo_transf(&m, e = e) or_else t1).pos[2] == 6.0)
    let meio = mundo.mundo_interpolar(&m, e = e, alfa = 0.5) or_else t1
    expect(meio.pos[0] == 2.5 and meio.pos[1] == 3.5 and meio.pos[2] == 4.5)
}

test "colunas A/B acompanham a remocao por troca com a ultima linha" {
    var m = mundo.mundo_novo(4)
    defer mundo.mundo_destruir(&m)
    let e0 = mundo.mundo_criar(&m, tipo = mundo.TipoEntidade.ator)
    let e1 = mundo.mundo_criar(&m, tipo = mundo.TipoEntidade.ator)
    let e2 = mundo.mundo_criar(&m, tipo = mundo.TipoEntidade.ator)
    let base = mundo.transformacao_identidade()
    let tb = transf({7.0, 0.0, 0.0}, rot = quat{w = 1.0}, escala = {1.0, 1.0, 1.0})
    expect(mundo.mundo_definir_transf(&m, e = e2, t = base) or_else false)
    expect(mundo.mundo_avancar_transf(&m, e = e2, t = tb) or_else false)
    expect(mundo.mundo_remover(&m, e = e0) or_else false)
    let meio = mundo.mundo_interpolar(&m, e = e2, alfa = 0.5) or_else base
    expect(meio.pos[0] == 3.5)
    expect((mundo.mundo_transf(&m, e = e1) or_else tb).pos[0] == 0.0)
    expect((mundo.mundo_transf_anterior(&m, e = e2) or_else tb).pos[0] == 0.0)
}

test "entidade vencida ou desconhecida = erro em mundo_interpolar e nas colunas" {
    var m = mundo.mundo_novo(4)
    defer mundo.mundo_destruir(&m)
    let e = mundo.mundo_criar(&m, tipo = mundo.TipoEntidade.projetil)
    expect(mundo.mundo_remover(&m, e = e) or_else false)
    var codigo = 0
    switch r in mundo.mundo_interpolar(&m, e = e, alfa = 0.5) {
        case mundo.Transformacao:
            codigo = 9
        case mundo.ErroMundo:
            codigo = 1
            if r == mundo.ErroMundo.vencida {
                codigo = 2
            }
    }
    expect(codigo == 2)
    let ausente = mundo.Entidade{indice = 77, geracao = 1}
    codigo = 0
    switch r in mundo.mundo_interpolar(&m, e = ausente, alfa = 0.5) {
        case mundo.Transformacao:
            codigo = 9
        case mundo.ErroMundo:
            codigo = 1
            if r == mundo.ErroMundo.desconhecida {
                codigo = 3
            }
    }
    expect(codigo == 3)
}

test "relogio_alfa: fracao de tick que sobrou, em [0, 1)" {
    var r = tick.relogio_novo()
    expect(tick.relogio_alfa(&r) == 0.0)
    let n = tick.relogio_acumular(&r, dt_ns = 25000000)
    expect(n == 1)
    let alfa = tick.relogio_alfa(&r)
    expect(alfa > 0.499999 and alfa < 0.500001)
    let m = tick.relogio_acumular(&r, dt_ns = 16666666)
    expect(m == 0 or m == 1)
    expect(tick.relogio_alfa(&r) >= 0.0 and tick.relogio_alfa(&r) < 1.0)
}
