{
  "versao": "0.2.0",
  "conferido_em": "2026-11-11 (a07; nada instalado; ausencia de opcional = linguagem pulada com motivo)",
  "limite_segundos": 10,
  "limite_build_segundos": 60,
  "saida_max_bytes": 65536,
  "nota": "Placeholders dos comandos: {forja} exe do compilador (--forja ou IA_FIRST_FORJA), {fonte} arquivo principal, {fontes} todos os arquivos da extensao na pasta do fonte (C), {exe} binario gerado, {dll} biblioteca gerada. Uma tarefa roda sempre com a pasta entrada\\ copiada para um diretorio de trabalho novo (cwd).",
  "linguagens": {
    "forja": {
      "obrigatoria": true,
      "informativo": false,
      "extensao": ".fj",
      "versao": "forja 0.19.0 (Linguagem v1.11, pos-b01)",
      "versao_comando": ["{forja}", "--versao"],
      "check": ["{forja}", "check", "{fonte}"],
      "build": ["{forja}", "build", "{fonte}", "-o", "{exe}"],
      "build_dll": ["{forja}", "build", "--modo", "dll", "{fonte}", "-o", "{dll}"],
      "test": ["{forja}", "test", "{fonte}"],
      "versao_encontrada": "forja 0.19.0 (Linguagem v1.11)",
      "run": ["{exe}"]
    },
    "c": {
      "obrigatoria": true,
      "informativo": false,
      "extensao": ".c",
      "versao": "gcc 16.1.0 (MinGW-W64 UCRT), -std=c11 -Wall -O0; -O2 so na medida de velocidade",
      "versao_comando": ["gcc", "--version"],
      "check": ["gcc", "-std=c11", "-Wall", "-O0", "-fsyntax-only", "{fontes}"],
      "build": ["gcc", "-std=c11", "-Wall", "-O0", "-o", "{exe}", "{fontes}", "-lm"],
      "build_dll": ["gcc", "-std=c11", "-Wall", "-O0", "-shared", "-o", "{dll}", "{fontes}", "-lm"],
      "versao_encontrada": "gcc 16.1.0 (MinGW-W64 x86_64-ucrt-posix-seh, built by Brecht Sanders, r2)",
      "run": ["{exe}"]
    },
    "python": {
      "obrigatoria": false,
      "informativo": true,
      "extensao": ".py",
      "versao": "Python 3.13.13, python -I",
      "versao_comando": ["python", "--version"],
      "check": ["python", "-I", "-c", "import ast,sys; ast.parse(open(sys.argv[1], encoding='utf-8').read())", "{fonte}"],
      "build": null,
      "versao_encontrada": "Python 3.13.13",
      "run": ["python", "-I", "{fonte}"]
    },
    "js": {
      "obrigatoria": false,
      "informativo": true,
      "extensao": ".js",
      "versao": "node v24.15.0 (arquivo .ts aceito pelo agente com tipos apagados, sem checagem)",
      "versao_comando": ["node", "--version"],
      "check": ["node", "--check", "{fonte}"],
      "build": null,
      "versao_encontrada": "node v24.15.0",
      "run": ["node", "{fonte}"]
    }
  }
}
