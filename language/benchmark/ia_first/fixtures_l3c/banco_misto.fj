// L3c: formas antigas e novas do vendor:banco no mesmo programa (banco.open com banco.ErroBanco, banco.executar com banco.DbError); a saida e a de banco_novo.fj.
import "vendor:banco/banco"

proc principal(bd: banco.Banco) -> ! banco.DbError {
    try banco.executar(bd, sql = "CREATE TABLE t(id INTEGER PRIMARY KEY, nome TEXT)")
    try banco.exec(bd, sql = "INSERT INTO t(nome) VALUES ('a')")
}

proc main() {
    switch aberto in banco.open(":memory:") {
    case banco.Banco:
        switch r in principal(aberto) {
        case banco.ErroBanco:
            print("erro inesperado")
        default:
            print("ok")
        }
        switch r in banco.exec(aberto, sql = "SELEC 1") {
        case banco.DbError:
            print("erro tratado")
        default:
            print("inesperado")
        }
        banco.fechar(aberto)
    case banco.ErroBanco:
        print("nao abriu")
    }
}
