// L3c: vendor:banco com as formas ANTIGAS (banco.abrir, banco.executar, banco.ErroBanco): valem em silencio e a saida e a de banco_novo.fj. Precisa de vendor\ ao lado.
import "vendor:banco/banco"

proc principal(bd: banco.Banco) -> ! banco.ErroBanco {
    try banco.executar(bd, sql = "CREATE TABLE t(id INTEGER PRIMARY KEY, nome TEXT)")
    try banco.executar(bd, sql = "INSERT INTO t(nome) VALUES ('a')")
}

proc main() {
    switch aberto in banco.abrir(":memory:") {
    case banco.Banco:
        switch r in principal(aberto) {
        case banco.ErroBanco:
            print("erro inesperado")
        default:
            print("ok")
        }
        switch r in banco.executar(aberto, sql = "SELEC 1") {
        case banco.ErroBanco:
            print("erro tratado")
        default:
            print("inesperado")
        }
        banco.fechar(aberto)
    case banco.ErroBanco:
        print("nao abriu")
    }
}
