// L3c: vendor:banco com as formas novas (L-09): banco.open, banco.exec e o enum banco.DbError. Precisa de vendor\ ao lado (o verificar_l3c.py cria a juncao).
import "vendor:banco/banco"

proc principal(bd: banco.Banco) -> ! banco.DbError {
    try banco.exec(bd, sql = "CREATE TABLE t(id INTEGER PRIMARY KEY, nome TEXT)")
    try banco.exec(bd, sql = "INSERT INTO t(nome) VALUES ('a')")
}

proc main() {
    switch aberto in banco.open(":memory:") {
    case banco.Banco:
        switch r in principal(aberto) {
        case banco.DbError:
            print("erro inesperado")
        default:
            print("ok")
        }
        switch r in banco.exec(aberto, sql = "SELEC 1") {
        case banco.DbError:
            print("erro tratado")
        default:
            print("inesperado")
        }
        banco.fechar(aberto)
    case banco.DbError:
        print("nao abriu")
    }
}
