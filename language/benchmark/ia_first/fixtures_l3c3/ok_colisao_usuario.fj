// L3c3: identificadores do USUARIO com o nome das formas novas e antigas de vendor:json e vendor:compression (name, size, key, text, number, list, object, data, level, src, dst, field, parse,
// kind, file, other, timeout, nome, tamanho, chave, texto, numero, lista, objeto, origem, destino, nivel, dados, anterior, invalido, sem_memoria...) continuam do usuario: variavel, parametro,
// campo, rotulo de proc do usuario e membro de enum do usuario nao sao trocados. Desde o IA1-L8 os nomes de TOPO sao por modulo (a raiz pode ter um proc `close` ou `parse` proprio, ao lado do do modulo; E0202 so vale
// dentro do mesmo modulo), mas esta fixture mantem so escopo local, campo, parametro e membro. Precisa de vendor\ ao lado.
import "vendor:json/json"
import "vendor:compression/compression"

enum Falha {
    invalid
    invalido
    missing
    file
    arquivo
    out_of_memory_mas_meu
    sem_memoria
    timeout
    other
    outro
    text
    texto
    number
    list
    object
    null
    nulo
}

struct Registro {
    name: str
    nome: str
    size: int
    tamanho: int
    key: int
    chave: int
    data: int
    dados: int
    level: int
    nivel: int
    src: int
    origem: int
    dst: int
    destino: int
}

proc somar(name: int, size: int, field: int) -> int {
    return name + size + field
}

proc medir(nome: int, tamanho: int, chave: int, objeto: int, lista: int) -> int {
    return nome + tamanho + chave + objeto + lista
}

proc nome_da_falha(f: Falha) -> str {
    switch f {
    case Falha.invalid:
        return "meu invalid"
    case Falha.invalido:
        return "meu invalido"
    case Falha.missing:
        return "meu missing"
    case Falha.file:
        return "meu file"
    case Falha.arquivo:
        return "meu arquivo"
    case Falha.out_of_memory_mas_meu:
        return "meu out_of_memory"
    case Falha.sem_memoria:
        return "meu sem_memoria"
    case Falha.timeout:
        return "meu timeout"
    case Falha.other:
        return "meu other"
    case Falha.outro:
        return "meu outro"
    case Falha.text:
        return "meu text"
    case Falha.texto:
        return "meu texto"
    case Falha.number:
        return "meu number"
    case Falha.list:
        return "meu list"
    case Falha.object:
        return "meu object"
    case Falha.null:
        return "meu null"
    case Falha.nulo:
        return "meu nulo"
    }
    return "?"
}

proc main() {
    let parse = 1
    let kind = 2
    let field = 3
    let key = 4
    let size = 5
    let text = 6
    let number = 7
    let list = 8
    let object = 9
    let level = 10
    let data = 11
    let src = 12
    let dst = 13
    let previous = 14
    let timeout = 15
    let file = 16
    let other = 17
    let dump = 18
    print(f"{parse} {kind} {field} {key} {size} {text} {number} {list} {object} {level} {data} {src} {dst} {previous} {timeout} {file} {other} {dump}")
    let r = Registro{name = "n", nome = "m", size = 1, tamanho = 2, key = 3, chave = 4, data = 5, dados = 6, level = 7, nivel = 8, src = 9, origem = 10, dst = 11, destino = 12}
    print(f"{r.name} {r.nome} {r.size} {r.tamanho} {r.key} {r.chave} {r.data} {r.dados} {r.level} {r.nivel} {r.src} {r.origem} {r.dst} {r.destino}")
    print(f"{somar(name = 1, size = 2, field = 3)} {somar(1, 2, 3)}")
    print(f"{medir(nome = 1, tamanho = 2, chave = 3, objeto = 4, lista = 5)} {medir(1, 2, 3, 4, 5)}")
    print(f"{nome_da_falha(Falha.invalid)} {nome_da_falha(Falha.invalido)} {nome_da_falha(Falha.file)} {nome_da_falha(Falha.arquivo)}")
    print(f"{nome_da_falha(Falha.sem_memoria)} {nome_da_falha(Falha.out_of_memory_mas_meu)} {nome_da_falha(Falha.timeout)} {nome_da_falha(Falha.other)} {nome_da_falha(Falha.outro)}")
    print(f"{nome_da_falha(Falha.text)} {nome_da_falha(Falha.texto)} {nome_da_falha(Falha.number)} {nome_da_falha(Falha.list)} {nome_da_falha(Falha.object)} {nome_da_falha(Falha.null)} {nome_da_falha(Falha.nulo)}")

    switch doc in json.parse("{\"a\": 4, \"s\": \"x\"}") {
    case json.Json:
        let campo = json.field_int(doc, name = "a") or_else -1
        let antigo = json.field_int(doc, name = "a") or_else -1
        let tamanho_do_doc = json.size(doc)
        let nome_em_texto = json.field_text(doc, name = "s") or_else "?"
        print(f"{campo} {antigo} {tamanho_do_doc} {nome_em_texto}")
        json.close(doc)
    case json.JsonError:
        print("parse falhou")
    }

    var original: [64]u8 = {}
    var pequeno: [128]u8 = {}
    let limite = compression.bound(64)
    print(f"{limite > 0}")
    switch gravados in compression.compress(original[..], dst = pequeno[..], level = 6) {
    case i64:
        print(f"comprimiu {gravados > 0}")
    case compression.ZlibError:
        print("compress falhou")
    }
    switch gravados in compression.compress(original[..], dst = pequeno[..], level = 6) {
    case i64:
        print(f"comprimiu {gravados > 0}")
    case compression.ZlibError:
        print("comprimir falhou")
    }
    print(f"{compression.crc(original[..], previous = 0)} {compression.crc(original[..], previous = 0)}")
}
