// L3c3/L3f: `destino` e `dst` sao o MESMO parametro de compression.compress; o `destino` (forma antiga) e recusado com E0110 antes de qualquer outra analise.
import "vendor:compression/compression"

proc gravar(entrada: []u8, saida: []u8) -> ! compression.ZlibError {
    let n = try compression.compress(entrada, destino = saida, dst = saida, level = 6)
}

proc main() {
    print(1)
}
