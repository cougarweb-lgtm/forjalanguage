// L3c3: o MESMO nome antigo em dois modulos com novos nomes diferentes ou iguais (tamanho: json.tamanho -> size, rotulo tamanho de compression.limite -> size; texto: proc json.texto -> text e
// membro JsonKind.texto -> text; sem_memoria: membro de JsonError e de ZlibError -> out_of_memory; fechar: json.fechar -> close) e cada linha vale so no escopo do seu modulo. Precisa de vendor\ ao lado.
import "vendor:json/json"
import "vendor:compression/compression"

proc main() {
    let doc = json.parse("{\"a\": [1, 2, 3], \"t\": \"x\"}") or_else json.Json{no = none, dono = false}
    let lista = json.field(doc, name = "a") or_else doc
    let texto = json.field(doc, name = "t") or_else doc
    print(f"{json.size(lista)} {json.size(lista)} {json.size(doc)}")
    let antigo = json.text(texto) or_else "?"
    let novo = json.text(texto) or_else "?"
    print(f"{antigo} {novo}")
    print(f"{json.kind(texto) == json.JsonKind.text} {json.kind(texto) == json.JsonKind.text} {json.kind(texto) == json.JsonKind.text}")
    print(f"{compression.bound(size = 100) == compression.bound(size = 100)} {compression.bound(100) == compression.bound(100)}")
    print(f"{json.JsonError.out_of_memory == json.JsonError.out_of_memory} {compression.ZlibError.out_of_memory == compression.ZlibError.out_of_memory}")
    json.close(doc)
}
