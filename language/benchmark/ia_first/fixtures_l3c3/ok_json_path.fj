// S2g-json (L10g): std:json 0.2.0, o caminho (get_path, path_*, at), push_bool/null/list e remove_*; a saida e a de ok_json_path.esperado.txt. Precisa de vendor\ ao lado.
import "vendor:json/json"

proc nome_do_erro(e: json.JsonError) -> str {
    switch e {
    case json.JsonError.invalid:
        return "invalid"
    case json.JsonError.missing:
        return "missing"
    case json.JsonError.wrong_type:
        return "wrong_type"
    case json.JsonError.file:
        return "file"
    case json.JsonError.out_of_memory:
        return "out_of_memory"
    case json.JsonError.invalid_path:
        return "invalid_path"
    }
    return "?"
}

proc mostrar(doc: json.Json, path: str) {
    var onde: int = -1
    switch r in json.path_text(doc, path = path, at = &onde) {
    case str:
        print(f"{path} = {r}")
    case json.JsonError:
        print(f"{path} -> {nome_do_erro(r)} em {onde}")
    }
}

proc caminhos(doc: json.Json) {
    mostrar(doc, path = "a.b[1].c")
    mostrar(doc, path = "l[0][1]")
    mostrar(doc, path = "a.b[2]")
    mostrar(doc, path = "a.x")
    mostrar(doc, path = "a.b.c")
    mostrar(doc, path = "a[0]")
    mostrar(doc, path = "a..b")
    mostrar(doc, path = "a.")
    mostrar(doc, path = "l[-1]")
    mostrar(doc, path = "a.b[1].c.d")
    let n = json.path_int(doc, path = "a.n") or_else -1
    let f = json.path_number(doc, path = "a.f") or_else -1.0
    let b = json.path_bool(doc, path = "a.ok") or_else false
    print(f"{n} {f as int} {b}")
}

proc editar() -> ! json.JsonError {
    let doc = try json.new_object()
    defer json.close(doc)
    try json.set_text(doc, name = "k", value = "v")
    try json.set_number(doc, name = "x", value = 1.0)
    let lista = try json.set_list(doc, name = "l")
    try json.push_bool(lista, value = true)
    try json.push_null(lista)
    let dentro = try json.push_list(lista)
    try json.push_text(dentro, value = "z")
    try json.remove_field(doc, name = "x")
    try json.remove_item(lista, index = 0)
    let compacto = try json.dump(doc, pretty = false)
    defer delete(compacto)
    print(compacto)
    let tem_x = json.has_field(doc, name = "x")
    print(f"{tem_x} {json.size(lista)}")
    switch r in json.remove_field(doc, name = "x") {
    case json.JsonError:
        print(f"remove_field: {nome_do_erro(r)}")
    default:
        print("remove_field ok")
    }
    switch r in json.remove_item(lista, index = 9) {
    case json.JsonError:
        print(f"remove_item: {nome_do_erro(r)}")
    default:
        print("remove_item ok")
    }
    switch r in json.remove_item(doc, index = 0) {
    case json.JsonError:
        print(f"remove_item(objeto): {nome_do_erro(r)}")
    default:
        print("remove_item ok")
    }
}

proc main() {
    let doc = json.parse("{\"a\": {\"b\": [{\"c\": \"um\"}, {\"c\": \"dois\"}], \"n\": 7, \"f\": 2.5, \"ok\": true}, \"l\": [[1, 2]]}") or_else json.Json{no = none, dono = false}
    defer json.close(doc)
    caminhos(doc)
    switch r in editar() {
    case json.JsonError:
        print(f"editar: {nome_do_erro(r)}")
    default:
        print("editar ok")
    }
}
