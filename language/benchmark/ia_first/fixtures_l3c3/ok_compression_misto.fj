// L3c3: std:compression com nomes NOVOS e ANTIGOS misturados (proc novo com rotulo antigo e o inverso; enum novo com membro antigo); a saida e a de ok_compression_novo.fj. Precisa de vendor\ ao lado.
import "vendor:compression/compression"

const TAMANHO: int = 512

proc preencher(buffer: []u8) {
    for i in 0..<len(buffer) {
        buffer[i] = ((i % 8) + 65) as u8
    }
}

proc nome_do_erro(e: compression.ZlibError) -> str {
    switch e {
    case compression.ErroZlib.dest_too_small:
        return "dest_too_small"
    case compression.ZlibError.dados_invalidos:
        return "invalid_data"
    case compression.ErroZlib.out_of_memory:
        return "out_of_memory"
    case compression.ZlibError.parametro:
        return "parametro"
    }
    return "?"
}

proc principal() -> ! compression.ErroZlib {
    var original: [512]u8 = {}
    preencher(original[..])
    var pequeno: [600]u8 = {}
    let comprimidos = try compression.compress(original[..], destino = pequeno[..], level = 9)
    print(f"original {TAMANHO} bytes -> comprimido {comprimidos} bytes")
    print(f"bound basta: {compression.limite(size = 512) >= comprimidos}")

    var volta: [512]u8 = {}
    let restaurados = try compression.descomprimir(src = pequeno[0..<(comprimidos as int)], dst = volta[..])
    print(f"restaurados {restaurados} bytes")

    var iguais = true
    for i in 0..<TAMANHO {
        if volta[i] != original[i] {
            iguais = false
        }
    }
    print(f"conteudo igual: {iguais}")
    let primeiro = compression.crc(data = original[..], anterior = 0)
    print(f"crc32 original {primeiro} volta {compression.crc(volta[..], previous = 0)}")
}

proc main() {
    print(f"zlib {compression.versao()}")
    switch r in principal() {
    case compression.ZlibError:
        print("erro inesperado")
    default:
        print("ok")
    }

    var original: [512]u8 = {}
    preencher(original[..])
    var minusculo: [4]u8 = {}
    switch r in compression.comprimir(src = original[..], destino = minusculo[..], nivel = 6) {
    case i64:
        print("inesperado")
    case compression.ErroZlib:
        print(f"erro tratado: {nome_do_erro(r)} ({r == compression.ZlibError.destino_pequeno})")
    }

    var lixo: [16]u8 = {}
    var saida: [64]u8 = {}
    switch r in compression.decompress(lixo[..], destino = saida[..]) {
    case i64:
        print("inesperado")
    case compression.ZlibError:
        print(f"erro tratado: {nome_do_erro(r)} ({r == compression.ErroZlib.invalid_data})")
    }
    print(nome_do_erro(compression.ZlibError.sem_memoria))
}
