// L3c3: std:compression pelos nomes ANTIGOS em portugues (comprimir, descomprimir, limite, ErroZlib, origem/destino/nivel/dados/anterior/tamanho =); a saida e a de ok_compression_novo.fj. Precisa de vendor\ ao lado.
import "vendor:compression/compression"

const TAMANHO: int = 512

proc preencher(buffer: []u8) {
    for i in 0..<len(buffer) {
        buffer[i] = ((i % 8) + 65) as u8
    }
}

proc nome_do_erro(e: compression.ErroZlib) -> str {
    switch e {
    case compression.ErroZlib.destino_pequeno:
        return "dest_too_small"
    case compression.ErroZlib.dados_invalidos:
        return "invalid_data"
    case compression.ErroZlib.sem_memoria:
        return "out_of_memory"
    case compression.ErroZlib.parametro:
        return "parametro"
    }
    return "?"
}

proc principal() -> ! compression.ErroZlib {
    var original: [512]u8 = {}
    preencher(original[..])
    var pequeno: [600]u8 = {}
    let comprimidos = try compression.comprimir(original[..], destino = pequeno[..], nivel = 9)
    print(f"original {TAMANHO} bytes -> comprimido {comprimidos} bytes")
    print(f"bound basta: {compression.limite(tamanho = 512) >= comprimidos}")

    var volta: [512]u8 = {}
    let restaurados = try compression.descomprimir(origem = pequeno[0..<(comprimidos as int)], destino = volta[..])
    print(f"restaurados {restaurados} bytes")

    var iguais = true
    for i in 0..<TAMANHO {
        if volta[i] != original[i] {
            iguais = false
        }
    }
    print(f"conteudo igual: {iguais}")
    let primeiro = compression.crc(dados = original[..], anterior = 0)
    print(f"crc32 original {primeiro} volta {compression.crc(volta[..], anterior = 0)}")
}

proc main() {
    print(f"zlib {compression.versao()}")
    switch r in principal() {
    case compression.ErroZlib:
        print("erro inesperado")
    default:
        print("ok")
    }

    var original: [512]u8 = {}
    preencher(original[..])
    var minusculo: [4]u8 = {}
    switch r in compression.comprimir(origem = original[..], destino = minusculo[..], nivel = 6) {
    case i64:
        print("inesperado")
    case compression.ErroZlib:
        print(f"erro tratado: {nome_do_erro(r)} ({r == compression.ErroZlib.destino_pequeno})")
    }

    var lixo: [16]u8 = {}
    var saida: [64]u8 = {}
    switch r in compression.descomprimir(lixo[..], destino = saida[..]) {
    case i64:
        print("inesperado")
    case compression.ErroZlib:
        print(f"erro tratado: {nome_do_erro(r)} ({r == compression.ErroZlib.dados_invalidos})")
    }
    print(nome_do_erro(compression.ErroZlib.sem_memoria))
}
