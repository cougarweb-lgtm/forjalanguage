// L3c3: vendor:net com nomes NOVOS e ANTIGOS misturados (enum novo com membro antigo e o inverso, proc novo com rotulo antigo e o inverso); so check, igual ao de ok_net_novo.fj. Precisa de vendor\ ao lado.
import "vendor:net/net"

proc nome_do_erro(e: net.ErroRede) -> str {
    switch e {
    case net.NetError.url_invalida:
        return "invalid_url"
    case net.ErroRede.cannot_resolve:
        return "cannot_resolve"
    case net.NetError.sem_conexao:
        return "cannot_connect"
    case net.ErroRede.timeout:
        return "timeout"
    case net.NetError.tls:
        return "tls"
    case net.ErroRede.http_erro:
        return "http_error"
    case net.NetError.file:
        return "file"
    case net.ErroRede.out_of_memory:
        return "out_of_memory"
    case net.NetError.outro:
        return "other"
    }
    return "?"
}

proc main() {
    let alvo: cstr = "alvo.tmp"
    switch r in net.download_file("https://exemplo.invalid/x", destino = alvo, timeout_s = 5) {
    case i32:
        print(f"HTTP {r}")
    case net.NetError:
        print(nome_do_erro(r))
    }
    print(f"{net.tamanho_do_arquivo(alvo)} {net.remove_file(alvo)} {net.versao() as str}")
}
