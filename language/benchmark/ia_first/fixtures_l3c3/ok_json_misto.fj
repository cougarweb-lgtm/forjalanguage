// L3c3: std:json com nomes NOVOS e ANTIGOS misturados (proc novo com rotulo antigo, proc antigo com rotulo novo, enum novo com membro antigo e o inverso); a saida e a de ok_json_novo.fj. Precisa de vendor\ ao lado.
import "vendor:json/json"

proc nome_do_erro(e: json.ErroJson) -> str {
    switch e {
    case json.JsonError.invalido:
        return "invalid"
    case json.ErroJson.missing:
        return "missing"
    case json.JsonError.tipo_errado:
        return "wrong_type"
    case json.ErroJson.file:
        return "file"
    case json.JsonError.sem_memoria:
        return "out_of_memory"
    case json.ErroJson.invalid_path:
        return "invalid_path"
    }
    return "?"
}

proc nome_do_tipo(k: json.JsonKind) -> str {
    switch k {
    case json.TipoJson.null:
        return "null"
    case json.JsonKind.booleano:
        return "boolean"
    case json.TipoJson.number:
        return "number"
    case json.JsonKind.texto:
        return "text"
    case json.TipoJson.list:
        return "list"
    case json.JsonKind.objeto:
        return "object"
    case json.TipoJson.outro:
        return "outro"
    }
    return "?"
}

proc ler() -> ! json.JsonError {
    let doc = try json.abrir("{\"nome\": \"leao\", \"vida\": 120, \"ativo\": true, \"peso\": 190.5, \"nada\": null, \"lista\": [1, 2, 3], \"pos\": {\"x\": 1.5}}")
    defer json.close(doc)
    print(f"tipo do doc {nome_do_tipo(json.tipo(doc))} tamanho {json.size(doc)}")
    let tem = json.tem_campo(doc, name = "nome")
    let nao_tem = json.has_field(doc, nome = "zzz")
    print(f"tem nome {tem} tem zzz {nao_tem}")
    let texto = try json.field_text(doc, nome = "nome")
    let inteiro = try json.campo_inteiro(doc, name = "vida")
    let flag = try json.field_bool(doc, nome = "ativo")
    let real = try json.campo_numero(doc, name = "peso")
    print(f"{texto} {inteiro} {flag} {real as int}")
    let vida = try json.field(doc, nome = "vida")
    let vida_i = try json.inteiro(vida)
    let vida_n = try json.number(vida)
    print(f"vida: {nome_do_tipo(json.kind(vida))} inteiro {vida_i} numero {vida_n as int}")
    let ativo = try json.campo(doc, name = "ativo")
    let ativo_b = try json.boolean(ativo)
    print(f"ativo: {nome_do_tipo(json.tipo(ativo))} {ativo_b}")
    let nome = try json.field(doc, name = "nome")
    let nome_t = try json.texto(nome)
    print(f"nome: {nome_do_tipo(json.kind(nome))} {nome_t}")
    let nada = try json.campo(doc, nome = "nada")
    print(f"nada: {nome_do_tipo(json.tipo(nada))}")
    let lista = try json.field(doc, nome = "lista")
    let item1 = try json.item(lista, indice = 1)
    let item1_i = try json.integer(item1)
    print(f"lista: {nome_do_tipo(json.kind(lista))} tamanho {json.tamanho(lista)} item1 {item1_i}")
    let pos = try json.campo(doc, name = "pos")
    let chave0 = try json.key(pos, indice = 0)
    print(f"pos: {nome_do_tipo(json.tipo(pos))} chave0 {chave0}")
}

proc escrever() -> ! json.ErroJson {
    let saida = try json.new_object()
    defer json.fechar(saida)
    try json.set_text(saida, nome = "modelo", valor = "aguia")
    try json.poe_numero(saida, name = "total", valor = 3.0)
    try json.set_bool(saida, nome = "ok", valor = true)
    try json.poe_nulo(saida, name = "extra")
    let nomes = try json.set_list(saida, nome = "nomes")
    try json.lista_texto(nomes, valor = "a")
    try json.push_number(nomes, valor = 2.0)
    let filho = try json.lista_objeto(nomes)
    try json.set_number(filho, nome = "n", valor = 7.0)
    let outro = try json.poe_objeto(saida, name = "filho")
    try json.set_bool(outro, nome = "f", valor = false)
    let raiz = try json.criar_lista()
    defer json.close(raiz)
    try json.push_text(raiz, valor = "z")
    let compacto = try json.dump(saida, bonito = false)
    defer delete(compacto)
    print(compacto)
    let bonito = try json.gerar(raiz, pretty = true)
    defer delete(bonito)
    print(bonito)
}

proc erros() {
    switch r in json.parse("{") {
    case json.Json:
        print("inesperado")
    case json.ErroJson:
        print(f"parse: {nome_do_erro(r)} {r == json.JsonError.invalido}")
    }
    switch r in json.abrir_str("[1,") {
    case json.Json:
        print("inesperado")
    case json.JsonError:
        print(f"parse_str: {nome_do_erro(r)}")
    }
    switch r in json.parse_file("arquivo_que_nao_existe.json") {
    case json.Json:
        print("inesperado")
    case json.ErroJson:
        print(f"parse_file: {nome_do_erro(r)} {r == json.ErroJson.file}")
    }
    let doc = json.parse_str("{\"a\": 1}") or_else json.Json{no = none, dono = false}
    defer json.fechar(doc)
    switch r in json.campo(doc, name = "b") {
    case json.Json:
        print("inesperado")
    case json.JsonError:
        print(f"field: {nome_do_erro(r)} {r == json.JsonError.ausente}")
    }
    switch r in json.field_text(doc, nome = "a") {
    case str:
        print("inesperado")
    case json.ErroJson:
        print(f"field_text: {nome_do_erro(r)} {r == json.ErroJson.wrong_type}")
    }
    switch r in json.poe_texto(doc, name = "k", valor = "v") {
    case json.JsonError:
        print("set_text falhou")
    default:
        print("set_text ok")
    }
    switch r in json.parse(texto = "{") {
    case json.Json:
        print("inesperado")
    case json.ErroJson:
        print(f"parse(text): {nome_do_erro(r)}")
    }
    switch r in json.abrir_str(text = "[1,") {
    case json.Json:
        print("inesperado")
    case json.JsonError:
        print(f"parse_str(text): {nome_do_erro(r)}")
    }
    switch r in json.parse_file(caminho = "arquivo_que_nao_existe.json") {
    case json.Json:
        print("inesperado")
    case json.ErroJson:
        print(f"parse_file(path): {nome_do_erro(r)}")
    }
    switch r in json.get_path(doc, path = "a.b") {
    case json.Json:
        print("inesperado")
    case json.JsonError:
        print(f"get_path: {nome_do_erro(r)}")
    }
    print(nome_do_erro(json.JsonError.invalid_path))
    print(nome_do_erro(json.ErroJson.out_of_memory))
}

proc main() {
    switch r in ler() {
    case json.ErroJson:
        print(f"ler: {nome_do_erro(r)}")
    default:
        print("ler ok")
    }
    switch r in escrever() {
    case json.JsonError:
        print(f"escrever: {nome_do_erro(r)}")
    default:
        print("escrever ok")
    }
    erros()
}
