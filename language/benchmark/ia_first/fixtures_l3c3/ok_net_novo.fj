// L3c3: vendor:net pelos nomes NOVOS (NetError, file_size, remove_file, download_file, dst =, timeout_s =); so check (nao usa a rede; o net.fj ja acusa E0709 no repo, igual nas tres formas). Precisa de vendor\ ao lado.
import "vendor:net/net"

proc nome_do_erro(e: net.NetError) -> str {
    switch e {
    case net.NetError.invalid_url:
        return "invalid_url"
    case net.NetError.cannot_resolve:
        return "cannot_resolve"
    case net.NetError.cannot_connect:
        return "cannot_connect"
    case net.NetError.timeout:
        return "timeout"
    case net.NetError.tls:
        return "tls"
    case net.NetError.http_error:
        return "http_error"
    case net.NetError.file:
        return "file"
    case net.NetError.out_of_memory:
        return "out_of_memory"
    case net.NetError.other:
        return "other"
    case net.NetError.send_failed:
        return "send_failed"
    case net.NetError.recv_failed:
        return "recv_failed"
    }
    return "?"
}

proc main() {
    let alvo: cstr = "alvo.tmp"
    switch r in net.download_file("https://exemplo.invalid/x", dst = alvo, timeout_s = 5) {
    case i32:
        print(f"HTTP {r}")
    case net.NetError:
        print(nome_do_erro(r))
    }
    print(f"{net.file_size(alvo)} {net.remove_file(alvo)} {net.versao() as str}")
}
