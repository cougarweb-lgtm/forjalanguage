// L3c3: std:json pelos nomes ANTIGOS em portugues (abrir, fechar, campo, tamanho, ErroJson, TipoJson, nome =, bonito =...); a saida e a de ok_json_novo.fj (a forma antiga vira a nova na leitura). Precisa de vendor\ ao lado.
import "vendor:json/json"

proc nome_do_erro(e: json.ErroJson) -> str {
    switch e {
    case json.ErroJson.invalido:
        return "invalid"
    case json.ErroJson.ausente:
        return "missing"
    case json.ErroJson.tipo_errado:
        return "wrong_type"
    case json.ErroJson.arquivo:
        return "file"
    case json.ErroJson.sem_memoria:
        return "out_of_memory"
    case json.ErroJson.invalid_path:
        return "invalid_path"
    }
    return "?"
}

proc nome_do_tipo(k: json.TipoJson) -> str {
    switch k {
    case json.TipoJson.nulo:
        return "null"
    case json.TipoJson.booleano:
        return "boolean"
    case json.TipoJson.numero:
        return "number"
    case json.TipoJson.texto:
        return "text"
    case json.TipoJson.lista:
        return "list"
    case json.TipoJson.objeto:
        return "object"
    case json.TipoJson.outro:
        return "outro"
    }
    return "?"
}

proc ler() -> ! json.ErroJson {
    let doc = try json.abrir("{\"nome\": \"leao\", \"vida\": 120, \"ativo\": true, \"peso\": 190.5, \"nada\": null, \"lista\": [1, 2, 3], \"pos\": {\"x\": 1.5}}")
    defer json.fechar(doc)
    print(f"tipo do doc {nome_do_tipo(json.tipo(doc))} tamanho {json.tamanho(doc)}")
    let tem = json.tem_campo(doc, nome = "nome")
    let nao_tem = json.tem_campo(doc, nome = "zzz")
    print(f"tem nome {tem} tem zzz {nao_tem}")
    let texto = try json.campo_texto(doc, nome = "nome")
    let inteiro = try json.campo_inteiro(doc, nome = "vida")
    let flag = try json.campo_bool(doc, nome = "ativo")
    let real = try json.campo_numero(doc, nome = "peso")
    print(f"{texto} {inteiro} {flag} {real as int}")
    let vida = try json.campo(doc, nome = "vida")
    let vida_i = try json.inteiro(vida)
    let vida_n = try json.numero(vida)
    print(f"vida: {nome_do_tipo(json.tipo(vida))} inteiro {vida_i} numero {vida_n as int}")
    let ativo = try json.campo(doc, nome = "ativo")
    let ativo_b = try json.booleano(ativo)
    print(f"ativo: {nome_do_tipo(json.tipo(ativo))} {ativo_b}")
    let nome = try json.campo(doc, nome = "nome")
    let nome_t = try json.texto(nome)
    print(f"nome: {nome_do_tipo(json.tipo(nome))} {nome_t}")
    let nada = try json.campo(doc, nome = "nada")
    print(f"nada: {nome_do_tipo(json.tipo(nada))}")
    let lista = try json.campo(doc, nome = "lista")
    let item1 = try json.item(lista, indice = 1)
    let item1_i = try json.inteiro(item1)
    print(f"lista: {nome_do_tipo(json.tipo(lista))} tamanho {json.tamanho(lista)} item1 {item1_i}")
    let pos = try json.campo(doc, nome = "pos")
    let chave0 = try json.chave(pos, indice = 0)
    print(f"pos: {nome_do_tipo(json.tipo(pos))} chave0 {chave0}")
}

proc escrever() -> ! json.ErroJson {
    let saida = try json.criar_objeto()
    defer json.fechar(saida)
    try json.poe_texto(saida, nome = "modelo", valor = "aguia")
    try json.poe_numero(saida, nome = "total", valor = 3.0)
    try json.poe_bool(saida, nome = "ok", valor = true)
    try json.poe_nulo(saida, nome = "extra")
    let nomes = try json.poe_lista(saida, nome = "nomes")
    try json.lista_texto(nomes, valor = "a")
    try json.lista_numero(nomes, valor = 2.0)
    let filho = try json.lista_objeto(nomes)
    try json.poe_numero(filho, nome = "n", valor = 7.0)
    let outro = try json.poe_objeto(saida, nome = "filho")
    try json.poe_bool(outro, nome = "f", valor = false)
    let raiz = try json.criar_lista()
    defer json.fechar(raiz)
    try json.lista_texto(raiz, valor = "z")
    let compacto = try json.gerar(saida, bonito = false)
    defer delete(compacto)
    print(compacto)
    let bonito = try json.gerar(raiz, bonito = true)
    defer delete(bonito)
    print(bonito)
}

proc erros() {
    switch r in json.abrir("{") {
    case json.Json:
        print("inesperado")
    case json.ErroJson:
        print(f"parse: {nome_do_erro(r)} {r == json.ErroJson.invalido}")
    }
    switch r in json.abrir_str("[1,") {
    case json.Json:
        print("inesperado")
    case json.ErroJson:
        print(f"parse_str: {nome_do_erro(r)}")
    }
    switch r in json.abrir_arquivo("arquivo_que_nao_existe.json") {
    case json.Json:
        print("inesperado")
    case json.ErroJson:
        print(f"parse_file: {nome_do_erro(r)} {r == json.ErroJson.arquivo}")
    }
    let doc = json.abrir_str("{\"a\": 1}") or_else json.Json{no = none, dono = false}
    defer json.fechar(doc)
    switch r in json.campo(doc, nome = "b") {
    case json.Json:
        print("inesperado")
    case json.ErroJson:
        print(f"field: {nome_do_erro(r)} {r == json.ErroJson.ausente}")
    }
    switch r in json.campo_texto(doc, nome = "a") {
    case str:
        print("inesperado")
    case json.ErroJson:
        print(f"field_text: {nome_do_erro(r)} {r == json.ErroJson.tipo_errado}")
    }
    switch r in json.poe_texto(doc, nome = "k", valor = "v") {
    case json.ErroJson:
        print("set_text falhou")
    default:
        print("set_text ok")
    }
    switch r in json.abrir(texto = "{") {
    case json.Json:
        print("inesperado")
    case json.ErroJson:
        print(f"parse(text): {nome_do_erro(r)}")
    }
    switch r in json.abrir_str(texto = "[1,") {
    case json.Json:
        print("inesperado")
    case json.ErroJson:
        print(f"parse_str(text): {nome_do_erro(r)}")
    }
    switch r in json.abrir_arquivo(caminho = "arquivo_que_nao_existe.json") {
    case json.Json:
        print("inesperado")
    case json.ErroJson:
        print(f"parse_file(path): {nome_do_erro(r)}")
    }
    switch r in json.get_path(doc, path = "a.b") {
    case json.Json:
        print("inesperado")
    case json.ErroJson:
        print(f"get_path: {nome_do_erro(r)}")
    }
    print(nome_do_erro(json.ErroJson.invalid_path))
    print(nome_do_erro(json.ErroJson.sem_memoria))
}

proc main() {
    switch r in ler() {
    case json.ErroJson:
        print(f"ler: {nome_do_erro(r)}")
    default:
        print("ler ok")
    }
    switch r in escrever() {
    case json.ErroJson:
        print(f"escrever: {nome_do_erro(r)}")
    default:
        print("escrever ok")
    }
    erros()
}
