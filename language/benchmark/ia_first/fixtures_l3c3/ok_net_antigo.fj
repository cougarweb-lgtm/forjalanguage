// L3c3: vendor:net pelos nomes ANTIGOS (ErroRede, tamanho_do_arquivo, remover_arquivo, baixar_arquivo, destino =, tempo_s =); so check, igual ao de ok_net_novo.fj. Precisa de vendor\ ao lado.
import "vendor:net/net"

proc nome_do_erro(e: net.ErroRede) -> str {
    switch e {
    case net.ErroRede.url_invalida:
        return "invalid_url"
    case net.ErroRede.sem_resolver:
        return "cannot_resolve"
    case net.ErroRede.sem_conexao:
        return "cannot_connect"
    case net.ErroRede.tempo_esgotado:
        return "timeout"
    case net.ErroRede.tls:
        return "tls"
    case net.ErroRede.http_erro:
        return "http_error"
    case net.ErroRede.arquivo:
        return "file"
    case net.ErroRede.sem_memoria:
        return "out_of_memory"
    case net.ErroRede.outro:
        return "other"
    }
    return "?"
}

proc main() {
    let alvo: cstr = "alvo.tmp"
    switch r in net.baixar_arquivo("https://exemplo.invalid/x", destino = alvo, tempo_s = 5) {
    case i32:
        print(f"HTTP {r}")
    case net.ErroRede:
        print(nome_do_erro(r))
    }
    print(f"{net.tamanho_do_arquivo(alvo)} {net.remover_arquivo(alvo)} {net.versao() as str}")
}
