// L3c3: o rotulo `name` (json) nao vale em compression: compression.compress nao tem o parametro name nem o antigo nome.
import "vendor:compression/compression"

proc gravar(entrada: []u8, saida: []u8) -> ! compression.ZlibError {
    let n = try compression.compress(entrada, name = saida, level = 6)
}

proc main() {
    print(1)
}
