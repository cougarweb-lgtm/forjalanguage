// S2g-json: `indice` (json.item), `valor` (json.set_text) e `texto` (json.parse_str) sao formas antigas e dao E0110 cada um; os novos sao index, value e text.
import "vendor:json/json"

proc ler(doc: json.Json) -> ! json.JsonError {
    let a = try json.item(doc, indice = 0)
    try json.set_text(doc, name = "k", valor = "v")
    let b = try json.parse_str(texto = "[]")
}

proc main() {
    print(1)
}
