// S2g-json (L10g): json.path_int devolve `i64 ! JsonError`; guardar direto num i64 sem try, switch ou or_else e E0301.
import "vendor:json/json"

proc main() {
    let doc = json.parse("{}") or_else json.Json{no = none, dono = false}
    defer json.close(doc)
    let n: i64 = json.path_int(doc, path = "a")
    print(n)
}
