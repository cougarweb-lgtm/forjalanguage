// L3c3/L3f: `nome` e `name` sao o MESMO parametro de json.field; o `nome` (forma antiga) e recusado com E0110 antes de qualquer outra analise.
import "vendor:json/json"

proc ler(doc: json.Json) -> ! json.JsonError {
    let campo = try json.field(doc, nome = "a", name = "b")
}

proc main() {
    print(1)
}
