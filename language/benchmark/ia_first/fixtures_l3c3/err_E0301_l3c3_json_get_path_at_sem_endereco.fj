// S2g-json (L10g): `at` de get_path e `?^int` (o endereco de um int, como no parse de std:fmt); um int solto e E0301.
import "vendor:json/json"

proc main() {
    let doc = json.parse("{}") or_else json.Json{no = none, dono = false}
    defer json.close(doc)
    let n = json.get_path(doc, path = "a", at = 5) or_else doc
    print(1)
}
