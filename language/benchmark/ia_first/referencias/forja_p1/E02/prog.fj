import "std:os"
import "std:arquivo"

// Soma os inteiros do texto (um por linha, '-' opcional); linha em branco e ignorada.
// O indice len(dados) age como um '\n' final, para a ultima linha sem quebra.
fn somar_linhas(dados: []u8) -> int {
    var soma: int = 0;
    var valor: int = 0;
    var negativo = false;
    var tem_digito = false;
    for i in 0..=len(dados) {
        let b: int = i < len(dados) ? dados[i] as int : 10;
        if b >= 48 && b <= 57 {
            valor = valor * 10 + (b - 48);
            tem_digito = true;
        } else if b == 45 {
            negativo = true;
        } else if b == 10 {
            if tem_digito && negativo { soma -= valor; } else if tem_digito { soma += valor; }
            valor = 0;
            negativo = false;
            tem_digito = false;
        }
    }
    return soma;
}

fn main() {
    let a = os.args();
    var dados, erro = arquivo.read_all(a[1]);
    defer delete(dados);
    switch e in erro {
    case arquivo.FileError:
        os.exit(2);
    case none:
        print(somar_linhas(dados[..]));
    }
}
