import "std:mem"

struct Particula {
    x: int = 0
    y: int = 0
}

// Soma x e y das 4 particulas alocadas na arena do quadro q.
fn simular_quadro(q: int, arena: mem.Arena) -> (soma_x: int, soma_y: int) {
    var soma_x: int = 0;
    var soma_y: int = 0;
    for i in 0..<4 {
        let p = new(Particula, arena);
        p.x = q * 10 + i;
        p.y = i * 2;
        soma_x += p.x;
        soma_y += p.y;
    }
    return soma_x, soma_y;
}

fn main() {
    let arena = mem.arena_create(256);
    for q in 1..=3 {
        let soma_x, soma_y = simular_quadro(q, arena);
        print(f"quadro {q}: soma_x={soma_x} soma_y={soma_y}");
        mem.arena_reset(arena);
    }
    mem.arena_destroy(arena);
    print("ok");
}
