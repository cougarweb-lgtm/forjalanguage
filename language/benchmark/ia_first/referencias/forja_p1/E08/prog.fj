import "std:os"

// atoll da libc: o argumento chega como texto e a tarefa garante inteiro valido.
foreign {
    link "msvcrt"
    proc atoll(texto: cstr) -> i64
}

fn para_int(s: str) -> int {
    let c = format_c(f"{s}", heap);
    defer delete(c);
    return atoll(c) as int;
}

fn main() -> int {
    let a = os.args();
    let n = para_int(a[1]);
    var fizzbuzz: int = 0;
    for i in 1..=n {
        let rotulo = i % 15 == 0 ? "FizzBuzz" : i % 3 == 0 ? "Fizz" : i % 5 == 0 ? "Buzz" : "";
        if rotulo == "" { print(i); } else { print(rotulo); }
        if rotulo == "FizzBuzz" { fizzbuzz++; }
    }
    return fizzbuzz;
}
