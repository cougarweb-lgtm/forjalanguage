import "std:os"
import "std:arquivo"

// A Forja nao indexa str nesta versao: strstr(texto, "") devolve o proprio inicio e vira uma fatia de bytes.
foreign {
    link "msvcrt"
    proc c_bytes = "strstr"(texto: cstr, procurado: cstr) -> ?^u8
}

// Anexa os bytes do texto ao destino.
fn anexar_texto(destino: ^[dynamic]u8, s: str) {
    let c = format_c(f"{s}", heap);
    defer delete(c);
    let p = c_bytes(c, "");
    let bytes = slice_from(p, len = len(s));
    for b in bytes { append(destino, b); }
}

fn main() {
    let a = os.args();
    var csv = make([dynamic]u8, heap);
    defer delete(csv);
    anexar_texto(&csv, "n,quadrado,cubo\n");
    for n in 1..=5 {
        let linha = format(f"{n},{n * n},{n * n * n}\n", heap);
        anexar_texto(&csv, linha);
        delete(linha);
    }
    switch e in arquivo.write_all(a[1], csv[..]) {
    case arquivo.FileError:
        print(f"erro: nao foi possivel gravar {a[1]}");
        os.exit(2);
    case none:
        print(f"gravado: {a[1]} (5 linhas)");
    }
}
