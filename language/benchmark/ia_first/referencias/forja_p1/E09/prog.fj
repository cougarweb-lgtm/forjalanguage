import "std:os"
import "std:arquivo"

// Acrescenta em saida cada inteiro do texto (um por linha, '-' opcional); linha em branco e ignorada.
// O indice len(dados) age como um '\n' final, para a ultima linha sem quebra.
fn ler_inteiros(dados: []u8, saida: ^[dynamic]int) {
    var valor: int = 0;
    var negativo = false;
    var tem_digito = false;
    for i in 0..=len(dados) {
        var b = 10;
        if i < len(dados) { b = dados[i] as int; }
        if b >= 48 && b <= 57 {
            valor = valor * 10 + (b - 48);
            tem_digito = true;
        } else if b == 45 {
            negativo = true;
        } else if b == 10 {
            if tem_digito && negativo { append(saida, 0 - valor); } else if tem_digito { append(saida, valor); }
            valor = 0;
            negativo = false;
            tem_digito = false;
        }
    }
}

// Media e desvio padrao populacional, em f64.
fn estatistica(v: []int) -> (media: f64, desvio: f64) {
    var soma: f64 = 0.0;
    for x in v { soma += x as f64; }
    let n = len(v) as f64;
    let media = soma / n;
    var quadrados: f64 = 0.0;
    for x in v {
        let d = x as f64 - media;
        quadrados += d * d;
    }
    return media, sqrt(quadrados / n);
}

fn main() {
    let a = os.args();
    var dados, erro = arquivo.read_all(a[1]);
    defer delete(dados);
    var valores = make([dynamic]int, heap);
    defer delete(valores);
    switch e in erro {
    case arquivo.FileError:
        os.exit(2);
    case none:
        ler_inteiros(dados[..], &valores);
    }
    let media, desvio = estatistica(valores[..]);
    print(f"media={media:.2} desvio={desvio:.2}");
}
