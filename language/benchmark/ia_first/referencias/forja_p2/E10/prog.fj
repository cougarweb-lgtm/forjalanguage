import "std:os"

// atoll da libc: os argumentos chegam como texto e a tarefa garante inteiros validos.
foreign {
    link "msvcrt"
    proc atoll(texto: cstr) -> i64
}

fn para_int(s: str) -> int {
    let c = format_c(f"{s}", alloc = heap)
    defer delete(c)
    return atoll(c) as int
}

fn main() {
    let a = os.args()
    var m: [4]int = {0, 0, 0, 0}
    for i in 0..<4 { m[i] = para_int(a[i + 1]) }
    let x = para_int(a[5])
    let y = para_int(a[6])
    print(f"{m[0] * x + m[1] * y} {m[2] * x + m[3] * y}")
}
