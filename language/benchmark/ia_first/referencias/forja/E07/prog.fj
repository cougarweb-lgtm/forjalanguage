import "std:os" as os

// A Forja nao indexa str nesta versao: strstr(texto, "") devolve o proprio inicio e vira uma fatia de bytes.
foreign {
    link "msvcrt"
    proc c_bytes = "strstr"(texto: cstr, procurado: cstr) -> ?^u8
}

proc bytes_de(s: str, c: cstr) -> []u8 {
    let p = c_bytes(c, procurado = "")
    return slice_from(p, len = len(s))
}

// Texto valido: '-' opcional e 1 a 15 digitos, nada mais. Devolve o valor, ou ok = false.
proc interpretar(b: []u8) -> (valor: int, ok: bool) {
    var inicio: int = 0
    if len(b) > 0 and b[0] == 45 {
        inicio = 1
    }
    let digitos = len(b) - inicio
    if digitos < 1 or digitos > 15 {
        return 0, false
    }
    var valor: int = 0
    for i in inicio..<len(b) {
        if b[i] < 48 or b[i] > 57 {
            return 0, false
        }
        valor = valor * 10 + (b[i] as int - 48)
    }
    if inicio == 1 {
        valor = 0 - valor
    }
    return valor, true
}

proc main() {
    let a = os.args()
    if len(a) < 2 {
        print("erro: informe um numero")
        os.exit(2)
    }
    let c = format_c(f"{a[1]}", alloc = heap)
    defer delete(c)
    let valor, ok = interpretar(bytes_de(a[1], c = c))
    if not ok {
        print(f"invalido: {a[1]}")
        os.exit(1)
    }
    print(valor * 2)
}
