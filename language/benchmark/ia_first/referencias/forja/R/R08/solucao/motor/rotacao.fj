// rotacao.fj 0.1.0 (11/11/2026) - rotacao_normalizar e rotacao_nlerp, movidos de mundo.fj.

// Divide q pela norma; quat nulo vira a identidade.
pub proc rotacao_normalizar(q: quat) -> quat {
    let norma = sqrt(q.x * q.x + q.y * q.y + q.z * q.z + q.w * q.w)
    if norma == 0.0 {
        return quat{w = 1.0}
    }
    return q * (1.0 / norma)
}

// Mistura a e b por t em [0, 1] pelo caminho curto (b troca de sinal se o produto interno for negativo) e normaliza.
pub proc rotacao_nlerp(a: quat, b: quat, t: f32) -> quat {
    let produto = a.x * b.x + a.y * b.y + a.z * b.z + a.w * b.w
    var alvo = b
    if produto < 0.0 {
        alvo = -b
    }
    return rotacao_normalizar(a * (1.0 - t) + alvo * t)
}
