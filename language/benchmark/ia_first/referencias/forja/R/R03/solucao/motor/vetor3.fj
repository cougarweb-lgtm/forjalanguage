// vetor3.fj 0.1.0 (11/11/2026) - vetores [3]f64 (mat_v3_*), movidos de matriz.fj.

// a - b em f64 (a conta do mundo grande: objeto - camera, antes de ir para f32).
pub proc mat_v3_diferenca(a: [3]f64, b: [3]f64) -> [3]f64 {
    var r: [3]f64 = {0.0, 0.0, 0.0}
    for i in 0..<3 {
        r[i] = a[i] - b[i]
    }
    return r
}

// Converte [3]f64 para [3]f32 (so depois da subtracao relativa a camera).
pub proc mat_v3_para_f32(a: [3]f64) -> [3]f32 {
    var r: [3]f32 = {0.0, 0.0, 0.0}
    for i in 0..<3 {
        r[i] = a[i] as f32
    }
    return r
}
