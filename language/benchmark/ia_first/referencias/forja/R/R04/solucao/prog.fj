// prog.fj 0.1.0 (11/11/2026) - base do conjunto R do benchmark IA FIRST: usa os modulos de motor\ e imprime o resultado (a saida nao pode mudar em refatoracao).
// Verificar: forja check prog.fj  &&  forja run prog.fj
import "motor/mundo" as mundo
import "motor/mundo_tick" as tick
import "motor/camera" as cam

proc avancar_relogio(r: ^tick.Relogio, dt_ns: u64) -> u32 {
    return tick.relogio_acumular(r, dt_ms = dt_ns / 1000000)
}

proc main() {
    var m = mundo.mundo_novo(8)
    defer mundo.mundo_destruir(&m)
    let a = mundo.mundo_criar(&m, tipo = mundo.TipoEntidade.ator)
    let b = mundo.mundo_criar(&m, tipo = mundo.TipoEntidade.ator)
    let p = mundo.mundo_criar(&m, tipo = mundo.TipoEntidade.projetil)
    print(f"atores={mundo.mundo_contar_tipo(&m, tipo = mundo.TipoEntidade.ator)} projeteis={mundo.mundo_contar_tipo(&m, tipo = mundo.TipoEntidade.projetil)} total={mundo.mundo_contar(&m)}")
    print(f"vivos a={mundo.mundo_viva(&m, e = a)} b={mundo.mundo_viva(&m, e = b)} p={mundo.mundo_viva(&m, e = p)}")

    let t1 = mundo.tile_de_posicao({1.0, 0.25, 0.5}, nivel = 2)
    print(f"tile face={t1.face} nivel={t1.nivel} x={t1.x} y={t1.y}")
    let t2 = mundo.tile_de_posicao({-3.0, 0.5, 0.5}, nivel = 3)
    print(f"tile face={t2.face} nivel={t2.nivel} x={t2.x} y={t2.y}")
    let t3 = mundo.tile_de_posicao({0.25, 0.5, 9.0}, nivel = 4)
    print(f"tile face={t3.face} nivel={t3.nivel} x={t3.x} y={t3.y}")

    var r = tick.relogio_novo()
    let n1 = avancar_relogio(&r, dt_ns = 50000000)
    print(f"ticks apos 50 ms = {n1} (a {tick.TICK_HZ} Hz)")
    let n2 = avancar_relogio(&r, dt_ns = 16000000)
    print(f"ticks apos 16 ms = {n2} (a {tick.TICK_HZ} Hz)")
    let n3 = avancar_relogio(&r, dt_ns = 34000000)
    print(f"ticks apos 34 ms = {n3} (a {tick.TICK_HZ} Hz)")

    var c = cam.Camera{posicao = {10.0, 0.0, 0.0}, yaw = 0.0, pitch = 0.0}
    let d = cam.cam_deslocamento(&c, pos_objeto = {12.0, 1.0, -2.0})
    print(f"deslocamento mm x={(d[0] * 1000.0) as int} y={(d[1] * 1000.0) as int} z={(d[2] * 1000.0) as int}")

    let q = mundo.rotacao_normalizar(quat{x = 0.0, y = 0.0, z = 0.0, w = 2.0})
    print(f"w normalizado mm={(q.w * 1000.0) as int}")
}
