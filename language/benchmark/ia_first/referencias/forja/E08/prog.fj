import "std:os" as os

// atoll da libc: o argumento chega como texto e a tarefa garante inteiro valido.
foreign {
    link "msvcrt"
    proc atoll(texto: cstr) -> i64
}

proc para_int(s: str) -> int {
    let c = format_c(f"{s}", alloc = heap)
    defer delete(c)
    return atoll(c) as int
}

proc main() {
    let a = os.args()
    let n = para_int(a[1])
    var fizzbuzz: int = 0
    for i in 1..=n {
        if i % 15 == 0 {
            print("FizzBuzz")
            fizzbuzz += 1
        } else if i % 3 == 0 {
            print("Fizz")
        } else if i % 5 == 0 {
            print("Buzz")
        } else {
            print(i)
        }
    }
    os.exit(fizzbuzz)
}
