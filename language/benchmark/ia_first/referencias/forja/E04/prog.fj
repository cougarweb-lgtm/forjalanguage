import "std:os" as os
import "std:file"

// Acrescenta em saida cada inteiro do texto (um por linha, '-' opcional); linha em branco e ignorada.
// O indice len(dados) age como um '\n' final, para a ultima linha sem quebra.
proc ler_inteiros(dados: []u8, saida: ^[dynamic]int) {
    var valor: int = 0
    var negativo = false
    var tem_digito = false
    for i in 0..=len(dados) {
        var b = 10
        if i < len(dados) {
            b = dados[i] as int
        }
        if b >= 48 and b <= 57 {
            valor = valor * 10 + (b - 48)
            tem_digito = true
        } else if b == 45 {
            negativo = true
        } else if b == 10 {
            if tem_digito and negativo {
                append(saida, item = 0 - valor)
            } else if tem_digito {
                append(saida, item = valor)
            }
            valor = 0
            negativo = false
            tem_digito = false
        }
    }
}

// Ordenacao por insercao, no lugar.
proc ordenar(v: []int) {
    for i in 1..<len(v) {
        let chave = v[i]
        var j = i - 1
        while j >= 0 and v[j] > chave {
            v[j + 1] = v[j]
            j -= 1
        }
        v[j + 1] = chave
    }
}

proc main() {
    let a = os.args()
    var valores = make([dynamic]int, alloc = heap)
    defer delete(valores)
    switch dados in file.read_all(a[1], alloc = heap) {
    case [dynamic]u8:
        ler_inteiros(dados[..], saida = &valores)
        delete(dados)
    case file.FileError:
        os.exit(2)
    }
    ordenar(valores[..])
    for i, v in valores {
        if i == 0 or v != valores[i - 1] {
            print(v)
        }
    }
}
