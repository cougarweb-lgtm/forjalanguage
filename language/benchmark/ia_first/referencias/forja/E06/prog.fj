import "std:os" as os
import "std:file"

// Cada '\n' encerra uma linha; texto final sem '\n' conta como mais uma. Vazio = 0.
proc contar_linhas(dados: []u8) -> int {
    var linhas: int = 0
    for b in dados {
        if b == 10 {
            linhas += 1
        }
    }
    if len(dados) > 0 and dados[len(dados) - 1] != 10 {
        linhas += 1
    }
    return linhas
}

proc main() {
    let a = os.args()
    if len(a) < 2 {
        print("erro: informe o arquivo")
        os.exit(2)
    }
    switch dados in file.read_all(a[1], alloc = heap) {
    case [dynamic]u8:
        print(contar_linhas(dados[..]))
        delete(dados)
    case file.FileError:
        print(f"erro: arquivo nao encontrado: {a[1]}")
        os.exit(2)
    }
}
