import "std:os" as os

foreign {
    link "msvcrt"
    proc atoll(texto: cstr) -> i64
}

proc para_int(s: str) -> int {
    let c = format_c(f"{s}", alloc = heap)
    defer delete(c)
    return atoll(c) as int
}

// Linha k do triangulo a partir da anterior (lista que cresce).
proc proxima_linha(anterior: []int, nova: ^[dynamic]int) {
    append(nova, item = 1)
    for j in 1..<len(anterior) {
        append(nova, item = anterior[j - 1] + anterior[j])
    }
    if len(anterior) > 0 {
        append(nova, item = 1)
    }
}

// Os n primeiros valores da linha separados por um espaco (str em heap: quem chama da delete).
proc texto_dos_primeiros(linha: []int, n: int) -> str {
    if n <= 1 {
        return format(f"{linha[0]}", alloc = heap)
    }
    let antes = texto_dos_primeiros(linha, n = n - 1)
    defer delete(antes)
    return format(f"{antes} {linha[n - 1]}", alloc = heap)
}

proc linha_para_texto(linha: []int) -> str {
    return texto_dos_primeiros(linha, n = len(linha))
}

proc main() {
    let a = os.args()
    let n = para_int(a[1])
    var triangulo = make([dynamic][dynamic]int, alloc = heap)
    for k in 0..<n {
        append(&triangulo, item = make([dynamic]int, alloc = heap))
        if k == 0 {
            append(&triangulo[k], item = 1)
        } else {
            proxima_linha(triangulo[k - 1][..], nova = &triangulo[k])
        }
    }
    for k in 0..<n {
        let texto = linha_para_texto(triangulo[k][..])
        print(texto)
        delete(texto)
    }
    for &linha in triangulo {
        delete(linha^)
    }
    delete(triangulo)
}
