struct Item {
    nome: str = ""
    qtd: int = 0
    preco: f64 = 0.0
}

const LARGURA_NOME: int = 10

// A f-string alinha so a direita; o nome ganha os espacos a direita aqui (str em heap: quem chama da delete).
proc com_espacos(texto: str, faltam: int) -> str {
    if faltam <= 0 {
        return format(f"{texto}", alloc = heap)
    }
    let mais = format(f"{texto} ", alloc = heap)
    defer delete(mais)
    return com_espacos(mais, faltam = faltam - 1)
}

proc preencher_nome(nome: str) -> str {
    return com_espacos(nome, faltam = LARGURA_NOME - len(nome))
}

proc imprimir_cabecalho() {
    let coluna1 = preencher_nome("Item")
    defer delete(coluna1)
    let qtd = "Qtd"
    let preco = "Preco"
    print(f"{coluna1}{qtd:5}{preco:8}")
}

proc imprimir_linha(nome: str, qtd: int, preco: f64) {
    let coluna1 = preencher_nome(nome)
    defer delete(coluna1)
    print(f"{coluna1}{qtd:5}{preco:8.2}")
}

proc main() {
    let itens: [3]Item = {Item{nome = "Maca", qtd = 12, preco = 3.5}, Item{nome = "Banana", qtd = 5, preco = 12.25}, Item{nome = "Uva", qtd = 100, preco = 0.99}}
    imprimir_cabecalho()
    var total_qtd: int = 0
    var total: f64 = 0.0
    for item in itens {
        imprimir_linha(item.nome, qtd = item.qtd, preco = item.preco)
        total_qtd += item.qtd
        total += (item.qtd as f64) * item.preco
    }
    imprimir_linha("Total", qtd = total_qtd, preco = total)
}
