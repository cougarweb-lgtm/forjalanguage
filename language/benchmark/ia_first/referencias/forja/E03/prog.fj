import "std:os" as os

proc main() {
    let a = os.args()
    var contagem = make(map[str]int, alloc = heap)
    defer delete(contagem)
    var ordem = make([dynamic]str, alloc = heap)
    defer delete(ordem)
    for i, palavra in a {
        if i > 0 {
            let antes = get(contagem, key = palavra) or_else 0
            if antes == 0 {
                append(&ordem, item = palavra)
            }
            insert(&contagem, key = palavra, value = antes + 1)
        }
    }
    for palavra in ordem {
        print(f"{palavra}: {get(contagem, key = palavra) or_else 0}")
    }
}
