import "std:os" as os
import "std:file"

// Soma os inteiros do texto (um por linha, '-' opcional); linha em branco e ignorada.
// O indice len(dados) age como um '\n' final, para a ultima linha sem quebra.
proc somar_linhas(dados: []u8) -> int {
    var soma: int = 0
    var valor: int = 0
    var negativo = false
    var tem_digito = false
    for i in 0..=len(dados) {
        var b = 10
        if i < len(dados) {
            b = dados[i] as int
        }
        if b >= 48 and b <= 57 {
            valor = valor * 10 + (b - 48)
            tem_digito = true
        } else if b == 45 {
            negativo = true
        } else if b == 10 {
            if tem_digito and negativo {
                soma -= valor
            } else if tem_digito {
                soma += valor
            }
            valor = 0
            negativo = false
            tem_digito = false
        }
    }
    return soma
}

proc main() {
    let a = os.args()
    switch dados in file.read_all(a[1], alloc = heap) {
    case [dynamic]u8:
        print(somar_linhas(dados[..]))
        delete(dados)
    case file.FileError:
        os.exit(2)
    }
}
