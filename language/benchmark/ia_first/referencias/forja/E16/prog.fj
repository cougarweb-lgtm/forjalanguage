import "std:os" as os
import "std:file"

foreign {
    link "msvcrt"
    proc atoll(texto: cstr) -> i64
}

// Acrescenta em saida cada inteiro do texto (um por linha, '-' opcional); linha em branco e ignorada.
// O indice len(dados) age como um '\n' final, para a ultima linha sem quebra.
proc ler_inteiros(dados: []u8, saida: ^[dynamic]int) {
    var valor: int = 0
    var negativo = false
    var tem_digito = false
    for i in 0..=len(dados) {
        var b = 10
        if i < len(dados) {
            b = dados[i] as int
        }
        if b >= 48 and b <= 57 {
            valor = valor * 10 + (b - 48)
            tem_digito = true
        } else if b == 45 {
            negativo = true
        } else if b == 10 {
            if tem_digito and negativo {
                append(saida, item = 0 - valor)
            } else if tem_digito {
                append(saida, item = valor)
            }
            valor = 0
            negativo = false
            tem_digito = false
        }
    }
}

proc para_int(s: str) -> int {
    let c = format_c(f"{s}", alloc = heap)
    defer delete(c)
    return atoll(c) as int
}

// Busca binaria em vetor ordenado de forma estritamente crescente; -1 se nao achar.
proc buscar(v: []int, alvo: int) -> int {
    var baixo: int = 0
    var alto: int = len(v) - 1
    while baixo <= alto {
        let meio = baixo + (alto - baixo) / 2
        if v[meio] == alvo {
            return meio
        }
        if v[meio] < alvo {
            baixo = meio + 1
        } else {
            alto = meio - 1
        }
    }
    return -1
}

proc main() {
    let a = os.args()
    var valores = make([dynamic]int, alloc = heap)
    defer delete(valores)
    switch dados in file.read_all(a[1], alloc = heap) {
    case [dynamic]u8:
        ler_inteiros(dados[..], saida = &valores)
        delete(dados)
    case file.FileError:
        os.exit(2)
    }
    print(buscar(valores[..], alvo = para_int(a[2])))
}
