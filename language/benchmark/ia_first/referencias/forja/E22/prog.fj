unit Metros: f32
unit Segundos: f32
unit MetrosPorSegundo = Metros/Segundos

// distancia = velocidade * tempo; o tipo do resultado e Metros, nao um real qualquer.
proc distancia(v: MetrosPorSegundo, t: Segundos) -> Metros {
    return v * t
}

proc main() {
    let v1: MetrosPorSegundo = 3.5
    let t1: Segundos = 4.0
    let v2: MetrosPorSegundo = 12.0
    let t2: Segundos = 2.5
    let d1 = distancia(v1, t = t1)
    let d2 = distancia(v2, t = t2)
    print(f"distancia: {d1:.1} m")
    print(f"distancia: {d2:.1} m")
}
