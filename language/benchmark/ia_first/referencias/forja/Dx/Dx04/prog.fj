proc imprimir_media(a: []int) {
    if len(a) == 0 {
        print("vazia")
        return
    }
    var total = 0
    for x in a {
        total += x
    }
    print(f"media: {total / len(a)}")
}

proc main() {
    var v: [3]int = {4, 8, 12}
    imprimir_media(v[..])
    imprimir_media(v[0..<0])
}
