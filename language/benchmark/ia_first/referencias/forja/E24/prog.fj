import "std:os" as os
import "matematica"

foreign {
    link "msvcrt"
    proc atoll(texto: cstr) -> i64
}

proc para_int(s: str) -> int {
    let c = format_c(f"{s}", alloc = heap)
    defer delete(c)
    return atoll(c) as int
}

proc main() {
    let a = os.args()
    let x = para_int(a[1])
    let y = para_int(a[2])
    print(f"soma_quadrados({x}, {y}) = {matematica.soma_quadrados(x, b = y)}")
}
