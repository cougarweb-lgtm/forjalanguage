import "std:os" as os

// Tabela fixa de idades; none = nome ausente (sem marcador -1/0).
proc buscar_idade(nome: str) -> ?int {
    if nome == "ana" {
        return 31
    }
    if nome == "bruno" {
        return 45
    }
    if nome == "carla" {
        return 28
    }
    return none
}

proc main() {
    let a = os.args()
    for i, nome in a {
        if i == 0 {
            continue
        }
        switch idade in buscar_idade(nome) {
        case int:
            print(f"{nome}: {idade}")
        case none:
            print(f"{nome}: ausente")
        }
    }
}
