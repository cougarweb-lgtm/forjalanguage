proc ordenar(a: []int) -> int {
    let n = len(a)
    var trocas = 0
    for i in 0..<n {
        let lim = n - 1 - i
        for j in 0..<lim {
            if a[j] > a[j + 1] {
                let t = a[j]
                a[j] = a[j + 1]
                a[j + 1] = t
                trocas += 1
            }
        }
    }
    return trocas
}

proc main() {
    var v: [6]int = {5, 2, 9, 1, 7, 3}
    print(ordenar(v[..]))
    for x in v {
        print(x)
    }
}
