import "std:os" as os

// atoll da libc: os argumentos chegam como texto e a tarefa garante inteiros validos.
foreign {
    link "msvcrt"
    proc atoll(texto: cstr) -> i64
}

proc para_int(s: str) -> int {
    let c = format_c(f"{s}", alloc = heap)
    defer delete(c)
    return atoll(c) as int
}

proc main() {
    let a = os.args()
    let ma = para_int(a[1])
    let mb = para_int(a[2])
    let mc = para_int(a[3])
    let md = para_int(a[4])
    let x = para_int(a[5])
    let y = para_int(a[6])
    print(f"{ma * x + mb * y} {mc * x + md * y}")
}
