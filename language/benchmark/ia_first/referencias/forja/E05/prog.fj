import "std:os" as os

struct Conta {
    titular: str = ""
    saldo: int = 0
}

proc depositar(c: ^Conta, valor: int) -> bool {
    if valor <= 0 {
        return false
    }
    c.saldo += valor
    return true
}

proc sacar(c: ^Conta, valor: int) -> bool {
    if valor <= 0 or valor > c.saldo {
        return false
    }
    c.saldo -= valor
    return true
}

proc texto_ok(ok: bool) -> str {
    if ok {
        return "ok"
    }
    return "recusado"
}

// Quantas das 4 verificacoes falharam.
proc autoteste() -> int {
    var falhas: int = 0
    var c = Conta{titular = "t", saldo = 100}
    if not (depositar(&c, valor = 50) and c.saldo == 150) {
        falhas += 1
    }
    if depositar(&c, valor = 0) or c.saldo != 150 {
        falhas += 1
    }
    if sacar(&c, valor = 200) or c.saldo != 150 {
        falhas += 1
    }
    if not (sacar(&c, valor = 150) and c.saldo == 0) {
        falhas += 1
    }
    return falhas
}

proc cenario() {
    var c = Conta{titular = "Rita", saldo = 1000}
    var ok = depositar(&c, valor = 500)
    print(f"deposito 500: {texto_ok(ok)}, saldo {c.saldo}")
    ok = sacar(&c, valor = 2000)
    print(f"saque 2000: {texto_ok(ok)}, saldo {c.saldo}")
    ok = sacar(&c, valor = 700)
    print(f"saque 700: {texto_ok(ok)}, saldo {c.saldo}")
    ok = depositar(&c, valor = -5)
    print(f"deposito -5: {texto_ok(ok)}, saldo {c.saldo}")
    print(f"titular {c.titular} saldo final {c.saldo}")
}

proc main() {
    let a = os.args()
    if len(a) > 1 and a[1] == "autoteste" {
        let falhas = autoteste()
        if falhas == 0 {
            print("autoteste: 4 ok")
            return
        }
        print(f"autoteste: falhou {falhas}")
        os.exit(1)
    }
    cenario()
}

test "deposito valido altera o saldo" {
    var c = Conta{titular = "t", saldo = 100}
    expect(depositar(&c, valor = 50))
    expect(c.saldo == 150)
}

test "saque maior que o saldo e recusado" {
    var c = Conta{titular = "t", saldo = 100}
    expect(not sacar(&c, valor = 200))
    expect(c.saldo == 100)
}
