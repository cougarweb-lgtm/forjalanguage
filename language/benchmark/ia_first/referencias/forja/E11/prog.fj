import "std:os" as os

foreign {
    link "msvcrt"
    proc atoll(texto: cstr) -> i64
}

const CAPACIDADE: int = 4

// Fila circular: inicio aponta o mais antigo; o proximo livre e (inicio + tamanho) % CAPACIDADE.
struct Fila {
    dados: [4]int = {}
    inicio: int = 0
    tamanho: int = 0
}

proc empilhar(f: ^Fila, valor: int) -> bool {
    if f.tamanho == CAPACIDADE {
        return false
    }
    f.dados[(f.inicio + f.tamanho) % CAPACIDADE] = valor
    f.tamanho += 1
    return true
}

// Devolve o mais antigo, ou none se a fila esta vazia.
proc desenfileirar(f: ^Fila) -> ?int {
    if f.tamanho == 0 {
        return none
    }
    let valor = f.dados[f.inicio]
    f.inicio = (f.inicio + 1) % CAPACIDADE
    f.tamanho -= 1
    return valor
}

proc para_int(s: str) -> int {
    let c = format_c(f"{s}", alloc = heap)
    defer delete(c)
    return atoll(c) as int
}

proc main() {
    let a = os.args()
    var fila = Fila{}
    for i, arg in a {
        if i == 0 {
            continue
        }
        if arg == "pop" {
            switch v in desenfileirar(&fila) {
            case int:
                print(f"pop {v}")
            case none:
                print("pop vazia")
            }
        } else {
            let valor = para_int(arg)
            if empilhar(&fila, valor = valor) {
                print(f"push {valor} ok")
            } else {
                print(f"push {valor} cheia")
            }
        }
    }
    print(f"tamanho={fila.tamanho}")
}
