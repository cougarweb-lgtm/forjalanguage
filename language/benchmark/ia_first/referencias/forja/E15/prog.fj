import "std:os" as os
import "std:file"

// A Forja nao indexa str nesta versao: strstr(texto, "") devolve o proprio inicio e vira uma fatia de bytes.
foreign {
    link "msvcrt"
    proc c_bytes = "strstr"(texto: cstr, procurado: cstr) -> ?^u8
}

// Anexa os bytes do texto ao destino.
proc anexar_texto(destino: ^[dynamic]u8, s: str) {
    let c = format_c(f"{s}", alloc = heap)
    defer delete(c)
    let p = c_bytes(c, procurado = "")
    let bytes = slice_from(p, len = len(s))
    for b in bytes {
        append(destino, item = b)
    }
}

proc main() {
    let a = os.args()
    var csv = make([dynamic]u8, alloc = heap)
    defer delete(csv)
    anexar_texto(&csv, s = "n,quadrado,cubo\n")
    for n in 1..=5 {
        let linha = format(f"{n},{n * n},{n * n * n}\n", alloc = heap)
        anexar_texto(&csv, s = linha)
        delete(linha)
    }
    switch e in file.write_all(a[1], data = csv[..]) {
    case file.FileError:
        print(f"erro: nao foi possivel gravar {a[1]}")
        os.exit(2)
    case none:
        print(f"gravado: {a[1]} (5 linhas)")
    }
}
