import "std:os" as os

enum Estado {
    verde
    amarelo
    vermelho
    piscante
}

proc nome_estado(e: Estado) -> str {
    var nome = "PISCANTE"
    switch e {
    case Estado.verde:
        nome = "VERDE"
    case Estado.amarelo:
        nome = "AMARELO"
    case Estado.vermelho:
        nome = "VERMELHO"
    case Estado.piscante:
        nome = "PISCANTE"
    }
    return nome
}

// tick: VERDE -> AMARELO -> VERMELHO -> VERDE; PISCANTE nao muda.
proc passo(e: Estado) -> Estado {
    var proximo = e
    switch e {
    case Estado.verde:
        proximo = Estado.amarelo
    case Estado.amarelo:
        proximo = Estado.vermelho
    case Estado.vermelho:
        proximo = Estado.verde
    case Estado.piscante:
        proximo = Estado.piscante
    }
    return proximo
}

proc main() {
    let a = os.args()
    var estado = Estado.verde
    print(f"inicio: {nome_estado(estado)}")
    for i, evento in a {
        if i == 0 {
            continue
        }
        if evento == "tick" {
            estado = passo(estado)
        } else if evento == "pane" {
            estado = Estado.piscante
        } else if evento == "ok" {
            if estado == Estado.piscante {
                estado = Estado.vermelho
            }
        } else {
            print(f"{evento}: evento invalido")
            continue
        }
        print(f"{evento}: {nome_estado(estado)}")
    }
}
