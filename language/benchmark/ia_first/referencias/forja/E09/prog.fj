import "std:os" as os
import "std:file"

// Acrescenta em saida cada inteiro do texto (um por linha, '-' opcional); linha em branco e ignorada.
// O indice len(dados) age como um '\n' final, para a ultima linha sem quebra.
proc ler_inteiros(dados: []u8, saida: ^[dynamic]int) {
    var valor: int = 0
    var negativo = false
    var tem_digito = false
    for i in 0..=len(dados) {
        var b = 10
        if i < len(dados) {
            b = dados[i] as int
        }
        if b >= 48 and b <= 57 {
            valor = valor * 10 + (b - 48)
            tem_digito = true
        } else if b == 45 {
            negativo = true
        } else if b == 10 {
            if tem_digito and negativo {
                append(saida, item = 0 - valor)
            } else if tem_digito {
                append(saida, item = valor)
            }
            valor = 0
            negativo = false
            tem_digito = false
        }
    }
}

// Media e desvio padrao populacional, em f64.
proc estatistica(v: []int) -> (media: f64, desvio: f64) {
    var soma: f64 = 0.0
    for x in v {
        soma += x as f64
    }
    let n = len(v) as f64
    let media = soma / n
    var quadrados: f64 = 0.0
    for x in v {
        let d = x as f64 - media
        quadrados += d * d
    }
    return media, sqrt(quadrados / n)
}

proc main() {
    let a = os.args()
    var valores = make([dynamic]int, alloc = heap)
    defer delete(valores)
    switch dados in file.read_all(a[1], alloc = heap) {
    case [dynamic]u8:
        ler_inteiros(dados[..], saida = &valores)
        delete(dados)
    case file.FileError:
        os.exit(2)
    }
    let media, desvio = estatistica(valores[..])
    print(f"media={media:.2} desvio={desvio:.2}")
}
