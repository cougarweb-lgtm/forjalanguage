// Funcoes da libm chamadas direto por foreign (nao reimplementadas).
foreign {
    link "m"
    proc pow(x: f64, y: f64) -> f64
    proc hypot(x: f64, y: f64) -> f64
    proc fmod(x: f64, y: f64) -> f64
    proc cbrt(x: f64) -> f64
}

proc main() {
    let potencia = pow(2.0, y = 10.0)
    let hipotenusa = hypot(3.0, y = 4.0)
    let resto = fmod(7.5, y = 2.0)
    let raiz_cubica = cbrt(27.0)
    print(f"pow={potencia:.2}")
    print(f"hypot={hipotenusa:.2}")
    print(f"fmod={resto:.2}")
    print(f"cbrt={raiz_cubica:.2}")
}
