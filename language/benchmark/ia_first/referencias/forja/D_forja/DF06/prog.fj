foreign {
    link "msvcrt"
    proc c_memset = "memset"(destino: ?^i32, valor: i32, n: u64) -> ?^i32
}

proc zerar(p: ?^i32) {
    if p == none {
        return
    }
    _ = c_memset(p, valor = 0, n = 4)
}

proc main() {
    print(1)
}

test "zerar um inteiro" {
    var x: i32 = 7
    zerar(&x)
    expect(x == 0)
    zerar(none)
}
