import "std:os" as os

foreign {
    link "msvcrt"
    proc atoll(texto: cstr) -> i64
}

const PI: f64 = 3.141592653589793

struct Circulo {
    raio: int = 0
}

struct Retangulo {
    largura: int = 0
    altura: int = 0
}

struct Quadrado {
    lado: int = 0
}

union Forma { Circulo, Retangulo, Quadrado }

proc area(f: Forma) -> f64 {
    var resultado: f64 = 0.0
    switch u in f {
    case Circulo:
        resultado = PI * (u.raio as f64) * (u.raio as f64)
    case Retangulo:
        resultado = (u.largura * u.altura) as f64
    case Quadrado:
        resultado = (u.lado * u.lado) as f64
    }
    return resultado
}

proc para_int(s: str) -> int {
    let c = format_c(f"{s}", alloc = heap)
    defer delete(c)
    return atoll(c) as int
}

proc main() {
    let a = os.args()
    var i: int = 1
    while i < len(a) {
        let nome = a[i]
        if nome == "circulo" {
            let f: Forma = Circulo{raio = para_int(a[i + 1])}
            print(f"{nome}: {area(f):.2}")
            i += 2
        } else if nome == "retangulo" {
            let f: Forma = Retangulo{largura = para_int(a[i + 1]), altura = para_int(a[i + 2])}
            print(f"{nome}: {area(f):.2}")
            i += 3
        } else if nome == "quadrado" {
            let f: Forma = Quadrado{lado = para_int(a[i + 1])}
            print(f"{nome}: {area(f):.2}")
            i += 2
        } else {
            print(f"forma desconhecida: {nome}")
            os.exit(1)
        }
    }
}
