// L3c2: identificadores do USUARIO com o nome das formas novas e antigas do vendor:db (value, index, path, version, next, reset, close, message, columns, parameter, execution, valor, indice, caminho,
// sem_memoria...) continuam do usuario: variavel, parametro, campo, rotulo de proc do usuario e membro de enum do usuario nao sao trocados. Desde o IA1-L8 os nomes de TOPO sao por modulo
// (E0202 so vale dentro do mesmo modulo), mas esta fixture mantem so escopo local, campo, parametro e membro. Precisa de vendor\ ao lado.
import "vendor:db/db"

enum Falha {
    parametro
    execucao
    sem_memoria
    out_of_memory_mas_meu
}

struct Janela {
    path: str
    index: i32
    value: i64
    next: int
    columns: int
}

proc somar(value: i64, index: i32) -> i64 {
    return value + (index as i64)
}

proc medir(caminho: str, indice: i32, valor: i64) -> int {
    return len(caminho) + (indice as int) + (valor as int)
}

proc nome_da_falha(f: Falha) -> str {
    switch f {
    case Falha.parametro:
        return "meu parametro"
    case Falha.execucao:
        return "minha execucao"
    case Falha.sem_memoria:
        return "meu sem_memoria"
    case Falha.out_of_memory_mas_meu:
        return "meu out_of_memory"
    }
    return "?"
}

proc main() {
    let version = 3
    let next = 4
    let reset = 5
    let close = 6
    let message = "m"
    let parameter = 8
    let execution = 9
    let columns = 7
    let nome: str = ":memory:"
    let path: cstr = ":memory:"
    let index: i32 = 1
    let value: i64 = 10
    let janela = Janela{path = nome, index = index, value = value, next = next, columns = columns}
    print(f"{somar(value = value, index = index)} {somar(value, index)}")
    print(f"{medir(caminho = nome, indice = index, valor = value)} {medir(nome, index, value)}")
    print(f"{version} {next} {reset} {close} {message} {parameter} {execution} {columns} {janela.path} {janela.index} {janela.value} {janela.next} {janela.columns}")
    print(f"{nome_da_falha(Falha.parametro)} {nome_da_falha(Falha.execucao)} {nome_da_falha(Falha.sem_memoria)} {nome_da_falha(Falha.out_of_memory_mas_meu)}")
    switch aberto in db.open(path = path) {
    case db.Db:
        switch r in db.exec(aberto, sql = "CREATE TABLE t(v INTEGER)") {
        case db.DbError:
            print("erro")
        default:
            print("ok")
        }
        switch q in db.prepare(aberto, sql = "INSERT INTO t(v) VALUES (?)") {
        case db.Query:
            switch r in db.bind_int(q, index = index, value = value) {
            case db.DbError:
                print(f"bind: {r == db.DbError.parameter}")
            default:
                print("bind ok")
            }
            switch r in db.bind_int(q, index = index, value = value + 1) {
            case db.DbError:
                print(f"bind: {r == db.DbError.parameter}")
            default:
                print("bind antigo ok")
            }
            db.finalize(q)
        case db.DbError:
            print("prepare falhou")
        }
        db.close(aberto)
    case db.DbError:
        print("nao abriu")
    }
}
