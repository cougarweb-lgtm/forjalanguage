// L3c2: pacote vendor\db_server pelo caminho NOVO (so check: nao conecta a nada); o resultado do check e o de servidor_antigo.fj. Precisa de vendor\ ao lado.
import "vendor:db_server/mariadb" as my
import "vendor:db_server/libpq" as pq

proc main() {
    print(f"mariadb {(my.mysql_get_client_version() as uint) > 0} libpq {pq.PQlibVersion() > 0}")
}
