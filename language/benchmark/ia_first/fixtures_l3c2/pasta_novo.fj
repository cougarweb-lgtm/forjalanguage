// L3c2: so a PASTA do pacote muda (import vendor:db/sqlite3, o arquivo sqlite3.fj nao mudou); a saida e a de pasta_antigo.fj. Precisa de vendor\ ao lado.
import "vendor:db/sqlite3" as sq

proc main() {
    let v = sq.sqlite3_libversion()
    let texto = (v or_else "?") as str
    print(f"SQLite {texto}")
}
