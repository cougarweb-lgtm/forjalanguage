// L3f: o rotulo antigo caminho de db.open e E0110 com a troca por path; o modulo e o proc ja estao na forma nova. Precisa de vendor\ ao lado.
import "vendor:db/db"

proc main() {
    switch aberto in db.open(caminho = ":memory:") {
    case db.Db:
        db.close(aberto)
    default:
        print("nao abriu")
    }
}
