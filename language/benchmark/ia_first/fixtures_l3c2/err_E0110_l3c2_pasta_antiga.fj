// L3f: a pasta antiga do pacote (vendor:banco/sqlite3) e E0110 com a troca por vendor:db/sqlite3; o arquivo sqlite3.fj nao mudou. Precisa de vendor\ ao lado.
import "vendor:banco/sqlite3" as sq

proc main() {
    let v = sq.sqlite3_libversion()
    let texto = (v or_else "?") as str
    print(f"SQLite {texto}")
}
