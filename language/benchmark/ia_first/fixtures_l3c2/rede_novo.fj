// L3c2: pacote vendor\net pelo caminho NOVO (import vendor:net/net e qualificador net.; so check: nao usa a rede); o check e o de rede_antigo.fj. Precisa de vendor\ ao lado.
import "vendor:net/net"

proc nome_do_erro(e: net.NetError) -> str {
    if e == net.NetError.invalid_url {
        return "url_invalida"
    }
    return "outro"
}

proc main() {
    print(f"libcurl: {net.versao() as str} {nome_do_erro(net.NetError.cannot_resolve)}")
}
