struct E3276 {
    vida: i32 in 0..=100 = 22
    x: int = 0
    y: int = 3
}

proc m3276(e: ^E3276, passos: int) {
    e.x += passos * e.y
    e.vida -= 5
}

proc d3276(v: MetrosPorSegundo, dt: Segundos = 1.25) -> Metros {
    return v * dt
}

proc p3276(n: int, m: int = 6) -> bool {
    return n % m == 0 and n > 32
}

proc f3277(a: int, b: int = 5, c: int = 9) -> int {
    var r = a * b + c
    if r > 186 {
        r = r - 186
    } else {
        r = r + 28
    }
    return r
}

proc s3277(n: int, passo: int = 6) -> int {
    var acc = 0
    for i in 0..<n {
        acc += i * passo
        if acc > 564 {
            acc -= 564
        }
    }
    return acc
}

proc w3277(limite: int, inc: int = 4) -> int {
    var x = 0
    var passos = 0
    while x < limite {
        x += inc
        passos += 1
    }
    return passos
}

struct E3277 {
    vida: i32 in 0..=100 = 22
    x: int = 0
    y: int = 5
}

proc m3277(e: ^E3277, passos: int) {
    e.x += passos * e.y
    e.vida -= 3
}

proc d3277(v: MetrosPorSegundo, dt: Segundos = 2.25) -> Metros {
    return v * dt
}

proc p3277(n: int, m: int = 6) -> bool {
    return n % m == 0 and n > 39
}

proc f3278(a: int, b: int = 2, c: int = 58) -> int {
    var r = a * b + c
    if r > 1413 {
        r = r - 1413
    } else {
        r = r + 35
    }
    return r
}

proc s3278(n: int, passo: int = 7) -> int {
    var acc = 0
    for i in 0..<n {
        acc += i * passo
        if acc > 725 {
            acc -= 725
        }
    }
    return acc
}

proc w3278(limite: int, inc: int = 4) -> int {
    var x = 0
    var passos = 0
    while x < limite {
        x += inc
        passos += 1
    }
    return passos
}

struct E3278 {
    vida: i32 in 0..=100 = 94
