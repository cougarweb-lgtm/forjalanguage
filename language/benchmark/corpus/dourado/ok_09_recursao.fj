proc fatorial(n: int) -> int {
    if n <= 1 {
        return 1
    }
    return n * fatorial(n - 1)
}

proc fib(n: int) -> int {
    var a = 0
    var b = 1
    for i in 0..<n {
        let t = a + b
        a = b
        b = t
    }
    return a
}

proc main() {
    print(fatorial(10))
    print(fib(20))
}
