unit Metros: f32
unit Segundos: f32
unit MetrosPorSegundo = Metros/Segundos

proc distancia(v: MetrosPorSegundo, dt: Segundos) -> Metros {
    return v * dt
}

proc main() {
    let v: MetrosPorSegundo = 8.0
    let t: Segundos = 0.5
    let d: Metros = distancia(v, dt = t)
    print(d as int)
    let r: MetrosPorSegundo = d / t
    print(r as int)
}
