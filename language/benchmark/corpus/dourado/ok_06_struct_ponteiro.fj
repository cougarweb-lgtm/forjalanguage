struct Grifo {
    vida: i32 in 0..=100 = 100
    velocidade: int = 8
    x: int = 0
}

proc mover(g: ^Grifo, passos: int) {
    g.x += g.velocidade * passos
    g.vida -= 10
}

proc main() {
    var g = Grifo{velocidade = 3}
    mover(&g, passos = 4)
    mover(&g, passos = 1)
    print(g.x)
    print(g.vida)
}
